; Diagnostic composition of the installed generated analysis workers.
; Keep their actual once/answer-stream boundaries and result binders. This
; file neither implements graph algorithms nor replaces the public library.
(= (ebench:analyze-components (BNFStartSomeV1 $startName $startSpan) $definitions $lexicals)
   (let* (($_ (println! (EbnfStage begin rank)))
          ((gslt:result:BNFDiscoveryRankDefinitionsV1:110 $ranked)
           (once (gslt:fn:BNFDiscoveryRankDefinitionsV1:110 $definitions BNFDiscoveryRankZeroV1)))
          ($_ (println! (EbnfStage end rank)))
          ($_ (println! (EbnfStage begin definition-index)))
          ((gslt:result:BNFDiscoveryDefinitionIndexV1:110 $definitionIndex)
           (once (gslt:fn:BNFDiscoveryDefinitionIndexV1:110 $ranked BNFGraphTrieEmptyV1)))
          ($_ (println! (EbnfStage end definition-index)))
          ($_ (println! (EbnfStage begin reverse-index)))
          ((gslt:result:BNFDiscoveryReverseIndexV1:1110 $reverse)
           (once (gslt:fn:BNFDiscoveryReverseIndexV1:1110 $ranked $lexicals BNFGraphTrieEmptyV1)))
          ($_ (println! (EbnfStage end reverse-index)))
          ($_ (println! (EbnfStage begin reachable)))
          ((gslt:result:BNFReachableLoopV1:11110 $reachableIndex)
           (once (gslt:fn:BNFReachableLoopV1:11110
             (BNFNamesConsV1 $startName BNFNamesNilV1)
             (BNFIndexedDefinitionsV1 $definitionIndex) $lexicals
             (BNFDiscoveryKnownV1 BNFGraphTrieEmptyV1 BNFNamesNilV1))))
          ($_ (println! (EbnfStage end reachable)))
          ($_ (println! (EbnfStage begin unreachable-diagnostics)))
          ((gslt:result:BNFUnreachableDiagnosticsV1:110 $unreachableDiagnostics)
           (once (gslt:fn:BNFUnreachableDiagnosticsV1:110 $definitions $reachableIndex)))
          ($_ (println! (EbnfStage end unreachable-diagnostics)))
          ($_ (println! (EbnfStage begin productive)))
          ((gslt:result:BNFDiscoveryClosureV1:11110 $productiveIndex)
           (superpose (collapse (gslt:mode:BNFDiscoveryClosureV1:11110
             BNFDiscoveryProductiveV1 $ranked $reverse $lexicals))))
          ($_ (println! (EbnfStage end productive)))
          ($_ (println! (EbnfStage begin unproductive-diagnostics)))
          ((gslt:result:BNFUnproductiveDiagnosticsV1:110 $unproductiveDiagnostics)
           (once (gslt:fn:BNFUnproductiveDiagnosticsV1:110 $definitions $productiveIndex)))
          ($_ (println! (EbnfStage end unproductive-diagnostics)))
          ($_ (println! (EbnfStage begin nullable)))
          ((gslt:result:BNFDiscoveryClosureV1:11110 $nullableIndex)
           (superpose (collapse (gslt:mode:BNFDiscoveryClosureV1:11110
             BNFDiscoveryNullableV1 $ranked $reverse $lexicals))))
          ($_ (println! (EbnfStage end nullable)))
          ($_ (println! (EbnfStage begin observe-reachable)))
          ((gslt:result:BNFIndexedNamesObserveV1:10 $reachable)
           (once (gslt:fn:BNFIndexedNamesObserveV1:10 $reachableIndex)))
          ($_ (println! (EbnfStage end observe-reachable)))
          ($_ (println! (EbnfStage begin observe-nullable)))
          ((gslt:result:BNFIndexedNamesObserveV1:10 $nullable)
           (once (gslt:fn:BNFIndexedNamesObserveV1:10 $nullableIndex)))
          ($_ (println! (EbnfStage end observe-nullable)))
          ($_ (println! (EbnfStage begin observe-productive)))
          ((gslt:result:BNFIndexedNamesObserveV1:10 $productive)
           (once (gslt:fn:BNFIndexedNamesObserveV1:10 $productiveIndex)))
          ($_ (println! (EbnfStage end observe-productive)))
          ($_ (println! (EbnfStage begin diagnostics)))
          ((gslt:result:BNFAppendDiagnosticsV1:110 $diagnostics)
           (once (gslt:fn:BNFAppendDiagnosticsV1:110 $unreachableDiagnostics $unproductiveDiagnostics)))
          ($_ (println! (EbnfStage end diagnostics)))
          ($_ (println! (EbnfStage begin finish)))
          ((gslt:result:BNFFinishGraphAnalysisV1:11111110 $result)
           (once (gslt:fn:BNFFinishGraphAnalysisV1:11111110
             (BNFStartSomeV1 $startName $startSpan) $definitions $lexicals
             $reachable $nullable $productive $diagnostics)))
          ($_ (println! (EbnfStage end finish))))
     $result))

(= (ebench:graph-input (EBNF:LoweredGrammar $original $authority $plain $origins))
   (bnf-v1:grammar-input $plain $authority))

(= (ebench:graph-checked $language $input)
   (let* (((LangDef:TermAdmitted) (langdef:admit-term $language "BnfGrammarInput" $input))
          ((gslt:result:BNFValidateGrammarDiscoveryV1:10 $declarations)
           (gslt:admitted-entry:BNFValidateGrammarDiscoveryV1:10 $language $input))
          ((BNFDeclarationValidationAcceptedV1 $start $definitions $lexicals) $declarations))
     (ebench:analyze-components $start $definitions $lexicals)))

(= (ebench:run-graph-components $lowered)
   (let $language (langdef:load-language "langdef/bnf/plain_bnf_grammar_v1.metta")
     (let $answers (collapse (ebench:graph-checked $language (ebench:graph-input $lowered)))
       (let $_ (langdef:close-language $language) (superpose $answers)))))
