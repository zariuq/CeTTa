(= (binding-id $x) $x)
(= (binding-box $x) (Box $x))
(= (binding-pair $x) (Pair $x $x))
(= (binding-region-walk $n)
   (if (== $n 0)
       done
       (let* (($previous (binding-id (- $n 1)))
                      ($next (binding-id $previous)))
                (binding-region-walk $next))))
!(binding-region-walk 50)
