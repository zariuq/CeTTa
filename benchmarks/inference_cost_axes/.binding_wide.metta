(= (binding-id $x) $x)
(= (binding-box $x) (Box $x))
(= (binding-pair $x) (Pair $x $x))
(= (binding-region-walk $n)
   (if (== $n 0)
       done
       (let* (($a (binding-id (- $n 1)))
                      ($b (binding-id $a))
                      ($c (binding-id $b))
                      ($d (binding-id $c))
                      ($e (binding-id $d))
                      ($f (binding-id $e))
                      ($g (binding-id $f))
                      ($next (binding-id $g)))
                (binding-region-walk $next))))
!(binding-region-walk 50)
