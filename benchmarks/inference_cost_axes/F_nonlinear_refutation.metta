; Axis F: nonlinear rejection after a safe structural candidate superset.
; The tag is unknown, so all 32 authored occurrences survive the deep index.
; The repeated variable then refutes every occurrence because left != right.
(= (nonlinear 0 $x $x) 0)
(= (nonlinear 1 $x $x) 1)
(= (nonlinear 2 $x $x) 2)
(= (nonlinear 3 $x $x) 3)
(= (nonlinear 4 $x $x) 4)
(= (nonlinear 5 $x $x) 5)
(= (nonlinear 6 $x $x) 6)
(= (nonlinear 7 $x $x) 7)
(= (nonlinear 8 $x $x) 8)
(= (nonlinear 9 $x $x) 9)
(= (nonlinear 10 $x $x) 10)
(= (nonlinear 11 $x $x) 11)
(= (nonlinear 12 $x $x) 12)
(= (nonlinear 13 $x $x) 13)
(= (nonlinear 14 $x $x) 14)
(= (nonlinear 15 $x $x) 15)
(= (nonlinear 16 $x $x) 16)
(= (nonlinear 17 $x $x) 17)
(= (nonlinear 18 $x $x) 18)
(= (nonlinear 19 $x $x) 19)
(= (nonlinear 20 $x $x) 20)
(= (nonlinear 21 $x $x) 21)
(= (nonlinear 22 $x $x) 22)
(= (nonlinear 23 $x $x) 23)
(= (nonlinear 24 $x $x) 24)
(= (nonlinear 25 $x $x) 25)
(= (nonlinear 26 $x $x) 26)
(= (nonlinear 27 $x $x) 27)
(= (nonlinear 28 $x $x) 28)
(= (nonlinear 29 $x $x) 29)
(= (nonlinear 30 $x $x) 30)
(= (nonlinear 31 $x $x) 31)

(= (nonlinear-refutation-loop $n)
   (if (== $n 0)
       done
       (let $discarded (collapse (nonlinear $tag left right))
         (nonlinear-refutation-loop (- $n 1)))))

!(nonlinear-refutation-loop 100000)
