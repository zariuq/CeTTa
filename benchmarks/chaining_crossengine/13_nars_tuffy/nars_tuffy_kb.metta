; Shared inference core and knowledge base, without an eager top-level query.
!(import! &self ../../../lib/lib_nars_portable)

(= (kb)
   ((Sentence ((==> (--> (× $1 $2) friend)
                    (==> (--> $1 ([] smokes))
                         (--> $2 ([] smokes))))
               (stv 0.4 0.9)) (1))
    (Sentence ((==> (--> $1 ([] smokes))
                    (--> $1 ([] cancerous)))
               (stv 0.6 0.9)) (2))
    (Sentence ((--> (× Anna Bob) friend)
               (stv 1.0 0.9)) (3))
    (Sentence ((--> (× Anna Edward) friend)
               (stv 1.0 0.9)) (4))
    (Sentence ((--> (× Anna Frank) friend)
               (stv 1.0 0.9)) (5))
    (Sentence ((--> (× Edward Frank) friend)
               (stv 1.0 0.9)) (6))
    (Sentence ((--> (× Gary Helen) friend)
               (stv 1.0 0.9)) (7))
    (Sentence ((--> (× Gary Frank) friend)
               (stv 0.0 0.9)) (8))
    (Sentence ((--> Anna ([] smokes))
               (stv 1.0 0.9)) (9))
    (Sentence ((--> Edward ([] smokes))
               (stv 1.0 0.9)) (10))))
