; JeTTa performance-suite workload 3: SICP-style symbolic differentiation
; followed by numeric evaluation at x = 3.
;
; Bind the derivative before evaluating its polynomial. The explicit boundary
; keeps the authored demand visible in each adapter. The checksum is 27 * @N@.

(= (mam:d x $iteration)
   (let $zero (* 0 $iteration)
     (Lit (+ 1 $zero))))
(= (mam:d (Lit $n) $iteration)
   (let $zero (* 0 $iteration)
     (Lit $zero)))
(= (mam:d (Plus $a $b) $iteration)
   (let $da (mam:d $a $iteration)
     (let $db (mam:d $b $iteration)
       (Plus $da $db))))
(= (mam:d (Mul $a $b) $iteration)
   (let $da (mam:d $a $iteration)
     (let $db (mam:d $b $iteration)
       (Plus (Mul $da $b) (Mul $a $db)))))

(= (mam:eval-poly x) 3)
(= (mam:eval-poly (Lit $n)) $n)
(= (mam:eval-poly (Plus $a $b))
   (+ (mam:eval-poly $a) (mam:eval-poly $b)))
(= (mam:eval-poly (Mul $a $b))
   (* (mam:eval-poly $a) (mam:eval-poly $b)))

(= (mam:derivative-value $expression $iteration)
   (let $derivative (mam:d $expression $iteration)
     (mam:eval-poly $derivative)))

(= (mam:differentiation-loop $remaining $sum)
   (if (< $remaining 1)
       $sum
       (let $next (- $remaining 1)
         (let $value
           (mam:derivative-value (Mul x (Mul x x)) $next)
           (mam:differentiation-loop $next (+ $sum $value))))))

!(mam:differentiation-loop @N@ 0)
