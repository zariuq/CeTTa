(block "canonical bit" "MakeNatBit" (nat-push-bit) "proved" "cMakeNatBit_binding, makeNatBit_iff (rules CanonZero, CanonOne, CanonMore: 2n + b); trusted: rc_bignat computes the stated functions of the magnitudes" (rules "CanonZero" "CanonOne" "CanonMore"))
(block "predecessor" "NatPred" (nat-pred) "proved" "natPred_binding, natPred_eq_none_iff (rules PredOdd, PredEven: n - 1, no rule for zero); trusted: rc_bignat" (rules "PredOdd" "PredEven"))
(block "numeral order" "NatCompare" (nat-order Less Equal Greater) "proved" "natCompare_binding, natCompare_canonical (rules CompareZero ... CompareLowGreater); trusted: rc_bignat, one word per number" (rules "CompareZero" "CompareLeftZero" "CompareRightZero" "CompareMore"))
(block "increment" "NatInc" (nat-succ) "proved" "natInc_binding (rules IncZero, IncEven, IncOdd); trusted: rc_bignat" (rules "IncZero" "IncEven" "IncOdd"))
(block "sum" "NatAdd" (nat-add) "proved" "natAdd_binding (rules AddZero ... AddOddOdd); trusted: rc_bignat" (rules "AddZero" "AddLeftZero" "AddRightZero" "AddEvenEven" "AddEvenOdd" "AddOddEven" "AddOddOdd"))
(block "exclusive or" "NatXor" (nat-xor) "proved" "natXor_binding (rules XorZero ... XorMore); trusted: rc_bignat" (rules "XorZero" "XorLeftZero" "XorRightZero" "XorMore"))
