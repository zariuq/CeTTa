(block "name equality" "hl:str-eq" "holb_str_eq" "proved" "strEq_binding, names_eq_iff: interned names have equal bytes exactly when they are the same id; strEq_refines" (rules "str-eq"))
(block "name order" "hl:cmp-str" "holb_cmp_str" "proved" "cmpStr_refines, nativeCmp_eq_memcmp; names_eq_iff (id to bytes); trusted: hk_name_cmp is memcmp of the common prefix then the lengths, and C memcmp compares unsigned" (rules "cmp-str-nn" "cmp-str-nc" "cmp-str-cn" "cmp-str-cc"))
(block "name prime" "hl:str-prime" "holb_str_prime" "proved" "strPrime_refines; names_eq_iff (id to bytes); trusted: hk_name_prime interns the bytes followed by 0x27" (rules "str-prime-nil" "str-prime-cons"))
(block "numeral order" "hl:cmp-nat" "rc_native_cmp_nat" "proved" "cmpNat_refines; trusted: the comparison of uint64_t" (rules "cmp-nat-zz" "cmp-nat-z0" "cmp-nat-z1" "cmp-nat-0z" "cmp-nat-1z" "cmp-nat-00" "cmp-nat-11" "cmp-nat-01" "cmp-nat-10"))
(block "numeral successor" "hl:nat-inc" "rc_native_nat_inc" "proved" "natInc_refines; checked at run time: the immediate range" (rules "inc-z" "inc-0" "inc-1"))
(block "type equality" "hl:ty-eq" "holb_ty_eq" "proved" "tyEq_binding: in an interning store ty-eq of two read-backs answers yes exactly when they are one node (interning_eq_iff, cmpType_eq_iff)" (rules "ty-eq"))
(block "term equality" "hl:tm-eq" "holb_tm_eq" "proved" "tmEq_binding: in an interning store tm-eq of two read-backs answers yes exactly when they are one node (interning_eq_iff, cmpTerm_eq_iff)" (rules "tm-eq"))
(block "type order" "hl:cmp-type" "holb_cmp_type" "checked" "hk_ty_compare: OCaml compare on hol_type" (rules "cmp-type-vv" "cmp-type-va" "cmp-type-av" "cmp-type-aa"))
(block "term order" "hl:cmp-term" "holb_cmp_term" "checked" "hk_tm_compare: OCaml compare on term" (rules "cmp-term-vv" "cmp-term-vc" "cmp-term-vm" "cmp-term-va" "cmp-term-cv" "cmp-term-cc" "cmp-term-cm" "cmp-term-ca" "cmp-term-mv" "cmp-term-mc" "cmp-term-mm" "cmp-term-ma" "cmp-term-av" "cmp-term-ac" "cmp-term-am" "cmp-term-aa"))
(block "alphaorder" "hl:alphaorder" "holb_alphaorder" "checked" "hk_alphaorder: fusion.ml orda/ordav" (rules "alphaorder"))
(block "type_of" "hl:type-of" "holb_type_of" "checked" "the type each native term records at construction" (rules "type-of-var" "type-of-const" "type-of-comb" "type-of-abs"))
(block "mk_comb" "hl:mk-comb" "holb_mk_comb" "checked" "hk_tm_comb; refusal mapped to tm-fail(mk_comb: types do not agree)" (rules "mk-comb"))
(block "mk_abs" "hl:mk-abs" "holb_mk_abs" "checked" "hk_tm_abs; refusal mapped to tm-fail(mk_abs: not a variable)" (rules "mk-abs-var" "mk-abs-const" "mk-abs-comb" "mk-abs-abs"))
(block "safe_mk_eq" "hl:safe-mk-eq" "holb_safe_mk_eq" "checked" "hk_tm_eq" (rules "safe-mk-eq"))
(block "frees" "hl:frees" "holb_frees" "checked" "hk_frees_exact (fusion.ml's order)" (rules "frees-var" "frees-const" "frees-abs" "frees-comb"))
(block "freesin" "hl:freesin" "holb_freesin" "checked" "hk_freesin" (rules "freesin-var" "freesin-const" "freesin-abs" "freesin-comb"))
(block "vfree_in" "hl:vfree-in" "holb_vfree_in" "checked" "hk_vfree_in" (rules "vfree-in-var" "vfree-in-const" "vfree-in-abs" "vfree-in-comb"))
(block "type_vars_in_term" "hl:type-vars-in-term" "holb_type_vars_in_term" "checked" "hk_type_vars_in_term_exact (fusion.ml's order)" (rules "tvs-var" "tvs-const" "tvs-comb" "tvs-abs"))
(block "tyvars" "hl:tyvars" "holb_tyvars" "checked" "hk_tyvars_exact (fusion.ml's order)" (rules "tyvars-var" "tyvars-app"))
(block "variant" "hl:variant" "holb_variant" "checked" "hk_variant" (rules "variant"))
(block "vsubst" "hl:vsubst" "holb_vsubst" "checked" "hk_vsubst; Bad substitution list mapped to vs-bad" (rules "vsubst-nil" "vsubst-cons"))
(block "vsubst recursion" "hl:vsubst-rec" "holb_vsubst_rec" "checked" "hk_vsubst on a list that passes vsubst's check, which the rules make first; a list that fails it stops the run" (rules "vs-var" "vs-const" "vs-comb" "vs-abs"))
(block "inst" "hl:inst" "holb_inst" "checked" "hk_inst" (rules "inst-nil" "inst-cons"))
(block "type_subst" "hl:type-subst" "holb_type_subst" "checked" "hk_type_subst" (rules "type-subst-var" "type-subst-app"))
(block "term_union" "hl:term-union" "holb_term_union" "checked" "fusion.ml's term_union over hk_alphaorder" (rules "term-union-nil" "term-union-cons-nil" "term-union-cons-cons"))
(block "term_remove" "hl:term-remove" "holb_term_remove" "checked" "fusion.ml's term_remove over hk_alphaorder" (rules "term-remove-nil" "term-remove-cons"))
(block "term_image vsubst" "hl:term-image-vsubst" "holb_term_image_vsubst" "checked" "fusion.ml's term_image over hk_vsubst and term_union" (rules "term-image-vsubst-nil" "term-image-vsubst-cons"))
(block "term_image inst" "hl:term-image-inst" "holb_term_image_inst" "checked" "fusion.ml's term_image over hk_inst and term_union" (rules "term-image-inst-nil" "term-image-inst-cons"))
(block "table lookup" "hl:table-get" "holb_table_get" "proved" "tableGet_readback: table-get on the read-back gives the stored cell, c-none where none; trusted: the array code is the model NTable; checked at run time: no table value is used after its update" (rules "table-get"))
(block "table append" "hl:table-put" "holb_table_put" "proved" "tablePut_readback: table-put on the read-back is the read-back of the store at next and next + 1; trusted: the array code is the model NTable; checked at run time: no table value is used after its update" (rules "table-put"))
(block "table update" "hl:table-set" "holb_table_set" "proved" "tableSet_readback: table-set on the read-back is the read-back of the store at the id; trusted: the array code is the model NTable; checked at run time: no table value is used after its update" (rules "table-set"))
(block "table size" "hl:table-next" "holb_table_next" "proved" "tableNext_readback; trusted: the array code is the model NTable; checked at run time: no table value is used after its update" (rules "table-next"))
(block "empty table" "hl:empty-table" "holb_empty_table" "proved" "emptyTable_readback; trusted: the array code is the model NTable; checked at run time: no table value is used after its update" (rules "empty-table"))
(law "type list order, reflexive" "hl:cmp-types" "hl:eq" "proved" "cmpTypes_refl, fastPath_sound" (rules "cmp-types-nn" "cmp-types-nc" "cmp-types-cn" "cmp-types-cc"))
(law "term list equality, reflexive" "hl:tms-eq" "hl:yes" "proved" "tmsEq_refl, fastPath_sound" (rules "tms-eq-nn" "tms-eq-nc" "tms-eq-cn" "tms-eq-cc"))
