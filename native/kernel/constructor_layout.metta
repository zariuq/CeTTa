; Linear constructor state, node fields and canonical graph tags.
(= (nc:f root) 0) (= (nc:f nodes) 1) (= (nc:f edges) 2) (= (nc:f ports) 3)
(= (nc:f node-cap) 4) (= (nc:f edge-cap) 5) (= (nc:f out-nodes) 6) (= (nc:f out-edges) 7)
(= (nc:f cursor) 8) (= (nc:f mode) 9) (= (nc:f child) 10) (= (nc:f first) 11)
(= (nc:f source) 12) (= (nc:f kind) 13) (= (nc:f a) 14) (= (nc:f b) 15) (= (nc:f c) 16)
(= (nc:f seed-nodes) 17) (= (nc:f expanded) 18)
(= (nc:n kind) 0) (= (nc:n a) 1) (= (nc:n b) 2) (= (nc:n c) 3)
(= (nc:k constant) 0) (= (nc:k variable) 1) (= (nc:k tuple) 2)
