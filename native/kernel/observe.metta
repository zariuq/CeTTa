; Scope-independent control for contextual output observation. The host lends
; read-only descriptor facts and performs the declared allocation/storage action.
!(import! &self "../../vendor/tcalc-native/native/p1/p1.metta")
!(import! &self "observe_layout.metta")
(= (no:get $r $f) (Load facts $r v11 (* 8 (no:f $f))))
(= (no:return $a) (Seq (Imm v1 (no:a $a)) (Return FIRED v1)))
(= (no:descend)
   (Seq (no:get v1 ready) (CmpI Ne v7 v1 0) (If v7 (no:return shared) Skip)
     (no:get v1 has-vars) (CmpI Eq v7 v1 0) (If v7 (no:return shared) Skip)
     (no:get v1 kind) (CmpI Eq v7 v1 (no:k variable)) (If v7 (no:return variable) Skip)
     (CmpI Eq v7 v1 (no:k expression)) (If v7 (no:return expression) (no:return shared))))
(= (no:variable)
   (Seq (no:get v1 memo) (CmpI Ne v7 v1 0) (If v7 (no:return memo) Skip)
     (no:get v1 seen) (CmpI Ne v7 v1 0) (If v7 (no:return unbound) Skip)
     (no:get v1 bound) (CmpI Ne v7 v1 0) (If v7 (no:return follow) (no:return unbound))))
(= (no:ascend)
   (Seq (no:get v1 variable-frame) (CmpI Ne v7 v1 0) (If v7 (no:return put-memo) Skip)
     (no:get v1 result) (CmpI Ne v7 v1 0)
     (If v7
       (Seq (no:get v1 draft) (CmpI Eq v7 v1 0)
         (no:get v1 changed) (CmpI Ne v8 v1 0) (Bin BinAnd TyBool v7 v7 v8)
         (If v7 (no:return new-draft) (no:return write-child))) Skip)
     (no:get v1 next) (no:get v2 length) (Cmp Ult v7 v1 v2)
     (If v7 (no:return next-child) (no:return finish))))
(= (no:program)
   (p1:program native_observe (Regions (Region facts RO 104 8)) (Registers) (Init)
     (Seq (Base v11 facts) (TFund 1) (no:get v1 phase)
       (CmpI Eq v7 v1 0) (If v7 (no:descend) Skip)
       (CmpI Eq v7 v1 1) (If v7 (no:variable) Skip)
       (CmpI Eq v7 v1 2) (If v7 (no:ascend) Skip)
       (Imm v1 1) (Return UNSUPPORTED v1))))
!(let* (($text (system:arg 0)) ($notes (system:arg 1))) (p1:write no:program $text $notes))
