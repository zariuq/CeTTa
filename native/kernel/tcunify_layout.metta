; The state words of native_tcunify, its answers and what it asks room for.
; The words the host copies in alternate between its tables, so that a
; compiler does not copy two at once across a store just made to one.
(= (tu:f phase) 0) (= (tu:f floor) 1) (= (tu:f wlen) 2) (= (tu:f tlen) 3)
(= (tu:f wcap) 4) (= (tu:f tcap) 5) (= (tu:f epoch) 6) (= (tu:f need) 7)
(= (tu:f a) 8) (= (tu:f abase) 9) (= (tu:f b) 10) (= (tu:f bbase) 11)
(= (tu:f ak) 12) (= (tu:f bk) 13)
(= (tu:f pvar) 14) (= (tu:f pvbase) 15) (= (tu:f pt) 16) (= (tu:f ptbase) 17)
(= (tu:f pindex) 18) (= (tu:f plocal) 19) (= (tu:f closed) 20)
(= (tu:f dstart) 21) (= (tu:f dtop) 22) (= (tu:f dfrom) 23)
(= (tu:f astart) 24) (= (tu:f bstart) 25)
(= (tu:r solved) 0) (= (tu:r refuted) 1) (= (tu:r room) 2) (= (tu:r close) 3)
(= (tu:r yield) 4) (= (tu:r fault) 5)
(= (tu:n work) 1) (= (tu:n trail) 2) (= (tu:n epoch) 3)
