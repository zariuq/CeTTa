; Execute a validated finite constructor shape. Port values are normalized
; separately; this machine copies no source environment and creates no JIT code.
!(import! &self "../../vendor/tcalc-native/native/p1/p1.metta")
!(import! &self "constructor_layout.metta")
(= (nc:get $r $f) (Load state $r v11 (* 8 (nc:f $f))))
(= (nc:put $f $r) (Store state v11 (* 8 (nc:f $f)) $r))
(= (nc:set $f $v) (Seq (Imm v1 $v) (nc:put $f v1)))
(= (nc:inc $f) (Seq (nc:get v1 $f) (Imm v2 1) (Add v1 v1 v2) (nc:put $f v1)))
(= (nc:fail $r) (Seq (Imm v1 $r) (Return UNSUPPORTED v1)))
(= (nc:decode)
   (Seq (nc:get v2 cursor) (nc:put source v2) (Shl v2 v2 2)
     (Base v4 plan) (Addr plan v4 v4 v2 3 0)
     (Load plan v1 v4 0) (nc:put kind v1)
     (Load plan v1 v4 8) (nc:put a v1)
     (Load plan v1 v4 16) (nc:put b v1)
     (Load plan v1 v4 24) (nc:put c v1)))
; Output id in v1. Record it for the next constructor and advance.
(= (nc:finish)
   (Seq (nc:get v2 cursor) (Base v4 map) (Addr map v4 v4 v2 3 0)
     (Store map v4 0 v1) (nc:inc cursor) (nc:set mode 0)))
(= (nc:allocate)
   (Seq (nc:get v2 out-nodes) (nc:get v3 node-cap) (Cmp Ult v7 v2 v3)
     (If v7 Skip (nc:fail 2))
     (Shl v5 v2 2) (Add v5 v5 v2) (Base v4 output) (Addr output v4 v4 v5 3 0)
     (nc:get v1 kind) (Store output v4 0 v1)
     (nc:get v1 a) (Store output v4 8 v1)
     (nc:get v1 b) (Store output v4 16 v1)
     (nc:get v1 c) (Store output v4 24 v1)
     (nc:get v1 source) (Store output v4 32 v1)
     (Mov v1 v2) (Imm v3 1) (Add v2 v2 v3) (nc:put out-nodes v2)
     (nc:finish)))
(= (nc:variable)
   (Seq (nc:get v2 a) (nc:get v3 ports) (Cmp Ult v7 v2 v3) (If v7 Skip (nc:fail 1))
     (Shl v3 v2 1) (Base v4 keys) (Addr keys v4 v4 v3 3 0)
     (Load keys v1 v4 0) (nc:get v3 b) (Cmp Eq v7 v1 v3)
     (Load keys v1 v4 8) (nc:get v3 c) (Cmp Eq v8 v1 v3)
     (Bin BinAnd TyBool v7 v7 v8) (If v7 Skip (nc:fail 1))
     (Base v4 holes) (Addr holes v4 v4 v2 3 0) (Load holes v1 v4 0)
     (nc:get v2 seed-nodes) (CmpI Ne v7 v1 0) (Cmp Ult v8 v1 v2)
     (Bin BinAnd TyBool v7 v7 v8) (If v7 (nc:finish) (nc:fail 1))))
(= (nc:tuple)
   (Seq (nc:get v1 c) (CmpI Eq v7 v1 0) (If v7 Skip (nc:fail 1))
     (nc:get v1 a) (nc:get v2 b) (nc:get v3 edges)
     (Cmp Ule v7 v1 v3) (If v7 Skip (nc:fail 1)) (Sub v3 v3 v1)
     (Cmp Ule v7 v2 v3) (If v7 Skip (nc:fail 1))
     (nc:get v1 out-edges) (nc:get v3 edge-cap) (Cmp Ule v7 v1 v3)
     (If v7 Skip (nc:fail 1)) (Sub v3 v3 v1) (Cmp Ule v7 v2 v3)
     (If v7 Skip (nc:fail 2)) (nc:put first v1)
     (Add v1 v1 v2) (nc:put out-edges v1) (nc:set child 0) (nc:set mode 1)))
(= (nc:copy-child)
   (Seq (nc:get v1 child) (nc:get v2 b) (Cmp Ult v7 v1 v2)
     (If v7
       (Seq (nc:get v2 a) (Add v2 v2 v1) (Base v4 edges) (Addr edges v4 v4 v2 3 0)
         (Load edges v2 v4 0) (nc:get v3 source)
         (CmpI Ne v7 v2 0) (Cmp Ult v8 v2 v3) (Bin BinAnd TyBool v7 v7 v8)
         (If v7 Skip (nc:fail 1)) (Base v4 map) (Addr map v4 v4 v2 3 0)
         (Load map v2 v4 0) (nc:get v3 out-nodes)
         (CmpI Ne v7 v2 0) (Cmp Ult v8 v2 v3) (Bin BinAnd TyBool v7 v7 v8)
         (If v7 Skip (nc:fail 1)) (nc:get v3 first) (Add v3 v3 v1)
         (Base v4 out-edges) (Addr out-edges v4 v4 v3 3 0) (Store out-edges v4 0 v2)
         (nc:inc child))
       (Seq (nc:get v1 first) (nc:put a v1) (nc:allocate)))))
(= (nc:step)
   (Seq (TFund 1) (nc:get v1 cursor) (nc:get v2 nodes) (Cmp Ule v7 v2 v1)
     (If v7
       (Seq (nc:get v1 root) (Base v4 map) (Addr map v4 v4 v1 3 0)
         (Load map v1 v4 0) (Return FIRED v1)) Skip)
     (nc:decode) (nc:get v1 mode) (CmpI Eq v7 v1 1)
     (If v7 (nc:copy-child)
       (Seq (nc:inc expanded) (nc:get v1 kind) (CmpI Eq v7 v1 (nc:k constant))
         (If v7
           (Seq (nc:get v1 b) (nc:get v2 c) (Bin BinOr TyU64 v1 v1 v2)
             (CmpI Eq v7 v1 0) (If v7 (nc:allocate) (nc:fail 1)))
           (Seq (nc:get v1 kind) (CmpI Eq v7 v1 (nc:k variable))
             (If v7 (nc:variable)
               (Seq (CmpI Eq v7 v1 (nc:k tuple)) (If v7 (nc:tuple) (nc:fail 1))))))))))
(= (nc:program)
   (p1:program native_constructor
     (Regions (Region plan RO 32 8) (Region edges RO 0 8) (Region holes RO 0 8)
       (Region output RW 40 8) (Region out-edges RW 0 8) (Region map RW 8 8)
       (Region state RW 152 8) (Region keys RO 0 8)) (Registers) (Init)
     (Seq (Base v11 state)
       (Len v1 plan) (Shr v1 v1 5) (nc:put nodes v1)
       (Len v1 edges) (Shr v1 v1 3) (nc:put edges v1)
       (Len v1 holes) (Shr v1 v1 3) (nc:put ports v1)
       (Arg1 v2) (CmpI Ne v7 v2 0) (CmpI Ule v8 v2 4294967295)
       (Bin BinAnd TyBool v7 v7 v8) (If v7 Skip (nc:fail 1)) (nc:put node-cap v2)
       (Shl v3 v2 2) (Add v3 v3 v2) (Shl v3 v3 3)
       (Len v1 output) (Cmp Ule v7 v3 v1) (If v7 Skip (nc:fail 2))
       (Len v1 out-edges) (Shr v1 v1 3) (nc:put edge-cap v1)
       (Arg0 v1) (nc:put root v1) (nc:get v2 nodes) (CmpI Ne v7 v1 0) (Cmp Ult v8 v1 v2)
       (Bin BinAnd TyBool v7 v7 v8) (If v7 Skip (nc:fail 1))
       (Len v1 map) (Shr v1 v1 3) (Cmp Ule v7 v2 v1) (If v7 Skip (nc:fail 1))
       (Len v1 keys) (Shr v1 v1 4) (nc:get v2 ports) (Cmp Eq v7 v1 v2)
       (If v7 Skip (nc:fail 1))
       (nc:get v1 out-nodes) (nc:get v2 seed-nodes) (Cmp Eq v7 v1 v2)
       (CmpI Ne v8 v1 0) (Bin BinAnd TyBool v7 v7 v8) (If v7 Skip (nc:fail 1))
       (nc:get v2 node-cap) (Cmp Ule v7 v1 v2) (If v7 Skip (nc:fail 2))
       (nc:get v1 out-edges) (nc:get v2 edge-cap) (Cmp Ule v7 v1 v2) (If v7 Skip (nc:fail 2))
       (nc:set cursor 1) (nc:set mode 0) (nc:set expanded 0)
       (Imm v9 4294967295)
       (Loop v10 v9 4294967295 (nc:step)) (nc:fail 2))))
!(let* (($text (system:arg 0)) ($notes (system:arg 1))) (p1:write nc:program $text $notes))
