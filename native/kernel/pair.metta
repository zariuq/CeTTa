; One matching decision over scoped facts; storage and library operations
; remain explicit actions carried out by the host.
!(import! &self "../../vendor/tcalc-native/native/p1/p1.metta")
!(import! &self "pair_layout.metta")
(= (np:get $r $f) (Load facts $r v11 (* 8 (np:f $f))))
(= (np:return $a) (Seq (Imm v1 (np:a $a)) (Return FIRED v1)))
(= (np:truth)
   (Seq (np:get v1 equal) (CmpI Ne v7 v1 0) (If v7 (np:return skip) (np:return reject))))
(= (np:start)
   (Seq (np:get v1 wildcard) (CmpI Ne v7 v1 0) (If v7 (np:return skip) Skip)
     (np:get v1 one-way) (CmpI Ne v7 v1 0) (np:get v1 left-kind)
     (CmpI Eq v8 v1 (np:k variable)) (Bin BinAnd TyBool v7 v7 v8)
     (If v7 (np:return bind-left) Skip)
     (np:get v1 left-address) (np:get v2 right-address) (Cmp Eq v7 v1 v2)
     (np:get v1 left-kind) (CmpI Eq v8 v1 (np:k variable)) (Bin BinAnd TyBool v7 v7 v8)
     (np:get v1 acyclic) (CmpI Ne v8 v1 0) (Bin BinAnd TyBool v7 v7 v8)
     (np:get v1 self-variable) (CmpI Ne v8 v1 0) (Bin BinAnd TyBool v7 v7 v8)
     (np:get v1 left-variable) (np:get v2 right-variable) (Cmp Eq v8 v1 v2)
     (Bin BinAnd TyBool v7 v7 v8)
     (np:get v1 left-scope) (np:get v2 right-scope) (Cmp Eq v8 v1 v2)
     (Bin BinAnd TyBool v7 v7 v8)
     (If v7 (np:return skip) (np:return ask-closed))))
(= (np:bind-variable)
   (Seq (np:get v1 left-kind) (CmpI Eq v7 v1 (np:k variable))
     (If v7
       (Seq (np:get v1 left-bound) (CmpI Ne v7 v1 0) (If v7 (np:return dereference-left) Skip)
         (np:get v1 right-kind) (CmpI Eq v7 v1 (np:k variable))
         (If v7
           (Seq (np:get v1 right-bound) (CmpI Ne v7 v1 0) (If v7 (np:return dereference-right) Skip)
             (np:get v1 left-variable) (np:get v2 right-variable) (Cmp Eq v7 v1 v2)
             (np:get v1 left-scope) (np:get v2 right-scope) (Cmp Eq v8 v1 v2)
             (Bin BinAnd TyBool v7 v7 v8) (If v7 (np:return skip) Skip)
             (np:get v1 prefer-right) (CmpI Ne v7 v1 0) (If v7 (np:return bind-right) Skip)) Skip)
         (np:return bind-left)) Skip)
     (np:get v1 right-kind) (CmpI Eq v7 v1 (np:k variable))
     (If v7
       (Seq (np:get v1 right-bound) (CmpI Ne v7 v1 0)
         (If v7 (np:return dereference-right) (np:return bind-right))) Skip)))
(= (np:store $offset $r) (Store result v10 $offset $r))
(= (np:rest $r) (Seq (Imm v1 (np:r $r)) (np:store 8 v1)))
(= (np:lists)
   (Seq (np:get v1 left-list) (np:get v2 right-list)
     (CmpI Ne v7 v1 0) (CmpI Ne v8 v2 0) (Bin BinAnd TyBool v7 v7 v8)
     (If v7 Skip (np:return reject))
     (np:get v1 left-length) (np:get v2 left-open) (Imm v3 1) (Add v2 v2 v3)
     (Cmp Ule v7 v2 v1) (If v7 Skip (np:return reject)) (Sub v5 v1 v2)
     (np:get v1 right-length) (np:get v2 right-open) (Add v2 v2 v3)
     (Cmp Ule v7 v2 v1) (If v7 Skip (np:return reject)) (Sub v6 v1 v2)
     (Cmp Ult v7 v5 v6) (If v7 (np:store 0 v5) (np:store 0 v6))
     (Cmp Eq v7 v5 v6)
     (If v7
       (Seq (np:get v1 left-open) (np:get v2 right-open)
         (CmpI Ne v7 v1 0) (CmpI Ne v8 v2 0)
         (If v7 (If v8 (np:rest both) (np:rest left-empty-right))
                (If v8 (np:rest empty-left-right) (np:rest none))))
       (Seq (Cmp Ult v7 v5 v6)
         (If v7
           (Seq (np:get v1 left-open) (CmpI Ne v7 v1 0) (If v7 Skip (np:return reject))
             (np:rest right-suffix) (Imm v1 1) (Add v1 v1 v5) (np:store 16 v1)
             (Sub v1 v6 v5) (np:store 24 v1))
           (Seq (np:get v1 right-open) (CmpI Ne v7 v1 0) (If v7 Skip (np:return reject))
             (np:rest left-suffix) (Imm v1 1) (Add v1 v1 v6) (np:store 16 v1)
             (Sub v1 v5 v6) (np:store 24 v1)))))
     (np:return list)))
(= (np:after-closed)
   (Seq (np:get v1 one-way) (CmpI Ne v7 v1 0)
     (If v7
       (Seq (np:get v1 left-kind) (np:get v2 right-kind)
         (CmpI Eq v7 v1 (np:k variable)) (If v7 (np:return bind-left) Skip)
         (Cmp Eq v7 v1 v2) (If v7 Skip (np:return reject))) Skip)
     (np:get v1 known) (CmpI Ne v7 v1 0) (If v7 (np:truth) Skip)
     (np:bind-variable)
     (np:get v1 left-kind) (np:get v2 right-kind)
     (CmpI Eq v7 v1 (np:k symbol)) (CmpI Eq v8 v2 (np:k symbol))
     (Bin BinAnd TyBool v7 v7 v8)
     (If v7 (Seq (np:get v1 left-symbol) (np:get v2 right-symbol) (Cmp Eq v7 v1 v2)
       (If v7 (np:return skip) (np:return reject))) Skip)
     (np:get v1 left-kind) (np:get v2 right-kind)
     (CmpI Eq v7 v1 (np:k grounded)) (CmpI Eq v8 v2 (np:k grounded))
     (Bin BinAnd TyBool v7 v7 v8) (If v7 (np:return ask-grounded) Skip)
     (np:get v1 left-class) (np:get v2 right-class) (Cmp Eq v7 v1 v2)
     (If v7 Skip (np:return reject))
     (np:get v1 left-kind) (np:get v2 right-kind)
     (CmpI Eq v7 v1 (np:k expression)) (CmpI Eq v8 v2 (np:k expression))
     (Bin BinAnd TyBool v7 v7 v8) (If v7 Skip (np:return reject))
     (np:get v1 left-list) (np:get v2 right-list) (Bin BinOr TyU64 v1 v1 v2)
     (CmpI Ne v7 v1 0) (If v7 (np:lists) Skip)
     (np:get v1 left-length) (np:get v2 right-length) (Cmp Eq v7 v1 v2)
     (If v7 (Seq (np:store 0 v1) (np:return expression)) (np:return reject))))
(= (np:program)
   (p1:program native_pair
     (Regions (Region facts RO 224 8) (Region result RW 32 8)) (Registers) (Init)
     (Seq (Base v11 facts) (Base v10 result) (Imm v1 0)
       (Store result v10 0 v1) (Store result v10 8 v1) (Store result v10 16 v1) (Store result v10 24 v1)
       (TFund 1) (np:get v1 phase)
       (CmpI Eq v7 v1 0) (If v7 (np:start) Skip)
       (CmpI Eq v7 v1 1) (If v7 (np:after-closed) Skip)
       (CmpI Eq v7 v1 2) (If v7 (np:truth) Skip)
       (Imm v1 1) (Return UNSUPPORTED v1))))
!(let* (($text (system:arg 0)) ($notes (system:arg 1))) (p1:write np:program $text $notes))
