(block "natural order" "nat.cmp" (nat-order cmp.lt cmp.eq cmp.gt) "proved" "natCmp_iff, natCmp_binding (Megalodon/RuleModuleBindings.lean): nat.cmp's rules are the numeric order of unary numerals, which rc_nat_cmp computes on immediates (the unary view: UNat.toNat_ofNat, Unary.tag_eq_s_iff); trusted: the comparison of uint64_t" (rules "NAT-CMP-ZZ" "NAT-CMP-ZS" "NAT-CMP-SZ" "NAT-CMP-SS"))
(block "natural equality" "nat.eq" (equal bool.t bool.f) "proved" "natEq_iff, natEq_binding: nat.eq's rules answer bool.t exactly on equal numerals; trusted: two immediates are the same word exactly when they hold the same number" (rules "NAT-EQ-EQ" "NAT-EQ-LT" "NAT-EQ-GT"))
(block "natural addition" "nat.add" (nat-add) "proved" "natAdd_iff, cNatAdd_refines, cNatAdd_binding: nat.add's rules are addition, which rc_nat_add computes wherever it gives a value; checked at run time: the immediate range" (rules "NAT-ADD-Z" "NAT-ADD-S"))
(block "name equality" "name.eq" (equal bool.t bool.f) "proved" "nameEq_iff, nameEq_binding (through interning_eq_iff): name.eq's rules decide equality of bit strings, and two interned names are equal exactly when they are one node; trusted: a node's id stands for its pointer" (rules "NAME-EQ-NN" "NAME-EQ-NO" "NAME-EQ-NI" "NAME-EQ-ON" "NAME-EQ-OO" "NAME-EQ-OI" "NAME-EQ-IN" "NAME-EQ-IO" "NAME-EQ-II"))
(block "type equality" "tp.eq" (equal bool.t bool.f) "proved" "tpEq_iff, tpEq_binding: tp.eq's rules (TP-EQ-HEADS for different heads, a rule per head) decide syntactic equality of types; trusted: a node's id stands for its pointer" (rules "TP-EQ-HEADS" "TP-EQ-VAR" "TP-EQ-PROP" "TP-EQ-BASE" "TP-EQ-ARR" "TP-EQ-ALL"))
(block "term equality" "tm.eq" (equal bool.t bool.f) "proved" "tmEq_iff, tmEq_binding: tm.eq's rules (TM-EQ-HEADS for different heads, a rule per head) decide syntactic equality of terms; trusted: a node's id stands for its pointer" (rules "TM-EQ-HEADS" "TM-EQ-DB" "TM-EQ-NAMED" "TM-EQ-PRIM" "TM-EQ-APP" "TM-EQ-LAM" "TM-EQ-IMP" "TM-EQ-ALL" "TM-EQ-TAPP" "TM-EQ-TLAM" "TM-EQ-TALL"))
(memo "normal form" "tm.nf" "proved" "tm.nf is a function of an interned term: memo_sound, memo2_sound; trusted: rc_memo.c is the model" (rules "NF-DB" "NF-NAMED" "NF-PRIM" "NF-APP" "NF-LAM" "NF-IMP" "NF-ALL" "NF-TAPP" "NF-TLAM" "NF-TALL"))
(memo "delta" "tm.delta" "proved" "tm.delta is a function of an interned theory and term: memo_sound, memo2_sound; trusted: rc_memo.c is the model" (rules "DELTA-DB" "DELTA-NAMED" "DELTA-PRIM" "DELTA-APP" "DELTA-LAM" "DELTA-IMP" "DELTA-ALL" "DELTA-TAPP" "DELTA-TLAM" "DELTA-TALL"))
(memo "term lookup" "ds.term" "proved" "ds.term is a function of interned declarations and a name: memo_sound, memo2_sound; trusted: rc_memo.c is the model" (rules "TERM-NIL" "TERM-PARAM-HIT" "TERM-PARAM-NEXT" "TERM-DEF-HIT" "TERM-DEF-NEXT" "TERM-REAL-HIT" "TERM-REAL-NEXT" "TERM-SKIP-AXIOM" "TERM-SKIP-THM"))
(memo "known lookup" "ds.known" "proved" "ds.known is a function of interned declarations and a name: memo_sound, memo2_sound; trusted: rc_memo.c is the model" (rules "KNOWN-NIL" "KNOWN-AXIOM-HIT" "KNOWN-AXIOM-NEXT" "KNOWN-THM-HIT" "KNOWN-THM-NEXT" "KNOWN-SKIP-PARAM" "KNOWN-SKIP-DEF" "KNOWN-SKIP-REAL"))
(memo "type inference" "tm.infer" "proved" "tm.infer is a function of an interned theory, depth, type list and term: memo_sound, memo2_sound; trusted: rc_memo.c is the model" (rules "INFER-DB" "INFER-PRIM" "INFER-NAMED" "INFER-APP" "INFER-TAPP" "INFER-LAM" "INFER-TLAM" "INFER-IMP" "INFER-ALL"))
(memo "instantiation" "tm.inst" "proved" "tm.inst is a function of a depth and two interned terms: memo_sound, memo2_sound; trusted: rc_memo.c is the model" (rules "TM-INST-DB-LT" "TM-INST-DB-EQ" "TM-INST-DB-GT" "TM-INST-NAMED" "TM-INST-PRIM" "TM-INST-APP" "TM-INST-LAM" "TM-INST-IMP" "TM-INST-ALL" "TM-INST-TAPP" "TM-INST-TLAM" "TM-INST-TALL"))
(memo "protection" "tm.prot" "proved" "tm.prot is a function of an interned term: memo_sound, memo2_sound; trusted: rc_memo.c is the model" (rules "TM-PROT-DB" "TM-PROT-NAMED" "TM-PROT-PRIM" "TM-PROT-APP" "TM-PROT-LAM" "TM-PROT-IMP" "TM-PROT-ALL" "TM-PROT-TAPP" "TM-PROT-TLAM" "TM-PROT-TALL"))
