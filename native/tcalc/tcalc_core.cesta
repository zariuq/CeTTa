        (updates-field 0 flat_words))
      (function explorer_free (takes-record 0))
      (function explorer_state (updates-record 0) (buffer 1) (nullable 1))
      (function run_in_order (buffer 2) (preserves-field 0 row))
      (function full_successor (buffer 1)
        )
      (function flat_plan (element 2) (element 3))
      (function tc_program_flat (pointee 0 terms))
      (function enumeration_step (pointee 0 out))
      (function successors (updates-record 0) (updates-field 1 state))
      (function expand (updates-record 0) (stores-field 0 row null) (updates-field 2 state))
      (function tc_explore (pointee 0 terms) (returns-own heap nullable)
        (returns-pointee ((row) (owns heap)) ((start) (owns heap)) ((size) (owns heap))
          ((amb_start) (owns heap)) ((amb_size) (owns heap)) ((amb_matches) (owns heap))))
      (function run_path (updates-record 0) (stores-field 0 row null)
        (updates-field 1 row) (updates-field 1 start) (updates-field 1 size)
        (updates-field 1 amb_start) (updates-field 1 amb_size) (updates-field 1 amb_matches))
      (function explore_state (context 0 Exploration) (pointee 0 x) (updates-pointee 0 x)
        (pointee 0 o) (updates-record 2)
        (preserves-field 0 (x row)) (updates-field 0 (next state))
        (preserves-field 0 (x store spend))
        (updates-field 0 (o row)) (updates-field 0 (o start)) (updates-field 0 (o size))
        (updates-field 0 (o amb_start)) (updates-field 0 (o amb_size))
        (updates-field 0 (o amb_matches)))
      (function tc_canonical_key (buffer 1) (returns-own heap nullable)
        )
