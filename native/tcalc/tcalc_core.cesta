        (field work (owns heap nullable) (count work_len)) (field build (owns heap nullable) (count build_len))
        (field native_out (owns heap nullable) (count native_out_cap))
        (field native_stack (owns heap nullable) (count native_stack_cap)))
      (function tc_kernel_unify (updates-record 0) (updates-record 1))
      (function tc_kernel_output (updates-record 0) (updates-record 1) (buffer 2) (buffer 6))
      (record TcUnifyStore (field node (borrow read) (count nodes)) (field item (borrow read) (count items))
        (field local (borrow write) (count locals)) (field unknown (borrow write) (count unknowns))
        (field trail (borrow write) (count trail_cap)) (field work (borrow write) (count work_cap))
        (field seen (borrow write) (count seen_cap)) (field state (borrow write) (count state_words)))
      (foreign cetta_kernel_tcalc_unify (updates-record 0)
        (obligation "Synchronously reads the borrowed term nodes and items and writes only the borrowed local, unknown, trail, work, seen and state words, each within its count. Retains no pointer, allocates nothing and makes no term."))
      (record TcBuildStore (field node (borrow read) (count nodes)) (field item (borrow read) (count items))
        (field local (borrow read) (count locals)) (field unknown (borrow read) (count unknowns))
        (field seen (borrow write) (count seen_cap)) (field memo (borrow write) (count memo_cap))
        (field out (borrow write) (count out_cap)) (field stack (borrow write) (count stack_cap))
        (field state (borrow write) (count state_words)))
      (foreign cetta_kernel_tcalc_build (updates-record 0)
        (obligation "Synchronously reads the borrowed term nodes, items, locals and unknowns and writes only the borrowed seen, memo, out, stack and state words, each within its count. Retains no pointer, allocates nothing and makes no term."))
