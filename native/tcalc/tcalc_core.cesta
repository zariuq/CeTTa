(cesta native-c/1 compact-c/2
  (unit
    (ownership
      (check-all)
      (allocator heap (malloc calloc) free (resize realloc)
        (obligation "malloc and calloc give fresh storage of the requested extent or null; realloc moves an allocation of the family to fresh storage of the requested extent and releases the old, or returns null and changes nothing; free releases one allocation of the family once and accepts null."))
      (foreign memset (buffer 0) (returns-borrow 0)
        (obligation "Writes the byte c to the first n bytes of the buffer, which holds them; retains no pointer."))
      (foreign memcpy (buffer 0) (buffer 1) (returns-borrow 0)
        (obligation "Copies n bytes from the second buffer to the first; both hold them and do not overlap; retains no pointer."))
      (foreign memcmp (buffer 0) (buffer 1)
        (obligation "Reads the first n bytes of both buffers, which hold them; retains no pointer."))
      (foreign strlen (buffer 0)
        (obligation "Reads a NUL-terminated string within its buffer; retains no pointer."))
      (foreign fwrite (buffer 0) (opaque 3)
        (obligation "Writes the requested bytes from the supplied buffer to the FILE stream and retains no pointer."))
      (foreign fprintf (opaque 0) (variadic-read)
        (obligation "Formats the supplied scalar values to the FILE stream and retains no pointer."))
      (foreign fputc (opaque 1)
        (obligation "Writes one byte to the FILE stream and retains no pointer."))
      (foreign snprintf (buffer 0) (variadic-read)
        (obligation "Formats scalar and borrowed string arguments into the bounded byte buffer and retains no pointer."))
      (record TcTerms (field node (owns heap nullable) (count nodes)) (field item (owns heap nullable) (count items))
        (field byte (owns heap nullable) (count bytes)) (field slot (owns heap nullable) (count slots))
        (field seen (owns heap nullable) (count seen_cap)) (field seen_value (owns heap nullable) (count seen_cap))
        (field decided (owns heap nullable) (count decided_len)))
      (record Solver (field local (owns heap nullable) (count local_cap))
        (field unknown (owns heap nullable) (count unknown_cap)) (field trail (owns heap nullable) (count trail_len))
        (field work (owns heap nullable) (count work_len)) (field build (owns heap nullable) (count build_len)))
      (record ProgramView (field rule (borrow read nullable) (count rules))
        (field term (borrow read nullable) (count terms)) (field check (borrow read nullable) (count checks))
        (field name (cstring nullable)))
      (callback TcDecide (field TcInterpretation flat)
        (buffer 0) (buffer 2) (buffer 4) (buffer 6) (buffer 8) (buffer 10))
      (callback TcStoreOpen (field TcStoreOps open) (opaque 0) (nullable 0) (stores 3 0))
      (callback TcStoreNext (field TcStoreOps next) (opaque 0) (nullable 0))
      (callback TcStoreClose (field TcStoreOps close) (opaque 0) (nullable 0))
      (callback TcStoreImport (field TcStoreOps import) (opaque 0) (nullable 0) (shallow 1))
      (callback TcStoreCommit (field TcStoreOps commit) (opaque 0) (nullable 0) (buffer 2) (buffer 4))
      (callback TcStoreSpend (field TcStoreOps spend) (opaque 0) (nullable 0))
      (callback RunExpand (targets explore_state))
      (record TcInterpretation (field region (borrow read nullable) (count regions))
        (field flat (callback TcDecide nullable)))
      (record TcStoreOps (field store (opaque nullable)) (field open (callback TcStoreOpen nullable))
        (field next (callback TcStoreNext nullable)) (field close (callback TcStoreClose nullable))
        (field import (callback TcStoreImport nullable)) (field commit (callback TcStoreCommit nullable))
        (field spend (callback TcStoreSpend nullable)))
      (record RowOrder (field node (borrow read) (count nodes))
        (field shape (borrow read) (count count)) (field row (borrow read) (count count)))
      (record StateTable (field state (owns heap nullable) (count states)) (field row (owns heap nullable) (count rows))
        (field slot (owns heap nullable) (count slots)) (field ground (owns heap nullable) (count grounds)))
      (record Fired (field firing (owns heap nullable) (count firings)) (field term (owns heap nullable) (count terms))
        (field slot (owns heap nullable) (count slots)) (field first (owns heap nullable) (count firsts)))
      (record TcProgram (field terms (borrow write)) (field rule (owns heap nullable) (count rules))
        (field term (owns heap nullable) (count terms_len)) (field check (owns heap nullable) (count checks_len))
        (field name (owns heap nullable) (count name_len)) (field row (owns heap nullable) (count rows)))
      (record Explorer (field terms (borrow write) (pointee))
        (field row (borrow read nullable) (count rows))
        (field member (owns heap nullable) (count members)) (field selection (owns heap nullable) (count selections))
        (field known (owns heap nullable) (count known_cap)) (field next (owns heap nullable) (count next_len))
        (field pick (owns heap nullable) (count pick_cap)) (field plans (owns heap nullable) (count plans_len))
        (field flat_words (owns heap nullable) (count flat_words_cap))
        (field key (owns heap nullable) (count key_cap))
        (field selected (borrow read nullable)))
      (record TcDecideScope (field x (borrow write)))
      (record Bag (field member (owns heap nullable) (count len)) (field base (owns heap nullable) (count blen))
        (field taken (owns heap nullable) (count rows)) (field read (owns heap nullable) (count rows)))
      (record RunOrder (field member (owns heap nullable) (count len))
        (field base (owns heap nullable) (count blen))
        (field taken (borrow read) (count rows)) (field read (borrow read) (count rows)))
      (record Successors (field state (owns heap nullable) (count len)))
      (record Enumeration (field out (borrow write)) (field bags (owns heap nullable) (count bags_len))
        (field bag_start (owns heap nullable) (count starts)) (field bag_result (owns heap nullable) (count results)))
      (record TcOutcomes (field row (owns heap nullable) (count rows)) (field start (owns heap nullable) (count starts))
        (field size (owns heap nullable) (count sizes)) (field amb_start (owns heap nullable) (count ambs))
        (field amb_size (owns heap nullable) (count amb_sizes))
        (field amb_matches (owns heap nullable) (count amb_match_len)))
      (record RunGraph (field order (owns heap nullable) (count len)) (field place (owns heap nullable) (count places))
        (field edge (owns heap nullable) (count edges)) (field first (owns heap nullable) (count firsts)))
      (record RunVisits (field state (owns heap nullable) (count slots)) (field phase (owns heap nullable) (count slots)))
      (record Exploration (field x (borrow write)) (field o (borrow write)))
      (record TcRule (field name (cstring nullable))
        (field take (borrow read nullable) (count takes))
        (field read (borrow read nullable) (count reads))
        (field tell (borrow read nullable) (count tells 2))
        (field check (borrow read nullable) (count checks))
        (field make (borrow read nullable) (count makes)))
      (function program_view (returns-record ((rule) (borrow 0 rule)) ((term) (borrow 0 term))
        ((check) (borrow 0 check)) ((name) (borrow 0 name))))
      (function terms_release (owns 0 heap))
      (function program_release (owns 0 heap))
      (function outcomes_release (owns 0 heap))
      (function solver_free (takes-field 0 local) (takes-field 0 unknown) (takes-field 0 trail)
        (takes-field 0 work) (takes-field 0 build))
      (function states_free (takes-field 0 state) (takes-field 0 row) (takes-field 0 slot) (takes-field 0 ground))
      (function fired_free (takes-field 0 firing) (takes-field 0 term) (takes-field 0 slot) (takes-field 0 first))
      (function run_graph_free (takes-field 0 order) (takes-field 0 place) (takes-field 0 edge)
        (takes-field 0 first))
      (function run_visits_free (takes-field 0 state) (takes-field 0 phase))
      (function rows_hash (buffer 0))
      (function fired_hash (buffer 2))
      (function fired_find (buffer 3))
      (function fired_add (buffer 3))
      (function selections_fit (buffer 2) (buffer 5))
      (function members_within (buffer 0) (buffer 2))
      (function nth_least_state (buffer 1))
      (function node_of (returns-borrow 0 node))
      (function tc_bytes (returns-borrow 0 byte))
      (function tc_program_rule_name (returns-borrow 0 name))
      (function walk_seen (initializes 2 when-true))
      (function tc_program_rows (returns-borrow 0 row))
      (function member_pick (element 1) (returns-borrow 0 selection))
      (function tc_outcome_rows (returns-borrow 0 row))
      (function tc_ambiguous_rows (returns-borrow 0 row))
      (function kept_bag (returns-borrow 0 bags) (initializes 2))
      (function same_node (buffer 3) (buffer 4))
      (function selection_hash (buffer 2))
      (function state_index (buffer 1))
      (function intern (buffer 2) (buffer 3))
      (function head_length_order (buffer 0))
      (function ground_order (buffer 0))
      (function same_rule (element 1) (element 2))
      (function flat_constant (element 0))
      (function flat_match_from (element 2))
      (function flat_decide (element 2))
      (function flat_start (updates-field 0 plans)
        (updates-field 0 flat_words))
      (function pattern_at (element 1))
      (function tell_at (element 1))
      (function make_at (element 1))
      (function check_at (element 1))
      (function checks_hold (element 1))
      (function tells_hold (element 1))
      (function admitted (element 1))
      (function append_made (element 1))
      (function handle_bag (pointee 2 out))
      (function enumerate_bags (pointee 3 out))
      (function successor_state (buffer 1))
      (function frame (element 2))
      (function identical_before (element 1))
      (function own_successor (element 1))

      (function tc_print (opaque 2))
      (function tc_terms_new (returns-own heap nullable)
        (returns-pointee ((node) (owns heap)) ((item) (owns heap)) ((byte) (owns heap))
          ((slot) (owns heap)) ((seen) (owns heap)) ((seen_value) (owns heap))
          ((decided) (owns heap))))
      (function tc_expression (buffer 1)
        )
      (function reserve (grows 0 heap))
      (function sort_terms (buffer 1)
        )
      (function sort_positions (buffer 1)
        )
      (function canonical_form (buffer 1) (initializes 4))
      (function renumber_from (buffer 3)
        )
      (function renumber (buffer 3))
      (function tc_program_new (returns-own heap nullable)
        (returns-pointee ((terms) (borrow 0))
          ((rule) (owns heap)) ((term) (owns heap))
          ((check) (owns heap)) ((name) (owns heap)) ((row) (owns heap))))
      (function tc_program_terms (returns-borrow 0 terms))
