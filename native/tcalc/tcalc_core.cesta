        (updates-field 0 amb_size) (updates-field 0 amb_matches))
      (function run_visit (updates-field 0 state) (updates-field 0 phase))
      (function run_breadth_first (calls 2 RunExpand) (context 3 Exploration)
        (pointee 3 x) (updates-pointee 3 x) (pointee 3 o)
        (updates-field 0 order) (updates-field 0 place)
        (updates-field 0 edge) (updates-field 0 first)
        (preserves-field 3 (x row)) (preserves-field 3 (x store spend))
