(cesta native-c/1 compact-c/2
  (unit
    (ownership
      (check-all)
      (foreign cetta_kernel_current
        (obligation "Returns the configured execution mode without retaining pointers or modifying terms or solver state."))
      (foreign cetta_kernel_note_c
        (obligation "Increments only the kernel diagnostic counter and retains no pointer."))
      (allocator heap (malloc calloc) free (resize realloc)
        (obligation "malloc and calloc give fresh storage of the requested extent or null; realloc moves an allocation of the family to fresh storage of the requested extent and releases the old, or returns null and changes nothing; free releases one allocation of the family once and accepts null."))
      (foreign memset (buffer 0) (returns-borrow 0)
        (obligation "Writes the byte c to the first n bytes of the buffer, which holds them; retains no pointer."))
      (foreign memcpy (buffer 0) (buffer 1) (returns-borrow 0)
        (obligation "Copies n bytes from the second buffer to the first; both hold them and do not overlap; retains no pointer."))
      (foreign memcmp (buffer 0) (buffer 1)
        (obligation "Reads the first n bytes of both buffers, which hold them; retains no pointer."))
      (foreign strlen (buffer 0)
        (obligation "Reads a NUL-terminated string within its buffer; retains no pointer."))
      (foreign fwrite (buffer 0) (opaque 3)
        (obligation "Writes the requested bytes from the supplied buffer to the FILE stream and retains no pointer."))
      (foreign fprintf (opaque 0) (variadic-read)
        (obligation "Formats the supplied scalar values to the FILE stream and retains no pointer."))
      (foreign fputc (opaque 1)
        (obligation "Writes one byte to the FILE stream and retains no pointer."))
      (foreign snprintf (buffer 0) (variadic-read)
        (obligation "Formats scalar and borrowed string arguments into the bounded byte buffer and retains no pointer."))
      (record TcTerms (field node (owns heap nullable) (count nodes)) (field item (owns heap nullable) (count items))
        (field byte (owns heap nullable) (count bytes)) (field slot (owns heap nullable) (count slots))
        (field seen (owns heap nullable) (count seen_cap)) (field seen_value (owns heap nullable) (count seen_cap))
        (field decided (owns heap nullable) (count decided_len)))
      (record Solver (field local (owns heap nullable) (count local_cap))
