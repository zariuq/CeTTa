(cesta-export/1 (header CETTA_TCALC_LISTS_GENERATED_H) (profile gnu11)
 (include <stddef.h>)
 (include <stdint.h>)
 (include "tcalc_records.h")
 (use "../../vendor/cesta/macros/Worklists.module" Growable)
 (function tc_push_u32 Push (element uint32_t) (count size_t)
   (doc "Append one 32-bit value (a term, a row position); 1, or 0 with the list unchanged."))
 (function tc_push_u64 Push (element uint64_t) (count size_t)
   (doc "Append one 64-bit value; 1, or 0 with the list unchanged."))
 (function tc_push_char Push (element char) (count size_t)
   (doc "Append one byte; 1, or 0 with the list unchanged."))
 (function tc_push_flag Push (element bool) (count size_t)
   (doc "Append one flag; 1, or 0 with the list unchanged."))
 (function tc_push_node Push (element TcNode) (count size_t)
   (doc "Append one term record; 1, or 0 with the list unchanged."))
 (function tc_push_rule Push (element TcStoredRule) (count size_t)
   (doc "Append one rule record; 1, or 0 with the list unchanged."))
 (function tc_push_state Push (element TcState) (count size_t)
   (doc "Append one state record; 1, or 0 with the list unchanged."))
 (function tc_push_member Push (element TcMember) (count size_t)
   (doc "Append one match record; 1, or 0 with the list unchanged.")))
