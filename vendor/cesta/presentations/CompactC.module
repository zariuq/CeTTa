      EscapedVariable . Expr ::= "(" "id" COrdinaryName ")";
      EscapedDeclaratorName . DirectDeclarator ::= "(" "name" CGeneralName ")";
    }
    Equations {
      (ExplicitParameterTypes a) == (ParameterTypes a);
      (CompactParameter a b) == (NamedParameter a b);
      (CompactInitializerElement x) == (InitializerElement x);
      (CompactArray name length) == (ArrayDeclarator name (NoTypeQualifiers) (SomeExpression length));
      (CompactIncompleteArray name) == (ArrayDeclarator name (NoTypeQualifiers) (NoExpression));
      (CompactFunctionPointer name parameters) ==
        (Declarator (FunctionDeclarator (ParenthesizedDeclarator (PointerDeclarator (Pointer (NoTypeQualifiers)) (NameDeclarator name))) parameters));
      (CompactFunctionPointerArray name length parameters) ==
        (Declarator (FunctionDeclarator (ParenthesizedDeclarator (PointerDeclarator (Pointer (NoTypeQualifiers))
          (ArrayDeclarator (NameDeclarator name) (NoTypeQualifiers) (SomeExpression length)))) parameters));
      (LiteralInteger a) == (IntConst a);
      (LiteralFloat a) == (FloatConst a);
      (LiteralCharacter a) == (CharConst a);
      (LiteralString a) == (StringLiterals (List a));
      (BareUniqueSpecifierQualifiers a) == (UniqueSpecifierQualifiers a (NoTypeQualifiers));
      (SimpleAbstractParameter a) == (AbstractParameter a (NoAbstractDeclarator));
      (SimpleTypeName a) == (TypeName a (NoAbstractDeclarator));
      (StatementExpression a) == (ExpressionStatement (SomeFullExpression a));
      (EmptyStatement) == (ExpressionStatement (NoFullExpression));
      (StatementIf a b) == (SelectionStatement (If a b));
      (StatementIfElse a b c) == (SelectionStatement (IfElse a b c));
      (StatementSwitch a b) == (SelectionStatement (Switch a b));
      (StatementWhile a b) == (IterationStatement (While a b));
      (StatementDoWhile a b) == (IterationStatement (DoWhile a b));
      (StatementFor a b c d) == (IterationStatement (For a b c d));
      (StatementForDeclaration a b c d) == (IterationStatement (ForDeclaration a b c d));
      (StatementGoto a) == (JumpStatement (Goto a));
      (StatementLabel a b) == (LabeledStatement (Label a b));
      (StatementCase a b) == (LabeledStatement (Case a b));
      (StatementDefault a) == (LabeledStatement (Default a));
      (StatementGNUIndirectGoto a) == (JumpStatement (GNUIndirectGoto a));
      (StatementGNUCaseRange a b c) == (LabeledStatement (GNUCaseRange a b c));
      (StatementGNUAttributedLabel a b c) == (LabeledStatement (GNUAttributedLabel a b c));
      (StatementBreak) == (JumpStatement (Break));
      (StatementContinue) == (JumpStatement (Continue));
      (VariableName a b) == (Declaration a (InitDeclarators (List (InitDeclarator b))));
      (VariableValue a b c) == (Declaration a (InitDeclarators (List (InitDeclaratorValue b c))));
      (BlockVariableName a b) == (BlockDeclaration (Declaration a (InitDeclarators (List (InitDeclarator b)))));
      (BlockVariableValue a b c) == (BlockDeclaration (Declaration a (InitDeclarators (List (InitDeclaratorValue b c)))));
      (ExternalVariableName a b) == (ExternalDeclaration (Declaration a (InitDeclarators (List (InitDeclarator b)))));
      (ExternalVariableValue a b c) == (ExternalDeclaration (Declaration a (InitDeclarators (List (InitDeclaratorValue b c)))));
      (EscapedVariable a) == (Var a);
      (EscapedDeclaratorName a) == (NameDeclarator a);
      (UnqualifiedPointerDeclarator a) == (PointerDeclarator (Pointer (NoTypeQualifiers)) a);
      (BarePointer) == (Pointer (NoTypeQualifiers));
      (TypedefOnlySpec a) == (UniqueDeclarationSpecifiers (TypedefType a) (List));
      (GNUAttributeShort a) == (GNUAttribute (GNUAttributeKeyword) a);
      (GNUAttributePrefixShort a) == (GNUAttribute (GNUAttributeKeywordPrefix) a);
      (SpecTailsVoid a) == (UniqueDeclarationSpecifiers (Void) a);
      (BareSpecBool) == (UniqueDeclarationSpecifiers (Bool) (List));
      (SpecTailsBool a) == (UniqueDeclarationSpecifiers (Bool) a);
      (BareSpecChar) == (PrimitiveDeclarationSpecifiers (Char) (List));
      (SpecTailsChar a) == (PrimitiveDeclarationSpecifiers (Char) a);
      (BareSpecShort) == (PrimitiveDeclarationSpecifiers (Short) (List));
      (SpecTailsShort a) == (PrimitiveDeclarationSpecifiers (Short) a);
      (BareSpecInt) == (PrimitiveDeclarationSpecifiers (Int) (List));
      (SpecTailsInt a) == (PrimitiveDeclarationSpecifiers (Int) a);
      (BareSpecLong) == (PrimitiveDeclarationSpecifiers (Long) (List));
      (SpecTailsLong a) == (PrimitiveDeclarationSpecifiers (Long) a);
      (BareSpecFloat) == (PrimitiveDeclarationSpecifiers (Float) (List));
      (SpecTailsFloat a) == (PrimitiveDeclarationSpecifiers (Float) a);
      (BareSpecDouble) == (PrimitiveDeclarationSpecifiers (Double) (List));
      (SpecTailsDouble a) == (PrimitiveDeclarationSpecifiers (Double) a);
      (BareSpecSigned) == (PrimitiveDeclarationSpecifiers (Signed) (List));
      (SpecTailsSigned a) == (PrimitiveDeclarationSpecifiers (Signed) a);
      (SpecTailsUnsigned a) == (PrimitiveDeclarationSpecifiers (Unsigned) a);
      (BareSpecComplex) == (PrimitiveDeclarationSpecifiers (Complex) (List));
      (SpecTailsComplex a) == (PrimitiveDeclarationSpecifiers (Complex) a);
      (BareSpecGNUInt128) == (PrimitiveDeclarationSpecifiers (GNUInt128) (List));
      (BareSpecGNUFloat16) == (PrimitiveDeclarationSpecifiers (GNUFloat16) (List));
      (SpecTailsGNUInt128 a) == (PrimitiveDeclarationSpecifiers (GNUInt128) a);
      (SpecTailsGNUFloat16 a) == (PrimitiveDeclarationSpecifiers (GNUFloat16) a);
      (BareSpecGNUAutoType) == (UniqueDeclarationSpecifiers (GNUAutoType) (List));
      (SpecTailsGNUAutoType a) == (UniqueDeclarationSpecifiers (GNUAutoType) a);
      (BareSpecGNUFloat128) == (UniqueDeclarationSpecifiers (GNUFloat128) (List));
      (SpecTailsGNUFloat128 a) == (UniqueDeclarationSpecifiers (GNUFloat128) a);
      (BareSpecGNUFloat32) == (UniqueDeclarationSpecifiers (GNUFloat32) (List));
      (BareSpecGNUBFloat16) == (UniqueDeclarationSpecifiers (GNUBFloat16) (List));
      (SpecTailsGNUFloat32 a) == (UniqueDeclarationSpecifiers (GNUFloat32) a);
      (SpecTailsGNUBFloat16 a) == (UniqueDeclarationSpecifiers (GNUBFloat16) a);
      (BareSpecGNUFloat64) == (UniqueDeclarationSpecifiers (GNUFloat64) (List));
      (SpecTailsGNUFloat64 a) == (UniqueDeclarationSpecifiers (GNUFloat64) a);
      (BareSpecGNUFloat32x) == (UniqueDeclarationSpecifiers (GNUFloat32x) (List));
      (SpecTailsGNUFloat32x a) == (UniqueDeclarationSpecifiers (GNUFloat32x) a);
      (BareSpecGNUFloat64x) == (UniqueDeclarationSpecifiers (GNUFloat64x) (List));
      (SpecTailsGNUFloat64x a) == (UniqueDeclarationSpecifiers (GNUFloat64x) a);
      (BareSpecGNUFloat128x) == (UniqueDeclarationSpecifiers (GNUFloat128x) (List));
      (SpecTailsGNUFloat128x a) == (UniqueDeclarationSpecifiers (GNUFloat128x) a);
      (BareSpecGNUQuad) == (UniqueDeclarationSpecifiers (GNUQuad) (List));
      (SpecTailsGNUQuad a) == (UniqueDeclarationSpecifiers (GNUQuad) a);
      (BareSpecGNUSigned) == (PrimitiveDeclarationSpecifiers (GNUSigned) (List));
      (SpecTailsGNUSigned a) == (PrimitiveDeclarationSpecifiers (GNUSigned) a);
      (BareNonTypeTypedef) == (StorageSpecifier (Typedef));
      (BareTailTypedef) == (NonTypeSpecifierTail (StorageSpecifier (Typedef)));
      (PrefixSpecTypedef a) == (PrefixedDeclarationSpecifiers (StorageSpecifier (Typedef)) a);
      (BareNonTypeExtern) == (StorageSpecifier (Extern));
      (BareTailExtern) == (NonTypeSpecifierTail (StorageSpecifier (Extern)));
      (PrefixSpecExtern a) == (PrefixedDeclarationSpecifiers (StorageSpecifier (Extern)) a);
      (BareNonTypeStatic) == (StorageSpecifier (Static));
      (BareTailStatic) == (NonTypeSpecifierTail (StorageSpecifier (Static)));
      (PrefixSpecStatic a) == (PrefixedDeclarationSpecifiers (StorageSpecifier (Static)) a);
      (BareNonTypeThreadLocal) == (StorageSpecifier (ThreadLocal));
      (BareTailThreadLocal) == (NonTypeSpecifierTail (StorageSpecifier (ThreadLocal)));
      (PrefixSpecThreadLocal a) == (PrefixedDeclarationSpecifiers (StorageSpecifier (ThreadLocal)) a);
      (BareNonTypeAuto) == (StorageSpecifier (Auto));
      (BareTailAuto) == (NonTypeSpecifierTail (StorageSpecifier (Auto)));
      (PrefixSpecAuto a) == (PrefixedDeclarationSpecifiers (StorageSpecifier (Auto)) a);
      (BareNonTypeRegister) == (StorageSpecifier (Register));
      (BareTailRegister) == (NonTypeSpecifierTail (StorageSpecifier (Register)));
      (PrefixSpecRegister a) == (PrefixedDeclarationSpecifiers (StorageSpecifier (Register)) a);
      (BareNonTypeGNUThread) == (StorageSpecifier (GNUThread));
      (BareTailGNUThread) == (NonTypeSpecifierTail (StorageSpecifier (GNUThread)));
      (PrefixSpecGNUThread a) == (PrefixedDeclarationSpecifiers (StorageSpecifier (GNUThread)) a);
      (BareNonTypeConst) == (QualifierSpecifier (Const));
      (BareTailConst) == (NonTypeSpecifierTail (QualifierSpecifier (Const)));
      (PrefixSpecConst a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (Const)) a);
      (BareNonTypeRestrict) == (QualifierSpecifier (Restrict));
      (BareTailRestrict) == (NonTypeSpecifierTail (QualifierSpecifier (Restrict)));
      (PrefixSpecRestrict a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (Restrict)) a);
      (BareNonTypeVolatile) == (QualifierSpecifier (Volatile));
      (BareTailVolatile) == (NonTypeSpecifierTail (QualifierSpecifier (Volatile)));
      (PrefixSpecVolatile a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (Volatile)) a);
      (BareNonTypeAtomicQualifier) == (QualifierSpecifier (AtomicQualifier));
      (BareTailAtomicQualifier) == (NonTypeSpecifierTail (QualifierSpecifier (AtomicQualifier)));
      (PrefixSpecAtomicQualifier a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (AtomicQualifier)) a);
      (BareNonTypeGNUConst) == (QualifierSpecifier (GNUConst));
      (BareTailGNUConst) == (NonTypeSpecifierTail (QualifierSpecifier (GNUConst)));
      (PrefixSpecGNUConst a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (GNUConst)) a);
      (BareNonTypeGNUConstPrefix) == (QualifierSpecifier (GNUConstPrefix));
      (BareTailGNUConstPrefix) == (NonTypeSpecifierTail (QualifierSpecifier (GNUConstPrefix)));
      (PrefixSpecGNUConstPrefix a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (GNUConstPrefix)) a);
      (BareNonTypeGNUVolatile) == (QualifierSpecifier (GNUVolatile));
      (BareTailGNUVolatile) == (NonTypeSpecifierTail (QualifierSpecifier (GNUVolatile)));
      (PrefixSpecGNUVolatile a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (GNUVolatile)) a);
      (BareNonTypeGNUVolatilePrefix) == (QualifierSpecifier (GNUVolatilePrefix));
      (BareTailGNUVolatilePrefix) == (NonTypeSpecifierTail (QualifierSpecifier (GNUVolatilePrefix)));
      (PrefixSpecGNUVolatilePrefix a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (GNUVolatilePrefix)) a);
      (BareNonTypeGNURestrict) == (QualifierSpecifier (GNURestrict));
      (BareTailGNURestrict) == (NonTypeSpecifierTail (QualifierSpecifier (GNURestrict)));
      (PrefixSpecGNURestrict a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (GNURestrict)) a);
      (BareNonTypeGNURestrictPrefix) == (QualifierSpecifier (GNURestrictPrefix));
      (BareTailGNURestrictPrefix) == (NonTypeSpecifierTail (QualifierSpecifier (GNURestrictPrefix)));
      (PrefixSpecGNURestrictPrefix a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (GNURestrictPrefix)) a);
      (BareNonTypeInline) == (FunctionSpecifier (Inline));
      (BareTailInline) == (NonTypeSpecifierTail (FunctionSpecifier (Inline)));
      (PrefixSpecInline a) == (PrefixedDeclarationSpecifiers (FunctionSpecifier (Inline)) a);
      (BareNonTypeNoreturn) == (FunctionSpecifier (Noreturn));
      (BareTailNoreturn) == (NonTypeSpecifierTail (FunctionSpecifier (Noreturn)));
      (PrefixSpecNoreturn a) == (PrefixedDeclarationSpecifiers (FunctionSpecifier (Noreturn)) a);
      (BareNonTypeGNUInline) == (FunctionSpecifier (GNUInline));
      (BareTailGNUInline) == (NonTypeSpecifierTail (FunctionSpecifier (GNUInline)));
      (PrefixSpecGNUInline a) == (PrefixedDeclarationSpecifiers (FunctionSpecifier (GNUInline)) a);
      (BareNonTypeGNUInlinePrefix) == (FunctionSpecifier (GNUInlinePrefix));
      (BareTailGNUInlinePrefix) == (NonTypeSpecifierTail (FunctionSpecifier (GNUInlinePrefix)));
      (PrefixSpecGNUInlinePrefix a) == (PrefixedDeclarationSpecifiers (FunctionSpecifier (GNUInlinePrefix)) a);
      (StatementAddAssign x y) == (ExpressionStatement (SomeFullExpression (AddAssign x y)));
      (ReturnValue value) == (JumpStatement (Return (SomeFullExpression value)));
      (ReturnVoid) == (JumpStatement (Return (NoFullExpression)));
      (CompoundStatement body) == (CompoundStatement (Block body));

      (UIntSpec) == (PrimitiveDeclarationSpecifiers (Unsigned) (List));
      (VoidSpec) == (UniqueDeclarationSpecifiers (Void) (List));
      (PointerName name) == (PointerDeclarator (Pointer (NoTypeQualifiers)) (NameDeclarator name));
      (PrototypeFunction spec name parameters body) ==
        (FunctionDefinition spec (Declarator (FunctionDeclarator (NameDeclarator name) parameters)) (List) (Block body));
    }
  }
}
