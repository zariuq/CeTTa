      GNUAttributedLabelDeclaration . LabeledStatement ::= "(" "attributed-label-decl" CGeneralName [GNUAttribute] Declaration ")";
      GNUCaseDeclaration . LabeledStatement ::= "(" "case-decl" Expr Declaration ")";
      GNUCaseRangeDeclaration . LabeledStatement ::= "(" "case-range-decl" Expr Expr Declaration ")";
      GNUDefaultDeclaration . LabeledStatement ::= "(" "default-decl" Declaration ")";
      GNUAttributeStatement . Statement ::= "(" "attributes-statement" [GNUAttribute] ")";
