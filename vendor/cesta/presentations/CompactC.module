Module CompactCPresentation {
  Theory CompactBasics() {
    Empty Terms {
      Var . Expr ::= COrdinaryName;
      IntConst . Expr ::= "(" "int" CInteger ")";
      Add . Expr ::= "(" "+" Expr Expr ")";
      Multiply . Expr ::= "(" "*" Expr Expr ")";
      Indirection . Expr ::= "(" "*" Expr ")";
      AddAssign . Expr ::= "(" "+=" Expr Expr ")";
      StatementAddAssign . Statement ::= "(" "+=" Expr Expr ")";
      ReturnValue . Statement ::= "(" "return" Expr ")";
      ReturnVoid . Statement ::= "(" "return" ")";
      Block . Block ::= "(" "block" [BlockItem] ")";
      BlockStatement . BlockItem ::= Statement;
      BlockDeclaration . BlockItem ::= "(" "declaration" Declaration ")";
      CompoundStatement . Statement ::= "(" "block" [BlockItem] ")";
      Declaration . Declaration ::= "(" "decl" DeclarationSpecifiers OptionalInitDeclarators ")";
      SimpleVariable . Declaration ::= "(" "var" DeclarationSpecifiers CGeneralName ")";
      UIntSpec . DeclarationSpecifiers ::= "unsigned";
      VoidSpec . DeclarationSpecifiers ::= "void";
      PointerName . Declarator ::= "(" "ptr" CGeneralName ")";
      NameOnly . Declarator ::= CGeneralName;
      NamedParameter . Parameter ::= "(" "param" DeclarationSpecifiers Declarator ")";
      ParameterTypes . ParameterTypeList ::= "(" "params" [Parameter] ")";
      PrototypeFunction . FunctionDefinition ::= "(" "fn" DeclarationSpecifiers CGeneralName ParameterTypeList [BlockItem] ")";
      ExternalFunction . ExternalDeclaration ::= FunctionDefinition;
      TranslationUnit . TranslationUnit ::= "(" "unit" [ExternalDeclaration] ")";
    }
    Equations {
      (StatementAddAssign x y) == (ExpressionStatement (SomeFullExpression (AddAssign x y)));
      (ReturnValue value) == (JumpStatement (Return (SomeFullExpression value)));
      (ReturnVoid) == (JumpStatement (Return (NoFullExpression)));
      (CompoundStatement body) == (CompoundStatement (Block body));
      (SimpleVariable spec name) == (Declaration spec (InitDeclarators (List (InitDeclarator (Declarator (NameDeclarator name))))));
      (UIntSpec) == (PrimitiveDeclarationSpecifiers (Unsigned) (List));
      (VoidSpec) == (UniqueDeclarationSpecifiers (Void) (List));
      (PointerName name) == (PointerDeclarator (Pointer (NoTypeQualifiers)) (NameDeclarator name));
      (NameOnly name) == (Declarator (NameDeclarator name));
      (PrototypeFunction spec name parameters body) ==
        (FunctionDefinition spec (Declarator (FunctionDeclarator (NameDeclarator name) parameters)) (List) (Block body));
    }
  }

  Theory CompactC() {
    Empty Terms {
