      GNUAsmInput . Statement ::= "(" "asm-input" GNUAsmKeyword [GNUAsmQualifier] [CString] [GNUAsmOperand] [GNUAsmOperand] ")";
      GNUAsmWithClobbers . Statement ::= "(" "asm-with-clobbers" GNUAsmKeyword [GNUAsmQualifier] [CString] [GNUAsmOperand] [GNUAsmOperand] [GNUAsmClobber] ")";
      GNUAsmLabels . Statement ::= "(" "asm-labels" GNUAsmKeyword [GNUAsmQualifier] [CString] [GNUAsmOperand] [GNUAsmOperand] [GNUAsmClobber] [GNUAsmLabel] ")";
      GNUAsmOperand . GNUAsmOperand ::= "(" "asm-operand" CString Expr ")";
      GNUAsmNamedOperand . GNUAsmOperand ::= "(" "asm-named-operand" CGeneralName CString Expr ")";
      GNUAsmClobber . GNUAsmClobber ::= CString;
      GNUAsmLabel . GNUAsmLabel ::= CGeneralName;
      GNUFileAsm . ExternalDeclaration ::= "(" "file-asm" GNUAsmKeyword [CString] ")";
