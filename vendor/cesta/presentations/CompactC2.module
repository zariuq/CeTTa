      StructStaticAssertion . StructDeclaration ::= StaticAssertion;
      GNUStructPragma . StructDeclaration ::= GNUPragma;
      GNUEmptyStructDeclaration . StructDeclaration ::= "(" ")";
      StructDeclarationExtension . StructDeclaration ::= "(" "__extension__" StructDeclaration ")";
      StructDeclarator . StructDeclarator ::= Declarator;
      BitFieldNamed . StructDeclarator ::= "(" ":" Declarator Expr2 ")";
      BitFieldAnonymous . StructDeclarator ::= "(" ":" Expr2 ")";
