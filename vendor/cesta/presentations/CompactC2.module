      GNUAttributeSpecifiers . DeclarationSpecifiers ::= "(" "attributes" [GNUAttribute] DeclarationSpecifiers ")";
      Inline . FunctionSpecifier ::= "inline";
      Noreturn . FunctionSpecifier ::= "_Noreturn";
      GNUInline . FunctionSpecifier ::= "__inline__";
      GNUInlinePrefix . FunctionSpecifier ::= "__inline";
      AlignasType . AlignmentSpecifier ::= "(" "_Alignas" "type" TypeName ")";
      AlignasExpression . AlignmentSpecifier ::= "(" "_Alignas" Expr2 ")";

      -- Structures, unions and enumerations.
      StructReferenceShort . StructSpecifier ::= "(" "struct" CGeneralName ")";
      StructDefinitionShort . StructSpecifier ::= "(" "struct" CGeneralName [StructDeclaration] ")";
      StructAnonymousShort . StructSpecifier ::= "(" "struct" [StructDeclaration] ")";
      UnionReferenceShort . StructSpecifier ::= "(" "union" CGeneralName ")";
      UnionDefinitionShort . StructSpecifier ::= "(" "union" CGeneralName [StructDeclaration] ")";
      UnionAnonymousShort . StructSpecifier ::= "(" "union" [StructDeclaration] ")";
      GNUEmptyStruct . StructSpecifier ::= "(" "empty-struct" StructOrUnion OptionalIdent ")";
      GNUAttributedStruct . StructSpecifier ::= "(" "attributed-struct" StructSpecifier GNUAttribute ")";
      GNUEnumAttributes . GNUEnumAttributes ::= "(" "attributes" [GNUAttribute] ")";
      GNUEnumDefinition . EnumSpecifier ::= "(" "enum" GNUEnumAttributes OptionalIdent [Enumerator] ")";
      GNUEnumDefinitionComma . EnumSpecifier ::= "(" "enum," GNUEnumAttributes OptionalIdent [Enumerator] ")";
      GNUEnumReference . EnumSpecifier ::= "(" "enum" GNUEnumAttributes CGeneralName ")";
