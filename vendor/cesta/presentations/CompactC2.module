      PrefixSQGNUConstPrefix . SpecifierQualifiers ::= "(" "__const" "." SpecifierQualifiers ")";
      PrefixSQGNUVolatile . SpecifierQualifiers ::= "(" "__volatile__" "." SpecifierQualifiers ")";
