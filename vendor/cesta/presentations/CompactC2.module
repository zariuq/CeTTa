      TriplePointer . Pointer ::= "***";
      Pointer . Pointer ::= "(" "*" OptionalTypeQualifiers ")";
      NestedPointer . Pointer ::= "(" "**" OptionalTypeQualifiers Pointer ")";
      NameDeclarator . DirectDeclarator ::= CGeneralName;
      EscapedDeclaratorName . DirectDeclarator ::= "(" "name" CGeneralName ")";
      ParenthesizedShort . DirectDeclarator ::= "(" Declarator ")";
      CompactArray . DirectDeclarator ::= "(" "[]" DirectDeclarator Expr1 ")";
      CompactIncompleteArray . DirectDeclarator ::= "(" "[]" DirectDeclarator ")";
      CompactStaticArray . DirectDeclarator ::= "(" "[]" DirectDeclarator "static" Expr1 ")";
      CompactVariableArray . DirectDeclarator ::= "(" "[]" DirectDeclarator "*" ")";
      ArrayDeclarator . DirectDeclarator ::= "(" "array" DirectDeclarator OptionalTypeQualifiers OptionalExpression ")";
      StaticArrayDeclarator . DirectDeclarator ::= "(" "static-array-declarator" DirectDeclarator OptionalTypeQualifiers Expr1 ")";
      QualifiedStaticArrayDeclarator . DirectDeclarator ::= "(" "qualified-static-array-declarator" DirectDeclarator [TypeQualifier] Expr1 ")";
      VariableArrayDeclarator . DirectDeclarator ::= "(" "variable-array-declarator" DirectDeclarator OptionalTypeQualifiers ")";
      FunctionParameters . DirectDeclarator ::= "(" "function" DirectDeclarator [Parameter] ")";
      FunctionVariadic . DirectDeclarator ::= "(" "function" DirectDeclarator [Parameter] "..." ")";
      FunctionUnspecified . DirectDeclarator ::= "(" "function" DirectDeclarator ")";
      OldFunctionDeclarator . DirectDeclarator ::= "(" "function-old" DirectDeclarator OptionalIdentifiers ")";
      AttributedShort . DirectDeclarator ::= "(" DirectDeclarator GNUAttribute ")";
      AsmUnderscoresDeclarator . DirectDeclarator ::= "(" DirectDeclarator "__asm__" [CString] ")";
      AsmPrefixDeclarator . DirectDeclarator ::= "(" DirectDeclarator "__asm" [CString] ")";
      AsmBareDeclarator . DirectDeclarator ::= "(" DirectDeclarator "asm" [CString] ")";
      NoIdentifiers . OptionalIdentifiers ::= "(" ")";
      Identifiers . OptionalIdentifiers ::= "(" "old-identifiers" [OldParameterName] ")";
      NoExpression . OptionalExpression ::= "(" ")";
      SomeExpression . OptionalExpression ::= Expr1;

      -- Parameters, type names and abstract declarators.
      ParameterTypes . ParameterTypeList ::= [Parameter];
      VariadicShort . ParameterTypeList ::= "(" [Parameter] "..." ")";
      CompactParameter . Parameter ::= "(" DeclarationSpecifiers Declarator ")";
      SimpleAbstractParameter . Parameter ::= DeclarationSpecifiers;
      PointerParameter . Parameter ::= "(" DeclarationSpecifiers "*" ")";
      DoublePointerParameter . Parameter ::= "(" DeclarationSpecifiers "**" ")";
      TriplePointerParameter . Parameter ::= "(" DeclarationSpecifiers "***" ")";
      AbstractParameter . Parameter ::= "(" "abstract-parameter" DeclarationSpecifiers OptionalAbstractDeclarator ")";
      TypeNameShort . TypeName ::= "(" SpecifierQualifiers AbstractDeclarator ")";
      SimpleTypeName . TypeName ::= SpecifierQualifiers;
      NoAbstractDeclarator . OptionalAbstractDeclarator ::= "(" ")";
      SomeAbstractDeclarator . OptionalAbstractDeclarator ::= AbstractDeclarator;
      AbstractFunctionPointer . AbstractDeclarator ::= "(" "fnptr" [Parameter] ")";
      AbstractFunctionPointerVariadic . AbstractDeclarator ::= "(" "fnptr" [Parameter] "..." ")";
      AbstractFunctionPointerUnspecified . AbstractDeclarator ::= "(" "fnptr" ")";
      AbstractPointerFunctionPointer . AbstractDeclarator ::= "(" "fnptr" "*" [Parameter] ")";
      AbstractPointer . AbstractDeclarator ::= Pointer;
      AbstractDeclarator . AbstractDeclarator ::= "(" "abstract-declarator" DirectAbstractDeclarator ")";
      PointerAbstractDeclarator . AbstractDeclarator ::= "(" "pointer-abstract-declarator" Pointer DirectAbstractDeclarator ")";
      ParenthesizedAbstractDeclarator . DirectAbstractDeclarator ::= "(" "parenthesized-abstract-declarator" AbstractDeclarator ")";
      AbstractArray . DirectAbstractDeclarator ::= "(" "abstract-array" OptionalTypeQualifiers OptionalExpression ")";
      NestedAbstractArray . DirectAbstractDeclarator ::= "(" "nested-abstract-array" DirectAbstractDeclarator OptionalTypeQualifiers OptionalExpression ")";
      AbstractStaticArray . DirectAbstractDeclarator ::= "(" "abstract-static-array" OptionalTypeQualifiers Expr1 ")";
      NestedAbstractStaticArray . DirectAbstractDeclarator ::= "(" "nested-abstract-static-array" DirectAbstractDeclarator OptionalTypeQualifiers Expr1 ")";
      AbstractQualifiedStaticArray . DirectAbstractDeclarator ::= "(" "abstract-qualified-static-array" [TypeQualifier] Expr1 ")";
      NestedAbstractQualifiedStaticArray . DirectAbstractDeclarator ::= "(" "nested-abstract-qualified-static-array" DirectAbstractDeclarator [TypeQualifier] Expr1 ")";
      AbstractVariableArray . DirectAbstractDeclarator ::= "(" "abstract-variable-array" ")";
      NestedAbstractVariableArray . DirectAbstractDeclarator ::= "(" "nested-abstract-variable-array" DirectAbstractDeclarator ")";
      AbstractFunction . DirectAbstractDeclarator ::= "(" "abstract-function" OptionalParameterTypes ")";
      NestedAbstractFunction . DirectAbstractDeclarator ::= "(" "nested-abstract-function" DirectAbstractDeclarator OptionalParameterTypes ")";
      GNUAttributedAbstractDeclarator . DirectAbstractDeclarator ::= "(" "attributed-abstract-declarator" DirectAbstractDeclarator GNUAttribute ")";
      NoParameterTypes . OptionalParameterTypes ::= "(" ")";
      SomeParameterTypes . OptionalParameterTypes ::= ParameterTypeList;

      -- Initializers.
      InitializerExpression . Initializer ::= Expr1;
      InitializerList . Initializer ::= "(" "init" [InitializerElement] ")";
      InitializerListComma . Initializer ::= "(" "init," [InitializerElement] ")";
      EmptyInitializer . Initializer ::= "(" "init" ")";
      InitializerElement . InitializerElement ::= Initializer;
      DesignatedShort . InitializerElement ::= "(" "=" Designator Initializer ")";
      DesignatedInitializerElement . InitializerElement ::= "(" "designated" [Designator] Initializer ")";
      GNUOldArrayInitializer . InitializerElement ::= "(" "old-array-initializer" Expr2 Initializer ")";
      ArrayDesignator . Designator ::= "(" "[]" Expr2 ")";
      RangeDesignator . Designator ::= "(" "[]" Expr2 "..." Expr2 ")";
      MemberDesignator . Designator ::= "(" "." CGeneralName ")";

      -- Attributes and pragmas.
      AttributeUnderscores . GNUAttribute ::= "(" "__attribute__" [GNUAttributeItem] ")";
      AttributePrefix . GNUAttribute ::= "(" "__attribute" [GNUAttributeItem] ")";
      GNUAttributeItem . GNUAttributeItem ::= GNUAttributeName;
      AttributeCallArguments . GNUAttributeItem ::= "(" GNUAttributeName [Expr1] ")";
      AttributeCallNone . GNUAttributeItem ::= "(" GNUAttributeName ")";
      GNUNamedAttribute . GNUAttributeName ::= CGeneralName;
      GNUConstAttribute . GNUAttributeName ::= "const";
      GNUConstUnderscoresAttribute . GNUAttributeName ::= "__const__";
      GNUConstPrefixAttribute . GNUAttributeName ::= "__const";
      GNUPragma . GNUPragma ::= "(" "pragma" CPragma ")";

      -- Functions and translation units.
      PrototypeFunction . FunctionDefinition ::= "(" "fn" DeclarationSpecifiers CGeneralName ParameterTypeList [BlockItem] ")";
      UnspecifiedFunction . FunctionDefinition ::= "(" "fn" DeclarationSpecifiers CGeneralName OptionalIdentifiers [BlockItem] ")";
      PointerFunction . FunctionDefinition ::= "(" "fn" DeclarationSpecifiers "*" CGeneralName ParameterTypeList [BlockItem] ")";
      DoublePointerFunction . FunctionDefinition ::= "(" "fn" DeclarationSpecifiers "**" CGeneralName ParameterTypeList [BlockItem] ")";
      FunctionDefinition . FunctionDefinition ::= "(" "fn-shape" DeclarationSpecifiers BoundDeclarator [Declaration] Block ")";
      FunctionExtension . FunctionDefinition ::= "(" "function-extension" FunctionDefinition ")";
      ExternalFunction . ExternalDeclaration ::= FunctionDefinition;
      ExternalDeclaration . ExternalDeclaration ::= Declaration;
      GNUExternalPragma . ExternalDeclaration ::= GNUPragma;
      GNUEmptyExternalDeclaration . ExternalDeclaration ::= "(" ")";
      FileAsmUnderscores . ExternalDeclaration ::= "(" "__asm__" [CString] ")";
      FileAsmPrefix . ExternalDeclaration ::= "(" "__asm" [CString] ")";
      FileAsmBare . ExternalDeclaration ::= "(" "asm" [CString] ")";
      TranslationUnit . TranslationUnit ::= "(" "unit" [ExternalDeclaration] ")";
      GNUEmptyTranslationUnit . TranslationUnit ::= "(" "unit" ")";

      -- Wrapper sorts. Their constructors are absorbed by the forms above;
      -- these spell them when they stand alone.
      NoInitDeclarators . OptionalInitDeclarators ::= "(" ")";
      InitDeclarators . OptionalInitDeclarators ::= [InitDeclarator];
      NoStructDeclarators . OptionalStructDeclarators ::= "(" ")";
      StructDeclarators . OptionalStructDeclarators ::= [StructDeclarator];
      NoDeclarator . OptionalDeclarator ::= "(" ")";
      SomeDeclarator . OptionalDeclarator ::= Declarator;
      EnumReference . EnumSpecifier ::= "(" "enum" CGeneralName ")";
      EnumDefinition . EnumSpecifier ::= "(" "enum" OptionalIdent [Enumerator] ")";
      EnumDefinitionComma . EnumSpecifier ::= "(" "enum," OptionalIdent [Enumerator] ")";
      Label . LabeledStatement ::= "(" "label" CGeneralName Statement ")";
      Case . LabeledStatement ::= "(" "case" Expr2 Statement ")";
      GNUCaseRange . LabeledStatement ::= "(" "case" Expr2 "..." Expr2 Statement ")";
      GNUAttributedLabel . LabeledStatement ::= "(" "label" CGeneralName [GNUAttribute] Statement ")";
      GNULabelDeclaration . LabeledStatement ::= "(" "label-decl" CGeneralName Declaration ")";
      GNUAttributedLabelDeclaration . LabeledStatement ::= "(" "label-decl" CGeneralName [GNUAttribute] Declaration ")";
      GNUCaseDeclaration . LabeledStatement ::= "(" "case-decl" Expr Declaration ")";
      GNUCaseRangeDeclaration . LabeledStatement ::= "(" "case-range-decl" Expr Expr Declaration ")";
      GNUDefaultDeclaration . LabeledStatement ::= "(" "default-decl" Declaration ")";
      GNUAttributeStatement . Statement ::= "(" "attributes-statement" [GNUAttribute] ")";
      GNUIdent . ExternalDeclaration ::= "(" "ident" CIdentDirective ")";
      Default . LabeledStatement ::= "(" "default" Statement ")";
      If . SelectionStatement ::= "(" "if" Expr Statement ")";
      IfElse . SelectionStatement ::= "(" "if" Expr Statement Statement ")";
      Switch . SelectionStatement ::= "(" "switch" Expr Statement ")";
      While . IterationStatement ::= "(" "while" Expr Statement ")";
      DoWhile . IterationStatement ::= "(" "do" Statement Expr ")";
      For . IterationStatement ::= "(" "for" OptionalFullExpression OptionalFullExpression OptionalFullExpression Statement ")";
      ForDeclaration . IterationStatement ::= "(" "for" Declaration OptionalFullExpression OptionalFullExpression Statement ")";
      Goto . JumpStatement ::= "(" "goto" CGeneralName ")";
      GNUIndirectGoto . JumpStatement ::= "(" "goto*" Expr ")";
      Continue . JumpStatement ::= "continue";
      Break . JumpStatement ::= "break";
      Return . JumpStatement ::= "(" "return" OptionalFullExpression ")";
      GNUTypeof . GNUTypeof ::= "typeof";
      GNUTypeofUnderscores . GNUTypeof ::= "__typeof__";
      GNUTypeofPrefix . GNUTypeof ::= "__typeof";
      GNUAttributeKeyword . GNUAttributeKeyword ::= "__attribute__";
      GNUAttributeKeywordPrefix . GNUAttributeKeyword ::= "__attribute";
      GNUAttributeArguments . GNUAttributeArguments ::= [Expr1];
      GNUNoAttributeArguments . GNUAttributeArguments ::= "(" ")";
      GNUAlignof . GNUAlignof ::= "__alignof__";
      GNUAlignofPrefix . GNUAlignof ::= "__alignof";
    }
    Equations {
      (AtomInteger a) == (IntConst a);
      (AtomFloat a) == (FloatConst a);
      (AtomCharacter a) == (CharConst a);
      (AtomString a) == (StringLiterals (List a));
      (CharacterSpelling a) == (CharConst a);
      (EscapedVariable a) == (Var a);
      (GenericTypeShort a b) == (GenericType a b);
      (GenericDefaultShort a) == (GenericDefault a);
      (CallArguments f a) == (Call f (Arguments a));
      (CallNone f) == (Call f (NoArguments));
      (EmptyCompoundLiteral a) == (GNUEmptyCompoundLiteral a);
      (SizeofTypeShort a) == (SizeofType a);
      (AlignofTypeUnderscores a) == (GNUAlignofType (GNUAlignof) a);
      (AlignofTypePrefix a) == (GNUAlignofType (GNUAlignofPrefix) a);
      (AlignofExpressionUnderscores a) == (GNUAlignofExpression (GNUAlignof) a);
      (AlignofExpressionPrefix a) == (GNUAlignofExpression (GNUAlignofPrefix) a);
      (LabelAddress a) == (GNULabelAddress a);
      (StatementExpressionBlock a) == (GNUStatementExpression (Block a));
      (Offsetof a b) == (GNUOffsetof a b);
      (OffsetNestedMember a b) == (GNUOffsetNestedMember a b);
      (OffsetSubscript a b) == (GNUOffsetSubscript a b);
      (VaArg a b) == (GNUVaArg a b);
      (CompatibleTypes a b) == (GNUCompatibleTypes a b);
      (ConvertVector a b) == (GNUConvertVector a b);

      (EmptyStatement) == (ExpressionStatement (NoFullExpression));
      (StatementBreak) == (JumpStatement (Break));
      (StatementContinue) == (JumpStatement (Continue));
      (StatementExpression a) == (ExpressionStatement (SomeFullExpression a));
      (CompoundBlock a) == (CompoundStatement (Block a));
      (StatementIf a b) == (SelectionStatement (If a b));
      (StatementIfElse a b c) == (SelectionStatement (IfElse a b c));
      (StatementSwitch a b) == (SelectionStatement (Switch a b));
      (StatementWhile a b) == (IterationStatement (While a b));
      (StatementDoWhile a b) == (IterationStatement (DoWhile a b));
      (StatementFor a b c d) == (IterationStatement (For a b c d));
      (StatementForDeclaration a b c d) == (IterationStatement (ForDeclaration a b c d));
      (StatementGoto a) == (JumpStatement (Goto a));
      (StatementIndirectGoto a) == (JumpStatement (GNUIndirectGoto a));
      (StatementReturnValue a) == (JumpStatement (Return (SomeFullExpression a)));
      (StatementReturn) == (JumpStatement (Return (NoFullExpression)));
      (StatementLabel a b) == (LabeledStatement (Label a b));
      (StatementCase a b) == (LabeledStatement (Case a b));
      (StatementCaseRange a b c) == (LabeledStatement (GNUCaseRange a b c));
      (StatementAttributedLabel a b c) == (LabeledStatement (GNUAttributedLabel a b c));
      (StatementLabelDeclaration a b) == (LabeledStatement (GNULabelDeclaration a b));
      (StatementAttributedLabelDeclaration a b c) == (LabeledStatement (GNUAttributedLabelDeclaration a b c));
      (StatementCaseDeclaration a b) == (LabeledStatement (GNUCaseDeclaration a b));
      (StatementCaseRangeDeclaration a b c) == (LabeledStatement (GNUCaseRangeDeclaration a b c));
      (StatementDefaultDeclaration a) == (LabeledStatement (GNUDefaultDeclaration a));
      (StatementDefault a) == (LabeledStatement (Default a));

      (TypedefName a b) == (Declaration (PrefixedDeclarationSpecifiers (StorageSpecifier (Typedef)) a) (InitDeclarators (List (InitDeclarator b))));
      (VariableName a b) == (Declaration a (InitDeclarators (List (InitDeclarator b))));
      (VariableValue a b c) == (Declaration a (InitDeclarators (List (InitDeclaratorValue b c))));
      (DeclarationList a b) == (Declaration a (InitDeclarators b));
      (DeclarationNone a) == (Declaration a (NoInitDeclarators));
      (DeclarationExtension a) == (GNUDeclarationExtension a);

      (BareSpecChar) == (PrimitiveDeclarationSpecifiers (Char) (List));
      (BareSpecShort) == (PrimitiveDeclarationSpecifiers (Short) (List));
      (BareSpecInt) == (PrimitiveDeclarationSpecifiers (Int) (List));
      (BareSpecLong) == (PrimitiveDeclarationSpecifiers (Long) (List));
      (BareSpecFloat) == (PrimitiveDeclarationSpecifiers (Float) (List));
      (BareSpecDouble) == (PrimitiveDeclarationSpecifiers (Double) (List));
      (BareSpecSigned) == (PrimitiveDeclarationSpecifiers (Signed) (List));
      (BareSpecUnsigned) == (PrimitiveDeclarationSpecifiers (Unsigned) (List));
      (BareSpecComplex) == (PrimitiveDeclarationSpecifiers (Complex) (List));
      (BareSpecGNUInt128) == (PrimitiveDeclarationSpecifiers (GNUInt128) (List));
      (BareSpecGNUFloat16) == (PrimitiveDeclarationSpecifiers (GNUFloat16) (List));
      (BareSpecGNUSigned) == (PrimitiveDeclarationSpecifiers (GNUSigned) (List));
      (UniqueSpec a) == (UniqueDeclarationSpecifiers a (List));
      (UniqueSpecTails a b) == (UniqueDeclarationSpecifiers a b);
      (SpecTailsChar a) == (PrimitiveDeclarationSpecifiers (Char) a);
      (SpecTailsShort a) == (PrimitiveDeclarationSpecifiers (Short) a);
      (SpecTailsInt a) == (PrimitiveDeclarationSpecifiers (Int) a);
      (SpecTailsLong a) == (PrimitiveDeclarationSpecifiers (Long) a);
      (SpecTailsFloat a) == (PrimitiveDeclarationSpecifiers (Float) a);
      (SpecTailsDouble a) == (PrimitiveDeclarationSpecifiers (Double) a);
      (SpecTailsSigned a) == (PrimitiveDeclarationSpecifiers (Signed) a);
      (SpecTailsUnsigned a) == (PrimitiveDeclarationSpecifiers (Unsigned) a);
      (SpecTailsComplex a) == (PrimitiveDeclarationSpecifiers (Complex) a);
      (SpecTailsGNUInt128 a) == (PrimitiveDeclarationSpecifiers (GNUInt128) a);
      (SpecTailsGNUFloat16 a) == (PrimitiveDeclarationSpecifiers (GNUFloat16) a);
      (SpecTailsGNUSigned a) == (PrimitiveDeclarationSpecifiers (GNUSigned) a);
      (PrefixSpecTypedef a) == (PrefixedDeclarationSpecifiers (StorageSpecifier (Typedef)) a);
      (PrefixSpecExtern a) == (PrefixedDeclarationSpecifiers (StorageSpecifier (Extern)) a);
      (PrefixSpecStatic a) == (PrefixedDeclarationSpecifiers (StorageSpecifier (Static)) a);
      (PrefixSpecThreadLocal a) == (PrefixedDeclarationSpecifiers (StorageSpecifier (ThreadLocal)) a);
      (PrefixSpecAuto a) == (PrefixedDeclarationSpecifiers (StorageSpecifier (Auto)) a);
      (PrefixSpecRegister a) == (PrefixedDeclarationSpecifiers (StorageSpecifier (Register)) a);
      (PrefixSpecGNUThread a) == (PrefixedDeclarationSpecifiers (StorageSpecifier (GNUThread)) a);
      (PrefixSpecConst a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (Const)) a);
      (PrefixSpecRestrict a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (Restrict)) a);
      (PrefixSpecVolatile a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (Volatile)) a);
      (PrefixSpecAtomicQualifier a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (AtomicQualifier)) a);
      (PrefixSpecGNUConst a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (GNUConst)) a);
      (PrefixSpecGNUConstPrefix a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (GNUConstPrefix)) a);
      (PrefixSpecGNUVolatile a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (GNUVolatile)) a);
      (PrefixSpecGNUVolatilePrefix a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (GNUVolatilePrefix)) a);
      (PrefixSpecGNURestrict a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (GNURestrict)) a);
      (PrefixSpecGNURestrictPrefix a) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (GNURestrictPrefix)) a);
      (PrefixSpecInline a) == (PrefixedDeclarationSpecifiers (FunctionSpecifier (Inline)) a);
      (PrefixSpecNoreturn a) == (PrefixedDeclarationSpecifiers (FunctionSpecifier (Noreturn)) a);
      (PrefixSpecGNUInline a) == (PrefixedDeclarationSpecifiers (FunctionSpecifier (GNUInline)) a);
      (PrefixSpecGNUInlinePrefix a) == (PrefixedDeclarationSpecifiers (FunctionSpecifier (GNUInlinePrefix)) a);
      (PrefixSpecAttribute a b) == (PrefixedDeclarationSpecifiers (QualifierSpecifier (GNUAttributeQualifier a)) b);

      (BareNonTypeTypedef) == (StorageSpecifier (Typedef));
      (BareNonTypeExtern) == (StorageSpecifier (Extern));
      (BareNonTypeStatic) == (StorageSpecifier (Static));
      (BareNonTypeThreadLocal) == (StorageSpecifier (ThreadLocal));
      (BareNonTypeAuto) == (StorageSpecifier (Auto));
      (BareNonTypeRegister) == (StorageSpecifier (Register));
      (BareNonTypeGNUThread) == (StorageSpecifier (GNUThread));
      (BareNonTypeConst) == (QualifierSpecifier (Const));
      (BareNonTypeRestrict) == (QualifierSpecifier (Restrict));
      (BareNonTypeVolatile) == (QualifierSpecifier (Volatile));
      (BareNonTypeAtomicQualifier) == (QualifierSpecifier (AtomicQualifier));
      (BareNonTypeGNUConst) == (QualifierSpecifier (GNUConst));
      (BareNonTypeGNUConstPrefix) == (QualifierSpecifier (GNUConstPrefix));
      (BareNonTypeGNUVolatile) == (QualifierSpecifier (GNUVolatile));
      (BareNonTypeGNUVolatilePrefix) == (QualifierSpecifier (GNUVolatilePrefix));
      (BareNonTypeGNURestrict) == (QualifierSpecifier (GNURestrict));
      (BareNonTypeGNURestrictPrefix) == (QualifierSpecifier (GNURestrictPrefix));
      (BareNonTypeInline) == (FunctionSpecifier (Inline));
      (BareNonTypeNoreturn) == (FunctionSpecifier (Noreturn));
      (BareNonTypeGNUInline) == (FunctionSpecifier (GNUInline));
      (BareNonTypeGNUInlinePrefix) == (FunctionSpecifier (GNUInlinePrefix));
      (AttributeSpecifier a) == (QualifierSpecifier (GNUAttributeQualifier a));
      (AlignasTypeSpecifier a) == (AlignmentSpecifier (AlignasType a));
      (AlignasExpressionSpecifier a) == (AlignmentSpecifier (AlignasExpression a));

      (TypeofExpression a) == (GNUTypeofExpression (GNUTypeof) a);
      (TypeofType a) == (GNUTypeofType (GNUTypeof) a);
      (TypeofUnderscoresExpression a) == (GNUTypeofExpression (GNUTypeofUnderscores) a);
      (TypeofUnderscoresType a) == (GNUTypeofType (GNUTypeofUnderscores) a);
      (TypeofPrefixExpression a) == (GNUTypeofExpression (GNUTypeofPrefix) a);
      (TypeofPrefixType a) == (GNUTypeofType (GNUTypeofPrefix) a);
      (EnumReferenceShort a) == (EnumType (EnumReference a));
      (EnumDefinitionShort a b) == (EnumType (EnumDefinition a b));
      (EnumDefinitionCommaShort a b) == (EnumType (EnumDefinitionComma a b));

      (StructReferenceShort a) == (StructReference (Struct) a);
      (StructDefinitionShort a b) == (StructDefinition (Struct) (SomeIdent a) b);
      (StructAnonymousShort a) == (StructDefinition (Struct) (NoIdent) a);
      (UnionReferenceShort a) == (StructReference (Union) a);
      (UnionDefinitionShort a b) == (StructDefinition (Union) (SomeIdent a) b);
      (UnionAnonymousShort a) == (StructDefinition (Union) (NoIdent) a);
      (FieldDeclarators a b) == (StructDeclaration a (StructDeclarators b));
      (FieldAnonymous a) == (StructDeclaration a (NoStructDeclarators));
      (StructDeclarationExtension a) == (GNUStructDeclarationExtension a);
      (BitFieldNamed a b) == (BitField (SomeDeclarator a) b);
      (BitFieldAnonymous a) == (BitField (NoDeclarator) a);
      (EnumeratorValueShort a b) == (EnumeratorValue a b);

      (BareSQChar) == (PrimitiveSpecifierQualifiers (Char) (List));
      (BareSQShort) == (PrimitiveSpecifierQualifiers (Short) (List));
      (BareSQInt) == (PrimitiveSpecifierQualifiers (Int) (List));
      (BareSQLong) == (PrimitiveSpecifierQualifiers (Long) (List));
      (BareSQFloat) == (PrimitiveSpecifierQualifiers (Float) (List));
      (BareSQDouble) == (PrimitiveSpecifierQualifiers (Double) (List));
      (BareSQSigned) == (PrimitiveSpecifierQualifiers (Signed) (List));
      (BareSQUnsigned) == (PrimitiveSpecifierQualifiers (Unsigned) (List));
      (BareSQComplex) == (PrimitiveSpecifierQualifiers (Complex) (List));
      (BareSQGNUInt128) == (PrimitiveSpecifierQualifiers (GNUInt128) (List));
      (BareSQGNUFloat16) == (PrimitiveSpecifierQualifiers (GNUFloat16) (List));
      (BareSQGNUSigned) == (PrimitiveSpecifierQualifiers (GNUSigned) (List));
      (BareUniqueSpecifierQualifiers a) == (UniqueSpecifierQualifiers a (NoTypeQualifiers));
      (UniqueQualified a b) == (UniqueSpecifierQualifiers a (SomeTypeQualifiers b));
      (SQTailsChar a) == (PrimitiveSpecifierQualifiers (Char) a);
      (SQTailsShort a) == (PrimitiveSpecifierQualifiers (Short) a);
      (SQTailsInt a) == (PrimitiveSpecifierQualifiers (Int) a);
      (SQTailsLong a) == (PrimitiveSpecifierQualifiers (Long) a);
      (SQTailsFloat a) == (PrimitiveSpecifierQualifiers (Float) a);
      (SQTailsDouble a) == (PrimitiveSpecifierQualifiers (Double) a);
      (SQTailsSigned a) == (PrimitiveSpecifierQualifiers (Signed) a);
      (SQTailsUnsigned a) == (PrimitiveSpecifierQualifiers (Unsigned) a);
      (SQTailsComplex a) == (PrimitiveSpecifierQualifiers (Complex) a);
      (SQTailsGNUInt128 a) == (PrimitiveSpecifierQualifiers (GNUInt128) a);
      (SQTailsGNUFloat16 a) == (PrimitiveSpecifierQualifiers (GNUFloat16) a);
      (SQTailsGNUSigned a) == (PrimitiveSpecifierQualifiers (GNUSigned) a);
      (PrefixSQConst a) == (PrefixedSpecifierQualifiers (Const) a);
      (PrefixSQRestrict a) == (PrefixedSpecifierQualifiers (Restrict) a);
      (PrefixSQVolatile a) == (PrefixedSpecifierQualifiers (Volatile) a);
      (PrefixSQAtomicQualifier a) == (PrefixedSpecifierQualifiers (AtomicQualifier) a);
      (PrefixSQGNUConst a) == (PrefixedSpecifierQualifiers (GNUConst) a);
      (PrefixSQGNUConstPrefix a) == (PrefixedSpecifierQualifiers (GNUConstPrefix) a);
      (PrefixSQGNUVolatile a) == (PrefixedSpecifierQualifiers (GNUVolatile) a);
      (PrefixSQGNUVolatilePrefix a) == (PrefixedSpecifierQualifiers (GNUVolatilePrefix) a);
      (PrefixSQGNURestrict a) == (PrefixedSpecifierQualifiers (GNURestrict) a);
      (PrefixSQGNURestrictPrefix a) == (PrefixedSpecifierQualifiers (GNURestrictPrefix) a);
      (PrefixSQAttribute a b) == (PrefixedSpecifierQualifiers (GNUAttributeQualifier a) b);

      (DoublePointerDeclarator a) == (PointerDeclarator (NestedPointer (NoTypeQualifiers) (Pointer (NoTypeQualifiers))) a);
      (TriplePointerDeclarator a) == (PointerDeclarator (NestedPointer (NoTypeQualifiers) (NestedPointer (NoTypeQualifiers) (Pointer (NoTypeQualifiers)))) a);
      (UnqualifiedPointerDeclarator a) == (PointerDeclarator (Pointer (NoTypeQualifiers)) a);
      (QualifiedPointerDeclarator a b) == (PointerDeclarator (Pointer a) b);
      (FunctionPointerParameters name parameters) ==
        (Declarator (FunctionDeclarator (ParenthesizedDeclarator (PointerDeclarator (Pointer (NoTypeQualifiers)) (NameDeclarator name))) (ParameterTypes parameters)));
      (FunctionPointerVariadic name parameters) ==
        (Declarator (FunctionDeclarator (ParenthesizedDeclarator (PointerDeclarator (Pointer (NoTypeQualifiers)) (NameDeclarator name))) (VariadicParameterTypes parameters)));
      (FunctionPointerUnspecified name) ==
        (Declarator (OldFunctionDeclarator (ParenthesizedDeclarator (PointerDeclarator (Pointer (NoTypeQualifiers)) (NameDeclarator name))) (NoIdentifiers)));
      (FunctionPointerArray name length parameters) ==
        (Declarator (FunctionDeclarator (ParenthesizedDeclarator (PointerDeclarator (Pointer (NoTypeQualifiers))
          (ArrayDeclarator (NameDeclarator name) (NoTypeQualifiers) (SomeExpression length)))) (ParameterTypes parameters)));
      (BarePointer) == (Pointer (NoTypeQualifiers));
      (DoublePointer) == (NestedPointer (NoTypeQualifiers) (Pointer (NoTypeQualifiers)));
      (TriplePointer) == (NestedPointer (NoTypeQualifiers) (NestedPointer (NoTypeQualifiers) (Pointer (NoTypeQualifiers))));
      (EscapedDeclaratorName a) == (NameDeclarator a);
      (ParenthesizedShort a) == (ParenthesizedDeclarator a);
      (CompactArray a b) == (ArrayDeclarator a (NoTypeQualifiers) (SomeExpression b));
      (CompactIncompleteArray a) == (ArrayDeclarator a (NoTypeQualifiers) (NoExpression));
      (CompactStaticArray a b) == (StaticArrayDeclarator a (NoTypeQualifiers) b);
      (CompactVariableArray a) == (VariableArrayDeclarator a (NoTypeQualifiers));
      (FunctionParameters a b) == (FunctionDeclarator a (ParameterTypes b));
      (FunctionVariadic a b) == (FunctionDeclarator a (VariadicParameterTypes b));
      (FunctionUnspecified a) == (OldFunctionDeclarator a (NoIdentifiers));
      (AttributedShort a b) == (GNUAttributedDeclarator a b);
      (AsmUnderscoresDeclarator a b) == (GNUAsmDeclarator a (GNUAsmKeyword) b);
      (AsmPrefixDeclarator a b) == (GNUAsmDeclarator a (GNUAsmKeywordPrefix) b);
      (AsmBareDeclarator a b) == (GNUAsmDeclarator a (GNUAsmKeywordBare) b);

      (VariadicShort a) == (VariadicParameterTypes a);
      (CompactParameter a b) == (NamedParameter a b);
      (SimpleAbstractParameter a) == (AbstractParameter a (NoAbstractDeclarator));
      (PointerParameter a) == (AbstractParameter a (SomeAbstractDeclarator (AbstractPointer (Pointer (NoTypeQualifiers)))));
      (DoublePointerParameter a) == (AbstractParameter a (SomeAbstractDeclarator (AbstractPointer (NestedPointer (NoTypeQualifiers) (Pointer (NoTypeQualifiers))))));
      (TriplePointerParameter a) == (AbstractParameter a (SomeAbstractDeclarator (AbstractPointer
        (NestedPointer (NoTypeQualifiers) (NestedPointer (NoTypeQualifiers) (Pointer (NoTypeQualifiers)))))));
      (TypeNameShort a b) == (TypeName a (SomeAbstractDeclarator b));
      (SimpleTypeName a) == (TypeName a (NoAbstractDeclarator));
      (AbstractFunctionPointer a) == (AbstractDeclarator (NestedAbstractFunction
        (ParenthesizedAbstractDeclarator (AbstractPointer (Pointer (NoTypeQualifiers)))) (SomeParameterTypes (ParameterTypes a))));
      (AbstractFunctionPointerVariadic a) == (AbstractDeclarator (NestedAbstractFunction
        (ParenthesizedAbstractDeclarator (AbstractPointer (Pointer (NoTypeQualifiers)))) (SomeParameterTypes (VariadicParameterTypes a))));
      (AbstractPointerFunctionPointer a) == (PointerAbstractDeclarator (Pointer (NoTypeQualifiers)) (NestedAbstractFunction
        (ParenthesizedAbstractDeclarator (AbstractPointer (Pointer (NoTypeQualifiers)))) (SomeParameterTypes (ParameterTypes a))));
      (AbstractFunctionPointerUnspecified) == (AbstractDeclarator (NestedAbstractFunction
        (ParenthesizedAbstractDeclarator (AbstractPointer (Pointer (NoTypeQualifiers)))) (NoParameterTypes)));

      (EmptyInitializer) == (GNUEmptyInitializer);
      (DesignatedShort a b) == (DesignatedInitializerElement (List a) b);
      (RangeDesignator a b) == (GNUArrayRangeDesignator a b);
      (AttributeUnderscores a) == (GNUAttribute (GNUAttributeKeyword) a);
      (AttributePrefix a) == (GNUAttribute (GNUAttributeKeywordPrefix) a);
      (AttributeCallArguments a b) == (GNUAttributeCall a (GNUAttributeArguments b));
      (AttributeCallNone a) == (GNUAttributeCall a (GNUNoAttributeArguments));

      (PrototypeFunction spec name parameters body) ==
        (FunctionDefinition spec (Declarator (FunctionDeclarator (NameDeclarator name) parameters)) (List) (Block body));
      (UnspecifiedFunction spec name identifiers body) ==
        (FunctionDefinition spec (Declarator (OldFunctionDeclarator (NameDeclarator name) identifiers)) (List) (Block body));
      (PointerFunction spec name parameters body) ==
        (FunctionDefinition spec (PointerDeclarator (Pointer (NoTypeQualifiers)) (FunctionDeclarator (NameDeclarator name) parameters)) (List) (Block body));
      (DoublePointerFunction spec name parameters body) ==
        (FunctionDefinition spec (PointerDeclarator (NestedPointer (NoTypeQualifiers) (Pointer (NoTypeQualifiers)))
          (FunctionDeclarator (NameDeclarator name) parameters)) (List) (Block body));
      (FunctionExtension a) == (GNUFunctionExtension a);
      (FileAsmUnderscores a) == (GNUFileAsm (GNUAsmKeyword) a);
      (FileAsmPrefix a) == (GNUFileAsm (GNUAsmKeywordPrefix) a);
      (FileAsmBare a) == (GNUFileAsm (GNUAsmKeywordBare) a);
    }
  }
}
