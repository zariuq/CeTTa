Module CompactC2Presentation {
  Theory CompactC2() {
    Empty Terms {
      -- Literals are written as the atom their C spelling reads as: 42 and
      -- 'a' are symbols, "hi\n" is a string. A spelling that is not exactly
      -- the printed form of one atom keeps its exact text in a headed form.
      AtomInteger . Expr16 ::= "" CInteger;
      AtomFloat . Expr16 ::= "" CFloat;
      AtomCharacter . Expr16 ::= "" CCharacter;
      AtomString . Expr16 ::= "" CString;
      CharacterSpelling . Expr16 ::= "(" "char" CCharacter ")";
      StringLiterals . Expr16 ::= "(" "strings" [CString] ")";
      Var . Expr16 ::= COrdinaryName;
      EscapedVariable . Expr16 ::= "(" "id" COrdinaryName ")";

      -- Expressions.
      Generic . Expr16 ::= "(" "_Generic" Expr1 [GenericAssociation] ")";
      GenericTypeShort . GenericAssociation ::= "(" TypeName Expr1 ")";
      GenericDefaultShort . GenericAssociation ::= "(" "default" Expr1 ")";
      Subscript . Expr15 ::= "(" "[]" Expr15 Expr ")";
      CallArguments . Expr15 ::= "(" "call" Expr15 [Expr1] ")";
      CallNone . Expr15 ::= "(" "call" Expr15 ")";
      NoArguments . Arguments ::= "(" ")";
      Arguments . Arguments ::= [Expr1];
      Member . Expr15 ::= "(" "." Expr15 CGeneralName ")";
      PointerMember . Expr15 ::= "(" "->" Expr15 CGeneralName ")";
      PostIncrement . Expr15 ::= "(" "post++" Expr15 ")";
      PostDecrement . Expr15 ::= "(" "post--" Expr15 ")";
      CompoundLiteral . Expr15 ::= "(" "compound" TypeName [InitializerElement] ")";
      CompoundLiteralComma . Expr15 ::= "(" "compound," TypeName [InitializerElement] ")";
      EmptyCompoundLiteral . Expr15 ::= "(" "compound" TypeName ")";
      PreIncrement . Expr14 ::= "(" "++" Expr14 ")";
      PreDecrement . Expr14 ::= "(" "--" Expr14 ")";
      AddressOf . Expr14 ::= "(" "&" Expr13 ")";
      Indirection . Expr14 ::= "(" "*" Expr13 ")";
      UnaryPlus . Expr14 ::= "(" "+" Expr13 ")";
      Negate . Expr14 ::= "(" "-" Expr13 ")";
      BitNot . Expr14 ::= "(" "~" Expr13 ")";
      Not . Expr14 ::= "(" "!" Expr13 ")";
      SizeofExpression . Expr14 ::= "(" "sizeof" Expr14 ")";
      SizeofTypeShort . Expr14 ::= "(" "sizeof" "type" TypeName ")";
      Alignof . Expr14 ::= "(" "_Alignof" TypeName ")";
      AlignofTypeUnderscores . Expr14 ::= "(" "__alignof__" "type" TypeName ")";
      AlignofTypePrefix . Expr14 ::= "(" "__alignof" "type" TypeName ")";
      AlignofExpressionUnderscores . Expr14 ::= "(" "__alignof__" Expr ")";
      AlignofExpressionPrefix . Expr14 ::= "(" "__alignof" Expr ")";
      LabelAddress . Expr14 ::= "(" "&&" CGeneralName ")";
      Cast . Expr13 ::= "(" "cast" TypeName Expr13 ")";
      GNUExpressionExtension . Expr13 ::= "(" "expression-extension" Expr13 ")";
      Multiply . Expr12 ::= "(" "*" Expr12 Expr13 ")";
      Divide . Expr12 ::= "(" "/" Expr12 Expr13 ")";
      Remainder . Expr12 ::= "(" "%" Expr12 Expr13 ")";
      Add . Expr11 ::= "(" "+" Expr11 Expr12 ")";
      Subtract . Expr11 ::= "(" "-" Expr11 Expr12 ")";
      ShiftLeft . Expr10 ::= "(" "<<" Expr10 Expr11 ")";
      ShiftRight . Expr10 ::= "(" ">>" Expr10 Expr11 ")";
      Less . Expr9 ::= "(" "<" Expr9 Expr10 ")";
      Greater . Expr9 ::= "(" ">" Expr9 Expr10 ")";
      LessEqual . Expr9 ::= "(" "<=" Expr9 Expr10 ")";
      GreaterEqual . Expr9 ::= "(" ">=" Expr9 Expr10 ")";
      Equal . Expr8 ::= "(" "==" Expr8 Expr9 ")";
      NotEqual . Expr8 ::= "(" "!=" Expr8 Expr9 ")";
      BitAnd . Expr7 ::= "(" "&" Expr7 Expr8 ")";
      BitXor . Expr6 ::= "(" "^" Expr6 Expr7 ")";
      BitOr . Expr5 ::= "(" "|" Expr5 Expr6 ")";
      And . Expr4 ::= "(" "&&" Expr4 Expr5 ")";
      Or . Expr3 ::= "(" "||" Expr3 Expr4 ")";
      Conditional . Expr2 ::= "(" "?:" Expr3 Expr Expr2 ")";
      GNUConditional . Expr2 ::= "(" "?:" Expr3 Expr2 ")";
      Assign . Expr1 ::= "(" "=" Expr14 Expr1 ")";
      MultiplyAssign . Expr1 ::= "(" "*=" Expr14 Expr1 ")";
      DivideAssign . Expr1 ::= "(" "/=" Expr14 Expr1 ")";
      RemainderAssign . Expr1 ::= "(" "%=" Expr14 Expr1 ")";
      AddAssign . Expr1 ::= "(" "+=" Expr14 Expr1 ")";
      SubtractAssign . Expr1 ::= "(" "-=" Expr14 Expr1 ")";
      ShiftLeftAssign . Expr1 ::= "(" "<<=" Expr14 Expr1 ")";
      ShiftRightAssign . Expr1 ::= "(" ">>=" Expr14 Expr1 ")";
      BitAndAssign . Expr1 ::= "(" "&=" Expr14 Expr1 ")";
      BitXorAssign . Expr1 ::= "(" "^=" Expr14 Expr1 ")";
      BitOrAssign . Expr1 ::= "(" "|=" Expr14 Expr1 ")";
      Comma . Expr ::= "(" "," Expr Expr1 ")";
      StatementExpressionBlock . Expr16 ::= "(" "block" [BlockItem] ")";
      Offsetof . Expr16 ::= "(" "__builtin_offsetof" TypeName GNUOffsetDesignator ")";
      GNUOffsetMember . GNUOffsetDesignator ::= CGeneralName;
      OffsetNestedMember . GNUOffsetDesignator ::= "(" "." GNUOffsetDesignator CGeneralName ")";
      OffsetSubscript . GNUOffsetDesignator ::= "(" "[]" GNUOffsetDesignator Expr ")";
      VaArg . Expr16 ::= "(" "__builtin_va_arg" Expr1 TypeName ")";
      CompatibleTypes . Expr16 ::= "(" "__builtin_types_compatible_p" TypeName TypeName ")";
      ConvertVector . Expr16 ::= "(" "__builtin_convertvector" Expr1 TypeName ")";

      -- Statements.
      EmptyStatement . Statement ::= "empty";
      StatementBreak . Statement ::= "break";
      StatementContinue . Statement ::= "continue";
      StatementExpression . Statement ::= Expr;
      CompoundBlock . Statement ::= "(" "block" [BlockItem] ")";
      StatementIf . Statement ::= "(" "if" Expr Statement ")";
      StatementIfElse . Statement ::= "(" "if" Expr Statement Statement ")";
      StatementSwitch . Statement ::= "(" "switch" Expr Statement ")";
      StatementWhile . Statement ::= "(" "while" Expr Statement ")";
      StatementDoWhile . Statement ::= "(" "do" Statement Expr ")";
      StatementFor . Statement ::= "(" "for" OptionalFullExpression OptionalFullExpression OptionalFullExpression Statement ")";
      StatementForDeclaration . Statement ::= "(" "for" Declaration OptionalFullExpression OptionalFullExpression Statement ")";
      StatementGoto . Statement ::= "(" "goto" CGeneralName ")";
      StatementIndirectGoto . Statement ::= "(" "goto*" Expr ")";
      StatementReturnValue . Statement ::= "(" "return" Expr ")";
      StatementReturn . Statement ::= "(" "return" ")";
      StatementLabel . Statement ::= "(" "label" CGeneralName Statement ")";
      StatementCase . Statement ::= "(" "case" Expr2 Statement ")";
      StatementCaseRange . Statement ::= "(" "case" Expr2 "..." Expr2 Statement ")";
      StatementAttributedLabel . Statement ::= "(" "label" CGeneralName [GNUAttribute] Statement ")";
      StatementLabelDeclaration . Statement ::= "(" "label-decl" CGeneralName Declaration ")";
      StatementAttributedLabelDeclaration . Statement ::= "(" "label-decl" CGeneralName [GNUAttribute] Declaration ")";
      StatementCaseDeclaration . Statement ::= "(" "case-decl" Expr2 Declaration ")";
      StatementCaseRangeDeclaration . Statement ::= "(" "case-range-decl" Expr2 Expr2 Declaration ")";
      StatementDefaultDeclaration . Statement ::= "(" "default-decl" Declaration ")";
      StatementDefault . Statement ::= "(" "default" Statement ")";
      Block . Block ::= "(" "block" [BlockItem] ")";
      NoFullExpression . OptionalFullExpression ::= "(" ")";
      SomeFullExpression . OptionalFullExpression ::= Expr;
      BlockStatement . BlockItem ::= Statement;
      BlockDeclaration . BlockItem ::= Declaration;
      GNUBlockPragma . BlockItem ::= GNUPragma;
      GNUAsmStatement . Statement ::= "(" "asm-statement" GNUAsmKeyword [GNUAsmQualifier] [CString] ")";
      GNUAsmOutput . Statement ::= "(" "asm-output" GNUAsmKeyword [GNUAsmQualifier] [CString] [GNUAsmOperand] ")";
      GNUAsmInput . Statement ::= "(" "asm-input" GNUAsmKeyword [GNUAsmQualifier] [CString] [GNUAsmOperand] [GNUAsmOperand] ")";
      GNUAsmWithClobbers . Statement ::= "(" "asm-with-clobbers" GNUAsmKeyword [GNUAsmQualifier] [CString] [GNUAsmOperand] [GNUAsmOperand] [GNUAsmClobber] ")";
      GNUAsmLabels . Statement ::= "(" "asm-labels" GNUAsmKeyword [GNUAsmQualifier] [CString] [GNUAsmOperand] [GNUAsmOperand] [GNUAsmClobber] [GNUAsmLabel] ")";
      GNUAsmOperand . GNUAsmOperand ::= "(" CString Expr ")";
      GNUAsmNamedOperand . GNUAsmOperand ::= "(" CGeneralName CString Expr ")";
      GNUAsmClobber . GNUAsmClobber ::= CString;
      GNUAsmLabel . GNUAsmLabel ::= CGeneralName;
      GNUAsmVolatile . GNUAsmQualifier ::= "volatile";
      GNUAsmVolatileUnderscores . GNUAsmQualifier ::= "__volatile__";
      GNUAsmInline . GNUAsmQualifier ::= "inline";
      GNUAsmGoto . GNUAsmQualifier ::= "goto";
      GNUAsmKeyword . GNUAsmKeyword ::= "__asm__";
      GNUAsmKeywordPrefix . GNUAsmKeyword ::= "__asm";
      GNUAsmKeywordBare . GNUAsmKeyword ::= "asm";

      -- Declarations.
      TypedefName . Declaration ::= "(" "typedef" DeclarationSpecifiers Declarator ")";
      VariableName . Declaration ::= "(" "var" DeclarationSpecifiers Declarator ")";
      VariableValue . Declaration ::= "(" "var" DeclarationSpecifiers Declarator Initializer ")";
      DeclarationList . Declaration ::= "(" "decl" DeclarationSpecifiers [InitDeclarator] ")";
      DeclarationNone . Declaration ::= "(" "decl" DeclarationSpecifiers ")";
      StaticAssertionDeclaration . Declaration ::= StaticAssertion;
      DeclarationExtension . Declaration ::= "(" "__extension__" Declaration ")";
      StaticAssertion . StaticAssertion ::= "(" "_Static_assert" Expr2 [CString] ")";
      InitDeclarator . InitDeclarator ::= BoundDeclarator;
      InitDeclaratorValue . InitDeclarator ::= "(" "=" BoundDeclarator Initializer ")";

      -- Specifiers are flat sequences of C words: a storage class, function
      -- specifier, qualifier or attribute before a type continues the
      -- sequence as a dotted tail, so (static inline int) reads as written.
      BareSpecChar . DeclarationSpecifiers ::= "char";
      BareSpecShort . DeclarationSpecifiers ::= "short";
      BareSpecInt . DeclarationSpecifiers ::= "int";
      BareSpecLong . DeclarationSpecifiers ::= "long";
      BareSpecFloat . DeclarationSpecifiers ::= "float";
      BareSpecDouble . DeclarationSpecifiers ::= "double";
      BareSpecSigned . DeclarationSpecifiers ::= "signed";
      BareSpecUnsigned . DeclarationSpecifiers ::= "unsigned";
      BareSpecComplex . DeclarationSpecifiers ::= "_Complex";
      BareSpecGNUInt128 . DeclarationSpecifiers ::= "__int128";
      BareSpecGNUFloat16 . DeclarationSpecifiers ::= "_Float16";
      BareSpecGNUSigned . DeclarationSpecifiers ::= "__signed__";
      UniqueSpec . DeclarationSpecifiers ::= UniqueTypeSpecifier;
      UniqueSpecTails . DeclarationSpecifiers ::= "(" "type" UniqueTypeSpecifier [NonTypeSpecifier] ")";
      SpecTailsChar . DeclarationSpecifiers ::= "(" "char" [PrimitiveOrNonTypeSpecifier] ")";
      SpecTailsShort . DeclarationSpecifiers ::= "(" "short" [PrimitiveOrNonTypeSpecifier] ")";
      SpecTailsInt . DeclarationSpecifiers ::= "(" "int" [PrimitiveOrNonTypeSpecifier] ")";
      SpecTailsLong . DeclarationSpecifiers ::= "(" "long" [PrimitiveOrNonTypeSpecifier] ")";
      SpecTailsFloat . DeclarationSpecifiers ::= "(" "float" [PrimitiveOrNonTypeSpecifier] ")";
      SpecTailsDouble . DeclarationSpecifiers ::= "(" "double" [PrimitiveOrNonTypeSpecifier] ")";
      SpecTailsSigned . DeclarationSpecifiers ::= "(" "signed" [PrimitiveOrNonTypeSpecifier] ")";
      SpecTailsUnsigned . DeclarationSpecifiers ::= "(" "unsigned" [PrimitiveOrNonTypeSpecifier] ")";
      SpecTailsComplex . DeclarationSpecifiers ::= "(" "_Complex" [PrimitiveOrNonTypeSpecifier] ")";
      SpecTailsGNUInt128 . DeclarationSpecifiers ::= "(" "__int128" [PrimitiveOrNonTypeSpecifier] ")";
      SpecTailsGNUFloat16 . DeclarationSpecifiers ::= "(" "_Float16" [PrimitiveOrNonTypeSpecifier] ")";
      SpecTailsGNUSigned . DeclarationSpecifiers ::= "(" "__signed__" [PrimitiveOrNonTypeSpecifier] ")";
      PrefixSpecTypedef . DeclarationSpecifiers ::= "(" "typedef" "." DeclarationSpecifiers ")";
      PrefixSpecExtern . DeclarationSpecifiers ::= "(" "extern" "." DeclarationSpecifiers ")";
      PrefixSpecStatic . DeclarationSpecifiers ::= "(" "static" "." DeclarationSpecifiers ")";
      PrefixSpecThreadLocal . DeclarationSpecifiers ::= "(" "_Thread_local" "." DeclarationSpecifiers ")";
      PrefixSpecAuto . DeclarationSpecifiers ::= "(" "auto" "." DeclarationSpecifiers ")";
      PrefixSpecRegister . DeclarationSpecifiers ::= "(" "register" "." DeclarationSpecifiers ")";
      PrefixSpecGNUThread . DeclarationSpecifiers ::= "(" "__thread" "." DeclarationSpecifiers ")";
      PrefixSpecConst . DeclarationSpecifiers ::= "(" "const" "." DeclarationSpecifiers ")";
      PrefixSpecRestrict . DeclarationSpecifiers ::= "(" "restrict" "." DeclarationSpecifiers ")";
      PrefixSpecVolatile . DeclarationSpecifiers ::= "(" "volatile" "." DeclarationSpecifiers ")";
      PrefixSpecAtomicQualifier . DeclarationSpecifiers ::= "(" "_Atomic" "." DeclarationSpecifiers ")";
      PrefixSpecGNUConst . DeclarationSpecifiers ::= "(" "__const__" "." DeclarationSpecifiers ")";
      PrefixSpecGNUConstPrefix . DeclarationSpecifiers ::= "(" "__const" "." DeclarationSpecifiers ")";
      PrefixSpecGNUVolatile . DeclarationSpecifiers ::= "(" "__volatile__" "." DeclarationSpecifiers ")";
      PrefixSpecGNUVolatilePrefix . DeclarationSpecifiers ::= "(" "__volatile" "." DeclarationSpecifiers ")";
      PrefixSpecGNURestrict . DeclarationSpecifiers ::= "(" "__restrict__" "." DeclarationSpecifiers ")";
      PrefixSpecGNURestrictPrefix . DeclarationSpecifiers ::= "(" "__restrict" "." DeclarationSpecifiers ")";
      PrefixSpecInline . DeclarationSpecifiers ::= "(" "inline" "." DeclarationSpecifiers ")";
      PrefixSpecNoreturn . DeclarationSpecifiers ::= "(" "_Noreturn" "." DeclarationSpecifiers ")";
      PrefixSpecGNUInline . DeclarationSpecifiers ::= "(" "__inline__" "." DeclarationSpecifiers ")";
      PrefixSpecGNUInlinePrefix . DeclarationSpecifiers ::= "(" "__inline" "." DeclarationSpecifiers ")";
      PrefixSpecAttribute . DeclarationSpecifiers ::= "(" GNUAttribute "." DeclarationSpecifiers ")";

      BareNonTypeTypedef . NonTypeSpecifier ::= "typedef";
      BareNonTypeExtern . NonTypeSpecifier ::= "extern";
      BareNonTypeStatic . NonTypeSpecifier ::= "static";
      BareNonTypeThreadLocal . NonTypeSpecifier ::= "_Thread_local";
      BareNonTypeAuto . NonTypeSpecifier ::= "auto";
      BareNonTypeRegister . NonTypeSpecifier ::= "register";
      BareNonTypeGNUThread . NonTypeSpecifier ::= "__thread";
      BareNonTypeConst . NonTypeSpecifier ::= "const";
      BareNonTypeRestrict . NonTypeSpecifier ::= "restrict";
      BareNonTypeVolatile . NonTypeSpecifier ::= "volatile";
      BareNonTypeAtomicQualifier . NonTypeSpecifier ::= "_Atomic";
      BareNonTypeGNUConst . NonTypeSpecifier ::= "__const__";
      BareNonTypeGNUConstPrefix . NonTypeSpecifier ::= "__const";
      BareNonTypeGNUVolatile . NonTypeSpecifier ::= "__volatile__";
      BareNonTypeGNUVolatilePrefix . NonTypeSpecifier ::= "__volatile";
      BareNonTypeGNURestrict . NonTypeSpecifier ::= "__restrict__";
      BareNonTypeGNURestrictPrefix . NonTypeSpecifier ::= "__restrict";
      BareNonTypeInline . NonTypeSpecifier ::= "inline";
      BareNonTypeNoreturn . NonTypeSpecifier ::= "_Noreturn";
      BareNonTypeGNUInline . NonTypeSpecifier ::= "__inline__";
      BareNonTypeGNUInlinePrefix . NonTypeSpecifier ::= "__inline";
      AttributeSpecifier . NonTypeSpecifier ::= GNUAttribute;
      AlignasTypeSpecifier . NonTypeSpecifier ::= "(" "_Alignas" "type" TypeName ")";
      AlignasExpressionSpecifier . NonTypeSpecifier ::= "(" "_Alignas" Expr2 ")";
      PrimitiveSpecifierTail . PrimitiveOrNonTypeSpecifier ::= PrimitiveTypeSpecifier;
      NonTypeSpecifierTail . PrimitiveOrNonTypeSpecifier ::= NonTypeSpecifier;

      Typedef . StorageClass ::= "typedef";
      Extern . StorageClass ::= "extern";
      Static . StorageClass ::= "static";
      ThreadLocal . StorageClass ::= "_Thread_local";
      Auto . StorageClass ::= "auto";
      Register . StorageClass ::= "register";
      GNUThread . StorageClass ::= "__thread";
      Char . PrimitiveTypeSpecifier ::= "char";
      Short . PrimitiveTypeSpecifier ::= "short";
      Int . PrimitiveTypeSpecifier ::= "int";
      Long . PrimitiveTypeSpecifier ::= "long";
      Float . PrimitiveTypeSpecifier ::= "float";
      Double . PrimitiveTypeSpecifier ::= "double";
      Signed . PrimitiveTypeSpecifier ::= "signed";
      Unsigned . PrimitiveTypeSpecifier ::= "unsigned";
      Complex . PrimitiveTypeSpecifier ::= "_Complex";
      GNUInt128 . PrimitiveTypeSpecifier ::= "__int128";
      GNUFloat16 . PrimitiveTypeSpecifier ::= "_Float16";
      GNUSigned . PrimitiveTypeSpecifier ::= "__signed__";
      Void . UniqueTypeSpecifier ::= "void";
      Bool . UniqueTypeSpecifier ::= "_Bool";
      GNUAutoType . UniqueTypeSpecifier ::= "__auto_type";
      GNUFloat128 . UniqueTypeSpecifier ::= "_Float128";
      GNUFloat32 . UniqueTypeSpecifier ::= "_Float32";
      GNUBFloat16 . UniqueTypeSpecifier ::= "__bf16";
      GNUFloat64 . UniqueTypeSpecifier ::= "_Float64";
      GNUFloat32x . UniqueTypeSpecifier ::= "_Float32x";
      GNUFloat64x . UniqueTypeSpecifier ::= "_Float64x";
      GNUFloat128x . UniqueTypeSpecifier ::= "_Float128x";
      GNUQuad . UniqueTypeSpecifier ::= "__float128";
      TypedefType . UniqueTypeSpecifier ::= CTypedefName;
      StructType . UniqueTypeSpecifier ::= StructSpecifier;
      AtomicType . UniqueTypeSpecifier ::= "(" "atomic-type" TypeName ")";
      TypeofExpression . UniqueTypeSpecifier ::= "(" "typeof" Expr ")";
      TypeofType . UniqueTypeSpecifier ::= "(" "typeof" "type" TypeName ")";
      TypeofUnderscoresExpression . UniqueTypeSpecifier ::= "(" "__typeof__" Expr ")";
      TypeofUnderscoresType . UniqueTypeSpecifier ::= "(" "__typeof__" "type" TypeName ")";
      TypeofPrefixExpression . UniqueTypeSpecifier ::= "(" "__typeof" Expr ")";
      TypeofPrefixType . UniqueTypeSpecifier ::= "(" "__typeof" "type" TypeName ")";
      EnumReferenceShort . UniqueTypeSpecifier ::= "(" "enum" CGeneralName ")";
      EnumDefinitionShort . UniqueTypeSpecifier ::= "(" "enum" OptionalIdent [Enumerator] ")";
      EnumDefinitionCommaShort . UniqueTypeSpecifier ::= "(" "enum," OptionalIdent [Enumerator] ")";
      Const . TypeQualifier ::= "const";
      Restrict . TypeQualifier ::= "restrict";
      Volatile . TypeQualifier ::= "volatile";
      AtomicQualifier . TypeQualifier ::= "_Atomic";
      GNUConst . TypeQualifier ::= "__const__";
      GNUConstPrefix . TypeQualifier ::= "__const";
      GNUVolatile . TypeQualifier ::= "__volatile__";
      GNUVolatilePrefix . TypeQualifier ::= "__volatile";
