      -- Specifier-qualifier lists of members and type names.
      BareSQChar . SpecifierQualifiers ::= "char";
      BareSQShort . SpecifierQualifiers ::= "short";
      BareSQInt . SpecifierQualifiers ::= "int";
      BareSQLong . SpecifierQualifiers ::= "long";
