(cesta record-visitors/1
 (owner arena-identity)
 (owner call-source-holders)
 (owner equation-holder)
 (owner eval-context)
 (owner frame-graph)
 (owner moving-roots)
 (owner need-holder)
 (owner nested-policy)
 (owner opaque)
 (owner program-space)
 (owner selection-indices)
 (visitor control_key (owner opaque) (type "struct Atom *")
  (call cesta_frame_null_reference) (argument value) (effects read)
  (obligation "An active opaque reference refuses collection; no target is dereferenced."))
 (visitor control_bound (owner opaque) (type "struct Atom *")
  (call cesta_frame_null_reference) (argument value) (effects read)
  (obligation "An active opaque reference refuses collection; no target is dereferenced."))
 (visitor control_advice (owner opaque) (type "struct PrimeNativeAdvice *")
  (call cesta_frame_null_reference) (argument value) (effects read)
  (obligation "An active opaque reference refuses collection; no target is dereferenced."))
 (visitor control_child_bounds (owner opaque) (type "struct Atom **")
  (call cesta_frame_null_reference) (argument value) (effects read)
  (obligation "An active opaque reference refuses collection; no target is dereferenced."))
 (visitor control_nested (owner opaque) (type "struct PrimeNativeControl *")
  (call cesta_frame_null_reference) (argument value) (effects read)
  (obligation "An active opaque reference refuses collection; no target is dereferenced."))
 (visitor control_nested_operation (owner opaque) (type "struct PrimeNativeAcquiredOperation *")
  (call cesta_frame_null_reference) (argument value) (effects read)
  (obligation "An active opaque reference refuses collection; no target is dereferenced."))
 (visitor dialect_source (owner opaque) (type "struct NativeDialectWork *")
  (call cesta_frame_null_reference) (argument value) (effects read)
  (obligation "An active opaque reference refuses collection; no target is dereferenced."))
 (visitor capsule_search (owner opaque) (type "struct PrimeCapsuleSearch *")
  (call cesta_frame_null_reference) (argument value) (effects read)
  (obligation "An active opaque reference refuses collection; no target is dereferenced."))
 (visitor match_rows (owner opaque) (type "PrimeMatchRows *")
  (call cesta_frame_null_reference) (argument value) (effects read)
  (obligation "An active opaque reference refuses collection; no target is dereferenced."))
 (visitor native_service (owner opaque) (type "PrimeNativeService *")
  (call cesta_frame_null_reference) (argument value) (effects read)
  (obligation "An active opaque reference refuses collection; no target is dereferenced."))
 (visitor return_advice (owner opaque) (type "PrimeNativeReturnAdvice *")
  (call cesta_frame_empty_advice) (argument value) (counted) (effects read)
  (obligation "Nonempty advice is opaque and refuses collection; zero length visits no entries."))
 (visitor pending_advice (owner opaque) (type "PrimeNativeReturnAdvice")
  (call cesta_frame_pending_advice) (argument address) (effects read)
  (obligation "A pending return is opaque and refuses collection without inspecting its payload."))
 (record "PrimeEvalStackFrame" (function cesta_frame_gc_gate) (context "CestaFrameGcAudit") (receiver read)
  (field continuation (borrow read) (owner frame-graph) (keep "Link in the separately allocated frame graph; the native scheduler retains its target."))
  (field control_next (borrow read nullable) (owner frame-graph) (keep "Link in the separately allocated frame graph; the native scheduler retains its target."))
  (field control_previous (borrow read nullable) (owner frame-graph) (keep "Link in the separately allocated frame graph; the native scheduler retains its target."))
  (field control_parent (borrow read nullable) (owner frame-graph) (keep "Link in the separately allocated frame graph; the native scheduler retains its target."))
  (field control_pending value)
  (field control_sequence value)
  (field control_queued value)
  (field control_closed value)
  (field control_notified value)
  (field control_changed value)
  (field control_retired value)
  (field control_shell_refs value)
  (field control_advisory value)
  (field control_force_stream value)
  (field control_force_detached value)
  (field control_key (borrow read nullable) (owner opaque) (visit control_key))
  (field control_bound (borrow read nullable) (owner opaque) (visit control_bound))
  (field control_advice (borrow read nullable) (owner opaque) (visit control_advice))
  (field control_child_bounds (borrow read nullable) (owner opaque) (visit control_child_bounds))
  (field control_child_bound_length value)
  (field control_child_bound_capacity value)
  (field control_nested (borrow read nullable) (owner opaque) (visit control_nested))
  (field control_nested_operation (borrow read nullable) (owner opaque) (visit control_nested_operation))
  (field control_nested_policy (borrow read) (owner nested-policy) (keep "Used with the nested control, whose active pointer the generated gate refuses; native policy/context lifetime remains an explicit obligation."))
  (field control_nested_budget value)
  (field control_nested_handle value)
  (field control_nested_retained value)
  (field control_nested_parked value)
  (field control_scoring value)
  (field control_generation value)
  (field control_selection (borrow read nullable) (owner selection-indices) (keep "Separately allocated indices contain no atom references and are released by the frame owner."))
  (field control_selection_length value)
  (field dialect_source (borrow read nullable) (owner opaque) (visit dialect_source))
  (field dialect_source_success value)
  (field dialect_source_is_call value)
  (field dialect_error_index value)
  (field control_return_advice (borrow read nullable) (owner opaque) (visit return_advice) (count control_return_advice_length))
  (field control_return_advice_capacity value)
  (field control_return_advice_length value)
  (field control_return_pending_advice (borrow read) (owner opaque) (visit pending_advice) (when control_return_pending))
  (field control_return_pending_begin value)
  (field control_return_pending_end value)
  (field control_return_pending value)
  (field kind value)
  (field ordinary_ordered value)
  (field pure_authority value)
  (field state value)
  (field space (borrow read nullable) (owner program-space) (keep "Identity link to a retained Space; spaces are not evacuated by this collector."))
  (field arena (borrow read nullable) (owner arena-identity) (keep "Identity link compared by the native driver audit; the Arena descriptor is not evacuated."))
  (field target (borrow read nullable) (owner moving-roots) (keep "Visited by prime_eval_stack_evacuate_frame; the native driver audits nonmoving binding carriers before evacuation."))
  (field context (borrow read nullable) (owner eval-context) (keep "Reference-counted context holds policies and Space identities rather than arena atoms."))
  (field atom (borrow read nullable) (owner moving-roots) (keep "Visited by prime_eval_stack_evacuate_frame; the native driver audits nonmoving binding carriers before evacuation."))
  (field etype (borrow read nullable) (owner moving-roots) (keep "Visited by prime_eval_stack_evacuate_frame; the native driver audits nonmoving binding carriers before evacuation."))
  (field fuel value)
  (field preserve_bindings value)
  (field env (borrow read) (owner moving-roots) (keep "Visited by prime_eval_stack_evacuate_frame; the native driver audits nonmoving binding carriers before evacuation."))
  (field env_initialized value)
  (field child (borrow read) (owner moving-roots) (keep "Visited by prime_eval_stack_evacuate_frame; the native driver audits nonmoving binding carriers before evacuation."))
  (field child_initialized value)
  (field force_pending (borrow read) (owner moving-roots) (keep "Visited by prime_eval_stack_evacuate_frame; the native driver audits nonmoving binding carriers before evacuation."))
  (field force_pending_initialized value)
  (field force_pending_observed value)
  (field force_published value)
  (field force_retry_pending value)
  (field index value)
  (field branch_index value)
  (field variable_branches_active value)
  (field equation_search (borrow read nullable) (owner equation-holder) (keep "The native equation audit checks its holders; evacuation moves its listed roots and immediately refreshes aliases."))
  (field capsule_search (borrow read nullable) (owner opaque) (visit capsule_search))
  (field match_rows (borrow read nullable) (owner opaque) (visit match_rows))
  (field native_service (borrow read nullable) (owner opaque) (visit native_service))
  (field call_force_reader (borrow read nullable) (owner call-source-holders) (keep "Reference-counted link to the native audited cell/slot/production graph; checkpoint storage and association remain native obligations."))
  (field normalization_children (borrow read nullable) (owner moving-roots) (keep "Visited by prime_eval_stack_evacuate_frame; the native driver audits nonmoving binding carriers before evacuation."))
  (field normalization_child_count value)
  (field normalization_child_index value)
  (field normalization_value_ready value)
  (field normalization_result_form value)
  (field normalization_return_value_ready value)
  (field tuple_bind value)
  (field strict_argument value)
  (field strict_mode value)
  (field strict_error_is_data value)
  (field strict_source (borrow read nullable) (owner moving-roots) (keep "Visited by prime_eval_stack_evacuate_frame; the native driver audits nonmoving binding carriers before evacuation."))
  (field then_branch (borrow read nullable) (owner moving-roots) (keep "Visited by prime_eval_stack_evacuate_frame; the native driver audits nonmoving binding carriers before evacuation."))
  (field else_branch (borrow read nullable) (owner moving-roots) (keep "Visited by prime_eval_stack_evacuate_frame; the native driver audits nonmoving binding carriers before evacuation."))
  (field weight_subject (borrow read nullable) (owner moving-roots) (keep "Visited by prime_eval_stack_evacuate_frame; the native driver audits nonmoving binding carriers before evacuation."))
  (field weight_algebra (borrow read nullable) (owner moving-roots) (keep "Visited by prime_eval_stack_evacuate_frame; the native driver audits nonmoving binding carriers before evacuation."))
  (field weight_trace (borrow read nullable) (owner moving-roots) (keep "Visited by prime_eval_stack_evacuate_frame; the native driver audits nonmoving binding carriers before evacuation."))
  (field weight_index value)
  (field weight_dependency value)
  (field weight_ownership_parked value)
  (field ref (borrow read nullable) (owner moving-roots) (keep "Visited by prime_eval_stack_evacuate_frame; the native driver audits nonmoving binding carriers before evacuation."))
  (field thunk_id value)
  (field value_producer_thunk value)
  (field cell (borrow read) (owner need-holder) (keep "FORCE admission audits origin, cache and capture references against both forbidden arenas."))
  (field before (borrow read) (owner need-holder) (keep "The native FORCE audit checks the snapshot and carrier against both forbidden arenas."))
  (field evaluating (borrow read) (owner need-holder) (keep "The native FORCE audit checks the snapshot and carrier against both forbidden arenas."))
  (field heap_owner (borrow read nullable) (owner arena-identity) (keep "The native FORCE audit compares this identity against the Need owner and both forbidden arenas."))
  (field previous_evaluator_id value)
  (field evaluator_id value)
  (field source_argument_universal_demand value)
  (field shared_need_wait value)
  (field force_waiters (borrow read nullable) (owner frame-graph) (keep "Link in the separately allocated frame graph; the native scheduler retains its target."))
  (field force_waiter_next (borrow read nullable) (owner frame-graph) (keep "Link in the separately allocated frame graph; the native scheduler retains its target."))
  (field force_producer (borrow read nullable) (owner frame-graph) (keep "Link in the separately allocated frame graph; the native scheduler retains its target."))
  (field open_force_next (borrow read nullable) (owner frame-graph) (keep "Link in the separately allocated frame graph; the native scheduler retains its target."))
  (field force_empty_lexical_env value)
  (field force_source_read (borrow read) (owner program-space) (keep "Revision token over retained Space identity; source freshness remains a native scheduling obligation."))
  (field stream_forwarded value)
  (field stream_consumer (borrow read nullable) (owner frame-graph) (keep "Link in the separately allocated frame graph; the native scheduler retains its target."))
))
