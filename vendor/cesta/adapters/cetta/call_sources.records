(cesta record-visitors/1
 (owner episode) (owner cell-links) (owner source-slots) (owner fork-points)
 (visitor reference (owner episode) (type "Atom *")
  (call cesta_call_source_reference) (argument value) (effects read)
  (obligation "The native predicate checks the complete atom graph against both forbidden arenas."))
 (visitor common (owner episode) (type "Bindings")
  (call cesta_call_source_common) (argument address) (effects read)
  (obligation "The native held-bindings audit checks logical atoms, worlds, carriers and reader contexts against both forbidden arenas."))
 (visitor slots (owner source-slots) (type "PrimeNeedCallSourceSlot *")
  (call cesta_call_source_slots) (argument value) (effects read)
  (obligation "Each retained slot is audited through its input and production holders; the native audit memoizes graph visits."))
 (visitor forks (owner fork-points) (type "PrimeNeedCallForkPoint *")
  (call cesta_call_source_forks) (argument value) (effects read)
  (obligation "Each fork's origin and snapshot are audited as production holders."))
 (record "PrimeNeedCallSourceCell" (function cesta_call_source_audit)
  (context "CestaCallSourceAudit") (receiver read)
  (field next (borrow read nullable) (owner cell-links)
   (keep "The enclosing hub loop visits the separately allocated cell list; cells remain live throughout the audit."))
  (field session value) (field thunk value) (field authority value) (field cursor_key value)
  (field reference (borrow read nullable) (owner episode) (visit reference))
  (field common (borrow read) (owner episode) (visit common))
  (field slots (borrow read nullable) (owner source-slots) (visit slots))
  (field forks (borrow read nullable) (owner fork-points) (visit forks))))
