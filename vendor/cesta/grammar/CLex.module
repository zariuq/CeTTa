                       digit+ ["eE"] ["+-"]? digit+) ["fFlL"]?) |
        ('0' ["xX"] (((digit | ["abcdefABCDEF"])* '.' (digit | ["abcdefABCDEF"])+) |
          ((digit | ["abcdefABCDEF"])+ '.'?)) ["pP"] ["+-"]? digit+ ["fFlL"]?));
    }
  }
