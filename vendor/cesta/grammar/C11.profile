profile C11;
classification CIdent "<ordinary-name>" "<typedef-name>" using CScope;
-- ISO 6.4.6p3: alternative punctuator spellings have the same meaning.
lexical spelling "<:" as "[";
lexical spelling ":>" as "]";
lexical spelling "<%" as "{";
lexical spelling "%>" as "}";
lexical spelling "%:" as "#";
lexical spelling "%:%:" as "##";
-- Formatting is a token-layout profile over the existing source productions.
layout block "{" "}";
layout group "(" ")";
layout group "[" "]";
layout line ";";
layout join "else" "while";
layout tight "(" "[" "." "->";
layout left ")" "]" "," ";";
layout spaced "return" "if" "while" "for" "switch";
layout prefix "!" "~" "-" "+" "*" "&" "++" "--";
layout attach ":" in "GenericType" "GenericAssociation" "GenericDefault" "GenericAssociation"
    "Label" "LabeledStatement" "Case" "LabeledStatement" "Default" "LabeledStatement";
layout spaced "+" "-" "*" "/" "%" "<<" ">>" "&" "^" "|" "&&" "||" "==" "!=" "<" ">" "<=" ">=" "=";
layout spaced "+=" "-=" "*=" "/=" "%=" "<<=" ">>=" "&=" "^=" "|=" "?" ":";
layout spaced ";" ",";
layout indent 2;
-- Parentheses required by native -Wparentheses diagnostics are contextual.
layout protect "And" "Expr4" with "_" "Expr16" inside "Or" "Expr3";
layout protect "BitAnd" "Expr7" with "_" "Expr16" inside "BitOr" "Expr5";
layout protect "BitAnd" "Expr7" with "_" "Expr16" inside "BitXor" "Expr6";
layout protect "BitXor" "Expr6" with "_" "Expr16" inside "BitOr" "Expr5";
layout protect "Add" "Expr11" with "_" "Expr16" inside "ShiftLeft" "Expr10";
layout protect "Add" "Expr11" with "_" "Expr16" inside "ShiftRight" "Expr10";
layout protect "Subtract" "Expr11" with "_" "Expr16" inside "ShiftLeft" "Expr10";
layout protect "Subtract" "Expr11" with "_" "Expr16" inside "ShiftRight" "Expr10";
layout protect "Add" "Expr11" with "_" "Expr16" inside "BitAnd" "Expr7";
layout protect "Add" "Expr11" with "_" "Expr16" inside "BitXor" "Expr6";
layout protect "Add" "Expr11" with "_" "Expr16" inside "BitOr" "Expr5";
layout protect "Subtract" "Expr11" with "_" "Expr16" inside "BitAnd" "Expr7";
layout protect "Subtract" "Expr11" with "_" "Expr16" inside "BitXor" "Expr6";
layout protect "Subtract" "Expr11" with "_" "Expr16" inside "BitOr" "Expr5";
layout protect "Equal" "Expr8" with "_" "Expr16" inside "BitAnd" "Expr7";
layout protect "Equal" "Expr8" with "_" "Expr16" inside "BitXor" "Expr6";
layout protect "Equal" "Expr8" with "_" "Expr16" inside "BitOr" "Expr5";
layout protect "NotEqual" "Expr8" with "_" "Expr16" inside "BitAnd" "Expr7";
layout protect "NotEqual" "Expr8" with "_" "Expr16" inside "BitXor" "Expr6";
layout protect "NotEqual" "Expr8" with "_" "Expr16" inside "BitOr" "Expr5";
layout protect "Less" "Expr9" with "_" "Expr16" inside "BitAnd" "Expr7";
layout protect "Less" "Expr9" with "_" "Expr16" inside "BitXor" "Expr6";
layout protect "Less" "Expr9" with "_" "Expr16" inside "BitOr" "Expr5";
layout protect "Greater" "Expr9" with "_" "Expr16" inside "BitAnd" "Expr7";
layout protect "Greater" "Expr9" with "_" "Expr16" inside "BitXor" "Expr6";
layout protect "Greater" "Expr9" with "_" "Expr16" inside "BitOr" "Expr5";
layout protect "LessEqual" "Expr9" with "_" "Expr16" inside "BitAnd" "Expr7";
layout protect "LessEqual" "Expr9" with "_" "Expr16" inside "BitXor" "Expr6";
layout protect "LessEqual" "Expr9" with "_" "Expr16" inside "BitOr" "Expr5";
layout protect "GreaterEqual" "Expr9" with "_" "Expr16" inside "BitAnd" "Expr7";
layout protect "GreaterEqual" "Expr9" with "_" "Expr16" inside "BitXor" "Expr6";
layout protect "GreaterEqual" "Expr9" with "_" "Expr16" inside "BitOr" "Expr5";
layout protect "Assign" "Expr1" with "_" "Expr16" inside "If" "SelectionStatement" argument 0;
layout protect "Assign" "Expr1" with "_" "Expr16" inside "IfElse" "SelectionStatement" argument 0;
layout protect "Assign" "Expr1" with "_" "Expr16" inside "While" "IterationStatement" argument 0;
layout protect "Assign" "Expr1" with "_" "Expr16" inside "DoWhile" "IterationStatement" argument 1;
layout protect "Assign" "Expr1" with "_" "Expr16" inside "For" "IterationStatement" argument 1;
layout protect "Assign" "Expr1" with "_" "Expr16" inside "ForDeclaration" "IterationStatement" argument 1;
-- Explicitly grouped comparisons preserve warning-clean chained readings.
layout protect "Less" "Expr9" with "_" "Expr16" inside "Less" "Expr9";
layout protect "Less" "Expr9" with "_" "Expr16" inside "Greater" "Expr9";
layout protect "Less" "Expr9" with "_" "Expr16" inside "LessEqual" "Expr9";
layout protect "Less" "Expr9" with "_" "Expr16" inside "GreaterEqual" "Expr9";
layout protect "Less" "Expr9" with "_" "Expr16" inside "Equal" "Expr8";
layout protect "Less" "Expr9" with "_" "Expr16" inside "NotEqual" "Expr8";
layout protect "Greater" "Expr9" with "_" "Expr16" inside "Less" "Expr9";
layout protect "Greater" "Expr9" with "_" "Expr16" inside "Greater" "Expr9";
layout protect "Greater" "Expr9" with "_" "Expr16" inside "LessEqual" "Expr9";
layout protect "Greater" "Expr9" with "_" "Expr16" inside "GreaterEqual" "Expr9";
layout protect "Greater" "Expr9" with "_" "Expr16" inside "Equal" "Expr8";
layout protect "Greater" "Expr9" with "_" "Expr16" inside "NotEqual" "Expr8";
layout protect "LessEqual" "Expr9" with "_" "Expr16" inside "Less" "Expr9";
layout protect "LessEqual" "Expr9" with "_" "Expr16" inside "Greater" "Expr9";
layout protect "LessEqual" "Expr9" with "_" "Expr16" inside "LessEqual" "Expr9";
layout protect "LessEqual" "Expr9" with "_" "Expr16" inside "GreaterEqual" "Expr9";
layout protect "LessEqual" "Expr9" with "_" "Expr16" inside "Equal" "Expr8";
layout protect "LessEqual" "Expr9" with "_" "Expr16" inside "NotEqual" "Expr8";
layout protect "GreaterEqual" "Expr9" with "_" "Expr16" inside "Less" "Expr9";
layout protect "GreaterEqual" "Expr9" with "_" "Expr16" inside "Greater" "Expr9";
layout protect "GreaterEqual" "Expr9" with "_" "Expr16" inside "LessEqual" "Expr9";
layout protect "GreaterEqual" "Expr9" with "_" "Expr16" inside "GreaterEqual" "Expr9";
layout protect "GreaterEqual" "Expr9" with "_" "Expr16" inside "Equal" "Expr8";
layout protect "GreaterEqual" "Expr9" with "_" "Expr16" inside "NotEqual" "Expr8";
layout protect "Equal" "Expr8" with "_" "Expr16" inside "Equal" "Expr8";
layout protect "Equal" "Expr8" with "_" "Expr16" inside "NotEqual" "Expr8";
layout protect "NotEqual" "Expr8" with "_" "Expr16" inside "Equal" "Expr8";
layout protect "NotEqual" "Expr8" with "_" "Expr16" inside "NotEqual" "Expr8";
-- ISO 6.7.2.4p4 fixes lexical interpretation even when no LR conflict arises.
lexical pair "_Atomic" "(" as "<atomic-parenthesis>";
-- Scope events are erased from the source tree and its S-expression quotation.
scope hook "Declaration" "Declaration" at 1 DeclarationOpen;
scope hook "Declaration" "Declaration" at 3 DeclarationClose;
scope hook "FunctionDefinition" "FunctionDefinition" at 1 DeclarationOpen;
scope hook "FunctionDefinition" "FunctionDefinition" at 2 FunctionOpen;
scope hook "FunctionDefinition" "FunctionDefinition" at 4 FunctionClose;
scope hook "_" "BoundDeclarator" at 1 BindDeclarator;
scope hook "NamedParameter" "Parameter" at 2 BindParameter;
scope reduction "Enumerator" "Enumerator" BindEnumerator;
scope reduction "EnumeratorValue" "Enumerator" BindEnumerator;
scope reduction "_" "OldParameterName" BindEnumerator;
-- The whole declarator is visible before its initializer; members never bind here.
scope hook "ParenthesizedDeclarator" "DirectDeclarator" at 1 PrototypeOpen;
scope hook "ParenthesizedDeclarator" "DirectDeclarator" at 3 ContextKeep;
scope hook "FunctionDeclarator" "DirectDeclarator" at 2 PrototypeOpen;
scope hook "FunctionDeclarator" "DirectDeclarator" at 3 PrototypeClose;
scope reduction "FunctionDeclarator" "DirectDeclarator" RecordFunction;
scope hook "OldFunctionDeclarator" "DirectDeclarator" at 2 PrototypeOpen;
scope hook "OldFunctionDeclarator" "DirectDeclarator" at 3 PrototypeClose;
scope reduction "OldFunctionDeclarator" "DirectDeclarator" RecordFunction;
scope hook "ParenthesizedAbstractDeclarator" "DirectAbstractDeclarator" at 1 PrototypeOpen;
scope hook "ParenthesizedAbstractDeclarator" "DirectAbstractDeclarator" at 3 ContextKeep;
scope hook "AbstractFunction" "DirectAbstractDeclarator" at 1 PrototypeOpen;
scope hook "AbstractFunction" "DirectAbstractDeclarator" at 2 PrototypeClose;
scope hook "NestedAbstractFunction" "DirectAbstractDeclarator" at 2 PrototypeOpen;
scope hook "NestedAbstractFunction" "DirectAbstractDeclarator" at 3 PrototypeClose;
-- Block and selection/iteration scopes; each controlled substatement has a scope.
scope hook "Block" "Block" at 1 Push;
scope hook "Block" "Block" at 2 Pop;
scope hook "If" "SelectionStatement" at 0 Push;
scope hook "If" "SelectionStatement" at 4 Push;
scope hook "If" "SelectionStatement" at 5 Pop;
scope hook "If" "SelectionStatement" at 5 Pop;
scope hook "IfElse" "SelectionStatement" at 0 Push;
scope hook "IfElse" "SelectionStatement" at 4 Push;
scope hook "IfElse" "SelectionStatement" at 5 Pop;
scope hook "IfElse" "SelectionStatement" at 6 Push;
scope hook "IfElse" "SelectionStatement" at 7 Pop;
scope hook "IfElse" "SelectionStatement" at 7 Pop;
scope hook "Switch" "SelectionStatement" at 0 Push;
scope hook "Switch" "SelectionStatement" at 4 Push;
scope hook "Switch" "SelectionStatement" at 5 Pop;
scope hook "Switch" "SelectionStatement" at 5 Pop;
scope hook "While" "IterationStatement" at 0 Push;
scope hook "While" "IterationStatement" at 4 Push;
scope hook "While" "IterationStatement" at 5 Pop;
scope hook "While" "IterationStatement" at 5 Pop;
scope hook "DoWhile" "IterationStatement" at 0 Push;
scope hook "DoWhile" "IterationStatement" at 1 Push;
scope hook "DoWhile" "IterationStatement" at 2 Pop;
scope hook "DoWhile" "IterationStatement" at 7 Pop;
scope hook "For" "IterationStatement" at 0 Push;
scope hook "For" "IterationStatement" at 8 Push;
scope hook "For" "IterationStatement" at 9 Pop;
scope hook "For" "IterationStatement" at 9 Pop;
scope hook "ForDeclaration" "IterationStatement" at 0 Push;
scope hook "ForDeclaration" "IterationStatement" at 7 Push;
scope hook "ForDeclaration" "IterationStatement" at 8 Pop;
scope hook "ForDeclaration" "IterationStatement" at 8 Pop;
-- ISO 6.8.4.1: an else associates with the lexically nearest eligible if.
conflict "else" prefer shift over reduce "ScopePop" "ScopePop";
-- ISO 6.7.6.3p11: in int(T), a typedef names the anonymous parameter type.
conflict "(" prefer reduce "TypedefType" "UniqueTypeSpecifier" over reduce "_" "CGeneralTypedefName";
conflict ")" prefer reduce "TypedefType" "UniqueTypeSpecifier" over reduce "_" "CGeneralTypedefName";
conflict "[" prefer reduce "TypedefType" "UniqueTypeSpecifier" over reduce "_" "CGeneralTypedefName";
-- ISO 6.7.7: [*] is the abstract variable array form. [*p] has an expression.
conflict "*" prefer shift over reduce "NoTypeQualifiers" "OptionalTypeQualifiers" when next "]";
