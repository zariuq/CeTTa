-- Cesta theory-source adapter, version 1. The module syntax supplies data to
-- the presentation algebra; language parser policy is declared separately.
-- Constructor identities below are the adapter's abstract syntax interface.
-- Equation and rewrite trees are retained as source declarations.
entrypoints Module;
ModuleImpl . Module ::= [Import] "Module" Name "{" [Prog] "}";
ImportModuleAs . Import ::= "import" String "as" Ident;
terminator Import "";
NameWildcard . Name ::= "_";
NameVar . Name ::= Ident;
ProgTheoryDecl . Prog ::= TheoryDecl;
ProgTheoryInst . Prog ::= "theory" TheoryInst;
terminator Prog "";
BaseTheoryDecl . TheoryDecl ::= "Theory" Name "(" [VariableDecl] ")" "{" TheoryInst "}";
VarDecl . VariableDecl ::= Ident ":" DottedPath;
separator VariableDecl ",";
BaseDottedPath . DottedPath ::= Ident;
QualifiedDottedPath . DottedPath ::= Ident "." DottedPath;

TheoryInstSubtract . TheoryInst ::= TheoryInst "\\" TheoryInst1;
TheoryInstDisj . TheoryInst1 ::= TheoryInst1 "\\/" TheoryInst2;
TheoryInstConj . TheoryInst2 ::= TheoryInst2 "/\\" TheoryInst3;
TheoryInstAddExports . TheoryInst3 ::= TheoryInst3 "Exports" "{" [Export] "}";
TheoryInstAddReplacements . TheoryInst3 ::= TheoryInst3 "Replacements" "{" [Replacement] "}";
TheoryInstAddTerms . TheoryInst3 ::= TheoryInst3 "Terms" "{" Grammar "}";
TheoryInstAddEquations . TheoryInst3 ::= TheoryInst3 "Equations" "{" [Equation] "}";
TheoryInstAddRewrites . TheoryInst3 ::= TheoryInst3 "Rewrites" "{" [RewriteDecl] "}";
TheoryInstEmpty . TheoryInst4 ::= "Empty";
TheoryInstRef . TheoryInst4 ::= Ident;
TheoryInstCtor . TheoryInst4 ::= DottedPath "(" [TheoryInst] ")";
TheoryInstFree . TheoryInst4 ::= "free" "(" DottedPath ")";
TheoryInstRec . TheoryInst4 ::= "let" Ident "=" TheoryInst "in" "(" TheoryInst ")";
_ . TheoryInst ::= TheoryInst1;
_ . TheoryInst1 ::= TheoryInst2;
_ . TheoryInst2 ::= TheoryInst3;
_ . TheoryInst3 ::= TheoryInst4;
_ . TheoryInst4 ::= "{" TheoryInst "}";
separator TheoryInst ",";

BaseExport . Export ::= Cat;
RenameExport . Export ::= Cat "=>" Cat;
terminator Export ";";
SimpleRepl . Replacement ::= IntList Label "." Cat "=>" Def;
terminator Replacement ";";
Ints . IntList ::= "[" [Integer] "]";
separator Integer ",";
MkGrammar . Grammar ::= [Def];
terminator Def ";";
Rule . Def ::= Label "." Cat "::=" [Item];
Internal . Def ::= "internal" Label "." Cat "::=" [Item];
Token . Def ::= "token" Ident Reg;
PosToken . Def ::= "position" "token" Ident Reg;
Comment . Def ::= "comment" String;
Comments . Def ::= "comment" String String;
Entryp . Def ::= "entrypoints" [Ident];
Separator . Def ::= "separator" MinimumSize Cat String;
Terminator . Def ::= "terminator" MinimumSize Cat String;
Coercions . Def ::= "coercions" Ident Integer;
Rules . Def ::= "rules" Ident "::=" [RHS];
Layout . Def ::= "layout" [String];
LayoutStop . Def ::= "layout" "stop" [String];
LayoutTop . Def ::= "layout" "toplevel";
MNonempty . MinimumSize ::= "nonempty";
MEmpty . MinimumSize ::=;
MkRHS . RHS ::= [Item];
separator nonempty RHS "|";
Terminal . Item ::= String;
NTerminal . Item ::= Cat;
AbsNTerminal . Item ::= "(" Ident ")" Item;
BindNTerminal . Item ::= "(" "Bind" Ident Cat ")";
terminator Item "";
ListOfCat . Cat ::= "[" Cat "]";
IdCat . Cat ::= Ident;
ArrowCat . Cat ::= "(" Cat "->" Cat ")";
ProdCat . Cat ::= "Product" "{" [Cat] "}";
terminator Cat ";";
Id . Label ::= Ident;
Wild . Label ::= "_";
ListE . Label ::= "[" "]" "{" Cat "}";
ListCons . Label ::= "(" ":" ")" "{" Cat "}";
ListOne . Label ::= "(" ":" "[" "]" ")" "{" Cat "}";
separator nonempty Ident ",";
separator nonempty String ",";

RAlt . Reg1 ::= Reg1 "|" Reg2;
RMinus . Reg1 ::= Reg2 "-" Reg2;
RSeq . Reg2 ::= Reg2 Reg3;
RStar . Reg3 ::= Reg3 "*";
RPlus . Reg3 ::= Reg3 "+";
ROpt . Reg3 ::= Reg3 "?";
REps . Reg3 ::= "eps";
RChar . Reg3 ::= Char;
RAlts . Reg3 ::= "[" String "]";
RSeqs . Reg3 ::= "{" String "}";
RDigit . Reg3 ::= "digit";
RLetter . Reg3 ::= "letter";
RUpper . Reg3 ::= "upper";
RLower . Reg3 ::= "lower";
RAny . Reg3 ::= "char";
_ . Reg ::= Reg1;
_ . Reg1 ::= Reg2;
_ . Reg2 ::= Reg3;
_ . Reg3 ::= "(" Reg ")";

EquationImpl . Equation ::= AST "==" AST;
EquationFresh . Equation ::= "if" Ident "#" Ident "then" Equation;
terminator Equation ";";
RDecl . RewriteDecl ::= Ident ":" Rewrite;
terminator RewriteDecl ";";
RewriteBase . Rewrite ::= AST "~>" AST;
RewriteContext . Rewrite ::= "let" Hypothesis "in" Rewrite;
Hyp . Hypothesis ::= DottedPath "~>" DottedPath;
ASTVar . AST ::= DottedPath;
ASTSExp . AST ::= "(" Label [AST] ")";
ASTQuotedSExp . AST ::= "(" String [AST] ")";
ASTText . AST ::= String;
ASTInteger . AST ::= Integer;
ASTSubst . AST ::= "(" "Subst" AST AST DottedPath ")";
terminator AST "";
comment "--";
comment "{-" "-}";
