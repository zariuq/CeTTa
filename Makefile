# Standalone compiler and qualification objects live under runtime/bootstrap
# but are not all members of one link-object family.  Their generated
# dependency files are nevertheless authoritative: omitting them can retain
# an ABI-stale object after a shared header changes.  Restrict the wildcard to
# the active configuration tag so unrelated build variants remain isolated.
# The tag's own variants (runtime stats, typecheck censuses) are included:
# their objects link into the same tool paths, so a variant object left stale
# by a header change would be relinked into those tools.
AUXILIARY_DEPS = $(wildcard runtime/bootstrap/*.$(BUILD_OBJ_TAG).d \
	runtime/bootstrap/*.$(BUILD_OBJ_TAG).*.d)

# Remake configuration stamps before evaluating object dependencies.  The
# stamp recipes update their generated headers as a side effect; treating the
# stamps as included makefiles makes GNU Make restart with those headers in
# place, so one invocation cannot relink a stale configuration.
ifneq ($(GSLT_SOURCE_LEAN_ONLY_V1),1)
-include $(BUILD_CONFIG_STAMP) $(STAGE0_BUILD_CONFIG_STAMP) $(DEPS) \
	$(AUXILIARY_DEPS)
endif

FORCE:

OP_LANG_PREPARED_HEADER_V1 = runtime/generated/cetta_term_reader_v1.generated.h
OP_LANG_PREPARE_TOOL_V1 = runtime/bootstrap/emit-operational-reader-v1
$(OP_LANG_PREPARE_TOOL_V1): tools/emit_operational_reader_v1.c native/operational_language_def_v1.c \
		native/operational_language_def_v1.h native/prepared_artifact_v1.h \
		src/lib_parse_native_grammar.c src/lib_parse_native_grammar.h src/gslt_dense_bitset_v1.c \
		native/cetta_standalone_alloc_v1.c src/native_sha256.c
	@mkdir -p $(dir $@)
	$(CC) -Isrc -I. -std=c11 -O2 -Wall -Werror -ffunction-sections -fdata-sections -o $@ \
		tools/emit_operational_reader_v1.c src/lib_parse_native_grammar.c src/gslt_dense_bitset_v1.c \
		native/cetta_standalone_alloc_v1.c src/native_sha256.c -Wl,--gc-sections
$(OP_LANG_PREPARED_HEADER_V1): $(OP_LANG_PREPARE_TOOL_V1)
	@mkdir -p $(dir $@)
	$(OP_LANG_PREPARE_TOOL_V1) $@

$(BUILD_CONFIG_HEADER): $(BUILD_CONFIG_STAMP) | $(OP_LANG_PREPARED_HEADER_V1)

$(BUILD_CONFIG_STAMP): $(BUILD_CONFIG_INPUTS)
	@mkdir -p $(BOOTSTRAP_TMPDIR)
	@set -eu; \
	tmp_cfg=$$(mktemp "$(BOOTSTRAP_TMPDIR)/build_config.XXXXXX"); \
	printf '%s\n' '/* autogenerated by Makefile; do not edit */' > "$$tmp_cfg"; \
	printf '#define CETTA_VERSION_STRING "%s"\n' "$(CETTA_VERSION)" >> "$$tmp_cfg"; \
	printf '#define CETTA_BUILD_MODE_STRING "%s"\n' "$(BUILD_CANON)" >> "$$tmp_cfg"; \
