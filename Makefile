.PHONY: test-metamath-insert-row-state-step-rhocalc-profile-v1
test-metamath-insert-row-state-step-rhocalc-profile-v1: \
		$(METAMATH_INSERT_ROW_STATE_STEP_RHOMETTA_PROGRAM_V1) \
		$(METAMATH_INSERT_ROW_ACCEPTED_RHOMETTA_RUN_QUERY_V1) \
		$(METAMATH_INSERT_ROW_REFUSED_RHOMETTA_RUN_QUERY_V1) \
		$(BIN)
	@set -euo pipefail; \
	work=$$(mktemp -d runtime/metamath-insert-row-state-step-rhocalc-profile.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		$(foreach source,$(METAMATH_STATE_TRANSITION_RHOMETTA_SOURCES_V1),--source $(source)) \
		--entry-rule state-step-insert-row-v1 \
		--out "$$work/regenerated.metta" >/dev/null; \
	cmp -s "$$work/regenerated.metta" \
		$(METAMATH_INSERT_ROW_STATE_STEP_RHOMETTA_PROGRAM_V1); \
	awk '1' $(METAMATH_INSERT_ROW_STATE_STEP_RHOMETTA_PROGRAM_V1) \
		$(METAMATH_INSERT_ROW_ACCEPTED_RHOMETTA_RUN_QUERY_V1) \
		$(METAMATH_INSERT_ROW_REFUSED_RHOMETTA_RUN_QUERY_V1) \
		> "$$work/run.metta"; \
	result=$$(timeout 60 $(CETTA_BIN_INVOKE) \
		--rho-reduction-limit 400 \
		--lang rhocalc --profile rhometta --syntax metta \
		"$$work/run.metta" 2>&1); \
	test "$$(printf '%s\n' "$$result" | \
		rg -o -F '(gslt-rho:observed-v1' | wc -l)" -eq 2; \
	test "$$(printf '%s\n' "$$result" | rg -o '\bAcceptedV1\b' | wc -l)" -eq 1; \
	test "$$(printf '%s\n' "$$result" | rg -o '\bRefusedKeyPresentV1\b' | wc -l)" -eq 1; \
	printf '%s\n' "$$result" | rg -F -q \
		'(StateStepV1 MetamathPackageV1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(StateInsertRowV1 MetamathRowsTableV1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 state-step-insert-row-v1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 insert-row-v1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 table-insert-v1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 insert-row-by-table-result-refused-present-v1'; \
	printf '%s\n' '(MetamathInsertRowStateStepRhoCalcProfileV1Summary 81 34 2 400 0)'

