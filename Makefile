$(PRIME_TAIL_GC_TEST_BIN): tests/test_prime_tail_gc_ownership.c src/eval.c src/eval_gc.h $(BUILD_CONFIG_HEADER) $(FALLBACK_EVAL_TEST_LINK_OBJ) $(BRIDGE_DEPS)
