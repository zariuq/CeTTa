		echo "FAIL: lib/shell"; \
		diff <(cat tests/petta/shell_run.expected) <(printf '%s\n' "$$actual") | head -30; \
		exit 1; \
	fi; \
	echo "PASS: native shell preserves output, exit status and selectable deadlines"

