		--source $(MM0_TERM_ENVIRONMENT_V1) \
		--source $(MM0_SECONDARY_LEXER_V1) \
		--source $(MM0_NOTATION_ENVIRONMENT_V1) \
		--source $(GSLT_DYNAMIC_PRATT_V1) \
		--source $(MM0_MATH_PARSER_V1) \
