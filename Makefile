					"$$source" >"$$actual"; \
				diff -u "$$expected" "$$actual"; \
				rm -f "$$actual"; \
				trap - EXIT; \
			done; \
		done; \
	done; \
	echo "(MettaZeroInteractCliV1Summary engines=$$engine_count realizations=2 fixtures=15 occurrence-bag=1 branch-local=1 immutable-worlds=1 indexed-candidate=1 support-indexed-abt=2)"

