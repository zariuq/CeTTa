		echo "SKIP: $(1) (no MORK bridge manifest configured)"; \
	else \
		echo "SKIP: $(1) (Rust bridge deps unavailable; missing: $(MORK_BRIDGE_MISSING_MANIFESTS))"; \
	fi
endef

