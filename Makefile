	@if [[ "$(ENABLE_PYTHON)" != 0 || "$(LIB_PROLOG_ENABLED)" != 0 ]]; then \
		echo 'the runtime-input RhoMetta gate requires the C-only build'; \
		exit 1; \
	fi
	@if ldd $(BIN) $(METAMATH_DIRECT_COMPILED_CURSOR_V1) \
		$(LANGDEF_COMPILER_V1_BIN) | rg -qi 'python|libswipl|prolog'; \
