		1 10 100 200 300 400 500 700

$(METAMATH_INSERT_EACH_CORE_RHOMETTA_PROGRAM_V1): \
		$(METAMATH_STATE_TRANSITION_RHOMETTA_SOURCES_V1) \
		$(LANGDEF_COMPILER_V1_BIN)
	@mkdir -p $(dir $@)
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		$(foreach source,$(METAMATH_STATE_TRANSITION_RHOMETTA_SOURCES_V1),--source $(source)) \
		--entry-rule insert-each-nil-v1 \
		--entry-rule insert-each-cons-v1 \
		--out $@

.PHONY: test-metamath-insert-each-core-rhocalc-profile-v1
test-metamath-insert-each-core-rhocalc-profile-v1: \
		$(METAMATH_INSERT_EACH_CORE_RHOMETTA_PROGRAM_V1) \
		$(METAMATH_INSERT_EACH_CORE_RHOMETTA_RUN_QUERY_V1) \
		$(GSLT_RULE_MUTATOR_V1_BIN) \
		$(BIN)
	@set -euo pipefail; \
	work=$$(mktemp -d runtime/metamath-insert-each-core-rhocalc-profile.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		$(foreach source,$(METAMATH_STATE_TRANSITION_RHOMETTA_SOURCES_V1),--source $(source)) \
		--entry-rule insert-each-nil-v1 \
		--entry-rule insert-each-cons-v1 \
		--out "$$work/regenerated.metta" >/dev/null; \
	cmp -s "$$work/regenerated.metta" \
		$(METAMATH_INSERT_EACH_CORE_RHOMETTA_PROGRAM_V1); \
	awk '1' $(METAMATH_INSERT_EACH_CORE_RHOMETTA_PROGRAM_V1) \
		$(METAMATH_INSERT_EACH_CORE_RHOMETTA_RUN_QUERY_V1) \
		> "$$work/run.metta"; \
	result=$$(timeout 45 $(CETTA_BIN_INVOKE) \
		--rho-reduction-limit 650 \
		--lang rhocalc --profile rhometta --syntax metta \
		"$$work/run.metta" 2>&1); \
	test "$$(rg -c '^; fresh request instance for ' \
		$(METAMATH_INSERT_EACH_CORE_RHOMETTA_PROGRAM_V1))" -eq 76; \
	test "$$(rg -c '^[(]= [(]gslt-rho:process:' \
		$(METAMATH_INSERT_EACH_CORE_RHOMETTA_PROGRAM_V1))" -eq 30; \
	test "$$(printf '%s\n' "$$result" | \
		rg -o -F '(gslt-rho:observed-v1' | wc -l)" -eq 3; \
	for token in \
		QueryMetamathInsertEachCoreOneAcceptedRhoCliV1 \
		QueryMetamathInsertEachCoreOneRefusedRhoCliV1 \
		QueryMetamathInsertEachCoreRollbackRhoCliV1; do \
		printf '%s\n' "$$result" | rg -F -q "$$token"; \
	done; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 insert-each-nil-v1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 insert-each-cons-v1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 insert-each-after-step-refused-v1'; \
	$(GSLT_RULE_MUTATOR_V1_BIN) mutate \
		--source $(RELATIONAL_STATE_TRANSITION_CORE_V1) \
		--out "$$work/severed-core.metta" \
		--rule insert-each-after-step-refused-v1 --mode delete; \
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		--source $(GSLT_GROUND_RELATIONS_V1) \
		--source $(CETTA_PETTA_GROUND_RELATIONS_V1) \
		--source "$$work/severed-core.metta" \
		--source $(RELATIONAL_STATE_OCCURRENCE_INTERFACE_V1) \
		--source $(METAMATH_STATE_TRANSITION_EXECUTION_CANARY_V1) \
		--entry-rule insert-each-nil-v1 \
		--entry-rule insert-each-cons-v1 \
		--out "$$work/severed.metta" >/dev/null; \
	! cmp -s "$$work/severed.metta" \
		$(METAMATH_INSERT_EACH_CORE_RHOMETTA_PROGRAM_V1); \
	! rg -F -q 'insert-each-after-step-refused-v1' \
		"$$work/severed.metta"; \
	printf '%s\n' '(MetamathInsertEachCoreRhoCalcProfileV1Summary 76 30 3 1 650 0)'

