		--out $@

.PHONY: audit-cogslt-relational-state-transition-coverage-v1
audit-cogslt-relational-state-transition-coverage-v1: \
		$(RELATIONAL_STATE_TRANSITION_COVERAGE_ANSWERS_V1)
	@set -euo pipefail; \
	lowered=$$(sed -n \
		's/^[(]TransitionActionCoverageObservedV1 transition-action-coverage-lowered-v1 \([^)]*\)[)]$$/\1/p' \
		$(RELATIONAL_STATE_TRANSITION_COVERAGE_ANSWERS_V1) | sort -u); \
	stepped=$$(sed -n \
		's/^[(]TransitionActionCoverageObservedV1 transition-action-coverage-stepped-v1 \([^)]*\)[)]$$/\1/p' \
		$(RELATIONAL_STATE_TRANSITION_COVERAGE_ANSWERS_V1) | sort -u); \
	test -n "$$lowered"; \
	test -n "$$stepped"; \
	lowered_count=$$(printf '%s\n' "$$lowered" | wc -l); \
	stepped_count=$$(printf '%s\n' "$$stepped" | wc -l); \
	answer_count=$$(wc -l \
		<$(RELATIONAL_STATE_TRANSITION_COVERAGE_ANSWERS_V1)); \
	test "$$answer_count" -eq \
		"$$((lowered_count + stepped_count))"; \
	lowered_only=$$(comm -23 \
		<(printf '%s\n' "$$lowered") <(printf '%s\n' "$$stepped")); \
	stepped_only=$$(comm -13 \
		<(printf '%s\n' "$$lowered") <(printf '%s\n' "$$stepped")); \
	lowered_only_count=0; \
	stepped_only_count=0; \
	if [[ -n "$$lowered_only" ]]; then \
		lowered_only_count=$$(printf '%s\n' "$$lowered_only" | wc -l); \
		printf '%s\n' "$$lowered_only" | \
			sed 's/^/(TransitionActionLoweredOnlyV1 /; s/$$/)/'; \
	fi; \
	if [[ -n "$$stepped_only" ]]; then \
		stepped_only_count=$$(printf '%s\n' "$$stepped_only" | wc -l); \
		printf '%s\n' "$$stepped_only" | \
			sed 's/^/(TransitionActionSteppedOnlyV1 /; s/$$/)/'; \
	fi; \
	printf '%s\n' \
		"(RelationalStateTransitionCoverageV1Summary $$lowered_count $$stepped_count $$lowered_only_count $$stepped_only_count)"

.PHONY: test-cogslt-relational-state-transition-coverage-v1
test-cogslt-relational-state-transition-coverage-v1: \
		$(RELATIONAL_STATE_TRANSITION_COVERAGE_ANSWERS_V1)
	@set -euo pipefail; \
	lowered=$$(sed -n \
		's/^[(]TransitionActionCoverageObservedV1 transition-action-coverage-lowered-v1 \([^)]*\)[)]$$/\1/p' \
		$(RELATIONAL_STATE_TRANSITION_COVERAGE_ANSWERS_V1) | sort -u); \
	stepped=$$(sed -n \
		's/^[(]TransitionActionCoverageObservedV1 transition-action-coverage-stepped-v1 \([^)]*\)[)]$$/\1/p' \
		$(RELATIONAL_STATE_TRANSITION_COVERAGE_ANSWERS_V1) | sort -u); \
	test -n "$$lowered"; \
	test -n "$$stepped"; \
	lowered_count=$$(printf '%s\n' "$$lowered" | wc -l); \
	stepped_count=$$(printf '%s\n' "$$stepped" | wc -l); \
	answer_count=$$(wc -l \
		<$(RELATIONAL_STATE_TRANSITION_COVERAGE_ANSWERS_V1)); \
	test "$$answer_count" -eq \
		"$$((lowered_count + stepped_count))"; \
	if [[ "$$lowered" != "$$stepped" ]]; then \
		comm -23 <(printf '%s\n' "$$lowered") \
			<(printf '%s\n' "$$stepped") | \
			sed 's/^/lowered without StateStepV1: /' >&2; \
		comm -13 <(printf '%s\n' "$$lowered") \
			<(printf '%s\n' "$$stepped") | \
			sed 's/^/StateStepV1 without lowering: /' >&2; \
		exit 1; \
	fi; \
	printf '%s\n' \
		"(RelationalStateTransitionCoverageV1Summary $$lowered_count $$stepped_count 0 0)"

.PHONY: test-cogslt-relational-state-action-layer-coverage-v1
test-cogslt-relational-state-action-layer-coverage-v1: \
		$(RELATIONAL_STATE_TRANSITION_COVERAGE_ANSWERS_V1)
	@set -euo pipefail; \
	lowered=$$(sed -n \
		's/^[(]TransitionActionCoverageObservedV1 transition-action-coverage-lowered-v1 \([^)]*\)[)]$$/\1/p' \
		$(RELATIONAL_STATE_TRANSITION_COVERAGE_ANSWERS_V1) | sort -u); \
	stepped=$$(sed -n \
		's/^[(]TransitionActionCoverageObservedV1 transition-action-coverage-stepped-v1 \([^)]*\)[)]$$/\1/p' \
		$(RELATIONAL_STATE_TRANSITION_COVERAGE_ANSWERS_V1) | sort -u); \
	test "$$(printf '%s\n' "$$lowered" | wc -l)" -eq 17; \
	test "$$(printf '%s\n' "$$stepped" | wc -l)" -eq 17; \
	test "$$lowered" = "$$stepped"; \
	printf '%s\n' \
		'(RelationalStateActionLayerCoverageV1Summary 17 17 0 0)'

.PHONY: test-cogslt-relational-state-transition-coverage-audit-v1
test-cogslt-relational-state-transition-coverage-audit-v1: \
		$(RELATIONAL_STATE_TRANSITION_COVERAGE_ANSWERS_V1) \
		$(RELATIONAL_STATE_TRANSITION_MUTATOR_CORE_V1)
	@set -euo pipefail; \
	record='(TransitionActionCoverageObservedV1 transition-action-coverage-stepped-v1 StateCopyEachRowMatchingV1)'; \
	rg -F -x -q "$$record" \
		$(RELATIONAL_STATE_TRANSITION_COVERAGE_ANSWERS_V1); \
	work=$$(mktemp -d runtime/relational-state-transition-coverage.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	$(RELATIONAL_STATE_TRANSITION_MUTATOR_CORE_V1) mutate \
		--source $(RELATIONAL_STATE_TRANSITION_CORE_V1) \
		--out "$$work/deleted-step.metta" \
		--rule state-step-copy-each-row-matching-v1 --mode delete; \
	$(RELATIONAL_STATE_TRANSITION_LANGDEF_CORE_V1) answers \
		--chart $(RELATIONAL_STATE_TRANSITION_CHART_CORE_V1) \
		--source $(RELATIONAL_STATE_TRANSITION_COVERAGE_V1) \
		$(foreach source,$(filter-out $(RELATIONAL_STATE_TRANSITION_CORE_V1) $(RELATIONAL_STATE_PROOF_BRIDGE_V1),$(METAMATH_STATE_PROOF_BRIDGE_DIRECT_SOURCES_V1)),--source $(source)) \
		--reflect-source $(RELATIONAL_STATE_TRANSITION_COMPILER_V1) \
		--reflect-source "$$work/deleted-step.metta" \
		--reflect-source $(RELATIONAL_STATE_PROOF_BRIDGE_V1) \
		--query '(TransitionActionCoverageObservedV1 ?kind ?constructor)' \
		--out "$$work/deleted-step.answers" >/dev/null; \
	if rg -F -x -q "$$record" "$$work/deleted-step.answers"; then \
		exit 1; \
	fi; \
	baseline_count=$$(wc -l \
		<$(RELATIONAL_STATE_TRANSITION_COVERAGE_ANSWERS_V1)); \
	deleted_count=$$(wc -l <"$$work/deleted-step.answers"); \
	test "$$deleted_count" -eq "$$((baseline_count - 1))"; \
	printf '%s\n' \
		'(RelationalStateTransitionCoverageAuditV1Summary 1 1 0)'

