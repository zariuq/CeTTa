.PHONY: test-metamath-require-each-rhometta-compile-v1
test-metamath-require-each-rhometta-compile-v1: \
		$(METAMATH_REQUIRE_EACH_RHOMETTA_PROGRAM_V1) \
		$(METAMATH_REQUIRE_EACH_RHOMETTA_RUN_V1) \
		$(GSLT_RULE_MUTATOR_V1_BIN)
	@set -euo pipefail; \
	work=$$(mktemp -d runtime/metamath-require-each-rhometta.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		$(foreach source,$(METAMATH_STATE_TRANSITION_RHOMETTA_SOURCES_V1),--source $(source)) \
		--entry-rule state-step-require-each-v1 \
		--epilogue $(METAMATH_REQUIRE_EACH_RHOMETTA_QUERY_V1) \
		--out "$$work/run.metta" >/dev/null; \
	cmp -s "$$work/run.metta" $(METAMATH_REQUIRE_EACH_RHOMETTA_RUN_V1); \
	if rg -qi 'HornClause|horn:prove|horn_prove|worklist' \
		$(METAMATH_REQUIRE_EACH_RHOMETTA_PROGRAM_V1); then \
		echo 'direct Rhometta require-each artifact contains an interpreter representation' >&2; \
		exit 1; \
	fi; \
	$(GSLT_RULE_MUTATOR_V1_BIN) mutate \
		--source $(RELATIONAL_STATE_TRANSITION_CORE_V1) \
		--out "$$work/severed-core.metta" \
		--rule require-each-by-membership-missing-v1 --mode delete; \
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		--source $(GSLT_GROUND_RELATIONS_V1) \
		--source $(CETTA_PETTA_GROUND_RELATIONS_V1) \
		--source "$$work/severed-core.metta" \
		--source $(RELATIONAL_STATE_OCCURRENCE_INTERFACE_V1) \
		--source $(METAMATH_STATE_TRANSITION_EXECUTION_CANARY_V1) \
		--entry-rule state-step-require-each-v1 \
		--out "$$work/severed.metta" >/dev/null; \
	! cmp -s "$$work/severed.metta" \
		$(METAMATH_REQUIRE_EACH_RHOMETTA_PROGRAM_V1); \
	! rg -F -q 'require-each-by-membership-missing-v1' \
		"$$work/severed.metta"; \
	printf '%s\n' '(MetamathRequireEachRhoMettaCompileV1Summary 57 24 1 1 0)'

