	if rg -qi 'HornClause|horn:prove|horn_prove|worklist' \
		$(METAMATH_PROOF_TRACE_COMPILE_COMPRESSED_RHOMETTA_PROGRAM_V1); then \
		echo 'direct RhoMetta compressed proof compiler contains an interpreter representation' >&2; \
		exit 1; \
	fi; \
	printf '%s\n' '(MetamathProofTraceCompressedRhoMettaCompileV1Summary 104 34 1 1 0)'

