		$(GSLT_DIRECT_PETTA_PROGRAM_V1); \
	! rg -F -q 'source-rule=direct-ancestor-step-v1' \
		"$$work/severed-program.metta"; \
	awk -v expected=4 ' \
		/^; gslt-source-rewrite-v1 / { \
			split($$3, field, "="); \
			if (!(field[2] in inventory)) inventory_count++; \
			inventory[field[2]] = 1; \
		} \
		/^; gslt-lowered-equation-v1 / { \
			split($$3, field, "="); \
			if (!(field[2] in inventory)) exit 1; \
			realized[field[2]] = 1; \
		} \
		/^\(= / { \
			if (previous !~ /^; gslt-lowered-equation-v1 /) exit 1; \
			equation_count++; \
		} \
		{ previous = $$0 } \
		END { \
			if (inventory_count != expected || equation_count == 0) exit 1; \
			for (key in inventory) \
				if (!(key in realized)) exit 1; \
		}' "$$work/severed-program.metta"; \
	awk '1; END { print "!(collapse (gslt:DirectAncestorV1 (DirectAncestorV1 DirectAliceV1 \044descendant)))" }' \
		"$$work/severed-program.metta" > "$$work/severed-run.metta"; \
	severed=$$(timeout 30 $(CETTA_PETTA_DIRECT_RUN_V1) \
		"$$work/severed-run.metta" 2>&1); \
	printf '%s\n' "$$severed" | rg -F -q \
		'((DirectAncestorV1 DirectAliceV1 DirectBobV1))'; \
	if printf '%s\n' "$$severed" | rg -q 'Direct(Cara|Dara)V1'; then \
		exit 1; \
	fi; \
	printf '%s\n' '(GSLTDirectPeTTaV1Summary 5 3 1 1 0)'

$(GSLT_DIRECT_RHOMETTA_PROGRAM_V1): \
		$(GSLT_DIRECT_PETTA_PARENT_V1) \
		$(GSLT_DIRECT_PETTA_ANCESTOR_V1) \
		$(GSLT_DIRECT_PETTA_COMPOSITION_V1) \
		$(LANGDEF_COMPILER_V1_BIN)
	@mkdir -p $(dir $@)
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		--composition $(GSLT_DIRECT_PETTA_COMPOSITION_V1) \
		--out $@

.PHONY: test-gslt-direct-source-identity-v1
test-gslt-direct-source-identity-v1: \
		$(GSLT_DIRECT_PETTA_PROGRAM_V1) \
		$(GSLT_DIRECT_RHOMETTA_PROGRAM_V1) \
		$(LANGDEF_COMPILER_V1_BIN)
	@set -euo pipefail; \
	work=$$(mktemp -d runtime/gslt-direct-source-identity.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	petta_digest=$$(awk \
		'$$1 == ";" && $$2 == "source-composition-sha256" { print $$3; exit }' \
		$(GSLT_DIRECT_PETTA_PROGRAM_V1)); \
	rho_digest=$$(awk \
		'$$1 == ";" && $$2 == "source-composition-sha256" { print $$3; exit }' \
		$(GSLT_DIRECT_RHOMETTA_PROGRAM_V1)); \
	printf '%s\n' "$$petta_digest" | rg -q '^[0-9a-f]{64}$$'; \
	test "$$petta_digest" = "$$rho_digest"; \
	$(LANGDEF_COMPILER_V1_BIN) petta-direct \
		--source $(GSLT_DIRECT_PETTA_ANCESTOR_V1) \
		--source $(GSLT_DIRECT_PETTA_PARENT_V1) \
		--out "$$work/reversed-petta.metta" >/dev/null; \
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		--source $(GSLT_DIRECT_PETTA_ANCESTOR_V1) \
		--source $(GSLT_DIRECT_PETTA_PARENT_V1) \
		--out "$$work/reversed-rho.metta" >/dev/null; \
	reversed_petta_digest=$$(awk \
		'$$1 == ";" && $$2 == "source-composition-sha256" { print $$3; exit }' \
		"$$work/reversed-petta.metta"); \
	reversed_rho_digest=$$(awk \
		'$$1 == ";" && $$2 == "source-composition-sha256" { print $$3; exit }' \
		"$$work/reversed-rho.metta"); \
	test "$$reversed_petta_digest" = "$$reversed_rho_digest"; \
	test "$$petta_digest" != "$$reversed_petta_digest"; \
	printf '%s\n' '(GSLTDirectSourceIdentityV1Summary 2 2 1 0)'

