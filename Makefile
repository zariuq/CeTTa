		$(foreach source,$(METAMATH_STATE_PROOF_BRIDGE_DIRECT_SOURCES_V1),--source $(source)) \
		--entry-rule state-start-occurrence-stream-v1 \
		--out "$$work/regenerated.metta"); \
	printf '%s\n' "$$summary" | rg -q \
		'^[(]GSLTDirectRhoMettaV1Summary 578 236 [0-9a-f]{64} [0-9a-f]{64}[)]$$'; \
	cmp -s "$$work/regenerated.metta" \
		$(METAMATH_STATE_PROOF_RUNTIME_RHOMETTA_PROGRAM_V1); \
	rg -F -q '; selected-entry-rule state-start-occurrence-stream-v1' \
		$(METAMATH_STATE_PROOF_RUNTIME_RHOMETTA_PROGRAM_V1); \
	! rg -q 'ParserOccurrenceV[0-9]|Metamath(Normal|Compressed).*Occurrence' \
		$(METAMATH_STATE_PROOF_RUNTIME_RHOMETTA_PROGRAM_V1); \
	if rg -qi 'HornClause|horn:prove|horn_prove|worklist' \
		$(METAMATH_STATE_PROOF_RUNTIME_RHOMETTA_PROGRAM_V1); then \
		echo 'runtime-input RhoMetta artifact contains an interpreter representation' >&2; \
		exit 1; \
	fi; \
	awk '1' $(METAMATH_STATE_PROOF_RUNTIME_RHOMETTA_PROGRAM_V1) \
		$(METAMATH_STATE_PROOF_RUNTIME_RHOMETTA_QUERY_V1) \
		> "$$work/run.metta"; \
	program_digest_before=$$(sha256sum \
		$(METAMATH_STATE_PROOF_RUNTIME_RHOMETTA_PROGRAM_V1) | cut -d' ' -f1); \
	output=$$(timeout 30 $(BIN) \
		--rho-reduction-limit 10 \
		--lang rhocalc --profile rhometta --syntax metta \
		"$$work/run.metta" \
		tests/langdef/metamath/invalid_missing_terminator.mm \
		$(METAMATH_DIRECT_RUNTIME_MANIFEST_V1)); \
	printf '%s\n' "$$output" | rg -F -q \
		'((MetamathDirectRhoOutcomeV1 ParserRefusedV1))'; \
	test "$$(printf '%s\n' "$$output" | \
		rg -F -c 'MetamathDirectRhoOutcomeV1')" -eq 1; \
	program_digest_after=$$(sha256sum \
		$(METAMATH_STATE_PROOF_RUNTIME_RHOMETTA_PROGRAM_V1) | cut -d' ' -f1); \
	test "$$program_digest_before" = "$$program_digest_after"; \
	printf '%s\n' \
		'(MetamathStateProofRuntimeRhoMettaV1Summary 578 236 1 1 0)'

