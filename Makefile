.PHONY: test-metamath-row-actions-direct-petta-v1
test-metamath-row-actions-direct-petta-v1: \
		$(METAMATH_ROW_ACTIONS_DIRECT_PETTA_PROGRAM_V1) \
		$(METAMATH_ROW_ACTIONS_DIRECT_PETTA_QUERY_V1) \
		$(GSLT_RULE_MUTATOR_V1_BIN) \
		$(BIN)
	@set -euo pipefail; \
	work=$$(mktemp -d runtime/metamath-row-actions-direct-petta.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	$(LANGDEF_COMPILER_V1_BIN) petta-direct \
		--source $(GSLT_GROUND_RELATIONS_V1) \
		--source $(CETTA_PETTA_GROUND_RELATIONS_V1) \
		--source $(RELATIONAL_STATE_TRANSITION_CORE_V1) \
		--source $(RELATIONAL_STATE_OCCURRENCE_INTERFACE_V1) \
		--source $(METAMATH_STATE_TRANSITION_EXECUTION_CANARY_V1) \
		--source $(METAMATH_STATE_TRANSITION_EXEC_IR_FACTS_DIRECT_V1) \
		--closed-entry-mode StateStepV1:1111000 \
		--out "$$work/regenerated.metta" >/dev/null; \
	cmp -s "$$work/regenerated.metta" \
		$(METAMATH_ROW_ACTIONS_DIRECT_PETTA_PROGRAM_V1); \
	! rg -F -q '(= (gslt:StateStepV1 ' \
		$(METAMATH_ROW_ACTIONS_DIRECT_PETTA_PROGRAM_V1); \
	awk '1' $(METAMATH_ROW_ACTIONS_DIRECT_PETTA_PROGRAM_V1) \
		$(METAMATH_ROW_ACTIONS_DIRECT_PETTA_QUERY_V1) \
		> "$$work/run.metta"; \
	output=$$(timeout 30 $(CETTA_PETTA_DIRECT_RUN_V1) \
		"$$work/run.metta" 2>&1); \
	for observation in \
		MetamathRequireRowAcceptedPeTTaV1 \
		MetamathRequireRowMissingPeTTaV1 \
		MetamathRequireRowKeyAbsentAcceptedPeTTaV1 \
		MetamathRequireRowKeyAbsentRefusedPeTTaV1 \
		MetamathInsertRowAcceptedPeTTaV1 \
		MetamathInsertRowRefusedPeTTaV1; do \
		printf '%s\n' "$$output" | rg -F -q "$$observation"; \
	done; \
	test "$$(printf '%s\n' "$$output" | rg -c '^[(][(]')" -eq 6; \
	$(GSLT_RULE_MUTATOR_V1_BIN) mutate \
		--source $(RELATIONAL_STATE_TRANSITION_CORE_V1) \
		--out "$$work/severed-core.metta" \
		--rule insert-row-by-table-result-refused-present-v1 \
		--mode delete; \
	$(LANGDEF_COMPILER_V1_BIN) petta-direct \
		--source $(GSLT_GROUND_RELATIONS_V1) \
		--source $(CETTA_PETTA_GROUND_RELATIONS_V1) \
		--source "$$work/severed-core.metta" \
		--source $(RELATIONAL_STATE_OCCURRENCE_INTERFACE_V1) \
		--source $(METAMATH_STATE_TRANSITION_EXECUTION_CANARY_V1) \
		--source $(METAMATH_STATE_TRANSITION_EXEC_IR_FACTS_DIRECT_V1) \
		--closed-entry-mode StateStepV1:1111000 \
		--out "$$work/severed.metta" >/dev/null; \
	! cmp -s "$$work/severed.metta" \
		$(METAMATH_ROW_ACTIONS_DIRECT_PETTA_PROGRAM_V1); \
	! rg -F -q 'insert-row-by-table-result-refused-present-v1' \
		"$$work/severed.metta"; \
	awk '1' "$$work/severed.metta" \
		$(METAMATH_ROW_ACTIONS_DIRECT_PETTA_QUERY_V1) \
		> "$$work/severed-run.metta"; \
	severed=$$(timeout 30 $(CETTA_PETTA_DIRECT_RUN_V1) \
		"$$work/severed-run.metta" 2>&1); \
	printf '%s\n' "$$severed" | rg -F -q \
		'MetamathInsertRowAcceptedPeTTaV1'; \
	! printf '%s\n' "$$severed" | rg -F -q \
		'MetamathInsertRowRefusedPeTTaV1'; \
	printf '%s\n' '(MetamathRowActionsDirectPeTTaV1Summary 252 6 1 1 0)'

