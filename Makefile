		$(BIN)
	@if [[ "$(ENABLE_PYTHON)" != 0 || "$(LIB_PROLOG_ENABLED)" != 0 ]]; then \
		echo 'the direct source-severance gate requires the C-only build'; \
		exit 1; \
	fi
	@if ldd $(BIN) $(METAMATH_DIRECT_COMPILED_CURSOR_V1) \
		$(PARSER_PACK_CURSOR_COMPILE_V1_STREAM_BIN) \
		$(GSLT_RULE_MUTATOR_V1_BIN) $(LANGDEF_COMPILER_V1_BIN) | \
		rg -qi 'python|libswipl|prolog'; then exit 1; fi
	@bash -n $(METAMATH_DIRECT_SOURCE_SEVERANCE_V1)
	@shellcheck $(METAMATH_DIRECT_SOURCE_SEVERANCE_V1)
	@CETTA_DIRECT_PETTA_ROOT="$(CURDIR)" \
		CETTA_DIRECT_PETTA_BIN="$(abspath $(BIN))" \
		CETTA_DIRECT_PETTA_COMPILER="$(abspath $(LANGDEF_COMPILER_V1_BIN))" \
		CETTA_DIRECT_PETTA_CURSOR_COMPILER="$(abspath $(PARSER_PACK_CURSOR_COMPILE_V1_STREAM_BIN))" \
		CETTA_DIRECT_PETTA_CURSOR_PREFIX="$(METAMATH_DIRECT_CURSOR_FOLD_PREFIX_V1)" \
		CETTA_DIRECT_PETTA_RULE_MUTATOR="$(abspath $(GSLT_RULE_MUTATOR_V1_BIN))" \
		CETTA_DIRECT_PETTA_PROGRAM="$(abspath $(METAMATH_STATE_PROOF_BRIDGE_DIRECT_PROGRAM_V1))" \
		CETTA_DIRECT_PETTA_QUERY="$(abspath $(METAMATH_STATE_PROOF_OCCURRENCE_OUTCOME_QUERY_V1))" \
		CETTA_DIRECT_PETTA_MANIFEST="$(abspath $(METAMATH_DIRECT_RUNTIME_MANIFEST_V1))" \
		CETTA_DIRECT_PETTA_REGULAR_DIGEST="$(METAMATH_REGULAR_COMPILER_DIGEST_V1)" \
		CETTA_DIRECT_PETTA_GUARDED_DIGEST="$(METAMATH_GUARDED_COMPILER_DIGEST_V1)" \
		CETTA_DIRECT_PETTA_ACTION_DIGEST="$(METAMATH_ACTION_COMPILER_DIGEST_V1)" \
		CETTA_DIRECT_PETTA_SPAN_MASK_DIGEST="$(METAMATH_OCCURRENCE_SPAN_MASK_COMPILER_DIGEST_V1)" \
		CETTA_DIRECT_PETTA_SOURCE_CONTROL_DIGEST="$(SOURCE_RESOLUTION_CONTROL_COMPILER_DIGEST_V1)" \
		$(METAMATH_DIRECT_SOURCE_SEVERANCE_V1)

.PHONY: probe-metamath-cogslt-petta-direct-corpus-v1 \
		probe-metamath-cogslt-petta-direct-corpus-core-v1
probe-metamath-cogslt-petta-direct-corpus-v1:
	@$(MAKE) --no-print-directory BUILD=core ENABLE_LIB_PROLOG=0 \
		BIN=$(METAMATH_COGSLT_CORE_BIN_V1) \
		METAMATH_TEST_ROOT_V1="$(METAMATH_TEST_ROOT_V1)" \
		METAMATH_DIRECT_PETTA_CORPUS_RESULTS_V1="$(METAMATH_DIRECT_PETTA_CORPUS_RESULTS_V1)" \
		METAMATH_DIRECT_PETTA_CORPUS_LIMIT_V1="$(METAMATH_DIRECT_PETTA_CORPUS_LIMIT_V1)" \
		METAMATH_DIRECT_PETTA_CORPUS_FILTER_V1="$(METAMATH_DIRECT_PETTA_CORPUS_FILTER_V1)" \
		METAMATH_DIRECT_PETTA_CORPUS_STAGE_TIMEOUT_V1="$(METAMATH_DIRECT_PETTA_CORPUS_STAGE_TIMEOUT_V1)" \
		probe-metamath-cogslt-petta-direct-corpus-core-v1

probe-metamath-cogslt-petta-direct-corpus-core-v1: \
		test-metamath-cogslt-petta-direct-outcome-driver-core-v1 \
		$(LANGDEF_DIRECT_PETTA_CORPUS_DRIVER_V1)
	@if [[ -z "$(strip $(METAMATH_TEST_ROOT_V1))" ]]; then \
		echo 'set METAMATH_TEST_ROOT_V1 to the conformance corpus checkout'; \
		exit 1; \
	fi
	@if [[ "$$(git -C "$(METAMATH_TEST_ROOT_V1)" rev-parse HEAD)" != \
		"$(METAMATH_TEST_COMMIT_V1)" ]]; then \
		echo 'Metamath conformance corpus revision does not match the pinned suite'; \
		exit 1; \
	fi
	@if ! git -C "$(METAMATH_TEST_ROOT_V1)" diff --quiet || \
		! git -C "$(METAMATH_TEST_ROOT_V1)" diff --cached --quiet; then \
		echo 'Metamath conformance corpus tracked source is dirty'; \
		exit 1; \
	fi
	@bash -n $(LANGDEF_DIRECT_PETTA_CORPUS_DRIVER_V1)
	@shellcheck $(LANGDEF_DIRECT_PETTA_CORPUS_DRIVER_V1)
	@CETTA_DIRECT_PETTA_ROOT="$(CURDIR)" \
		CETTA_DIRECT_PETTA_BIN="$(abspath $(BIN))" \
		CETTA_DIRECT_PETTA_PROGRAM="$(abspath $(METAMATH_STATE_PROOF_BRIDGE_DIRECT_PROGRAM_V1))" \
		CETTA_DIRECT_PETTA_QUERY="$(abspath $(METAMATH_STATE_PROOF_OCCURRENCE_OUTCOME_QUERY_V1))" \
		CETTA_DIRECT_PETTA_MANIFEST="$(abspath $(METAMATH_DIRECT_RUNTIME_MANIFEST_V1))" \
		CETTA_DIRECT_PETTA_TIMEOUT="$(METAMATH_DIRECT_PETTA_CORPUS_STAGE_TIMEOUT_V1)" \
		CETTA_DIRECT_PETTA_DRIVER="$(abspath $(LANGDEF_DIRECT_PETTA_OUTCOME_DRIVER_V1))" \
		CETTA_DIRECT_PETTA_TEST_ROOT="$(abspath $(METAMATH_TEST_ROOT_V1))" \
		CETTA_DIRECT_PETTA_RESULTS="$(abspath $(METAMATH_DIRECT_PETTA_CORPUS_RESULTS_V1))" \
		CETTA_DIRECT_PETTA_CORPUS_LIMIT="$(METAMATH_DIRECT_PETTA_CORPUS_LIMIT_V1)" \
		CETTA_DIRECT_PETTA_CORPUS_FILTER="$(METAMATH_DIRECT_PETTA_CORPUS_FILTER_V1)" \
		$(LANGDEF_DIRECT_PETTA_CORPUS_DRIVER_V1)

$(METAMATH_PROOF_COMPILER_DIRECT_PROGRAM_V1): \
		$(METAMATH_PROOF_COMPILER_DIRECT_SOURCES_V1) \
		$(LANGDEF_COMPILER_V1_BIN)
	$(LANGDEF_COMPILER_V1_BIN) petta-direct \
		$(foreach source,$(METAMATH_PROOF_COMPILER_DIRECT_SOURCES_V1),--source $(source)) \
		--out $@

$(METAMATH_PROOF_PLAN_DIRECT_V1): \
		$(METAMATH_PROOF_COMPILER_DIRECT_PROGRAM_V1) \
		$(METAMATH_PROOF_COMPILER_DIRECT_QUERY_V1) \
		$(BIN)
	@set -euo pipefail; \
	work=$$(mktemp -d runtime/metamath-proof-plan-direct.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	awk '1' $(METAMATH_PROOF_COMPILER_DIRECT_PROGRAM_V1) \
		$(METAMATH_PROOF_COMPILER_DIRECT_QUERY_V1) > "$$work/run.metta"; \
	timeout 120 $(CETTA_PETTA_DIRECT_RUN_V1) "$$work/run.metta" \
		> "$$work/raw.answers" 2> "$$work/petta.stderr"; \
	LC_ALL=C sort -u "$$work/raw.answers" > $@; \
	test "$$(wc -l < $@)" -eq 58; \
	if rg -v -q '^\(proof-artifact-v1 ' $@; then \
		echo 'direct proof compiler emitted a non-artifact answer' >&2; \
		exit 1; \
	fi

$(METAMATH_PROOF_SEMANTIC_PAYLOAD_DIRECT_V1): \
		$(METAMATH_PROOF_PLAN_DIRECT_V1) \
		$(LANGDEF_COMPILER_V1_BIN)
	$(LANGDEF_COMPILER_V1_BIN) answer-facts \
		--source $< --out $@

$(METAMATH_PROOF_DENOTATION_DIRECT_PROGRAM_V1): \
		$(METAMATH_PROOF_SEMANTIC_PAYLOAD_DIRECT_V1) \
		$(CERTIFICATE_GSLT_FIRST_ORDER_DENOTATION_V1) \
		$(LANGDEF_COMPILER_V1_BIN)
	$(LANGDEF_COMPILER_V1_BIN) petta-direct \
		--source $(METAMATH_PROOF_SEMANTIC_PAYLOAD_DIRECT_V1) \
		--source $(CERTIFICATE_GSLT_FIRST_ORDER_DENOTATION_V1) \
		--out $@

$(METAMATH_PROOF_REFLECTION_DIRECT_V1): \
		$(METAMATH_PROOF_DENOTATION_DIRECT_PROGRAM_V1) \
		$(METAMATH_PROOF_DENOTATION_DIRECT_QUERY_V1) \
		$(BIN)
	@set -euo pipefail; \
	work=$$(mktemp -d runtime/metamath-proof-reflection-direct.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	awk '1' $(METAMATH_PROOF_DENOTATION_DIRECT_PROGRAM_V1) \
		$(METAMATH_PROOF_DENOTATION_DIRECT_QUERY_V1) > "$$work/run.metta"; \
	timeout 120 $(CETTA_PETTA_DIRECT_RUN_V1) "$$work/run.metta" \
		> "$$work/raw.answers" 2> "$$work/petta.stderr"; \
	LC_ALL=C sort -u "$$work/raw.answers" > $@; \
	test "$$(wc -l < $@)" -eq 57; \
	if rg -v -q '^\(source-(operator|rule) ' $@; then \
		echo 'direct proof denotation emitted an invalid reflection answer' >&2; \
		exit 1; \
	fi

$(METAMATH_PROOF_SEMANTIC_EXEC_DIRECT_V1): \
		$(METAMATH_PROOF_REFLECTION_DIRECT_V1) \
		$(LANGDEF_COMPILER_V1_BIN)
	$(LANGDEF_COMPILER_V1_BIN) semantic-gslt \
		--source $< --out $@

.PHONY: test-metamath-cogslt-petta-proof-bootstrap-direct-v1
test-metamath-cogslt-petta-proof-bootstrap-direct-v1: \
		$(METAMATH_PROOF_COMPILER_DIRECT_PROGRAM_V1) \
		$(METAMATH_PROOF_PLAN_DIRECT_V1) \
		$(METAMATH_PROOF_SEMANTIC_PAYLOAD_DIRECT_V1) \
		$(METAMATH_PROOF_DENOTATION_DIRECT_PROGRAM_V1) \
		$(METAMATH_PROOF_REFLECTION_DIRECT_V1) \
		$(METAMATH_PROOF_SEMANTIC_EXEC_DIRECT_V1)
	@set -euo pipefail; \
	if rg -qi 'HornClause|horn:prove|horn_prove|worklist' \
		$(METAMATH_PROOF_COMPILER_DIRECT_PROGRAM_V1) \
		$(METAMATH_PROOF_DENOTATION_DIRECT_PROGRAM_V1); then \
		echo 'direct proof bootstrap contains an interpreter representation' >&2; \
		exit 1; \
	fi; \
	for rule in \
		proof-environment-lookup-cons-v1 \
		proof-environment-lookup-compared-equal-v1 \
		proof-environment-lookup-compared-unequal-v1 \
		proof-sequence-instantiate-cons-v1 \
		proof-sequence-instantiate-class-literal-v1 \
		proof-sequence-instantiate-class-variable-v1; do \
		rg -F -q "$$rule" $(METAMATH_PROOF_PLAN_DIRECT_V1); \
		rg -F -q "$$rule" $(METAMATH_PROOF_SEMANTIC_EXEC_DIRECT_V1); \
	done; \
	if rg -q \
		'proof-environment-lookup-(head|tail)-v1|proof-sequence-instantiate-(literal|variable)-v1' \
		$(METAMATH_PROOF_PLAN_DIRECT_V1) \
		$(METAMATH_PROOF_SEMANTIC_EXEC_DIRECT_V1); then \
		echo 'direct proof bootstrap selected relational sequence rules' >&2; \
		exit 1; \
	fi; \
	printf '%s\n' '(MetamathProofBootstrapDirectV1Summary 241 58 75 33 24 0)'

$(METAMATH_PROOF_TRACE_DIRECT_PROGRAM_V1): \
		$(METAMATH_PROOF_TRACE_DIRECT_SOURCES_V1) \
		$(LANGDEF_COMPILER_V1_BIN)
	$(LANGDEF_COMPILER_V1_BIN) petta-direct \
		$(foreach source,$(METAMATH_PROOF_TRACE_DIRECT_SOURCES_V1),--source $(source)) \
		--out $@

.PHONY: test-metamath-cogslt-petta-proof-trace-direct-v1
test-metamath-cogslt-petta-proof-trace-direct-v1: \
		test-metamath-cogslt-petta-proof-bootstrap-direct-v1 \
		$(METAMATH_PROOF_TRACE_DIRECT_PROGRAM_V1) \
		$(METAMATH_PROOF_TRACE_DIRECT_QUERY_V1) \
		$(METAMATH_PROOF_TRACE_ESSENTIAL_RESULT_QUERY_V1) \
		$(GSLT_RULE_MUTATOR_V1_BIN) \
		$(BIN)
	@set -euo pipefail; \
	work=$$(mktemp -d runtime/metamath-proof-trace-direct.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	$(LANGDEF_COMPILER_V1_BIN) petta-direct \
		$(foreach source,$(METAMATH_PROOF_TRACE_DIRECT_SOURCES_V1),--source $(source)) \
		--out "$$work/regenerated.metta" >/dev/null; \
	cmp -s "$$work/regenerated.metta" \
		$(METAMATH_PROOF_TRACE_DIRECT_PROGRAM_V1); \
	if rg -qi 'HornClause|horn:prove|horn_prove|worklist' \
		$(METAMATH_PROOF_TRACE_DIRECT_PROGRAM_V1); then \
		echo 'direct proof-trace artifact contains an interpreter representation' >&2; \
		exit 1; \
	fi; \
	awk '1' $(METAMATH_PROOF_TRACE_DIRECT_PROGRAM_V1) \
		$(METAMATH_PROOF_TRACE_DIRECT_QUERY_V1) > "$$work/run.metta"; \
	output=$$(timeout 60 $(CETTA_PETTA_DIRECT_RUN_V1) \
		"$$work/run.metta" 2>&1); \
	printf '%s\n' "$$output" | rg -F -q \
		'((MetamathProofTraceDirectNormalV1 AcceptedV1))'; \
	printf '%s\n' "$$output" | rg -F -q \
		'((MetamathProofTraceDirectCompressedV1 AcceptedV1))'; \
	printf '%s\n' "$$output" | rg -F -q \
		'((MetamathProofTraceDirectNormalEvidenceV1 AcceptedV1))'; \
	printf '%s\n' "$$output" | rg -F -q \
		'((MetamathProofTraceDirectCompressedEvidenceV1 AcceptedV1))'; \
	test "$$(printf '%s\n' "$$output" | rg -c '^[(][)]$$')" -eq 1; \
	awk '1' $(METAMATH_PROOF_TRACE_DIRECT_PROGRAM_V1) \
		$(METAMATH_PROOF_TRACE_ESSENTIAL_RESULT_QUERY_V1) \
		> "$$work/essential-result-run.metta"; \
	essential=$$(timeout 60 $(CETTA_PETTA_DIRECT_RUN_V1) \
		"$$work/essential-result-run.metta" 2>&1); \
	test "$$(printf '%s\n' "$$essential" | rg -c '^[(][(]')" -eq 2; \
	printf '%s\n' "$$essential" | rg -F -q \
		'ProofTraceEssentialsSucceededV1'; \
	printf '%s\n' "$$essential" | rg -F -q \
		'(ProofTraceRefusedEssentialMismatchV1 (ProofSequenceConsV1 input-x-v1 ProofSequenceNilV1) (ProofSequenceConsV1 input-a-v1 ProofSequenceNilV1) (ProofSequenceConsV1 input-dummy-v1 ProofSequenceNilV1))'; \
	$(GSLT_RULE_MUTATOR_V1_BIN) mutate \
		--source $(CERTIFICATE_GSLT_TRACE_SEMANTICS_V1) \
		--out "$$work/severed-semantics.metta" \
		--rule proof-trace-exec-state-result-apply-v1 --mode delete; \
	$(LANGDEF_COMPILER_V1_BIN) petta-direct \
		--source $(METAMATH_PROOF_SEMANTIC_EXEC_DIRECT_V1) \
		--source "$$work/severed-semantics.metta" \
		--source $(CERTIFICATE_GSLT_TRACE_COMPILER_V1) \
		--source $(CERTIFICATE_GSLT_TRACE_INPUT_V1) \
		--source experiments/gslt2parse_foundation/presentations/core/certificate_gslt_trace_input_interface_v1.metta \
		--source $(CERTIFICATE_GSLT_TRACE_PROJECTED_INPUT_INTERFACE_V1) \
		--source $(CERTIFICATE_GSLT_TRACE_APARTNESS_INTERFACE_V1) \
		--source $(METAMATH_PROOF_TRACE_POLICY_V1) \
		--source $(METAMATH_PROOF_TRACE_CODEC_V1) \
		--source $(CERTIFICATE_GSLT_TRACE_INPUT_CANARY_V1) \
		--source $(CERTIFICATE_GSLT_TRACE_EVIDENCE_CANARY_V1) \
		--out "$$work/severed-program.metta" >/dev/null; \
	! cmp -s "$$work/severed-program.metta" \
		$(METAMATH_PROOF_TRACE_DIRECT_PROGRAM_V1); \
	awk '1' "$$work/severed-program.metta" \
		$(METAMATH_PROOF_TRACE_DIRECT_QUERY_V1) > "$$work/severed-run.metta"; \
	severed=$$(timeout 60 $(CETTA_PETTA_DIRECT_RUN_V1) \
		"$$work/severed-run.metta" 2>&1); \
	test "$$(printf '%s\n' "$$severed" | rg -c '^[(][)]$$')" -eq 5; \
	if printf '%s\n' "$$severed" | \
		rg -q 'MetamathProofTraceDirect(Normal|Compressed)(Evidence)?V1'; then \
		exit 1; \
	fi; \
	printf '%s\n' '(MetamathProofTraceDirectV1Summary 230 6 1 1 0)'

