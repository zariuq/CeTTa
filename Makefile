		PlainBnfSecondStageDocumentExactV1 \
		PlainBnfSecondStageDenotationFixedPointExactV1; do \
		test "$$(printf '%s\n' "$$output" | rg -F -x -c "$$marker")" -eq 1; \
	done; \
		! printf '%s\n' "$$output" | rg -q \
		'^[(](Error|assertEqual|PlainBnfUnexpected)'

