.PHONY: test-metamath-cogslt-occurrence-stream-v1
test-metamath-cogslt-occurrence-stream-v1: \
		$(METAMATH_CURSOR_FOLD_TEST_BIN_V1) $(LANGDEF_COMPILER_V1_BIN)
	@set -euo pipefail; \
	work=$$(mktemp -d runtime/metamath-occurrence-stream.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	$(METAMATH_CURSOR_FOLD_TEST_BIN_V1) \
		tests/langdef/metamath/positive_constants.mm \
		--occurrence-answers > "$$work/positive.answers"; \
	$(METAMATH_CURSOR_FOLD_TEST_BIN_V1) \
		tests/langdef/metamath/positive_constants.mm \
		--occurrence-answers > "$$work/regenerated.answers"; \
	cmp -s "$$work/positive.answers" "$$work/regenerated.answers"; \
	test "$$(wc -l < "$$work/positive.answers")" -eq 2; \
	rg -q '^[(]ParserOccurrenceStreamV3 sha256-[0-9a-f]{64} sha256-[0-9a-f]{64} 1 2 2[)]$$' \
		"$$work/positive.answers"; \
	rg -q '^[(]ParserOccurrenceV3 0 ParserOccurrenceReduceV1 mm-declare-constants statement_const 49 0 13 0 13 .* ParserOccurrenceEmptyRolesNilV1[)]$$' \
		"$$work/positive.answers"; \
	rg -q 'SourceBytesHexV1 hex-776666' "$$work/positive.answers"; \
	rg -q 'SourceBytesHexV1 hex-7c2d' "$$work/positive.answers"; \
	$(LANGDEF_COMPILER_V1_BIN) answer-facts \
		--source "$$work/positive.answers" \
		--out "$$work/positive.metta" >/dev/null; \
	$(METAMATH_CURSOR_FOLD_TEST_BIN_V1) \
		tests/support/metamath_mini_thm_compressed_v0.mm \
		--occurrence-answers > "$$work/compressed.answers"; \
	rg -q '^[(]ParserOccurrenceStreamV3 .* 6 36 11[)]$$' \
		"$$work/compressed.answers"; \
	test "$$(rg -o '[(]ParserOccurrenceValueV1 mm-symbol 0 [^)]*[(]SourceBytesHexV1 hex-776666[)][)]' \
		"$$work/compressed.answers" | wc -l)" -eq 5; \
	$(LANGDEF_COMPILER_V1_BIN) answer-facts \
		--source "$$work/compressed.answers" \
		--out "$$work/compressed.metta" >/dev/null; \
	sed 's/wff/wi/' tests/langdef/metamath/positive_constants.mm \
		> "$$work/source-mutated.mm"; \
	$(METAMATH_CURSOR_FOLD_TEST_BIN_V1) "$$work/source-mutated.mm" \
		--occurrence-answers > "$$work/source-mutated.answers"; \
	! cmp -s "$$work/positive.answers" "$$work/source-mutated.answers"; \
	rg -q 'SourceBytesHexV1 hex-7769' "$$work/source-mutated.answers"; \
	if $(METAMATH_CURSOR_FOLD_TEST_BIN_V1) \
		tests/langdef/metamath/invalid_missing_terminator.mm \
		--occurrence-answers > "$$work/rejected.answers" 2>/dev/null; then \
		exit 1; \
	fi; \
	test ! -s "$$work/rejected.answers"; \
	$(METAMATH_CURSOR_FOLD_TEST_BIN_V1) \
		tests/langdef/metamath/invalid_symbol_kind_conflict.mm \
		--occurrence-answers > "$$work/semantic-negative.answers"; \
	rg -q '^[(]ParserOccurrenceStreamV3 .* 2 2 1[)]$$' \
		"$$work/semantic-negative.answers"; \
	rg -q 'ParserOccurrenceReduceV1 mm-declare-constants' \
		"$$work/semantic-negative.answers"; \
	rg -q 'ParserOccurrenceReduceV1 mm-declare-variables' \
		"$$work/semantic-negative.answers"; \
	printf '%s\n' '(MetamathOccurrenceStreamV1Summary 3 6 2 1 0)'

