.PHONY: test-metamath-insert-row-core-rhocalc-profile-v1
test-metamath-insert-row-core-rhocalc-profile-v1: \
		$(METAMATH_INSERT_ROW_CORE_RHOMETTA_PROGRAM_V1) \
		$(METAMATH_INSERT_ROW_CORE_RHOMETTA_RUN_QUERY_V1) \
		$(METAMATH_INSERT_ROW_CORE_REFUSED_RHOMETTA_RUN_QUERY_V1) \
		$(BIN)
	@set -euo pipefail; \
	work=$$(mktemp -d runtime/metamath-insert-row-core-rhocalc-profile.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	awk '1' $(METAMATH_INSERT_ROW_CORE_RHOMETTA_PROGRAM_V1) \
		$(METAMATH_INSERT_ROW_CORE_RHOMETTA_RUN_QUERY_V1) \
		$(METAMATH_INSERT_ROW_CORE_REFUSED_RHOMETTA_RUN_QUERY_V1) \
		> "$$work/run.metta"; \
	result=$$(timeout 30 $(CETTA_BIN_INVOKE) \
		--rho-reduction-limit 400 \
		--lang rhocalc --profile rhometta --syntax metta \
		"$$work/run.metta" 2>&1); \
	test "$$(printf '%s\n' "$$result" | \
		rg -o -F '(gslt-rho:observed-v1' | wc -l)" -eq 2; \
	printf '%s\n' "$$result" | rg -F -q \
		'(InsertRowV1 (StateV1 MetamathPackageV1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'StateRequireKeyAbsentV1 (RowConsV1 NatZeroV1 RowNilV1) AcceptedV1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 insert-row-v1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 table-insert-v1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(RefusedKeyPresentV1 MetamathRowsTableV1 (RowConsV1 NatZeroV1 RowNilV1))'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 insert-row-by-table-result-refused-present-v1'; \
	printf '%s\n' '(MetamathInsertRowCoreRhoCalcProfileV1Summary 35 18 2 400 0)'

