			echo "FAIL: $$f (exit $$status; timeout limit $(PRIME_COMPLETION_TIMEOUT)s)"; \
			fail=$$((fail + 1)); continue; \
		fi; \
		if [ "$$result" = "$$(cat "$$exp")" ]; then \
			pass=$$((pass + 1)); \
		else \
			echo "FAIL: $$f"; \
			diff <(cat "$$exp") <(echo "$$result") | head -30; \
			fail=$$((fail + 1)); \
		fi; \
	done; \
	echo "Prime normal gate: $$pass passed, $$fail failed"; \
	[ $$fail -eq 0 ]
