$(METAMATH_DIRECT_RUNTIME_LOCK_V1): \
		$(METAMATH_DIRECT_RUNTIME_MANIFEST_V1) \
		$(METAMATH_DIRECT_COMPILED_CURSOR_V1) \
		$(METAMATH_NORMALIZED_PACK_V1) \
		$(METAMATH_DIRECT_RUNTIME_SOURCES_V1) \
		$(LANGDEF_COMPILER_V1_BIN)
	$(LANGDEF_COMPILER_V1_BIN) seal \
		--manifest $(METAMATH_DIRECT_RUNTIME_MANIFEST_V1) \
		--pack $(METAMATH_NORMALIZED_PACK_V1) \
		--compiled-cursor $(METAMATH_DIRECT_COMPILED_CURSOR_V1) \
		--lock-out $@

.PHONY: build-langdef-compiled-cursor-generated-v1
GENERATED_LANGDEF_CURSOR_C ?=
GENERATED_LANGDEF_CURSOR_SO ?=
GENERATED_LANGDEF_CURSOR_PREFIX ?=
build-langdef-compiled-cursor-generated-v1: \
		$(LANGDEF_COMPILED_CURSOR_EXPORT_V1) \
		$(LANGDEF_COMPILED_CURSOR_HEADER_V1) $(BUILD_CONFIG_HEADER)
	@test -n "$(GENERATED_LANGDEF_CURSOR_C)" -a \
		-f "$(GENERATED_LANGDEF_CURSOR_C)"
	@test -n "$(GENERATED_LANGDEF_CURSOR_SO)" -a \
		-n "$(GENERATED_LANGDEF_CURSOR_PREFIX)"
	@mkdir -p "$(dir $(GENERATED_LANGDEF_CURSOR_SO))"
	$(CC) $(CPPFLAGS) $(CFLAGS) -fPIC -shared -Wl,--build-id=none \
		-DCETTA_LANGDEF_COMPILED_PREFIX=$(GENERATED_LANGDEF_CURSOR_PREFIX) \
		-DCETTA_LANGDEF_COMPILED_HAS_OCCURRENCE_SPAN_MASK=1 \
		-DCETTA_LANGDEF_COMPILED_HAS_STATE_PROGRAM=1 \
		-DCETTA_LANGDEF_COMPILED_HAS_SOURCE_CONTROL=1 \
		-o "$(GENERATED_LANGDEF_CURSOR_SO)" \
		$(LANGDEF_COMPILED_CURSOR_EXPORT_V1) \
		"$(GENERATED_LANGDEF_CURSOR_C)"

