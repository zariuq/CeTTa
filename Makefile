	$(CC) $(CPPFLAGS) -DCETTA_CODE_TREE_MUTATION_SKIP_FREE=1 $(CFLAGS) -o $@ tests/test_code_tree.c src/select/code_tree.c $(CODE_TREE_TEST_LINK_FLAGS)

