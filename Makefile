test-rho-examples: $(BIN)
	@pass=0; fail=0; \
	for f in examples/rho/pure/*.mrho examples/rho/pure/*.rho; do \
		[ -f "$$f" ] || continue; \
		exp="$${f%.*}.expected"; \
		if [ ! -f "$$exp" ]; then continue; fi; \
		result=$$($(CETTA_BIN_INVOKE) --lang rhocalc "$$f" 2>&1); \
		if [ "$$result" = "$$(cat "$$exp")" ]; then \
			echo "PASS: $$f"; \
			pass=$$((pass + 1)); \
		else \
			echo "FAIL: $$f"; \
			diff <(cat "$$exp") <(echo "$$result") | head -20; \
			fail=$$((fail + 1)); \
		fi; \
	done; \
