		rg -c '^MM0LiveSyntax.*AcceptedV1$$')" -eq 3; \
	test "$$(printf '%s\n' "$$petta_output" | rg -c '^[(][)]$$')" -eq 2; \
	! printf '%s\n' "$$petta_output" | rg -q 'partial|Error'; \
