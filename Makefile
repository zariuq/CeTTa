	commits=$$(printf '%s\n' "$$stats" | awk '$$1 == "runtime-counter" && ($$2 == "prepared-pure-call-commit" || $$2 == "open-equation-choice" || $$2 == "petta-answer-producer-choice") {sum += $$3} END {print sum+0}'); \
