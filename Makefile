		$(METAMATH_INSERT_EACH_MATCHING_CORE_RHOMETTA_PROGRAM_V1))" -eq 85; \
	test "$$(rg -c '^[(]= [(]gslt-rho:process:' \
		$(METAMATH_INSERT_EACH_MATCHING_CORE_RHOMETTA_PROGRAM_V1))" -eq 35; \
	for rule in \
		insert-each-matching-nil-v1 \
		insert-each-matching-cons-v1; do \
		rg -F -q "; selected-entry-rule $$rule" \
			$(METAMATH_INSERT_EACH_MATCHING_CORE_RHOMETTA_PROGRAM_V1); \
	done; \
	if rg -qi 'HornClause|horn:prove|horn_prove|worklist' \
		$(METAMATH_INSERT_EACH_MATCHING_CORE_RHOMETTA_PROGRAM_V1); then \
		echo 'direct Rhometta insert-each-matching artifact contains an interpreter representation' >&2; \
		exit 1; \
	fi; \
	$(GSLT_RULE_MUTATOR_V1_BIN) mutate \
		--source $(RELATIONAL_STATE_TRANSITION_CORE_V1) \
		--out "$$work/severed-core.metta" \
		--rule insert-each-matching-after-insert-refused-v1 --mode delete; \
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		--source $(GSLT_GROUND_RELATIONS_V1) \
		--source $(CETTA_PETTA_GROUND_RELATIONS_V1) \
		--source "$$work/severed-core.metta" \
		--source $(RELATIONAL_STATE_OCCURRENCE_INTERFACE_V1) \
		--source $(METAMATH_STATE_TRANSITION_EXECUTION_CANARY_V1) \
		--entry-rule insert-each-matching-nil-v1 \
		--entry-rule insert-each-matching-cons-v1 \
		--out "$$work/severed.metta" >/dev/null; \
	! cmp -s "$$work/severed.metta" \
		$(METAMATH_INSERT_EACH_MATCHING_CORE_RHOMETTA_PROGRAM_V1); \
	! rg -F -q 'insert-each-matching-after-insert-refused-v1' \
		"$$work/severed.metta"; \
	printf '%s\n' '(MetamathInsertEachMatchingCoreRhoMettaCompileV1Summary 85 35 2 1 0)'

