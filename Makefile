	for gc in "" "CETTA_GC=1 CETTA_GC_BUDGET_MB=1"; do \
		env $$gc $(CETTA_BIN_INVOKE) --lang $$lane \
			tests/he/chain_destination_binder.metta \
			| diff -u tests/he/chain_destination_binder.expected -; \
	done; \
	done; \
	echo 'PASS: chain binds its destination in its template, in every HE profile'

test-he-not-reducible: $(BIN) tests/he/not_reducible_boundary.metta \
		tests/he/not_reducible_boundary.expected
	@set -eu -o pipefail; \
	for lane in $(HE_PROFILE_LANES); do \
	for gc in "" "CETTA_GC=1 CETTA_GC_BUDGET_MB=1"; do \
		env $$gc $(CETTA_BIN_INVOKE) --lang $$lane \
			tests/he/not_reducible_boundary.metta \
			| diff -u tests/he/not_reducible_boundary.expected -; \
	done; \
	done; \
	echo 'PASS: an equation or if branch whose body is NotReducible leaves its call unreduced, in every HE profile'

# A value HE's evaluation answered is not evaluated again: a one-line
# function answers what its body answers, a value argument is chosen once
# and shared, collect-then-spread gives the same answers, a space holds
# syntax, and a value keeps the form it was answered in.  The answers are
# Rust HE's, in every HE profile and on every route.  A value is still
# checked against a declared result type in he, and answered unchecked in
# he-compat, as Rust HE does.  A call that comes back stuck after its
# arguments are evaluated is a value in he; he-compat evaluates it again
# where Rust HE does.
.PHONY: test-he-evaluated-values
test-all: test-he-evaluated-values
test-he-evaluated-values: $(BIN) tests/he/evaluated_values.metta \
		tests/he/evaluated_values.expected \
		tests/he/evaluated_values.compat.expected \
		tests/he/evaluated_values_typed.metta \
		tests/he/evaluated_values_typed.expected \
		tests/he/evaluated_values_typed.compat.expected \
		tests/he/evaluated_values_stuck.metta \
		tests/he/evaluated_values_stuck.expected \
		tests/he/evaluated_values_stuck.compat.expected
	@set -eu -o pipefail; \
	for lane in $(HE_PROFILE_LANES); do \
	for route in "" "CETTA_PREPARED_PURE_REFERENCE=1" \
			"CETTA_HE_CANONICAL_EXECUTION=0" "CETTA_HE_SHARED_EXECUTION=0" \
			"CETTA_HE_COMPLETED_DELIVERY=0" "CETTA_GC=1 CETTA_GC_BUDGET_MB=1"; do \
		values_expected=tests/he/evaluated_values.expected; \
		case "$$lane" in *he-compat*) \
			values_expected=tests/he/evaluated_values.compat.expected;; esac; \
		env $$route $(CETTA_BIN_INVOKE) --lang $$lane \
			tests/he/evaluated_values.metta \
			| diff -u $$values_expected -; \
		for program in evaluated_values_typed evaluated_values_stuck; do \
		expected=tests/he/$$program.expected; \
		case "$$lane" in *he-compat*) \
			expected=tests/he/$$program.compat.expected;; esac; \
		env $$route $(CETTA_BIN_INVOKE) --lang $$lane \
			tests/he/$$program.metta | diff -u $$expected -; \
		done; \
	done; \
	done; \
	echo 'PASS: a value HE answered is answered again unevaluated, in every HE profile and on every route'

# A typed head runs in the prepared machine as HE runs it: a parameter of a
# value class is cast where HE casts it, the range is shown by the bodies,
# and a call HE answers with a type error, or one at an arity no arrow
# declares, is left to the canonical evaluator.  The typed loop's call
# compiles into the machine's register code, and turning the machine off
# changes no answer.  An answer producer, as under collapse, leaves a typed
# head to the evaluator.  An equation extending get-type does not take part
# in HE's typing of a call (unlike PeTTa's guard).
.PHONY: test-he-typed-calls-prepared
test-all: test-he-typed-calls-prepared
test-he-typed-calls-prepared: $(BIN) tests/he/typed_calls_prepared.metta \
		tests/he/typed_calls_prepared.expected \
		tests/he/typed_calls_authored_classifier.metta \
		tests/he/typed_calls_authored_classifier.expected
	@set -eu -o pipefail; \
	for program in typed_calls_prepared typed_calls_authored_classifier; do \
	for lane in he "he --profile he-compat" "he --profile extended"; do \
	for route in "" "CETTA_PREPARED_PURE_REFERENCE=1"; do \
		env $$route $(CETTA_BIN_INVOKE) --lang $$lane \
			tests/he/$$program.metta \
			| diff -u tests/he/$$program.expected -; \
	done; \
	done; \
	done; \
	trace=$$(CETTA_PREPARED_PURE_DEBUG=1 $(CETTA_BIN_INVOKE) --lang he \
		tests/he/typed_calls_prepared.metta 2>&1 >/dev/null); \
	grep -q 'bodies lowered to register code' <<<"$$trace"; \
	! grep -F -q 'atom=(inc $$acc)' <<<"$$trace"; \
	echo 'PASS: typed heads run in the prepared machine with HE casts, type errors and arity, in every HE profile'

# `not` is a prepared intrinsic: the prepared machine negates a truth value,
# and any other value leaves the call to the canonical evaluator.  Both routes
# answer as the reference engines do: SWI-PeTTa fails on a value that is not
# a truth value, and HE raises a type error.
.PHONY: test-prepared-pure-not
test-all: test-prepared-pure-not
test-prepared-pure-not: $(BIN) tests/petta/prepared_not.metta \
		tests/petta/prepared_not.expected tests/he/prepared_not.metta \
		tests/he/prepared_not.expected
	@set -eu -o pipefail; \
	for route in "" "CETTA_PREPARED_PURE_REFERENCE=1" \
		"CETTA_PREPARED_PURE_REFERENCE=1 CETTA_OPEN_EQUATIONS_REFERENCE=1"; do \
		env $$route $(CETTA_BIN_INVOKE) --lang petta \
			tests/petta/prepared_not.metta \
			| diff -u tests/petta/prepared_not.expected -; \
		for lane in he "he --profile he-compat" "he --profile extended"; do \
			env $$route $(CETTA_BIN_INVOKE) --lang $$lane \
				tests/he/prepared_not.metta \
				| diff -u tests/he/prepared_not.expected -; \
		done; \
	done; \
	for language in petta he; do \
		trace=$$(CETTA_PREPARED_PURE_DEBUG=1 $(CETTA_BIN_INVOKE) \
			--lang $$language tests/$$language/prepared_not.metta 2>&1 >/dev/null); \
		grep -q 'bodies lowered to register code' <<<"$$trace"; \
		! grep -q 'outside the pure machine fragment' <<<"$$trace"; \
	done; \
	echo 'PASS: prepared not preserves PeTTa failure and HE type errors across execution routes'

