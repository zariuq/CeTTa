		'(compile-proof-storage-plan-v1 (proof-frame-index-plan-v1 mm-check-theorem-compressed 14 mm-stack-proof-machine-v1 u32-open-addressed-index-v1 duplicate-reject-v1 proof-call-region-v1))' \
