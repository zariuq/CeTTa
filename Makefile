	@mkdir -p $(dir $@)
	$(GSLT_RULE_MUTATOR_V1_BIN) mutate \
		--source $(CERTIFICATE_GSLT_SEQUENCE_SCHEMA_V1) --out $@ \
		--rule proof-sequence-assertion-rule-apply --mode delete

