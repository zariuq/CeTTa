	CETTA_BIN=./$(BIN) python3 benchmarks/tensor/compact.py \
		--unit-binary ./$(DENSE_TENSOR_V1_TEST_BIN) $(TENSOR_BENCH_ARGS)

benchmark-tensor-capacity: $(BIN) test-library-spellings-v1
