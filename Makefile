test-metamath-state-proof-runtime-rhometta-core-v1: \
		$(METAMATH_STATE_PROOF_RUNTIME_RHOMETTA_PROGRAM_V1) \
		$(METAMATH_STATE_PROOF_RUNTIME_RHOMETTA_QUERY_V1) \
