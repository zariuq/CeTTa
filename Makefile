# Frame identities (src/binding/frame_identity.h) are one 64-bit word, a
# handle and its generation: across the handle range each round-trips its
# spelling, rejects stale generations and retires a spent handle; other
# words do not decode; a bounded table refuses without spending and serves
# again.
LAYOUT_WORDS_HEADER = src/generated/cetta_layout_words.generated.h
FRAME_IDENTITY_TEST_BIN = runtime/test_frame_identity-$(BUILD_OBJ_TAG)

$(FRAME_IDENTITY_TEST_BIN): tests/test_frame_identity.c src/atom.c src/binding/frame_identity.c src/binding/frame_identity.h src/binding/frame_identity_test.h $(LAYOUT_WORDS_HEADER) $(BUILD_CONFIG_HEADER)
	@mkdir -p runtime
	$(CC) $(CPPFLAGS) -DCETTA_TEST_HOOKS=1 -DCETTA_RUNTIME_STATS_NOOP=1 $(CFLAGS) -o $@ tests/test_frame_identity.c $(SYMBOL_STANDALONE_SRC) src/atom.c src/binding/frame_identity.c src/name_key.c src/atom_blob.c src/term_canon.c $(LDFLAGS)

.PHONY: test-frame-identity
test-all: test-frame-identity
test-frame-identity: $(FRAME_IDENTITY_TEST_BIN)
	@$(call cetta_exec,./$(FRAME_IDENTITY_TEST_BIN))

# Frame identities are spelled by the layout declared in
# langdef/layouts/runtime_words.module.  The accessors are checked-in
# ordinary C; regenerating them needs the Cesta tool (CESTA), building
# with them does not.  The test compares them with an independent reading of
# the word.
LAYOUT_WORDS_TEST_BIN = runtime/test_layout_words-$(BUILD_OBJ_TAG)

.PHONY: regenerate-layout-words check-layout-words-generated test-layout-words
regenerate-layout-words: | cesta-tool
	python3 -B tools/regenerate_layout_words.py --cesta "$(CESTA)"
check-layout-words-generated: | cesta-tool
	python3 -B tools/regenerate_layout_words.py --cesta "$(CESTA)" --check

$(LAYOUT_WORDS_TEST_BIN): tests/test_layout_words.c $(LAYOUT_WORDS_HEADER) src/binding/frame_identity.h src/match.h
	@mkdir -p runtime
	$(CC) $(CPPFLAGS) $(CFLAGS) -o $@ tests/test_layout_words.c $(LDFLAGS)

test-all: test-layout-words
test-layout-words: $(LAYOUT_WORDS_TEST_BIN)
	@$(call cetta_exec,./$(LAYOUT_WORDS_TEST_BIN))

# Reclaimable names (src/binding/name_space.h): watermarks survive non-final
# releases, a failed weak upgrade that releases last recycles the name, owner
# counts never wrap and spent names retire, quarantine never reuses, and live
# names are distinct across threads with only-growing generations.
NAME_SPACE_TEST_BIN = runtime/test_name_space-$(BUILD_OBJ_TAG)

$(NAME_SPACE_TEST_BIN): tests/test_name_space.c src/binding/name_space.h $(BUILD_CONFIG_HEADER)
	@mkdir -p runtime
	$(CC) $(CPPFLAGS) $(CFLAGS) -o $@ tests/test_name_space.c $(LDFLAGS)

.PHONY: test-name-space
test-name-space: $(NAME_SPACE_TEST_BIN)
	@$(call cetta_exec,./$(NAME_SPACE_TEST_BIN))

# Arena identities are reclaimable names: reused only after their arenas are
# freed (a run creates arenas past the end of the name space), each reuse
# starting its reset epochs above the last, an older generation's name owned
# by the younger arena that links it, and no name live twice under threads.
ARENA_IDENTITY_NAMES_TEST_BIN = runtime/test_arena_identity_names-$(BUILD_OBJ_TAG)

$(ARENA_IDENTITY_NAMES_TEST_BIN): tests/test_arena_identity_names.c $(SYMBOL_STANDALONE_SRC) src/atom.c src/binding/frame_identity.c src/binding/name_space.h $(BUILD_CONFIG_HEADER)
