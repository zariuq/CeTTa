	$(filter-out $(OPERATIONAL_LANGUAGE_DEF_V1_ALLOC_OBJ),\
		$(OPERATIONAL_LANGUAGE_DEF_V1_LINK_OBJ))

$(LANGUAGE_DEF_GROUND_TERM_V1_TEST_OBJ): \
		$(LANGUAGE_DEF_GROUND_TERM_V1_TEST_SRC) \
