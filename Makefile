		$(METAMATH_SOURCE_RESOLUTION_CONTROL_V1) \
		$(METAMATH_NORMALIZED_PACK_V1) $(METAMATH_LEXICAL_NFA_V1) \
		$(METAMATH_EMPTY_GUARD_ANSWERS_V1) \
		$(METAMATH_EMPTY_GUARD_EVIDENCE_V1) \
		$(METAMATH_ACTION_BYTECODE_V1) $(METAMATH_OCCURRENCE_FOLD_V1) \
		$(METAMATH_STATE_PROGRAM_V1) \
		$(PARSER_PACK_CURSOR_COMPILE_V1_STREAM_BIN) \
		| build-cogslt-relational-state-transition-core-tools-v1
	@set -euo pipefail; \
	test "$$(wc -l <$(SOURCE_RESOLUTION_CONTROL_ANSWERS_V1))" -eq 11; \
	test "$$(wc -l <$(METAMATH_SOURCE_RESOLUTION_CONTROL_V1))" -eq 35; \
	test "$$(rg -c ' SourceControlDecisionRecordV1 ' \
		$(METAMATH_SOURCE_RESOLUTION_CONTROL_V1))" -eq 24; \
	test "$$(rg -c ' SourceControlFinishRecordV1 ' \
		$(METAMATH_SOURCE_RESOLUTION_CONTROL_V1))" -eq 11; \
	rg -F -x -q \
		'(SourceResolutionObservationV1 FreshAcceptedV1 (SourceExpandFreshV1 SourceIdA) (SourceAcceptedFreshV1 SourceIdA))' \
		$(SOURCE_RESOLUTION_CONTROL_ANSWERS_V1); \
	rg -F -x -q \
		'(SourceResolutionObservationV1 ActiveRejectV1 (SourceRefuseV1 (SourceRefusedActiveV1 SourceIdA)) (SourceRefusedOutcomeV1 (SourceRefusedActiveV1 SourceIdA)))' \
		$(SOURCE_RESOLUTION_CONTROL_ANSWERS_V1); \
	rg -F -x -q \
		'(SourceResolutionObservationV1 MissingV1 (SourceRefuseV1 (SourceRefusedMissingV1 SourcePathA)) (SourceRefusedOutcomeV1 (SourceRefusedMissingV1 SourcePathA)))' \
		$(SOURCE_RESOLUTION_CONTROL_ANSWERS_V1); \
	rg -F -x -q \
		'(SourceResolutionObservationV1 FreshResourceV1 (SourceExpandFreshV1 SourceIdA) SourceResourceOutcomeV1)' \
		$(SOURCE_RESOLUTION_CONTROL_ANSWERS_V1); \
	! rg -q 'InvalidPolicyV1' \
		$(SOURCE_RESOLUTION_CONTROL_ANSWERS_V1); \
	! rg -q 'StateResolveSourceV1|state-resolve-source|mm-resolve-include' \
		$(SOURCE_RESOLUTION_CONTROL_CORE_V1) \
		$(SOURCE_RESOLUTION_CONTROL_CANARY_V1); \
	work=$$(mktemp -d runtime/source-resolution-control.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	$(RELATIONAL_STATE_TRANSITION_MUTATOR_CORE_V1) mutate \
		--source $(SOURCE_RESOLUTION_CONTROL_CORE_V1) \
		--out "$$work/deleted-active-reject.metta" \
		--rule source-resolve-active-reject-v1 --mode delete; \
	$(RELATIONAL_STATE_TRANSITION_LANGDEF_CORE_V1) answers \
		--chart $(RELATIONAL_STATE_TRANSITION_CHART_CORE_V1) \
		--source "$$work/deleted-active-reject.metta" \
		--source $(SOURCE_RESOLUTION_CONTROL_CANARY_V1) \
		--query '(SourceResolutionObservationV1 ?name ?decision ?outcome)' \
		--out "$$work/deleted-active-reject.answers" >/dev/null; \
	test "$$(wc -l <"$$work/deleted-active-reject.answers")" -eq 10; \
	! rg -q 'ActiveRejectV1' "$$work/deleted-active-reject.answers"; \
	$(RELATIONAL_STATE_TRANSITION_LANGDEF_CORE_V1) answers \
		--chart $(RELATIONAL_STATE_TRANSITION_CHART_CORE_V1) \
		--source "$$work/deleted-active-reject.metta" \
		--source $(SOURCE_RESOLUTION_CONTROL_COMPILER_V1) \
		--query '(SourceResolutionControlRecordV1 ?kind ?a ?b ?c)' \
		--out "$$work/deleted-active-reject.plan" >/dev/null; \
	test "$$(wc -l <"$$work/deleted-active-reject.plan")" -eq 33; \
	if $(PARSER_PACK_CURSOR_COMPILE_V1_STREAM_BIN) \
		--abi $(METAMATH_NORMALIZED_PACK_V1) \
		--lexical-answers $(METAMATH_LEXICAL_NFA_V1) \
		--guard-answers $(METAMATH_EMPTY_GUARD_ANSWERS_V1) \
		--guard-evidence $(METAMATH_EMPTY_GUARD_EVIDENCE_V1) \
		--guarded-answers $(METAMATH_EMPTY_GUARD_ANSWERS_V1) \
		--regular-compiler-digest $(METAMATH_REGULAR_COMPILER_DIGEST_V1) \
		--guarded-compiler-digest $(METAMATH_GUARDED_COMPILER_DIGEST_V1) \
		--action-answers $(METAMATH_ACTION_BYTECODE_V1) \
		--action-compiler-digest $(METAMATH_ACTION_COMPILER_DIGEST_V1) \
		--occurrence-fold-answers $(METAMATH_OCCURRENCE_FOLD_V1) \
		--state-answers $(METAMATH_STATE_PROGRAM_V1) \
		--source-control-answers "$$work/deleted-active-reject.plan" \
		--source-control-compiler-digest $(SOURCE_RESOLUTION_CONTROL_COMPILER_DIGEST_V1) \
		--out-c "$$work/invalid.generated.c" \
		--prefix source_control_mutation_v1 >/dev/null 2>&1; then \
		echo 'incomplete source-control plan was admitted' >&2; exit 1; \
	fi; \
	$(RELATIONAL_STATE_TRANSITION_MUTATOR_CORE_V1) mutate \
		--source $(SOURCE_RESOLUTION_CONTROL_CORE_V1) \
		--out "$$work/deleted-fresh-resource.metta" \
		--rule source-finish-fresh-resource-v1 --mode delete; \
	$(RELATIONAL_STATE_TRANSITION_LANGDEF_CORE_V1) answers \
		--chart $(RELATIONAL_STATE_TRANSITION_CHART_CORE_V1) \
		--source "$$work/deleted-fresh-resource.metta" \
		--source $(SOURCE_RESOLUTION_CONTROL_CANARY_V1) \
		--query '(SourceResolutionObservationV1 ?name ?decision ?outcome)' \
		--out "$$work/deleted-fresh-resource.answers" >/dev/null; \
	test "$$(wc -l <"$$work/deleted-fresh-resource.answers")" -eq 10; \
	! rg -q 'FreshResourceV1' "$$work/deleted-fresh-resource.answers"; \
	printf '%s\n' '(SourceResolutionControlV1Summary 12 11 2 1 0)'

