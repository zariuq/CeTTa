		else \
			$(MAKE) -s BUILD=$(BUILD_CANON) ENABLE_RUNTIME_STATS=1 test-mork-runtime-stats-lane-body; \
		fi; \
	else \
		if [ -f "$(MORK_BRIDGE_MANIFEST)" ] && [ "$(MORK_BRIDGE_DEPS_READY)" = "1" ]; then \
			bridge_build=mork; \
			if [ "$(ENABLE_PYTHON)" = "1" ]; then bridge_build=main; fi; \
