.PHONY: test-gslt-rhometta-ground-relations-v1
test-gslt-rhometta-ground-relations-v1: \
		$(GSLT_DIRECT_RHOMETTA_GROUND_RELATIONS_PROGRAM_V1) \
		$(GSLT_DIRECT_RHOMETTA_GROUND_RELATIONS_QUERY_V1) \
		$(BIN)
	@set -euo pipefail; \
	work=$$(mktemp -d runtime/gslt-rhometta-ground-relations.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	awk '1' $(GSLT_DIRECT_RHOMETTA_GROUND_RELATIONS_PROGRAM_V1) \
		$(GSLT_DIRECT_RHOMETTA_GROUND_RELATIONS_QUERY_V1) \
		> "$$work/run.metta"; \
	rg -F -q \
		'(if (== (quote $$left) (quote $$right)) (superpose ()) (quote (different $$left $$right)))' \
		$(GSLT_DIRECT_RHOMETTA_GROUND_RELATIONS_PROGRAM_V1); \
	result=$$(timeout 30 $(CETTA_BIN_INVOKE) \
		--rho-reduction-limit 50 \
		--lang rhocalc --profile rhometta --syntax metta \
		"$$work/run.metta" 2>&1); \
	oracle_result=$$(CETTA_RHO_CANONICAL_EXHAUSTIVE_ORACLE=1 \
		timeout 30 $(CETTA_BIN_INVOKE) \
		--rho-reduction-limit 50 \
		--lang rhocalc --profile rhometta --syntax metta \
		"$$work/run.metta" 2>&1); \
	test "$$result" = "$$oracle_result"; \
	test "$$(printf '%s\n' "$$result" | \
		rg -o -F '(gslt-rho:observed-v1' | wc -l)" -eq 3; \
	printf '%s\n' "$$result" | rg -F -q \
		'(DirectGroundDifferentV1 DirectLeftV1 DirectRightV1)'; \
	printf '%s\n' "$$result" | rg -F -q \
		'QueryDirectGroundDifferentStructuredAcceptedRhoCliV1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'QueryDirectGroundDifferentTwiceAcceptedRhoCliV1'; \
	! printf '%s\n' "$$result" | rg -F -q \
		'QueryDirectGroundDifferentRefusedRhoCliV1'; \
	! printf '%s\n' "$$result" | rg -F -q \
		'QueryDirectGroundDifferentStructuredRefusedRhoCliV1'; \
	! printf '%s\n' "$$result" | rg -F -q \
		'QueryDirectGroundDifferentTwiceRefusedRhoCliV1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:capability-evidence-v1 different'; \
	printf '%s\n' '(GSLTDirectRhoMettaGroundRelationsV1Summary 2 3 3 1 0)'

.PHONY: test-gslt-rhometta-constructor-recursion-v1
test-gslt-rhometta-constructor-recursion-v1: \
		$(GSLT_DIRECT_RHOMETTA_CONSTRUCTOR_RECURSION_PROGRAM_V1) \
		$(GSLT_DIRECT_RHOMETTA_CONSTRUCTOR_RECURSION_QUERY_V1) \
		$(BIN)
	@set -euo pipefail; \
	work=$$(mktemp -d runtime/gslt-rhometta-constructor-recursion.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		--source $(GSLT_DIRECT_RHOMETTA_CONSTRUCTOR_RECURSION_V1) \
		--out "$$work/program.metta" >/dev/null; \
	cmp -s "$$work/program.metta" \
		$(GSLT_DIRECT_RHOMETTA_CONSTRUCTOR_RECURSION_PROGRAM_V1); \
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		--source $(GSLT_DIRECT_RHOMETTA_CONSTRUCTOR_RECURSION_V1) \
		--epilogue $(GSLT_DIRECT_RHOMETTA_CONSTRUCTOR_RECURSION_QUERY_V1) \
		--out "$$work/run.metta" >/dev/null; \
	output=$$(timeout 30 ./$(BIN) --lang he "$$work/run.metta" 2>&1); \
	test "$$(printf '%s\n' "$$output" | \
		rg -o -F '(gslt-rho:observed-v1' | wc -l)" -eq 3; \
	printf '%s\n' "$$output" | rg -F -q \
		'(DirectBuildListV1 (NatSuccV1 (NatSuccV1 NatZeroV1)) (DirectBuildConsV1 DirectBuildItemV1 (DirectBuildConsV1 DirectBuildItemV1 DirectBuildNilV1)))'; \
	printf '%s\n' "$$output" | rg -F -q \
		'(gslt-rho:evidence-cons-v1 (gslt-rho:derivation-v1 direct-build-list-cons-v1'; \
	! printf '%s\n' "$$output" | rg -F -q \
		'QueryDirectBuildListImpossibleV1'; \
	test "$$(printf '%s\n' "$$output" | rg -F -x -c '[()]')" -eq 2; \
	rg -F -q 'fresh request instance for DirectRhoMettaConstructorRecursionV1 / direct-build-list-cons-v1' \
		$(GSLT_DIRECT_RHOMETTA_CONSTRUCTOR_RECURSION_PROGRAM_V1); \
	printf '%s\n' '(GSLTDirectRhoMettaConstructorRecursionV1Summary 2 1 3 1)'

.PHONY: test-gslt-rhometta-direct-v1
test-gslt-rhometta-direct-v1: \
		test-gslt-direct-source-identity-v1 \
		$(GSLT_DIRECT_RHOMETTA_PROGRAM_V1) \
		$(GSLT_DIRECT_IDENTITY_TARGET_EQUATION_V1) \
		$(GSLT_DIRECT_RHOMETTA_QUERY_V1) \
		$(GSLT_DIRECT_RHOMETTA_PARENT_QUERY_V1) \
		$(GSLT_DIRECT_RHOMETTA_TRAMPOLINE_V1) \
		test-gslt-rhometta-ground-relations-v1 \
		test-gslt-rhometta-constructor-recursion-v1 \
		$(GSLT_RULE_MUTATOR_V1_BIN) \
		$(BIN)
	@set -euo pipefail; \
	work=$$(mktemp -d runtime/gslt-rhometta-direct.XXXXXX); \
	trap 'rm -rf "$$work"' EXIT INT TERM; \
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		--composition $(GSLT_DIRECT_PETTA_COMPOSITION_V1) \
		--out "$$work/program.metta" >/dev/null; \
	cmp -s "$$work/program.metta" $(GSLT_DIRECT_RHOMETTA_PROGRAM_V1); \
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		--source $(GSLT_DIRECT_PETTA_PARENT_V1) \
		--source $(GSLT_DIRECT_PETTA_ANCESTOR_V1) \
		--out "$$work/explicit-program.metta" >/dev/null; \
	cmp -s "$$work/explicit-program.metta" \
		$(GSLT_DIRECT_RHOMETTA_PROGRAM_V1); \
	rg -q \
		'[(]gslt-rho:path-token-v1 [$$]__gslt_rho_returned_[0-9]+_[0-9]+ [$$]__gslt_rho_occurrence_[0-9]+_[0-9]+[)]' \
		"$$work/explicit-program.metta"; \
	! rg -q \
		'[(]gslt-rho:path-token-v1 ([(]gslt-rho:path-token-v1|[$$]__gslt_rho_(instance|relation|query)_token_)' \
		"$$work/explicit-program.metta"; \
	rg -F -q \
		'; target-package-sha256 ba510c06a983e9c921325da27a8abaee41d023a98f76aec0506e0641b04cad29' \
		$(GSLT_DIRECT_RHOMETTA_PROGRAM_V1); \
	sed 's/rho:recv-persistent/rho:recv-persistent-mutant/' \
		$(RHOMETTA_PERSISTENT_RECEIVE_EXTENSION_V1) \
		> "$$work/mutated-target.metta"; \
	! $(LANGDEF_COMPILER_V1_BIN) rhometta-direct \
		--target $(RHO_ABSTRACT_SYNTAX_V1) \
		--target $(RHO_RUNTIME_TERM_ABI_V1) \
		--target "$$work/mutated-target.metta" \
		--source $(GSLT_DIRECT_PETTA_PARENT_V1) \
		--source $(GSLT_DIRECT_PETTA_ANCESTOR_V1) \
		--out "$$work/mutated-target-program.metta" \
		>/dev/null 2>"$$work/mutated-target.err"; \
	rg -F -q 'rhometta-direct target package digest mismatch' \
		"$$work/mutated-target.err"; \
	! $(RHOMETTA_DIRECT_COMPILER_V1) \
		--source $(GSLT_DIRECT_IDENTITY_TARGET_EQUATION_V1) \
		--out "$$work/identity-target-equation.metta" \
		>/dev/null 2>"$$work/identity-target-equation.err"; \
	rg -F -q \
		'direct Rhometta rejects a structurally identical target equation' \
		"$$work/identity-target-equation.err"; \
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		--composition $(GSLT_DIRECT_PETTA_COMPOSITION_V1) \
		--epilogue $(GSLT_DIRECT_RHOMETTA_QUERY_V1) \
		--out "$$work/run.metta" >/dev/null; \
	output=$$(timeout 30 ./$(BIN) --lang he "$$work/run.metta" 2>&1); \
	test "$$(printf '%s\n' "$$output" | \
		rg -o -F '(gslt-rho:observed-v1' | wc -l)" -eq 3; \
	printf '%s\n' "$$output" | rg -F -q \
		'(DirectAncestorV1 DirectAliceV1 DirectBobV1)'; \
	printf '%s\n' "$$output" | rg -F -q \
		'(DirectAncestorV1 DirectAliceV1 DirectCaraV1)'; \
	printf '%s\n' "$$output" | rg -F -q \
		'(DirectAncestorV1 DirectAliceV1 DirectDaraV1)'; \
	test "$$(printf '%s\n' "$$output" | rg -F -x -c '[()]')" -eq 2; \
	! printf '%s\n' "$$output" | rg -F -q \
		'(gslt-rho:observed-v1 QueryMissingParentV1'; \
	$(GSLT_RULE_MUTATOR_V1_BIN) mutate \
		--source $(GSLT_DIRECT_PETTA_ANCESTOR_V1) \
		--out "$$work/severed-source.metta" \
		--rule direct-ancestor-step-v1 --mode delete; \
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		--source $(GSLT_DIRECT_PETTA_PARENT_V1) \
		--source "$$work/severed-source.metta" \
		--epilogue $(GSLT_DIRECT_RHOMETTA_QUERY_V1) \
		--out "$$work/severed-run.metta" >/dev/null; \
	severed=$$(timeout 30 ./$(BIN) --lang he "$$work/severed-run.metta" 2>&1); \
	test "$$(printf '%s\n' "$$severed" | \
		rg -o -F '(gslt-rho:observed-v1' | wc -l)" -eq 1; \
	printf '%s\n' "$$severed" | rg -F -q \
		'(DirectAncestorV1 DirectAliceV1 DirectBobV1)'; \
	! printf '%s\n' "$$severed" | rg -q 'Direct(Cara|Dara)V1'; \
	if rg -qi 'HornClause|horn:prove|horn_prove|worklist' \
		$(GSLT_DIRECT_RHOMETTA_PROGRAM_V1); then \
		echo 'direct Rhometta artifact contains an interpreter representation' >&2; \
		exit 1; \
	fi; \
	./$(BIN) --lang he $(GSLT_DIRECT_RHOMETTA_TRAMPOLINE_V1) >/dev/null; \
	printf '%s\n' '(GSLTDirectRhoMettaV1Summary 5 2 3 1 1)'

