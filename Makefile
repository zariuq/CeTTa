		rg -c '^MM0Runtime.*V1$$')" -eq 6; \
	$(RHOMETTA_DIRECT_COMPILER_V1) \
		--source $(GSLT_GROUND_RELATIONS_V1) \
		--source $(CETTA_PETTA_GROUND_RELATIONS_V1) \
		--source $(MM0_LIVE_SYNTAX_FOLD_V1) \
