		--entry-rule require-row-key-absent-v1 \
		--out "$$work/regenerated.metta" >/dev/null; \
	cmp -s "$$work/regenerated.metta" \
		$(METAMATH_ROW_CONDITIONS_CORE_RHOMETTA_PROGRAM_V1); \
	awk '1' $(METAMATH_ROW_CONDITIONS_CORE_RHOMETTA_PROGRAM_V1) \
		$(METAMATH_ROW_CONDITIONS_CORE_RHOMETTA_RUN_QUERY_V1) \
		> "$$work/run.metta"; \
	result=$$(timeout 30 $(CETTA_BIN_INVOKE) \
		--rho-reduction-limit 300 \
		--lang rhocalc --profile rhometta --syntax metta \
		"$$work/run.metta" 2>&1); \
	test "$$(rg -c '^; fresh request instance for ' \
		$(METAMATH_ROW_CONDITIONS_CORE_RHOMETTA_PROGRAM_V1))" -eq 29; \
	test "$$(rg -c '^[(]= [(]gslt-rho:process:' \
		$(METAMATH_ROW_CONDITIONS_CORE_RHOMETTA_PROGRAM_V1))" -eq 15; \
	test "$$(printf '%s\n' "$$result" | \
		rg -o -F '(gslt-rho:observed-v1' | wc -l)" -eq 4; \
	printf '%s\n' "$$result" | rg -F -q \
		'(RequireRowV1 (StateV1 MetamathPackageV1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(RefusedRowAbsentV1 MetamathRowsTableV1 (RowConsV1 (NatSuccV1 NatZeroV1) RowNilV1))'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(RequireRowKeyAbsentV1 (StateV1 MetamathPackageV1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(RefusedKeyPresentV1 MetamathRowsTableV1 (RowConsV1 NatZeroV1 RowNilV1))'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 require-row-by-membership-present-v1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 require-row-by-membership-absent-v1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 require-row-key-absent-by-lookup-absent-v1'; \
	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 require-row-key-absent-by-lookup-present-v1'; \
	for rule in \
		require-row-by-membership-absent-v1 \
		require-row-key-absent-by-lookup-present-v1; do \
		$(GSLT_RULE_MUTATOR_V1_BIN) mutate \
			--source $(RELATIONAL_STATE_TRANSITION_CORE_V1) \
			--out "$$work/severed-core-$$rule.metta" \
			--rule "$$rule" --mode delete; \
		$(RHOMETTA_DIRECT_COMPILER_V1) \
			--source $(GSLT_GROUND_RELATIONS_V1) \
			--source $(CETTA_PETTA_GROUND_RELATIONS_V1) \
			--source "$$work/severed-core-$$rule.metta" \
			--source $(RELATIONAL_STATE_OCCURRENCE_INTERFACE_V1) \
			--source $(METAMATH_STATE_TRANSITION_EXECUTION_CANARY_V1) \
			--entry-rule require-row-v1 \
			--entry-rule require-row-key-absent-v1 \
			--out "$$work/severed-$$rule.metta" >/dev/null; \
		! cmp -s "$$work/severed-$$rule.metta" \
			$(METAMATH_ROW_CONDITIONS_CORE_RHOMETTA_PROGRAM_V1); \
		! rg -F -q "; fresh request instance for RelationalStateTransitionCoreV1 / $$rule" \
			"$$work/severed-$$rule.metta"; \
	done; \
	printf '%s\n' '(MetamathRowConditionsCoreRhoCalcProfileV1Summary 29 15 4 2 300 0)'

