	printf '%s\n' "$$result" | rg -F -q \
		'(gslt-rho:derivation-v1 require-row-key-absent-by-lookup-present-v1'; \
	printf '%s\n' '(MetamathRequireRowKeyAbsentStateStepRhoCalcProfileV1Summary 57 24 2 400 0)'

