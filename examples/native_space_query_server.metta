; Compositional relational queries use the ordinary captured Space leaves.
!(import! &self "native_kb_server.metta")
!(import! &self (library kb_query))
!(import! &self (library list))

; Applications declare reviewed pure callbacks as program data:
; (QueryPureCallbackV1 their-function). KB facts cannot extend this list.
; This is an application review boundary, not a proof of callback purity.
(: query-server:callback? (-> Atom Bool))
(: query-server:allowed-plan? (-> Atom Bool))
(= (query-server:callback? $name)
  (if (kbq:callback? $name)
    (> (size-atom (collapse (match &self (QueryPureCallbackV1 $name) Allowed))) 0) False))
(= (query-server:allowed-plan? $plan)
  (if (knowledge:headed? $plan)
    (case $plan
      (((KqRows $rows) True)
       ((KqSpace $collection $pattern $template) True)
       ((KqRange $collection $arity $position $lower $upper $pattern $template) True)
       ((KqUnion $plans) (query-server:allowed-plans? $plans))
       ((KqBind $left $pattern $right) (and (query-server:allowed-plan? $left) (query-server:allowed-plan? $right)))
       ((KqOptional $left $pattern $right $missing) (and (query-server:allowed-plan? $left) (query-server:allowed-plan? $right)))
       ((KqSemi $left $pattern $right) (and (query-server:allowed-plan? $left) (query-server:allowed-plan? $right)))
       ((KqAnti $left $pattern $right) (and (query-server:allowed-plan? $left) (query-server:allowed-plan? $right)))
       ((KqMap $source $callback) (and (query-server:callback? $callback) (query-server:allowed-plan? $source)))
       ((KqSelect $source $callback) (and (query-server:callback? $callback) (query-server:allowed-plan? $source)))
       ((KqDistinct $source $callback $maximum) (and (query-server:callback? $callback) (query-server:allowed-plan? $source)))
       ((KqFold $source $initial $callback $maximum) (and (query-server:callback? $callback) (query-server:allowed-plan? $source)))
       ((KqOrder $source $callback $maximum) (and (query-server:callback? $callback) (query-server:allowed-plan? $source)))
       ((KqGroup $source $key $equal $initial $step $maximum)
        (and (and (query-server:callback? $key) (query-server:callback? $equal))
          (and (query-server:callback? $step) (query-server:allowed-plan? $source))))
       ((KqSlice $source $offset $count) (query-server:allowed-plan? $source))
       ($bad False))) False))
(= (query-server:allowed-plans? $plans)
  (if (== (get-metatype $plans) Expression)
    (if (== $plans ()) True
      (let ($head $tail) (decons-atom $plans)
        (and (query-server:allowed-plan? $head) (query-server:allowed-plans? $tail)))) False))

(= (query-server:configuration)
  (let (ValueServiceV1 $socket $data $routes $limits) (kb-server:configuration)
    (ValueServiceV1 $socket $data
      (list:append $routes
        ((ServiceRouteV1 RelOpen Read query-server:open)
         (ServiceRouteV1 RelPage Read query-server:page)
         (ServiceRouteV1 RelInspect Read query-server:inspect)
         (ServiceRouteV1 RelCancel Read query-server:cancel)
         (ServiceRouteV1 RelOpenRead Read query-server:open-read)
         (ServiceRouteV1 RelReadPage Read query-server:read-page)
         (ServiceRouteV1 RelReadCommit Write query-server:read-commit)
         (ServiceRouteV1 RelReadCancel Read query-server:read-cancel))) $limits)))
(= (query-server:open (ServiceCallV1 $configuration $peer $view (RelOpenV1 $plan $maximum)))
  (if (query-server:allowed-plan? $plan)
   (if (and (kb:integer? $maximum) (and (> $maximum 0) (<= $maximum 131072)))
    (let $cursor (kbq:open-space $view $plan $maximum)
      (if (kbq:cursor? $cursor)
        (let (StoreViewInfo $epoch $revision) (store:view-info $view)
          (ServiceKeepValueV1 $cursor (RelOpenedV1 $epoch $revision))) $cursor))
    (KbRefused query-row-budget)) (KbRefused query-service-plan)))
(= (query-server:page (ServiceCallV1 $configuration $peer $cursor (RelPageV1 $count $fuel)))
  (if (and (and (kb:integer? $count) (kb:integer? $fuel))
           (and (and (> $count 0) (<= $count 32)) (and (>= $fuel 0) (<= $fuel 4096))))
    (case (kbq:page $cursor $count $fuel)
      (((KqPage $rows (KqMore $next)) (ServiceKeepValueV1 $next (RelPageV1 $rows More)))
       ((KqPage $rows (KqPaused $next)) (ServiceKeepValueV1 $next (RelPageV1 $rows Paused)))
       ((KqPage $rows (KqComplete $work)) (RelPageV1 $rows (Complete $work)))
       ((KqPage $rows (KqFailure $error $work)) (RelPageV1 $rows (Failed $error $work)))
       ($failure $failure)))
    (let $_ (kbq:close $cursor) (KbRefused query-page-budget))))
(= (query-server:cancel (ServiceCallV1 $configuration $peer $cursor $unused))
  (let $_ (kbq:close $cursor) RelCancelledV1))
(= (query-server:inspect (ServiceCallV1 $configuration $peer $cursor $unused))
  (ServiceKeepValueV1 $cursor (kbq:inspect-space $cursor)))

; A query-informed write retains a data/program context through completion.
; The service's opaque linear phase, not client-supplied syntax, distinguishes
; an unfinished query from the context allowed to reach this commit handler.
(= (query-server:open-read $call)
  (case (query-server:open $call)
    (((ServiceKeepValueV1 $cursor $metadata)
      (case (kbq:read-context $cursor)
        (((DurableReadContextV1 $view $watch)
          (ServiceKeepValueV1 (RelReadSessionV1 $cursor (DurableReadContextV1 $view $watch)) $metadata))
         ($failure (let $_ (kbq:close $cursor) $failure)))))
     ($failure $failure))))
(= (query-server:close-read $state)
  (case $state
    (((RelReadSessionV1 $cursor $context)
      (let* (($_ (kbq:close $cursor)) ($_ (durable-query:close-context $context))) RelReadClosedV1))
     ((RelReadCompleteV1 $context) (durable-query:close-context $context))
     ($bad RelReadClosedV1))))
(= (query-server:read-page (ServiceCallV1 $configuration $peer $state $arguments))
  (case $state
    (((RelReadSessionV1 $cursor $context)
      (case (query-server:page (ServiceCallV1 $configuration $peer $cursor $arguments))
        (((ServiceKeepValueV1 $next $page) (ServiceKeepValueV1 (RelReadSessionV1 $next $context) $page))
         ((RelPageV1 $rows (Complete $work))
          (ServiceKeepValueV1 (RelReadCompleteV1 $context) (RelPageV1 $rows (Complete $work))))
         ($failure (let $_ (durable-query:close-context $context) $failure)))))
     ($bad (let $_ (query-server:close-read $state) (KbRefused query-read-phase))))))
(= (query-server:read-commit
    (ServiceCallV1 (KbConfigurationV1 $owner) $peer $state (RelReadCommitV1 $collection $request $command $changes)))
  (case $state
    (((RelReadCompleteV1 $context)
      (let* (($answer (if (and (== (get-metatype $changes) Expression) (<= (size-atom $changes) 128))
                        (durable-query:commit-command $owner $context $collection $request $command $changes)
                        (StoreRefused edit-count-limit)))
             ($_ (durable-query:close-context $context))) $answer))
     ($bad (let $_ (query-server:close-read $state) (KbRefused query-read-phase))))))
(= (query-server:read-cancel (ServiceCallV1 $configuration $peer $state $arguments))
  (let $_ (query-server:close-read $state) RelReadClosedV1))
