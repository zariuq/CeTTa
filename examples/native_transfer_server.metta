; Logical transfer uses the same collection, view and publication authority
; as embedded programs. No server-side file path is supplied by a client.
!(import! &self "native_space_query_server.metta")
!(import! &self (library space_transfer))

(= (transfer-server:configuration)
  (let (ValueServiceV1 $socket $data $routes $limits) (query-server:configuration)
    (ValueServiceV1 $socket $data
      (list:append $routes
        ((ServiceRouteV1 ExportOpen Read transfer-server:export-open)
         (ServiceRouteV1 ExportNext Read transfer-server:export-next)
         (ServiceRouteV1 ExportCancel Read transfer-server:export-cancel)
         (ServiceRouteV1 ImportOpen Write transfer-server:import-open)
         (ServiceRouteV1 ImportRow Write transfer-server:import-row)
         (ServiceRouteV1 ImportFinish Write transfer-server:import-finish)
         (ServiceRouteV1 ImportCancel Read transfer-server:import-cancel)
         (ServiceRouteV1 ImportOrigin Read transfer-server:origin))) $limits)))
(= (transfer-server:export-open (ServiceCallV1 $configuration $peer $view (ExportOpenV1 $collection $maximum)))
  (case (durable-space:export-open $view $collection $maximum)
    (((SpaceExportOpenedV1 $state $header) (ServiceKeepValueV1 $state $header)) ($failure $failure))))
(= (transfer-server:export-next (ServiceCallV1 $configuration $peer $state $unused))
  (case (durable-space:export-next $state)
    (((SpaceExportMoreV1 $next $row) (ServiceKeepValueV1 $next $row)) ($terminal $terminal))))
(= (transfer-server:export-cancel (ServiceCallV1 $configuration $peer $state $unused))
  (durable-space:export-close $state))
(= (transfer-server:import-open
    (ServiceCallV1 (KbConfigurationV1 $owner) $peer $view (ImportOpenV1 $collection $request $header $digest $maximum)))
  (if (and (durable-index:integer? $maximum) (and (>= $maximum 64) (<= $maximum 67108864)))
    (case (durable-space:import-open $owner $view $collection $request $header $digest $maximum)
      (((SpaceImportOpenedV1 $state) (ServiceKeepValueV1 $state (durable-space:import-progress $state))) ($terminal $terminal)))
    (SpaceRefusedV1 import-spool-limit)))
(= (transfer-server:import-row (ServiceCallV1 $configuration $peer $state $row))
  (case (durable-space:import-row $state $row)
    (((SpaceImportMoreV1 $next $mapping) (ServiceKeepValueV1 $next $mapping)) ($terminal $terminal))))
(= (transfer-server:import-finish (ServiceCallV1 (KbConfigurationV1 $owner) $peer $state $footer))
  (durable-space:import-finish $owner $state $footer))
(= (transfer-server:import-cancel (ServiceCallV1 $configuration $peer $state $unused))
  (durable-space:import-close $state))
(= (transfer-server:origin (ServiceCallV1 $configuration $peer $view (ImportOriginV1 $collection $request $origin)))
  (durable-space:import-origin $view $collection $request $origin))
