// A job runner in the C-style presentation (2.0): workers take jobs one unit
// of work at a time, and a round repeats until nothing fires.  The file is
// read in order: each statement runs and its answers print, `atom` puts an
// atom in the program's space, and `f(x) = e` defines.  Calls are written
// f(a) where they run, data f{a} where it is held (patterns, atoms put in a
// space), as C and Go write a composite literal.
// Run: cetta --lang petta --profile extended --syntax cstyle job_runner_loop.cm
import!(&self, library{lib_transform});
import!(&self, library{lib_flow});

bind!(&jobs, new-space());
for ($j of [build, check, deploy]) { add-atom(&jobs, job{$j, 2}) };
add-atom(&jobs, worker{alice});
add-atom(&jobs, worker{bob});

// One step of the runner: a worker takes a job with work left and puts it
// back with one unit less; the worker's share is logged in the same firing.
run-round() = transform &jobs {
  take job{$j, $left}, read worker{$w}, when $left > 0, let $rest = $left - 1
  => worked{$w, $j}, job{$j, $rest}
} into &jobs;

// Rounds until the runner is quiet; the answer is how many rounds fired.
repeat { run-round() };

// Every logged share, then the finished jobs.
for (worked{$w, $j} from &jobs) { println!(share($w, $j)) };
sort-atom(collapse(match &jobs { job{$j, 0} => $j }));

// A budgeted loop: a statement block runs while the budget lasts.
bind!(&budget, new-state(3));
while (get-state(&budget) > 0) {
  println!(tick(get-state(&budget)));
  change-state!(&budget, get-state(&budget) - 1)
};
get-state(&budget);
