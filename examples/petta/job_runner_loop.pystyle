# The job runner of job_runner_loop.cm in the Python-style presentation (1.1),
# printed from the C-style text through its atoms, comments kept.  The file is
# read in order: each line runs and its answers print, `atom` puts an atom in
# the program's space, `def` defines; indentation delimits blocks.  Calls are
# written f(a) where they run, data f{a} where it is held.
# Run: cetta --lang petta --profile extended --syntax pystyle job_runner_loop.pystyle
import!(&self, library{lib_transform})
import!(&self, library{lib_flow})
bind!(&jobs, new-space())
for $j of [build, check, deploy]:
    add-atom(&jobs, job{$j, 2})
add-atom(&jobs, worker{alice})
add-atom(&jobs, worker{bob})
# One step of the runner: a worker takes a job with work left and puts it
# back with one unit less; the worker's share is logged in the same firing.
def run-round():
    transform &jobs into &jobs:
        take job{$j, $left}
        read worker{$w}
        when $left > 0
        let $rest = $left - 1
    yield (worked{$w, $j}, job{$j, $rest})
# Rounds until the runner is quiet; the answer is how many rounds fired.
repeat:
    run-round()
# Every logged share, then the finished jobs.
for worked{$w, $j} from &jobs:
    println!(share($w, $j))
sort-atom(collapse([$j for job{$j, 0} in &jobs]))
# A budgeted loop: a statement block runs while the budget lasts.
bind!(&budget, new-state(3))
while get-state(&budget) > 0:
    println!(tick(get-state(&budget)))
    change-state!(&budget, get-state(&budget) - 1)
get-state(&budget)
