; File-based PLN compression stages. Search and acceptance run in CeTTa.
!(import! &self (library lib_ic_source_seeds))
!(import! &self (library lib_ic_library_cost))
!(import! &self (library fs))
!(import! &self (library str))

(= (pln-poc:read $path)
   (let $numbers (map-atom (str:split-whitespace (fs:read-text $path)) $word (str:string->number $word))
     (tensor:from-values u8 ((size-atom $numbers)) $numbers)))
(= (pln-poc:write $path $artifact)
   (case (tensor:inspect $artifact)
     (((TensorData u8 $shape $entries)
       (fs:write $path (str:join " "
         (map-atom $entries $entry (str:number->string (index-atom $entry 1))))))
      ($bad (PLN:Fault Bytes)))))
(= (pln-poc:cost $artifact)
   (case (ic:library-cost Nodes $artifact) (((IC:Some $cost) $cost) ($bad (PLN:Fault Cost)))))
(= (pln-poc:bytes $artifact) (car-atom (tensor:shape $artifact)))
(= (pln-poc:finish (IC:SearchResult $best $statistics $reason $fault $state))
   (let $released (ic:release $state) (PLN:Search $best $statistics $reason $fault)))
(= (pln-poc:run $prepared $split)
   (case $prepared
     (((IC:PreparedSearch $state)
       (if (== $split 0) (pln-poc:finish (ic:resume $state 4000))
         (case (ic:resume $state $split)
           (((IC:SearchResult $best $statistics BudgetExhausted $fault $next)
             (let $printed (println! (PLN:Paused $split))
               (pln-poc:finish (ic:resume $next (- 4000 $split)))))
            ($bad (PLN:Fault DidNotPause))))))
      ($bad (PLN:Fault Preparation)))))
(= (pln-poc:search $artifact $name $split)
   (pln-poc:search $artifact $name $split 64))
(= (pln-poc:search $artifact $name $split $limit)
   (case (library-stack:view $artifact)
     (((Library:StackValue $layers $document $original)
       (let $prepared (ic:prepare-library RuleHeads $document)
         (case (ic:source-seed-region $prepared $limit)
           (((Library:SeedRegion $pairs $available)
             (let $printed (println! (PLN:Region (size-atom $pairs) $available))
               (pln-poc:run
                 (ic:continue-library Nodes RuleHeads $artifact $name 2048 (Library:Seeds $pairs)) $split)))
            ($bad (PLN:Fault Region))))))
      ($bad (PLN:Fault Artifact)))))
(= (pln-poc:uses $name $term)
   (case $term
     (((Syntax:Expr $children)
       (+ (if (== $children ()) 0
             (if (source-library:literal-symbol? (car-atom $children) $name) 1 0))
          (foldl-atom $children 0 $count $child (+ $count (pln-poc:uses $name $child)))))
      ($atom 0))))
(= (pln-poc:form-uses $name (Syntax:Form $names $term))
   (case $term
     (((Syntax:Expr ($equals $left $body))
       (if (source-library:literal-symbol? $equals "=") (pln-poc:uses $name $body)
         (pln-poc:uses $name $term)))
      ($other (pln-poc:uses $name $term)))))
(= (pln-poc:show-helpers $layers (Syntax:Document $v $r $forms))
   (map-atom $layers $layer
     (case $layer
       (((Library:Layer $codec $name)
         (println! (PLN:Uses $name
           (foldl-atom $forms 0 $count $form (+ $count (pln-poc:form-uses $name $form))))))))))

(= (pln-poc:pack $source $output $normalized)
   (let* (($document (syntax:read (fs:read-text $source)))
          ($artifact (ic:source-pack $document))
          ($saved (pln-poc:write $output $artifact))
          ($text (fs:write $normalized (syntax:write $document))))
     (println! (PLN:Packed (pln-poc:cost $artifact) (pln-poc:bytes $artifact)))))
(= (pln-poc:save $before $name $output $helpers
      (PLN:Search $best (IC:Statistics $turns $seen $accepted $faults) $reason $fault))
   (case (library-stack:view $best)
     (((Library:StackValue $layers (Syntax:Document $v $r $forms) $original)
       (let* (($saved (pln-poc:write $output $best))
              ($definitions (list:take (size-atom $layers) $forms))
              ($text (fs:write $helpers (syntax:write (Syntax:Document $v $r $definitions))))
              ($uses (pln-poc:show-helpers $layers (Syntax:Document $v $r $forms))))
         (println! (PLN:Stage $name (pln-poc:cost $before) (pln-poc:cost $best)
           (pln-poc:bytes $before) (pln-poc:bytes $best) $accepted $seen $reason $fault $faults))))
      ($bad (println! (PLN:Fault Export))))))
(= (pln-poc:learn $input $name $split $output $helpers)
   (pln-poc:learn $input $name $split $output $helpers 64))
(= (pln-poc:learn $input $name $split $output $helpers $limit)
   (let $before (pln-poc:read $input)
     (pln-poc:save $before $name $output $helpers (pln-poc:search $before $name $split $limit))))
(= (pln-poc:decode $input $output)
   (case (ic:library-unpack (pln-poc:read $input))
     (((IC:Some $document)
       (let $saved (fs:write $output (syntax:write $document)) (println! (PLN:Decoded))))
      ($bad (println! (PLN:Refused))))))
(= (pln-poc:export $input $output)
   (case (library-stack:view (pln-poc:read $input))
     (((Library:StackValue $layers $document $original)
       (let $saved (fs:write $output (syntax:write $document)) (println! (PLN:Exported))))
      ($bad (println! (PLN:Refused))))))
