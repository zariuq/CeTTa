; Application policies are ordinary MeTTa queries on the informing view.
; All accepted edits and receipts use the existing durable collection writer.
!(import! &self (library durable_space))

(: invariants:commit (-> %Undefined% %Undefined% Atom Atom Atom %Undefined%))
(: invariants:decide (-> %Undefined% Atom Atom %Undefined%))
(: invariants:job (-> %Undefined% Atom Atom Atom %Undefined%))
(: invariants:claim (-> %Undefined% Atom Atom Atom %Undefined%))
(: invariants:probe (-> %Undefined% Atom Atom Atom %Undefined%))
(: invariants:remove-program (-> %Undefined% Atom Atom %Undefined%))

(= (invariants:probe $view $collection $pattern $template)
  (durable-space:probe $view $collection $pattern $template 4096))
(= (invariants:commit $owner $view $collection $request $command)
  (let $identity (SpaceInvariantCommandV1 $collection $command)
    (case (knowledge:receipt $view $request $identity (durable-space:wire-limit))
      ((KnowledgeReceiptAbsentV1
        (case (invariants:decide $view $collection $command)
          (((InvariantChangesV1 $changes)
            (durable-space:commit-command $owner $view $collection $request $identity $changes))
           ($failure $failure))))
       ($prior (knowledge:replay-on $owner $view $prior))))))

(= (invariants:decide $view $collection $command)
  (case $command
    (((AddProgramV1 $name)
      (if (knowledge:ground-identity? $name)
        (case (invariants:probe $view $collection (ProgramV1 $name) ())
          ((SpaceProbeAbsentV1 (InvariantChangesV1 ((SpaceInsertV1 0 (ProgramV1 $name)))))
           ((SpaceProbeFoundV1 $value $ids) (InvariantRefusedV1 duplicate-program))
           ($failure $failure)))
        (InvariantRefusedV1 program-identity)))
     ((AddDependencyV1 $source $target)
      (if (and (knowledge:ground-identity? $source) (knowledge:ground-identity? $target))
        (case (invariants:probe $view $collection (, (ProgramV1 $source) (ProgramV1 $target)) ())
          (((SpaceProbeFoundV1 $value $ids)
            (InvariantChangesV1 ((SpaceInsertV1 0 (DependsV1 $source $target)))))
           (SpaceProbeAbsentV1 (InvariantRefusedV1 missing-program))
           ($failure $failure)))
        (InvariantRefusedV1 program-identity)))
     ((RemoveProgramV1 $name)
      (if (knowledge:ground-identity? $name)
        (invariants:remove-program $view $collection $name)
        (InvariantRefusedV1 program-identity)))
     ((EnqueueV1 $job $payload)
      (if (knowledge:ground-identity? $job)
        (invariants:job $view $collection $job $payload)
        (InvariantRefusedV1 job-identity)))
     ((ClaimV1 $job $worker)
      (if (and (knowledge:ground-identity? $job) (knowledge:ground-identity? $worker))
        (invariants:claim $view $collection $job $worker)
        (InvariantRefusedV1 claim-identity)))
     ($other (InvariantRefusedV1 command)))))

(= (invariants:remove-program $view $collection $name)
  (case (invariants:probe $view $collection (ProgramV1 $name) ())
    (((SpaceProbeFoundV1 $value ($reference))
      (case (invariants:probe $view $collection (DependsV1 $name $outgoing) ())
        ((SpaceProbeAbsentV1
          (case (invariants:probe $view $collection (DependsV1 $incoming $name) ())
            ((SpaceProbeAbsentV1 (InvariantChangesV1 ((SpaceDeleteV1 $reference))))
             ((SpaceProbeFoundV1 $ignored $ids) (InvariantRefusedV1 referenced-program))
             ($failure $failure))))
         ((SpaceProbeFoundV1 $ignored $ids) (InvariantRefusedV1 referenced-program))
         ($failure $failure))))
     (SpaceProbeAbsentV1 (InvariantRefusedV1 missing-program))
     ($failure $failure))))

(= (invariants:job $view $collection $job $payload)
  (case (invariants:probe $view $collection (JobV1 $job $state $old) ())
    ((SpaceProbeAbsentV1 (InvariantChangesV1 ((SpaceInsertV1 0 (JobV1 $job QueuedV1 $payload)))))
     ((SpaceProbeFoundV1 $value $ids) (InvariantRefusedV1 duplicate-job))
     ($failure $failure))))
(= (invariants:claim $view $collection $job $worker)
  (case (invariants:probe $view $collection (JobV1 $job QueuedV1 $payload) $payload)
    (((SpaceProbeFoundV1 $value ($reference))
      (InvariantChangesV1 ((SpaceUpdateV1 $reference (JobV1 $job (ClaimedV1 $worker) $value)))))
     (SpaceProbeAbsentV1 (InvariantRefusedV1 not-queued))
     ($failure $failure))))
