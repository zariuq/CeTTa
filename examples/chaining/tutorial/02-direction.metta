!(import! &self pat)
(edge $stored b)
(edge a b)
(edge a b)
!(collapse (match &self (edge a $y) (destination $y)))
!(collapse (pat:match% &self (edge a $y) (destination $y)))
!(collapse (pat:%match &self (edge a b) $row (covered $row)))
!(pat:let% (p $x) (p 2) (+ $x 10))
!(pat:case% (p $u) (((p a) guessed-a) ((p $x) (kept $x))))
!(pat:unify% (pair $x $x) (pair a a) (same $x) different)
!(pat:unify% (pair $x $x) (pair $u $v) (same $x) different)
!(pat:is-instance (f a a) (f $x $x))
!(pat:is-instance (f a b) (f $x $x))
!(pat:is-variant (f $x $y) (f $y $x))
!(pat:is-variant (f $x $x) (f $y $z))
