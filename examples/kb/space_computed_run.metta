!(import! &self "space_computed_curriculum.metta")
!(import! &self (library system))
!(import! &self (library str))
(= (space-computed:argument $value)
  (case (get-metatype $value) ((Symbol (str:symbol->string $value)) ($other $value))))
(= (space-computed:demo $path)
  (case (space-computed:install $path)
    (((KnowledgeCommittedV1 $answer $epoch $revision)
      (ComputedLessonV1 (space-computed:run (Query $path 2 8))))
     ((KnowledgeReplayedV1 $answer)
      (ComputedLessonV1 (space-computed:run (Query $path 2 8))))
     ($failure $failure))))
!(if (system:has-args)
   (space-computed:demo (space-computed:argument (system:arg 0)))
   (ComputedUsage "Supply an existing private store directory."))
