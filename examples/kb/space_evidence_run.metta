!(import! &self "space_evidence_curriculum.metta")
!(import! &self (library system))
(= (space-evidence:argument $value)
  (case (get-metatype $value) ((Symbol (str:symbol->string $value)) ($other $value))))
(= (space-evidence:demo $path)
  (case (space-evidence:install $path)
    (((KnowledgeCommittedV1 $answer $epoch $revision)
      (space-evidence:run (Query $path (space-evidence:revision) 1 32)))
     ((KnowledgeReplayedV1 $answer)
      (space-evidence:run (Query $path (space-evidence:revision) 1 32)))
     ($failure $failure))))
!(if (system:has-args)
   (space-evidence:demo (space-evidence:argument (system:arg 0)))
   (CurriculumUsage "Supply an existing private store directory."))
