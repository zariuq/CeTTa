; Reusable example program. The CLI and value worker call the same entry.
!(import! &self (library kb_query))
!(import! &self (library rel))
!(import! &self "claims_data.metta")
!(import! &self "dependencies_data.metta")

(= (curriculum:edits)
   (collapse (match &self (KbFact $id $relation $fields) (KbPut $id $relation $fields))))
(= (curriculum:install $owner $view)
   (let $edits (curriculum:edits)
     (kb:commit $owner $view (kb:observe-empty $view)
       curriculum-v1 (CurriculumData $edits) CurriculumReady $edits 1048576)))

; Every supporting occurrence and judgement identity survives this join.
; Repeated origins are visible; no numerical evidence revision is implied.
(= (curriculum:claim-origins $claim)
   (KqBind
     (KqScan (KbArgument judgement 0 $claim)
       (KbFact $judgement judgement ($claim $stance $assessment))
       ($judgement $stance $assessment))
     ($judgement $stance $assessment)
     (KqBind
       (KqScan (KbArgument evidence 0 $judgement)
         (KbFact $evidence evidence ($judgement $source)) ($evidence $source))
       ($evidence $source)
       (KqScan (KbRelation source)
         (KbFact $source source ($origin $label))
         (SupportedBy $judgement $evidence $source $origin $stance $assessment)))))
(= (curriculum:optional-evidence)
   (KqOptional
     (KqScan (KbRelation judgement)
       (KbFact $judgement judgement ($claim $stance $assessment)) ($judgement $claim))
     ($judgement $claim)
     (KqScan (KbArgument evidence 0 $judgement)
       (KbFact $evidence evidence ($judgement $source))
       (HasEvidence $judgement $claim $evidence $source))
     (NoEvidence $judgement $claim)))
(= (curriculum:two-hops $program)
   (KqBind
     (KqScan (KbArgument dependency 0 $program)
       (KbFact $first dependency ($program $middle)) ($first $middle))
     ($first $middle)
     (KqScan (KbArgument dependency 0 $middle)
       (KbFact $second dependency ($middle $target))
       (TwoHops $first $second $program $middle $target))))
(= (curriculum:origin (SupportedBy $judgement $evidence $source $origin $stance $assessment)) $origin)
(= (curriculum:origin-counts $rows)
   (OriginCounts (size-atom $rows)
     (size-atom (rel:distinct kb:equal (rel:project curriculum:origin $rows)))))

; This small curriculum explicitly collects its answers. Library pages do not.
; Both limits remain finite, and a stopped example does not claim completion.
(= (curriculum:collect $cursor $remaining $reversed)
   (if (== $remaining 0)
       (let $closed (kbq:close $cursor) CurriculumStopped)
     (case (kbq:page $cursor 2 3)
       (((KqPage $rows (KqMore $next))
         (curriculum:collect $next (- $remaining 1) (list:append (list:reverse $rows) $reversed)))
        ((KqPage $rows (KqPaused $next))
         (curriculum:collect $next (- $remaining 1) (list:append (list:reverse $rows) $reversed)))
        ((KqPage $rows (KqComplete $work))
         (CurriculumRows (list:reverse (list:append (list:reverse $rows) $reversed))))
        ((KqPage $rows (KqFailure $error $work)) (CurriculumFailed $error))
        ($error (let $closed (kbq:close $cursor) (CurriculumFailed $error)))))))
(= (curriculum:query $view $plan)
   (case (kbq:open $view $plan 1048576)
     (((KqCursor $v $state $steps $keys $bytes)
       (curriculum:collect (KqCursor $v $state $steps $keys $bytes) 1000 ()))
      ($error (CurriculumFailed $error)))))
(= (curriculum:answers $owner)
   (case (store:snapshot $owner)
     (((StoreSnapshot $view $epoch $revision)
       (let* (($origins (curriculum:query $view (curriculum:claim-origins claim1)))
              ($optional (curriculum:query $view (curriculum:optional-evidence)))
              ($paths (curriculum:query $view (curriculum:two-hops emit)))
              ($closed (store:close $view)))
         (case ($origins $optional $paths)
           ((((CurriculumRows $a) (CurriculumRows $b) (CurriculumRows $c))
             (CurriculumResult $a (curriculum:origin-counts $a) $b $c))
            ($bad (CurriculumFailed $bad))))))
      ($error (CurriculumFailed $error)))))
(= (curriculum:run $path)
   (case (store:open $path "create")
     (((StoreOpened $owner)
       (let* (($installed
                (case (store:snapshot $owner)
                  (((StoreSnapshot $view $before-epoch $before-revision)
                    (let* (($installation (curriculum:install $owner $view))
                           ($view-closed (store:close $view))) $installation))
                   ($error $error))))
              ($result (case $installed
                (((KnowledgeCommittedV1 CurriculumReady $epoch $revision) (curriculum:answers $owner))
                 ((KnowledgeReplayedV1 CurriculumReady) (curriculum:answers $owner))
                 ($error (CurriculumFailed $error)))))
              ($closed (store:close $owner))) $result))
      ($error (CurriculumFailed $error)))))
