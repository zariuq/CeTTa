; The program/dependency example over captured indexed graph cursors.
!(import! &self "curriculum.metta")
!(import! &self (library kb_graph))

(= (graph-curriculum:collect $cursor $remaining $reversed)
   (if (== $remaining 0)
     (let $closed (kbg:close $cursor) CurriculumStopped)
     (case (kbg:page $cursor 2 3)
       (((KgPage $rows (KgMore $next))
         (graph-curriculum:collect $next (- $remaining 1) (list:append (list:reverse $rows) $reversed)))
        ((KgPage $rows (KgPaused $next))
         (graph-curriculum:collect $next (- $remaining 1) (list:append (list:reverse $rows) $reversed)))
        ((KgPage $rows (KgComplete $work))
         (GraphRows (list:reverse (list:append (list:reverse $rows) $reversed)) $work))
        ((KgPage $rows (KgFailure $error $work)) (CurriculumFailed $error))
        ($bad (let $closed (kbg:close $cursor) (CurriculumFailed $bad)))))))
(= (graph-curriculum:query $view $plan)
   (let $cursor (kbg:open $view $plan 1048576 1000)
     (if (kbg:cursor? $cursor) (graph-curriculum:collect $cursor 1000 ())
         (CurriculumFailed $cursor))))
(= (graph-curriculum:answers $view)
   (let* (($spec (KgRelation dependency 0 1))
          ($neighbours (graph-curriculum:query $view (KgNeighbours $spec emit out)))
          ($incoming (graph-curriculum:query $view (KgNeighbours $spec parse in)))
          ($reachable (graph-curriculum:query $view (KgReach $spec emit out)))
          ($shortest (graph-curriculum:query $view (KgShortest $spec emit lex all out)))
          ($walks (graph-curriculum:query $view (KgPaths $spec parse 1 2 out)))
          ($isolated (graph-curriculum:query $view (KgReach $spec isolated out))))
     (GraphCurriculum $neighbours $incoming $reachable $shortest $walks $isolated)))
(= (graph-curriculum:run $path)
   (case (curriculum:run $path)
     (((CurriculumResult $origins $counts $optional $paths)
       (case (store:open $path "existing")
         (((StoreOpened $owner)
           (let $answer
             (case (store:snapshot $owner)
               (((StoreSnapshot $view $epoch $revision)
                 (let* (($graphs (graph-curriculum:answers $view))
                        ($view-closed (store:close $view))) $graphs))
                ($error (CurriculumFailed $error))))
             (let $owner-closed (store:close $owner) $answer)))
          ($error (CurriculumFailed $error)))))
      ($bad (CurriculumFailed $bad)))))
