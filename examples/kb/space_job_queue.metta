; A local job queue expressed as ordinary Space facts and MeTTa transitions.
; Payloads stay data; this module never dispatches an external action.
!(import! &self "../native_space_query_server.metta")
!(import! &self (library math))

(: jobs:intent (-> Atom %Undefined%))
(: jobs:transition (-> %Undefined% Atom %Undefined%))
(: jobs:decide (-> %Undefined% Atom Number Atom %Undefined%))
(: jobs:changed (-> Atom Atom Number Atom Atom Number Atom Number Atom Atom %Undefined%))
(: jobs:time? (-> Atom Bool))
(= (jobs:time? $value)
  (if (and (== (get-metatype $value) Grounded) (== (get-type $value) Number))
    (not (or (math:isnan $value) (math:isinf $value))) False))
(= (jobs:probe $view $pattern $template)
  (durable-space:probe $view gateway-jobs $pattern $template 4096))
; Receipt ordering is explicit over one job's indexed history. FIFO ready
; and running scans use a separate ordered Int64 projection; inactive jobs
; have a non-integer marker and are outside that cursor's domain.
(QueryPureCallbackV1 jobs:event-less)
(: jobs:event-less (-> Atom Atom Bool))
(= (jobs:event-less
    (SpaceAnswerV1 (GatewayEventV1 $a $left $s $t $d) $refs)
    (SpaceAnswerV1 (GatewayEventV1 $b $right $u $v $e) $more)) (< $left $right))
(= (jobs:events $id)
  (let $maximum (durable-space:wire-limit)
    (KqOrder
      (KqSpace gateway-jobs (GatewayEventV1 $id $sequence $state $at $detail)
        (GatewayEventV1 $id $sequence $state $at $detail)) jobs:event-less $maximum)))
(= (jobs:active $state)
  (let $position (if (== $state queued) 4 5)
    (KqIndexedI64Range gateway-jobs 8 $position (Inclusive 1) NoBound
      (GatewayJobV1 $id $state $sequence $ready $running $effect $fields)
      (GatewayJobV1 $id $state $sequence $ready $running $effect $fields))))
(= (jobs:effect (GatewayFieldsV1 $fp $request $effect $cancel $value $error $outputs $deadline))
  (quote $effect))

(= (jobs:initialize $path $agent)
  (if (and (== (get-type $path) String) (== (get-type $agent) String))
    (case (store:open $path "create")
      (((StoreOpened $owner)
        (let $answer
          (case (store:snapshot $owner)
            (((StoreSnapshot $view $epoch $revision)
              (let* (($created (durable-space:create-indexed $owner $view gateway-jobs gateway-schema-v1
                       ((SpaceIndexV1 2 0) (SpaceIndexV1 3 1) (SpaceIndexV1 8 1)
                        (SpaceRangeIndexV1 8 4) (SpaceRangeIndexV1 8 5) (SpaceIndexV1 6 1))))
                     ($_ (store:close $view)))
                (case $created
                  (((KnowledgeCommittedV1 $value $same $next) (jobs:initialize-owner $owner $agent))
                   ((KnowledgeReplayedV1 $value) (jobs:initialize-owner $owner $agent))
                   ($failure $failure)))))
             ($failure $failure)))
          (let $_ (store:close $owner) $answer)))
       ($failure $failure)))
    (GatewayRefusedV1 configuration)))
(= (jobs:initialize-owner $owner $agent)
  (case (store:snapshot $owner)
    (((StoreSnapshot $view $epoch $revision)
      (let $answer
        (case (jobs:probe $view (GatewayOwnerV1 $stored) $stored)
          ((SpaceProbeAbsentV1
            (durable-space:commit-command $owner $view gateway-jobs gateway-owner-v1 (GatewayOwnerV1 $agent)
              ((SpaceInsertV1 owner (GatewayOwnerV1 $agent))
               (SpaceInsertV1 sequence (GatewaySequenceV1 0)))))
           ((SpaceProbeFoundV1 $stored $ids)
            (if (== $stored $agent) GatewayReadyV1 (GatewayRefusedV1 owner-conflict)))
           ($failure $failure)))
        (let $_ (store:close $view) $answer)))
     ($failure $failure))))

(= (jobs:find $view $id)
  (jobs:probe $view (GatewayJobV1 $id $state $sequence $ready $running $effect $fields)
    (GatewayJobV1 $id $state $sequence $ready $running $effect $fields)))
(= (jobs:first $view $plan)
  (let $cursor (kbq:open-space $view $plan (durable-space:wire-limit))
    (if (kbq:cursor? $cursor)
      (case (kbq:page $cursor 1 4096)
        (((KqPage ($row) (KqMore $next)) (let $_ (kbq:close $next) (GatewayFirstV1 $row)))
         ((KqPage ($row) (KqComplete $work)) (GatewayFirstV1 $row))
         ((KqPage () (KqComplete $work)) GatewayEmptyV1)
         ((KqPage $rows (KqPaused $next)) (let $_ (kbq:close $next) (GatewayRefusedV1 query-incomplete)))
         ((KqPage $rows (KqFailure $error $work)) $error)
         ($failure (let $_ (kbq:close $cursor) $failure)))) $cursor)))
(= (jobs:sequence $view)
  (case (jobs:probe $view (GatewaySequenceV1 $sequence) $sequence)
    (((SpaceProbeFoundV1 $sequence ($reference))
      (if (kb:integer? $sequence) (GatewaySequenceAtV1 $sequence $reference)
        (GatewayRefusedV1 sequence-format)))
     (SpaceProbeAbsentV1 (GatewayRefusedV1 sequence-required))
     ($failure $failure))))

; Return a reply and edits. The original captured view validates every lookup,
; absence and FIFO decision before the batch and its retry receipt publish.
(= (jobs:transition $view $command)
  (if (jobs:valid-command? $command)
   (case (jobs:sequence $view)
    (((GatewaySequenceAtV1 $last $counter)
      (jobs:decide $view $command (+ $last 1) $counter))
     ($failure $failure))) (GatewayRefusedV1 command-format)))
(: jobs:valid-command? (-> Atom Bool))
(= (jobs:valid-command? $command)
  (case $command
    (((GatewaySubmitV1 $id $fp $payload $effect $deadline $now)
      (and (jobs:time? $deadline) (jobs:time? $now)))
     ((GatewayClaimV1 $now) (jobs:time? $now))
     ((GatewayCancelV1 $id $now) (and (== (get-type $id) String) (jobs:time? $now)))
     ((GatewayFinishV1 $id $state $result $error $outputs $now)
      (and (== (get-type $id) String) (jobs:time? $now)))
     ((GatewayRecoverV1 $now) (jobs:time? $now))
     ($bad False))))
(= (jobs:changed $id $state $first $fields $reference $sequence $counter $at $detail $answer)
  (let* (($ready (if (== $state queued) $first GatewayInactiveV1))
         ($running (if (== $state running) $first GatewayInactiveV1))
         ($effect (jobs:effect $fields))
         ($job (GatewayJobV1 $id $state $first $ready $running $effect $fields))
         ($edit (case $reference
           ((GatewayNewV1 (SpaceInsertV1 job $job))
            ($stored (SpaceUpdateV1 $stored $job)))))
         ($event (GatewayEventV1 $id $sequence $state $at $detail)))
    (GatewayPlanV1 $answer
      ((SpaceUpdateV1 $counter (GatewaySequenceV1 $sequence))
       $edit (SpaceInsertV1 event $event)))))

(= (jobs:decide $view $command $sequence $counter)
  (case $command
    (((GatewaySubmitV1 $id $fingerprint $request $effect $deadline $now)
      (if (and (== (get-type $id) String) (and (== (get-type $fingerprint) String)
               (or (== $effect read) (== $effect write))))
        (case (jobs:find $view $id)
          ((SpaceProbeAbsentV1
            (jobs:changed $id queued $sequence
              (GatewayFieldsV1 $fingerprint $request $effect False NoValueV1 NoValueV1 NoValueV1 $deadline)
              GatewayNewV1 $sequence $counter $now (GatewayDetailV1) (GatewaySubmittedV1 $id)))
           ((SpaceProbeFoundV1 (GatewayJobV1 $id $state $first $ready $running $e
                (GatewayFieldsV1 $old $r $e $c $v $err $out $d)) $ids)
            (if (== $old $fingerprint) (GatewayPlanV1 (GatewayExistingV1 $id) ())
              (GatewayRefusedV1 fingerprint-conflict)))
           ($failure $failure))) (GatewayRefusedV1 submit-format)))
     ((GatewayClaimV1 $now)
      (case (jobs:first $view (jobs:active queued))
        (((GatewayFirstV1 (SpaceAnswerV1
             (GatewayJobV1 $id queued $first $ready $running $effect
               (GatewayFieldsV1 $fp $request $effect $cancel $value $error $outputs $deadline)) ($reference)))
          (if (<= $deadline $now)
            (jobs:changed $id expired $first
              (GatewayFieldsV1 $fp $request $effect $cancel $value (SomeValueV1 "deadline-before-dispatch") $outputs $deadline)
              $reference $sequence $counter $now (GatewayDispatchedV1 False) GatewayEmptyV1)
            (jobs:changed $id running $first
              (GatewayFieldsV1 $fp $request $effect $cancel $value $error $outputs $deadline)
              $reference $sequence $counter $now (GatewayAttemptV1 1)
              (GatewayClaimedV1 $id))))
         (GatewayEmptyV1 (GatewayPlanV1 GatewayEmptyV1 ()))
         ($failure $failure))))
     ((GatewayCancelV1 $id $now) (jobs:cancel $view $id $now $sequence $counter))
     ((GatewayFinishV1 $id $state $result $error $outputs $now)
      (jobs:finish $view $id $state $result $error $outputs $now $sequence $counter))
     ((GatewayRecoverV1 $now) (jobs:recover $view $now $sequence $counter))
     ($bad (GatewayRefusedV1 command)))))
(= (jobs:cancel $view $id $now $sequence $counter)
  (case (jobs:find $view $id)
    ((SpaceProbeAbsentV1 (GatewayPlanV1 GatewayEmptyV1 ()))
     ((SpaceProbeFoundV1 (GatewayJobV1 $id $state $first $ready $running $effect
          (GatewayFieldsV1 $fp $request $effect $cancel $value $error $outputs $deadline)) ($reference))
      (case ($state $cancel)
        (((queued $any)
          (jobs:changed $id cancelled $first
            (GatewayFieldsV1 $fp $request $effect True $value $error $outputs $deadline)
            $reference $sequence $counter $now (GatewayDispatchedV1 False) (GatewayCancelledV1 $id)))
         ((running False)
          (jobs:cancel-running $id $first $running $fp $request $effect $value $error $outputs $deadline
            $reference $sequence $counter $now))
         ($other (GatewayPlanV1 (GatewayExistingV1 $id) ())))))
     ($failure $failure))))
(= (jobs:cancel-running $id $first $running $fp $request $effect $value $error $outputs $deadline
     $reference $sequence $counter $now)
  (GatewayPlanV1 (GatewayCancellationRequestedV1 $id)
    ((SpaceUpdateV1 $counter (GatewaySequenceV1 $sequence))
     (SpaceUpdateV1 $reference (GatewayJobV1 $id running $first GatewayInactiveV1 $first $effect
       (GatewayFieldsV1 $fp $request $effect True $value $error $outputs $deadline)))
     (SpaceInsertV1 event (GatewayEventV1 $id $sequence
       cancel-requested $now (GatewayDetailV1))))))
(= (jobs:finish $view $id $state $result $error $outputs $now $sequence $counter)
  (if (or (== $state succeeded) (or (== $state failed) (or (== $state cancelled)
          (or (== $state expired) (== $state uncertain)))))
    (case (jobs:find $view $id)
      (((SpaceProbeFoundV1 (GatewayJobV1 $id running $first $ready $running $effect
           (GatewayFieldsV1 $fp $request $effect $cancel $old $old-error $old-outputs $deadline)) ($reference))
        (let $detail (jobs:error-detail $error)
          (jobs:changed $id $state $first
            (GatewayFieldsV1 $fp $request $effect $cancel $result $error $outputs $deadline)
            $reference $sequence $counter $now $detail (GatewayFinishedV1 $id))))
       ($other (GatewayRefusedV1 not-running))))
    (GatewayRefusedV1 terminal-state)))

(= (jobs:error-detail $error)
  (case $error
    (((SomeValueV1 $text)
      (if (== $text "") (GatewayDetailV1) (GatewayErrorDetailV1 $text)))
     ($none (GatewayDetailV1)))))
(= (jobs:recover $view $now $sequence $counter)
  (let* (($plan (jobs:active running))
         ($cursor (kbq:open-space $view $plan (durable-space:wire-limit))))
    (if (kbq:cursor? $cursor)
      (jobs:recover-loop $cursor $now $sequence $counter 0 ()) $cursor)))
(= (jobs:recover-loop $cursor $now $sequence $counter $count $edits)
  (case (kbq:page $cursor 1 4096)
    (((KqPage ($row) (KqMore $next))
      (jobs:recover-row $next $row $now $sequence $counter $count $edits))
     ((KqPage ($row) (KqComplete $work))
      (jobs:recover-row GatewayRecoveryEndV1 $row $now $sequence $counter $count $edits))
     ((KqPage () (KqComplete $work))
      (jobs:recover-end $sequence $counter $count $edits))
     ((KqPage () (KqPaused $next))
      (jobs:recover-loop $next $now $sequence $counter $count $edits))
     ((KqPage $rows (KqFailure $error $work)) $error)
     ($failure (let $_ (kbq:close $cursor) $failure)))))
(= (jobs:recover-row $next
    (SpaceAnswerV1 (GatewayJobV1 $id running $first $ready $running $effect
      (GatewayFieldsV1 $fp $request $effect $cancel $value $error $outputs $deadline)) ($reference))
    $now $sequence $counter $count $edits)
  (let* (($state (if (== $effect write) uncertain failed))
         ($job (GatewayJobV1 $id $state $first GatewayInactiveV1 GatewayInactiveV1 $effect
           (GatewayFieldsV1 $fp $request $effect $cancel $value (SomeValueV1 "gateway-restarted") $outputs $deadline)))
         ($event (GatewayEventV1 $id $sequence
           $state $now (GatewayErrorDetailV1 "gateway-restarted")))
         ($changes (cons-atom (SpaceUpdateV1 $reference $job)
           (cons-atom (SpaceInsertV1 (recovery $sequence) $event) $edits))))
    (if (== $next GatewayRecoveryEndV1)
      (jobs:recover-end (+ $sequence 1) $counter (+ $count 1) $changes)
      (jobs:recover-loop $next $now (+ $sequence 1) $counter (+ $count 1) $changes))))
(= (jobs:recover-end $sequence $counter $count $edits)
  (GatewayPlanV1 (GatewayRecoveredV1 $count)
    (if (== $count 0) ()
      (cons-atom (SpaceUpdateV1 $counter (GatewaySequenceV1 (- $sequence 1))) $edits))))

; Observation time may change on a retry. It is not a different logical
; command. The first committed outcome and event times remain authoritative.
(= (jobs:intent $command)
  (case $command
    (((GatewaySubmitV1 $id $fp $request $effect $deadline $now) (GatewaySubmitIntentV1 $id $fp))
     ((GatewayClaimV1 $now) GatewayClaimIntentV1)
     ((GatewayCancelV1 $id $now) (GatewayCancelIntentV1 $id))
     ((GatewayFinishV1 $id $state $result $error $outputs $now)
      (GatewayFinishIntentV1 $id $state $result $error $outputs))
     ((GatewayRecoverV1 $now) GatewayRecoverIntentV1)
     ($bad (GatewayRefusedV1 command)))))

(: jobs:commit (-> %Undefined% %Undefined% Atom Atom Atom %Undefined%))
(= (jobs:commit $owner $view $agent $request $command)
  (if (and (== (get-type $agent) String) (== (get-type $request) String))
    (case (store:program-watch-open)
      (((StoreProgramWatch $watch)
        (let $answer
          (case (store:snapshot $owner)
            (((StoreSnapshot $fresh $epoch $revision)
              (let $result (jobs:receipt-or-plan $owner $view $fresh $watch $agent $request $command)
                (let $_ (store:close $fresh) $result)))
             ($failure $failure)))
          (let $_ (store:close $watch) $answer)))
       ($failure $failure))) (GatewayRefusedV1 operation-format)))
(= (jobs:receipt-or-plan $owner $view $fresh $watch $agent $request $command)
  (case (jobs:probe $fresh (GatewayOwnerV1 $stored) $stored)
    (((SpaceProbeFoundV1 $stored $ids)
      (if (== $agent $stored)
        (let* (($intent (jobs:intent $command)) ($identity (GatewayCommandV1 $agent $intent)))
          (case (knowledge:receipt $fresh $request $identity (durable-space:wire-limit))
            ((KnowledgeReceiptAbsentV1
              (case (jobs:transition $view $command)
                (((GatewayPlanV1 $value $changes)
                  (let $all (cons-atom (SpaceInsertV1 outcome (GatewayOutcomeV1 $request $value)) $changes)
                   (case (durable-space:commit-policy $owner $view gateway-jobs $request $identity
                    $all (ProgramWatchV1 $watch))
                    (((KnowledgeCommittedV1 $created $same $next)
                      (GatewayCommittedV1 $value $created $same $next))
                     ($failure $failure)))))
                 ($failure $failure))))
             ((KnowledgeReplayedV1 $created)
              (case (knowledge:replay-on $owner $fresh (KnowledgeReplayedV1 $created))
                (((KnowledgeReplayedV1 $same)
                  (case (jobs:probe $fresh (GatewayOutcomeV1 $request $value) $value)
                    (((SpaceProbeFoundV1 $value $refs) (GatewayReplayedV1 $value $same))
                     (SpaceProbeAbsentV1 (GatewayRefusedV1 outcome-required))
                     ($failure $failure))))
                 ($failure $failure))))
             ($failure $failure)))) (GatewayRefusedV1 owner-conflict)))
     (SpaceProbeAbsentV1 (GatewayRefusedV1 owner-required))
     ($failure $failure))))

; Embedded calls and the service both invoke jobs:commit on the same owner.
(= (jobs:run (Initialize $path $agent)) (jobs:initialize $path $agent))
(= (jobs:run (Apply $path $agent $request $command))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let $result (jobs:commit $owner $view $agent $request $command)
              (let $_ (store:close $view) $result)))
           ($failure $failure)))
        (let $_ (store:close $owner) $answer)))
     ($failure $failure))))
(= (jobs:run (Find $path $id))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let $result (jobs:find $view $id) (let $_ (store:close $view) $result)))
           ($failure $failure)))
        (let $_ (store:close $owner) $answer)))
     ($failure $failure))))

; Read-only inspection uses the same facts as application transitions.
(= (jobs:run (Events $path $id))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($plan (jobs:events $id)) ($cursor (kbq:open-space $view $plan (durable-space:wire-limit)))
                   ($_ (store:close $view)))
              (if (kbq:cursor? $cursor) (jobs:collect $cursor ()) $cursor)))
           ($failure $failure)))
        (let $_ (store:close $owner) $answer)))
     ($failure $failure))))
(= (jobs:collect $cursor $reversed)
  (case (kbq:page $cursor 1 4096)
    (((KqPage $rows (KqMore $next))
      (jobs:collect $next (list:append (list:reverse $rows) $reversed)))
     ((KqPage $rows (KqPaused $next))
      (jobs:collect $next (list:append (list:reverse $rows) $reversed)))
     ((KqPage $rows (KqComplete $work))
      (GatewayEventsV1 (list:reverse (list:append (list:reverse $rows) $reversed)) $work))
     ((KqPage $rows (KqFailure $error $work)) $error)
     ($failure (let $_ (kbq:close $cursor) $failure)))))

; The service exposes controlled writes and ordinary captured reads. There is
; no raw edit or external execution route. Effect labels are trusted inputs
; from the application's dispatcher configuration, not dispatch authority.
(= (jobs:configuration)
  (let* (($path (system:getenv-or-default "CETTA_KB_DIRECTORY" ""))
         ($agent (system:getenv-or-default "CETTA_JOB_AGENT" "example-agent"))
         ($initialized (jobs:initialize $path $agent)))
    (case $initialized
      (((KnowledgeCommittedV1 $value $epoch $revision) (jobs:configuration-open $path $agent))
       ((KnowledgeReplayedV1 $value) (jobs:configuration-open $path $agent))
       (GatewayReadyV1 (jobs:configuration-open $path $agent))
       ($failure $failure)))))
(= (jobs:configuration-open $path $agent)
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (ValueServiceV1 (system:getenv-or-default "CETTA_KB_SOCKET" "")
        (GatewayConfigurationV1 $owner $agent)
        ((ServiceRouteV1 Snapshot Read jobs:server-snapshot)
         (ServiceRouteV1 Apply Write jobs:server-apply)
         (ServiceRouteV1 Find Read jobs:server-find)
         (ServiceRouteV1 EventsOpen Read jobs:server-events)
         (ServiceRouteV1 RelPage Read query-server:page)
         (ServiceRouteV1 RelCancel Read query-server:cancel)
         (ServiceRouteV1 Resolve Read jobs:server-resolve)
         (ServiceRouteV1 Compact Write jobs:server-compact))
        (ServiceLimitsV1 16 64 1048576 30000 67108864 1000000)))
     ($failure $failure))))
(= (jobs:server-snapshot (ServiceCallV1 (GatewayConfigurationV1 $owner $agent) $peer $unused $arguments))
  (kb-server:snapshot (ServiceCallV1 (KbConfigurationV1 $owner) $peer $unused $arguments)))
(= (jobs:server-apply (ServiceCallV1 (GatewayConfigurationV1 $owner $agent) $peer $view $arguments))
  (case $arguments
    (((GatewayApplyV1 $request $command) (jobs:commit $owner $view $agent $request $command))
     ($bad (GatewayRefusedV1 apply-format)))))
(= (jobs:server-find (ServiceCallV1 $configuration $peer $view $id))
  (if (== (get-type $id) String) (jobs:find $view $id) (GatewayRefusedV1 job-identity)))
(= (jobs:server-events (ServiceCallV1 $configuration $peer $view $id))
  (if (== (get-type $id) String)
    (let* (($plan (jobs:events $id)) ($cursor (kbq:open-space $view $plan (durable-space:wire-limit))))
      (if (kbq:cursor? $cursor) (ServiceKeepValueV1 $cursor GatewayEventsOpenedV1) $cursor))
    (GatewayRefusedV1 job-identity)))
(= (jobs:server-resolve (ServiceCallV1 (GatewayConfigurationV1 $owner $agent) $peer $view $arguments))
  (case $arguments
    (((GatewayResolveV1 $request $command)
      (let* (($intent (jobs:intent $command)) ($identity (GatewayCommandV1 $agent $intent)))
        (case (knowledge:receipt $view $request $identity (durable-space:wire-limit))
          ((KnowledgeReceiptAbsentV1 GatewayUnresolvedV1)
           ((KnowledgeReplayedV1 $created)
            (case (jobs:probe $view (GatewayOutcomeV1 $request $value) $value)
              (((SpaceProbeFoundV1 $value $references) (GatewayResolvedV1 $value $references))
               (SpaceProbeAbsentV1 (GatewayRefusedV1 outcome-required))
               ($failure $failure))))
           ($failure $failure)))))
     ($bad (GatewayRefusedV1 resolve-format)))))
(= (jobs:server-compact (ServiceCallV1 (GatewayConfigurationV1 $owner $agent) $peer $unused $arguments))
  (store:compact $owner))

(= (jobs:run (Inspect $path $id))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($job (jobs:find $view $id)) ($plan (jobs:events $id))
                   ($cursor (kbq:open-space $view $plan (durable-space:wire-limit)))
                   ($_ (store:close $view)))
              (if (kbq:cursor? $cursor)
                (GatewayInspectionV1 $job (jobs:collect $cursor ())) $cursor)))
           ($failure $failure)))
        (let $_ (store:close $owner) $answer)))
     ($failure $failure))))
