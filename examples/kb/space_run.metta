!(import! &self "space_curriculum.metta")
!(import! &self (library system))
(= (space-curriculum:argument $value)
  (case (get-metatype $value) ((Symbol (str:symbol->string $value)) ($other $value))))
(= (space-curriculum:demo $path)
  (case (space-curriculum:install $path)
    (((KnowledgeCommittedV1 $answer $epoch $revision) (space-curriculum:lessons $path))
     ((KnowledgeReplayedV1 $answer) (space-curriculum:lessons $path))
     ($failure $failure))))
(= (space-curriculum:lessons $path)
  (let* ((($head $plans) (decons-atom (space-curriculum:plans)))
         ($answers (map-atom $plans $plan (space-curriculum:run (Query $path $plan 2 3)))))
    (SpaceCurriculumV1 $answers)))
!(if (system:has-args)
   (space-curriculum:demo (space-curriculum:argument (system:arg 0)))
   (CurriculumUsage "Supply an existing private store directory."))
