; One-account native database service. Configuration selects the source;
; request values are inert data and never select server filesystem paths.
!(import! &self (library db))
!(import! &self (library system))

(= (db-server:configuration)
  (let* (($path (system:getenv-or-default "CETTA_DB_SOURCE" ""))
         ($socket (system:getenv-or-default "CETTA_DB_SOCKET" ""))
         ($owner (db:open $path))
         ($incarnation (system:uuid4-hex))
         ($data (db-server:configuration-data $owner $incarnation))
         ($frame (store:value-byte-limit)))
    (ValueServiceV1 $socket $data
      ((ServiceRouteV1 DbCapabilities Read db-server:capabilities)
       (ServiceRouteV1 DbCapture Read db-server:capture)
       (ServiceRouteV1 DbCandidates Read db-server:candidates)
       (ServiceRouteV1 DbScan Read db-server:scan)
       (ServiceRouteV1 DbCandidateNext Read db-server:next)
       (ServiceRouteV1 DbCandidateRead Read db-server:read)
       (ServiceRouteV1 DbCandidateClone Read db-server:clone)
       (ServiceRouteV1 DbCandidateCancel Read db-server:cancel)
       (ServiceRouteV1 DbPublish Write db-server:publish)
       (ServiceRouteV1 DbResolve Read db-server:resolve)
       (ServiceRouteV1 DbEnsure Write db-server:ensure)
       (ServiceRouteV1 DbInfo Read db-server:info))
      (ServiceLimitsV1 64 1024 $frame 30000 268435456 1000000))))
(= (db-server:configuration-data $owner $incarnation)
  (case $owner
    (((db:readonly $space) (DbConfigurationV1 $owner (ActOwnerV1 $incarnation) $incarnation act))
     ((Error $where $why) (Error $where $why))
     ($directory
      (let* (((StoreSnapshot $view $epoch $_) (store:snapshot $owner))
             ($_ (store:close $view)))
        (DbConfigurationV1 $owner $epoch $incarnation directory))))))
(= (db-server:capabilities (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation $kind) (ServicePeerV1 $uid $rights) $unused $arguments))
  (let* (($access (if (and (== $kind directory) (== $rights ReadWrite)) ReadWrite ReadOnly))
         ($limit (store:value-byte-limit)))
    (DbCapabilitiesV1 $identity $incarnation $kind $access $limit)))

(= (db-server:capture (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation directory) $peer $unused (DbCaptureV1 $collection)))
  (case (store:snapshot $owner)
    (((StoreSnapshot $view $epoch $revision)
      (let* (((KnowledgeAddressV1 $key) (durable-space:metadata $collection))
             ($captured (store:source-open-view $view $key))
             ($_ (store:close $view)))
        (db-server:captured $captured $identity $incarnation $revision $collection directory)))
     ($failure $failure))))
(= (db-server:capture (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation act) $peer $unused (DbCaptureV1 $collection)))
  (if (== $collection data)
    (let* (($space (db:snapshot $owner))
           ($captured (store:source-open $space))
           ($_ (db:close $space)))
      (db-server:captured $captured $identity $incarnation 0 $collection act))
    (DbRefusedV1 collection-absent)))
(= (db-server:captured $captured $owner $incarnation $revision $collection $kind)
  (case $captured
    (((StoreSourceOpened $source $count $limit)
      (ServiceKeepV1 $source (DbCapturedV1 $owner $incarnation $revision $collection $count $limit $kind)))
     ($failure $failure))))
(= (db-server:candidates (ServiceCallV1 $configuration $peer $source (DbCandidatesV1 $pattern)))
  (case (store:source-candidates $source $pattern)
    (((StoreCandidateOpened $cursor $sequence) (ServiceKeepV1 $cursor (DbCandidateOpenedV1 $sequence)))
     ($failure $failure))))
(= (db-server:scan (ServiceCallV1 $configuration $peer $source $unused))
  (case (store:source-scan $source)
    (((StoreCandidateOpened $cursor $sequence) (ServiceKeepV1 $cursor (DbCandidateOpenedV1 $sequence)))
     ($failure $failure))))
(= (db-server:next (ServiceCallV1 $configuration $peer $cursor (DbCandidateNextV1 $sequence $work)))
  (store:candidate-next $cursor $sequence $work))
(= (db-server:read (ServiceCallV1 $configuration $peer $cursor (DbCandidateReadV1 $sequence $part $offset $maximum)))
  (store:candidate-read $cursor $sequence $part $offset $maximum))
(= (db-server:clone (ServiceCallV1 $configuration $peer $cursor (DbCandidateCloneV1 $mode)))
  (case (store:candidate-clone $cursor $mode)
    (((StoreCandidateOpened $copy $sequence) (ServiceKeepV1 $copy (DbCandidateOpenedV1 $sequence)))
     ($failure $failure))))
(= (db-server:cancel (ServiceCallV1 $configuration $peer $cursor $unused)) (store:candidate-cancel $cursor))

; Freshness requirements belong to validators. The initial service validates
; this owner at publication and refuses foreign current requirements. Declared
; historical inputs carry no freshness assertion or publication permission.
(= (db-server:dependencies? $owner $incarnation $revision $collection $requirements)
  (if (== (get-metatype $requirements) Expression)
    (if (== $requirements ()) True
      (let ($first $rest) (decons-atom $requirements)
        (and (db-server:dependency? $owner $incarnation $revision $collection $first)
          (db-server:dependencies? $owner $incarnation $revision $collection $rest)))) False))
(= (db-server:dependency? $owner $incarnation $revision $collection $requirement)
  (case $requirement
    (((DbHistoricalV1 $foreign $generation $observed $scope) True)
     ((DbFreshV1 $expected-owner $expected-incarnation $expected-revision $scope)
      (and (and (== $owner $expected-owner) (== $incarnation $expected-incarnation))
        (and (== $revision $expected-revision)
          (or (== $scope DbWholeV1) (== $scope (DbCollectionV1 $collection))))))
     ($unknown False))))
(= (db-server:publish (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation $kind) $peer $source
    (DbPublishV1 $collection $request $operation $changes $values $requirements)))
  (if (== $kind directory)
    (case (store:source-context $source)
      (((StoreSourceContextV1 $epoch $revision $metadata)
        (let (KnowledgeAddressV1 $key) (durable-space:metadata $collection)
          (if (and (and (== $epoch $identity) (== $metadata $key))
                   (db-server:dependencies? $identity $incarnation $revision $collection $requirements))
            (db-server:publish-source $owner $source $collection $request $operation $changes $values)
            (DbRefusedV1 dependency-owner-or-scope))))
       ($failure (DbRefusedV1 publication-view-required))))
    (DbRefusedV1 read-only)))
(= (db-server:publish-source $owner $source $collection $request $operation $changes $values)
  (case (store:source-view $source)
    (((StoreSnapshot $view $_ $_)
      (case (store:program-watch-open)
        (((StoreProgramWatch $watch)
          (let* (($result (durable-space:commit-policy-result $owner $view $collection $request
                           (DbTransactionV1 $collection $operation) $changes (ProgramWatchV1 $watch) (DbTransactionValuesV1 $values)))
                 ($_ (store:close $watch)) ($_ (store:close $view))) $result))
         ($failure (let $_ (store:close $view) $failure)))))
     ($failure $failure))))
(= (db-server:resolve (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation $kind) $peer $unused
    (DbResolveV1 $collection $request $operation)))
  (if (== $kind directory) (db:resolve $owner $collection $request $operation) (DbRefusedV1 receipt-domain-required)))
(= (db-server:ensure (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation $kind) $peer $unused
    (DbEnsureV1 $collection $indexes)))
  (if (== $kind directory) (db:ensure $owner $collection $indexes) (DbRefusedV1 read-only)))
(= (db-server:info (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation $kind) $peer $unused $arguments))
  (db:info $owner))
