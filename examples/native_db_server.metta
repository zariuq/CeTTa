; One-account native database service. Configuration selects the source;
; request values are inert data and never select server filesystem paths.
!(import! &self (library db))
!(import! &self (library system))

(= (db-server:configuration)
  (let* (($path (system:getenv-or-default "CETTA_DB_SOURCE" ""))
         ($socket (system:getenv-or-default "CETTA_DB_SOCKET" ""))
         ($owner (db:open $path))
         ($incarnation (system:uuid4-hex))
         ($artifacts (act:artifact-root $socket))
         ($data (db-server:configuration-data $owner $incarnation $artifacts))
         ($frame (store:value-byte-limit))
         ($memory (str:string->number (system:getenv-or-default "CETTA_DB_MAINTENANCE_MEMORY" "33554432")))
         ($work (str:string->number (system:getenv-or-default "CETTA_DB_MAINTENANCE_WORK" "65536"))))
    (ValueServiceV2 $socket $data
      ((ServiceRouteV1 DbCapabilities Read db-server:capabilities)
       (ServiceRouteV1 DbProtocolInfo Read db-server:protocol)
       (ServiceRouteV1 DbCapture Read db-server:capture)
       (ServiceRouteV1 DbCaptureRelated Read db-server:related)
       (ServiceRouteV1 DbCandidates Read db-server:candidates)
       (ServiceRouteV1 DbScan Read db-server:scan)
       (ServiceRouteV1 DbCandidateNext Read db-server:next)
       (ServiceRouteV1 DbCandidateStep Read db-server:step)
       (ServiceRouteV1 DbCandidateRead Read db-server:read)
       (ServiceRouteV1 DbCandidateClone Read db-server:clone)
       (ServiceRouteV1 DbCandidateCancel Read db-server:cancel)
       (ServiceRouteV1 DbPublish Write db-server:publish)
       (ServiceRouteV1 DbResolve Read db-server:resolve)
       (ServiceRouteV1 DbEnsure Write db-server:ensure)
       (ServiceRouteV1 DbInfo Read db-server:info)
       (ServiceRouteV1 DbCompactOpen Write db-server:compact-open)
       (ServiceRouteV1 DbCompactStep Write db-server:compact-step)
       (ServiceRouteV1 DbCompactInfo Read db-server:compact-info)
       (ServiceRouteV1 DbCompactCancel Write db-server:compact-cancel)
       (ServiceRouteV1 DbTransferInfo Read db-server:transfer-info)
       (ServiceRouteV1 DbExportOpen Read db-server:export-open)
       (ServiceRouteV1 DbUploadOpen Write db-server:upload-open)
       (ServiceRouteV1 DbArtifactWrite Write db-server:artifact-write)
       (ServiceRouteV1 DbArtifactStep Read db-server:artifact-step)
       (ServiceRouteV1 DbArtifactInfo Read db-server:artifact-info)
       (ServiceRouteV1 DbArtifactRead Read db-server:artifact-read)
       (ServiceRouteV1 DbArtifactCancel Read db-server:artifact-cancel)
       (ServiceRouteV1 DbImportOpen Write db-server:import-open)
       (ServiceRouteV1 DbImportNext Write db-server:import-next)
       (ServiceRouteV1 DbImportFinish Write db-server:import-finish)
       (ServiceRouteV1 DbImportCancel Write db-server:import-cancel)
       (ServiceRouteV1 DbRangeOpen Read db-server:range-open)
       (ServiceRouteV1 DbRangeNext Read db-server:range-next)
       (ServiceRouteV1 DbRangeRead Read db-server:range-read)
       (ServiceRouteV1 DbRangeCancel Read db-server:range-cancel))
      (ServiceLimitsV2 64 1024 $frame 30000 268435456 1000000 0)
      (ServiceMaintenanceV1 db-server:maintenance (DbMaintenanceIdleV1 $memory True) $work))))
(= (db-server:configuration-data $owner $incarnation $artifacts)
  (case $owner
    (((db:readonly $space) (DbConfigurationV1 $owner (ActOwnerV1 $incarnation) $incarnation act $artifacts))
     ((Error $where $why) (Error $where $why))
     ($directory
      (let* (((StoreSnapshot $view $epoch $_) (store:snapshot $owner))
             ((StoreDomainV1 $domain) (store:view-domain $view))
             ($_ (store:close $view)))
        (DbConfigurationV1 $owner (DbOwnerV1 $epoch $domain) $incarnation directory $artifacts))))))
(= (db-server:capabilities (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation $kind $artifacts) (ServicePeerV1 $uid $rights) $unused $arguments))
  (let* (($access (if (and (== $kind directory) (== $rights ReadWrite)) ReadWrite ReadOnly))
         ($limit (store:value-byte-limit)))
    (DbCapabilitiesV1 $identity $incarnation $kind $access $limit)))
(= (db-server:protocol $call)
  (DbProtocolV1 1 (OriginalFactsV1 ImmutablePositionsV1 LinearContinuationsV1
    PrivateArtifactsV1 StoredScalarRangesV1 ServiceMaintenanceV1 FactLocalVariablesV1 PhysicalDomainsV1 RetainedSessionsV1)))
(= (db-server:owner-epoch (DbOwnerV1 $epoch $domain)) $epoch)

(= (db-server:capture (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation directory $artifacts) $peer $unused (DbCaptureV1 $collection)))
  (case (store:snapshot $owner)
    (((StoreSnapshot $view $epoch $revision)
      (let* (((KnowledgeAddressV1 $key) (durable-space:metadata $collection))
             ($captured (store:source-open-view $view $key))
             ($_ (store:close $view)))
        (db-server:captured $captured $identity $incarnation $revision $collection directory)))
     ($failure $failure))))
(= (db-server:capture (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation act $artifacts) $peer $unused (DbCaptureV1 $collection)))
  (if (== $collection data)
    (let* (($space (db:snapshot $owner))
           ($captured (store:source-open $space))
           ($_ (db:close $space)))
      (db-server:captured $captured $identity $incarnation 0 $collection act))
    (DbRefusedV1 collection-absent)))
(= (db-server:captured $captured $owner $incarnation $revision $collection $kind)
  (case $captured
    (((StoreSourceOpened $source $count $limit)
      (ServiceKeepV1 $source (DbCapturedV1 $owner $incarnation $revision $collection $count $limit $kind)))
     ($failure $failure))))
(= (db-server:related (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation directory $artifacts) $peer $source (DbCaptureV1 $collection)))
  (case (store:source-view $source)
    (((StoreSnapshot $view $epoch $revision)
      (let* (((KnowledgeAddressV1 $key) (durable-space:metadata $collection))
             ($captured (store:source-open-view $view $key))
             ($_ (store:close $view)))
        (db-server:captured $captured $identity $incarnation $revision $collection directory)))
     ($failure $failure))))
(= (db-server:related (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation act $artifacts) $peer $source (DbCaptureV1 $collection)))
  (if (== $collection data)
    (let* (($space (store:source-space $source))
           ($captured (store:source-open $space))
           ($_ (db:close $space)))
      (db-server:captured $captured $identity $incarnation 0 data act))
    (DbRefusedV1 collection-absent)))
(= (db-server:candidates (ServiceCallV1 $configuration $peer $source (DbCandidatesV1 $pattern)))
  (case (store:source-candidates $source $pattern)
    (((StoreCandidateOpened $cursor $sequence) (ServiceKeepV1 $cursor (DbCandidateOpenedV1 $sequence)))
     ($failure $failure))))
(= (db-server:scan (ServiceCallV1 $configuration $peer $source $unused))
  (case (store:source-scan $source)
    (((StoreCandidateOpened $cursor $sequence) (ServiceKeepV1 $cursor (DbCandidateOpenedV1 $sequence)))
     ($failure $failure))))
(= (db-server:next (ServiceCallV1 $configuration $peer $cursor (DbCandidateNextV1 $sequence $work)))
  (store:candidate-next $cursor $sequence $work))
(= (db-server:read (ServiceCallV1 $configuration $peer $cursor (DbCandidateReadV1 $sequence $part $offset $maximum)))
  (store:candidate-read $cursor $sequence $part $offset $maximum))
(= (db-server:clone (ServiceCallV1 $configuration $peer $cursor (DbCandidateCloneV1 $mode)))
  (case (store:candidate-clone $cursor $mode)
    (((StoreCandidateOpened $copy $sequence) (ServiceKeepV1 $copy (DbCandidateOpenedV1 $sequence)))
     ($failure $failure))))
(= (db-server:cancel (ServiceCallV1 $configuration $peer $cursor $unused)) (store:candidate-cancel $cursor))

; Freshness requirements belong to validators. The initial service validates
; this owner at publication and refuses foreign current requirements. Declared
; historical inputs carry no freshness assertion or publication permission.
(= (db-server:dependencies? $owner $incarnation $revision $collection $requirements)
  (if (== (get-metatype $requirements) Expression)
    (if (== $requirements ()) True
      (let ($first $rest) (decons-atom $requirements)
        (and (db-server:dependency? $owner $incarnation $revision $collection $first)
          (db-server:dependencies? $owner $incarnation $revision $collection $rest)))) False))
(= (db-server:dependency? $owner $incarnation $revision $collection $requirement)
  (case $requirement
    (((DbHistoricalV1 $foreign $generation $observed $scope) True)
     ((DbFreshV1 $expected-owner $expected-incarnation $expected-revision $scope)
      (and (and (== $owner $expected-owner) (== $incarnation $expected-incarnation))
        (and (== $revision $expected-revision)
          (db-server:scope? $scope))))
     ($unknown False))))
(= (db-server:scope? $scope)
  (case $scope
    ((DbWholeV1 True) ((DbCollectionV1 $observed-collection) True) ($unknown False))))
(= (db-server:publish (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation $kind $artifacts) $peer $source
    (DbPublishV1 $collection $request $operation $changes $values $requirements)))
  (if (== $kind directory)
    (case (store:source-context $source)
      (((StoreSourceContextV1 $epoch $revision $metadata)
        (let (KnowledgeAddressV1 $key) (durable-space:metadata $collection)
          (if (and (and (== $epoch (db-server:owner-epoch $identity)) (== $metadata $key))
                   (db-server:dependencies? $identity $incarnation $revision $collection $requirements))
            (db-server:publish-source $owner $source $collection $request $operation $changes $values)
            (DbRefusedV1 dependency-owner-or-scope))))
       ($failure (DbRefusedV1 publication-view-required))))
    (DbRefusedV1 read-only)))
(= (db-server:publish-source $owner $source $collection $request $operation $changes $values)
  (case (store:source-view $source)
    (((StoreSnapshot $view $_ $_)
      (case (store:program-watch-open)
        (((StoreProgramWatch $watch)
          (let* (($result (durable-space:commit-policy-result $owner $view $collection $request
                           (DbTransactionV1 $collection $operation) $changes (ProgramWatchV1 $watch) (DbTransactionValuesV1 $values)))
                 ($_ (store:close $watch)) ($_ (store:close $view))) $result))
         ($failure (let $_ (store:close $view) $failure)))))
     ($failure $failure))))
(= (db-server:resolve (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation $kind $artifacts) $peer $unused
    (DbResolveV1 $collection $request $operation)))
  (if (== $kind directory) (db-server:result (catch (db:resolve $owner $collection $request $operation))) (DbRefusedV1 receipt-domain-required)))
(= (db-server:ensure (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation $kind $artifacts) $peer $unused
    (DbEnsureV1 $collection $indexes)))
  (if (== $kind directory) (db-server:result (catch (db:ensure $owner $collection $indexes))) (DbRefusedV1 read-only)))
(= (db-server:info (ServiceCallV1 (DbConfigurationV1 $owner $identity $incarnation $kind $artifacts) $peer $unused $arguments))
  (db:info $owner))

; A position is immutable for this route. Retained readers and pending client
; clones can share it while a successor advances the native copy.
(= (db-server:step (ServiceCallV1 $configuration $peer $cursor (DbCandidateNextV1 $sequence $work)))
  (case (store:candidate-clone $cursor current)
    (((StoreCandidateOpened $copy $_)
      (let $answer (store:candidate-next $copy $sequence $work)
        (case $answer
          (((StoreCandidateRow $same $body $identity)
            (ServiceKeepV1 $copy (DbCandidateSteppedV1 $answer)))
           (StoreCandidatePaused (ServiceKeepV1 $copy (DbCandidateSteppedV1 StoreCandidatePaused)))
           ($terminal (let $_ (store:close $copy) (DbCandidateStoppedV1 $terminal)))))))
     ($failure (DbCandidateStoppedV1 $failure)))))

; Expected database refusals are portable data; handler faults stay faults.
(= (db-server:result $result)
  (case $result (((Error $where $reason) (DbErrorV1 $reason)) ($value $value))))

(= (db-server:compact-open (ServiceCallV1 (DbConfigurationV1 $owner $_ $_ $kind $artifacts) $peer $unused (DbCompactOpenV1 $memory)))
  (if (== $kind directory)
    (case (store:compact-act-open $owner $memory)
      (((StoreCompactionOpened $job $info) (ServiceKeepV1 $job $info))
       ($failure $failure)))
    (DbRefusedV1 read-only)))
(= (db-server:compact-step (ServiceCallV1 (DbConfigurationV1 $owner $_ $_ $kind $artifacts) $peer $job (DbCompactStepV1 $work)))
  (case (store:compact-act-step $job $work)
    (((StoreSnapshot $view $_ $_)
      (let* (($_ (store:close $view)) ($info (store:compact-act-info $job))
             ($_ (store:collect $owner)))
        (DbCompactionDoneV1 $info)))
     ($more $more))))
(= (db-server:compact-info (ServiceCallV1 $configuration $peer $job $unused))
  (store:compact-act-info $job))
(= (db-server:compact-cancel (ServiceCallV1 $configuration $peer $job $unused))
  (ServiceReleaseV1 DbCompactionCancelledV1))

; Artifacts are private native file resources. No request selects a server path.
(= (db-server:transfer-info $call)
  (let $chunk (act:artifact-chunk-size) (DbTransferV1 $chunk 33554432)))
(= (db-server:artifact-kept $artifact)
  (case $artifact
    (((Error $where $why) (DbErrorV1 $why))
     ($handle (ServiceKeepV1 $handle (act:artifact-info $handle))))))
(= (db-server:export-open (ServiceCallV1
     (DbConfigurationV1 $owner $_ $_ $_ $artifacts) $peer $unused (DbExportOpenV1 $collection $memory)))
  (case (db:snapshot $owner $collection)
    (((Error $where $why) (DbErrorV1 $why))
     ($space
      (let* (($artifact (act:artifact-export $artifacts $space $memory))
             ($_ (db:close $space))) (db-server:artifact-kept $artifact))))))
(= (db-server:upload-open (ServiceCallV1
     (DbConfigurationV1 $_ $_ $_ $_ $artifacts) $peer $unused (DbUploadOpenV1 $size $digest)))
  (db-server:artifact-kept (act:artifact-upload $artifacts $size $digest)))
(= (db-server:artifact-write (ServiceCallV1 $configuration $peer $artifact (DbArtifactWriteV1 $offset $bytes)))
  (db-server:result (act:artifact-write $artifact $offset $bytes)))
(= (db-server:artifact-step (ServiceCallV1 $configuration $peer $artifact (DbArtifactStepV1 $work)))
  (db-server:result (act:artifact-step $artifact $work)))
(= (db-server:artifact-info (ServiceCallV1 $configuration $peer $artifact $unused))
  (db-server:result (act:artifact-info $artifact)))
(= (db-server:artifact-read (ServiceCallV1 $configuration $peer $artifact (DbArtifactReadV1 $offset $maximum)))
  (db-server:result (act:artifact-read $artifact $offset $maximum)))
(= (db-server:artifact-cancel (ServiceCallV1 $configuration $peer $artifact $unused))
  (ServiceReleaseV1 DbArtifactCancelledV1))

; The host moves each append continuation exactly once. Its native spool owns
; the input and destination view; closing the upload cannot invalidate it.
(= (db-server:import-open (ServiceCallV1
     (DbConfigurationV1 $owner $_ $_ $kind $artifacts) $peer $artifact
     (DbImportOpenV1 $collection $request $operation)))
  (if (== $kind directory)
   (case (act:artifact-space $artifact)
    (((Error $where $why) (DbErrorV1 $why))
     ($source
      (let* (($result (db-server:import-source $owner $collection $request $operation $source))
             ($_ (act:close! $source))) $result))))
   (DbRefusedV1 read-only)))
(= (db-server:import-source $owner $collection $request $operation $source)
  (case (act:info $source)
    (((ActSnapshotInfo $profile $count $bytes $digest $maximum)
      (let $command (DbTransactionV1 $collection (DbImportV1 $operation $profile $digest))
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $_ $_)
            (let* (($opened (durable-space:append-open $owner $view $collection $request $command $source 9223372036854775807))
                   ($_ (store:close $view)))
              (case $opened
                (((SpaceAppendOpenedV1 $state) (db-server:import-kept $state $command False))
                 ($prior (DbImportPriorV1 $prior))))))
           ($failure $failure)))))
     ($failure $failure))))
(= (db-server:import-kept $state $command $ready)
  (ServiceKeepValueV1 (DbImportStateV1 $state $command)
    (DbLinearV1 (DbImportProgressV1 $ready $command (durable-space:append-info $state)))))
(= (db-server:import-next (ServiceCallV1 $configuration $peer
     (DbImportStateV1 $state $command) (DbImportNextV1 $work)))
  (if (and (== (get-type $work) Number) (>= $work 0))
    (db-server:import-advance $state $command $work)
    (let $_ (durable-space:append-close $state) (DbErrorV1 import-work))))
(= (db-server:import-advance $state $command $work)
  (if (== $work 0) (db-server:import-kept $state $command False)
    (case (durable-space:append-next $state)
      (((SpaceAppendMoreV1 $next) (db-server:import-advance $next $command (- $work 1)))
       ((SpaceAppendReadyV1 $next) (db-server:import-kept $next $command True))
       ($failure $failure)))))
(= (db-server:import-finish (ServiceCallV1 $configuration $peer
     (DbImportStateV1 $state $command) $unused))
  (durable-space:append-finish $state))
(= (db-server:import-cancel (ServiceCallV1 $configuration $peer
     (DbImportStateV1 $state $command) $unused))
  (let $_ (durable-space:append-close $state) DbImportCancelledV1))

; Maintenance has its own retained state and work clock. A failed attempt
; leaves user receipts intact and can be retried after another write.
(= (db-server:maintenance
     (ServiceMaintenanceCallV1 (DbConfigurationV1 $owner $_ $_ $kind $artifacts)
       (DbMaintenanceIdleV1 $memory $resume) $work))
  (if (== $kind directory)
    (db-server:maintenance-check $owner $memory $resume)
    (ServiceMaintenanceIdleV1 (DbMaintenanceIdleV1 $memory False) DbMaintenanceReadOnlyV1)))
(= (db-server:maintenance-check $owner $memory $resume)
  (case (store:snapshot $owner)
    (((StoreSnapshot $view $_ $_)
      (let* (($info (store:storage-info $view)) ($_ (store:close $view)))
        (db-server:maintenance-storage $owner $memory $resume $info)))
     ($failure (db-server:maintenance-failed $memory $failure)))))
(= (db-server:maintenance-storage $owner $memory $resume $info)
  (case $info
    (((StoreStorageInfo $format $epoch $revision $base $delta $frozen $has-base $has-frozen)
      (if (and (== $format 3) (or (and $has-frozen $resume) (>= $delta (max 8388608 (/ $base 4)))))
        (db-server:maintenance-open $owner $memory)
        (ServiceMaintenanceIdleV1 (DbMaintenanceIdleV1 $memory False) $info)))
     ($failure (db-server:maintenance-failed $memory $failure)))))
(= (db-server:maintenance-open $owner $memory)
  (case (store:compact-act-open $owner $memory)
    (((StoreCompactionOpened $job $info)
      (ServiceMaintenanceMoreV1 (DbMaintenanceActiveV1 $memory $job) $info))
     ((StoreRefused busy)
      (ServiceMaintenanceIdleV1 (DbMaintenanceIdleV1 $memory False) (DbMaintenanceDeferredV1 busy)))
     ($failure (db-server:maintenance-failed $memory $failure)))))
(= (db-server:maintenance
     (ServiceMaintenanceCallV1 (DbConfigurationV1 $owner $_ $_ $kind $artifacts)
       (DbMaintenanceActiveV1 $memory $job) $work))
  (case (store:compact-act-step $job $work)
    (((StoreCompactionMore $info)
      (ServiceMaintenanceMoreV1 (DbMaintenanceActiveV1 $memory $job) $info))
     ((StoreSnapshot $view $_ $_)
      (let* (($_ (store:close $view)) ($info (store:compact-act-info $job))
             ($_ (store:close $job)) ($_ (store:collect $owner)))
        (ServiceMaintenanceMoreV1 (DbMaintenanceIdleV1 $memory False) $info)))
     ($failure
      (let $_ (store:close $job) (db-server:maintenance-failed $memory $failure))))))
(= (db-server:maintenance-failed $memory $failure)
  (ServiceMaintenanceStoppedV1 (DbMaintenanceIdleV1 $memory True) (DbMaintenanceFailedV1 $failure)))

; Range traversal selects original stored scalars; it never receives the
; client's matching pattern or projection.
(= (db-server:range-open (ServiceCallV1 (DbConfigurationV1 $owner $_ $_ $kind $artifacts) $peer $source
     (DbRangeOpenV1 $collection $arity $position $lower $upper $ordered)))
  (if (not (== (get-type $ordered) Bool)) (DbRefusedV1 range-order-flag)
   (if (== $kind directory)
    (case (store:source-context $source)
      (((StoreSourceContextV1 $epoch $revision $metadata)
        (let (KnowledgeAddressV1 $key) (durable-space:metadata $collection)
          (if (== $metadata $key)
            (db-server:range-view $source $collection $arity $position $lower $upper $ordered)
            (DbRefusedV1 range-source-scope))))
       ($failure (DbRefusedV1 range-view-required))))
    (if (== $kind act)
      (if (== $collection data)
        (if $ordered (KbRefused ordered-integer-index-required)
          (db-server:range-act $source $arity $position $lower $upper))
        (DbRefusedV1 collection-absent))
      (DbRefusedV1 range-view-required)))))
(= (db-server:range-view $source $collection $arity $position $lower $upper $ordered)
  (case (store:source-view $source)
    (((StoreSnapshot $view $_ $_)
      (case (range-i:raw-open $view $collection $arity $position $lower $upper $ordered (store:value-byte-limit))
        (((KqReady $range)
          (let* (($limit (store:value-byte-limit)) ($chunk (act:artifact-chunk-size)))
            (ServiceKeepValueV1 (DbRangeStateV1 $view $range NoRangePacketV1 0)
              (DbLinearV1 (DbRangeOpenedV1 0 $limit $chunk)))))
         ($failure (let $_ (db-server:range-close-view $view) $failure)))))
     ($failure $failure))))
(= (db-server:range-next (ServiceCallV1 $configuration $peer
     (DbRangeStateV1 $view $range $packet $sequence) (DbRangeNextV1 $expected)))
  (if (== $sequence $expected)
    (let $_ (db-server:range-close-packet $packet)
      (case (kbq:advance $range)
        (((KqSkip $next $keys $bytes)
          (ServiceKeepValueV1 (DbRangeStateV1 $view $next NoRangePacketV1 $sequence)
            (DbLinearV1 (DbRangeSkipV1 $sequence $keys $bytes))))
         ((KqOut (SpaceOriginalV1 $atom $identity) $next $keys $bytes)
          (db-server:range-packet $view $next $sequence $atom $identity $keys $bytes))
         ((KqEnd $keys $bytes)
          (let $_ (db-server:range-close-view $view) (DbRangeEndV1 $sequence $keys $bytes)))
         ((KqFail $failure $keys $bytes)
          (let $_ (db-server:range-close-view $view) (DbRangeFailedV1 $failure $keys $bytes))))))
    (let* (($_ (db-server:range-close-packet $packet)) ($_ (kbq:close-state $range))
           ($_ (db-server:range-close-view $view))) (DbRefusedV1 range-sequence))))
(: db-server:range-packet (-> Atom Atom Number Atom Atom Number Number %Undefined%))
(= (db-server:range-packet $view $next $sequence $atom $identity $keys $bytes)
  (case (store:source-single $atom $identity)
    (((StoreSourceOpened $source $_ $_)
      (let* (($opened (store:source-scan $source)) ($_ (store:close $source)))
        (db-server:range-scan $view $next $sequence $keys $bytes $opened)))
     ($failure (db-server:range-error $view $next $failure)))))
(= (db-server:range-scan $view $next $sequence $keys $bytes $opened)
  (case $opened
    (((StoreCandidateOpened $packet $_)
      (case (store:candidate-next $packet 0 1)
        (((StoreCandidateRow $_ $body-size $identity-size)
          (ServiceKeepValueV1 (DbRangeStateV1 $view $next $packet (+ $sequence 1))
            (DbLinearV1 (DbRangeRowV1 $sequence $body-size $identity-size $keys $bytes))))
         ($failure (let $_ (store:close $packet) (db-server:range-error $view $next $failure))))))
     ($failure (db-server:range-error $view $next $failure)))))
(= (db-server:range-error $view $next $failure)
  (let* (($_ (kbq:close-state $next)) ($_ (db-server:range-close-view $view))) $failure))
(= (db-server:range-close-packet $packet)
  (if (== $packet NoRangePacketV1) True (store:close $packet)))
(= (db-server:range-read (ServiceCallV1 $configuration $peer
     (DbRangeStateV1 $view $range $packet $sequence) (DbRangeReadV1 $row $part $offset $maximum)))
  (if (and (not (== $packet NoRangePacketV1)) (== (+ $row 1) $sequence))
    (ServiceKeepValueV1 (DbRangeStateV1 $view $range $packet $sequence)
      (DbLinearV1 (DbRangeChunkV1 (store:candidate-read $packet 0 $part $offset $maximum))))
    (let* (($_ (db-server:range-close-packet $packet)) ($_ (kbq:close-state $range))
           ($_ (db-server:range-close-view $view))) (DbRefusedV1 range-sequence))))
(= (db-server:range-cancel (ServiceCallV1 $configuration $peer
     (DbRangeStateV1 $view $range $packet $sequence) $unused))
  (let* (($_ (db-server:range-close-packet $packet)) ($_ (kbq:close-state $range))
         ($_ (db-server:range-close-view $view))) DbRangeCancelledV1))

(= (db-server:range-close-view $view)
  (if (== $view NoRangeViewV1) True (store:close $view)))
(= (db-server:range-act $source $arity $position $lower $upper)
  (let* (($space (store:source-space $source))
         ($opened (plain-range:raw-open $space $arity $position $lower $upper))
         ($_ (store:close $space)))
    (case $opened
      (((KqReady $range)
        (let* (($limit (store:value-byte-limit)) ($chunk (act:artifact-chunk-size)))
          (ServiceKeepValueV1 (DbRangeStateV1 NoRangeViewV1 $range NoRangePacketV1 0)
            (DbLinearV1 (DbRangeOpenedV1 0 $limit $chunk)))))
       ($failure $failure)))))
