; Faithful exact-image qualification for Popper's synthesis-droplast task.
;
; Source: logic-and-learning-lab/Popper revision
; 5c608d3ec87e4975866042fe326e9a317277e021.
; Source file digests (SHA-256):
;   bias.pl 5c2e402553a073514a55286265cccf937602f21e60740853136479ac3976d875
;   bk.pl   32a1a41e61cfa3fbecfe605828a1d5b489eb87ff41c78c9a05cf111f39593f20
;   exs.pl  f724d76455f288e6524d5050e145f1895db92b6f75b77ee123a7d41b71433ed8
;
; Prolog integer constants are interpreted injectively in the pinned
; popper:n0..popper:n101 vocabulary.  The target and its list background are
; structural and therefore cover every finite List over that exact image.

!(import! &self ../../lib/ilp/prime_native_list_types.metta)
!(import! &self ../../lib/ilp/popper_snapshot_numerals.metta)
!(import! &self ../../lib/ilp/popper_native_list_relations.metta)
!(import! &self ../../lib/ilp/popper_benchmark_classify.metta)
!(import! &self ../../lib/ilp/popper_synthesis_droplast_types.metta)
!(import! &self ../../lib/ilp/popper_synthesis_droplast_rules.metta)

(= (popper:droplast:classify $name (quote $goal))
  (let
    (compile-result proof-occurrence-bag
      $occurrences $metrics $revision)
    (compile:run
      (popper:droplast:package) 128 4000000 256 (quote $goal))
    (popper:classify-occurrences
      $name (quote $goal) $occurrences)))

