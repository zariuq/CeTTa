      (list:cons popper:numeral popper:n96 (list:cons popper:numeral popper:n77 (list:cons popper:numeral popper:n60 (list:cons popper:numeral popper:n65 (list:cons popper:numeral popper:n6 (list:nil popper:numeral)))))))))

