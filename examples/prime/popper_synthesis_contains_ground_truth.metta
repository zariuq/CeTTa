; Faithful exact-image qualification for Popper's synthesis-contains task.
;
; Source: logic-and-learning-lab/Popper revision
; 5c608d3ec87e4975866042fe326e9a317277e021.
; Source file digests (SHA-256):
;   bias.pl 95050838286d3ce39e31a6c1b207a7a06b3d7cf634184cba7bea76289096b4f4
;   bk.pl   508fe8d0bb4ee35fc7f317cc955f1229beeea9815d7b28b154ab1b7cea6443dc
;   exs.pl  4730e68c1c140295e3071007d1dabccc14a9dd199a915af3c4a7ddba6ac4b66d
;
; The reference program recognizes a list containing 6 or 9.  Its reachable
; background image uses native List head/tail evidence and the two authored
; constant predicates.  Each matching occurrence retains its own recursive
; proof path; the classifier checks the complete occurrence bag.

!(import! &self ../../lib/ilp/prime_native_list_types.metta)
!(import! &self ../../lib/ilp/popper_snapshot_numerals.metta)
!(import! &self ../../lib/ilp/popper_native_list_relations.metta)
!(import! &self ../../lib/ilp/popper_benchmark_classify.metta)
!(import! &self ../../lib/ilp/popper_synthesis_contains_types.metta)
!(import! &self ../../lib/ilp/popper_synthesis_contains_rules.metta)

(= (popper:contains:classify $name (quote $goal))
  (let
    (compile-result proof-occurrence-bag
      $occurrences $metrics $revision)
    (compile:run
      (popper:contains:package) 128 8000000 512 (quote $goal))
    (popper:classify-occurrences
      $name (quote $goal) $occurrences)))

