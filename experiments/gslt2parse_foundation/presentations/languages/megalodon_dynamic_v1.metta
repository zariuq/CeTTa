    (rule mg-step-mg-prefix-decl (head (mg-step (mg-state ?env ?scopes) ?witnesses (node mg-prefix-decl (pair ?name (pair (node mg-priority ?raw-priority) ?meaning))) (mg-state (mg-env-add ?env ?name ?priority mg-fix-prefix) ?scopes) ?witnesses)) (body (mg-priority-normalize ?raw-priority ?priority) (mg-valid-priority ?priority) (mg-compatible ?env ?priority mg-fix-prefix) (mg-resolve ?env (cons ?meaning nil) ?meaning-ast)))
    (rule mg-step-section (head (mg-step (mg-state ?env ?scopes) ?witnesses (node mg-section ?name) (mg-state ?env (mg-scopes-add ?scopes ?name ?env)) ?witnesses)) (body))
    (rule mg-valid-priority-one (head (mg-valid-priority (cons ?a nil))) (body (mg-nonzero ?a)))
    (rule mg-valid-priority-three (head (mg-valid-priority (cons ?a (cons ?b (cons ?c nil))))) (body (mg-nonzero ?a)))
    (rule mg-valid-priority-two (head (mg-valid-priority (cons ?a (cons ?b nil)))) (body (mg-nonzero ?a)))
  ))
