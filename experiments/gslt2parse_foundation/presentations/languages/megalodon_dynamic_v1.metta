    (operator mg-compatible 3)
    (operator mg-cp-bits 2)
    (operator mg-cp-ne 2)
    (operator mg-digit-less 2)
    (operator mg-env-add 4)
    (operator mg-env-binder-add 5)
    (operator mg-find-root 3)
    (operator mg-fold 5)
    (operator mg-fold-application 3)
    (operator mg-fold-application-tail 4)
    (operator mg-group 1)
    (operator mg-infix 3)
    (operator mg-infix-kind 1)
    (operator mg-lex-less 2)
    (operator mg-list-ne 2)
    (operator mg-lookup 4)
    (operator mg-name-ne 2)
    (operator mg-nonzero 1)
    (operator mg-not-lookup 2)
    (operator mg-paren 1)
    (operator mg-parse 4)
    (operator mg-postfix 2)
    (operator mg-prefix 2)
    (operator mg-priority-less 2)
    (operator mg-priority-ne 2)
