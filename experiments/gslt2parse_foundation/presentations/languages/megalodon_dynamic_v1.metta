    (operator mg-reverse-acc 3)
    (operator mg-root 5)
    (operator mg-scan-root 5)
    (operator mg-scopes-add 3)
    (operator mg-shorter 2)
    (operator mg-state 2)
    (operator mg-step 5)
    (operator mg-valid-priority 1)
    (operator mg-witness-add 3)
  )
  (equations)
  (rewrites
    (rule def-mg-document (head (definition mg-document (node mg-document (right (ref mg-skip) (left (star (ref mg-statement)) eof))))) (body))
    (rule def-mg-expression (head (definition mg-expression (left (node mg-expression mg-name-list) (ref mg-skip)))) (body))
    (rule def-mg-k-assign (head (definition mg-k-assign (left (lit (cons (cp 58) (cons (cp 61) nil))) (ref mg-skip)))) (body))
