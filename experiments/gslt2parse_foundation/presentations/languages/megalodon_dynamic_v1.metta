(gslt-presentation-v1 MegalodonDynamicV1
  (signature
    (operator mg-apply 2)
    (operator mg-assoc-compatible 2)
    (operator mg-atom 1)
    (operator mg-binder 4)
    (operator mg-binder-form 4)
    (operator mg-binder-lookup 5)
