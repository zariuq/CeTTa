    (rule def-mg-k-colon (head (definition mg-k-colon (left (lit (cons (cp 58) nil)) (ref mg-skip)))) (body))
    (rule def-mg-k-dot (head (definition mg-k-dot (left (lit (cons (cp 46) nil)) (ref mg-skip)))) (body))
    (rule def-mg-k-end (head (definition mg-k-end (left (lit (cons (cp 69) (cons (cp 110) (cons (cp 100) nil)))) (ref mg-skip1)))) (body))
