    (rule def-mg-k-right (head (definition mg-k-right (left (lit (cons (cp 114) (cons (cp 105) (cons (cp 103) (cons (cp 104) (cons (cp 116) nil)))))) (ref mg-skip)))) (body))
    (rule def-mg-k-section (head (definition mg-k-section (left (lit (cons (cp 83) (cons (cp 101) (cons (cp 99) (cons (cp 116) (cons (cp 105) (cons (cp 111) (cons (cp 110) nil)))))))) (ref mg-skip1)))) (body))
    (rule def-mg-name-punct (head (definition mg-name-punct (left (ref mg-name-raw) (ref mg-skip)))) (body))
    (rule def-mg-name-raw (head (definition mg-name-raw (node mg-name (seq (class (c-union ascii-lower (c-union ascii-upper underscore))) (star (class (c-union ascii-lower (c-union ascii-upper (c-union ascii-digit (c-union underscore mg-apostrophe)))))))))) (body))
    (rule def-mg-name-space (head (definition mg-name-space (left (ref mg-name-raw) (ref mg-skip1)))) (body))
    (rule def-mg-priority-space (head (definition mg-priority-space (left (node mg-priority (plus (class ascii-digit))) (ref mg-skip1)))) (body))
    (rule def-mg-skip (head (definition mg-skip (star (class tptp-whitespace)))) (body))
    (rule def-mg-skip1 (head (definition mg-skip1 (plus (class tptp-whitespace)))) (body))
    (rule def-mg-statement (head (definition mg-statement (alt (node mg-infix-left (right (ref mg-k-infix) (seq (ref mg-name-space) (seq (ref mg-priority-space) (right (ref mg-k-left) (right (ref mg-k-assign) (left (ref mg-name-punct) (ref mg-k-dot)))))))) (alt (node mg-infix-right (right (ref mg-k-infix) (seq (ref mg-name-space) (seq (ref mg-priority-space) (right (ref mg-k-right) (right (ref mg-k-assign) (left (ref mg-name-punct) (ref mg-k-dot)))))))) (alt (node mg-infix-none (right (ref mg-k-infix) (seq (ref mg-name-space) (seq (ref mg-priority-space) (right (ref mg-k-assign) (left (ref mg-name-punct) (ref mg-k-dot))))))) (alt (node mg-axiom (right (ref mg-k-axiom) (seq (ref mg-name-punct) (right (ref mg-k-colon) (left (ref mg-expression) (ref mg-k-dot)))))) (alt (node mg-section (right (ref mg-k-section) (left (ref mg-name-punct) (ref mg-k-dot)))) (node mg-end (right (ref mg-k-end) (left (ref mg-name-punct) (ref mg-k-dot))))))))))) (body))
    (rule member-mg-apostrophe-39 (head (member mg-apostrophe (cp 39))) (body))
    (rule mg-assoc-compatible-left-left (head (mg-assoc-compatible mg-left mg-left)) (body))
    (rule mg-assoc-compatible-left-none (head (mg-assoc-compatible mg-left mg-none)) (body))
    (rule mg-assoc-compatible-none-left (head (mg-assoc-compatible mg-none mg-left)) (body))
    (rule mg-assoc-compatible-none-none (head (mg-assoc-compatible mg-none mg-none)) (body))
    (rule mg-assoc-compatible-postfix-postfix (head (mg-assoc-compatible mg-fix-postfix mg-fix-postfix)) (body))
    (rule mg-assoc-compatible-prefix-prefix (head (mg-assoc-compatible mg-fix-prefix mg-fix-prefix)) (body))
    (rule mg-assoc-compatible-right-right (head (mg-assoc-compatible mg-right mg-right)) (body))
    (rule mg-binder-lookup-head (head (mg-binder-lookup (mg-env-binder-add ?rest ?name ?delimiter ?multiplicity ?meaning) ?name ?delimiter ?multiplicity ?meaning)) (body))
    (rule mg-binder-lookup-tail (head (mg-binder-lookup (mg-env-binder-add ?rest ?other ?other-delimiter ?other-multiplicity ?other-meaning) ?name ?delimiter ?multiplicity ?meaning)) (body (mg-name-ne ?other ?name) (mg-binder-lookup ?rest ?name ?delimiter ?multiplicity ?meaning)))
    (rule mg-binder-lookup-through-fixity (head (mg-binder-lookup (mg-env-add ?rest ?operator ?priority ?kind) ?name ?delimiter ?multiplicity ?meaning)) (body (mg-binder-lookup ?rest ?name ?delimiter ?multiplicity ?meaning)))
    (rule mg-bit-ne-01 (head (mg-bit-ne mg-b0 mg-b1)) (body))
    (rule mg-bit-ne-10 (head (mg-bit-ne mg-b1 mg-b0)) (body))
    (rule mg-bits-ne-head (head (mg-bits-ne (mg-bits-cons ?a ?as) (mg-bits-cons ?b ?bs))) (body (mg-bit-ne ?a ?b)))
    (rule mg-bits-ne-tail (head (mg-bits-ne (mg-bits-cons ?a ?as) (mg-bits-cons ?a ?bs))) (body (mg-bits-ne ?as ?bs)))
    (rule mg-compatible-different-priority (head (mg-compatible (mg-env-add ?rest ?name ?old-priority ?old-assoc) ?priority ?assoc)) (body (mg-priority-ne ?old-priority ?priority) (mg-compatible ?rest ?priority ?assoc)))
    (rule mg-compatible-empty (head (mg-compatible mg-env-empty ?priority ?assoc)) (body))
    (rule mg-compatible-same-priority (head (mg-compatible (mg-env-add ?rest ?name ?priority ?old-assoc) ?priority ?assoc)) (body (mg-assoc-compatible ?old-assoc ?assoc) (mg-compatible ?rest ?priority ?assoc)))
    (rule mg-compatible-through-binder (head (mg-compatible (mg-env-binder-add ?rest ?name ?delimiter ?multiplicity ?meaning) ?priority ?assoc)) (body (mg-compatible ?rest ?priority ?assoc)))
