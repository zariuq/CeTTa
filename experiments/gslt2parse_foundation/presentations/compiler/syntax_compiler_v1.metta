(gslt-presentation-v1 SyntaxCompilerV1
  (signature
    (operator compile-definition 2)
    (operator compile-grammar 2)
    (operator compile-root 2)
    (operator sir-alt 2)
    (operator sir-char 1)
    (operator sir-class 1)
    (operator sir-definition 2)
    (operator sir-eps 1)
    (operator sir-left 2)
    (operator sir-lit 1)
    (operator sir-node 2)
    (operator sir-opt 1)
    (operator sir-peek 1)
    (operator sir-plus 1)
    (operator sir-ref 1)
    (operator sir-right 2)
    (operator sir-root 2)
    (operator sir-seq 2)
    (operator sir-star 1)
    (operator sir-until 2)
  )
  (equations)
  (rewrites
    (rule compile-alt (head (compile-grammar (alt ?left ?right) (sir-alt ?a ?b))) (body (compile-grammar ?left ?a) (compile-grammar ?right ?b)))
    (rule compile-any (head (compile-grammar any sir-any)) (body))
    (rule compile-char (head (compile-grammar (char ?codepoint) (sir-char ?codepoint))) (body))
    (rule compile-class (head (compile-grammar (class ?name) (sir-class ?name))) (body))
    (rule compile-definition (head (compile-definition ?name (sir-definition ?name ?ir))) (body (definition ?name ?grammar) (compile-grammar ?grammar ?ir)))
    (rule compile-eof (head (compile-grammar eof sir-eof)) (body))
    (rule compile-eps (head (compile-grammar (eps ?value) (sir-eps ?value))) (body))
    (rule compile-left (head (compile-grammar (left ?left ?right) (sir-left ?a ?b))) (body (compile-grammar ?left ?a) (compile-grammar ?right ?b)))
    (rule compile-lit (head (compile-grammar (lit ?bytes) (sir-lit ?bytes))) (body))
    (rule compile-node (head (compile-grammar (node ?label ?grammar) (sir-node ?label ?body))) (body (compile-grammar ?grammar ?body)))
    (rule compile-opt (head (compile-grammar (opt ?grammar) (sir-opt ?body))) (body (compile-grammar ?grammar ?body)))
    (rule compile-peek (head (compile-grammar (peek ?grammar) (sir-peek ?body))) (body (compile-grammar ?grammar ?body)))
    (rule compile-plus (head (compile-grammar (plus ?grammar) (sir-plus ?body))) (body (compile-grammar ?grammar ?body)))
    (rule compile-ref (head (compile-grammar (ref ?name) (sir-ref ?name))) (body))
    (rule compile-right (head (compile-grammar (right ?left ?right) (sir-right ?a ?b))) (body (compile-grammar ?left ?a) (compile-grammar ?right ?b)))
    (rule compile-root-definition (head (compile-root ?name (sir-root ?name ?ir))) (body (definition ?name ?grammar) (compile-grammar ?grammar ?ir)))
    (rule compile-seq (head (compile-grammar (seq ?left ?right) (sir-seq ?a ?b))) (body (compile-grammar ?left ?a) (compile-grammar ?right ?b)))
    (rule compile-star (head (compile-grammar (star ?grammar) (sir-star ?body))) (body (compile-grammar ?grammar ?body)))
    (rule compile-until (head (compile-grammar (until ?end ?item) (sir-until ?e ?i))) (body (compile-grammar ?end ?e) (compile-grammar ?item ?i)))
  ))
