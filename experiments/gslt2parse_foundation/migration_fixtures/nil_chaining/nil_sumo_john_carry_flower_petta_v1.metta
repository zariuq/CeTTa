;; PeTTa-dialect port of Nil's SUMO john-carry-flower experiment,
;; bfc-xp.metta chainer idiom.
(= (fromNumber $n) (if (<= $n 0) Z (S (fromNumber (- $n 1)))))
(= (bcn $kb $rb $_ (: $x $a)) (match $kb (: $x $a) (: $x $a)))
(= (bcn $kb $rb (S $k) (: ($f $x $y) $c))
   (let* (((: $f (-> $a $b $c)) (match $rb (: $f (-> $a $b $c)) (: $f (-> $a $b $c))))
          ((: $x $a) (bcn $kb $rb $k (: $x $a)))
          ((: $y $b) (bcn $kb $rb $k (: $y $b))))
     (: ($f $x $y) $c)))
(= (bcn $kb $rb (S $k) (: ($f $x $y $z) $c))
   (let* (((: $f (-> $a $b $c2 $c)) (match $rb (: $f (-> $a $b $c2 $c)) (: $f (-> $a $b $c2 $c))))
          ((: $x $a) (bcn $kb $rb $k (: $x $a)))
          ((: $y $b) (bcn $kb $rb $k (: $y $b)))
          ((: $z $c2) (bcn $kb $rb $k (: $z $c2))))
     (: ($f $x $y $z) $c)))
!(bind! &kb (new-space))
!(bind! &rb (new-space))
!(add-atom &rb (: BinaryConjunctionIntroduction (-> $x $y (∧ $x $y))))
!(add-atom &rb (: TrinaryConjunctionIntroduction (-> $x $y $z (∧ $x $y $z))))
!(add-atom &rb (: ModusPonens (-> (⟹ $x $y) $x $y)))
!(add-atom &kb (: (WitnessOf (⟹ (∧ (subclass $X $Y) (instance $Z $X)) (instance $Z $Y))) (⟹ (∧ (subclass $X $Y) (instance $Z $X)) (instance $Z $Y))))
!(add-atom &kb (: (WitnessOf (instance objectTransferred CaseRole)) (instance objectTransferred CaseRole)))
!(add-atom &kb (: (WitnessOf (subrelation objectTransferred patient)) (subrelation objectTransferred patient)))
!(add-atom &kb (: (WitnessOf (domain objectTransferred 1 Transfer)) (domain objectTransferred 1 Transfer)))
!(add-atom &kb (: (WitnessOf (domain objectTransferred 2 Object)) (domain objectTransferred 2 Object)))
!(add-atom &kb (: (WitnessOf (format EnglishLanguage objectTransferred "the object transferred in %1 is %n %2")) (format EnglishLanguage objectTransferred "the object transferred in %1 is %n %2")))
!(add-atom &kb (: (WitnessOf (documentation objectTransferred EnglishLanguage "A relation that specifies the object that is transferred during the process. For example, in a &%Mailing process, the object transferred is a letter or package.")) (documentation objectTransferred EnglishLanguage "A relation that specifies the object that is transferred during the process. For example, in a &%Mailing process, the object transferred is a letter or package.")))
!(add-atom &kb (: (WitnessOf (⟹ (∧ (instance $T Transfer) (objectTransferred $T $O) (orientation $O2 $O Inside)) (objectTransferred $T $O2))) (⟹ (∧ (instance $T Transfer) (objectTransferred $T $O) (orientation $O2 $O Inside)) (objectTransferred $T $O2))))
!(add-atom &kb (: (WitnessOf (⟹ (∧ (instance $T Transfer) (objectTransferred $T $O) (orientation $O2 $O On)) (objectTransferred $T $O2))) (⟹ (∧ (instance $T Transfer) (objectTransferred $T $O) (orientation $O2 $O On)) (objectTransferred $T $O2))))
!(add-atom &kb (: (WitnessOf (subclass Carrying Transfer)) (subclass Carrying Transfer)))
!(add-atom &kb (: (WitnessOf (subclass Flower PlantAnatomicalStructure)) (subclass Flower PlantAnatomicalStructure)))
!(add-atom &kb (: (WitnessOf (instance Inside PositionalAttribute)) (instance Inside PositionalAttribute)))
!(add-atom &kb (: (WitnessOf (subclass Container Object)) (subclass Container Object)))
!(add-atom &kb (: (WitnessOf (domain objectTransferred 1 Transfer)) (domain objectTransferred 1 Transfer)))
!(add-atom &kb (: (WitnessOf (domain objectTransferred 2 Object)) (domain objectTransferred 2 Object)))
!(add-atom &kb (: (WitnessOf (instance objectTransferred CaseRole)) (instance objectTransferred CaseRole)))
!(add-atom &kb (: (WitnessOf (subrelation objectTransferred patient)) (subrelation objectTransferred patient)))
!(add-atom &kb (: (WitnessOf (instance JohnsCarry Carrying)) (instance JohnsCarry Carrying)))
!(add-atom &kb (: (WitnessOf (objectTransferred JohnsCarry JohnsVase)) (objectTransferred JohnsCarry JohnsVase)))
!(add-atom &kb (: (WitnessOf (agent JohnsCarry John)) (agent JohnsCarry John)))
!(add-atom &kb (: (WitnessOf (instance JohnsFlower Flower)) (instance JohnsFlower Flower)))
!(add-atom &kb (: (WitnessOf (instance JohnsVase Container)) (instance JohnsVase Container)))
!(add-atom &kb (: (WitnessOf (orientation JohnsFlower JohnsVase Inside)) (orientation JohnsFlower JohnsVase Inside)))
!(test (collapse (bcn &kb &rb (fromNumber 4) (: $prf (objectTransferred JohnsCarry JohnsFlower))))
       ((: (ModusPonens (WitnessOf (⟹ (∧ (instance JohnsCarry Transfer) (objectTransferred JohnsCarry JohnsVase) (orientation JohnsFlower JohnsVase Inside)) (objectTransferred JohnsCarry JohnsFlower))) (TrinaryConjunctionIntroduction (ModusPonens (WitnessOf (⟹ (∧ (subclass Carrying Transfer) (instance JohnsCarry Carrying)) (instance JohnsCarry Transfer))) (BinaryConjunctionIntroduction (WitnessOf (subclass Carrying Transfer)) (WitnessOf (instance JohnsCarry Carrying)))) (WitnessOf (objectTransferred JohnsCarry JohnsVase)) (WitnessOf (orientation JohnsFlower JohnsVase Inside)))) (objectTransferred JohnsCarry JohnsFlower))))
