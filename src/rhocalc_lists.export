(cesta-export/1 (header CETTA_RHOCALC_LISTS_GENERATED_H) (profile gnu11)
 (include <stdint.h>)
 (use "../vendor/cesta/macros/Worklists.module" Growable)
 (function rho_push_var Push (element VarId) (count uint32_t)
   (doc "Append one bound variable to a scope; 1, or 0 with the list unchanged."))
 (function rho_push_atom Push (element RhoAtomRef) (count uint32_t)
   (doc "Append one atom; 1, or 0 with the list unchanged."))
 (function rho_push_endpoint Push (element RhoEndpoint) (count uint32_t)
   (doc "Append one COMM endpoint; 1, or 0 with the list unchanged."))
 (function rho_push_alpha Push (element RhoAlphaEntry) (count uint32_t)
   (doc "Append one binder of the alpha environment; 1, or 0 with the list unchanged."))
 (function rho_push_key Push (element RhoKey) (count uint32_t)
   (doc "Append one canonical key beside its item; 1, or 0 with the list unchanged."))
 (function rho_push_pointer Push (element RhoPointer) (count CettaCount)
   (doc "Append one resource of a promoted map; 1, or 0 with the list unchanged."))
 (function rho_push_epoch Push (element uint64_t) (count CettaCount)
   (doc "Append one owner epoch of a promoted map; 1, or 0 with the list unchanged."))
 (function rho_push_text_action Push (element RhoAtomTextAction) (count size_t)
   (doc "Append one action of the atom-text walk; 1, or 0 with the list unchanged.")))
