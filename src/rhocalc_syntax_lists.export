(cesta-export/1 (header CETTA_RHOCALC_SYNTAX_LISTS_GENERATED_H) (profile gnu11)
 (include <stdint.h>)
 (use "../vendor/cesta/macros/Worklists.module" Growable)
 (function rho_syntax_push_atom Push (element RhoSyntaxAtom) (count uint32_t)
   (doc "Append one atom read; 1, or 0 with the list unchanged."))
 (function rho_syntax_push_binding Push (element RhoElabBinding) (count uint32_t)
   (doc "Append one name the elaborator binds; 1, or 0 with the list unchanged."))
 (function rho_syntax_push_var Push (element VarId) (count uint32_t)
   (doc "Append one variable in scope; 1, or 0 with the list unchanged."))
 (function rho_syntax_push_symbol Push (element SymbolId) (count uint32_t)
   (doc "Append one free name; 1, or 0 with the list unchanged."))
 (function rho_syntax_push_print_binding Push (element RhoPrintBinding) (count uint32_t)
   (doc "Append one name the printer binds; 1, or 0 with the list unchanged.")))
