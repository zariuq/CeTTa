(cesta-export/1 (header CETTA_RHOCALC_COST_LISTS_GENERATED_H) (profile gnu11)
 (include <stdint.h>)
 (use "../vendor/cesta/macros/Worklists.module" Growable)
 (function rhocost_push_index Push (element uint32_t) (count uint32_t)
   (doc "Append one index; 1, or 0 with the list unchanged."))
 (function rhocost_push_producer Push (element uint64_t) (count uint32_t)
   (doc "Append one producer of a component; 1, or 0 with the list unchanged."))
 (function rhocost_push_token Push (element RhoCostToken) (count uint32_t)
   (doc "Append one funding token; 1, or 0 with the list unchanged."))
 (function rhocost_push_signed_endpoint Push (element RhoCostSignedEndpoint) (count uint32_t)
   (doc "Append one signed endpoint; 1, or 0 with the list unchanged."))
 (function rhocost_push_whole_redex Push (element RhoCostWholeRedex) (count uint32_t)
   (doc "Append one whole redex; 1, or 0 with the list unchanged."))
 (function rhocost_push_cover_frame Push (element RhoCostCoverFrame) (count uint32_t)
   (doc "Append one frame of the exact-cover search; 1, or 0 with the list unchanged."))
 (function rhocost_push_trace_component Push (element RhoCostTraceComponent) (count uint32_t)
   (doc "Append one trace component; 1, or 0 with the list unchanged."))
 (function rhocost_push_step Push (element RhoCostStep) (count uint32_t)
   (doc "Append one funded step; 1, or 0 with the list unchanged."))
 (function rhocost_push_parallel_task Push (element RhoCostParallelTask) (count uint32_t)
   (doc "Append one task of a parallel wave; 1, or 0 with the list unchanged.")))
