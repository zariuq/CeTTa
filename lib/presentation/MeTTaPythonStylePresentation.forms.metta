; Interpretation of MeTTaPythonStylePresentation.module into ordinary MeTTa
; atoms (the template encoding is the one of MeTTaCStylePresentation.forms.metta).
; Every production denotes one atom; the list order is the printing preference.
; Blocks are printed by indentation where the layout rules allow it, and with
; explicit braces where more text follows the block on its line.

(pres:version pystyle "1.1")

(pres:forms pystyle
  ((Program (cs:arg 0))
   (SRun (cs:run (cs:arg 0)))
   (SDef (cs:x = (cs:arg 0) (cs:arg 1)))
   (SEq (cs:x = (cs:arg 0) (cs:arg 1)))
   (SType (cs:x : (cs:arg 0) (cs:arg 1)))
   (SFact (cs:arg 0))

   (ELambda (cs:x |-> (cs:arg 0) (cs:arg 1)))
   (ELet (cs:x let (cs:arg 0) (cs:arg 1) (cs:arg 2)))
   (ELetStar (cs:x let* (cs:arg 0) (cs:arg 1)))
   (BindOne (cs:x (cs:arg 0) (cs:arg 1)))
   (EArrow (cs:cons -> (cs:cons (cs:arg 0) (cs:arg 1))))
   (ATMore (cs:cons (cs:arg 0) (cs:arg 1)))
   (ATLast (cs:x (cs:arg 0)))

   (EOr (cs:x or (cs:arg 0) (cs:arg 1)))
   (EAnd (cs:x and (cs:arg 0) (cs:arg 1)))
   (EEq (cs:x == (cs:arg 0) (cs:arg 1)))
   (ELt (cs:x < (cs:arg 0) (cs:arg 1)))
   (EGt (cs:x > (cs:arg 0) (cs:arg 1)))
   (ELe (cs:x <= (cs:arg 0) (cs:arg 1)))
   (EGe (cs:x >= (cs:arg 0) (cs:arg 1)))
   (EAdd (cs:x + (cs:arg 0) (cs:arg 1)))
   (ESub (cs:x - (cs:arg 0) (cs:arg 1)))
   (EMul (cs:x * (cs:arg 0) (cs:arg 1)))
   (EDiv (cs:x / (cs:arg 0) (cs:arg 1)))
   (EMod (cs:x % (cs:arg 0) (cs:arg 1)))
   (EQuote (cs:x quote (cs:arg 0)))
   (EUnquote (cs:x unquote (cs:arg 0)))

   (EIf (cs:x if (cs:arg 0) (cs:arg 1) (cs:arg 2)))
   (ECase (cs:x case (cs:arg 0) (cs:arg 1)))
   (ArmOne (cs:x (cs:arg 0) (cs:arg 1)))
   (EMatch (cs:x match (cs:arg 2) (cs:arg 1) (cs:arg 0)))
   ; imperative flows (lib/petta/lib_flow.metta states their meaning)
   (EDo (cs:x flow:then (cs:arg 0) (cs:arg 1)))
   (SeqMore (cs:x flow:then (cs:arg 0) (cs:arg 1)))
   (SeqLast (cs:arg 0))
   (EForOf (cs:x flow:for-each (cs:x superpose (cs:arg 1)) (cs:x |-> (cs:x (cs:arg 0)) (cs:arg 2))))
   (EFor (cs:x flow:for-each (cs:arg 1) (cs:x |-> (cs:x (cs:arg 0)) (cs:arg 2))))
   (EForFrom (cs:x flow:for-match (cs:arg 1) (cs:arg 0) (cs:arg 2)))
   (EWhile (cs:x flow:while (cs:arg 0) (cs:arg 1)))
   (ERepeat (cs:x flow:until-quiet (cs:arg 0)))
   (ETransformInto (cs:x transform (cs:arg 0) (cs:arg 2) (cs:arg 3) (cs:arg 1)))
   (ETransform (cs:x transform (cs:arg 0) (cs:arg 1) (cs:arg 2)))
   (SrcsMany (cs:cons , (cs:cons (cs:arg 0) (cs:arg 1))))
   (SrcsOne (cs:arg 0))
   (CTake (cs:x take (cs:arg 0)))
   (CRead (cs:x read (cs:arg 0)))
   (CAbsent (cs:x absent (cs:arg 0)))
   (CWhen (cs:x let True (cs:arg 0)))
   (CLet (cs:x let (cs:arg 0) (cs:arg 1)))
   (CAll (cs:x all (cs:arg 0)))
   (COnce (cs:x once (cs:arg 0)))
   (CUnique (cs:x unique (cs:arg 0)))
   (CCollect (cs:x collect (cs:arg 1) (cs:arg 0)))
   (CPlain (cs:arg 0))
   (EConj (cs:cons , (cs:cons (cs:arg 0) (cs:arg 1))))

   (ECall (cs:cons (cs:arg 0) (cs:arg 1)))
   ; data is printed f{a, b}; 1.0's f[a, b] reads as the same atom
   (EDataLit (cs:cons (cs:arg 0) (cs:arg 1)))
   (EData (cs:cons (cs:arg 0) (cs:arg 1)))
   (ETuple (cs:arg 0))))

(pres:token-forms pystyle
  ((EVar var) (ESym name) (EQSym quoted) (EInt number) (ENegInt negative)
   (EDouble number) (ENegDouble negative) (EStr string) (ERaw raw)))

; Roles and looks as in the C style (see MeTTaCStylePresentation.forms.metta).
(pres:roles pystyle SRun (run))
(pres:roles pystyle SFact (data))
(pres:roles pystyle SDef (head run))
(pres:roles pystyle SEq (head run))
(pres:roles pystyle SType (data data))
(pres:roles pystyle ELambda (data run))
(pres:roles pystyle ELet (data run run))
(pres:roles pystyle ELetStar (inherit run))
(pres:roles pystyle BindOne (data run))
(pres:roles pystyle EArrow (data data))
(pres:roles pystyle ATMore (data data))
(pres:roles pystyle ATLast (data))
(pres:roles pystyle EQuote (data))
(pres:roles pystyle EIf (run run run))
(pres:roles pystyle ECase (run inherit))
(pres:roles pystyle ArmOne (data run))
(pres:roles pystyle EMatch (run data run))
(pres:roles pystyle EDo (run run))
(pres:roles pystyle SeqMore (run run))
(pres:roles pystyle SeqLast (run))
(pres:roles pystyle EForOf (data list run))
(pres:roles pystyle EFor (data run run))
(pres:roles pystyle EForFrom (data run run))
(pres:roles pystyle EWhile (run run))
(pres:roles pystyle ERepeat (run))
(pres:roles pystyle ETransformInto (run run source data))
(pres:roles pystyle ETransform (run source run))
(pres:roles pystyle CTake (data))
(pres:roles pystyle CRead (data))
(pres:roles pystyle CAbsent (data))
(pres:roles pystyle CWhen (run))
(pres:roles pystyle CLet (data run))
(pres:roles pystyle CCollect (data inherit))
(pres:roles pystyle CPlain (pattern))
(pres:roles pystyle ECall (run args))
(pres:roles pystyle EDataLit (data data))
(pres:roles pystyle EData (data data))
(pres:roles pystyle ETuple (list))
(pres:look pystyle ECall run head)
(pres:look pystyle EDataLit data)
(pres:look pystyle EData data)
(pres:look pystyle ETuple data list run head)

(pres:view-guard pystyle ECall callable-head)
(pres:view-guard pystyle EDataLit symbol-head)
(pres:view-guard pystyle EData symbol-head)

(pres:statement pystyle "Stmt" "\n")
(pres:leaf-category pystyle "Exp")
