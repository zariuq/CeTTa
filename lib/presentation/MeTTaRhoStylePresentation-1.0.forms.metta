; Interpretation of MeTTaRhoStylePresentation-1.0.module into ordinary MeTTa
; atoms: version 1.0 of the Rholang style, frozen so that every text written
; for 1.0 reads as it always did (--syntax rhostyle@1.0).  The current version
; is MeTTaRhoStylePresentation.forms.metta.  This table is read by the
; build-time presentation compiler only.

(pres:version rhostyle "1.0")

(pres:forms rhostyle
  ((Program (cs:arg 0))
   (SContract (cs:x = (cs:cons (cs:arg 0) (cs:arg 1)) (cs:arg 2)))
   (SEq (cs:x = (cs:arg 0) (cs:arg 1)))
   (SType (cs:x : (cs:arg 0) (cs:arg 1)))
   (SNew (cs:run (cs:x bind! (cs:arg 0) (cs:x new-space))))
   (SRun (cs:run (cs:arg 0)))
   (SFact (cs:arg 0))

   (ELambda (cs:x |-> (cs:arg 0) (cs:arg 1)))
   (ENew (cs:x let (cs:arg 0) (cs:x new-space) (cs:arg 1)))
   (EImport (cs:x import! (cs:arg 1) (cs:arg 0)))
   (EThen (cs:x flow:then (cs:arg 0) (cs:arg 1)))
   (ThMore (cs:x flow:then (cs:arg 0) (cs:arg 1)))
   (ThIn (cs:arg 0))
   (ELet (cs:x let (cs:arg 0) (cs:arg 1) (cs:arg 2)))
   (ELetSeq (cs:x let* (cs:cons (cs:arg 0) (cs:arg 1)) (cs:arg 2)))
   (ELetStar (cs:x let* (cs:arg 0) (cs:arg 1)))
   (LBindOne (cs:x (cs:arg 0) (cs:arg 1)))
   (LBsMore (cs:cons (cs:arg 0) (cs:arg 1)))
   (LBsOne (cs:x (cs:arg 0)))
   (ESend (cs:x add-atom (cs:arg 0) (cs:arg 1)))
   (EArrow (cs:cons -> (cs:cons (cs:arg 0) (cs:arg 1))))
   (ATMore (cs:cons (cs:arg 0) (cs:arg 1)))
   (ATLast (cs:x (cs:arg 0)))

   (EOr (cs:x or (cs:arg 0) (cs:arg 1)))
   (EAnd (cs:x and (cs:arg 0) (cs:arg 1)))
   (EEq (cs:x == (cs:arg 0) (cs:arg 1)))
   (ELt (cs:x < (cs:arg 0) (cs:arg 1)))
   (EGt (cs:x > (cs:arg 0) (cs:arg 1)))
   (ELe (cs:x <= (cs:arg 0) (cs:arg 1)))
   (EGe (cs:x >= (cs:arg 0) (cs:arg 1)))
   (EAdd (cs:x + (cs:arg 0) (cs:arg 1)))
   (ESub (cs:x - (cs:arg 0) (cs:arg 1)))
   (EMul (cs:x * (cs:arg 0) (cs:arg 1)))
   (EDiv (cs:x / (cs:arg 0) (cs:arg 1)))
   (EMod (cs:x % (cs:arg 0) (cs:arg 1)))
   (EQuote (cs:x quote (cs:arg 0)))
   (EUnquote (cs:x unquote (cs:arg 0)))

   (EPrint (cs:x println! (cs:arg 0)))
   (EIf (cs:x if (cs:arg 0) (cs:arg 1) (cs:arg 2)))
   (ECase (cs:x case (cs:arg 0) (cs:arg 1)))
   (ArmOne (cs:x (cs:arg 0) (cs:arg 1)))
   (EMatch (cs:x match (cs:arg 1) (cs:arg 0) (cs:arg 2)))
   (EForMatch (cs:x flow:for-match (cs:arg 1) (cs:arg 0) (cs:arg 2)))
   (EForEach (cs:x flow:for-each (cs:arg 1) (cs:x |-> (cs:x (cs:arg 0)) (cs:arg 2))))
   (EWhile (cs:x flow:while (cs:arg 0) (cs:arg 1)))
   (ERepeat (cs:x flow:until-quiet (cs:arg 0)))
   (ETransformInto (cs:x transform (cs:channel Chan) (cs:arg 0) (cs:arg 1) (cs:channel Dest)))
   (ETransform (cs:x transform (cs:channel Chan) (cs:arg 0) (cs:arg 1)))

   (RcWhereMore (cs:cons , (cs:cons (cs:arg 0) (cs:cons (cs:x let True (cs:arg 1)) (cs:arg 2)))))
   (RcWhere (cs:x , (cs:arg 0) (cs:x let True (cs:arg 1))))
   (RcMany (cs:cons , (cs:cons (cs:arg 0) (cs:arg 1))))
   (RcOne (cs:arg 0))
   (RLWhereMore (cs:cons (cs:arg 0) (cs:cons (cs:x let True (cs:arg 1)) (cs:arg 2))))
   (RLWhere (cs:x (cs:arg 0) (cs:x let True (cs:arg 1))))
   (RLMore (cs:cons (cs:arg 0) (cs:arg 1)))
   (RLOne (cs:x (cs:arg 0)))
   (RTake (cs:x take (cs:arg 0)))
   (RAbsent (cs:fixed 2 0 (cs:x absent (cs:arg 0))))
   (RReadQ (cs:x read (cs:arg 0)))
   (RAll (cs:x all (cs:arg 0)))
   (ROnce (cs:x once (cs:arg 0)))
   (RUnique (cs:x unique (cs:arg 0)))
   (RCollect (cs:x collect (cs:arg 0) (cs:arg 1)))
   (RGuard (cs:x let True (cs:arg 0)))
   (RLet (cs:x let (cs:arg 0) (cs:arg 1)))
   (RRead (cs:arg 0))
   (ChanOne (cs:arg 0))

   (TplsMany (cs:cons , (cs:cons (cs:arg 0) (cs:arg 1))))
   (TplsOne (cs:arg 0))
   (SendsMany (cs:cons , (cs:cons (cs:arg 0) (cs:arg 1))))
   (SendsOne (cs:arg 0))
   (SendOne (cs:arg 1))
   (DestOne (cs:arg 0))
   (EConj (cs:cons , (cs:cons (cs:arg 0) (cs:arg 1))))

   (ECall (cs:cons (cs:arg 0) (cs:arg 1)))
   (EData (cs:cons (cs:arg 0) (cs:arg 1)))
   (ETuple (cs:arg 0))))

(pres:token-forms rhostyle
  ((EVar var) (ESym name) (EQSym quoted) (EInt number) (ENegInt negative)
   (EDouble number) (ENegDouble negative) (EStr string) (ERaw raw)
   (HName name) (HQuoted quoted) (HVar var)))

(pres:roles rhostyle SContract (data data run))
(pres:roles rhostyle SEq (head run))
(pres:roles rhostyle SType (data data))
(pres:roles rhostyle SNew (data))
(pres:roles rhostyle SRun (run))
(pres:roles rhostyle SFact (data))
(pres:roles rhostyle ELambda (data run))
(pres:roles rhostyle ENew (data run))
(pres:roles rhostyle EImport (data run))
(pres:roles rhostyle EThen (run run))
(pres:roles rhostyle ThMore (run run))
(pres:roles rhostyle ThIn (run))
(pres:roles rhostyle ELet (data run run))
(pres:roles rhostyle ELetSeq (inherit inherit run))
(pres:roles rhostyle ELetStar (inherit run))
(pres:roles rhostyle LBindOne (data run))
(pres:roles rhostyle ESend (run data))
(pres:roles rhostyle EArrow (data data))
(pres:roles rhostyle ATMore (data data))
(pres:roles rhostyle ATLast (data))
(pres:roles rhostyle EQuote (data))
(pres:roles rhostyle EPrint (run))
(pres:roles rhostyle EIf (run run run))
(pres:roles rhostyle ECase (run inherit))
(pres:roles rhostyle ArmOne (data run))
(pres:roles rhostyle EMatch (data run run))
(pres:roles rhostyle EForMatch (data run run))
(pres:roles rhostyle EForEach (data run run))
(pres:roles rhostyle EWhile (run run))
(pres:roles rhostyle ERepeat (run))
(pres:roles rhostyle ETransform (inherit run))
(pres:roles rhostyle ETransformInto (inherit data))
(pres:roles rhostyle RcWhereMore (inherit run inherit))
(pres:roles rhostyle RcWhere (inherit run))
(pres:roles rhostyle RLWhereMore (inherit run inherit))
(pres:roles rhostyle RLWhere (inherit run))
(pres:roles rhostyle RTake (data run))
(pres:roles rhostyle RRead (data run))
(pres:roles rhostyle RReadQ (data run))
(pres:roles rhostyle RAbsent (data run data))
(pres:roles rhostyle RLet (data run))
(pres:roles rhostyle RGuard (run))
(pres:roles rhostyle RCollect (inherit data))
(pres:roles rhostyle ECall (run args))
(pres:roles rhostyle EData (data data))
(pres:roles rhostyle ETuple (list))
(pres:look rhostyle ECall run head)
(pres:look rhostyle EData data)
(pres:look rhostyle ETuple data list run head)

(pres:view-guard rhostyle ECall callable-head)
(pres:view-guard rhostyle EData symbol-head)

(pres:channel rhostyle Chan)
(pres:channel rhostyle Dest)
(pres:scope-open rhostyle "select")

(pres:spacing rhostyle "!" tight)
(pres:spacing rhostyle "@" prefix)
(pres:spacing rhostyle "for" spaced)
(pres:spacing rhostyle "foreach" spaced)
(pres:spacing rhostyle "while" spaced)
(pres:spacing rhostyle "if" spaced)
(pres:break-after rhostyle ",")
(pres:break-after rhostyle "&")
(pres:break-after rhostyle "=>")
(pres:break-after rhostyle "|")

(pres:statement rhostyle "Stmt" ";\n")
(pres:leaf-category rhostyle "Exp")
