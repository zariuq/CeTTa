(= (fs:read-text $path)
   (function
     (case (__cetta_lib_fs_read_text $path)
       (($result (return $result))))))

; Structured results: ("ok" text), ("limit" max-bytes), ("missing" cwd),
; ("directory" ""), ("denied" ""), or ("error" class detail).
; 0 means unlimited. Raw preserves bytes; replace repairs malformed UTF-8.
(= (fs:read-text-result $path $max-bytes $errors)
   (function
     (case (__cetta_lib_fs_read_text_result $path $max-bytes $errors)
       (($result (return $result))))))

(= (fs:write $path $text)
   (function
     (case (__cetta_lib_fs_write $path $text)
       (($result (return $result))))))

; POSIX rename changes directory entries, not an open reader's inode. Within
; one filesystem, replacing a name publishes the complete new file at once.
; Cross-filesystem moves fail; there is no copy/delete fallback. The source's
; metadata moves with it. This is visibility atomicity, not crash durability.
(: __cetta_lib_fs_rename (-> Atom Atom Atom))
(: fs:rename (-> %Undefined% %Undefined% Atom))
(= (fs:rename $source $target)
   (function (chain (eval (__cetta_lib_fs_rename $source $target)) $result
     (return $result))))

(= (fs:append-text $path $text)
   (function
     (case (__cetta_lib_fs_append_text $path $text)
       (($result (return $result))))))

(= (fs:exists $path)
   (function
     (case (__cetta_lib_fs_exists $path)
       (($result (return $result))))))

(= (fs:canonical-path $path)
   (function
     (case (__cetta_lib_fs_canonical_path $path)
       (($result (return $result))))))

(= (fs:try-canonical-path $path)
   (function
     (case (__cetta_lib_fs_try_canonical_path $path)
       (($result (return $result))))))

; Resolve a relative path against the directory containing a base file, then
; canonicalize the existing target. Absolute requested paths are accepted
; unchanged. Failure remains data rather than an evaluator error.
(= (fs:try-canonical-from-file $base-file $requested-path)
   (function
     (case
       (__cetta_lib_fs_try_canonical_from_file $base-file $requested-path)
       (($result (return $result))))))

; Resolve a relative path beneath an explicit directory, then canonicalize
; the existing target. This operation performs no environment-variable or
; working-directory search.
(= (fs:try-canonical-under $directory $requested-path)
   (function
     (case (__cetta_lib_fs_try_canonical_under $directory $requested-path)
       (($result (return $result))))))

(= (fs:read-lines $path)
   (function
     (case (__cetta_lib_fs_read_lines $path)
       (($result (return $result))))))

; The complete lines within bytes [start, end) of a file (end -1: its end).
; A range starting inside the file begins at the next line.
(= (fs:read-lines-between $path $start $end)
   (function
     (case (__cetta_lib_fs_read_lines_between $path $start $end)
       (($result (return $result))))))

; Streaming numbered window: ("window" start count more numbered-text empty).
; Tree page: ("page" text more next-offset) or ("not-directory" path).
; Grep page: ("matches" text more next-offset files-scanned errors).
; Page sizes, offsets, recursion depth and skipped names are caller choices.
; Read errors are ("error" detail). Search uses PCRE2 when available.
; Update: ("written" absolute-path bytes sha256-prefix backup-path),
; ("count" occurrences path) for a non-unique edit, or ("error" detail).
; Updates preserve bytes on append, normalize newlines on a strict UTF-8 edit,
; and atomically replace with a collision-free backup in the supplied directory.
; Operation replace is an atomic state-file update without a backup.
(= (fs:line-window $path $start $count)
   (function
     (case (__cetta_lib_fs_line_window $path $start $count)
       (($result (return $result))))))

(= (fs:tree-page $path $depth $limit $offset $skips)
   (function
     (case (__cetta_lib_fs_tree_page $path $depth $limit $offset $skips)
       (($result (return $result))))))

(= (fs:grep-page $pattern $path $limit $offset $skips)
   (function
     (case (__cetta_lib_fs_grep_page $pattern $path $limit $offset $skips)
       (($result (return $result))))))

(= (fs:update-text $path $operation $first $second $backup-directory)
   (function
     (case (__cetta_lib_fs_update_text $path $operation $first $second $backup-directory)
       (($result (return $result))))))

(= (fs:is-file $path)
   (function
     (case (__cetta_lib_fs_is_file $path)
       (($result (return $result))))))

; Seek to the requested tail, repairing invalid UTF-8 as read-text-result does.
; Returns (fs:tail total-bytes truncated text). 0 requests the whole file.
(= (fs:tail-text $path $bytes)
   (function
     (case (__cetta_lib_fs_tail_text $path $bytes)
       (($result (return $result))))))

; Names only, excluding . and ..; errors stay explicit. No implicit page cap.
(= (fs:entries $path)
   (function (case (__cetta_lib_fs_entries $path)
     (($result (return $result))))))

; Entry kind is an enumeration hint. Use metadata for a resolved observation:
; (fs:info KIND SIZE (fs:identity DEVICE INODE)) for the policy follow or
; no-follow; follow-modified and no-follow-modified add (fs:modified SECONDS
; NANOSECONDS), follow-permissions and no-follow-permissions add
; (fs:permissions BITS), Python's stat.S_IMODE of the mode.
; HE's Atom result contract preserves the observation's constructor fields.
; Public operands are computed once; the native receives their data intact.
(: __cetta_lib_fs_metadata (-> Atom Atom Atom))
(: __cetta_lib_fs_open_directory (-> Atom Atom))
(: __cetta_lib_fs_next_entry (-> Atom Atom))
(: __cetta_lib_fs_open_read (-> Atom Atom))
(: __cetta_lib_fs_read_chunk (-> Atom Atom Atom))
(: __cetta_lib_fs_close (-> Atom Atom))
(: fs:metadata (-> %Undefined% %Undefined% Atom))
(: fs:open-directory (-> %Undefined% Atom))
(: fs:next-entry (-> %Undefined% Atom))
(: fs:open-read (-> %Undefined% Atom))
(: fs:read-chunk (-> %Undefined% %Undefined% Atom))
(: fs:close (-> %Undefined% Atom))
(= (fs:metadata $path $links)
   (function (chain (eval (__cetta_lib_fs_metadata $path $links)) $result
     (return $result))))

(= (fs:open-directory $path)
   (function (chain (eval (__cetta_lib_fs_open_directory $path)) $result
     (return $result))))

(= (fs:next-entry $owner)
   (function (chain (eval (__cetta_lib_fs_next_entry $owner)) $result
     (return $result))))

(= (fs:open-read $path)
   (function (chain (eval (__cetta_lib_fs_open_read $path)) $result
     (return $result))))

; A zero-size request is an empty chunk, not an end observation. Aliases share
; position; independently opened owners do not. Faults retain known progress.
(= (fs:read-chunk $owner $count)
   (function (chain (eval (__cetta_lib_fs_read_chunk $owner $count)) $result
     (return $result))))

(= (fs:close $owner)
   (function (chain (eval (__cetta_lib_fs_close $owner)) $result
     (return $result))))

; A writer owns a descriptor opened as Python's os.open opens one for writing.
; flags lists "append", "create", "truncate" and "exclusive"; mode is the
; creation mode, which the umask narrows (384 is 0o600, 438 is 0o666).
; write-all writes every byte of a text and answers (fs:written bytes); a
; fault keeps the owner open and its progress counts the owner's bytes in all.
; sync is fsync, including an owned directory after publishing a rename.
; lock takes exclusive or shared, waiting for a conflicting
; holder, as fcntl.flock does; exclusive-nowait and shared-nowait answer
; fs:held at once instead. unlock releases it. set-mode is os.fchmod,
; answering fs:mode-set; given a path instead of an owner it is os.chmod, which
; follows a symbolic link. Syncing, setting the mode, locking and closing accept
; readers too. Closing, the last holder's release, or the
; process's end closes the descriptor, which releases its lock.
(: __cetta_lib_fs_open_write (-> Atom Atom Atom Atom))
(: __cetta_lib_fs_write_all (-> Atom Atom Atom))
(: __cetta_lib_fs_sync (-> Atom Atom))
(: __cetta_lib_fs_lock (-> Atom Atom Atom))
(: __cetta_lib_fs_unlock (-> Atom Atom))
(: __cetta_lib_fs_set_mode (-> Atom Atom Atom))
(: fs:open-write (-> %Undefined% %Undefined% %Undefined% Atom))
(: fs:write-all (-> %Undefined% %Undefined% Atom))
(: fs:sync (-> %Undefined% Atom))
(: fs:lock (-> %Undefined% %Undefined% Atom))
(: fs:unlock (-> %Undefined% Atom))
(: fs:set-mode (-> %Undefined% %Undefined% Atom))
(= (fs:open-write $path $flags $mode)
   (function (chain (eval (__cetta_lib_fs_open_write $path $flags $mode)) $result
     (return $result))))

(= (fs:write-all $owner $text)
   (function (chain (eval (__cetta_lib_fs_write_all $owner $text)) $result
     (return $result))))

(= (fs:sync $owner)
   (function (chain (eval (__cetta_lib_fs_sync $owner)) $result
     (return $result))))

(= (fs:lock $owner $mode)
   (function (chain (eval (__cetta_lib_fs_lock $owner $mode)) $result
     (return $result))))

(= (fs:unlock $owner)
   (function (chain (eval (__cetta_lib_fs_unlock $owner)) $result
     (return $result))))

(= (fs:set-mode $owner $mode)
   (function (chain (eval (__cetta_lib_fs_set_mode $owner $mode)) $result
     (return $result))))

; os.unlink: () or (fs:failed ...) with the errno, a directory included.
; os.access: True when access(2) grants the real user every named permission,
; "read", "write" and "execute", or, naming none, when the path exists. A
; refusal is False, never a failure.
(: __cetta_lib_fs_remove (-> Atom Atom))
(: __cetta_lib_fs_access (-> Atom Atom Atom))
(: fs:remove (-> %Undefined% Atom))
(: fs:access (-> %Undefined% %Undefined% Atom))
(= (fs:remove $path)
   (function (chain (eval (__cetta_lib_fs_remove $path)) $result
     (return $result))))

(= (fs:access $path $permissions)
   (function (chain (eval (__cetta_lib_fs_access $path $permissions)) $result
     (return $result))))

; Path.mkdir(mode, parents=True, exist_ok=True) as Python 3.12 runs it: missing
; parents get mode 0777 (511) and the last directory the given mode, both
; narrowed by the umask. An existing directory is accepted; any other refusal
; is (fs:failed ...) naming the directory whose mkdir refused.
(: __cetta_lib_fs_make_directories (-> Atom Atom Atom))
(: fs:make-directories (-> %Undefined% %Undefined% Atom))
(= (fs:make-directories $path $mode)
   (function (chain (eval (__cetta_lib_fs_make_directories $path $mode)) $result
     (return $result))))

; A walker owns every open directory in its traversal. current observes the
; pending entry without advancing; step applies one explicit descent decision.
(: __cetta_lib_fs_walk_open (-> Atom Atom))
(: __cetta_lib_fs_walk_current (-> Atom Atom))
(: __cetta_lib_fs_walk_step (-> Atom Atom Atom))
(: __cetta_lib_fs_walk_metadata (-> Atom Atom Atom))
(: fs:walk-open (-> %Undefined% Atom))
(: fs:walk-current (-> %Undefined% Atom))
(: fs:walk-step (-> %Undefined% %Undefined% Atom))
(: fs:walk-metadata (-> %Undefined% %Undefined% Atom))
(= (fs:walk-open $path)
   (function (chain (eval (__cetta_lib_fs_walk_open $path)) $result
     (return $result))))
(= (fs:walk-current $owner)
   (function (chain (eval (__cetta_lib_fs_walk_current $owner)) $result
     (return $result))))
(= (fs:walk-step $owner $action)
   (function (chain (eval (__cetta_lib_fs_walk_step $owner $action)) $result
     (return $result))))
(= (fs:walk-metadata $owner $links)
   (function (chain (eval (__cetta_lib_fs_walk_metadata $owner $links)) $result
     (return $result))))

; exclusions is a tuple of basenames. Only missing entries are skipped after
; a metadata/descent race; other faults remain observations for the caller.
; Structural decomposition keeps callable observation constructors inert.
(: fs:walk-next (-> %Undefined% %Undefined% Atom %Undefined%))
(= (fs:walk-next $owner $links $exclusions)
  (if (or (== $links follow) (== $links no-follow))
    (let $current (fs:walk-current $owner)
      (fs:walk-follow-current $owner $links $exclusions $current))
    (fs:walk-metadata $owner $links)))
(: fs:walk-excluded (-> Atom Atom %Undefined%))
(= (fs:walk-excluded $name $exclusions)
  (case $exclusions
    ((() False)
     ($nonempty (let ($first $rest) (decons-atom $nonempty)
       (if (== $first $name) True (fs:walk-excluded $name $rest)))))))
(: fs:walk-follow-current (-> Atom Atom Atom Atom %Undefined%))
(: fs:walk-publish (-> Atom %Undefined%))
(= (fs:walk-publish $current)
  (let ($head $fields) (decons-atom $current) (fs:walk-cons $head $fields)))
(: fs:walk-cons (-> Atom Atom Atom))
(= (fs:walk-cons $head $fields)
  (function (chain (eval (cons-atom $head $fields)) $result (return $result))))
(: fs:walk-advance (-> Atom %Undefined% Atom Atom %Undefined%))
(= (fs:walk-advance $owner $action $links $exclusions)
  (let $next (fs:walk-step $owner $action)
    (fs:walk-selected $owner $links $exclusions $next)))
(= (fs:walk-follow-current $owner $links $exclusions $current)
  (if (== $current fs:walk-ready)
    (fs:walk-advance $owner skip $links $exclusions)
    (let ($head $fields) (decons-atom $current)
      (case $head
        ((fs:walk-entry
          (let ($path $relative $name $hint $index) $fields
            (if (fs:walk-excluded $name $exclusions)
              (fs:walk-advance $owner skip $links $exclusions)
              (let $info (fs:walk-metadata $owner $links)
                (let ($kind $details) (decons-atom $info)
                  (case $kind
                    ((fs:info
                      (let ($type $size $identity) $details
                        (fs:walk-advance $owner
                            (if (== $type directory)
                              (if (== $links follow) descend-follow descend) skip)
                          $links $exclusions)))
                     (fs:failed
                      (let ($reason $operation $failed-path $code $progress $message) $details
                        (if (== $reason fs:missing)
                          (fs:walk-advance $owner skip $links $exclusions)
                          (fs:walk-publish $info)))))))))))
         ($other (fs:walk-publish $current)))))))
(: fs:walk-selected (-> Atom Atom Atom Atom %Undefined%))
(= (fs:walk-selected $owner $links $exclusions $current)
  (let ($head $fields) (decons-atom $current)
    (case $head
      ((fs:walk-entry
        (let ($path $relative $name $hint $index) $fields
          (if (fs:walk-excluded $name $exclusions)
            (fs:walk-advance $owner skip $links $exclusions)
            (fs:walk-publish $current))))
       (fs:failed
        (let ($reason $operation $path $code $progress $message) $fields
          (let ($progress-head $progress-fields) (decons-atom $progress)
            (let ($observed $position) $progress-fields
              (if (and (== $reason fs:missing) (== $position known-position))
                (fs:walk-advance $owner skip $links $exclusions)
                (fs:walk-publish $current))))))
       ($other (fs:walk-publish $current))))))

; A versioned metadata observation; old fs:metadata tuples are unchanged.
; The extra fields are modification/change times, permissions and allocated
; blocks in POSIX 512-byte units. Follow policy is explicit.
(: fs:metadata-v2 (-> %Undefined% %Undefined% Atom))
(= (fs:metadata-v2 $path $links)
   (case $links
     ((follow (fs:metadata $path follow-observed))
      (no-follow (fs:metadata $path no-follow-observed))
      ($bad (fs:failed fs:invalid-argument metadata-v2 "" 0 (fs:progress 0 known-position) "expected follow or no-follow")))))
; Stream a regular file with bounded buffering. A changed file/path refuses;
; success is (fs:hashed-v1 HEX (fs:info-v2 ...)). No digest is returned for a
; partial read. This does not claim an immutable filesystem snapshot.
(: fs:sha256-file (-> %Undefined% Atom))
(= (fs:sha256-file $path)
   (function (chain (eval (__cetta_lib_fs_metadata $path content-sha256)) $result (return $result))))
