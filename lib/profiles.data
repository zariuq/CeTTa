(cesta-tables/1
  (Table Languages
    (Columns (Column code Identifier) (Column id Nat))
    (Key code)
    (Unique id)
    (Rows
      (Row CETTA_LANGUAGE_HE 0)
      (Row CETTA_LANGUAGE_MM2 1)
      (Row CETTA_LANGUAGE_PETTA 2)
      (Row CETTA_LANGUAGE_AMBIENT 3)
      (Row CETTA_LANGUAGE_CALCULATOR 4)
      (Row CETTA_LANGUAGE_IMP 5)
      (Row CETTA_LANGUAGE_LAMBDA 6)
      (Row CETTA_LANGUAGE_METTAFULL_LEGACY 7)
      (Row CETTA_LANGUAGE_MINSKYLITE 8)
      (Row CETTA_LANGUAGE_MM0LITE 9)
      (Row CETTA_LANGUAGE_PYASHCORE 10)
      (Row CETTA_LANGUAGE_RHOCALC 11)
      (Row CETTA_LANGUAGE_PRIME 12)
      (Row CETTA_LANGUAGE_SUBZERO 13)
      (Row CETTA_LANGUAGE_ZERO 14)
      (Row CETTA_LANGUAGE_GSLT_IL 15)
      (Row CETTA_LANGUAGE_ZEROUV 16)
      (Row CETTA_LANGUAGE_METTA_INTERACT 17)
      (Row CETTA_LANGUAGE_HOL_LIGHT 18)
    ))
  (Table Versions
    (Columns (Column code Identifier) (Column id Nat))
    (Key code)
    (Unique id)
    (Rows
      (Row CETTA_LANGUAGE_VERSION_NONE 0)
      (Row CETTA_LANGUAGE_VERSION_PETTA_STABLE 6)
      (Row CETTA_LANGUAGE_VERSION_PETTA_1_1 2)
      (Row CETTA_LANGUAGE_VERSION_PRIME_0_0_1 3)
      (Row CETTA_LANGUAGE_VERSION_HE_0_2_10 4)
      (Row CETTA_LANGUAGE_VERSION_PETTA_1_1_C 5)
    ))
  (Table Profiles
    (Columns (Column id Nat) (Column code Identifier) (Column object Identifier) (Column language (Ref Languages code)) (Column name Text) (Column note Text) (Column he Bool) (Column extensions Bool) (Column dependent Bool) (Column rust Bool) (Column version (Ref Versions code)) (Column identity Identifier) (Column self Identifier) (Column quote Bool) (Column group (Enum before typing after hol)))
    (Key id)
    (Unique code)
    (Unique object)
    (Unique language name)
    (Rows
      (Row 0 CETTA_PROFILE_HE_FORMAL CETTA_PROFILE_HE_FORMAL_VALUE CETTA_LANGUAGE_HE "he" "Hyperon Experimental 0.2.10 with CeTTa's deliberate differences; the default." true false false false CETTA_LANGUAGE_VERSION_HE_0_2_10 CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false before)
      (Row 1 CETTA_PROFILE_HE_COMPAT CETTA_PROFILE_HE_COMPAT_VALUE CETTA_LANGUAGE_HE "he-compat" "Rust Hyperon Experimental 0.2.10's behavior, also where he differs." true false false true CETTA_LANGUAGE_VERSION_HE_0_2_10 CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false before)
      (Row 2 CETTA_PROFILE_HE_EXTENDED CETTA_PROFILE_HE_EXTENDED_VALUE CETTA_LANGUAGE_HE "extended" "HE-compatible syntax plus labeled CeTTa extensions." true true false false CETTA_LANGUAGE_VERSION_HE_0_2_10 CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false before)
      (Row 3 CETTA_PROFILE_HE_PRIME CETTA_PROFILE_HE_PRIME_VALUE CETTA_LANGUAGE_HE "he-prime" "HE typing with explicit dependent binders, checked type-level computation, and typed inhabitation search." false true true false CETTA_LANGUAGE_VERSION_HE_0_2_10 CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false before)
      (Row 6 CETTA_PROFILE_PRIME_DEFAULT CETTA_PROFILE_PRIME_DEFAULT_VALUE CETTA_LANGUAGE_PRIME "prime-default" "Built-in policy for the MeTTa-Prime semantic package." false true true false CETTA_LANGUAGE_VERSION_PRIME_0_0_1 CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false before)
      ; Four identity profiles of the draft: the same programs run under each so
      ; that the identity decision family can be tested rather than argued.
      (Row 15 CETTA_PROFILE_PRIME_IDENTITY_J CETTA_PROFILE_PRIME_IDENTITY_J_VALUE CETTA_LANGUAGE_PRIME "identity-j" "Identity elimination with one iota rule; every route retained." false true true false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false before)
      (Row 16 CETTA_PROFILE_PRIME_IDENTITY_SCOPED CETTA_PROFILE_PRIME_IDENTITY_SCOPED_VALUE CETTA_LANGUAGE_PRIME "identity-scoped" "Identity elimination plus uniqueness of routes inside declared regions." false true true false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_SCOPED CETTA_CONTEXT_SELF_PROGRAM false before)
      (Row 17 CETTA_PROFILE_PRIME_IDENTITY_UIP CETTA_PROFILE_PRIME_IDENTITY_UIP_VALUE CETTA_LANGUAGE_PRIME "identity-uip" "Uniqueness of identity routes everywhere." false true true false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_UIP CETTA_CONTEXT_SELF_PROGRAM false before)
      (Row 18 CETTA_PROFILE_PRIME_IDENTITY_UNIVALENCE CETTA_PROFILE_PRIME_IDENTITY_UNIVALENCE_VALUE CETTA_LANGUAGE_PRIME "identity-univalence" "Identity elimination, declared regions, and the univalence guest declarations without computation." false true true false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_UNIVALENCE CETTA_CONTEXT_SELF_PROGRAM false before)
      (Row 19 CETTA_PROFILE_PRIME_CONTEXT_SELF_HOME CETTA_PROFILE_PRIME_CONTEXT_SELF_HOME_VALUE CETTA_LANGUAGE_PRIME "context-self-home" "Inside captured code, &self is the space the code was captured in." false true true false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_HOME false before)
      (Row 20 CETTA_PROFILE_PRIME_CONTEXT_SELF_HERE CETTA_PROFILE_PRIME_CONTEXT_SELF_HERE_VALUE CETTA_LANGUAGE_PRIME "context-self-here" "&self is the space the current evaluation is in." false true true false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_HERE false before)
      ; An explicit opt-in bubble, never the default: substitution enters
      ; quotations, as HE's does, so a quoted parameter captures its argument as
      ; written.  One variable can then name two things in one body, and the
      ; answer depends on the evaluation route (SealedCode.asWritten_incoherent).
      (Row 21 CETTA_PROFILE_PRIME_QUOTE_AS_WRITTEN CETTA_PROFILE_PRIME_QUOTE_AS_WRITTEN_VALUE CETTA_LANGUAGE_PRIME "quote-as-written" "Opt-in: substitution enters quotations and quoted parameters capture their arguments as written." false true true false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM true before)
      (Row 7 CETTA_PROFILE_PETTA_EXTENDED CETTA_PROFILE_PETTA_EXTENDED_VALUE CETTA_LANGUAGE_PETTA "extended" "Corrected stable PeTTa plus labeled shared CeTTa extensions." false true false false CETTA_LANGUAGE_VERSION_PETTA_STABLE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false before)
      (Row 22 CETTA_PROFILE_PETTA_1_1_C CETTA_PROFILE_PETTA_1_1_C_VALUE CETTA_LANGUAGE_PETTA "petta@1.1.c" "PeTTa's typed line with declarations as call contracts: a failed check raises on every route." false false false false CETTA_LANGUAGE_VERSION_PETTA_1_1_C CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false before)
      (Row 8 CETTA_PROFILE_PETTA_TYPECHECK_V2 CETTA_PROFILE_PETTA_TYPECHECK_V2_VALUE CETTA_LANGUAGE_PETTA "typecheck-v2" "PeTTa with native Roman-compatible residual type checking." false true false false CETTA_LANGUAGE_VERSION_PETTA_1_1 CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false typing)
      (Row 13 CETTA_PROFILE_PETTA_TYPECHECK_V3 CETTA_PROFILE_PETTA_TYPECHECK_V3_VALUE CETTA_LANGUAGE_PETTA "typecheck-v3" "PeTTa with native v3 judgments and coherent typecheck-v2 delegation." false true false false CETTA_LANGUAGE_VERSION_PETTA_1_1 CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false typing)
      (Row 4 CETTA_PROFILE_RHOCALC_STRICT_CORE CETTA_PROFILE_RHOCALC_STRICT_CORE_VALUE CETTA_LANGUAGE_RHOCALC "strict-core" "Strict-core rho-calculus without cost-layer extensions." false false false false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false after)
      (Row 5 CETTA_PROFILE_RHOCALC_COST CETTA_PROFILE_RHOCALC_COST_VALUE CETTA_LANGUAGE_RHOCALC "cost" "Meredith cost-accounted rho extension (ground-signature token-gated slice)." false false false false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false after)
      (Row 14 CETTA_PROFILE_RHOCALC_RHOMETTA CETTA_PROFILE_RHOCALC_RHOMETTA_VALUE CETTA_LANGUAGE_RHOCALC "rhometta" "Rho-calculus with inert MeTTa values and transactional COMM-time payload evaluation." false true false false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false after)
      (Row 9 CETTA_PROFILE_ZERO_EXP CETTA_PROFILE_ZERO_EXP_VALUE CETTA_LANGUAGE_ZERO "exp" "Experimental authored semantic work and continuation layer." false false false false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false after)
      (Row 11 CETTA_PROFILE_ZERO_EMIT CETTA_PROFILE_ZERO_EMIT_VALUE CETTA_LANGUAGE_ZERO "emit" "Experimental revision-threaded match/let/eval/emit profile; add-atom is the persistent-emission compatibility spelling." false false false false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false after)
      (Row 12 CETTA_PROFILE_ZERO_INTERACT CETTA_PROFILE_ZERO_INTERACT_VALUE CETTA_LANGUAGE_ZERO "interact" "Experimental match/let/eval/emit profile over authenticated immutable space revisions; add-atom is an emit alias." false false false false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false after)
      (Row 10 CETTA_PROFILE_MM2_GSLT CETTA_PROFILE_MM2_GSLT_VALUE CETTA_LANGUAGE_MM2 "gslt" "Authored strict support-transform GSLT with open-world directives and exact fuel." false false false false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false after)
      (Row 23 CETTA_PROFILE_HOL_STANDARD CETTA_PROFILE_HOL_STANDARD_VALUE CETTA_LANGUAGE_HOL_LIGHT "standard" "Default: permit only checked HOL Light standard axioms." false false false false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false hol)
      (Row 24 CETTA_PROFILE_HOL_OPEN CETTA_PROFILE_HOL_OPEN_VALUE CETTA_LANGUAGE_HOL_LIGHT "open" "Permit explicit user axioms and retain their dependencies." false false false false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false hol)
      (Row 25 CETTA_PROFILE_HOL_SEALED CETTA_PROFILE_HOL_SEALED_VALUE CETTA_LANGUAGE_HOL_LIGHT "sealed" "Permit no new axioms." false false false false CETTA_LANGUAGE_VERSION_NONE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false hol)
      (Row 26 CETTA_PROFILE_PETTA_AI CETTA_PROFILE_PETTA_AI_VALUE CETTA_LANGUAGE_PETTA "ai" "Corrected stable PeTTa with sealed sorts: a function's declaration types its calls' answers, never an unevaluated application of it." false false false false CETTA_LANGUAGE_VERSION_PETTA_STABLE CETTA_IDENTITY_POLICY_J CETTA_CONTEXT_SELF_PROGRAM false before)
    )))
