(cesta-tables/1
  (Table Languages
    (Columns (Column code Identifier) (Column id Nat))
    (Key code)
    (Unique id)
    (Rows
      (Row CETTA_LANGUAGE_HE 0)
      (Row CETTA_LANGUAGE_MM2 1)
      (Row CETTA_LANGUAGE_PETTA 2)
      (Row CETTA_LANGUAGE_AMBIENT 3)
      (Row CETTA_LANGUAGE_CALCULATOR 4)
      (Row CETTA_LANGUAGE_IMP 5)
      (Row CETTA_LANGUAGE_LAMBDA 6)
      (Row CETTA_LANGUAGE_METTAFULL_LEGACY 7)
      (Row CETTA_LANGUAGE_MINSKYLITE 8)
      (Row CETTA_LANGUAGE_MM0LITE 9)
      (Row CETTA_LANGUAGE_PYASHCORE 10)
      (Row CETTA_LANGUAGE_RHOCALC 11)
      (Row CETTA_LANGUAGE_PRIME 12)
      (Row CETTA_LANGUAGE_SUBZERO 13)
      (Row CETTA_LANGUAGE_ZERO 14)
      (Row CETTA_LANGUAGE_GSLT_IL 15)
      (Row CETTA_LANGUAGE_ZEROUV 16)
      (Row CETTA_LANGUAGE_METTA_INTERACT 17)
      (Row CETTA_LANGUAGE_HOL_LIGHT 18)
    ))
  (Table Versions
    (Columns (Column code Identifier) (Column id Nat))
    (Key code)
    (Unique id)
    (Rows
      (Row CETTA_LANGUAGE_VERSION_NONE 0)
      (Row CETTA_LANGUAGE_VERSION_PETTA_STABLE 6)
      (Row CETTA_LANGUAGE_VERSION_PETTA_1_1 2)
      (Row CETTA_LANGUAGE_VERSION_PRIME_0_0_1 3)
      (Row CETTA_LANGUAGE_VERSION_HE_0_2_10 4)
      (Row CETTA_LANGUAGE_VERSION_PETTA_1_1_C 5)
    ))
  (Table Profiles
    (Columns (Column id Nat) (Column code Identifier) (Column object Identifier) (Column language (Ref Languages code)) (Column name Text) (Column note Text) (Column he Bool) (Column extensions Bool) (Column dependent Bool) (Column rust Bool) (Column version (Ref Versions code)) (Column group (Enum before typing after hol)))
    (Key id)
    (Unique code)
    (Unique object)
    (Unique language name)
    (Rows
      (Row 0 CETTA_PROFILE_HE_FORMAL CETTA_PROFILE_HE_FORMAL_VALUE CETTA_LANGUAGE_HE "he" "Hyperon Experimental 0.2.10 with CeTTa's deliberate differences; the default." true false false false CETTA_LANGUAGE_VERSION_HE_0_2_10 before)
      (Row 1 CETTA_PROFILE_HE_COMPAT CETTA_PROFILE_HE_COMPAT_VALUE CETTA_LANGUAGE_HE "he-compat" "Rust Hyperon Experimental 0.2.10's behavior, also where he differs." true false false true CETTA_LANGUAGE_VERSION_HE_0_2_10 before)
      (Row 2 CETTA_PROFILE_HE_EXTENDED CETTA_PROFILE_HE_EXTENDED_VALUE CETTA_LANGUAGE_HE "extended" "HE-compatible syntax plus labeled CeTTa extensions." true true false false CETTA_LANGUAGE_VERSION_HE_0_2_10 before)
      (Row 3 CETTA_PROFILE_HE_PRIME CETTA_PROFILE_HE_PRIME_VALUE CETTA_LANGUAGE_HE "he-prime" "HE typing with explicit dependent binders, checked type-level computation, and typed inhabitation search." false true true false CETTA_LANGUAGE_VERSION_HE_0_2_10 before)
      (Row 6 CETTA_PROFILE_PRIME_DEFAULT CETTA_PROFILE_PRIME_DEFAULT_VALUE CETTA_LANGUAGE_PRIME "prime-default" "Frozen MeTTa-Prime 0.0.1 draft policy." false true true false CETTA_LANGUAGE_VERSION_PRIME_0_0_1 before)
      (Row 7 CETTA_PROFILE_PETTA_EXTENDED CETTA_PROFILE_PETTA_EXTENDED_VALUE CETTA_LANGUAGE_PETTA "extended" "Corrected stable PeTTa plus labeled shared CeTTa extensions." false true false false CETTA_LANGUAGE_VERSION_PETTA_STABLE before)
      (Row 15 CETTA_PROFILE_PETTA_1_1_C CETTA_PROFILE_PETTA_1_1_C_VALUE CETTA_LANGUAGE_PETTA "petta@1.1.c" "PeTTa's typed line with declarations as call contracts: a failed check raises on every route." false false false false CETTA_LANGUAGE_VERSION_PETTA_1_1_C before)
      (Row 19 CETTA_PROFILE_PETTA_AI CETTA_PROFILE_PETTA_AI_VALUE CETTA_LANGUAGE_PETTA "ai" "Corrected stable PeTTa with sealed sorts: a function's declaration types its calls' answers, never an unevaluated application of it." false false false false CETTA_LANGUAGE_VERSION_PETTA_STABLE before)
      (Row 8 CETTA_PROFILE_PETTA_TYPECHECK_V2 CETTA_PROFILE_PETTA_TYPECHECK_V2_VALUE CETTA_LANGUAGE_PETTA "typecheck-v2" "PeTTa with native Roman-compatible residual type checking." false true false false CETTA_LANGUAGE_VERSION_PETTA_1_1 typing)
      (Row 13 CETTA_PROFILE_PETTA_TYPECHECK_V3 CETTA_PROFILE_PETTA_TYPECHECK_V3_VALUE CETTA_LANGUAGE_PETTA "typecheck-v3" "PeTTa with native v3 judgments and coherent typecheck-v2 delegation." false true false false CETTA_LANGUAGE_VERSION_PETTA_1_1 typing)
      (Row 4 CETTA_PROFILE_RHOCALC_STRICT_CORE CETTA_PROFILE_RHOCALC_STRICT_CORE_VALUE CETTA_LANGUAGE_RHOCALC "strict-core" "Strict-core rho-calculus without cost-layer extensions." false false false false CETTA_LANGUAGE_VERSION_NONE after)
      (Row 5 CETTA_PROFILE_RHOCALC_COST CETTA_PROFILE_RHOCALC_COST_VALUE CETTA_LANGUAGE_RHOCALC "cost" "Meredith cost-accounted rho extension (ground-signature token-gated slice)." false false false false CETTA_LANGUAGE_VERSION_NONE after)
      (Row 14 CETTA_PROFILE_RHOCALC_RHOMETTA CETTA_PROFILE_RHOCALC_RHOMETTA_VALUE CETTA_LANGUAGE_RHOCALC "rhometta" "Rho-calculus with inert MeTTa values and transactional COMM-time payload evaluation." false true false false CETTA_LANGUAGE_VERSION_NONE after)
      (Row 9 CETTA_PROFILE_ZERO_EXP CETTA_PROFILE_ZERO_EXP_VALUE CETTA_LANGUAGE_ZERO "exp" "Experimental authored semantic work and continuation layer." false false false false CETTA_LANGUAGE_VERSION_NONE after)
      (Row 11 CETTA_PROFILE_ZERO_EMIT CETTA_PROFILE_ZERO_EMIT_VALUE CETTA_LANGUAGE_ZERO "emit" "Experimental revision-threaded match/let/eval/emit profile; add-atom is the persistent-emission compatibility spelling." false false false false CETTA_LANGUAGE_VERSION_NONE after)
      (Row 12 CETTA_PROFILE_ZERO_INTERACT CETTA_PROFILE_ZERO_INTERACT_VALUE CETTA_LANGUAGE_ZERO "interact" "Experimental match/let/eval/emit profile over authenticated immutable space revisions; add-atom is an emit alias." false false false false CETTA_LANGUAGE_VERSION_NONE after)
      (Row 10 CETTA_PROFILE_MM2_GSLT CETTA_PROFILE_MM2_GSLT_VALUE CETTA_LANGUAGE_MM2 "gslt" "Authored strict support-transform GSLT with open-world directives and exact fuel." false false false false CETTA_LANGUAGE_VERSION_NONE after)
      (Row 16 CETTA_PROFILE_HOL_STANDARD CETTA_PROFILE_HOL_STANDARD_VALUE CETTA_LANGUAGE_HOL_LIGHT "standard" "Default: permit only checked HOL Light standard axioms." false false false false CETTA_LANGUAGE_VERSION_NONE hol)
      (Row 17 CETTA_PROFILE_HOL_OPEN CETTA_PROFILE_HOL_OPEN_VALUE CETTA_LANGUAGE_HOL_LIGHT "open" "Permit explicit user axioms and retain their dependencies." false false false false CETTA_LANGUAGE_VERSION_NONE hol)
      (Row 18 CETTA_PROFILE_HOL_SEALED CETTA_PROFILE_HOL_SEALED_VALUE CETTA_LANGUAGE_HOL_LIGHT "sealed" "Permit no new axioms." false false false false CETTA_LANGUAGE_VERSION_NONE hol)
    )))
