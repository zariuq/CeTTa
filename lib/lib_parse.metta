; ============ lib_parse v2 : GSLT-scale invertible parsing, domain-agnostic ============
; ONE grammar-generic engine. Same code parses logic, bio sequences, tensor arrays, ...
; TRUST BOUNDARY:  p-all / lp-parse-raw = UNTRUSTED search (returns a FOREST, never theoremhood)
;                  lp-lower / lp-admit / lp-print / lp-parse-cert = TRUSTED, total, fail-closed.

; ---- total list utils ----
(= (app2 Nil $y) $y)
(= (app2 (Cons $x $xs) $y) (Cons $x (app2 $xs $y)))
(= (hd2 (Cons $x $r)) $x)
(= (tl2 (Cons $x $r)) $r)
(= (memb $x Nil) False)
(= (memb $x (Cons $y $ys)) (if (== $x $y) True (memb $x $ys)))
(= (rev $l) (rev2 $l Nil)) (= (rev2 Nil $a) $a) (= (rev2 (Cons $x $r) $a) (rev2 $r (Cons $x $a)))
(= (issingle (Cons $x Nil)) True) (= (issingle (Cons $x (Cons $y $r))) False) (= (issingle Nil) False)
(= (starts-with Nil $c) False) (= (starts-with (Cons $x $r) $c) (== $x $c))
(= (all-distinct Nil) True) (= (all-distinct (Cons $x $r)) (if (memb $x $r) False (all-distinct $r)))
(= (not True) False) (= (not False) True)
(= (and True $x) $x) (= (and False $x) False)
(= (not-err $x) (case $x (((Err $y) False) ($z True))))
(= (is-err $x) (case $x (((Err $y) True) ($z False))))
(= (mkL $e) (if (== $e ()) Nil (mkL2 (decons-atom $e)))) (= (mkL2 ($h $t)) (Cons $h (mkL $t)))

; ---- total grammar-shape checks for trusted APIs ----
(= (tpltok-ok $t)
   (case $t (((Tm $c) True) ((Hl $nt) True) ((HlB $nt $scope) True) ($o False))))
(= (tpl-ok $tpl)
   (case $tpl ((Nil True) ((Cons $t $r) (and (tpltok-ok $t) (tpl-ok $r))) ($o False))))
(= (g-entry-ok $e)
   (case $e (((VarD $v $nt) True) ((Prod $l $nt $tpl) (tpl-ok $tpl)) ($o False))))
(= (g-ok $g)
   (case $g ((Nil True) ((Cons $e $r) (and (g-entry-ok $e) (g-ok $r))) ($o False))))

; ---- grammar = finite data. entries: (Prod label nt template) | (VarD var nt) ----
; template tokens: (Tm const) | (Hl nt) | (HlB nt scope)
; HlB marks a binder-position child parsed as nt; the trusted lowering path turns it into
; canonical binder form and scopes the next matching body-hole of nonterminal scope.
(= (template-of (Cons (Prod $l $nt $tpl) $r) $q) (if (== $l $q) $tpl (template-of $r $q)))
(= (template-of (Cons (VarD $v $nt) $r) $q) (template-of $r $q))
(= (template-of Nil $q) (Err notmpl))
(= (prod-nt (Cons (Prod $l $nt $tpl) $r) $q) (if (== $l $q) $nt (prod-nt $r $q)))
(= (prod-nt (Cons (VarD $v $nt) $r) $q) (prod-nt $r $q))
(= (prod-nt Nil $q) (Err noprod))
(= (var-nt (Cons (VarD $v $nt) $r) $q) (if (== $v $q) $nt (var-nt $r $q)))
(= (var-nt (Cons (Prod $a $b $c) $r) $q) (var-nt $r $q))
(= (var-nt Nil $q) (Err novar))
(= (is-var $g $v) (not-err (var-nt $g $v)))
(= (prods-for (Cons (Prod $l $nt $tpl) $r) $q) (if (== $nt $q) (Cons (Prod $l $nt $tpl) (prods-for $r $q)) (prods-for $r $q)))
(= (prods-for (Cons (VarD $v $nt) $r) $q) (prods-for $r $q))
(= (prods-for Nil $q) Nil)

; =============== UNTRUSTED L2: p-all — full forest enumerator (all parses) ===============
; bounded for non-left-cyclic grammars: a non-trailing hole takes a PROPER prefix (>=1, leaves >=1).
(= (p-all $g $nt $toks) (if (== $toks Nil) Nil (p-all-ne $g $nt $toks)))
(= (p-all-ne $g $nt $toks) (app2 (var-parses $g $nt $toks) (prod-parses $g $nt $toks (prods-for $g $nt))))
(= (var-parses $g $nt $toks) (if (issingle $toks) (vp2 $g $nt (hd2 $toks)) Nil))
(= (vp2 $g $nt $v) (if (is-var $g $v) (if (== (var-nt $g $v) $nt) (Cons (Lf $v) Nil) Nil) Nil))
(= (prod-parses $g $nt $toks Nil) Nil)
(= (prod-parses $g $nt $toks (Cons (Prod $l $pnt $tpl) $rest))
   (app2 (label-trees $l (m-all $g $tpl $toks)) (prod-parses $g $nt $toks $rest)))
(= (label-trees $l Nil) Nil)
(= (label-trees $l (Cons $kids $rest)) (Cons (Nd $l $kids) (label-trees $l $rest)))
; m-all: list of kid-lists that fully consume toks
(= (m-all $g Nil $toks) (if (== $toks Nil) (Cons Nil Nil) Nil))
(= (m-all $g (Cons (Tm $c) $r) $toks) (if (starts-with $toks $c) (m-all $g $r (tl2 $toks)) Nil))
(= (m-all $g (Cons (Hl $nt) $r) $toks) (hole-all $g $nt $r $toks))
(= (m-all $g (Cons (HlB $nt $scope) $r) $toks) (hole-all $g $nt $r $toks))
(= (depth-adj $t $d) (if (== $t LP) (+ $d 1) (if (== $t RP) (- $d 1) $d)))
(= (hole-all $g $nt Nil $toks) (kids1 (p-all $g $nt $toks)))
(= (kids1 Nil) Nil) (= (kids1 (Cons $t $r)) (Cons (Cons $t Nil) (kids1 $r)))
; hole followed by a TERMINAL: split only at that terminal's depth-0 occurrences (fast; all => ambiguity)
(= (hole-all $g $nt (Cons (Tm $c) $rr) $toks) (dsplit $g $nt (Cons (Tm $c) $rr) $c $toks 0 Nil))
; hole followed by a HOLE (no delimiter): fall back to full proper-prefix enumeration (rare)
(= (hole-all $g $nt (Cons (Hl $h) $rr) $toks) (sloop $g $nt (Cons (Hl $h) $rr) (Cons (hd2 $toks) Nil) (tl2 $toks)))
(= (dsplit $g $nt $rtpl $c Nil $d $prerev) Nil)
(= (dsplit $g $nt $rtpl $c (Cons $x $rest) $d $prerev)
   (if (and (== $d 0) (== $x $c))
       (app2 (combine (p-all $g $nt (rev $prerev)) $g $rtpl (Cons $x $rest))
             (dsplit $g $nt $rtpl $c $rest (depth-adj $x $d) (Cons $x $prerev)))
       (dsplit $g $nt $rtpl $c $rest (depth-adj $x $d) (Cons $x $prerev))))
(= (sloop $g $nt $r $prerev $rem)
   (if (== $rem Nil) Nil
       (app2 (combine (p-all $g $nt (rev $prerev)) $g $r $rem)
             (sloop $g $nt $r (Cons (hd2 $rem) $prerev) (tl2 $rem)))))
(= (combine Nil $g $r $suf) Nil)
(= (combine (Cons $tree $tr) $g $r $suf) (app2 (prepend $tree (m-all $g $r $suf)) (combine $tr $g $r $suf)))
(= (prepend $tree Nil) Nil) (= (prepend $tree (Cons $kids $kr)) (Cons (Cons $tree $kids) (prepend $tree $kr)))

; lp-parse : forest -> Unique | Ambiguous | NoParse  (untrusted but honest about ambiguity)
(= (lp-parse-raw $g $nt $toks) (uniq (p-all $g $nt $toks)))
(= (lp-parse $g $nt $toks) (uniq-lower $g (p-all $g $nt $toks)))
(= (uniq-lower $g Nil) NoParse)
(= (uniq-lower $g (Cons $t Nil)) (Unique (lp-lower $g $t)))
(= (uniq-lower $g (Cons $t (Cons $u $r))) Ambiguous)
(= (uniq Nil) NoParse) (= (uniq (Cons $t Nil)) (Unique $t)) (= (uniq (Cons $t (Cons $u $r))) Ambiguous)

; =============== TRUSTED L1: lp-admit — total, fail-closed grammar gate ===============
(= (prod-labels (Cons (Prod $l $nt $tpl) $r)) (Cons $l (prod-labels $r)))
(= (prod-labels (Cons (VarD $a $b) $r)) (prod-labels $r))
(= (prod-labels Nil) Nil)
(= (var-labels (Cons (VarD $v $nt) $r)) (Cons $v (var-labels $r)))
(= (var-labels (Cons (Prod $a $b $c) $r)) (var-labels $r))
(= (var-labels Nil) Nil)
(= (prod-keys (Cons (Prod $l $nt $tpl) $r)) (Cons (K $nt $tpl) (prod-keys $r)))
(= (prod-keys (Cons (VarD $a $b) $r)) (prod-keys $r))
(= (prod-keys Nil) Nil)
(= (decl-nts (Cons (Prod $l $nt $tpl) $r)) (Cons $nt (decl-nts $r)))
(= (decl-nts (Cons (VarD $v $nt) $r)) (Cons $nt (decl-nts $r)))
(= (decl-nts Nil) Nil)
(= (refs-of Nil) Nil)
(= (refs-of (Cons (Tm $c) $r)) (refs-of $r))
(= (refs-of (Cons (Hl $nt) $r)) (Cons $nt (refs-of $r)))
(= (refs-of (Cons (HlB $nt $scope) $r)) (Cons $nt (Cons $scope (refs-of $r))))
(= (holes-of Nil) Nil)
(= (holes-of (Cons (Tm $c) $r)) (holes-of $r))
(= (holes-of (Cons (Hl $nt) $r)) (Cons $nt (holes-of $r)))
(= (holes-of (Cons (HlB $nt $scope) $r)) (Cons $nt (holes-of $r)))
(= (all-in Nil $set) True) (= (all-in (Cons $x $r) $set) (if (memb $x $set) (all-in $r $set) False))
(= (holes-ok (Cons (Prod $l $nt $tpl) $r) $set) (if (all-in (refs-of $tpl) $set) (holes-ok $r $set) False))
(= (holes-ok (Cons (VarD $a $b) $r) $set) (holes-ok $r $set))
(= (holes-ok Nil $set) True)
(= (lp-admit $g)
   (if (not (g-ok $g))                       (Rejected bad-grammar)
   (if (not (all-distinct (prod-labels $g))) (Rejected dup-label)
   (if (not (all-distinct (var-labels $g)))  (Rejected dup-var)
   (if (not (holes-ok $g (decl-nts $g)))     (Rejected undeclared-hole)
   (if (not (all-distinct (prod-keys $g)))   (Rejected dup-surface)
       Admitted))))))
; NOTE: Admitted does NOT assert unambiguity — that is a separate obligation (see lp-parse/Ambiguous).

; =============== TRUSTED L3: total predicates + gated print / parse-cert ===============
(= (root-nt $g $t)
   (if (g-ok $g)
       (case $t (((Lf $v) (var-nt $g $v)) ((Nd $l $k) (prod-nt $g $l)) ($o (Err badtree))))
       (Err bad-grammar)))
(= (tree-ok $g $t)
   (if (g-ok $g)
       (case $t (((Lf $v) (is-var $g $v)) ((Nd $l $k) (nd-ok $g $l $k)) ($o False)))
       False))
(= (nd-ok $g $l $kids)
   (if (g-ok $g)
       (case (template-of $g $l) (((Err $e) False) ($tpl (kids-ok $g (holes-of $tpl) $kids))))
       False))
(= (kids-ok-cons $g $h $hr $kids)
   (case $kids
     ((Nil False)
      ((Cons $k $kr)
       (if (== (root-nt $g $k) $h) (if (tree-ok $g $k) (kids-ok $g $hr $kr) False) False))
      ($o False))))
(= (kids-ok $g $holes $kids)
   (if (g-ok $g)
       (case $holes
         ((Nil (case $kids ((Nil True) ((Cons $k $kr) False) ($o False))))
          ((Cons $h $hr) (kids-ok-cons $g $h $hr $kids))
          ($o False)))
       False))
; internal printer (NOT public): linearize
(= (pr $g (Lf $v)) (mkL ($v)))
(= (pr $g (Nd $l $kids)) (fill $g (template-of $g $l) $kids))
(= (fill $g Nil $kids) Nil)
(= (fill $g (Cons (Tm $c) $r) $kids) (Cons $c (fill $g $r $kids)))
(= (fill $g (Cons (Hl $nt) $r) (Cons $k $kr)) (app2 (pr $g $k) (fill $g $r $kr)))
(= (fill $g (Cons (HlB $nt $scope) $r) (Cons $k $kr)) (app2 (pr $g $k) (fill $g $r $kr)))
; PUBLIC gated API: print only admitted+well-formed; cert only under admitted grammar
(= (lp-print $g $tree)
   (if (== (lp-admit $g) Admitted) (if (tree-ok $g $tree) (Ok (pr $g $tree)) (Rejected bad-tree)) (Rejected bad-grammar)))
(= (lp-parse-cert $g $nt $toks $tree)
   (if (== (lp-admit $g) Admitted)
       (if (tree-ok $g $tree) (if (== (root-nt $g $tree) $nt) (== (pr $g $tree) $toks) False) False)
       False))

; =============== TRUSTED L4: binder-aware lowering / cert ====================
(= (env-idx $x Nil $i) NF)
(= (env-idx $x (Cons $y $ys) $i)
   (if (== $x $y) $i (env-idx $x $ys (+ $i 1))))
(= (ctx-add $nm $ctx) (if (== $nm NF) $ctx (Cons $nm $ctx)))
(= (binder-name $t) (case $t (((Lf $v) $v) ($o NF))))

(= (lp-lower $g $tree) (lp-lower-under $g Nil $tree))
(= (lp-lower-under $g $ctx $t)
   (case $t
     (((Lf $v)
       (let $i (env-idx $v $ctx 0)
         (if (== $i NF) (Lf $v) (Bv $i))))
      ((Nd $l $kids)
       (case (template-of $g $l)
         (((Err $e) (Bad badtree))
          ($tpl (Nd $l (lower-kids $g $ctx $tpl $kids))))))
      ($o (Bad badtree)))))

(= (lower-kids $g $ctx Nil Nil) Nil)
(= (lower-kids $g $ctx Nil (Cons $k $kr)) Nil)
(= (lower-kids $g $ctx (Cons (Tm $c) $r) $kids) (lower-kids $g $ctx $r $kids))
(= (lower-kids $g $ctx (Cons (Hl $nt) $r) Nil) Nil)
(= (lower-kids $g $ctx (Cons (Hl $nt) $r) (Cons $k $kr))
   (Cons (lp-lower-under $g $ctx $k) (lower-kids $g $ctx $r $kr)))
(= (lower-kids $g $ctx (Cons (HlB $nt $scope) $r) Nil) Nil)
(= (lower-kids $g $ctx (Cons (HlB $nt $scope) $r) (Cons $k $kr))
   (Cons (Bd $nt $scope)
     (lower-kids-bound $g $ctx (binder-name $k) $scope $r $kr)))

(= (lower-kids-bound $g $ctx $nm $scope Nil Nil) Nil)
(= (lower-kids-bound $g $ctx $nm $scope Nil (Cons $k $kr)) Nil)
(= (lower-kids-bound $g $ctx $nm $scope (Cons (Tm $c) $r) $kids)
   (lower-kids-bound $g $ctx $nm $scope $r $kids))
(= (lower-kids-bound $g $ctx $nm $scope (Cons (Hl $nt) $r) Nil) Nil)
(= (lower-kids-bound $g $ctx $nm $scope (Cons (Hl $nt) $r) (Cons $k $kr))
   (if (== $nt $scope)
     (Cons (lp-lower-under $g (ctx-add $nm $ctx) $k)
       (lower-kids $g $ctx $r $kr))
     (Cons (lp-lower-under $g $ctx $k)
       (lower-kids $g $ctx $r $kr))))
(= (lower-kids-bound $g $ctx $nm $scope (Cons (HlB $nt $scope2) $r) Nil) Nil)
(= (lower-kids-bound $g $ctx $nm $scope (Cons (HlB $nt $scope2) $r) (Cons $k $kr))
   (Cons (lp-lower-under $g $ctx $k)
     (lower-kids $g $ctx $r $kr)))

(= (lp-lower-cert $g $raw-tree $canon-tree)
   (if (and (g-ok $g) (== (lp-admit $g) Admitted))
       (if (tree-ok $g $raw-tree) (== (lp-lower $g $raw-tree) $canon-tree) False)
       False))
(= (lp-parse-cert $g $nt $toks $raw-tree $canon-tree)
   (and (lp-parse-cert $g $nt $toks $raw-tree)
        (lp-lower-cert $g $raw-tree $canon-tree)))

; ======================= grammar builders =======================
(= (conv-e (VarD $v $nt)) (VarD $v $nt))
(= (conv-e (Prod $l $nt $tpl)) (Prod $l $nt (mkL $tpl)))
(= (mkGram $e) (if (== $e ()) Nil (mkG2 (decons-atom $e)))) (= (mkG2 ($h $t)) (Cons (conv-e $h) (mkGram $t)))
(= (pu-tree (Unique $t)) $t)
