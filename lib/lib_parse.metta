; ============ lib_parse v2 : GSLT-scale invertible parsing, domain-agnostic ============
; ONE grammar-generic engine. Same code parses logic, bio sequences, tensor arrays, ...
; TRUST BOUNDARY:  p-all / lp-parse-raw = UNTRUSTED search (returns a FOREST, never theoremhood)
;                  lp-lower / lp-admit / lp-print / lp-parse-cert = TRUSTED, total, fail-closed.

; ---- total list utils ----
(= (app2 Nil $y) $y)
(= (app2 (Cons $x $xs) $y) (Cons $x (app2 $xs $y)))
(= (hd2 (Cons $x $r)) $x)
(= (tl2 (Cons $x $r)) $r)
(= (memb $x Nil) False)
(= (memb $x (Cons $y $ys)) (if (== $x $y) True (memb $x $ys)))
(= (rev $l) (rev2 $l Nil)) (= (rev2 Nil $a) $a) (= (rev2 (Cons $x $r) $a) (rev2 $r (Cons $x $a)))
(= (issingle (Cons $x Nil)) True) (= (issingle (Cons $x (Cons $y $r))) False) (= (issingle Nil) False)
(= (starts-with Nil $c) False) (= (starts-with (Cons $x $r) $c) (== $x $c))
(= (all-distinct Nil) True) (= (all-distinct (Cons $x $r)) (if (memb $x $r) False (all-distinct $r)))
(= (not True) False) (= (not False) True)
(= (and True $x) $x) (= (and False $x) False)
(= (not-err $x) (case $x (((Err $y) False) ($z True))))
(= (is-err $x) (case $x (((Err $y) True) ($z False))))
(= (mkL $e) (if (== $e ()) Nil (mkL2 (decons-atom $e)))) (= (mkL2 ($h $t)) (Cons $h (mkL $t)))

; ---- total grammar-shape checks for trusted APIs ----
(= (tpltok-ok $t)
   (case $t (((Tm $c) True) ((Hl $nt) True) ((HlB $nt $scope) True) ($o False))))
(= (tpl-ok $tpl)
   (case $tpl ((Nil True) ((Cons $t $r) (and (tpltok-ok $t) (tpl-ok $r))) ($o False))))
(= (g-entry-ok $e)
   (case $e (((VarD $v $nt) True) ((LexD $cls $nt) True) ((Prod $l $nt $tpl) (tpl-ok $tpl)) ($o False))))
(= (g-ok $g)
   (case $g ((Nil True) ((Cons $e $r) (and (g-entry-ok $e) (g-ok $r))) ($o False))))

; ---- grammar = finite data. entries: (Prod label nt template) | (VarD var nt) | (LexD class nt) ----
; template tokens: (Tm const) | (Hl nt) | (HlB nt scope)
; HlB marks a binder-position child parsed as nt; the trusted lowering path turns it into
; canonical binder form and scopes the next matching body-hole of nonterminal scope.
(= (template-of (Cons (Prod $l $nt $tpl) $r) $q) (if (== $l $q) $tpl (template-of $r $q)))
(= (template-of (Cons (VarD $v $nt) $r) $q) (template-of $r $q))
(= (template-of (Cons (LexD $cls $nt) $r) $q) (template-of $r $q))
(= (template-of Nil $q) (Err notmpl))
(= (tpl-len $tpl)
   (case $tpl
     ((Nil 0)
      ((Cons $t $r) (+ 1 (tpl-len $r)))
      ($o (Err badtpl)))))
(= (tpl-nth $tpl $i)
   (case $tpl
     ((Nil (Err oob))
      ((Cons $t $r) (if (== $i 0) $t (tpl-nth $r (- $i 1))))
      ($o (Err badtpl)))))
(= (tpl-nth-is-tm $tpl $i $tok)
   (case (tpl-nth $tpl $i)
     (((Tm $c) (== $c $tok))
      ($o False))))
(= (tpl-nth-is-hl $tpl $i $nt)
   (case (tpl-nth $tpl $i)
     (((Hl $h) (== $h $nt))
      ($o False))))
(= (tpl-nth-is-hlb $tpl $i $nt $scope)
   (case (tpl-nth $tpl $i)
     (((HlB $h $s) (and (== $h $nt) (== $s $scope)))
      ($o False))))
(= (tpl-count-tm $tpl $tok)
   (case $tpl
     ((Nil 0)
      ((Cons (Tm $c) $r)
       (+ (if (== $c $tok) 1 0) (tpl-count-tm $r $tok)))
      ((Cons $h $r) (tpl-count-tm $r $tok))
      ($o (Err badtpl)))))
(= (tpl-count-hl $tpl $nt)
   (case $tpl
     ((Nil 0)
      ((Cons (Hl $h) $r)
       (+ (if (== $h $nt) 1 0) (tpl-count-hl $r $nt)))
      ((Cons $h $r) (tpl-count-hl $r $nt))
      ($o (Err badtpl)))))
(= (tpl-count-hlb $tpl $nt $scope)
   (case $tpl
     ((Nil 0)
      ((Cons (HlB $h $s) $r)
       (+ (if (and (== $h $nt) (== $s $scope)) 1 0) (tpl-count-hlb $r $nt $scope)))
      ((Cons $h $r) (tpl-count-hlb $r $nt $scope))
      ($o (Err badtpl)))))
(= (tpl-has-hlb $tpl)
   (case $tpl
     ((Nil False)
      ((Cons (HlB $h $s) $r) True)
      ((Cons $h $r) (tpl-has-hlb $r))
      ($o False))))
(= (g-has-hlb $g)
   (case $g
     ((Nil False)
      ((Cons (Prod $l $nt $tpl) $r)
       (if (tpl-has-hlb $tpl) True (g-has-hlb $r)))
      ((Cons $e $r) (g-has-hlb $r))
      ($o False))))
(= (prod-nt (Cons (Prod $l $nt $tpl) $r) $q) (if (== $l $q) $nt (prod-nt $r $q)))
(= (prod-nt (Cons (VarD $v $nt) $r) $q) (prod-nt $r $q))
(= (prod-nt (Cons (LexD $cls $nt) $r) $q) (prod-nt $r $q))
(= (prod-nt Nil $q) (Err noprod))
(= (lex-class $tok)
   (case $tok
     (((Lex $cls $raw) $cls)
      ($o NF))))
(= (var-nt (Cons (VarD $v $nt) $r) $q) (if (== $v $q) $nt (var-nt $r $q)))
(= (var-nt (Cons (LexD $cls $nt) $r) $q) (if (== (lex-class $q) $cls) $nt (var-nt $r $q)))
(= (var-nt (Cons (Prod $a $b $c) $r) $q) (var-nt $r $q))
(= (var-nt Nil $q) (Err novar))
(= (is-var $g $v) (not-err (var-nt $g $v)))
(= (prods-for (Cons (Prod $l $nt $tpl) $r) $q) (if (== $nt $q) (Cons (Prod $l $nt $tpl) (prods-for $r $q)) (prods-for $r $q)))
(= (prods-for (Cons (VarD $v $nt) $r) $q) (prods-for $r $q))
(= (prods-for (Cons (LexD $cls $nt) $r) $q) (prods-for $r $q))
(= (prods-for Nil $q) Nil)
(= (has-var-nt (Cons (VarD $v $nt) $q) $want)
   (if (== $nt $want) True (has-var-nt $q $want)))
(= (has-var-nt (Cons (LexD $cls $nt) $q) $want)
   (if (== $nt $want) True (has-var-nt $q $want)))
(= (has-var-nt (Cons (Prod $l $nt $tpl) $q) $want) (has-var-nt $q $want))
(= (has-var-nt Nil $want) False)
(= (tpl-can-contain-tm $g Nil $c $seen) False)
(= (tpl-can-contain-tm $g (Cons (Tm $tok) $r) $c $seen)
   (if (== $tok $c) True (tpl-can-contain-tm $g $r $c $seen)))
(= (tpl-can-contain-tm $g (Cons (Hl $nt) $r) $c $seen)
   (if (nt-can-contain-tm-seen $g $nt $c $seen)
       True
       (tpl-can-contain-tm $g $r $c $seen)))
(= (tpl-can-contain-tm $g (Cons (HlB $nt $scope) $r) $c $seen)
   (if (nt-can-contain-tm-seen $g $nt $c $seen)
       True
       (tpl-can-contain-tm $g $r $c $seen)))
(= (nt-can-contain-tm-prods $g Nil $c $seen) False)
(= (nt-can-contain-tm-prods $g (Cons (Prod $l $nt $tpl) $r) $c $seen)
   (if (tpl-can-contain-tm $g $tpl $c $seen)
       True
       (nt-can-contain-tm-prods $g $r $c $seen)))
(= (nt-can-contain-tm-seen $g $nt $c $seen)
   (if (memb $nt $seen)
       False
       (nt-can-contain-tm-prods $g (prods-for $g $nt) $c (Cons $nt $seen))))
(= (nt-can-contain-tm $g $nt $c) (nt-can-contain-tm-seen $g $nt $c Nil))
(= (prod-head-key $g $p)
   (case $p
     (((Prod $l $nt (Cons (Tm $c) $r)) (HeadTm $c))
      ((Prod $l $nt (Cons (Hl $h) (Cons (Tm $c) $r)))
       (if (leaf-nt $g $h) (HeadAfterLeaf $c) NoHead))
      ((Prod $l $nt (Cons (HlB $h $scope) (Cons (Tm $c) $r)))
       (if (leaf-nt $g $h) (HeadAfterLeaf $c) NoHead))
      ($o NoHead))))
(= (head-key-match $key $toks)
   (case $key
     (((HeadTm $c) (starts-with $toks $c))
      ((HeadAfterLeaf $c)
       (case $toks
         (((Cons $x $r) (starts-with $r $c))
          ($o False))))
      ($o False))))
(= (all-prods-head-keyed $g Nil) True)
(= (all-prods-head-keyed $g (Cons $p $r))
   (if (== (prod-head-key $g $p) NoHead) False (all-prods-head-keyed $g $r)))
(= (matching-prods-head $g Nil $toks) Nil)
(= (matching-prods-head $g (Cons (Prod $l $nt $tpl) $r) $toks)
   (if (head-key-match (prod-head-key $g (Prod $l $nt $tpl)) $toks)
       (Cons (Prod $l $nt $tpl) (matching-prods-head $g $r $toks))
       (matching-prods-head $g $r $toks)))
(= (candidate-keep-prod $g $p $toks)
   (case (prod-head-key $g $p)
     ((NoHead True)
      ($k (head-key-match $k $toks)))))
(= (candidate-prods-filter $g Nil $toks) Nil)
(= (candidate-prods-filter $g (Cons (Prod $l $nt $tpl) $r) $toks)
   (if (candidate-keep-prod $g (Prod $l $nt $tpl) $toks)
       (Cons (Prod $l $nt $tpl) (candidate-prods-filter $g $r $toks))
       (candidate-prods-filter $g $r $toks)))
(= (candidate-prods $g $nt $toks)
   (let $ps (prods-for $g $nt)
     (if (has-var-nt $g $nt)
         $ps
         (candidate-prods-filter $g $ps $toks))))
(= (leaf-list-shape2 $g $nt $ps)
   (case $ps
      (((Cons (Prod $lb $nb (Cons (Hl $e1) Nil))
         (Cons (Prod $ls $ns (Cons (Hl $e2) (Cons (Hl $self) Nil))) Nil))
       (if (and (== $nb $nt)
                (and (== $ns $nt)
                     (and (== $e1 $e2)
                          (and (== $self $nt) (leaf-nt $g $e1)))))
           (LeafList $e1)
           NoLeafList))
      ((Cons (Prod $ls $ns (Cons (Hl $e2) (Cons (Hl $self) Nil)))
         (Cons (Prod $lb $nb (Cons (Hl $e1) Nil)) Nil))
       (if (and (== $nb $nt)
                (and (== $ns $nt)
                     (and (== $e1 $e2)
                          (and (== $self $nt) (leaf-nt $g $e1)))))
           (LeafList $e1)
           NoLeafList))
      ($o NoLeafList))))
(= (leaf-list-shape $g $nt)
   (if (has-var-nt $g $nt) NoLeafList (leaf-list-shape2 $g $nt (prods-for $g $nt))))
(= (wrap-list-shape2 $g $nt $ps)
   (case $ps
      (((Cons
          (Prod $lb $nb
            (Cons (Tm $open1)
              (Cons (Hl $inner1)
                (Cons (Tm $close1) Nil))))
          (Cons
            (Prod $ls $ns
              (Cons (Tm $open2)
                (Cons (Hl $inner2)
                  (Cons (Tm $close2)
                    (Cons (Hl $self) Nil)))))
            Nil))
        (if (and (== $nb $nt)
                 (and (== $ns $nt)
                      (and (== $open1 $open2)
                           (and (== $close1 $close2)
                                (and (== $inner1 $inner2)
                                     (== $self $nt))))))
            (WrapList $open1 $inner1 $close1 $lb $ls)
            NoWrapList))
      ((Cons
          (Prod $ls $ns
            (Cons (Tm $open2)
              (Cons (Hl $inner2)
                (Cons (Tm $close2)
                  (Cons (Hl $self) Nil)))))
          (Cons
            (Prod $lb $nb
              (Cons (Tm $open1)
                (Cons (Hl $inner1)
                  (Cons (Tm $close1) Nil))))
            Nil))
        (if (and (== $nb $nt)
                 (and (== $ns $nt)
                      (and (== $open1 $open2)
                           (and (== $close1 $close2)
                                (and (== $inner1 $inner2)
                                     (== $self $nt))))))
            (WrapList $open1 $inner1 $close1 $lb $ls)
            NoWrapList))
      ($o NoWrapList))))
(= (wrap-list-shape $g $nt)
   (if (has-var-nt $g $nt) NoWrapList (wrap-list-shape2 $g $nt (prods-for $g $nt))))
(= (split-first $c $toks $prerev)
   (case $toks
     ((Nil NoSplit)
      ((Cons $x $rest)
       (if (== $x $c)
           (Split (rev $prerev) (Cons $x $rest))
           (split-first $c $rest (Cons $x $prerev))))
      ($o NoSplit))))
(= (wrap-depth-adj $open $close $t $d)
   (if (== $t $open) (+ $d 1) (if (== $t $close) (- $d 1) $d)))
(= (wrap-scan $open $close Nil $d $prerev) NoWrapSplit)
(= (wrap-scan $open $close (Cons $x $rest) $d $prerev)
   (if (and (== $d 1) (== $x $close))
       (WrapSplit (rev $prerev) $rest)
       (wrap-scan $open $close $rest (wrap-depth-adj $open $close $x $d) (Cons $x $prerev))))
; =============== UNTRUSTED L2: p-all — full forest enumerator (all parses) ===============
; bounded for non-left-cyclic grammars: a non-trailing hole takes a PROPER prefix (>=1, leaves >=1).
(= (p-all $g $nt $toks) (if (== $toks Nil) Nil (p-all-ne $g $nt $toks)))
(= (p-all-ne $g $nt $toks) (p-cand $g $nt $toks))
(= (p-cand $g $nt $toks)
   (let $ps (candidate-prods $g $nt $toks)
     (app2 (var-parses $g $nt $toks) (prod-parses-cand $g $nt $toks $ps))))
(= (prod-parses-cand $g $nt $toks $ps)
   (case (wrap-list-shape2 $g $nt $ps)
     (((WrapList $open $inner $close $lb $ls)
       (wrap-list-parses $g $nt $inner $open $close $lb $ls $toks))
      ($o (prod-parses $g $nt $toks $ps)))))
(= (var-parses $g $nt $toks) (if (issingle $toks) (vp2 $g $nt (hd2 $toks)) Nil))
(= (vp2 $g $nt $v) (if (is-var $g $v) (if (== (var-nt $g $v) $nt) (Cons (Lf $v) Nil) Nil) Nil))
(= (prod-parses $g $nt $toks Nil) Nil)
(= (prod-parses $g $nt $toks (Cons (Prod $l $pnt $tpl) $rest))
   (app2 (label-trees $l (m-all $g $tpl $toks)) (prod-parses $g $nt $toks $rest)))
(= (wrap-list-parses $g $nt $inner $open $close $lb $ls $toks)
   (if (starts-with $toks $open)
       (case (wrap-scan $open $close (tl2 $toks) 1 Nil)
         (((WrapSplit $inner-toks $tail)
           (let $inners (p-cand $g $inner $inner-toks)
             (if (== $tail Nil)
                 (label-trees $lb (kids1 $inners))
                 (label-trees $ls
                   (wrap-tail-kids $inners (kids1 (p-cand $g $nt $tail)))))))
          ($o Nil)))
       Nil))
(= (label-trees $l Nil) Nil)
(= (label-trees $l (Cons $kids $rest)) (Cons (Nd $l $kids) (label-trees $l $rest)))
; m-all: list of kid-lists that fully consume toks
(= (m-all $g Nil $toks) (if (== $toks Nil) (Cons Nil Nil) Nil))
(= (m-all $g (Cons (Tm $c) $r) $toks) (if (starts-with $toks $c) (m-all $g $r (tl2 $toks)) Nil))
(= (m-all $g (Cons (Hl $nt) $r) $toks) (hole-all $g $nt $r $toks))
(= (m-all $g (Cons (HlB $nt $scope) $r) $toks) (hole-all $g $nt $r $toks))
(= (depth-adj $t $d) (if (== $t LP) (+ $d 1) (if (== $t RP) (- $d 1) $d)))
(= (hole-all $g $nt Nil $toks) (kids1 (p-cand $g $nt $toks)))
(= (kids1 Nil) Nil) (= (kids1 (Cons $t $r)) (Cons (Cons $t Nil) (kids1 $r)))
(= (leaf-nt $g $nt) (== (prods-for $g $nt) Nil))
(= (hole-one $g $nt $r $toks)
   (if (== $toks Nil)
       Nil
       (combine (p-cand $g $nt (Cons (hd2 $toks) Nil)) $g $r (tl2 $toks))))
(= (hole-all-term-generic $g $nt $c $rr $toks)
   (if (leaf-nt $g $nt)
       (hole-one $g $nt (Cons (Tm $c) $rr) $toks)
       (dsplit $g $nt (Cons (Tm $c) $rr) $c $toks 0 Nil)))
(= (hole-leaf-list-before-term $g $nt $elem $c $rr $toks)
   (case (split-first $c $toks Nil)
     (((Split Nil $suf) Nil)
      ((Split $pref $suf) (combine (p-cand $g $nt $pref) $g (Cons (Tm $c) $rr) $suf))
      ($o (hole-all-term-generic $g $nt $c $rr $toks)))))
; hole followed by a TERMINAL: split only at that terminal's depth-0 occurrences (fast; all => ambiguity)
(= (hole-all $g $nt (Cons (Tm $c) $rr) $toks)
   (case (leaf-list-shape $g $nt)
     (((LeafList $elem)
       (if (== (p-all $g $elem (Cons $c Nil)) Nil)
           (hole-leaf-list-before-term $g $nt $elem $c $rr $toks)
           (hole-all-term-generic $g $nt $c $rr $toks)))
      ($o (hole-all-term-generic $g $nt $c $rr $toks)))))
; hole followed by a HOLE (no delimiter): fall back to full proper-prefix enumeration (rare)
(= (hole-all $g $nt (Cons (Hl $h) $rr) $toks)
   (if (leaf-nt $g $nt)
       (hole-one $g $nt (Cons (Hl $h) $rr) $toks)
       (if (== $toks Nil) Nil (sloop $g $nt (Cons (Hl $h) $rr) (Cons (hd2 $toks) Nil) (tl2 $toks)))))
(= (hole-all $g $nt (Cons (HlB $h $scope) $rr) $toks)
   (if (leaf-nt $g $nt)
       (hole-one $g $nt (Cons (HlB $h $scope) $rr) $toks)
       (if (== $toks Nil) Nil (sloop $g $nt (Cons (HlB $h $scope) $rr) (Cons (hd2 $toks) Nil) (tl2 $toks)))))
(= (dsplit $g $nt $rtpl $c Nil $d $prerev) Nil)
(= (dsplit $g $nt $rtpl $c (Cons $x $rest) $d $prerev)
   (if (and (== $d 0) (== $x $c))
       (let $now (combine (p-cand $g $nt (rev $prerev)) $g $rtpl (Cons $x $rest))
         (if (nt-can-contain-tm $g $nt $c)
             (app2 $now (dsplit $g $nt $rtpl $c $rest (depth-adj $x $d) (Cons $x $prerev)))
             $now))
       (dsplit $g $nt $rtpl $c $rest (depth-adj $x $d) (Cons $x $prerev))))
(= (sloop $g $nt $r $prerev $rem)
   (if (== $rem Nil) Nil
       (app2 (combine (p-cand $g $nt (rev $prerev)) $g $r $rem)
             (sloop $g $nt $r (Cons (hd2 $rem) $prerev) (tl2 $rem)))))
(= (combine Nil $g $r $suf) Nil)
(= (combine (Cons $tree $tr) $g $r $suf) (app2 (prepend $tree (m-all $g $r $suf)) (combine $tr $g $r $suf)))
(= (prepend $tree Nil) Nil) (= (prepend $tree (Cons $kids $kr)) (Cons (Cons $tree $kids) (prepend $tree $kr)))
(= (wrap-tail-kids Nil $tail-kids) Nil)
(= (wrap-tail-kids (Cons $tree $trees) $tail-kids)
   (app2 (prepend $tree $tail-kids) (wrap-tail-kids $trees $tail-kids)))

; lp-parse : forest -> Unique | Ambiguous | NoParse  (untrusted but honest about ambiguity)
(= (lp-parse-raw $g $nt $toks) (uniq (p-all $g $nt $toks)))
(= (lp-parse $g $nt $toks) (uniq-lower $g (p-all $g $nt $toks)))
(= (uniq-lower $g Nil) NoParse)
(= (uniq-lower $g (Cons $t Nil))
   (Unique (if (g-has-hlb $g) (lp-lower $g $t) $t)))
(= (uniq-lower $g (Cons $t (Cons $u $r))) Ambiguous)
(= (uniq Nil) NoParse) (= (uniq (Cons $t Nil)) (Unique $t)) (= (uniq (Cons $t (Cons $u $r))) Ambiguous)
(= (lp-parse-class $g $nt $toks)
   (case (lp-parse $g $nt $toks)
     (((Unique $t) Unique)
      (Ambiguous Ambiguous)
      (NoParse NoParse)
      ($o BadParse))))
(= (lp-corpus-unique-on $g $nt Nil) True)
(= (lp-corpus-unique-on $g $nt (Cons $toks $rest))
   (if (== (lp-parse-class $g $nt $toks) Unique)
       (lp-corpus-unique-on $g $nt $rest)
       False))
(= (lp-unambiguity-status $cert-ok $g $nt $corpus)
   (if $cert-ok
       CertifiedUnambiguous
       (if (lp-corpus-unique-on $g $nt $corpus)
           CorpusChecked
           Unchecked)))

; =============== TRUSTED L1: lp-admit — total, fail-closed grammar gate ===============
(= (prod-labels (Cons (Prod $l $nt $tpl) $r)) (Cons $l (prod-labels $r)))
(= (prod-labels (Cons (VarD $a $b) $r)) (prod-labels $r))
(= (prod-labels (Cons (LexD $a $b) $r)) (prod-labels $r))
(= (prod-labels Nil) Nil)
(= (var-labels (Cons (VarD $v $nt) $r)) (Cons (ExactLeaf $v) (var-labels $r)))
(= (var-labels (Cons (LexD $cls $nt) $r)) (Cons (LexLeaf $cls) (var-labels $r)))
(= (var-labels (Cons (Prod $a $b $c) $r)) (var-labels $r))
(= (var-labels Nil) Nil)
(= (prod-keys (Cons (Prod $l $nt $tpl) $r)) (Cons (K $nt $tpl) (prod-keys $r)))
(= (prod-keys (Cons (VarD $a $b) $r)) (prod-keys $r))
(= (prod-keys (Cons (LexD $a $b) $r)) (prod-keys $r))
(= (prod-keys Nil) Nil)
(= (decl-nts (Cons (Prod $l $nt $tpl) $r)) (Cons $nt (decl-nts $r)))
(= (decl-nts (Cons (VarD $v $nt) $r)) (Cons $nt (decl-nts $r)))
(= (decl-nts (Cons (LexD $cls $nt) $r)) (Cons $nt (decl-nts $r)))
(= (decl-nts Nil) Nil)
(= (refs-of Nil) Nil)
(= (refs-of (Cons (Tm $c) $r)) (refs-of $r))
(= (refs-of (Cons (Hl $nt) $r)) (Cons $nt (refs-of $r)))
(= (refs-of (Cons (HlB $nt $scope) $r)) (Cons $nt (Cons $scope (refs-of $r))))
(= (holes-of Nil) Nil)
(= (holes-of (Cons (Tm $c) $r)) (holes-of $r))
(= (holes-of (Cons (Hl $nt) $r)) (Cons $nt (holes-of $r)))
(= (holes-of (Cons (HlB $nt $scope) $r)) (Cons $nt (holes-of $r)))
(= (all-in Nil $set) True) (= (all-in (Cons $x $r) $set) (if (memb $x $set) (all-in $r $set) False))
(= (holes-ok (Cons (Prod $l $nt $tpl) $r) $set) (if (all-in (refs-of $tpl) $set) (holes-ok $r $set) False))
(= (holes-ok (Cons (VarD $a $b) $r) $set) (holes-ok $r $set))
(= (holes-ok (Cons (LexD $a $b) $r) $set) (holes-ok $r $set))
(= (holes-ok Nil $set) True)
(= (lp-admit $g)
   (if (not (g-ok $g))                       (Rejected bad-grammar)
   (if (not (all-distinct (prod-labels $g))) (Rejected dup-label)
   (if (not (all-distinct (var-labels $g)))  (Rejected dup-var)
   (if (not (holes-ok $g (decl-nts $g)))     (Rejected undeclared-hole)
   (if (not (all-distinct (prod-keys $g)))   (Rejected dup-surface)
       Admitted))))))
; NOTE: Admitted does NOT assert unambiguity — that is a separate obligation (see lp-parse/Ambiguous).

; =============== TRUSTED L3: total predicates + gated print / parse-cert ===============
(= (root-nt $g $t)
   (if (g-ok $g)
       (case $t (((Lf $v) (var-nt $g $v)) ((Nd $l $k) (prod-nt $g $l)) ($o (Err badtree))))
       (Err bad-grammar)))
(= (tree-ok $g $t)
   (if (g-ok $g)
       (case $t (((Lf $v) (is-var $g $v)) ((Nd $l $k) (nd-ok $g $l $k)) ($o False)))
       False))
(= (nd-ok $g $l $kids)
   (if (g-ok $g)
       (case (template-of $g $l) (((Err $e) False) ($tpl (kids-ok $g (holes-of $tpl) $kids))))
       False))
(= (kids-ok-cons $g $h $hr $kids)
   (case $kids
     ((Nil False)
      ((Cons $k $kr)
       (if (== (root-nt $g $k) $h) (if (tree-ok $g $k) (kids-ok $g $hr $kr) False) False))
      ($o False))))
(= (kids-ok $g $holes $kids)
   (if (g-ok $g)
       (case $holes
         ((Nil (case $kids ((Nil True) ((Cons $k $kr) False) ($o False))))
          ((Cons $h $hr) (kids-ok-cons $g $h $hr $kids))
          ($o False)))
       False))
; internal printer (NOT public): linearize
(= (pr $g (Lf $v)) (mkL ($v)))
(= (pr $g (Nd $l $kids)) (fill $g (template-of $g $l) $kids))
(= (fill $g Nil $kids) Nil)
(= (fill $g (Cons (Tm $c) $r) $kids) (Cons $c (fill $g $r $kids)))
(= (fill $g (Cons (Hl $nt) $r) (Cons $k $kr)) (app2 (pr $g $k) (fill $g $r $kr)))
(= (fill $g (Cons (HlB $nt $scope) $r) (Cons $k $kr)) (app2 (pr $g $k) (fill $g $r $kr)))
; PUBLIC gated API: print only admitted+well-formed; cert only under admitted grammar
(= (lp-print $g $tree)
   (if (== (lp-admit $g) Admitted) (if (tree-ok $g $tree) (Ok (pr $g $tree)) (Rejected bad-tree)) (Rejected bad-grammar)))
(= (lp-parse-cert $g $nt $toks $tree)
   (if (== (lp-admit $g) Admitted)
       (if (tree-ok $g $tree) (if (== (root-nt $g $tree) $nt) (== (pr $g $tree) $toks) False) False)
       False))

; =============== TRUSTED L3b: shared generalized cert -> raw tree -> parse-cert ==========
; Shared cert vocabulary:
;   (TokC tok idx)                      explicit terminal token at position idx
;   (LeafC tok left right)              admitted leaf (VarD/LexD) spanning [left,right)
;   (EpsC)                              empty-production witness
;   (NodeC label lhs left right kids)   production witness with full RHS kids
(= (lp-len Nil) 0)
(= (lp-len (Cons $x $r)) (+ 1 (lp-len $r)))
(= (lp-tok-at Nil $i) (Err oob))
(= (lp-tok-at (Cons $x $r) $i)
   (if (== $i 0) $x (lp-tok-at $r (- $i 1))))

(= (lp-shared-cert-tree-at-leaf $g $toks $want-nt $tok $left $right $pos)
   (if (and (== $left $pos)
            (and (== $right (+ $pos 1))
                 (and (== (lp-tok-at $toks $pos) $tok)
                      (== (var-nt $g $tok) $want-nt))))
       (CertOk $right (Lf $tok))
       CertErr))
(= (lp-shared-cert-node-from-template $g $toks $label $right $kids $pos $tpl)
   (case (lp-shared-cert-kids $g $toks $tpl $kids $pos)
     (((KidsOk $end $trees)
       (if (== $end $right)
           (CertOk $end (Nd $label $trees))
           CertErr))
      ($o CertErr))))
(= (lp-shared-cert-tree-at-node $g $toks $want-nt $label $lhs $left $right $kids $pos)
   (if (and (== $lhs $want-nt) (== $left $pos))
       (case (template-of $g $label)
         (((Err $e) CertErr)
          ($tpl
            (lp-shared-cert-node-from-template
              $g $toks $label $right $kids $pos $tpl))))
       CertErr))
(= (lp-shared-cert-tree-at $g $toks $want-nt $cert $pos)
   (case $cert
     (((LeafC $tok $left $right)
       (lp-shared-cert-tree-at-leaf $g $toks $want-nt $tok $left $right $pos))
      ((NodeC $label $lhs $left $right $kids)
       (lp-shared-cert-tree-at-node $g $toks $want-nt $label $lhs $left $right $kids $pos))
      ($o CertErr))))

(= (lp-shared-cert-kids $g $toks Nil $kids $pos)
   (case $kids
     ((Nil (KidsOk $pos Nil))
      ((Cons (EpsC) Nil) (KidsOk $pos Nil))
      ($o CertErr))))
(= (lp-shared-cert-kids $g $toks (Cons (Tm $c) $r) Nil $pos) CertErr)
(= (lp-shared-cert-kids $g $toks (Cons (Tm $c) $r) (Cons $k $kr) $pos)
   (case $k
     (((TokC $tok $idx)
       (if (and (== $idx $pos)
                (and (== (lp-tok-at $toks $pos) $tok)
                     (== $tok $c)))
           (lp-shared-cert-kids $g $toks $r $kr (+ $pos 1))
           CertErr))
      ($o CertErr))))
(= (lp-shared-cert-kids $g $toks (Cons (Hl $nt) $r) Nil $pos) CertErr)
(= (lp-shared-cert-kids $g $toks (Cons (Hl $nt) $r) (Cons $k $kr) $pos)
   (case (lp-shared-cert-tree-at $g $toks $nt $k $pos)
     (((CertOk $end $tree)
       (case (lp-shared-cert-kids $g $toks $r $kr $end)
         (((KidsOk $end2 $trees) (KidsOk $end2 (Cons $tree $trees)))
          ($o CertErr))))
      ($o CertErr))))
(= (lp-shared-cert-kids $g $toks (Cons (HlB $nt $scope) $r) Nil $pos) CertErr)
(= (lp-shared-cert-kids $g $toks (Cons (HlB $nt $scope) $r) (Cons $k $kr) $pos)
   (case (lp-shared-cert-tree-at $g $toks $nt $k $pos)
     (((CertOk $end $tree)
       (case (lp-shared-cert-kids $g $toks $r $kr $end)
         (((KidsOk $end2 $trees) (KidsOk $end2 (Cons $tree $trees)))
          ($o CertErr))))
      ($o CertErr))))

(= (lp-shared-cert-tree $g $nt $toks $cert)
   (if (== (lp-admit $g) Admitted)
       (case (lp-shared-cert-tree-at $g $toks $nt $cert 0)
         (((CertOk $end $tree)
           (if (== $end (lp-len $toks))
               (Ok $tree)
               (Err bad-span)))
          ($o (Err bad-cert))))
       (Err bad-grammar)))
(= (lp-shared-parse-cert $g $nt $toks $cert)
   (case (lp-shared-cert-tree $g $nt $toks $cert)
     (((Ok $tree) (lp-parse-cert $g $nt $toks $tree))
      ($o False))))

; Shared-cert mutation tooth for negative checks.
(= (lp-shared-cert-corrupt-tok $tok)
   (case $tok
     (((Lex $cls $raw) (Lex BROKEN_TOKEN_KIND $raw))
      ($o BROKEN_TOKEN_KIND))))
(= (lp-shared-cert-corrupt-go $cert)
   (case $cert
     (((TokC $tok $idx)
       (MutOne True (TokC BROKEN_TOKEN_KIND $idx)))
      ((LeafC $tok $left $right)
       (MutOne True (LeafC (lp-shared-cert-corrupt-tok $tok) $left $right)))
      ((EpsC)
       (MutOne False (EpsC)))
      ((NodeC $label $lhs $left $right $kids)
       (case (lp-shared-cert-corrupt-kids $kids)
         (((MutKids $done $kids2)
           (MutOne $done (NodeC $label $lhs $left $right $kids2)))
          ($o (MutOne False (NodeC $label $lhs $left $right $kids))))))
      ($o (MutOne False $cert)))))
(= (lp-shared-cert-corrupt-kids $kids)
   (case $kids
     ((Nil (MutKids False Nil))
      ((Cons $k $kr)
       (case (lp-shared-cert-corrupt-go $k)
         (((MutOne True $k2)
           (MutKids True (Cons $k2 $kr)))
          ((MutOne False $k2)
           (case (lp-shared-cert-corrupt-kids $kr)
             (((MutKids $done $kr2)
               (MutKids $done (Cons $k2 $kr2)))
              ($o (MutKids False (Cons $k2 $kr))))))
          ($o (MutKids False (Cons $k $kr))))))
      ($o (MutKids False $kids)))))
(= (lp-shared-cert-corrupt-first-token $cert)
   (case (lp-shared-cert-corrupt-go $cert)
     (((MutOne $done $cert2) $cert2)
      ($o $cert))))

; =============== UNTRUSTED L3b helper: raw tree -> shared generalized cert ===============
(= (lp-tree-shared-kids $g $toks Nil Nil $pos) (KidsCertOk $pos Nil))
(= (lp-tree-shared-kids $g $toks Nil (Cons $k $kr) $pos) CertErr)
(= (lp-tree-shared-kids $g $toks (Cons (Tm $c) $r) $kids $pos)
   (if (== (lp-tok-at $toks $pos) $c)
       (case (lp-tree-shared-kids $g $toks $r $kids (+ $pos 1))
         (((KidsCertOk $end $certs)
           (KidsCertOk $end (Cons (TokC $c $pos) $certs)))
          ($o CertErr)))
       CertErr))
(= (lp-tree-shared-kids $g $toks (Cons (Hl $nt) $r) Nil $pos) CertErr)
(= (lp-tree-shared-kids $g $toks (Cons (Hl $nt) $r) (Cons $k $kr) $pos)
   (case (lp-tree-shared-cert-at $g $toks $nt $k $pos)
     (((CertOk $mid $cert)
       (case (lp-tree-shared-kids $g $toks $r $kr $mid)
         (((KidsCertOk $end $certs)
           (KidsCertOk $end (Cons $cert $certs)))
          ($o CertErr))))
      ($o CertErr))))
(= (lp-tree-shared-kids $g $toks (Cons (HlB $nt $scope) $r) Nil $pos) CertErr)
(= (lp-tree-shared-kids $g $toks (Cons (HlB $nt $scope) $r) (Cons $k $kr) $pos)
   (case (lp-tree-shared-cert-at $g $toks $nt $k $pos)
     (((CertOk $mid $cert)
       (case (lp-tree-shared-kids $g $toks $r $kr $mid)
         (((KidsCertOk $end $certs)
           (KidsCertOk $end (Cons $cert $certs)))
          ($o CertErr))))
      ($o CertErr))))

(= (lp-tree-shared-cert-at $g $toks $want-nt $tree $pos)
   (case $tree
     (((Lf $tok)
       (if (and (tree-ok $g (Lf $tok))
                (and (== (root-nt $g (Lf $tok)) $want-nt)
                     (== (lp-tok-at $toks $pos) $tok)))
           (CertOk (+ $pos 1) (LeafC $tok $pos (+ $pos 1)))
           CertErr))
      ((Nd $label $kids)
       (if (and (tree-ok $g (Nd $label $kids))
                (== (prod-nt $g $label) $want-nt))
           (case (template-of $g $label)
             (((Err $e) CertErr)
              ($tpl
                (case (lp-tree-shared-kids $g $toks $tpl $kids $pos)
                  (((KidsCertOk $end $certs)
                    (CertOk $end (NodeC $label $want-nt $pos $end $certs)))
                   ($o CertErr))))))
           CertErr))
      ($o CertErr))))

(= (lp-tree-shared-cert $g $nt $toks $tree)
   (if (== (lp-admit $g) Admitted)
       (case (lp-tree-shared-cert-at $g $toks $nt $tree 0)
         (((CertOk $end $cert)
           (if (== $end (lp-len $toks))
               (Ok $cert)
               (Err bad-span)))
          ($o (Err bad-tree))))
       (Err bad-grammar)))

(= (lp-parse-shared $g $nt $toks)
   (case (lp-parse-raw $g $nt $toks)
     (((Unique $tree)
       (case (lp-tree-shared-cert $g $nt $toks $tree)
         (((Ok $cert) (Unique $cert))
          ($o BadParse))))
      (Ambiguous Ambiguous)
      (NoParse NoParse)
      ($o BadParse))))

; =============== TRUSTED L4: binder-aware lowering / cert ====================
(= (env-idx $x Nil $i) NF)
(= (env-idx $x (Cons $y $ys) $i)
   (if (== $x $y) $i (env-idx $x $ys (+ $i 1))))
(= (ctx-add $nm $ctx) (if (== $nm NF) $ctx (Cons $nm $ctx)))
(= (binder-name $t) (case $t (((Lf $v) $v) ($o NF))))

(= (lp-lower $g $tree) (lp-lower-under $g Nil $tree))
(= (lp-lower-under $g $ctx $t)
   (case $t
     (((Lf $v)
       (let $i (env-idx $v $ctx 0)
         (if (== $i NF) (Lf $v) (Bv $i))))
     ((Nd $l $kids)
       (case (template-of $g $l)
         (((Err $e) (Bad badtree))
          ($tpl
            (if (tpl-has-hlb $tpl)
                (Nd $l (lower-kids $g $ctx $tpl $kids))
                (Nd $l (lower-kids-plain $g $ctx $tpl $kids)))))))
      ($o (Bad badtree)))))

(= (pend-ctx Nil $nt $ctx) $ctx)
(= (pend-ctx (Cons (PB $nm $scope) $r) $nt $ctx)
   (if (== $scope $nt)
       (ctx-add $nm (pend-ctx $r $nt $ctx))
       (pend-ctx $r $nt $ctx)))
(= (pend-drop Nil $nt) Nil)
(= (pend-drop (Cons (PB $nm $scope) $r) $nt)
   (if (== $scope $nt)
       (pend-drop $r $nt)
       (Cons (PB $nm $scope) (pend-drop $r $nt))))

(= (lower-kids-plain $g $ctx Nil Nil) Nil)
(= (lower-kids-plain $g $ctx Nil (Cons $k $kr)) Nil)
(= (lower-kids-plain $g $ctx (Cons (Tm $c) $r) $kids)
   (lower-kids-plain $g $ctx $r $kids))
(= (lower-kids-plain $g $ctx (Cons (Hl $nt) $r) Nil) Nil)
(= (lower-kids-plain $g $ctx (Cons (Hl $nt) $r) (Cons $k $kr))
   (Cons (lp-lower-under $g $ctx $k)
     (lower-kids-plain $g $ctx $r $kr)))
(= (lower-kids-plain $g $ctx (Cons (HlB $nt $scope) $r) $kids)
   (lower-kids $g $ctx (Cons (HlB $nt $scope) $r) $kids))

(= (lower-kids $g $ctx $tpl $kids) (lower-kids-pending $g $ctx Nil $tpl $kids))
(= (lower-kids-pending $g $ctx $pend Nil Nil) Nil)
(= (lower-kids-pending $g $ctx $pend Nil (Cons $k $kr)) Nil)
(= (lower-kids-pending $g $ctx $pend (Cons (Tm $c) $r) $kids)
   (lower-kids-pending $g $ctx $pend $r $kids))
(= (lower-kids-pending $g $ctx $pend (Cons (Hl $nt) $r) Nil) Nil)
(= (lower-kids-pending $g $ctx $pend (Cons (Hl $nt) $r) (Cons $k $kr))
   (Cons (lp-lower-under $g (pend-ctx $pend $nt $ctx) $k)
     (lower-kids-pending $g $ctx (pend-drop $pend $nt) $r $kr)))
(= (lower-kids-pending $g $ctx $pend (Cons (HlB $nt $scope) $r) Nil) Nil)
(= (lower-kids-pending $g $ctx $pend (Cons (HlB $nt $scope) $r) (Cons $k $kr))
   (Cons (Bd $nt $scope)
     (lower-kids-pending $g $ctx (Cons (PB (binder-name $k) $scope) $pend) $r $kr)))

(= (lp-lower-cert $g $raw-tree $canon-tree)
   (if (and (g-ok $g) (== (lp-admit $g) Admitted))
       (if (tree-ok $g $raw-tree) (== (lp-lower $g $raw-tree) $canon-tree) False)
       False))
(= (lp-parse-cert $g $nt $toks $raw-tree $canon-tree)
   (and (lp-parse-cert $g $nt $toks $raw-tree)
        (lp-lower-cert $g $raw-tree $canon-tree)))
(= (lp-shared-parse-cert $g $nt $toks $cert $canon-tree)
   (case (lp-shared-cert-tree $g $nt $toks $cert)
     (((Ok $raw-tree) (lp-parse-cert $g $nt $toks $raw-tree $canon-tree))
      ($o False))))

; ======================= grammar builders =======================
(= (conv-e (VarD $v $nt)) (VarD $v $nt))
(= (conv-e (LexD $cls $nt)) (LexD $cls $nt))
(= (conv-e (Prod $l $nt $tpl)) (Prod $l $nt (mkL $tpl)))
(= (mkGram $e) (if (== $e ()) Nil (mkG2 (decons-atom $e)))) (= (mkG2 ($h $t)) (Cons (conv-e $h) (mkGram $t)))
(= (pu-tree (Unique $t)) $t)
