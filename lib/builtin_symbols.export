(cesta-export/1 (header CETTA_BUILTIN_SYMBOLS_GENERATED_H) (profile c11)
  (table-rows "builtin_symbols.data" Builtins (macro CETTA_BUILTIN_SYMBOL_ROWS) (columns field spelling))
  (table-rows "builtin_symbols.data" Builtins (macro CETTA_PETTA_ONLY_BUILTIN_SYMBOL_ROWS) (columns field) (where petta_only true))
  (table-rows "builtin_symbols.data" Builtins (macro CETTA_BUILTIN_CONSTRUCTOR_SYMBOL_ROWS) (columns field) (where constructor true))
  (table-rows "builtin_symbols.data" Builtins (macro CETTA_PUBLIC_LIBRARY_NATIVE_SYMBOL_ROWS) (columns field) (where public_library_native true))
  (table-rows "builtin_symbols.data" Builtins (macro CETTA_STATIC_GROUNDED_SYMBOL_ROWS) (columns field) (where static_grounded true))
  (table-rows "builtin_symbols.data" Builtins (macro CETTA_PURE_GROUNDED_SYMBOL_ROWS) (columns field) (where pure_grounded true))
  (table-rows "builtin_symbols.data" Builtins (macro CETTA_TYPE_PURE_EXTRA_GROUNDED_SYMBOL_ROWS) (columns field) (where type_pure_extra true))
  (table-rows "builtin_symbols.data" Builtins (macro CETTA_SPECULATIVE_SYMBOL_ROWS) (columns field) (where speculative true)))
