; CeTTa's builtin vocabulary, declared once.
;
; Row order is the SymbolId order of the builtin interval: a new builtin is
; appended, never inserted, so every established SymbolId is preserved.
; src/generated/cetta_builtin_symbols.generated.h holds its views, through
; builtin_symbols.export (python3 tools/regenerate_registry_tables.py
; --cesta CESTA); symbol.h names them.  Each Bool column is one membership,
; and its comment states what admitting a builtin to it means.
(cesta-tables/1
    (Table Builtins
        (Columns
            (Column field Identifier)
            (Column spelling Text)
            ; Identity, dialect ownership and constructor role are separate facts.
            ; These columns supplement the registered vocabulary without changing IDs.
            (Column petta_only Bool)
            (Column constructor Bool)
            ; Libraries may publish native primitives under their public names. The
            ; shared registry supplies dispatch and operand-observation capability;
            ; no evaluator needs to recognize a library's spelling or value type.
            (Column public_library_native Bool)
            ; Builtins whose grounded-operation capability is independent of language
            ; and profile.  symbol_table_init_builtins compiles this declaration into
            ; SymbolEntry flags, so evaluator dispatch reads one capability bit instead
            ; of reclassifying an interned opcode by name.
            (Column static_grounded Bool)
            ; Grounded value operations without ambient observations or mutation, given
            ; closed values from the host. This is also an execution permission list:
            ; additions require an effect audit, not merely a predictable result type.
            (Column pure_grounded Bool)
            ; Result-type purity is weaker than effect freedom. Additional type-only
            ; licenses belong here, not in the shared execution-permission list above.
            ; Type purity is pure_grounded plus these rows.
            (Column type_pure_extra Bool)
            ; Additional operations admitted in a host-owned speculative HE context.
            ; Query spaces must be fresh in-memory projections of the supplied observation.
            ; Changes are returned as proposals, never applied through mutation builtins.
            ; Native extensions and future builtins are excluded until explicitly audited.
            (Column speculative Bool)
        )
        (Key field) (Unique spelling)
        (Rows
            (Row empty "Empty" false false false false false false false)
            (Row not_reducible "NotReducible" false false false false false false false)
            (Row error "Error" false false false false false false false)
            (Row equals "=" false false false false false false false)
            (Row atom "Atom" false false false false false false false)
            (Row symbol "Symbol" false false false false false false false)
            (Row variable "Variable" false false false false false false false)
            (Row expression "Expression" false false false false false false false)
            (Row grounded "Grounded" false false false false false false false)
            (Row list_type "List" false false false false false false false)
