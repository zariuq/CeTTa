  (1023 ARENA_LEDGER_SPACE_HELD_BYTES "arena-ledger-space-held-bytes")
  (1024 ARENA_LEDGER_SPACE_HELD_BYTES_PEAK "arena-ledger-space-held-bytes-peak")
  ; Full-size blocks retired into thread stocks, held for reuse.
  (1025 ARENA_STOCK_BYTES "arena-stock-bytes")
  (1026 ARENA_STOCK_BYTES_PEAK "arena-stock-bytes-peak")
  ; Open-equation cursors open now, suspended or running.
  (1027 OPEN_EQUATION_CURSOR_LIVE "open-equation-cursor-live")
  (1028 OPEN_EQUATION_CURSOR_LIVE_PEAK "open-equation-cursor-live-peak")
  ; Spaces initialized and not yet freed, and their structs' bytes, which
  ; live in whatever storage their creator chose.
  (1029 SPACE_LIVE "space-live")
  (1030 SPACE_LIVE_PEAK "space-live-peak")
  (1031 SPACE_STRUCT_BYTES "space-struct-bytes")
  (1032 SPACE_STRUCT_BYTES_PEAK "space-struct-bytes-peak")
  ; Heap bytes allocated while a space was initialized (C library heap
  ; accounting; zero where it is unavailable).
  (1033 SPACE_INIT_HEAP_BYTES "space-init-heap-bytes")
  ; Activation identities: acquisitions, handles returned at their last
  ; release (retired ones included), and the gauge of those live.
  (1034 FRAME_IDENTITY_MINT "frame-identity-mint")
  (1035 FRAME_IDENTITY_FREE "frame-identity-free")
  (1036 FRAME_IDENTITY_LIVE "frame-identity-live")
  (1037 FRAME_IDENTITY_LIVE_PEAK "frame-identity-live-peak")
  ; Global fresh-variable bases minted, and the symbol table's entries
  ; when the snapshot is taken: both are permanent.
  (1038 FRESH_VAR_BASE_MINT "fresh-var-base-mint")
  (1039 SYMBOL_TABLE_ENTRIES "symbol-table-entries")
  ; The deepest PeTTa search-machine choice stack.
  (1040 PETTA_CHOICE_DEPTH_PEAK "petta-choice-depth-peak")
  ; One when this binary records statistics: a build without them still
  ; prints every counter, all zero, which is not a measurement.
  (1041 STATISTICS_RECORDED "runtime-statistics-recorded")
  ; Untried equations selection refuted because their bodies begin by
  ; destructuring a value decons-atom has no answer for.
  (1042 OPEN_EQUATION_ENTRY_GUARD_REFUTED "open-equation-entry-guard-refuted")
  ; States of Prolog `eval` calls that may still be retried: created at the
  ; first call, disposed by its last answer, its failure or its prune.
  (1043 PETTA_LIBPL_EVAL_STATE_LIVE "petta-libpl-eval-state-live")
  (1044 PETTA_LIBPL_EVAL_STATE_LIVE_PEAK "petta-libpl-eval-state-live-peak")
  (1045 PETTA_LIBPL_EVAL_PRUNED "petta-libpl-eval-pruned")
  ; Collections of the search machine's heap while choices are pending,
  ; the major ones among them, and those due but declined because a
  ; pending choice cannot move its atoms.
  (1046 PETTA_CHOICE_HEAP_COLLECTIONS "petta-choice-heap-collections")
  (1047 PETTA_CHOICE_HEAP_MAJOR_COLLECTIONS "petta-choice-heap-major-collections")
  (1048 PETTA_CHOICE_HEAP_COLLECTION_DECLINED "petta-choice-heap-collection-declined")
  ; The program versions open-equation cursors keep, one per program a
  ; cursor entered, and the open tier's compiled programs alive.
  (1049 OPEN_EQUATION_CURSOR_VERSIONS_LIVE "open-equation-cursor-versions-live")
  (1050 OPEN_EQUATION_CURSOR_VERSIONS_LIVE_PEAK "open-equation-cursor-versions-live-peak")
  (1051 OPEN_EQUATION_PROGRAMS_LIVE "open-equation-programs-live")
  (1052 OPEN_EQUATION_PROGRAMS_LIVE_PEAK "open-equation-programs-live-peak")
  ; The open-equation cursors' collections: minor and major ones that
  ; copied, those declined for finding most of their generation reached,
  ; the bytes minor collections promoted, the old generation's largest
  ; size after a collection, and the region's largest size when one was
  ; tried.
  (1053 OPEN_EQUATION_MINOR_COLLECTIONS "open-equation-minor-collections")
  (1054 OPEN_EQUATION_MAJOR_COLLECTIONS "open-equation-major-collections")
  (1055 OPEN_EQUATION_MINOR_COLLECTIONS_DECLINED "open-equation-minor-collections-declined")
  (1056 OPEN_EQUATION_MAJOR_COLLECTIONS_DECLINED "open-equation-major-collections-declined")
  (1057 OPEN_EQUATION_PROMOTED_BYTES "open-equation-promoted-bytes")
  (1058 OPEN_EQUATION_OLD_BYTES_PEAK "open-equation-old-bytes-peak")
  (1059 OPEN_EQUATION_REGION_AT_COLLECTION_BYTES_PEAK "open-equation-region-at-collection-bytes-peak")
  ; What a major collection keeps, at most: the cursors' live data at the
  ; moments majors run.
  (1060 OPEN_EQUATION_MAJOR_SURVIVOR_BYTES_PEAK "open-equation-major-survivor-bytes-peak")
  ; HE completed values (eval_he_value_index.inc): certificates issued,
  ; occurrences delivered from one instead of interpreted, and rebuilt
  ; calls published as their own source.
  (1061 HE_COMPLETED_VALUE_CERTIFIED "he-completed-value-certified")
  (1062 HE_COMPLETED_VALUE_DELIVERED "he-completed-value-delivered")
  (1063 HE_COMPLETED_VALUE_SHARED "he-completed-value-shared")
  (1064 BINDINGS_FRAME_ID_SET_LOOKUP "bindings-frame-id-set-lookup")
  (1065 BINDINGS_FRAME_ID_SET_PROBE "bindings-frame-id-set-probe")
  (1066 PETTA_IDENTITY_PRESSURE_COLLECTION "petta-identity-pressure-collection")
  ; exec:saturate realized semi-naively (exec_saturation.h): saturations
  ; admitted, rounds run, and template instances proposed.
  (1067 EXEC_SATURATION_ADMITTED "exec-saturation-admitted")
  (1068 EXEC_SATURATION_ROUND "exec-saturation-round")
  (1069 EXEC_SATURATION_PROPOSAL "exec-saturation-proposal")
  ; A lexical filter realized by one revision-pinned pure program: attempts
  ; admitted, items tested, complete filters published, and safe declines to
  ; the existential relational implementation. Replay-safety decisions share
  ; a cache but retain operation-specific receipts.
  (1070 PREPARED_FILTER_ADMISSION "prepared-filter-admission")
  (1071 PREPARED_FILTER_STEP "prepared-filter-step")
  (1072 PREPARED_FILTER_COMMIT "prepared-filter-commit")
  (1073 PREPARED_FILTER_DECLINE "prepared-filter-decline")
  (1074 PREPARED_FILTER_SAFETY_CHECK "prepared-filter-safety-check")
  (1075 PREPARED_FILTER_SAFETY_REUSE "prepared-filter-safety-reuse")
  ; A registered SWI pairing-heap call realized without crossing the Prolog
  ; boundary. Attempts include safe declines; commits publish one exact
  ; answer. Melds and copied child slots expose the persistent-heap cost.
  (1076 PETTA_PRIORITY_HEAP_ATTEMPT "petta-priority-heap-attempt")
  (1077 PETTA_PRIORITY_HEAP_COMMIT "petta-priority-heap-commit")
  (1078 PETTA_PRIORITY_HEAP_DECLINE "petta-priority-heap-decline")
  (1079 PETTA_PRIORITY_HEAP_MELD "petta-priority-heap-meld")
  (1080 PETTA_PRIORITY_HEAP_CHILD_COPY "petta-priority-heap-child-copy")
  ; Ground closed is-member observations whose matching multiplicity is at
  ; most one, answered inside the open-equation region.
  (1081 OPEN_EQUATION_MEMBER "open-equation-member")
  ; Head and tail observations of an already-resolved open-cons value. The
  ; selected child remains in the cursor's region; no list is materialized.
  (1082 OPEN_EQUATION_OPEN_CONS_PROJECTION
        "open-equation-open-cons-projection")
  ; Binary min/max over ready Int/Float operands, selected by the same
  ; comparison as PeTTa's canonical expansion.
  (1083 OPEN_EQUATION_MINMAX "open-equation-minmax")
  ; Completion of an unforgeable partial with a named base directly enters
  ; the current admitted relation after concatenating stored and new values.
  (1084 OPEN_EQUATION_PARTIAL_ENTER "open-equation-partial-enter")
  ; Exact applications of privately tagged one- and two-place lexical
  ; callables realized by a cursor-owned determinate pure plan.
  (1085 OPEN_EQUATION_PURE_CALLABLE "open-equation-pure-callable")
  ; Under-application of a private lexical callable, retaining the ready
  ; argument prefix in the canonical partial carrier.
  (1086 OPEN_EQUATION_LAMBDA_PARTIAL "open-equation-lambda-partial")
  ; A privately tagged callable carrier delivered by a generic host step as
  ; the value it already is. Only an outer application may execute it.
  (1087 OPEN_EQUATION_CALLABLE_VALUE "open-equation-callable-value")
  ; Case arms matched as constructor decision trees over ground values;
  ; open values and list-carrier equivalences retain full unification.
  (1088 OPEN_EQUATION_GROUND_CASE_MATCH
        "open-equation-ground-case-match")
  ; A sole full signature whose preparation has no rejecting type guard,
  ; executed without a one-alternative dispatch wrapper.
  (1089 OPEN_EQUATION_IDENTITY_TYPED_CALL
        "open-equation-identity-typed-call")
  ; PeTTa sealed prepared as code plus environment inside the equation
  ; region; only its freshened computation suspends to the host.
  (1090 OPEN_EQUATION_SEALED_CONTINUATION
        "open-equation-sealed-continuation")
  ; Exact source-recognized structural length recurrences executed as one
  ; least-work constructor-spine loop.
  (1091 OPEN_EQUATION_ALGEBRAIC_LENGTH
        "open-equation-algebraic-length")
  ; Exact source-recognized structural append recurrences executed by
  ; sharing the right operand and rebuilding the left prefix once.
  (1092 OPEN_EQUATION_ALGEBRAIC_APPEND
        "open-equation-algebraic-append")
  ; Exact source-recognized projection-map recurrences executed by one
  ; input-spine scan and one output-prefix construction.
  (1093 OPEN_EQUATION_ALGEBRAIC_PROJECT_MAP
        "open-equation-algebraic-project-map")
  ; Exact source-recognized short-circuit constructor-membership folds.
  (1094 OPEN_EQUATION_ALGEBRAIC_CONTAINS
        "open-equation-algebraic-contains")
  ; Nonnegative source-certified decrement-and-tail folds.
  (1095 OPEN_EQUATION_ALGEBRAIC_DROP "open-equation-algebraic-drop")
  ; Source-certified additive folds over proper recursive child fields.
  (1096 OPEN_EQUATION_ALGEBRAIC_SCALAR_SUM "open-equation-algebraic-scalar-sum")
  ; Nodes inspected by additive fold attempts, including declined prefixes.
  (1097 OPEN_EQUATION_ALGEBRAIC_SCALAR_NODE "open-equation-algebraic-scalar-node")
  ; Accepted direct native entries; a refusal performs no native call.
  (1098 OPEN_EQUATION_NATIVE_CALL "open-equation-native-call")
  ; Cons cells a reader read back as the flat list they spell.  A complete
  ; list is built flat, so only a list whose tail was open when it was built
  ; is read this way.
  (1099 PETTA_LIST_CELLS_FLATTENED "petta-list-cells-flattened")
  ; The ordered rows of each head and length that a query selecting by its
  ; head alone reads lazily: indexes built, rows they were built over,
  ; cursors that read one, and rows those cursors offered.
  (1100 SPACE_HEAD_INDEX_BUILD "space-head-index-build")
  (1101 SPACE_HEAD_INDEX_BUILD_ROW "space-head-index-build-row")
  (1102 SPACE_HEAD_INDEX_CURSOR "space-head-index-cursor")
  (1103 SPACE_HEAD_INDEX_ROW "space-head-index-row")
  ; Slots a table keyed by atoms passes before it meets its key or an empty
  ; slot: unique-atom, and the answer tables of tabled and memoized calls.
  (1104 ATOM_TABLE_KEY_PROBE "atom-table-key-probe")
  ; Matches whose whole answer bag the native query path computed, for an
  ; observer that takes every answer, and the answers they gave.
  (1105 NATIVE_QUERY_ADMISSION "native-query-admission")
  (1106 NATIVE_QUERY_ANSWER "native-query-answer")
  ; The candidate rows the native query path's index loops read.
  (1107 NATIVE_QUERY_LOOP_ROW "native-query-loop-row")
  ; Conjunctions over dense binary relations joined by rows of bits, and the
  ; machine words those rows gave.
  (1108 DENSE_RELATION_ADMISSION "dense-relation-admission")
  (1109 DENSE_RELATION_WORD "dense-relation-word")
  ; The instances the native query path made for its effects.
  (1110 NATIVE_QUERY_EFFECT_INSTANCE "native-query-effect-instance")
  ; Collections of the term universe: those run and those a region held
  ; off, the roots listed, the entries found live and dead, the dead record
  ; bytes, and the most entries one collection found dead.
  (1111 TERM_UNIVERSE_COLLECTION "term-universe-collection")
  (1112 TERM_UNIVERSE_COLLECTION_INHIBITED "term-universe-collection-inhibited")
  (1113 TERM_UNIVERSE_COLLECTION_ROOT "term-universe-collection-root")
  (1114 TERM_UNIVERSE_COLLECTION_LIVE "term-universe-collection-live")
  (1115 TERM_UNIVERSE_COLLECTION_DEAD "term-universe-collection-dead")
  (1116 TERM_UNIVERSE_COLLECTION_DEAD_BYTES "term-universe-collection-dead-bytes")
  (1117 TERM_UNIVERSE_COLLECTION_DEAD_PEAK "term-universe-collection-dead-peak")
  ; Entries a reclaiming collection freed, and their record bytes.
  (1118 TERM_UNIVERSE_COLLECTION_RECLAIMED "term-universe-collection-reclaimed")
  (1119 TERM_UNIVERSE_COLLECTION_RECLAIMED_BYTES "term-universe-collection-reclaimed-bytes")
  ; Pairs of subterms a structural comparison visits.
  (1120 ATOM_COMPARE_PAIR "atom-compare-pair")
  ; Legs of a native query that read the pairs of a relation kept as bits.
  (1121 NATIVE_QUERY_BITS_LEG "native-query-bits-leg")))
