; Decision procedure for the typed algorithmic equality on kernel terms.
; Index arithmetic follows Presentation.wk and Presentation.inst0: an index
; below the cutoff stays, every other index moves by the shift, and inst0
; replaces index 0. A binder increments the cutoff and weakens the substitute.
; MettaKernel's waist is the same arithmetic on another grammar and is not imported.
; (Lam domain body) binds only the body. A one-argument Lam is body-only.
; Fuel 0 and a head outside the Pi/Sigma/Id/universe/spine fragment yield
; Unresolved. A shape the relation rejects yields Refuted.

(= (tc:tag (Got $t)) Got)
(= (tc:tag Miss) Miss)
(= (tc:tag (Lvl $n)) Lvl)
(= (tc:tag Open) Open)
(= (tc:tag (Ok $t)) Ok)
(= (tc:tag NoFuel) NoFuel)
(= (tc:tag (Step $t)) Step)
(= (tc:tag Stuck) Stuck)
(= (tc:tag (Hit $b)) Hit)
(= (tc:tag None) None)
(= (tc:tag (Some $i)) Some)
(= (tc:tag (Bind $k $t)) Bind)

(= (tc:got-tm (Got $t)) $t)
(= (tc:ok-tm (Ok $t)) $t)
(= (tc:lvl-n (Lvl $n)) $n)
(= (tc:hit-binds (Hit $b)) $b)
(= (tc:some-ix (Some $i)) $i)

(= (tc:h $t)
   (if (== (get-metatype $t) Expression) (car-atom $t) $t))

(= (tc:nargs $t)
   (if (== (get-metatype $t) Expression)
     (let $n (size-atom $t)
       (if (< 0 $n) (- $n 1) 0))
     0))

(= (tc:a0 $t)
   (let $c (cdr-atom $t) (car-atom $c)))
(= (tc:a1 $t)
   (let $c (cdr-atom $t)
     (let $r (cdr-atom $c) (car-atom $r))))
(= (tc:a2 $t)
   (let $c (cdr-atom $t)
     (let $r1 (cdr-atom $c)
       (let $r2 (cdr-atom $r1) (car-atom $r2)))))
(= (tc:a3 $t)
   (let $c (cdr-atom $t)
     (let $r1 (cdr-atom $c)
       (let $r2 (cdr-atom $r1)
         (let $r3 (cdr-atom $r2) (car-atom $r3))))))

(= (tc:mk1 Fst $a) (Fst $a))
(= (tc:mk1 Snd $a) (Snd $a))
(= (tc:mk1 Refl $a) (Refl $a))
(= (tc:mk2 App $a $b) (App $a $b))
(= (tc:mk2 Pair $a $b) (Pair $a $b))
(= (tc:mk2 Pi $a $b) (Pi $a $b))
(= (tc:mk2 Sigma $a $b) (Sigma $a $b))
(= (tc:mk2 Lam $a $b) (Lam $a $b))

(= (tc:expr-empty $e)
   (if (== (get-metatype $e) Expression)
     (if (== (size-atom $e) 0) Yes No)
     Yes))

(= (tc:list-empty Nil) Yes)
(= (tc:list-empty (Cons $a $r)) No)
(= (tc:list-hd (Cons $a $r)) $a)
(= (tc:list-tl (Cons $a $r)) $r)
(= (tc:list-len Nil) 0)
(= (tc:list-len (Cons $a $r)) (+ 1 (tc:list-len $r)))

(= (tc:nth Nil $i) Miss)
(= (tc:nth (Cons $a $r) $i) (tc:nth-go $a $r $i (== $i 0)))
(= (tc:nth-go $a $r $i True) (Got $a))
(= (tc:nth-go $a $r $i False) (tc:nth $r (- $i 1)))

(= (tc:replace Nil $i $x) Nil)
(= (tc:replace (Cons $a $r) $i $x) (tc:replace-go $a $r $i $x (== $i 0)))
(= (tc:replace-go $a $r $i $x True) (Cons $x $r))
(= (tc:replace-go $a $r $i $x False)
   (Cons $a (tc:replace $r (- $i 1) $x)))

(= (tc:bind-get $k Nil) Miss)
(= (tc:bind-get $k (Cons (Bind $n $t) $rest))
   (if (== $n $k) (Got $t) (tc:bind-get $k $rest)))

(= (tc:both $x $y)
   (if (== $x Unresolved) Unresolved
     (if (== $y Unresolved) Unresolved
       (if (== $x Refuted) Refuted
         (if (== $y Refuted) Refuted
           (if (== (tc:h $x) Refuted) $x
             (if (== (tc:h $y) Refuted) $y
               (if (== $x Accepted)
                 (if (== $y Accepted) Accepted Unresolved)
                 Unresolved))))))))

; ---------- levels ----------

(= (tc:norm-suc (Lvl $n)) (Lvl (+ $n 1)))
(= (tc:norm-suc Open) Open)
(= (tc:norm-max (Lvl $a) (Lvl $b))
   (if (< $a $b) (Lvl $b) (Lvl $a)))
(= (tc:norm-max (Lvl $a) Open) Open)
(= (tc:norm-max Open (Lvl $b)) Open)
(= (tc:norm-max Open Open) Open)
(= (tc:level-of $t)
   (let $h (tc:h $t)
     (if (== $h LevelConst) (Lvl (tc:a0 $t))
       (if (== $h LevelSucc) (tc:norm-suc (tc:level-of (tc:a0 $t)))
         (if (== $h LevelMax)
           (tc:norm-max (tc:level-of (tc:a0 $t)) (tc:level-of (tc:a1 $t)))
           Open)))))

; ---------- shift and substitution ----------

(= (tc:cut $fault $c)
   (if (== $fault wrong-shift) $c (+ $c 1)))

(= (tc:shift $fault $d $c $t)
   (let $h (tc:h $t)
     (if (== $h idx) (tc:shift-idx $d $c $t)
       (if (== $h Lam) (tc:shift-lam $fault $d $c $t)
         (if (== $h Pi) (tc:shift-binder $fault $d $c Pi $t)
           (if (== $h Sigma) (tc:shift-binder $fault $d $c Sigma $t)
             (if (== $h Id) (tc:shift-id $fault $d $c $t)
               (if (== $h App) (tc:shift-bin $fault $d $c App $t)
                 (if (== $h Pair) (tc:shift-bin $fault $d $c Pair $t)
                   (if (== $h Fst) (tc:shift-unary $fault $d $c Fst $t)
                     (if (== $h Snd) (tc:shift-unary $fault $d $c Snd $t)
                       (if (== $h Refl) (tc:shift-unary $fault $d $c Refl $t)
                         $t))))))))))))

(= (tc:shift-idx $d $c (idx $k))
   (tc:shift-idx-go $d $k (< $k $c)))
(= (tc:shift-idx-go $d $k True) (idx $k))
(= (tc:shift-idx-go $d $k False) (idx (+ $k $d)))

(= (tc:shift-unary $fault $d $c $h $t)
   (tc:mk1 $h (tc:shift $fault $d $c (tc:a0 $t))))

(= (tc:shift-bin $fault $d $c $h $t)
   (tc:mk2 $h
     (tc:shift $fault $d $c (tc:a0 $t))
     (tc:shift $fault $d $c (tc:a1 $t))))

(= (tc:shift-binder $fault $d $c $h $t)
   (tc:mk2 $h
     (tc:shift $fault $d $c (tc:a0 $t))
     (tc:shift $fault $d (tc:cut $fault $c) (tc:a1 $t))))

(= (tc:shift-lam $fault $d $c $t)
   (if (== (tc:nargs $t) 1)
     (Lam (tc:shift $fault $d (tc:cut $fault $c) (tc:a0 $t)))
     (tc:shift-binder $fault $d $c Lam $t)))

(= (tc:shift-id $fault $d $c $t)
   (Id
     (tc:shift $fault $d $c (tc:a0 $t))
     (tc:shift $fault $d $c (tc:a1 $t))
     (tc:shift $fault $d $c (tc:a2 $t))))

(= (tc:wk $fault $t) (tc:shift $fault 1 0 $t))

(= (tc:subst-lift $fault $s)
   (if (== $fault wrong-shift) $s (tc:wk $fault $s)))

(= (tc:subst $fault $j $s $t)
   (let $h (tc:h $t)
     (if (== $h idx) (tc:subst-idx $j $s $t)
       (if (== $h Lam) (tc:subst-lam $fault $j $s $t)
         (if (== $h Pi) (tc:subst-binder $fault $j $s Pi $t)
           (if (== $h Sigma) (tc:subst-binder $fault $j $s Sigma $t)
             (if (== $h Id) (tc:subst-id $fault $j $s $t)
               (if (== $h App) (tc:subst-bin $fault $j $s App $t)
                 (if (== $h Pair) (tc:subst-bin $fault $j $s Pair $t)
                   (if (== $h Fst) (tc:subst-unary $fault $j $s Fst $t)
                     (if (== $h Snd) (tc:subst-unary $fault $j $s Snd $t)
                       (if (== $h Refl) (tc:subst-unary $fault $j $s Refl $t)
                         $t))))))))))))

(= (tc:subst-idx $j $s (idx $k))
   (tc:subst-idx-eq $j $s $k (== $k $j)))
(= (tc:subst-idx-eq $j $s $k True) $s)
(= (tc:subst-idx-eq $j $s $k False)
   (tc:subst-idx-gt $j $s $k (< $j $k)))
(= (tc:subst-idx-gt $j $s $k True) (idx (- $k 1)))
(= (tc:subst-idx-gt $j $s $k False) (idx $k))

(= (tc:subst-unary $fault $j $s $h $t)
   (tc:mk1 $h (tc:subst $fault $j $s (tc:a0 $t))))

(= (tc:subst-bin $fault $j $s $h $t)
   (let $x (tc:a0 $t)
     (let $y (tc:a1 $t)
       (tc:subst-pair $fault $j $s $h $x $y))))
(= (tc:subst-pair $fault $j $s App $x $y)
   (let $x2 (tc:subst $fault $j $s $x)
     (let $y2 (tc:subst $fault $j $s $y)
       (App $x2 $y2))))
(= (tc:subst-pair $fault $j $s Pair $x $y)
   (let $x2 (tc:subst $fault $j $s $x)
     (let $y2 (tc:subst $fault $j $s $y)
       (Pair $x2 $y2))))
(= (tc:join-app $x $y) (App $x $y))
(= (tc:join-pair $x $y) (Pair $x $y))

(= (tc:subst-binder $fault $j $s $h $t)
   (tc:mk2 $h
     (tc:subst $fault $j $s (tc:a0 $t))
     (tc:subst $fault (+ $j 1) (tc:subst-lift $fault $s) (tc:a1 $t))))

(= (tc:subst-lam $fault $j $s $t)
   (if (== (tc:nargs $t) 1)
     (Lam (tc:subst $fault (+ $j 1) (tc:subst-lift $fault $s) (tc:a0 $t)))
     (tc:subst-binder $fault $j $s Lam $t)))

(= (tc:subst-id $fault $j $s $t)
   (Id
     (tc:subst $fault $j $s (tc:a0 $t))
     (tc:subst $fault $j $s (tc:a1 $t))
     (tc:subst $fault $j $s (tc:a2 $t))))

(= (tc:inst0 $fault $s $body) (tc:subst $fault 0 $s $body))

(= (tc:lam-body $t)
   (if (== (tc:nargs $t) 1) (tc:a0 $t) (tc:a1 $t)))

; ---------- pattern variables into a right-hand side ----------

(= (tc:papply $binds $depth $fault $t)
   (let $h (tc:h $t)
     (if (== $h PVar) (tc:papply-var $binds $depth $fault $t)
       (if (== $h Lam) (tc:papply-lam $binds $depth $fault $t)
         (if (== $h Pi) (tc:papply-binder $binds $depth $fault Pi $t)
           (if (== $h Sigma) (tc:papply-binder $binds $depth $fault Sigma $t)
             (if (== $h Id) (tc:papply-id $binds $depth $fault $t)
               (if (== $h App) (tc:papply-bin $binds $depth $fault App $t)
                 (if (== $h Pair) (tc:papply-bin $binds $depth $fault Pair $t)
                   (if (== $h Fst) (tc:papply-unary $binds $depth $fault Fst $t)
                     (if (== $h Snd) (tc:papply-unary $binds $depth $fault Snd $t)
                       (if (== $h Refl) (tc:papply-unary $binds $depth $fault Refl $t)
                         $t))))))))))))

(= (tc:papply-var $binds $depth $fault $t)
   (let $got (tc:bind-get (tc:a0 $t) $binds)
     (if (== (tc:tag $got) Got)
       (tc:shift $fault $depth 0 (tc:got-tm $got))
       $t)))

(= (tc:papply-unary $binds $depth $fault $h $t)
   (tc:mk1 $h (tc:papply $binds $depth $fault (tc:a0 $t))))

(= (tc:papply-bin $binds $depth $fault $h $t)
   (tc:mk2 $h
     (tc:papply $binds $depth $fault (tc:a0 $t))
     (tc:papply $binds $depth $fault (tc:a1 $t))))

(= (tc:papply-binder $binds $depth $fault $h $t)
   (tc:mk2 $h
     (tc:papply $binds $depth $fault (tc:a0 $t))
     (tc:papply $binds (+ $depth 1) $fault (tc:a1 $t))))

(= (tc:papply-lam $binds $depth $fault $t)
   (if (== (tc:nargs $t) 1)
     (Lam (tc:papply $binds (+ $depth 1) $fault (tc:a0 $t)))
     (tc:papply-binder $binds $depth $fault Lam $t)))

(= (tc:papply-id $binds $depth $fault $t)
   (Id
     (tc:papply $binds $depth $fault (tc:a0 $t))
     (tc:papply $binds $depth $fault (tc:a1 $t))
     (tc:papply $binds $depth $fault (tc:a2 $t))))

; ---------- declarations ----------

(= (tc:decl-get $name Nil) Miss)
(= (tc:decl-get $name PrimeCtxNil) Miss)
(= (tc:decl-get $name (Cons (Decl $n $ty) $rest))
   (if (== $n $name) (Got $ty) (tc:decl-get $name $rest)))
(= (tc:decl-get $name (PrimeCtxDecl $const $ty $rest))
   (if (== (tc:a0 $const) $name) (Got $ty) (tc:decl-get $name $rest)))

(= (tc:lookup $fault Nil $i) Miss)
(= (tc:lookup $fault PrimeCtxNil $i) Miss)
(= (tc:lookup $fault (Cons $a $rest) $i)
   (tc:lookup-go $fault $a $rest $i (== $i 0)))
(= (tc:lookup $fault (PrimeCtxCons $a $rest) $i)
   (tc:lookup-go $fault $a $rest $i (== $i 0)))
(= (tc:lookup-go $fault $a $rest $i True) (Got (tc:wk $fault $a)))
(= (tc:lookup-go $fault $a $rest $i False)
   (tc:lookup-wk $fault (tc:lookup $fault $rest (- $i 1))))
(= (tc:lookup-wk $fault (Got $t)) (Got (tc:wk $fault $t)))
(= (tc:lookup-wk $fault Miss) Miss)

; ---------- weak-head step ----------

(= (tc:apply-spine $h Nil) $h)
(= (tc:apply-spine $h (Cons $a $r))
   (tc:apply-spine (App $h $a) $r))

(= (tc:unspine $t $acc)
   (if (== (tc:h $t) App)
     (tc:unspine (tc:a0 $t) (Cons (tc:a1 $t) $acc))
     (Spine $t $acc)))

(= (tc:step $rules $fault $t)
   (let $h (tc:h $t)
     (if (== $h App) (tc:step-app $rules $fault $t)
       (if (== $h Fst) (tc:step-fst $rules $fault $t)
         (if (== $h Snd) (tc:step-snd $rules $fault $t)
           (if (== $h DeclConst)
             (tc:step-spine $rules $fault (Spine $t Nil))
             Stuck))))))

(= (tc:step-app $rules $fault $t)
   (let $f (tc:a0 $t)
     (let $a (tc:a1 $t)
       (if (== (tc:h $f) Lam)
         (tc:step-beta $fault $a (tc:lam-body $f))
         (let $sf (tc:step $rules $fault $f)
           (if (== (tc:tag $sf) Step)
             (Step (App (tc:got-step $sf) $a))
             (tc:step-spine $rules $fault (tc:unspine $t Nil))))))))
; inst0 of the fresh variable is the argument. Doing that before the general
; substitution keeps a large argument out of the elaborator.
(= (tc:step-beta $fault $a (idx $k))
   (tc:step-beta-idx $fault $a $k (== $k 0)))
(= (tc:step-beta-idx $fault $a $k True) (Step $a))
(= (tc:step-beta-idx $fault $a $k False) (Step (tc:inst0 $fault $a (idx $k))))
(= (tc:step-beta $fault $a (Lam $d $b)) (Step (tc:inst0 $fault $a (Lam $d $b))))
(= (tc:step-beta $fault $a (Lam $b)) (Step (tc:inst0 $fault $a (Lam $b))))
(= (tc:step-beta $fault $a (App $f $x)) (Step (tc:inst0 $fault $a (App $f $x))))
(= (tc:step-beta $fault $a (DeclConst $n)) (Step (tc:inst0 $fault $a (DeclConst $n))))
(= (tc:step-beta $fault $a (Pi $d $b)) (Step (tc:inst0 $fault $a (Pi $d $b))))
(= (tc:step-beta $fault $a (Sigma $d $b)) (Step (tc:inst0 $fault $a (Sigma $d $b))))
(= (tc:step-beta $fault $a (Pair $x $y)) (Step (tc:inst0 $fault $a (Pair $x $y))))
(= (tc:step-beta $fault $a (Fst $p)) (Step (tc:inst0 $fault $a (Fst $p))))
(= (tc:step-beta $fault $a (Snd $p)) (Step (tc:inst0 $fault $a (Snd $p))))
(= (tc:step-beta $fault $a (Refl $x)) (Step (tc:inst0 $fault $a (Refl $x))))
(= (tc:step-beta $fault $a (Id $x $y $z)) (Step (tc:inst0 $fault $a (Id $x $y $z))))
(= (tc:step-beta $fault $a (Sort $l)) (Step (tc:inst0 $fault $a (Sort $l))))

(= (tc:got-step (Step $t)) $t)

(= (tc:step-fst $rules $fault $t)
   (let $p (tc:a0 $t)
     (if (== (tc:h $p) Pair)
       (Step (tc:a0 $p))
       (let $sp (tc:step $rules $fault $p)
         (if (== (tc:tag $sp) Step)
           (Step (Fst (tc:got-step $sp)))
           Stuck)))))

(= (tc:step-snd $rules $fault $t)
   (let $p (tc:a0 $t)
     (if (== (tc:h $p) Pair)
       (Step (tc:a1 $p))
       (let $sp (tc:step $rules $fault $p)
         (if (== (tc:tag $sp) Step)
           (Step (Snd (tc:got-step $sp)))
           Stuck)))))

(= (tc:step-spine $rules $fault (Spine $head $args))
   (if (== (tc:h $head) DeclConst)
     (tc:try-rules $rules $fault $args (tc:a0 $head) $head)
     Stuck))

(= (tc:try-rules $rules $fault $args $name $head)
   (if (== (get-metatype $rules) Expression)
     (if (== (tc:h $rules) LCons)
       (let $one (tc:try-one (tc:a0 $rules) $rules $fault $args $name $head)
         (if (== (tc:tag $one) Step)
           $one
           (tc:try-rules (tc:a1 $rules) $fault $args $name $head)))
       Stuck)
     Stuck))

(= (tc:try-one $rule $rules $fault $args $name $head)
   (if (== (tc:h $rule) PrimeRule)
     (let $rh (tc:a0 $rule)
       (if (== $rh $name)
         (tc:try-shaped $rules $fault $args (tc:a1 $rule) (tc:a2 $rule) (tc:a3 $rule) $head)
         Miss))
     Miss))

(= (tc:try-shaped $rules $fault $args $arity $pats $rhs $head)
   (let $n (tc:list-len $args)
     (if (== $n $arity)
       (tc:try-exact $rules $fault $args $pats $rhs $head)
       (if (== (tc:below $fault $n $arity) Yes)
         (tc:fire $fault $args $pats $rhs)
         Miss))))

(= (tc:below $fault $n $arity)
   (if (== $fault delta-below-arity)
     (if (< 0 $n) (if (< $n $arity) Yes No) No)
     No))

(= (tc:try-exact $rules $fault $args $pats $rhs $head)
   (let $ix (tc:scrut-ix $pats 0)
     (if (== (tc:tag $ix) Some)
       (tc:try-scrut $rules $fault $args $pats $rhs $head (tc:some-ix $ix))
       (tc:fire $fault $args $pats $rhs))))

(= (tc:scrut-ix $pats $i)
   (if (== (tc:expr-empty $pats) Yes)
     None
     (let $p (car-atom $pats)
       (if (== (tc:h $p) PVar)
         (tc:scrut-ix (cdr-atom $pats) (+ $i 1))
         (Some $i)))))

(= (tc:try-scrut $rules $fault $args $pats $rhs $head $i)
   (let $arg (tc:nth $args $i)
     (if (== (tc:tag $arg) Got)
       (let $st (tc:step $rules $fault (tc:got-tm $arg))
         (if (== (tc:tag $st) Step)
           (Step (tc:apply-spine $head (tc:replace $args $i (tc:got-step $st))))
           (tc:fire $fault $args $pats $rhs)))
       Miss)))

(= (tc:fire $fault $args $pats $rhs)
   (let $m (tc:match-all $pats $args Nil $fault)
     (if (== (tc:tag $m) Hit)
       (Step (tc:papply (tc:hit-binds $m) 0 $fault $rhs))
       Miss)))

(= (tc:match-all $pats $args $binds $fault)
   (if (== (tc:expr-empty $pats) Yes)
     (if (== (tc:list-empty $args) Yes) (Hit $binds) Miss)
     (if (== (tc:list-empty $args) Yes)
       (if (== $fault delta-below-arity) (Hit $binds) Miss)
       (let $m (tc:match (car-atom $pats) (tc:list-hd $args) $binds $fault)
         (if (== (tc:tag $m) Hit)
           (tc:match-all (cdr-atom $pats) (tc:list-tl $args) (tc:hit-binds $m) $fault)
           Miss)))))

(= (tc:match $pat $term $binds $fault)
   (let $hp (tc:h $pat)
     (if (== $hp PVar)
       (tc:match-pvar (tc:a0 $pat) $term $binds $fault)
       (if (== $hp PRefl)
         (tc:match-refl $pat $term $binds $fault)
         (if (== $hp Refl)
           (tc:match-refl $pat $term $binds $fault)
           (if (== $hp $term) (Hit $binds)
             (if (== $hp (tc:h $term))
               (tc:match-kids $hp $pat $term $binds $fault)
               Miss)))))))

(= (tc:match-pvar $k $term $binds $fault)
   (let $old (tc:bind-get $k $binds)
     (if (== (tc:tag $old) Got)
       (if (== (tc:got-tm $old) $term) (Hit $binds)
         (if (== $fault skip-endpoint) (Hit $binds) Miss))
       (Hit (Cons (Bind $k $term) $binds)))))

; skip-j-refl does not fire a Refl pattern. fire-j-neutral binds that
; pattern's payload against the neutral scrutinee itself.
(= (tc:match-refl $pat $term $binds $fault)
   (tc:match-refl-go $pat $term $binds $fault (== $fault skip-j-refl)))
(= (tc:match-refl-go $pat $term $binds $fault True) Miss)
(= (tc:match-refl-go $pat $term $binds $fault False)
   (tc:match-refl-head $pat $term $binds $fault (== (tc:h $term) Refl)))
(= (tc:match-refl-head $pat $term $binds $fault True)
   (tc:match (tc:a0 $pat) (tc:a0 $term) $binds $fault))
(= (tc:match-refl-head $pat $term $binds $fault False)
   (tc:match-refl-neutral $pat $term $binds $fault (== $fault fire-j-neutral)))
(= (tc:match-refl-neutral $pat $term $binds $fault True)
   (tc:match (tc:a0 $pat) $term $binds $fault))
(= (tc:match-refl-neutral $pat $term $binds $fault False) Miss)

(= (tc:match-kids idx $pat $term $binds $fault)
   (if (== (tc:a0 $pat) (tc:a0 $term)) (Hit $binds) Miss))
(= (tc:match-kids DeclConst $pat $term $binds $fault)
   (if (== (tc:a0 $pat) (tc:a0 $term)) (Hit $binds) Miss))
(= (tc:match-kids Sort $pat $term $binds $fault)
   (if (== (tc:a0 $pat) (tc:a0 $term)) (Hit $binds) Miss))
(= (tc:match-kids App $pat $term $binds $fault)
   (tc:match-two (tc:a0 $pat) (tc:a0 $term) (tc:a1 $pat) (tc:a1 $term) $binds $fault))
(= (tc:match-kids Pair $pat $term $binds $fault)
   (tc:match-two (tc:a0 $pat) (tc:a0 $term) (tc:a1 $pat) (tc:a1 $term) $binds $fault))
(= (tc:match-kids Pi $pat $term $binds $fault)
   (tc:match-two (tc:a0 $pat) (tc:a0 $term) (tc:a1 $pat) (tc:a1 $term) $binds $fault))
(= (tc:match-kids Sigma $pat $term $binds $fault)
   (tc:match-two (tc:a0 $pat) (tc:a0 $term) (tc:a1 $pat) (tc:a1 $term) $binds $fault))
(= (tc:match-kids Lam $pat $term $binds $fault)
   (tc:match-two (tc:a0 $pat) (tc:a0 $term) (tc:a1 $pat) (tc:a1 $term) $binds $fault))
(= (tc:match-kids Fst $pat $term $binds $fault)
   (tc:match (tc:a0 $pat) (tc:a0 $term) $binds $fault))
(= (tc:match-kids Snd $pat $term $binds $fault)
   (tc:match (tc:a0 $pat) (tc:a0 $term) $binds $fault))
(= (tc:match-kids Refl $pat $term $binds $fault)
   (tc:match (tc:a0 $pat) (tc:a0 $term) $binds $fault))
(= (tc:match-kids Id $pat $term $binds $fault)
   (let $m (tc:match (tc:a0 $pat) (tc:a0 $term) $binds $fault)
     (if (== (tc:tag $m) Hit)
       (tc:match-two (tc:a1 $pat) (tc:a1 $term) (tc:a2 $pat) (tc:a2 $term) (tc:hit-binds $m) $fault)
       Miss)))

(= (tc:match-two $p1 $t1 $p2 $t2 $binds $fault)
   (let $m (tc:match $p1 $t1 $binds $fault)
     (if (== (tc:tag $m) Hit)
       (tc:match $p2 $t2 (tc:hit-binds $m) $fault)
       Miss)))

(= (tc:whnf $n $rules $fault $t)
   (if (< 0 $n)
     (let $s (tc:step $rules $fault $t)
       (if (== (tc:tag $s) Step)
         (tc:whnf (- $n 1) $rules $fault (tc:got-step $s))
         (Ok $t)))
     NoFuel))

; ---------- shapes ----------

(= (tc:is-fun $t)
   (let $h (tc:h $t)
     (if (== $h Lam) Yes
       (if (== $h idx) Yes
         (if (== $h App) Yes
           (if (== $h Fst) Yes
             (if (== $h Snd) Yes
               (if (== $h DeclConst) Yes No))))))))

(= (tc:is-pair $t)
   (let $h (tc:h $t)
     (if (== $h Pair) Yes
       (if (== $h idx) Yes
         (if (== $h App) Yes
           (if (== $h Fst) Yes
             (if (== $h Snd) Yes
               (if (== $h DeclConst) Yes No))))))))

; ---------- synthesis of a principal sort or a binder ----------

(= (tc:synth $n $rules $fault $ctx $decls $t)
   (let $h (tc:h $t)
     (if (== $h idx) (tc:lookup $fault $ctx (tc:a0 $t))
       (if (== $h DeclConst) (tc:decl-get (tc:a0 $t) $decls)
         (if (== $h Sort) (tc:synth-sort $t)
           (if (== $h App) (tc:synth-app $n $rules $fault $ctx $decls $t)
             (if (== $h Fst) (tc:synth-fst $n $rules $fault $ctx $decls $t)
               (if (== $h Snd) (tc:synth-snd $n $rules $fault $ctx $decls $t)
                 (if (== $h Pi) (tc:synth-binder $n $rules $fault $ctx $decls $t)
                   (if (== $h Sigma) (tc:synth-binder $n $rules $fault $ctx $decls $t)
                     Miss))))))))))

(= (tc:synth-binder $n $rules $fault $ctx $decls $t)
   (let $sd (tc:synth $n $rules $fault $ctx $decls (tc:a0 $t))
     (tc:synth-binder-d $n $rules $fault $ctx $decls $t $sd)))
(= (tc:synth-binder-d $n $rules $fault $ctx $decls $t (Got $d))
   (let $sc (tc:synth $n $rules $fault (Cons (tc:a0 $t) $ctx) $decls (tc:a1 $t))
     (tc:synth-binder-c $d $sc)))
(= (tc:synth-binder-d $n $rules $fault $ctx $decls $t Miss) Miss)
(= (tc:synth-binder-c $d (Got $c))
   (tc:synth-binder-lv (tc:as-level $d) (tc:as-level $c)))
(= (tc:synth-binder-c $d Miss) Miss)
(= (tc:synth-binder-lv (Lvl $i) (Lvl $j))
   (Got (Sort (LevelConst (tc:lvl-n (tc:norm-max (Lvl $i) (Lvl $j)))))))
(= (tc:synth-binder-lv Open $j) Miss)
(= (tc:synth-binder-lv (Lvl $i) Open) Miss)

(= (tc:synth-sort $t)
   (let $lv (tc:level-of (tc:a0 $t))
     (if (== (tc:tag $lv) Lvl)
       (Got (Sort (LevelConst (+ (tc:lvl-n $lv) 1))))
       Miss)))

(= (tc:synth-app $n $rules $fault $ctx $decls $t)
   (let $sf (tc:synth $n $rules $fault $ctx $decls (tc:a0 $t))
     (tc:synth-app-sf $n $fault $rules $ctx $decls $t $sf)))
(= (tc:synth-app-sf $n $fault $rules $ctx $decls $t (Got $fty))
   (let $wn (tc:whnf $n $rules $fault $fty)
     (tc:synth-app-wn $n $fault $rules $ctx $decls $t $wn)))
(= (tc:synth-app-sf $n $fault $rules $ctx $decls $t (Refuted $thm)) (Refuted $thm))
(= (tc:synth-app-sf $n $fault $rules $ctx $decls $t Miss) Miss)
(= (tc:synth-app-wn $n $fault $rules $ctx $decls $t (Ok $pi))
   (let $is (== (tc:h $pi) Pi)
     (tc:synth-app-pi $n $fault $rules $ctx $decls $t $pi $is)))
(= (tc:synth-app-wn $n $fault $rules $ctx $decls $t NoFuel) Miss)
(= (tc:synth-app-pi $n $fault $rules $ctx $decls $t $pi True)
   (let $ck (tc:check $n $fault $rules $ctx $decls (tc:a1 $t) (tc:a0 $pi) Miss Open)
     (tc:synth-app-ck $fault $t $pi $ck)))
(= (tc:synth-app-pi $n $fault $rules $ctx $decls $t $pi False) Miss)
(= (tc:synth-app-ck $fault $t $pi Accepted)
   (Got (tc:inst0 $fault (tc:a1 $t) (tc:a1 $pi))))
(= (tc:synth-app-ck $fault $t $pi Unresolved) Miss)
(= (tc:synth-app-ck $fault $t $pi Refuted) (Refuted Synth.not_typed))
(= (tc:synth-app-ck $fault $t $pi (Refuted $thm)) (Refuted $thm))

(= (tc:synth-fst $n $rules $fault $ctx $decls $t)
   (let $sp (tc:synth $n $rules $fault $ctx $decls (tc:a0 $t))
     (if (== (tc:tag $sp) Got)
       (let $wn (tc:whnf $n $rules $fault (tc:got-tm $sp))
         (if (== (tc:tag $wn) Ok)
           (if (== (tc:h (tc:ok-tm $wn)) Sigma)
             (Got (tc:a0 (tc:ok-tm $wn)))
             Miss)
           Miss))
       Miss)))

(= (tc:synth-snd $n $rules $fault $ctx $decls $t)
   (let $sp (tc:synth $n $rules $fault $ctx $decls (tc:a0 $t))
     (if (== (tc:tag $sp) Got)
       (let $wn (tc:whnf $n $rules $fault (tc:got-tm $sp))
         (if (== (tc:tag $wn) Ok)
           (if (== (tc:h (tc:ok-tm $wn)) Sigma)
             (Got (tc:inst0 $fault (Fst (tc:a0 $t)) (tc:a1 (tc:ok-tm $wn))))
             Miss)
           Miss))
       Miss)))

(= (tc:cumul-ok $fault $m $L)
   (if (< $L $m) No
     (if (== $fault no-cumulativity)
       (if (== $m $L) Yes No)
       Yes)))

(= (tc:as-level $t)
   (if (== (tc:h $t) Sort) (tc:level-of (tc:a0 $t)) Open))

(= (tc:gate $n $fault $rules $ctx $decls $l $r $ty)
   (if (== (tc:h $ty) Sort)
     (let $sl (tc:synth $n $rules $fault $ctx $decls $l)
       (let $sr (tc:synth $n $rules $fault $ctx $decls $r)
         (let $lv (tc:level-of (tc:a0 $ty))
           (if (== (tc:tag $lv) Lvl)
             (tc:gate-sides $fault $sl $sr (tc:lvl-n $lv))
             Go))))
     Go))

(= (tc:gate-sides $fault $sl $sr $L)
   (if (== (tc:tag $sl) Got)
     (if (== (tc:tag $sr) Got)
       (tc:gate-levels $fault (tc:as-level (tc:got-tm $sl)) (tc:as-level (tc:got-tm $sr)) $L)
       Go)
     Go))

(= (tc:gate-levels $fault $ml $mr $L)
   (if (== (tc:tag $ml) Lvl)
     (if (== (tc:tag $mr) Lvl)
       (if (== (tc:cumul-ok $fault (tc:lvl-n $ml) $L) No) Refuted
         (if (== (tc:cumul-ok $fault (tc:lvl-n $mr) $L) No) Refuted Go))
       Go)
     Go))

; ---------- comparison ----------

(= (tc:compare $n $fault $rules $ctx $decls $l $r $ty)
   (if (< 0 $n)
     (tc:compare-go (- $n 1) $fault $rules $ctx $decls $l $r $ty)
     Unresolved))

(= (tc:peel $t) (tc:peel-h (tc:h $t) $t))
(= (tc:peel-h App $t) (tc:peel-fun (tc:h (tc:a0 $t)) $t))
(= (tc:peel-h Lam $t) $t)
(= (tc:peel-h Pi $t) $t)
(= (tc:peel-h Sigma $t) $t)
(= (tc:peel-h Id $t) $t)
(= (tc:peel-h Sort $t) $t)
(= (tc:peel-h idx $t) $t)
(= (tc:peel-h DeclConst $t) $t)
(= (tc:peel-h Pair $t) $t)
(= (tc:peel-h Fst $t) $t)
(= (tc:peel-h Snd $t) $t)
(= (tc:peel-h Refl $t) $t)
(= (tc:peel-fun Lam $t)
   (tc:peel-lam (tc:lam-body (tc:a0 $t)) (tc:a1 $t) $t))
(= (tc:peel-fun App $t) $t)
(= (tc:peel-fun DeclConst $t) $t)
(= (tc:peel-fun idx $t) $t)
(= (tc:peel-fun Fst $t) $t)
(= (tc:peel-fun Snd $t) $t)
(= (tc:peel-fun Pair $t) $t)
(= (tc:peel-fun Refl $t) $t)
(= (tc:peel-fun Pi $t) $t)
(= (tc:peel-fun Sigma $t) $t)
(= (tc:peel-fun Sort $t) $t)
(= (tc:peel-fun Id $t) $t)
(= (tc:peel-lam (idx $k) $a $t) (tc:peel-k $k $a $t (== $k 0)))
(= (tc:peel-k $k $a $t True) $a)
(= (tc:peel-k $k $a $t False) $t)
(= (tc:peel-lam (Lam $d $b) $a $t) $t)
(= (tc:peel-lam (Lam $b) $a $t) $t)
(= (tc:peel-lam (App $f $x) $a $t) $t)
(= (tc:peel-lam (DeclConst $n) $a $t) $t)
(= (tc:peel-lam (Pi $d $b) $a $t) $t)
(= (tc:peel-lam (Sigma $d $b) $a $t) $t)
(= (tc:peel-lam (Pair $x $y) $a $t) $t)
(= (tc:peel-lam (Fst $p) $a $t) $t)
(= (tc:peel-lam (Snd $p) $a $t) $t)
(= (tc:peel-lam (Refl $x) $a $t) $t)
(= (tc:peel-lam (Id $x $y $z) $a $t) $t)
(= (tc:peel-lam (Sort $l) $a $t) $t)

(= (tc:shrink $fault $t)
   (let $h (tc:h $t)
     (tc:shrink-h $fault $h $t)))
(= (tc:shrink-h $fault App $t)
   (let $x (tc:a0 $t)
     (let $y (tc:a1 $t)
       (tc:shrink-app-kids $fault $x $y))))
(= (tc:shrink-app-kids $fault $x $y)
   (let $f (tc:shrink $fault $x)
     (let $a (tc:shrink $fault $y)
       (tc:shrink-app2 $fault $f $a))))
(= (tc:shrink-app2 $fault $f $a) (tc:shrink-app $fault $f $a))
(= (tc:shrink-h $fault Lam $t)
   (let $n (tc:nargs $t)
     (tc:shrink-lam $fault $n $t)))
(= (tc:shrink-lam $fault 1 $t)
   (let $b (tc:a0 $t)
     (tc:shrink-lam1 $fault $b)))
(= (tc:shrink-lam1 $fault $b)
   (let $b2 (tc:shrink $fault $b)
     (tc:mk-lam1 $b2)))
(= (tc:mk-lam1 $b) (Lam $b))
(= (tc:shrink-lam $fault 2 $t)
   (let $d (tc:a0 $t)
     (let $b (tc:a1 $t)
       (tc:shrink-lam2 $fault $d $b))))
(= (tc:shrink-lam2 $fault $d $b)
   (let $d2 (tc:shrink $fault $d)
     (let $b2 (tc:shrink $fault $b)
       (tc:mk-lam $d2 $b2))))
(= (tc:mk-lam $d $b) (Lam $d $b))
(= (tc:shrink-h $fault Pi $t)
   (let $d (tc:a0 $t)
     (let $b (tc:a1 $t)
       (tc:shrink-pi2 $fault $d $b))))
(= (tc:shrink-pi2 $fault $d $b)
   (let $d2 (tc:shrink $fault $d)
     (let $b2 (tc:shrink $fault $b)
       (tc:mk-pi $d2 $b2))))
(= (tc:mk-pi $d $b) (Pi $d $b))
(= (tc:shrink-h $fault Sigma $t)
   (let $d (tc:a0 $t)
     (let $b (tc:a1 $t)
       (tc:shrink-sigma2 $fault $d $b))))
(= (tc:shrink-sigma2 $fault $d $b)
   (let $d2 (tc:shrink $fault $d)
     (let $b2 (tc:shrink $fault $b)
       (tc:mk-sigma $d2 $b2))))
(= (tc:mk-sigma $d $b) (Sigma $d $b))
(= (tc:shrink-h $fault Pair $t)
   (let $x (tc:a0 $t)
     (let $y (tc:a1 $t)
       (tc:shrink-pair2 $fault $x $y))))
(= (tc:shrink-pair2 $fault $x $y)
   (let $x2 (tc:shrink $fault $x)
     (let $y2 (tc:shrink $fault $y)
       (tc:mk-pair $x2 $y2))))
(= (tc:mk-pair $x $y) (Pair $x $y))
(= (tc:shrink-h $fault Id $t)
   (let $a (tc:a0 $t)
     (let $b (tc:a1 $t)
       (let $c (tc:a2 $t)
         (tc:shrink-id3 $fault $a $b $c)))))
(= (tc:shrink-id3 $fault $a $b $c)
   (let $a2 (tc:shrink $fault $a)
     (let $b2 (tc:shrink $fault $b)
       (let $c2 (tc:shrink $fault $c)
         (tc:mk-id $a2 $b2 $c2)))))
(= (tc:mk-id $a $b $c) (Id $a $b $c))
(= (tc:shrink-h $fault Fst $t)
   (let $a (tc:a0 $t)
     (tc:shrink-fst $fault $a)))
(= (tc:shrink-fst $fault $a)
   (let $a2 (tc:shrink $fault $a)
     (tc:mk1 Fst $a2)))
(= (tc:shrink-h $fault Snd $t)
   (let $a (tc:a0 $t)
     (tc:shrink-snd $fault $a)))
(= (tc:shrink-snd $fault $a)
   (let $a2 (tc:shrink $fault $a)
     (tc:mk1 Snd $a2)))
(= (tc:shrink-h $fault Refl $t)
   (let $a (tc:a0 $t)
     (tc:shrink-refl $fault $a)))
(= (tc:shrink-refl $fault $a)
   (let $a2 (tc:shrink $fault $a)
     (tc:mk1 Refl $a2)))
(= (tc:shrink-h $fault Sort $t) $t)
(= (tc:shrink-h $fault idx $t) $t)
(= (tc:shrink-h $fault DeclConst $t) $t)
(= (tc:shrink-app $fault $f $a) (tc:shrink-app-h $fault (tc:h $f) $f $a))
(= (tc:shrink-app-h $fault Lam $f $a) (tc:contract $fault (tc:lam-body $f) $a $f))
(= (tc:shrink-app-h $fault App $f $a) (App $f $a))
(= (tc:shrink-app-h $fault DeclConst $f $a) (App $f $a))
(= (tc:shrink-app-h $fault idx $f $a) (App $f $a))
(= (tc:shrink-app-h $fault Fst $f $a) (App $f $a))
(= (tc:shrink-app-h $fault Snd $f $a) (App $f $a))
(= (tc:shrink-app-h $fault Pair $f $a) (App $f $a))
(= (tc:shrink-app-h $fault Refl $f $a) (App $f $a))
(= (tc:shrink-app-h $fault Pi $f $a) (App $f $a))
(= (tc:shrink-app-h $fault Sigma $f $a) (App $f $a))
(= (tc:shrink-app-h $fault Sort $f $a) (App $f $a))
(= (tc:shrink-app-h $fault Id $f $a) (App $f $a))
(= (tc:contract $fault (idx $k) $a $f) (tc:contract-idx $fault $k $a $f (== $k 0)))
(= (tc:contract-idx $fault $k $a $f True) $a)
(= (tc:contract-idx $fault $k $a $f False) (tc:contract-small $fault (tc:h $a) (idx $k) $a $f))
(= (tc:contract $fault (App $x $y) $a $f) (tc:contract-small $fault (tc:h $a) (App $x $y) $a $f))
(= (tc:contract $fault (Lam $d $b) $a $f) (tc:contract-small $fault (tc:h $a) (Lam $d $b) $a $f))
(= (tc:contract $fault (Lam $b) $a $f) (tc:contract-small $fault (tc:h $a) (Lam $b) $a $f))
(= (tc:contract $fault (DeclConst $n) $a $f) (tc:contract-small $fault (tc:h $a) (DeclConst $n) $a $f))
(= (tc:contract $fault (Pi $d $b) $a $f) (tc:contract-small $fault (tc:h $a) (Pi $d $b) $a $f))
(= (tc:contract $fault (Sigma $d $b) $a $f) (tc:contract-small $fault (tc:h $a) (Sigma $d $b) $a $f))
(= (tc:contract $fault (Pair $x $y) $a $f) (tc:contract-small $fault (tc:h $a) (Pair $x $y) $a $f))
(= (tc:contract $fault (Fst $p) $a $f) (tc:contract-small $fault (tc:h $a) (Fst $p) $a $f))
(= (tc:contract $fault (Snd $p) $a $f) (tc:contract-small $fault (tc:h $a) (Snd $p) $a $f))
(= (tc:contract $fault (Refl $x) $a $f) (tc:contract-small $fault (tc:h $a) (Refl $x) $a $f))
(= (tc:contract $fault (Id $x $y $z) $a $f) (tc:contract-small $fault (tc:h $a) (Id $x $y $z) $a $f))
(= (tc:contract $fault (Sort $l) $a $f) (tc:contract-small $fault (tc:h $a) (Sort $l) $a $f))
(= (tc:contract-small $fault idx $b $a $f) (tc:inst0 $fault $a $b))
(= (tc:contract-small $fault DeclConst $b $a $f) (tc:inst0 $fault $a $b))
(= (tc:contract-small $fault Sort $b $a $f) (tc:inst0 $fault $a $b))
(= (tc:contract-small $fault Refl $b $a $f) (tc:inst0 $fault $a $b))
(= (tc:contract-small $fault App $b $a $f) (App $f $a))
(= (tc:contract-small $fault Lam $b $a $f) (App $f $a))
(= (tc:contract-small $fault Pi $b $a $f) (App $f $a))
(= (tc:contract-small $fault Sigma $b $a $f) (App $f $a))
(= (tc:contract-small $fault Pair $b $a $f) (App $f $a))
(= (tc:contract-small $fault Fst $b $a $f) (App $f $a))
(= (tc:contract-small $fault Snd $b $a $f) (App $f $a))
(= (tc:contract-small $fault Id $b $a $f) (App $f $a))

; A declared-constant spine is reduced on the original term. Shrink rebuilds
; an application from copies that no longer match an admitted rule.
(= (tc:wants-step $t)
   (let $h (tc:h $t)
     (let $app (== $h App)
       (let $dc (== $h DeclConst)
         (let $fst (== $h Fst)
           (let $snd (== $h Snd)
             (tc:wants-step-app $t $app $dc $fst $snd)))))))
(= (tc:wants-step-app $t True $dc $fst $snd) (tc:wants-step (tc:a0 $t)))
(= (tc:wants-step-app $t False True $fst $snd) Yes)
(= (tc:wants-step-app $t False False True $snd) Yes)
(= (tc:wants-step-app $t False False False True) Yes)
(= (tc:wants-step-app $t False False False False) No)

(= (tc:compare-go $n $fault $rules $ctx $decls $l $r $ty)
   (tc:compare-route $n $fault $rules $ctx $decls $l $r $ty (== $fault no-cumulativity)))
(= (tc:compare-route $n $fault $rules $ctx $decls $l $r $ty True)
   (tc:compare-whnf $n $fault $rules $ctx $decls $l $r $ty))
(= (tc:compare-route $n $fault $rules $ctx $decls $l $r $ty False)
   (let $wl (tc:wants-step $l)
     (let $wr (tc:wants-step $r)
       (tc:compare-pre $n $fault $rules $ctx $decls $l $r $ty $wl $wr))))
(= (tc:compare-pre $n $fault $rules $ctx $decls $l $r $ty No No)
   (tc:compare-shrink 4 $n $fault $rules $ctx $decls $l $r $ty))
(= (tc:compare-pre $n $fault $rules $ctx $decls $l $r $ty Yes $wr)
   (tc:compare-pre-step $n $fault $rules $ctx $decls $l $r $ty))
(= (tc:compare-pre $n $fault $rules $ctx $decls $l $r $ty No Yes)
   (tc:compare-pre-step $n $fault $rules $ctx $decls $l $r $ty))
(= (tc:compare-pre-step $n $fault $rules $ctx $decls $l $r $ty)
   (let $sl (tc:step $rules $fault $l)
     (let $sr (tc:step $rules $fault $r)
       (let $lt (== (tc:tag $sl) Step)
         (let $rt (== (tc:tag $sr) Step)
           (tc:after-step $n $fault $rules $ctx $decls $l $r $ty $sl $sr $lt $rt))))))
(= (tc:after-step $n $fault $rules $ctx $decls $l $r $ty $sl $sr True True)
   (let $l2 (tc:got-step $sl)
     (let $r2 (tc:got-step $sr)
       (tc:compare $n $fault $rules $ctx $decls $l2 $r2 $ty))))
(= (tc:after-step $n $fault $rules $ctx $decls $l $r $ty $sl $sr True False)
   (let $l2 (tc:got-step $sl)
     (tc:compare $n $fault $rules $ctx $decls $l2 $r $ty)))
(= (tc:after-step $n $fault $rules $ctx $decls $l $r $ty $sl $sr False True)
   (let $r2 (tc:got-step $sr)
     (tc:compare $n $fault $rules $ctx $decls $l $r2 $ty)))
(= (tc:after-step $n $fault $rules $ctx $decls $l $r $ty $sl $sr False False)
   (tc:compare-shrink 4 $n $fault $rules $ctx $decls $l $r $ty))
(= (tc:compare-shrink 0 $n $fault $rules $ctx $decls $l $r $ty)
   (tc:compare-whnf $n $fault $rules $ctx $decls $l $r $ty))
(= (tc:compare-shrink 1 $n $fault $rules $ctx $decls $l $r $ty)
   (let $l1 (tc:shrink $fault $l)
     (let $r1 (tc:shrink $fault $r)
       (tc:compare-shrink-do 1 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1))))
(= (tc:compare-shrink 2 $n $fault $rules $ctx $decls $l $r $ty)
   (let $l1 (tc:shrink $fault $l)
     (let $r1 (tc:shrink $fault $r)
       (tc:compare-shrink-do 2 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1))))
(= (tc:compare-shrink 3 $n $fault $rules $ctx $decls $l $r $ty)
   (let $l1 (tc:shrink $fault $l)
     (let $r1 (tc:shrink $fault $r)
       (tc:compare-shrink-do 3 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1))))
(= (tc:compare-shrink 4 $n $fault $rules $ctx $decls $l $r $ty)
   (let $l1 (tc:shrink $fault $l)
     (let $r1 (tc:shrink $fault $r)
       (tc:compare-shrink-do 4 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1))))
(= (tc:compare-shrink-do $k $n $fault $rules $ctx $decls $l $r $ty $l1 $r1)
   (tc:compare-shrink-eq $k $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 (== $l1 $r1)))
(= (tc:compare-shrink-eq $k $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 True) Accepted)
(= (tc:compare-shrink-eq $k $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 False)
   (tc:compare-shrink-next $k $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 (== $l1 $l) (== $r1 $r)))
(= (tc:compare-shrink-next $k $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 True True)
   (tc:compare-whnf $n $fault $rules $ctx $decls $l $r $ty))
(= (tc:compare-shrink-next 1 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 True False)
   (tc:compare-shrink 0 $n $fault $rules $ctx $decls $l1 $r1 $ty))
(= (tc:compare-shrink-next 2 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 True False)
   (tc:compare-shrink 1 $n $fault $rules $ctx $decls $l1 $r1 $ty))
(= (tc:compare-shrink-next 3 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 True False)
   (tc:compare-shrink 2 $n $fault $rules $ctx $decls $l1 $r1 $ty))
(= (tc:compare-shrink-next 4 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 True False)
   (tc:compare-shrink 3 $n $fault $rules $ctx $decls $l1 $r1 $ty))
(= (tc:compare-shrink-next 1 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 False True)
   (tc:compare-shrink 0 $n $fault $rules $ctx $decls $l1 $r1 $ty))
(= (tc:compare-shrink-next 2 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 False True)
   (tc:compare-shrink 1 $n $fault $rules $ctx $decls $l1 $r1 $ty))
(= (tc:compare-shrink-next 3 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 False True)
   (tc:compare-shrink 2 $n $fault $rules $ctx $decls $l1 $r1 $ty))
(= (tc:compare-shrink-next 4 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 False True)
   (tc:compare-shrink 3 $n $fault $rules $ctx $decls $l1 $r1 $ty))
(= (tc:compare-shrink-next 1 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 False False)
   (tc:compare-shrink 0 $n $fault $rules $ctx $decls $l1 $r1 $ty))
(= (tc:compare-shrink-next 2 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 False False)
   (tc:compare-shrink 1 $n $fault $rules $ctx $decls $l1 $r1 $ty))
(= (tc:compare-shrink-next 3 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 False False)
   (tc:compare-shrink 2 $n $fault $rules $ctx $decls $l1 $r1 $ty))
(= (tc:compare-shrink-next 4 $n $fault $rules $ctx $decls $l $r $ty $l1 $r1 False False)
   (tc:compare-shrink 3 $n $fault $rules $ctx $decls $l1 $r1 $ty))

(= (tc:compare-whnf $n $fault $rules $ctx $decls $l $r $ty)
   (let $tyn (tc:whnf $n $rules $fault $ty)
     (let $ln (tc:whnf $n $rules $fault $l)
       (let $rn (tc:whnf $n $rules $fault $r)
         (if (== (tc:tag $tyn) Ok)
           (if (== (tc:tag $ln) Ok)
             (if (== (tc:tag $rn) Ok)
               (tc:after $n $fault $rules $ctx $decls
                 (tc:ok-tm $tyn) (tc:ok-tm $ln) (tc:ok-tm $rn))
               Unresolved)
             Unresolved)
           Unresolved)))))

(= (tc:after $n $fault $rules $ctx $decls $ty $l $r)
   (let $g (tc:gate $n $fault $rules $ctx $decls $l $r $ty)
     (if (== $g Refuted) Refuted
       (if (== $l $r) Accepted
         (tc:dispatch $n $fault $rules $ctx $decls $ty $l $r)))))

(= (tc:dispatch $n $fault $rules $ctx $decls $ty $l $r)
   (let $h (tc:h $ty)
     (if (== $h Pi) (tc:at-pi $n $fault $rules $ctx $decls $ty $l $r)
       (if (== $h Sigma) (tc:at-sigma $n $fault $rules $ctx $decls $ty $l $r)
         (if (== $h Id) (tc:at-id $n $fault $rules $ctx $decls $ty $l $r)
           (if (== $h Sort) (tc:as-types $n $fault $rules $ctx $decls $l $r)
             (if (== $h Lam) Unresolved
               (if (== $h Pair) Unresolved
                 (tc:spines $n $fault $rules $ctx $decls $l $r)))))))))

(= (tc:at-pi $n $fault $rules $ctx $decls $ty $l $r)
   (if (== $fault drop-pi-eta)
     (tc:spines $n $fault $rules $ctx $decls $l $r)
     (if (== (tc:is-fun $l) Yes)
       (if (== (tc:is-fun $r) Yes)
         (tc:compare $n $fault $rules
           (Cons (tc:a0 $ty) $ctx) $decls
           (App (tc:wk $fault $l) (idx 0))
           (App (tc:wk $fault $r) (idx 0))
           (tc:a1 $ty))
         (tc:spines $n $fault $rules $ctx $decls $l $r))
       (tc:spines $n $fault $rules $ctx $decls $l $r))))

(= (tc:at-sigma $n $fault $rules $ctx $decls $ty $l $r)
   (if (== $fault drop-sigma-eta)
     (tc:spines $n $fault $rules $ctx $decls $l $r)
     (if (== (tc:is-pair $l) Yes)
       (if (== (tc:is-pair $r) Yes)
         (tc:both
           (tc:compare $n $fault $rules $ctx $decls
             (Fst $l) (Fst $r) (tc:a0 $ty))
           (tc:compare $n $fault $rules $ctx $decls
             (Snd $l) (Snd $r)
             (tc:inst0 $fault (Fst $l) (tc:a1 $ty))))
         (tc:spines $n $fault $rules $ctx $decls $l $r))
       (tc:spines $n $fault $rules $ctx $decls $l $r))))

(= (tc:at-id $n $fault $rules $ctx $decls $ty $l $r)
   (if (== (tc:h $l) Refl)
     (if (== (tc:h $r) Refl)
       (tc:compare $n $fault $rules $ctx $decls
         (tc:a0 $l) (tc:a0 $r) (tc:a0 $ty))
       (tc:spines $n $fault $rules $ctx $decls $l $r))
     (tc:spines $n $fault $rules $ctx $decls $l $r)))

(= (tc:as-types $n $fault $rules $ctx $decls $l $r)
   (let $hl (tc:h $l)
     (let $hr (tc:h $r)
       (if (== $hl $hr)
         (if (== $hl Sort) (tc:sorts $l $r)
           (if (== $hl Pi)
             (tc:both
               (tc:as-types $n $fault $rules $ctx $decls (tc:a0 $l) (tc:a0 $r))
               (tc:as-types $n $fault $rules (Cons (tc:a0 $l) $ctx) $decls (tc:a1 $l) (tc:a1 $r)))
             (if (== $hl Sigma)
               (tc:both
                 (tc:as-types $n $fault $rules $ctx $decls (tc:a0 $l) (tc:a0 $r))
                 (tc:as-types $n $fault $rules (Cons (tc:a0 $l) $ctx) $decls (tc:a1 $l) (tc:a1 $r)))
               (if (== $hl Id)
                 (tc:both
                   (tc:as-types $n $fault $rules $ctx $decls (tc:a0 $l) (tc:a0 $r))
                   (tc:both
                     (tc:compare $n $fault $rules $ctx $decls (tc:a1 $l) (tc:a1 $r) (tc:a0 $l))
                     (tc:compare $n $fault $rules $ctx $decls (tc:a2 $l) (tc:a2 $r) (tc:a0 $l))))
                 (if (== $hl idx) (tc:spines $n $fault $rules $ctx $decls $l $r)
                   (if (== $hl DeclConst) (tc:spines $n $fault $rules $ctx $decls $l $r)
                     (if (== $hl App) (tc:spines $n $fault $rules $ctx $decls $l $r)
                       (if (== $hl Fst) (tc:spines $n $fault $rules $ctx $decls $l $r)
                         (if (== $hl Snd) (tc:spines $n $fault $rules $ctx $decls $l $r)
                           Unresolved)))))))))
         (if (== $hl Sort) Refuted
           (if (== $hr Sort) Refuted
             (if (== $hl Pi) Refuted
               (if (== $hr Pi) Refuted
                 (if (== $hl Sigma) Refuted
                   (if (== $hr Sigma) Refuted
                     (if (== $hl Id) Refuted
                       (if (== $hr Id) Refuted
                         (tc:spines $n $fault $rules $ctx $decls $l $r)))))))))))))

(= (tc:sorts $l $r)
   (let $nl (tc:level-of (tc:a0 $l))
     (let $nr (tc:level-of (tc:a0 $r))
       (if (== (tc:tag $nl) Lvl)
         (if (== (tc:tag $nr) Lvl)
           (if (== (tc:lvl-n $nl) (tc:lvl-n $nr)) Accepted Refuted)
           Unresolved)
         (if (== $l $r) Accepted Unresolved)))))

(= (tc:spines $n $fault $rules $ctx $decls $l $r)
   (if (< 0 $n)
     (if (== $l $r) Accepted
       (tc:spines-go (- $n 1) $fault $rules $ctx $decls $l $r))
     Unresolved))

(= (tc:spines-go $n $fault $rules $ctx $decls $l $r)
   (let $hl (tc:h $l)
     (let $hr (tc:h $r)
       (if (== $hl $hr)
         (if (== $hl idx)
           (if (== (tc:a0 $l) (tc:a0 $r)) Accepted Refuted)
           (if (== $hl DeclConst)
             (if (== (tc:a0 $l) (tc:a0 $r)) Accepted Refuted)
             (if (== $hl App) (tc:spines-app $n $fault $rules $ctx $decls $l $r)
               (if (== $hl Fst) (tc:spines-fst $n $fault $rules $ctx $decls $l $r)
                 (if (== $hl Snd) (tc:spines-snd $n $fault $rules $ctx $decls $l $r)
                   Refuted)))))
         Refuted))))

(= (tc:spines-app $n $fault $rules $ctx $decls $l $r)
   (let $fun (tc:spines $n $fault $rules $ctx $decls (tc:a0 $l) (tc:a0 $r))
     (if (== $fun Accepted)
       (let $sf (tc:synth $n $rules $fault $ctx $decls (tc:a0 $l))
         (if (== (tc:tag $sf) Got)
           (let $wn (tc:whnf $n $rules $fault (tc:got-tm $sf))
             (if (== (tc:tag $wn) Ok)
               (if (== (tc:h (tc:ok-tm $wn)) Pi)
                 (tc:compare $n $fault $rules $ctx $decls
                   (tc:a1 $l) (tc:a1 $r) (tc:a0 (tc:ok-tm $wn)))
                 Unresolved)
               Unresolved))
           Unresolved))
       $fun)))

(= (tc:spines-fst $n $fault $rules $ctx $decls $l $r)
   (tc:spines $n $fault $rules $ctx $decls (tc:a0 $l) (tc:a0 $r)))

(= (tc:spines-snd $n $fault $rules $ctx $decls $l $r)
   (let $fun (tc:spines $n $fault $rules $ctx $decls (tc:a0 $l) (tc:a0 $r))
     (if (== $fun Accepted)
       (let $sf (tc:synth $n $rules $fault $ctx $decls (tc:a0 $l))
         (if (== (tc:tag $sf) Got)
           (let $wn (tc:whnf $n $rules $fault (tc:got-tm $sf))
             (if (== (tc:tag $wn) Ok)
               (if (== (tc:h (tc:ok-tm $wn)) Sigma) Accepted Unresolved)
               Unresolved))
           Unresolved))
       $fun)))

; ---------- checking ----------
; Refl is checked at an Id by checking the payload at the carrier and
; comparing both endpoints with that payload. Every other term requires its
; synthesized type to lie below the expected type. Equality of the two types
; is sufficient, and a smaller universe lies below a larger one.

(= (tc:check $n $fault $rules $ctx $decls $term $expected $synth $at)
   (if (< 0 $n)
     (tc:check-go (- $n 1) $fault $rules $ctx $decls $term $expected $synth $at)
     Unresolved))

(= (tc:check-go $n $fault $rules $ctx $decls $term $expected $synth $at)
   (let $h (tc:h $term)
     (let $refl (== $h Refl)
       (tc:check-head $n $fault $rules $ctx $decls $term $expected $synth $at $refl))))

(= (tc:check-head $n $fault $rules $ctx $decls $term $expected $synth $at True)
   (tc:check-refl $n $fault $rules $ctx $decls $term $expected))
(= (tc:check-head $n $fault $rules $ctx $decls $term $expected $synth $at False)
   (let $h (tc:h $term)
     (let $lam (== $h Lam)
       (let $pair (== $h Pair)
         (tc:check-intro $n $fault $rules $ctx $decls $term $expected $synth $at $lam $pair)))))

(= (tc:check-intro $n $fault $rules $ctx $decls $term $expected $synth $at True $pair)
   (tc:check-lam $n $fault $rules $ctx $decls $term $expected))
(= (tc:check-intro $n $fault $rules $ctx $decls $term $expected $synth $at False True)
   (tc:check-pair $n $fault $rules $ctx $decls $term $expected))
(= (tc:check-intro $n $fault $rules $ctx $decls $term $expected $synth $at False False)
   (let $app (== (tc:h $term) App)
     (tc:check-maybe-app $n $fault $rules $ctx $decls $term $expected $synth $at $app)))
(= (tc:check-maybe-app $n $fault $rules $ctx $decls $term $expected $synth $at True)
   (tc:check-app $n $fault $rules $ctx $decls $term $expected $synth $at))
(= (tc:check-maybe-app $n $fault $rules $ctx $decls $term $expected $synth $at False)
   (tc:check-cumul $n $fault $rules $ctx $decls $term $expected $synth $at))

(= (tc:check-app $n $fault $rules $ctx $decls $term $expected $synth $at)
   (let $sf (tc:synth $n $fault $rules $ctx $decls (tc:a0 $term))
     (tc:check-app-fn $n $fault $rules $ctx $decls $term $expected $synth $at $sf)))
(= (tc:check-app-fn $n $fault $rules $ctx $decls $term $expected $synth $at (Got $fty))
   (let $wn (tc:whnf $n $rules $fault $fty)
     (tc:check-app-pi $n $fault $rules $ctx $decls $term $expected $synth $at $wn)))
(= (tc:check-app-fn $n $fault $rules $ctx $decls $term $expected $synth $at Miss)
   (let $fun (tc:a0 $term)
     (let $lam (== (tc:h $fun) Lam)
       (tc:check-app-lam $n $fault $rules $ctx $decls $term $expected $fun $lam))))
(= (tc:check-app-lam $n $fault $rules $ctx $decls $term $expected $fun True)
   (let $ann (== (tc:nargs $fun) 2)
     (tc:check-app-lam-ann $n $fault $rules $ctx $decls $term $expected $fun $ann)))
(= (tc:check-app-lam $n $fault $rules $ctx $decls $term $expected $fun False)
   (tc:check-cumul $n $fault $rules $ctx $decls $term $expected Miss Open))
(= (tc:check-app-lam-ann $n $fault $rules $ctx $decls $term $expected $fun True)
   (let $ck (tc:check $n $fault $rules $ctx $decls (tc:a1 $term) (tc:a0 $fun) Miss Open)
     (tc:check-app-lam-ck $n $fault $rules $ctx $decls $term $expected $fun $ck)))
(= (tc:check-app-lam-ann $n $fault $rules $ctx $decls $term $expected $fun False)
   (tc:check-cumul $n $fault $rules $ctx $decls $term $expected Miss Open))
(= (tc:check-app-lam-ck $n $fault $rules $ctx $decls $term $expected $fun Accepted)
   (let $body (tc:lam-body $fun)
     (tc:check-app-lam-body $n $fault $rules $ctx $decls (tc:a1 $term) $expected $body
       (== (tc:h $body) idx))))
(= (tc:check-app-lam-ck $n $fault $rules $ctx $decls $term $expected $fun Refuted)
   (Refuted Synth.not_typed))
(= (tc:check-app-lam-ck $n $fault $rules $ctx $decls $term $expected $fun Unresolved)
   Unresolved)
(= (tc:check-app-lam-ck $n $fault $rules $ctx $decls $term $expected $fun (Refuted $thm))
   (Refuted $thm))
(= (tc:check-app-lam-body $n $fault $rules $ctx $decls $arg $expected $body True)
   (tc:check-app-lam-idx $n $fault $rules $ctx $decls $arg $expected $body (== (tc:a0 $body) 0)))
(= (tc:check-app-lam-body $n $fault $rules $ctx $decls $arg $expected $body False)
   (tc:check $n $fault $rules $ctx $decls (tc:inst0 $fault $arg $body) $expected Miss Open))
(= (tc:check-app-lam-idx $n $fault $rules $ctx $decls $arg $expected $body True)
   (tc:check $n $fault $rules $ctx $decls $arg $expected Miss Open))
(= (tc:check-app-lam-idx $n $fault $rules $ctx $decls $arg $expected $body False)
   (tc:check $n $fault $rules $ctx $decls (tc:inst0 $fault $arg $body) $expected Miss Open))
(= (tc:check-app-pi $n $fault $rules $ctx $decls $term $expected $synth $at (Ok $pi))
   (let $is (== (tc:h $pi) Pi)
     (tc:check-app-is $n $fault $rules $ctx $decls $term $expected $synth $at $pi $is)))
(= (tc:check-app-pi $n $fault $rules $ctx $decls $term $expected $synth $at NoFuel)
   Unresolved)
(= (tc:check-app-is $n $fault $rules $ctx $decls $term $expected $synth $at $pi True)
   (let $ck (tc:check $n $fault $rules $ctx $decls (tc:a1 $term) (tc:a0 $pi) Miss Open)
     (tc:check-app-arg $n $fault $rules $ctx $decls $term $expected $synth $at $pi $ck)))
(= (tc:check-app-is $n $fault $rules $ctx $decls $term $expected $synth $at $pi False)
   (tc:check-cumul $n $fault $rules $ctx $decls $term $expected $synth $at))
(= (tc:check-app-arg $n $fault $rules $ctx $decls $term $expected $synth $at $pi Accepted)
   (let $res (tc:inst0 $fault (tc:a1 $term) (tc:a1 $pi))
     (let $b (tc:below $n $fault $rules $ctx $decls $res $expected $at)
       (tc:check-app-res $n $fault $rules $ctx $decls $term $expected $synth $at $b))))
(= (tc:check-app-res $n $fault $rules $ctx $decls $term $expected $synth $at Accepted)
   Accepted)
(= (tc:check-app-res $n $fault $rules $ctx $decls $term $expected $synth $at Unresolved)
   Unresolved)
(= (tc:check-app-res $n $fault $rules $ctx $decls $term $expected $synth $at Refuted)
   (tc:check-app-fallback $n $fault $rules $ctx $decls $term $expected $synth $at
     (Refuted Synth.not_typed) (== $synth Miss)))
(= (tc:check-app-res $n $fault $rules $ctx $decls $term $expected $synth $at (Refuted $thm))
   (tc:check-app-fallback $n $fault $rules $ctx $decls $term $expected $synth $at
     (Refuted $thm) (== $synth Miss)))
(= (tc:check-app-arg $n $fault $rules $ctx $decls $term $expected $synth $at $pi Refuted)
   (Refuted Synth.not_typed))
(= (tc:check-app-arg $n $fault $rules $ctx $decls $term $expected $synth $at $pi Unresolved)
   Unresolved)
(= (tc:check-app-arg $n $fault $rules $ctx $decls $term $expected $synth $at $pi (Refuted $thm))
   (Refuted $thm))
(= (tc:check-app-fallback $n $fault $rules $ctx $decls $term $expected $synth $at $bad True)
   $bad)
(= (tc:check-app-fallback $n $fault $rules $ctx $decls $term $expected $synth $at $bad False)
   (tc:check-cumul $n $fault $rules $ctx $decls $term $expected $synth $at))

(= (tc:check-lam $n $fault $rules $ctx $decls $term $expected)
   (let $wn (tc:whnf $n $rules $fault $expected)
     (let $ok (== (tc:tag $wn) Ok)
       (tc:check-lam-wn $n $fault $rules $ctx $decls $term $wn $ok))))

(= (tc:check-lam-wn $n $fault $rules $ctx $decls $term $wn True)
   (let $ty (tc:ok-tm $wn)
     (let $pi (== (tc:h $ty) Pi)
       (tc:check-lam-pi $n $fault $rules $ctx $decls $term $ty $pi))))
(= (tc:check-lam-wn $n $fault $rules $ctx $decls $term $wn False) Unresolved)

(= (tc:check-lam-pi $n $fault $rules $ctx $decls $term $ty True)
   (let $ann (== (tc:nargs $term) 2)
     (tc:check-lam-ann $n $fault $rules $ctx $decls $term $ty $ann)))
(= (tc:check-lam-pi $n $fault $rules $ctx $decls $term $ty False)
   (Refuted Check.iff_typed))

(= (tc:check-lam-ann $n $fault $rules $ctx $decls $term $ty True)
   (let $dom (tc:conv $n $fault $rules $ctx $decls (tc:a0 $term) (tc:a0 $ty))
     (tc:check-lam-dom $n $fault $rules $ctx $decls (tc:a1 $term) $ty $dom)))
(= (tc:check-lam-ann $n $fault $rules $ctx $decls $term $ty False)
   (tc:check $n $fault $rules (Cons (tc:a0 $ty) $ctx) $decls
     (tc:a0 $term) (tc:a1 $ty) Miss Open))

(= (tc:check-lam-dom $n $fault $rules $ctx $decls $body $ty Accepted)
   (tc:check $n $fault $rules (Cons (tc:a0 $ty) $ctx) $decls
     $body (tc:a1 $ty) Miss Open))
(= (tc:check-lam-dom $n $fault $rules $ctx $decls $body $ty Refuted)
   (Refuted Below.pi_iff))
(= (tc:check-lam-dom $n $fault $rules $ctx $decls $body $ty Unresolved) Unresolved)
(= (tc:check-lam-dom $n $fault $rules $ctx $decls $body $ty (Refuted $thm))
   (Refuted $thm))

(= (tc:check-pair $n $fault $rules $ctx $decls $term $expected)
   (let $wn (tc:whnf $n $rules $fault $expected)
     (let $ok (== (tc:tag $wn) Ok)
       (tc:check-pair-wn $n $fault $rules $ctx $decls $term $wn $ok))))

(= (tc:check-pair-wn $n $fault $rules $ctx $decls $term $wn True)
   (let $ty (tc:ok-tm $wn)
     (let $sg (== (tc:h $ty) Sigma)
       (tc:check-pair-sg $n $fault $rules $ctx $decls $term $ty $sg))))
(= (tc:check-pair-wn $n $fault $rules $ctx $decls $term $wn False) Unresolved)

(= (tc:check-pair-sg $n $fault $rules $ctx $decls $term $ty True)
   (let $c1 (tc:check $n $fault $rules $ctx $decls (tc:a0 $term) (tc:a0 $ty) Miss Open)
     (tc:check-pair-fst $n $fault $rules $ctx $decls $term $ty $c1)))
(= (tc:check-pair-sg $n $fault $rules $ctx $decls $term $ty False)
   (Refuted Check.iff_typed))

(= (tc:check-pair-fst $n $fault $rules $ctx $decls $term $ty Accepted)
   (let $cod (tc:inst0 $fault (tc:a0 $term) (tc:a1 $ty))
     (tc:check $n $fault $rules $ctx $decls (tc:a1 $term) $cod Miss Open)))
(= (tc:check-pair-fst $n $fault $rules $ctx $decls $term $ty Refuted)
   (Refuted Below.sigma_iff))
(= (tc:check-pair-fst $n $fault $rules $ctx $decls $term $ty Unresolved) Unresolved)
(= (tc:check-pair-fst $n $fault $rules $ctx $decls $term $ty (Refuted $thm))
   (Refuted $thm))

(= (tc:check-refl $n $fault $rules $ctx $decls $term $expected)
   (let $wn (tc:whnf $n $rules $fault $expected)
     (let $ok (== (tc:tag $wn) Ok)
       (tc:check-refl-wn $n $fault $rules $ctx $decls $term $wn $ok))))

(= (tc:check-refl-wn $n $fault $rules $ctx $decls $term $wn True)
   (let $ty (tc:ok-tm $wn)
     (let $is (== (tc:h $ty) Id)
       (tc:check-refl-id $n $fault $rules $ctx $decls $term $ty $is))))
(= (tc:check-refl-wn $n $fault $rules $ctx $decls $term $wn False) Unresolved)

(= (tc:check-refl-id $n $fault $rules $ctx $decls $term $ty True)
   (tc:check-refl-body $n $fault $rules $ctx $decls
     (tc:a0 $term) (tc:a0 $ty) (tc:a1 $ty) (tc:a2 $ty)))
(= (tc:check-refl-id $n $fault $rules $ctx $decls $term $ty False) Refuted)

(= (tc:check-refl-body $n $fault $rules $ctx $decls $a $A $x $y)
   (let $gat (tc:synth $n $rules $fault $ctx $decls $A)
     (tc:check-refl-gate $n $fault $rules $ctx $decls $a $A $x $y $gat)))

(= (tc:check-refl-gate $n $fault $rules $ctx $decls $a $A $x $y (Got $at))
   (tc:both
     (tc:check $n $fault $rules $ctx $decls $a $A Miss $at)
     (tc:both
       (tc:check $n $fault $rules $ctx $decls $x $A Miss $at)
       (tc:both
         (tc:check $n $fault $rules $ctx $decls $y $A Miss $at)
         (tc:both
           (tc:compare $n $fault $rules $ctx $decls $a $x $A)
           (tc:compare $n $fault $rules $ctx $decls $a $y $A))))))
(= (tc:check-refl-gate $n $fault $rules $ctx $decls $a $A $x $y Miss)
   (tc:both
     (tc:check $n $fault $rules $ctx $decls $a $A Miss Open)
     (tc:both
       (tc:check $n $fault $rules $ctx $decls $x $A Miss Open)
       (tc:both
         (tc:check $n $fault $rules $ctx $decls $y $A Miss Open)
         (tc:both
           (tc:compare $n $fault $rules $ctx $decls $a $x $A)
           (tc:compare $n $fault $rules $ctx $decls $a $y $A))))))

(= (tc:check-cumul $n $fault $rules $ctx $decls $term $expected $synth $at)
   (let $h (tc:h $term)
     (let $sort (== $h Sort)
       (tc:check-cumul-sort $n $fault $rules $ctx $decls $term $expected $synth $at $sort))))

(= (tc:check-cumul-sort $n $fault $rules $ctx $decls $term $expected $synth $at True)
   (let $got (tc:synth $n $rules $fault $ctx $decls $term)
     (tc:check-sort-got $n $fault $rules $ctx $decls $term $expected $synth $at $got)))
(= (tc:check-cumul-sort $n $fault $rules $ctx $decls $term $expected $synth $at False)
   (let $given (== $synth Miss)
     (tc:check-given $n $fault $rules $ctx $decls $term $expected $synth $at $given)))

(= (tc:check-sort-got $n $fault $rules $ctx $decls $term $expected $synth $at (Got $p))
   (tc:below $n $fault $rules $ctx $decls $p $expected $at))
(= (tc:check-sort-got $n $fault $rules $ctx $decls $term $expected $synth $at Miss)
   (let $given (== $synth Miss)
     (tc:check-given $n $fault $rules $ctx $decls $term $expected $synth $at $given)))

(= (tc:check-given $n $fault $rules $ctx $decls $term $expected $synth $at False)
   (tc:below $n $fault $rules $ctx $decls $synth $expected $at))
(= (tc:check-given $n $fault $rules $ctx $decls $term $expected $synth $at True)
   (let $got (tc:synth $n $rules $fault $ctx $decls $term)
     (tc:check-found $n $fault $rules $ctx $decls $expected $at $got)))

(= (tc:check-found $n $fault $rules $ctx $decls $expected $at (Got $p))
   (tc:below $n $fault $rules $ctx $decls $p $expected $at))
(= (tc:check-found $n $fault $rules $ctx $decls $expected $at Miss) Unresolved)

(= (tc:below $n $fault $rules $ctx $decls $p $a $at)
   (let $open (== $at Open)
     (tc:below-go $n $fault $rules $ctx $decls $p $a $at $open)))

(= (tc:below-go $n $fault $rules $ctx $decls $p $a $at True)
   (tc:below-struct $n $fault $rules $ctx $decls $p $a))
(= (tc:below-go $n $fault $rules $ctx $decls $p $a $at False)
   (let $eq (tc:compare $n $fault $rules $ctx $decls $p $a $at)
     (tc:below-eq $n $fault $rules $ctx $decls $p $a $eq)))

(= (tc:below-eq $n $fault $rules $ctx $decls $p $a Accepted) Accepted)
(= (tc:below-eq $n $fault $rules $ctx $decls $p $a Unresolved) Unresolved)
(= (tc:below-eq $n $fault $rules $ctx $decls $p $a Refuted)
   (tc:below-struct $n $fault $rules $ctx $decls $p $a))

(= (tc:below-struct $n $fault $rules $ctx $decls $p $a)
   (if (< 0 $n)
     (let $pn (tc:whnf $n $rules $fault $p)
       (let $an (tc:whnf $n $rules $fault $a)
         (tc:below-wh $n $fault $rules $ctx $decls $pn $an)))
     Unresolved))

(= (tc:below-wh $n $fault $rules $ctx $decls (Ok $p) (Ok $a))
   (let $same (== $p $a)
     (tc:below-ident $n $fault $rules $ctx $decls $p $a $same)))
(= (tc:below-ident $n $fault $rules $ctx $decls $p $a True) Accepted)
(= (tc:below-ident $n $fault $rules $ctx $decls $p $a False)
   (let $hp (tc:h $p)
     (let $ha (tc:h $a)
       (let $same (== $hp $ha)
         (tc:below-same $n $fault $rules $ctx $decls $p $a $hp $same)))))
(= (tc:below-wh $n $fault $rules $ctx $decls NoFuel $an) Unresolved)
(= (tc:below-wh $n $fault $rules $ctx $decls (Ok $p) NoFuel) Unresolved)

(= (tc:below-same $n $fault $rules $ctx $decls $p $a $hp True)
   (let $sort (== $hp Sort)
     (let $pi (== $hp Pi)
       (let $sig (== $hp Sigma)
         (tc:below-form $n $fault $rules $ctx $decls $p $a $sort $pi $sig)))))
(= (tc:below-same $n $fault $rules $ctx $decls $p $a $hp False)
   (Refuted RigidShape.below_iff))

(= (tc:below-form $n $fault $rules $ctx $decls $p $a True $pi $sig)
   (tc:below-univ $fault $p $a))
(= (tc:below-form $n $fault $rules $ctx $decls $p $a False True $sig)
   (tc:below-pi $n $fault $rules $ctx $decls $p $a))
(= (tc:below-form $n $fault $rules $ctx $decls $p $a False False True)
   (tc:below-sigma $n $fault $rules $ctx $decls $p $a))
(= (tc:below-form $n $fault $rules $ctx $decls $p $a False False False)
   (let $c (tc:conv $n $fault $rules $ctx $decls $p $a)
     (tc:below-rigid $c)))
(= (tc:below-rigid Accepted) Accepted)
(= (tc:below-rigid Refuted) (Refuted RigidShape.below_iff))
(= (tc:below-rigid Unresolved) Unresolved)
(= (tc:below-rigid (Refuted $thm)) (Refuted RigidShape.below_iff))

(= (tc:below-univ $fault $p $a)
   (tc:below-univ-lv $fault (tc:level-of (tc:a0 $p)) (tc:level-of (tc:a0 $a))))
(= (tc:below-univ-lv $fault (Lvl $m) (Lvl $L))
   (tc:below-univ-yes (== (tc:cumul-ok $fault $m $L) Yes)))
(= (tc:below-univ-lv $fault Open $other) Unresolved)
(= (tc:below-univ-lv $fault (Lvl $m) Open) Unresolved)
(= (tc:below-univ-yes True) Accepted)
(= (tc:below-univ-yes False) (Refuted Below.universe_iff))

(= (tc:below-pi $n $fault $rules $ctx $decls $p $a)
   (let $room (< 128 $n)
     (tc:below-pi-room $n $fault $rules $ctx $decls $p $a $room)))
(= (tc:below-pi-room $n $fault $rules $ctx $decls $p $a True)
   (let $dom (tc:conv $n $fault $rules $ctx $decls (tc:a0 $p) (tc:a0 $a))
     (tc:below-pi-dom $n $fault $rules $ctx $decls $p $a $dom)))
(= (tc:below-pi-room $n $fault $rules $ctx $decls $p $a False) Unresolved)
(= (tc:below-pi-dom $n $fault $rules $ctx $decls $p $a Accepted)
   (let $m (- $n 1)
     (tc:below $m $fault $rules (Cons (tc:a0 $p) $ctx) $decls
       (tc:a1 $p) (tc:a1 $a) Open)))
(= (tc:below-pi-dom $n $fault $rules $ctx $decls $p $a Refuted)
   (Refuted Below.pi_iff))
(= (tc:below-pi-dom $n $fault $rules $ctx $decls $p $a Unresolved) Unresolved)
(= (tc:below-pi-dom $n $fault $rules $ctx $decls $p $a (Refuted $thm))
   (Refuted $thm))

(= (tc:below-sigma $n $fault $rules $ctx $decls $p $a)
   (let $room (< 128 $n)
     (tc:below-sigma-room $n $fault $rules $ctx $decls $p $a $room)))
(= (tc:below-sigma-room $n $fault $rules $ctx $decls $p $a True)
   (let $m (- $n 1)
     (let $dom (tc:below $m $fault $rules $ctx $decls (tc:a0 $p) (tc:a0 $a) Open)
       (tc:below-sigma-dom $n $fault $rules $ctx $decls $p $a $dom))))
(= (tc:below-sigma-room $n $fault $rules $ctx $decls $p $a False) Unresolved)
(= (tc:below-sigma-dom $n $fault $rules $ctx $decls $p $a Accepted)
   (let $m (- $n 1)
     (tc:below $m $fault $rules (Cons (tc:a0 $p) $ctx) $decls
       (tc:a1 $p) (tc:a1 $a) Open)))
(= (tc:below-sigma-dom $n $fault $rules $ctx $decls $p $a Refuted)
   (Refuted Below.sigma_iff))
(= (tc:below-sigma-dom $n $fault $rules $ctx $decls $p $a Unresolved) Unresolved)
(= (tc:below-sigma-dom $n $fault $rules $ctx $decls $p $a (Refuted $thm))
   (Refuted $thm))

(= (tc:conv $n $fault $rules $ctx $decls $l $r)
   (let $ln (tc:whnf $n $rules $fault $l)
     (let $rn (tc:whnf $n $rules $fault $r)
       (tc:conv-ok $n $fault $rules $ctx $decls $ln $rn))))
(= (tc:conv-ok $n $fault $rules $ctx $decls (Ok $l) (Ok $r))
   (if (== $l $r) Accepted
     (tc:as-types $n $fault $rules $ctx $decls $l $r)))
(= (tc:conv-ok $n $fault $rules $ctx $decls NoFuel $r) Unresolved)
(= (tc:conv-ok $n $fault $rules $ctx $decls (Ok $l) NoFuel) Unresolved)

(= (tc:answer-map Accepted) Established)
(= (tc:answer-map Unresolved) Unresolved)
(= (tc:answer-map Refuted) (Refuted Synth.not_typed))
(= (tc:answer-map (Refuted $thm)) (Refuted $thm))

(= (tc:answer $n $rules $ctx $decls check $term $expected $synth $at)
   (tc:answer-map (tc:check $n none $rules $ctx $decls $term $expected $synth $at)))
(= (tc:answer $n $rules $ctx $decls eq $l $r $ty)
   (tc:answer-eq (tc:compare $n none $rules $ctx $decls $l $r $ty)
     $n $rules $ctx $decls $l $r))
(= (tc:answer-eq Accepted $n $rules $ctx $decls $l $r) Established)
(= (tc:answer-eq Unresolved $n $rules $ctx $decls $l $r) Unresolved)
(= (tc:answer-eq Refuted $n $rules $ctx $decls $l $r)
   (let $hl (tc:h $l)
     (let $hr (tc:h $r)
       (tc:answer-eq-th $n $rules $ctx $decls $l $r
         (== $hl $hr) (== $hl Pi) (== $hl Sigma) (== $hl Id)))))
(= (tc:answer-eq-th $n $rules $ctx $decls $l $r True True $sg $id)
   (let $b (tc:below $n none $rules $ctx $decls $l $r Open)
     (tc:answer-eq-below $b $l $r)))
(= (tc:answer-eq-th $n $rules $ctx $decls $l $r True False True $id)
   (let $b (tc:below $n none $rules $ctx $decls $l $r Open)
     (tc:answer-eq-below $b $l $r)))
(= (tc:answer-eq-th $n $rules $ctx $decls $l $r True False False True)
   (tc:answer-eq-id $n $rules $ctx $decls $l $r))
(= (tc:answer-eq-th $n $rules $ctx $decls $l $r True False False False)
   (tc:answer-eq-synth $n $rules $ctx $decls $l $r))
(= (tc:answer-eq-th $n $rules $ctx $decls $l $r False $pi $sg $id)
   (tc:answer-eq-synth $n $rules $ctx $decls $l $r))
(= (tc:answer-eq-id $n $rules $ctx $decls $l $r)
   (let $cv (tc:conv $n none $rules $ctx $decls (tc:a0 $l) (tc:a0 $r))
     (tc:answer-eq-id-cv $n $rules $ctx $decls $l $r $cv)))
(= (tc:answer-eq-id-cv $n $rules $ctx $decls $l $r Accepted)
   (Refuted RigidShape.below_iff))
(= (tc:answer-eq-id-cv $n $rules $ctx $decls $l $r Unresolved) Unresolved)
(= (tc:answer-eq-id-cv $n $rules $ctx $decls $l $r Refuted)
   (tc:answer-eq-id-diff $n $rules $ctx $decls (tc:a0 $l) (tc:a0 $r)))
(= (tc:answer-eq-id-cv $n $rules $ctx $decls $l $r (Refuted $thm))
   (tc:answer-eq-id-diff $n $rules $ctx $decls (tc:a0 $l) (tc:a0 $r)))
(= (tc:answer-eq-id-diff $n $rules $ctx $decls $c1 $c2)
   (let $pi (== (tc:h $c1) Pi)
     (let $pi2 (== (tc:h $c2) Pi)
       (let $so (== (tc:h $c1) Sort)
         (let $so2 (== (tc:h $c2) Sort)
           (tc:answer-eq-id-kind $n $rules $ctx $decls $c1 $c2 $pi $pi2 $so $so2))))))
(= (tc:answer-eq-id-kind $n $rules $ctx $decls $c1 $c2 True True $so $so2)
   (tc:answer-eq-id-raise $n $rules $ctx $decls $c1 $c2 raised_function_carrier_ne))
(= (tc:answer-eq-id-kind $n $rules $ctx $decls $c1 $c2 False False True True)
   (tc:answer-eq-id-raise $n $rules $ctx $decls $c1 $c2 raised_carrier_ne))
(= (tc:answer-eq-id-kind $n $rules $ctx $decls $c1 $c2 False False False False)
   (Refuted RigidShape.below_iff))
(= (tc:answer-eq-id-kind $n $rules $ctx $decls $c1 $c2 False False True False)
   (Refuted RigidShape.below_iff))
(= (tc:answer-eq-id-kind $n $rules $ctx $decls $c1 $c2 False False False True)
   (Refuted RigidShape.below_iff))
(= (tc:answer-eq-id-kind $n $rules $ctx $decls $c1 $c2 True False $so $so2)
   (Refuted RigidShape.below_iff))
(= (tc:answer-eq-id-kind $n $rules $ctx $decls $c1 $c2 False True $so $so2)
   (Refuted RigidShape.below_iff))
(= (tc:answer-eq-id-raise $n $rules $ctx $decls $c1 $c2 $name)
   (let $up (tc:below $n none $rules $ctx $decls $c1 $c2 Open)
     (let $dn (tc:below $n none $rules $ctx $decls $c2 $c1 Open)
       (tc:answer-eq-id-up $up $dn $name))))
(= (tc:answer-eq-id-up $up $dn $name)
   (let $ua (== $up Accepted)
     (let $da (== $dn Accepted)
       (let $uu (== $up Unresolved)
         (let $du (== $dn Unresolved)
           (tc:answer-eq-id-upgo $ua $da $uu $du $name))))))
(= (tc:answer-eq-id-upgo True $da $uu $du $name) (Refuted $name))
(= (tc:answer-eq-id-upgo False True $uu $du $name) (Refuted $name))
(= (tc:answer-eq-id-upgo False False True $du $name) Unresolved)
(= (tc:answer-eq-id-upgo False False False True $name) Unresolved)
(= (tc:answer-eq-id-upgo False False False False $name) (Refuted RigidShape.below_iff))
(= (tc:answer-eq-synth $n $rules $ctx $decls $l $r)
   (let $sl (tc:synth $n none $rules $ctx $decls $l)
     (let $sr (tc:synth $n none $rules $ctx $decls $r)
       (tc:answer-eq-ty $n $rules $ctx $decls $l $r $sl $sr))))
(= (tc:answer-eq-ty $n $rules $ctx $decls $l $r $sl $sr)
   (let $ga (== (tc:tag $sl) Got)
     (let $gb (== (tc:tag $sr) Got)
       (tc:answer-eq-ty-go $n $rules $ctx $decls $l $r $sl $sr $ga $gb))))
(= (tc:answer-eq-ty-go $n $rules $ctx $decls $l $r (Got $a) (Got $b) True True)
   (let $ha (tc:h $a)
     (let $hb (tc:h $b)
       (tc:answer-eq-heads $n $rules $ctx $decls $l $r $a $b
         (== $ha Sort) (== $hb Sort) (== $ha Pi) (== $hb Pi)))))
(= (tc:answer-eq-ty-go $n $rules $ctx $decls $l $r $sl $sr False $gb)
   (let $b (tc:below $n none $rules $ctx $decls $l $r Open)
     (tc:answer-eq-below $b $l $r)))
(= (tc:answer-eq-ty-go $n $rules $ctx $decls $l $r $sl $sr True False)
   (let $b (tc:below $n none $rules $ctx $decls $l $r Open)
     (tc:answer-eq-below $b $l $r)))
(= (tc:answer-eq-heads $n $rules $ctx $decls $l $r $a $b True True $pa $pb)
   (Refuted Synth.not_equal_types))
(= (tc:answer-eq-heads $n $rules $ctx $decls $l $r $a $b True False False True)
   (Refuted Synth.not_equal_types))
(= (tc:answer-eq-heads $n $rules $ctx $decls $l $r $a $b False True True False)
   (Refuted Synth.not_equal_types))
(= (tc:answer-eq-heads $n $rules $ctx $decls $l $r $a $b False False True True)
   (let $b (tc:below $n none $rules $ctx $decls $l $r Open)
     (tc:answer-eq-below $b $l $r)))
(= (tc:answer-eq-heads $n $rules $ctx $decls $l $r $a $b False False True False)
   (let $up (tc:below $n none $rules $ctx $decls $a $b Open)
     (tc:answer-eq-up $up)))
(= (tc:answer-eq-heads $n $rules $ctx $decls $l $r $a $b False False False True)
   (let $up (tc:below $n none $rules $ctx $decls $a $b Open)
     (tc:answer-eq-up $up)))
(= (tc:answer-eq-heads $n $rules $ctx $decls $l $r $a $b False False False False)
   (let $up (tc:below $n none $rules $ctx $decls $a $b Open)
     (tc:answer-eq-up $up)))
(= (tc:answer-eq-up Accepted) (Refuted not_equal_of_unrelated))
(= (tc:answer-eq-up (Refuted $thm)) (Refuted $thm))
(= (tc:answer-eq-up Refuted) (Refuted Synth.not_equal_types))
(= (tc:answer-eq-up Unresolved) Unresolved)
(= (tc:answer-eq-below Accepted $l $r)
   (tc:answer-eq-sub (== (tc:h $l) Pi) (== (tc:h $l) Id)))
(= (tc:answer-eq-below Unresolved $l $r) Unresolved)
(= (tc:answer-eq-below (Refuted $thm) $l $r) (Refuted $thm))
(= (tc:answer-eq-below Refuted $l $r) (Refuted Synth.not_equal_types))
(= (tc:answer-eq-sub True $id) (Refuted Below.pi_codomain_raise))
(= (tc:answer-eq-sub False True) (Refuted raised_carrier_ne))
(= (tc:answer-eq-sub False False) (Refuted Synth.not_equal_types))
(= (tc:answer $n $rules $ctx $decls formed $term)
   (tc:answer-formed $n $rules (tc:synth $n none $rules $ctx $decls $term)))
(= (tc:answer $n $rules $ctx $decls of $term)
   (tc:answer-of $term (tc:synth $n none $rules $ctx $decls $term)))

(= (tc:answer-formed $n $rules (Got $t))
   (tc:answer-formed-ty (tc:whnf $n $rules none $t)))
(= (tc:answer-formed $n $rules (Refuted $thm)) (Refuted $thm))
(= (tc:answer-formed $n $rules Miss) Unresolved)
(= (tc:answer-formed-ty (Ok $t))
   (tc:answer-formed-sort (== (tc:h $t) Sort)))
(= (tc:answer-formed-ty NoFuel) Unresolved)
(= (tc:answer-formed-sort True) Established)
(= (tc:answer-formed-sort False) (Refuted Synth.isType_iff))

(= (tc:answer-of $term (Got $t)) Established)
(= (tc:answer-of $term (Refuted $thm)) (Refuted $thm))
(= (tc:answer-of $term Miss)
   (let $h (tc:h $term)
     (let $ix (== $h idx)
       (let $dc (== $h DeclConst)
         (tc:answer-of-miss $ix $dc)))))
(= (tc:answer-of-miss True $dc) (Refuted Synth.not_typed))
(= (tc:answer-of-miss False True) (Refuted Synth.not_typed))
(= (tc:answer-of-miss False False) Unresolved)
