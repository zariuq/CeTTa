(: multi:proof:true-p
  (-> (state : multi:state) (index : multi:index)
      (q r : finite-view:status)
      (view : (multi:cell-view state index finite-view:present q r))
      (multi:true state (multi:p index))))
(: multi:proof:true-q
  (-> (state : multi:state) (index : multi:index)
      (p r : finite-view:status)
      (view : (multi:cell-view state index p finite-view:present r))
      (multi:true state (multi:q index))))
(: multi:proof:true-r
  (-> (state : multi:state) (index : multi:index)
      (p q : finite-view:status)
      (view : (multi:cell-view state index p q finite-view:present))
      (multi:true state (multi:r index))))
(: multi:proof:not-true-p
  (-> (state : multi:state) (index : multi:index)
      (q r : finite-view:status)
      (view : (multi:cell-view state index finite-view:absent q r))
      (multi:not-true state (multi:p index))))
(: multi:proof:not-true-q
  (-> (state : multi:state) (index : multi:index)
      (p r : finite-view:status)
      (view : (multi:cell-view state index p finite-view:absent r))
      (multi:not-true state (multi:q index))))
(: multi:proof:not-true-r
  (-> (state : multi:state) (index : multi:index)
      (p q : finite-view:status)
      (view : (multi:cell-view state index p q finite-view:absent))
      (multi:not-true state (multi:r index))))
(: multi:proof:does-a
  (-> (state : multi:state) (index : multi:index)
      (b c : finite-view:status)
      (view : (multi:action-view state index finite-view:present b c))
      (multi:does state multi:robot (multi:a index))))
(: multi:proof:does-b
  (-> (state : multi:state) (index : multi:index)
      (a c : finite-view:status)
      (view : (multi:action-view state index a finite-view:present c))
      (multi:does state multi:robot (multi:b index))))
(: multi:proof:does-c
  (-> (state : multi:state) (index : multi:index)
      (a b : finite-view:status)
      (view : (multi:action-view state index a b finite-view:present))
      (multi:does state multi:robot (multi:c index))))
(: multi:proof:not-does-a
  (-> (state : multi:state) (index : multi:index)
      (b c : finite-view:status)
      (view : (multi:action-view state index finite-view:absent b c))
      (multi:not-does state multi:robot (multi:a index))))
(: multi:proof:not-does-b
  (-> (state : multi:state) (index : multi:index)
      (a c : finite-view:status)
      (view : (multi:action-view state index a finite-view:absent c))
      (multi:not-does state multi:robot (multi:b index))))
(: multi:proof:not-does-c
  (-> (state : multi:state) (index : multi:index)
      (a b : finite-view:status)
      (view : (multi:action-view state index a b finite-view:absent))
      (multi:not-does state multi:robot (multi:c index))))
(: multi:proof:true-step
  (-> (state : multi:state) (step : multi:index)
      (view : (multi:step-view state step))
      (multi:true state (multi:step step))))

