; Generated proof-producing rules for every Untwisty Corridor state.
; Negative GDL premises consume exact finite-view absence evidence.
; Action and persistence proofs of p remain separate occurrences.

(= (corridor:package corridor:goal:train:state-1)
  (compile:rule-package iggp-corridor-goal-train-state-1-v1
    (rm-package
      (rm-block proposition-view-q8 iggp:corridor:goal:train:state-1:proposition-view-q8
        (quote corridor:proof:proposition-view:goal:train:state-1:q8)
        rm-nil
        (quote (corridor:proposition-view corridor:goal:train:state-1 corridor:q8 finite-view:absent)))
      (rm-block true-proposition iggp:corridor:true-proposition
        (quote (corridor:proof:true-proposition corridor:goal:train:state-1 $proposition (unquote $view-proof)))
        (rm-cons (rm-premise $view-proof (quote (corridor:proposition-view corridor:goal:train:state-1 $proposition finite-view:present))) rm-nil)
        (quote (corridor:true corridor:goal:train:state-1 $proposition)))
      (rm-block not-true-proposition iggp:corridor:not-true-proposition
        (quote (corridor:proof:not-true-proposition corridor:goal:train:state-1 $proposition (unquote $view-proof)))
        (rm-cons (rm-premise $view-proof (quote (corridor:proposition-view corridor:goal:train:state-1 $proposition finite-view:absent))) rm-nil)
        (quote (corridor:not-true corridor:goal:train:state-1 $proposition)))
      (rm-block goal-hundred iggp:corridor:goal-hundred
        (quote (corridor:proof:goal-hundred corridor:goal:train:state-1 (unquote $q8-proof)))
        (rm-cons (rm-premise $q8-proof (quote (corridor:true corridor:goal:train:state-1 corridor:q8))) rm-nil)
        (quote (corridor:goal corridor:goal:train:state-1 corridor:robot corridor:n100)))
      (rm-block goal-zero iggp:corridor:goal-zero
        (quote (corridor:proof:goal-zero corridor:goal:train:state-1 (unquote $not-q8)))
        (rm-cons (rm-premise $not-q8 (quote (corridor:not-true corridor:goal:train:state-1 corridor:q8))) rm-nil)
        (quote (corridor:goal corridor:goal:train:state-1 corridor:robot corridor:n0)))
    )))

