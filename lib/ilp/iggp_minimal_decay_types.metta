(: decay:true-value
  (-> (state : decay:state) (value : decay:int) (u 0)))
(: decay:does
  (-> (state : decay:state) (agent : decay:agent)
      (action : decay:action) (u 0)))
(: decay:succ
  (-> (state : decay:state) (earlier : decay:int)
      (later : decay:int) (u 0)))
(: decay:goal
