(: decay:proof:succ-0-1
  (-> (state : decay:state)
      (decay:succ state decay:n0 decay:n1)))
(: decay:proof:succ-1-2
  (-> (state : decay:state)
      (decay:succ state decay:n1 decay:n2)))
(: decay:proof:succ-2-3
