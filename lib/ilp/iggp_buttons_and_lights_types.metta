(: buttons:proof:true-p
  (-> (state : buttons:state) (q r : finite-view:status)
      (step : buttons:fluent)
      (view : (buttons:state-view state finite-view:present q r step))
      (buttons:true state buttons:p)))
(: buttons:proof:true-q
  (-> (state : buttons:state) (p r : finite-view:status)
      (step : buttons:fluent)
      (view : (buttons:state-view state p finite-view:present r step))
      (buttons:true state buttons:q)))
(: buttons:proof:true-r
  (-> (state : buttons:state) (p q : finite-view:status)
      (step : buttons:fluent)
      (view : (buttons:state-view state p q finite-view:present step))
      (buttons:true state buttons:r)))
(: buttons:proof:not-true-p
  (-> (state : buttons:state) (q r : finite-view:status)
      (step : buttons:fluent)
      (view : (buttons:state-view state finite-view:absent q r step))
      (buttons:not-true state buttons:p)))
(: buttons:proof:not-true-q
  (-> (state : buttons:state) (p r : finite-view:status)
      (step : buttons:fluent)
      (view : (buttons:state-view state p finite-view:absent r step))
      (buttons:not-true state buttons:q)))
(: buttons:proof:not-true-r
  (-> (state : buttons:state) (p q : finite-view:status)
      (step : buttons:fluent)
      (view : (buttons:state-view state p q finite-view:absent step))
      (buttons:not-true state buttons:r)))
(: buttons:proof:true-step
  (-> (state : buttons:state) (p q r : finite-view:status)
      (step : buttons:fluent)
      (view : (buttons:state-view state p q r step))
      (buttons:true state step)))

(: buttons:proof:successor-1-2
  (-> (state : buttons:state)
      (buttons:successor state buttons:n1
        buttons:n2)))
(: buttons:proof:successor-2-3
  (-> (state : buttons:state)
      (buttons:successor state buttons:n2
        buttons:n3)))
(: buttons:proof:successor-3-4
  (-> (state : buttons:state)
      (buttons:successor state buttons:n3
        buttons:n4)))
(: buttons:proof:successor-4-5
  (-> (state : buttons:state)
      (buttons:successor state buttons:n4
        buttons:n5)))
(: buttons:proof:successor-5-6
  (-> (state : buttons:state)
      (buttons:successor state buttons:n5
        buttons:n6)))
(: buttons:proof:successor-6-7
  (-> (state : buttons:state)
      (buttons:successor state buttons:n6
        buttons:n7)))
(: buttons:proof:legal-a
  (-> (state : buttons:state)
      (buttons:legal state buttons:robot buttons:a)))
(: buttons:proof:legal-b
  (-> (state : buttons:state)
      (buttons:legal state buttons:robot buttons:b)))
(: buttons:proof:legal-c
  (-> (state : buttons:state)
      (buttons:legal state buttons:robot buttons:c)))

(: buttons:proof:goal-100
  (-> (state : buttons:state)
      (p-proof : (buttons:true state buttons:p))
      (q-proof : (buttons:true state buttons:q))
      (r-proof : (buttons:true state buttons:r))
      (buttons:goal state buttons:robot buttons:n100)))
(: buttons:proof:goal-0-p
  (-> (state : buttons:state)
      (absence : (buttons:not-true state buttons:p))
      (buttons:goal state buttons:robot buttons:n0)))
(: buttons:proof:goal-0-q
  (-> (state : buttons:state)
      (absence : (buttons:not-true state buttons:q))
      (buttons:goal state buttons:robot buttons:n0)))
(: buttons:proof:goal-0-r
  (-> (state : buttons:state)
      (absence : (buttons:not-true state buttons:r))
      (buttons:goal state buttons:robot buttons:n0)))
(: buttons:proof:terminal-all-on
  (-> (state : buttons:state)
      (p-proof : (buttons:true state buttons:p))
      (q-proof : (buttons:true state buttons:q))
      (r-proof : (buttons:true state buttons:r))
      (buttons:terminal state)))
(: buttons:proof:terminal-step-seven
  (-> (state : buttons:state)
      (step-proof : (buttons:true state buttons:n7))
      (buttons:terminal state)))
(: buttons:proof:next-step
  (-> (state : buttons:state) (earlier later : buttons:fluent)
      (true-proof : (buttons:true state earlier))
      (successor-proof : (buttons:successor state earlier later))
      (buttons:next state later)))
(: buttons:proof:next-p-a-absent
  (-> (state : buttons:state)
      (does-proof : (buttons:does state buttons:robot buttons:a))
      (condition-proof : (buttons:not-true state buttons:p))
      (buttons:next state buttons:p)))
(: buttons:proof:next-p-b-q
  (-> (state : buttons:state)
      (does-proof : (buttons:does state buttons:robot buttons:b))
      (condition-proof : (buttons:true state buttons:q))
      (buttons:next state buttons:p)))
(: buttons:proof:next-p-c-p
  (-> (state : buttons:state)
      (does-proof : (buttons:does state buttons:robot buttons:c))
      (condition-proof : (buttons:true state buttons:p))
      (buttons:next state buttons:p)))
(: buttons:proof:next-q-a-q
  (-> (state : buttons:state)
      (does-proof : (buttons:does state buttons:robot buttons:a))
      (condition-proof : (buttons:true state buttons:q))
      (buttons:next state buttons:q)))
(: buttons:proof:next-q-b-p
  (-> (state : buttons:state)
      (does-proof : (buttons:does state buttons:robot buttons:b))
      (condition-proof : (buttons:true state buttons:p))
      (buttons:next state buttons:q)))
(: buttons:proof:next-q-c-r
  (-> (state : buttons:state)
      (does-proof : (buttons:does state buttons:robot buttons:c))
      (condition-proof : (buttons:true state buttons:r))
      (buttons:next state buttons:q)))
(: buttons:proof:next-r-a-r
  (-> (state : buttons:state)
      (does-proof : (buttons:does state buttons:robot buttons:a))
      (condition-proof : (buttons:true state buttons:r))
      (buttons:next state buttons:r)))
(: buttons:proof:next-r-b-r
  (-> (state : buttons:state)
      (does-proof : (buttons:does state buttons:robot buttons:b))
      (condition-proof : (buttons:true state buttons:r))
      (buttons:next state buttons:r)))
(: buttons:proof:next-r-c-q
  (-> (state : buttons:state)
      (does-proof : (buttons:does state buttons:robot buttons:c))
      (condition-proof : (buttons:true state buttons:q))
      (buttons:next state buttons:r)))

