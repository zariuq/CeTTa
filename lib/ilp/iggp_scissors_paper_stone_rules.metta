            (rm-cons
              (rm-premise $apart
                (quote (sps:distinct sps:terminal:test:state-4 $player $other)))
              (rm-cons
                (rm-premise $beats-proof
                  (quote (sps:beats sps:terminal:test:state-4 $own $other-action)))
                rm-nil))))
        (quote (sps:wins sps:terminal:test:state-4 $player)))
      (rm-block loses iggp:sps:loses
        (quote
          (sps:proof:loses sps:terminal:test:state-4 $player $other
            $own $other-action
            (unquote $player-does) (unquote $other-does)
            (unquote $apart) (unquote $beats-proof)))
        (rm-cons
          (rm-premise $player-does
            (quote (sps:does sps:terminal:test:state-4 $player $own)))
          (rm-cons
            (rm-premise $other-does
              (quote (sps:does sps:terminal:test:state-4 $other $other-action)))
            (rm-cons
              (rm-premise $apart
                (quote (sps:distinct sps:terminal:test:state-4 $player $other)))
              (rm-cons
                (rm-premise $beats-proof
                  (quote (sps:beats sps:terminal:test:state-4 $other-action $own)))
                rm-nil))))
        (quote (sps:loses sps:terminal:test:state-4 $player)))
      (rm-block terminal iggp:sps:terminal
        (quote
          (sps:proof:terminal sps:terminal:test:state-4
            (unquote $step-proof)))
        (rm-cons
          (rm-premise $step-proof
            (quote (sps:true-step sps:terminal:test:state-4 sps:n3)))
          rm-nil)
        (quote (sps:terminal sps:terminal:test:state-4)))
    )))
