(: hopper:cipher:char-to-num
  (-> (char : hopper:char) (number : hopper:cipher-num) (u 0)))
(: hopper:cipher:num-to-char
  (-> (number : hopper:cipher-num) (char : hopper:char) (u 0)))
(: hopper:cipher:pred
  (-> (later : hopper:cipher-num)
      (earlier : hopper:cipher-num) (u 0)))
