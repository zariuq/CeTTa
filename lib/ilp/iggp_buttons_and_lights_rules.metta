; Generated proof-producing rules for all buttons_and_lights states.
; State-view projection makes finite-state absence explicit evidence.
; Outside the exact state image, no absence proof is manufactured.

(= (buttons:package buttons:goal:train:state-1)
  (compile:rule-package iggp-buttons-goal-train-state-1-v1
    (rm-package
      (rm-block state-view iggp:buttons:goal:train:state-1:view
        (quote buttons:proof:view:goal:train:state-1)
        rm-nil
        (quote (buttons:state-view buttons:goal:train:state-1 finite-view:absent finite-view:absent finite-view:absent buttons:n1)))
      (rm-block successor-1-2 iggp:buttons:successor-1-2
        (quote (buttons:proof:successor-1-2 buttons:goal:train:state-1))
        rm-nil
        (quote (buttons:successor buttons:goal:train:state-1 buttons:n1 buttons:n2)))
      (rm-block successor-2-3 iggp:buttons:successor-2-3
        (quote (buttons:proof:successor-2-3 buttons:goal:train:state-1))
        rm-nil
        (quote (buttons:successor buttons:goal:train:state-1 buttons:n2 buttons:n3)))
      (rm-block successor-3-4 iggp:buttons:successor-3-4
