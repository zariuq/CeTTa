        (quote (buttons:proof:successor-5-6 buttons:goal:train:state-1))
        rm-nil
        (quote (buttons:successor buttons:goal:train:state-1 buttons:n5 buttons:n6)))
      (rm-block successor-6-7 iggp:buttons:successor-6-7
        (quote (buttons:proof:successor-6-7 buttons:goal:train:state-1))
        rm-nil
        (quote (buttons:successor buttons:goal:train:state-1 buttons:n6 buttons:n7)))
      (rm-block true-p iggp:buttons:true-p
        (quote
          (buttons:proof:true-p buttons:goal:train:state-1 $q $r $step
            (unquote $view-proof)))
        (rm-cons
          (rm-premise $view-proof
            (quote (buttons:state-view buttons:goal:train:state-1
              finite-view:present $q $r $step)))
          rm-nil)
        (quote (buttons:true buttons:goal:train:state-1 buttons:p)))
      (rm-block true-q iggp:buttons:true-q
        (quote
