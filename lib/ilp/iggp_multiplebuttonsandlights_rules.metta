        (rm-cons (rm-premise $p-proof (quote (multi:true multi:terminal:test:state-34 (multi:p multi:n5)))) (rm-cons (rm-premise $q-proof (quote (multi:true multi:terminal:test:state-34 (multi:q multi:n5)))) (rm-cons (rm-premise $r-proof (quote (multi:true multi:terminal:test:state-34 (multi:r multi:n5)))) rm-nil)))
        (quote (multi:terminal multi:terminal:test:state-34)))
      (rm-block terminal-step-seven iggp:multi:terminal-step-seven
        (quote (multi:proof:terminal-step-seven multi:terminal:test:state-34 (unquote $step-proof)))
        (rm-cons (rm-premise $step-proof (quote (multi:true multi:terminal:test:state-34 (multi:step multi:n7)))) rm-nil)
        (quote (multi:terminal multi:terminal:test:state-34)))
    )))
