; Typed, immutable packed-tensor programs over the existing compact DAG.
; Operator labels are data. Only the closed recipes below select operations;
; decoded names never become evaluator calls. Input references bind at run time.
!(import! &self (library tensor))
!(import! &self (library dag))
!(import! &self (library list))
!(import! &self (library lib_binary_value))

(= (tensor-program:sort? $sort)
   (or (== $sort "F64Tensor") (or (== $sort "BoolTensor") (== $sort "I64Tensor"))))
(= (tensor-program:value? $sort $value)
   (if (tensor:is-tensor $value)
     (and (tensor:all-finite $value)
       (or (and (== $sort "F64Tensor") (== (tensor:dtype $value) f64))
         (or (and (== $sort "BoolTensor") (== (tensor:dtype $value) bool))
             (and (== $sort "I64Tensor") (== (tensor:dtype $value) i64))))) False))
(= (tensor-program:contract $recipe)
   (case $recipe
     ((TP:Add (TP:Contract ("F64Tensor" "F64Tensor") "F64Tensor" None))
      (TP:Subtract (TP:Contract ("F64Tensor" "F64Tensor") "F64Tensor" None))
      (TP:Multiply (TP:Contract ("F64Tensor" "F64Tensor") "F64Tensor" None))
      (TP:Divide (TP:Contract ("F64Tensor" "F64Tensor") "F64Tensor" None))
      (TP:Less (TP:Contract ("F64Tensor" "F64Tensor") "BoolTensor" None))
      (TP:Greater (TP:Contract ("F64Tensor" "F64Tensor") "BoolTensor" None))
      (TP:Scan (TP:Contract ("F64Tensor") "F64Tensor" Axis))
      (TP:Concatenate (TP:Contract ("F64Tensor" "F64Tensor") "F64Tensor" Axis))
      (TP:Permute (TP:Contract ("F64Tensor") "F64Tensor" Permutation))
      (TP:Broadcast (TP:Contract ("F64Tensor") "F64Tensor" Shape))
      (TP:BroadcastLike (TP:Contract ("F64Tensor" "F64Tensor") "F64Tensor" None))
      (TP:Matvec (TP:Contract ("F64Tensor" "F64Tensor") "F64Tensor" Schedule))
      (TP:Sum (TP:Contract ("F64Tensor") "F64Tensor" Schedule))
      (TP:Gather (TP:Contract ("F64Tensor" "I64Tensor") "F64Tensor" None))
      (TP:GatherRows (TP:Contract ("F64Tensor" "I64Tensor") "F64Tensor" None))
      ($other (TP:Fault UnknownRecipe)))))
(= (tensor-program:operators? $operators $names)
   (if (== (get-metatype $operators) Expression)
     (if (== $operators ()) True
       (case (car-atom $operators)
         (((TP:Operator $name $inputs $output $recipe)
           (if (and (binary-schema:text? $name) (not (binary-schema:member? $name $names)))
             (case (tensor-program:contract $recipe)
               (((TP:Contract $wanted-inputs $wanted-output $parameters)
                 (and (== $inputs $wanted-inputs)
                   (and (== $output $wanted-output)
                     (let $later (cons-atom $name $names)
                       (tensor-program:operators? (cdr-atom $operators) $later))))) ($other False))) False))
          ($other False)))) False))
(= (tensor-program:family? $family)
   (case $family
     (((TP:Family "TF1" $operators) (tensor-program:operators? $operators ())) ($other False))))
(= (tensor-program:at $items $index)
   (if (binary:unsigned? $index)
     (if (< $index (size-atom $items)) (TP:Some (index-atom $items $index)) TP:None) TP:None))
(= (tensor-program:operator (TP:Family $version $operators) $index) (tensor-program:at $operators $index))
(= (tensor-program:naturals? $values)
   (if (== (get-metatype $values) Expression)
     (if (== $values ()) True
       (and (binary:unsigned? (car-atom $values)) (tensor-program:naturals? (cdr-atom $values)))) False))
(= (tensor-program:parameters? $kind $values)
   (case $kind
     ((None (== $values ()))
      (Axis (case $values ((($axis) (binary:unsigned? $axis)) ($other False))))
      (Shape (case $values ((($shape) (tensor-program:naturals? $shape)) ($other False))))
      (Permutation (case $values ((($permutation) (tensor-program:naturals? $permutation)) ($other False))))
      (Schedule (or (== $values (sequential)) (== $values (fixed4))))
      ($other False))))

(= (tensor-program:bytes $value)
   (case (binary-value:pack $value)
     (((Binary:TreeBytes $bytes) $bytes) ($other (TP:Fault Codec)))))
(= (tensor-program:input $sort $index)
   (if (and (tensor-program:sort? $sort) (binary:unsigned? $index))
     (let $bytes (tensor-program:bytes (TP:Input $sort $index)) (Binary:Leaf $bytes))
     (TP:Fault Input)))
(= (tensor-program:constant $sort $value)
   (if (tensor-program:value? $sort $value)
     (let* (($storage (if (== $sort "BoolTensor") (tensor:cast $value u8 exact) $value))
            ($encoded (tensor:encode-bytes $storage)))
       (case $encoded
         (((Tensor:Fault $reason) (TP:Fault Transport))
          ($bytes (let $record (tensor-program:bytes (TP:Constant $sort $bytes)) (Binary:Leaf $record))))))
     (TP:Fault Constant)))
; The logical sort stays I64Tensor. Its explicitly tagged U8 storage is
; admitted only by an exact integer cast, never a floating approximation.
; Keep ordinary literals when the complete compact record would be larger.
(= (tensor-program:compact-constant $sort $value)
   (case (tensor-program:constant $sort $value)
     (((Binary:Leaf $ordinary)
       (if (== $sort "I64Tensor")
         (let $small (tensor:cast $value u8 exact)
           (if (and (tensor:is-tensor $small) (== (tensor:dtype $small) u8))
             (let $compact (tensor-program:bytes
                    (TP:PackedConstant $sort "u8" (tensor:encode-bytes $small)))
               (if (< (index-atom (tensor:shape $compact) 0) (index-atom (tensor:shape $ordinary) 0))
                 (Binary:Leaf $compact) (Binary:Leaf $ordinary))) (Binary:Leaf $ordinary)))
         (Binary:Leaf $ordinary))) ($invalid $invalid))))
(= (tensor-program:node $operator $parameters $children)
   (if (and (binary:unsigned? $operator) (tensor-program:naturals? $children))
     (let $bytes (tensor-program:bytes (TP:Apply $operator $parameters)) (Binary:Node $bytes $children))
     (TP:Fault Application)))
(= (tensor-program:decode-constant $sort $bytes)
   (let $storage (tensor:decode-bytes $bytes)
     (if (and (== $sort "BoolTensor")
              (not (and (tensor:is-tensor $storage) (== (tensor:dtype $storage) u8))))
       (TP:Fault Constant)
       (let $value (if (== $sort "BoolTensor") (tensor:cast $storage bool exact) $storage)
         (if (tensor-program:value? $sort $value) (TP:Value $sort $value) (TP:Fault Constant))))))
(= (tensor-program:decode-packed-constant $sort $storage $bytes)
   (if (and (== $sort "I64Tensor") (== $storage "u8"))
     (let $packed (tensor:decode-bytes $bytes)
       (if (and (tensor:is-tensor $packed) (== (tensor:dtype $packed) u8))
         (let $value (tensor:cast $packed i64 exact)
           (if (tensor-program:value? $sort $value) (TP:Value $sort $value) (TP:Fault Constant)))
         (TP:Fault Constant))) (TP:Fault Constant)))
(= (tensor-program:leaf-type $bytes)
   (case (binary-value:unpack $bytes)
     (((BinaryValue:Value (TP:Input $sort $index))
       (if (and (tensor-program:sort? $sort) (binary:unsigned? $index)) (TP:Some $sort) TP:None))
      ((BinaryValue:Value (TP:Constant $sort $payload))
       (case (tensor-program:decode-constant $sort $payload)
         (((TP:Value $actual $value) (TP:Some $actual)) ($other TP:None))))
      ((BinaryValue:Value (TP:PackedConstant $sort $storage $payload))
       (case (tensor-program:decode-packed-constant $sort $storage $payload)
         (((TP:Value $actual $value) (TP:Some $actual)) ($other TP:None))))
      ($other TP:None))))
(= (tensor-program:select-types $types $references)
   (if (== $references ()) (TP:Some ())
     (case ((tensor-program:at $types (car-atom $references))
            (tensor-program:select-types $types (cdr-atom $references)))
       ((((TP:Some $first) (TP:Some $rest))
         (let $selected (cons-atom $first $rest) (TP:Some $selected))) ($other TP:None)))))
(= (tensor-program:node-type $family $bytes $argument-types)
   (case (binary-value:unpack $bytes)
     (((BinaryValue:Value (TP:Apply $index $parameters))
       (case (tensor-program:operator $family $index)
         (((TP:Some (TP:Operator $name $inputs $output $recipe))
           (case (tensor-program:contract $recipe)
             (((TP:Contract $expected $result $kind)
               (if (and (== $argument-types $inputs) (tensor-program:parameters? $kind $parameters))
                 (TP:Some $output) TP:None)) ($other TP:None)))) ($other TP:None))))
      ($other TP:None))))
(= (tensor-program:record-type $family $types $record)
   (case $record
     (((Binary:Leaf $bytes) (tensor-program:leaf-type $bytes))
      ((Binary:Node $bytes $references)
       (case (tensor-program:select-types $types $references)
         (((TP:Some $arguments) (tensor-program:node-type $family $bytes $arguments)) ($other TP:None))))
      ($other TP:None))))
(= (tensor-program:check-records $family $types $records)
   (if (== $records ()) (TP:Some $types)
     (case (tensor-program:record-type $family $types (car-atom $records))
       (((TP:Some $sort)
         (let $later (union-atom $types (cons-atom $sort ()))
           (tensor-program:check-records $family $later (cdr-atom $records)))) ($other TP:None)))))
(= (tensor-program:load $family $forest)
   (if (tensor-program:family? $family)
     (case (dag:from-records $forest)
       (((Dag:Fault $reason) (TP:Fault References))
        ($handle
         (case (dag:export $handle)
           (((Dag:Forest $roots $records)
             (case (tensor-program:check-records $family () $records)
               (((TP:Some $types) (TP:Loaded $family $handle))
                ($other (let $closed (dag:close $handle) (TP:Fault Types))))))
            ($other (let $closed (dag:close $handle) (TP:Fault References))))))))
     (TP:Fault Family)))
(= (tensor-program:pack $family $forest)
   (case (tensor-program:load $family $forest)
     (((TP:Loaded $checked $handle)
       (let* (($records (dag:export $handle))
              ($bytes (tensor-program:bytes (TP:Program "TP1" $checked $records)))
              ($closed (dag:close $handle))) (TP:Artifact $bytes))) ($other $other))))
(= (tensor-program:unpack $bytes)
   (case (binary-value:unpack $bytes)
     (((BinaryValue:Value (TP:Program "TP1" $family $forest)) (tensor-program:load $family $forest))
      ($other (TP:Fault Codec)))))

; Lexical projections contain authored primitive code, not decoded call heads.
; Native compilation is an optimization; ordinary evaluation retains the same
; closed recipe when observers, fuel or unsupported compilation require it.
(= (tensor-program:zip $recipe $inputs)
   (let $projection
     (case $recipe
       ((TP:Add (|-> ($x $y) (+ $x $y)))
        (TP:Subtract (|-> ($x $y) (- $x $y)))
        (TP:Multiply (|-> ($x $y) (* $x $y)))
        (TP:Divide (|-> ($x $y) (/ $x $y)))
        (TP:Less (|-> ($x $y) (if (< $x $y) 1.0 0.0)))
        (TP:Greater (|-> ($x $y) (if (> $x $y) 1.0 0.0)))))
     (let $result (tensor:zip-map f64 $inputs $projection ())
       (if (or (== $recipe TP:Less) (== $recipe TP:Greater)) (tensor:cast $result bool exact) $result))))
; Broadcasting observes the logical scalar, not a physical allocation offset.
; Copy before dense conversion also handles computed COO scalars. Conversion
; refuses absent support rather than supplying an implicit scalar zero.
(= (tensor-program:broadcast $scalar $shape)
   (if (== (tensor:shape $scalar) ())
     (case (tensor:copy $scalar)
       (((Tensor:Fault $reason) (Tensor:Fault $reason))
        ($copy
          (case (tensor:convert $copy dense)
            (((Tensor:Fault $reason) (Tensor:Fault $reason))
             ($owned
               (let $strides (map-atom $shape $dimension 0)
                 (tensor:view $owned $shape $strides 0)))))))) (TP:Fault ScalarBroadcast)))
(= (tensor-program:apply $recipe $parameters $inputs)
   (case $recipe
     ((TP:Scan (tensor:scan-sum (car-atom $inputs) (car-atom $parameters)))
      (TP:Concatenate (tensor:concatenate (car-atom $inputs) (index-atom $inputs 1) (car-atom $parameters)))
      (TP:Permute (tensor:permute (car-atom $inputs) (car-atom $parameters)))
      (TP:Broadcast (tensor-program:broadcast (car-atom $inputs) (car-atom $parameters)))
      (TP:Matvec (tensor:matvec (car-atom $inputs) (index-atom $inputs 1) (car-atom $parameters)))
      (TP:BroadcastLike (tensor-program:broadcast (car-atom $inputs) (tensor:shape (index-atom $inputs 1))))
      (TP:Sum
       (let $total (tensor:sum (car-atom $inputs) (car-atom $parameters))
         (case $total
           (((Tensor:Fault $reason) $total)
            ($value (tensor:from-values f64 () ($value)))))))
      (TP:Gather (tensor:gather (car-atom $inputs) (tensor:cast (index-atom $inputs 1) index exact)))
      (TP:GatherRows (tensor:gather-rows (car-atom $inputs) (tensor:cast (index-atom $inputs 1) index exact)))
      ($other (tensor-program:zip $recipe $inputs)))))
(= (tensor-program:leaf $inputs $bytes)
   (case (binary-value:unpack $bytes)
     (((BinaryValue:Value (TP:Input $sort $index))
       (case (tensor-program:at $inputs $index)
         (((TP:Some $value)
           (if (tensor-program:value? $sort $value) (TP:Value $sort $value) (TP:Fault InputSort)))
          ($other (TP:Fault InputIndex)))))
      ((BinaryValue:Value (TP:Constant $sort $payload)) (tensor-program:decode-constant $sort $payload))
      ((BinaryValue:Value (TP:PackedConstant $sort $storage $payload))
       (tensor-program:decode-packed-constant $sort $storage $payload))
      ($other (TP:Fault Leaf)))))
(= (tensor-program:arguments $values)
   (if (== $values ()) (TP:Some ())
     (case (car-atom $values)
       (((TP:Value $sort $value)
         (case (tensor-program:arguments (cdr-atom $values))
           (((TP:Some $tail) (let $arguments (cons-atom $value $tail) (TP:Some $arguments))) ($other $other))))
        ($failure $failure)))))
(= (tensor-program:node-value $family $bytes $values)
   (case (tensor-program:arguments $values)
     (((TP:Some $inputs)
       (case (binary-value:unpack $bytes)
         (((BinaryValue:Value (TP:Apply $index $parameters))
           (case (tensor-program:operator $family $index)
             (((TP:Some (TP:Operator $name $sorts $output $recipe))
               (let $result (catch (tensor-program:apply $recipe $parameters $inputs))
                 (if (tensor-program:value? $output $result) (TP:Value $output $result) (TP:Fault Operation))))
              ($other (TP:Fault Operator))))) ($other (TP:Fault Application)))))
      ($failure $failure))))
(= (tensor-program:run $bytes $inputs)
   (if (== (get-metatype $inputs) Expression)
     (case (tensor-program:unpack $bytes)
       (((TP:Loaded $family $handle)
         (let* (($leaf (|-> ($payload) (tensor-program:leaf $inputs $payload)))
                ($node (|-> ($tag $children) (tensor-program:node-value $family $tag $children)))
                ($values (dag:fold-unique $handle $leaf $node))
                ($closed (dag:close $handle))) (TP:Outputs $values))) ($other $other)))
     (TP:Fault Inputs)))
