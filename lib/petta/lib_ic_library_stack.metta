; Joint source libraries reuse the framed source schema. A final document is
; stored once, with explicit newest-first single-helper decoder descriptors.
; Deserialization rechecks every layer and the finite dependency graph.
!(import! &self (library lib_ic_context_library))

(= (library-stack:schema)
   (union-atom (source-library:schema)
     ((Binary:Form 10 Library:Layer (Text Text))
      (Binary:Form 11 Library:StackArchive (Text (Vector (Record Library:Layer)) (Record Syntax:Document))))))
(= (library-stack:layers? $layers $seen)
   (if (== (get-metatype $layers) Expression)
     (if (== $layers ()) True
       (case (car-atom $layers)
         (((Library:Layer $codec $name)
           (and (or (== $codec "LC1") (== $codec "LC2"))
             (and (source-library:name? $name)
               (and (not (binary-schema:member? $name $seen))
                 (library-stack:layers? (cdr-atom $layers) (cons-atom $name $seen))))))
          ($invalid-layer False)))) False))
(= (library-stack:entries $layers $forms)
   (if (== $layers ()) (Library:Entries ())
     (if (== $forms ()) (Library:Refused MissingDefinition)
       (case ((car-atom $layers) (source-library:parse-clause (car-atom $forms))
              (library-stack:entries (cdr-atom $layers) (cdr-atom $forms)))
         ((((Library:Layer $codec $name) (IC:Some (Library:Clause $names $head $left $body $arity))
              (Library:Entries $later))
           (if (source-library:literal-symbol? $head $name)
             (Library:Entries (cons-atom (Library:Helper $name $body) $later))
             (Library:Refused DefinitionOrder)))
          ($invalid-definition (Library:Refused DefinitionOrder)))))))
(= (library-stack:depends-on-pending? $body $remaining)
   (if (== $remaining ()) False
     (case (car-atom $remaining)
       (((Library:Helper $name $other-body)
         (or (source-library:mentions? $name $body)
           (library-stack:depends-on-pending? $body (cdr-atom $remaining))))))))
(= (library-stack:ready $remaining)
   (filter-atom $remaining $entry
     (case $entry
       (((Library:Helper $name $body) (not (library-stack:depends-on-pending? $body $remaining)))))))
(= (library-stack:waves $remaining $fuel $done)
   (if (== $remaining ()) (Library:Waves $done)
     (if (== $fuel 0) (Library:Refused DependencyBound)
       (let $ready (library-stack:ready $remaining)
         (if (== $ready ()) (Library:Refused CyclicLibrary)
           (let* (($rest (filter-atom $remaining $entry (not (binary-schema:member? $entry $ready))))
                  ($next (union-atom $done (cons-atom $ready ()))))
             (library-stack:waves $rest (- $fuel 1) $next)))))))
(= (library-stack:valid? $layers $document)
   (if (and (source-codec:valid? $document)
         (and (>= (size-atom $layers) 2) (library-stack:layers? $layers ())))
     (case $document
       (((Syntax:Document $version $reader $forms)
         (if (source-library:current-reader? $reader)
           (case (library-stack:entries $layers $forms)
             (((Library:Entries $entries)
               (case (library-stack:waves $entries (size-atom $entries) ())
                 (((Library:Waves $waves) True) ($cyclic False)))) ($invalid False))) False))
        ($invalid-document False))) False))
(= (library-stack:restore $layers $document)
   (if (== $layers ()) (IC:Some $document)
     (case (car-atom $layers)
       (((Library:Layer $codec $name)
         (case (source-library:restore-codec $codec $name $document)
           (((IC:Some $before) (library-stack:restore (cdr-atom $layers) $before))
            ($invalid-step IC:None)))) ($invalid-layer IC:None)))))
(= (library-stack:unpack $payload)
   (case (binary-schema:decode (library-stack:schema) (Record Library:StackArchive) $payload)
     (((Binary:Value (Library:StackArchive "LM1" $layers $document))
       (if (library-stack:valid? $layers $document)
         (case (library-stack:restore $layers $document)
           (((IC:Some $original) (Library:StackValue $layers $document $original))
            ($invalid-reconstruction (Library:Refused Reconstruction))))
         (Library:Refused InvalidLayers)))
      ($invalid-record (Library:Refused InvalidArtifact)))))
(= (library-stack:decode $payload)
   (case (library-stack:unpack $payload)
     (((Library:StackValue $layers $document $original) (IC:Some $original)) ($invalid IC:None))))
(= (library-stack:pack $layers $document)
   (case (binary-schema:encode (library-stack:schema) (Record Library:StackArchive)
           (Library:StackArchive "LM1" $layers $document))
     (((Binary:TreeBytes $payload) (source-archive:envelope "LM1" $payload)) ($invalid IC:None))))
(= (library-stack:export $payload)
   (case (library-stack:unpack $payload)
     (((Library:StackValue $layers $document $original)
       (let $text (syntax:write $document)
         (if (== (syntax:read $text) $document)
           (Library:ExportMany $layers $document $text $original) (Library:Refused Unrenderable))))
      ($invalid $invalid))))

; Recover the fixed definition present at each decoder stage. This is private
; preparation data, not a second stored source or a new learned hypothesis.
(= (library-stack:stages $layers $document)
   (if (== $layers ()) (Library:Stages ())
     (case ($document (car-atom $layers))
       ((((Syntax:Document $version $reader $forms) (Library:Layer $codec $name))
         (if (== $forms ()) (Library:Refused MissingDefinition)
           (case (source-library:restore-codec $codec $name $document)
             (((IC:Some $before)
               (case (library-stack:stages (cdr-atom $layers) $before)
                 (((Library:Stages $later)
                   (let* (($definition (car-atom $forms))
                          ($stages (cons-atom (Library:Stage $codec $name $definition) $later)))
                     (Library:Stages $stages)))
                  ($failed $failed))))
              ($bad-expansion (Library:Refused Reconstruction))))))
        ($bad-stage (Library:Refused InvalidLayers))))))

; Metadata is parsed as data, not inferred from a source-name prefix.
(= (library-stack:view $artifact)
   (case (binary:unpack-fields $artifact)
     (((Binary:Fields ($version $codec $payload))
       (if (== $version (binary:utf8 "SIC1"))
         (if (== $codec (binary:utf8 "LM1")) (library-stack:unpack $payload)
           (if (or (== $codec (binary:utf8 "LC1")) (== $codec (binary:utf8 "LC2")))
             (case (ic:export-library $artifact)
               (((Library:Export $name $document $text $original)
                 (Library:StackValue ((Library:Layer (binary:from-utf8 $codec) $name)) $document $original))
                ($invalid $invalid)))
             (if (or (== $codec (binary:utf8 "ST1")) (== $codec (binary:utf8 "IC1")))
               (case (ic:library-unpack $artifact)
                 (((IC:Some $source) (Library:StackValue () $source $source))
                  ($invalid-source (Library:Refused InvalidArtifact))))
               (Library:Refused Codec)))) (Library:Refused Version)))
      ($invalid-envelope (Library:Refused InvalidArtifact)))))
(= (library-stack:extend $layers $current $candidate)
   (case (library-stack:view $candidate)
     (((Library:StackValue ((Library:Layer $codec $name)) $document $original)
       (if (== $original $current)
         (if (== $layers ()) (Library:Extended $candidate)
           (let $next (cons-atom (Library:Layer $codec $name) $layers)
             (if (library-stack:valid? $next $document)
               (let $bytes (library-stack:pack $next $document)
                 (if (binary-tree:bytes? $bytes) (Library:Extended $bytes) (Library:Refused Encoding)))
               (Library:Refused InvalidLayers)))) (Library:Refused Reconstruction)))
      ($invalid-candidate (Library:Refused Candidate)))))

(= (library-stack:prepare Entered $document) (ic:prepare-library $document))
(= (library-stack:prepare Deferred $document) (ic:prepare-library Deferred $document))
(= (library-stack:seed Entered $prepared $name $left $right)
   (source-library:seed $prepared $name $left $right))
(= (library-stack:seed Deferred $prepared $name $left $right)
   (context-library:seed $prepared $name $left $right))
(= (library-stack:site-count (Library:Prepared $document $archive $sites)) (size-atom $sites))
(= (library-stack:site-count (Library:DeferredPrepared $document $archive $sites)) (size-atom $sites))
(= (library-stack:prepared-document (Library:Prepared $document $archive $sites)) $document)
(= (library-stack:prepared-document (Library:DeferredPrepared $document $archive $sites)) $document)
(= (library-stack:prepared-mode? $mode $prepared)
   (case ($mode $prepared)
     (((Entered (Library:Prepared $document $archive $sites)) True)
      ((Deferred (Library:DeferredPrepared $document $archive $sites)) True) ($wrong-profile False))))
(= (library-stack:seeds? $pairs $count)
   (if (== (get-metatype $pairs) Expression)
     (if (== $pairs ()) True
       (case (car-atom $pairs)
         ((($left $right)
           (and (binary:unsigned? $left)
             (and (binary:unsigned? $right)
               (and (< $left $count)
                 (and (< $right $count) (library-stack:seeds? (cdr-atom $pairs) $count))))))
          ($invalid-pair False)))) False))
(= (library-stack:region? $region $count)
   (case $region
     ((Library:AllPairs True) ((Library:Seeds $pairs) (library-stack:seeds? $pairs $count))
      ($invalid-region False))))
(= (library-stack:produce-seeds $pairs)
   (if (== $pairs ()) (superpose ())
     (case (car-atom $pairs) ((($left $right) (IC:Proposal (Library:Seed $left $right)))))))
(= (library-stack:produce-seeds $pairs)
   (if (== $pairs ()) (superpose ()) (library-stack:produce-seeds (cdr-atom $pairs))))
(= (library-stack:producer Library:AllPairs $count) (source-library:pairs $count 0 1))
(= (library-stack:producer (Library:Seeds $pairs) $count) (library-stack:produce-seeds $pairs))
(= (ic-search:observation (Library:StackModel $mode $layers $prepared $name $region) $artifact)
   (case (library-stack:view $artifact)
     (((Library:StackValue $actual $document $original)
       (if (and (library-stack:prepared-mode? $mode $prepared)
             (and (== $layers $actual)
               (and (== $document (library-stack:prepared-document $prepared))
                 (and (source-library:name? $name) (not (source-library:mentions? $name $document))))))
         (if (library-stack:region? $region (library-stack:site-count $prepared))
           (IC:Some (Library:StackObservation $mode $layers $prepared $name $region $original)) IC:None)
         IC:None))
      ($invalid-artifact IC:None))))
(= (ic-search:consider (Library:StackModel $mode $layers $prepared $name $region) $original $best $candidate)
   (case (ic:library-check $original $best $candidate)
     (((IC:PackedAccepted $next $before $after) (IC:CandidateAccepted $next))
      ((IC:PackedRejected $reason) (IC:CandidateRejected $reason)))))
(= (ic-search:materialize (Library:StackModel $mode $layers $prepared $name $region) $original $proposal)
   (case $proposal
     (((Library:Seed $left $right)
       (case (library-stack:seed $mode $prepared $name $left $right)
         (((Library:Candidate $candidate $support)
           (case (library-stack:extend $layers (library-stack:prepared-document $prepared) $candidate)
             (((Library:Extended $bytes) (IC:Candidate $bytes))
              ((Library:Refused $reason) (IC:Refused $reason)))))
          ((Library:Refused $reason) (IC:Refused $reason)))))
      ($invalid-proposal (IC:ProducerFault InvalidLibraryProposal)))))
(= (library-stack:open $mode $layers $document $artifact $suffix $quantum $region)
   (let $name (str:concat "ic-learned:" $suffix)
     (if (and (source-library:name? $name) (not (source-library:mentions? $name $document)))
       (let* (($prepared (library-stack:prepare $mode $document))
              ($count (library-stack:site-count $prepared)))
         (if (binary:unsigned? $count)
           (if (library-stack:region? $region $count)
             (let* (($handle (work-new (library-stack:producer $region $count)))
                    ($model (Library:StackModel $mode $layers $prepared $name $region)))
             (case (ic:prepare $model $artifact ((context-space)) $quantum ((IC:Branch 0 $handle)))
               (((IC:PreparedSearch $state) (IC:PreparedSearch $state))
                ($failed (let $released (work-cancel $handle) $failed)))))
             (IC:SearchRefused InvalidLibraryRegion))
           (IC:SearchRefused InvalidLibraryTask))) (IC:SearchRefused InvalidLibraryName))))
(= (ic:continue-library $artifact $suffix $quantum)
   (ic:continue-library Entered $artifact $suffix $quantum))
(= (ic:continue-library $mode $artifact $suffix $quantum)
   (ic:continue-library $mode $artifact $suffix $quantum Library:AllPairs))
(= (ic:continue-library $mode $artifact $suffix $quantum $region)
   (if (and (binary-schema:text? $suffix) (or (== $mode Entered) (== $mode Deferred)))
     (case (library-stack:view $artifact)
       (((Library:StackValue $layers $document $original)
         (library-stack:open $mode $layers $document $artifact $suffix $quantum $region))
        ($invalid-task (IC:SearchRefused InvalidLibraryTask)))) (IC:SearchRefused InvalidLibraryName)))
