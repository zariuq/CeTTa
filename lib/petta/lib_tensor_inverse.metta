; Backward proposals along declared typed operator paths. A path has one
; unknown constant and known siblings in an ordinary tensor-program prefix.
; IEEE inverse formulas propose values; only forward original-task checking
; can accept a model. This is not complete enumeration of floating preimages.
!(import! &self (library lib_ic_numeric_program))

(= (tp-inverse:steps? $family $types $steps)
   (if (== (get-metatype $steps) Expression)
     (if (== $steps ()) True
       (case (car-atom $steps)
         (((TP:InverseUnary $index $parameters)
           (case (tensor-program:operator $family $index)
             (((TP:Some (TP:Operator $name ("F64Tensor") "F64Tensor" TP:Broadcast))
               (and (tensor-program:parameters? Shape $parameters)
                    (tp-inverse:steps? $family $types (cdr-atom $steps)))) ($other False))))
          ((TP:InverseBinary $index $parameters $slot $known)
           (case (tensor-program:operator $family $index)
             (((TP:Some (TP:Operator $name ("F64Tensor" "F64Tensor") "F64Tensor" $recipe))
               (and (== $parameters ())
                 (and (or (== $slot 0) (== $slot 1))
                   (and (== (tensor-program:at $types $known) (TP:Some "F64Tensor"))
                     (and (or (== $recipe TP:Add) (or (== $recipe TP:Subtract)
                              (or (== $recipe TP:Multiply) (or (== $recipe TP:Divide)
                                (and (== $recipe TP:BroadcastLike) (== $slot 0))))))
                       (tp-inverse:steps? $family $types (cdr-atom $steps))))))) ($other False))))
          ($other False)))) False))
(= (tp-inverse:paths? $family $types $paths)
   (if (== (get-metatype $paths) Expression)
     (if (== $paths ()) True
       (case (car-atom $paths)
         (((TP:InversePath $priority $steps)
           (and (binary:unsigned? $priority)
             (and (tp-inverse:steps? $family $types $steps)
                  (tp-inverse:paths? $family $types (cdr-atom $paths))))) ($other False)))) False))
(= (tensor-program:prepare-inverse $family $input-sorts $constants $paths)
   (case (tensor-program:prepare-region $family $input-sorts $constants () 0)
     (((TP:Region $checked $records $types $instructions $maximum)
       (if (tp-inverse:paths? $checked $types $paths) (TP:InverseRegion $checked $records $types $paths)
         (TP:Fault InversePaths))) ($other $other))))
(= (tensor-program:inverse-region? $region)
   (case $region
     (((TP:InverseRegion $family $records $types $paths)
       (if (== (get-metatype $records) Expression)
         (if (tensor-program:region? (TP:Region $family $records $types () 0))
           (tp-inverse:paths? $family $types $paths) False) False)) ($other False))))
(= (tp-inverse:admitted? $family $records $steps $priority)
   (if (== (get-metatype $records) Expression)
     (if (and (tensor-program:family? $family) (binary:unsigned? $priority))
       (case (tensor-program:check-records $family () $records)
         (((TP:Some $types) (tp-inverse:steps? $family $types $steps)) ($other False))) False) False))

(= (tp-inverse:continue $family $records $inputs $desired $mask $steps $frames $priority)
   (IC:Continue $priority (TP:InverseStep $family $records $inputs $desired $mask $steps $frames $priority)))
(= (tp-inverse:known $family $records $inputs $index)
   (case (tensor-program:pack $family (Dag:Forest ($index) $records))
     (((TP:Artifact $bytes)
       (case (tensor-program:run $bytes $inputs)
         (((TP:Outputs ((TP:Value "F64Tensor" $value))) (TP:Some $value)) ($other TP:None)))) ($other TP:None))))

; Two ready-value inputs per map reuse the ordinary lexical bulk compiler.
; Masked coordinates are made inert before arithmetic, not after overflow.
(= (tp-inverse:binary $recipe $slot $desired $known $mask)
   (let* (($wanted (tensor:zip-map f64 ($desired $mask) (|-> ($y $m) (if $m $y 0.0)) ()))
          ($fixed (tensor:zip-map f64 ($known $mask) (|-> ($x $m) (if $m $x 0.0)) ())))
     (let $projection
       (case $recipe
         ((TP:Add (|-> ($y $x) (- $y $x)))
          (TP:Subtract (if (== $slot 0) (|-> ($y $x) (+ $y $x)) (|-> ($y $x) (- $x $y))))
          (TP:Multiply (|-> ($y $x) (if (== $x 0.0) 0.0 (/ $y $x))))
          (TP:Divide (if (== $slot 0) (|-> ($y $x) (* $y $x))
                        (|-> ($y $x) (if (== $y 0.0) 1.0 (/ $x $y)))))))
       (let* (($answer (catch (tensor:zip-map f64 ($wanted $fixed) $projection ())))
              ($remaining
                (case $recipe
                  ((TP:Multiply
                    (tensor:zip-map bool ($mask $fixed) (|-> ($m $x) (and $m (not (== $x 0.0)))) ()))
                   (TP:Divide
                    (if (== $slot 1)
                      (tensor:zip-map bool ($mask $wanted) (|-> ($m $y) (and $m (not (== $y 0.0)))) ()) $mask))
                   ($other $mask)))))
         (if (tensor-program:value? "F64Tensor" $answer) (TP:Constraint $answer $remaining) TP:None)))))

(= (tp-inverse:wrap $family $records $root $frames)
   (if (== $frames ()) (TP:Blueprint $family (Dag:Forest ($root) $records))
     (case (car-atom $frames)
       (((TP:UnaryFrame $index $parameters)
         (let* (($node (tensor-program:node $index $parameters ($root)))
                ($next (union-atom $records ($node))))
           (tp-inverse:wrap $family $next (size-atom $records) (cdr-atom $frames))))
        ((TP:BinaryFrame $index $parameters $slot $known)
         (let* (($children (if (== $slot 0) ($root $known) ($known $root)))
                ($node (tensor-program:node $index $parameters $children))
                ($next (union-atom $records ($node))))
           (tp-inverse:wrap $family $next (size-atom $records) (cdr-atom $frames))))
        ($other (TP:Fault InverseFrame))))))
(= (tp-inverse:finish $original $family $records $desired $frames)
   (case (tensor-program:constant "F64Tensor" $desired)
     (((Binary:Leaf $bytes)
       (let $next (union-atom $records ((Binary:Leaf $bytes)))
         (ic-search:materialize IC:ArrayArchive $original
           (tp-inverse:wrap $family $next (size-atom $records) $frames))))
      ($other (IC:Refused InverseConstant)))))

(= (tp-inverse:start-samples $family $records $inputs $desired $mask $steps $frames $priority)
   (case ((tensor:entries $desired) (tensor:entries $mask))
     ((((TensorEntries $keys $values) (TensorEntries $mask-keys $masks))
       (IC:Continue $priority (TP:InverseSamples $family $records $inputs $values $masks
         $steps $frames $priority 0 () False))) ($other (IC:Refused InverseStorage)))))

(= (tp-inverse:advance $original $family $records $inputs $desired $mask $steps $frames $priority)
   (if (and (tensor-program:value? "F64Tensor" $desired) (tensor-program:value? "BoolTensor" $mask))
     (if (== (tensor:shape $desired) (tensor:shape $mask))
       (if (== $steps ()) (tp-inverse:finish $original $family $records $desired $frames)
         (case (car-atom $steps)
           (((TP:InverseBinary $index $parameters $slot $known-index)
             (case (tp-inverse:known $family $records $inputs $known-index)
               (((TP:Some $known)
                 (if (== (tensor:shape $known) (tensor:shape $desired))
                   (case (tensor-program:operator $family $index)
                     (((TP:Some (TP:Operator $name $sorts $output $recipe))
                       (if (== $recipe TP:BroadcastLike)
                         (let $next-frames (cons-atom (TP:BinaryFrame $index $parameters $slot $known-index) $frames)
                           (tp-inverse:start-samples $family $records $inputs $desired $mask
                             (cdr-atom $steps) $next-frames $priority))
                        (case (tp-inverse:binary $recipe $slot $desired $known $mask)
                         (((TP:Constraint $next-desired $next-mask)
                           (let $next-frames (cons-atom (TP:BinaryFrame $index $parameters $slot $known-index) $frames)
                             (tp-inverse:continue $family $records $inputs $next-desired $next-mask
                               (cdr-atom $steps) $next-frames $priority))) ($other (IC:Refused InverseArithmetic))))))
                      ($other (IC:Refused InverseOperator)))) (IC:Refused InverseShape))) ($other (IC:Refused InverseKnown)))))
            ((TP:InverseUnary $index ($shape))
             (if (== $shape (tensor:shape $desired))
               (let $next-frames (cons-atom (TP:UnaryFrame $index ($shape)) $frames)
                 (tp-inverse:start-samples $family $records $inputs $desired $mask (cdr-atom $steps) $next-frames $priority))
               (IC:Refused InverseShape))) ($other (IC:ProducerFault InverseStep)))))
       (IC:Refused InverseShape)) (IC:Refused InverseValues)))

; Samples are exact CTN1 scalar identities, never approximate hash keys.
; Repeated observations remain in the original task. Only duplicate parameter
; proposals within this one sampling cursor are suppressed.
(= (tp-inverse:samples $family $records $inputs $values $masks $steps $frames $priority $position $seen $had)
   (tp-inverse:scan $family $records $inputs $values $masks $steps $frames $priority $position $seen $had 64))
(= (tp-inverse:scan $family $records $inputs $values $masks $steps $frames $priority $position $seen $had $quantum)
   (if (== $quantum 0)
     (IC:Continue $priority (TP:InverseSamples $family $records $inputs $values $masks $steps $frames
       $priority $position $seen $had))
    (if (< $position (index-atom (tensor:shape $values) 0))
     (let (tensor:present $observed) (tensor:at $masks $position)
       (if $observed
         (let* (((tensor:present $number) (tensor:at $values $position))
                ($scalar (tensor:from-values f64 () ($number))) ($key (tensor:encode-bytes $scalar)))
           (if (ic-search:member? $key $seen)
             (tp-inverse:scan $family $records $inputs $values $masks $steps $frames
               $priority (+ $position 1) $seen True (- $quantum 1))
             (let $later-seen (cons-atom $key $seen)
               (IC:Responses
                 ((IC:Continue $priority (TP:InverseSamples $family $records $inputs $values $masks $steps $frames
                    $priority (+ $position 1) $later-seen True))
                  (IC:Continue $priority (TP:InverseStep $family $records $inputs $scalar
                    (tensor:from-values bool () (True)) $steps $frames $priority)))))))
         (tp-inverse:scan $family $records $inputs $values $masks $steps $frames
           $priority (+ $position 1) $seen $had (- $quantum 1))))
     (if $had (IC:Responses ())
       (tp-inverse:continue $family $records $inputs (tensor:from-values f64 () (0.0))
         (tensor:from-values bool () (False)) $steps $frames $priority)))))

(= (ic-search:observation IC:InverseArrays $bytes) (ic-arrays:observe $bytes))
(= (ic-search:consider IC:InverseArrays $original $best $candidate)
   (ic-search:consider IC:ArrayArchive $original $best $candidate))
(= (ic-search:materialize IC:InverseArrays $original $proposal)
   (case $proposal
     (((TP:InverseStep $family $records $inputs $desired $mask $steps $frames $priority)
       (if (tp-inverse:admitted? $family $records $steps $priority)
         (tp-inverse:advance $original $family $records $inputs $desired $mask $steps $frames $priority)
         (IC:ProducerFault InverseState)))
      ((TP:InverseSamples $family $records $inputs $values $masks $steps $frames $priority $position $seen $had)
       (if (tp-inverse:admitted? $family $records $steps $priority)
         (if (and (ic-parameters:vector? f64 $values) (ic-parameters:vector? bool $masks))
           (if (binary:unsigned? $position)
             (if (and (== (tensor:shape $values) (tensor:shape $masks))
                   (and (<= $position (index-atom (tensor:shape $values) 0))
                     (and (== (get-metatype $seen) Expression) (or (== $had True) (== $had False)))))
               (tp-inverse:samples $family $records $inputs $values $masks $steps $frames $priority $position $seen $had)
               (IC:ProducerFault InverseCursor)) (IC:ProducerFault InverseCursor))
           (IC:ProducerFault InverseCursor)) (IC:ProducerFault InverseState)))
      ((TP:Blueprint $family $forest) (ic-search:materialize IC:ArrayArchive $original $proposal))
      ($other (IC:ProducerFault InverseProposal)))))
(= (tp-inverse:branches $family $records $inputs $desired $mask $paths)
   (if (== $paths ()) ()
     (case (car-atom $paths)
       (((TP:InversePath $priority $steps)
         (let* (($proposal (TP:InverseStep $family $records $inputs $desired $mask $steps () $priority))
                ($handle (work-new (ic-search:from-list ((IC:Proposal $proposal)))))
                ($rest (tp-inverse:branches $family $records $inputs $desired $mask (cdr-atom $paths))))
           (cons-atom (IC:Branch $priority $handle) $rest)))))))
(= (tp-inverse:release $branches)
   (if (== $branches ()) ()
     (case (car-atom $branches)
       (((IC:Branch $priority $handle)
         (let $closed (work-cancel $handle) (tp-inverse:release (cdr-atom $branches))))))))
(= (ic:prepare-fit Numeric:InversePrograms $original $region $sources)
   (if (tensor-program:inverse-region? $region)
     (case ((ic-arrays:observe $original) $region)
       ((((IC:Some (Numeric:ArrayValues $values "F64Tensor" $mask $criterion $desired))
          (TP:InverseRegion $family $records $types $paths))
         (let* (($inputs (ic-arrays:raw-inputs $values))
                ($branches (tp-inverse:branches $family $records $inputs $desired $mask $paths))
                ($dependencies (cons-atom (context-space) $sources)))
           (case (ic:prepare IC:InverseArrays $original $dependencies 64 $branches)
             (((IC:PreparedSearch $state) (IC:PreparedSearch $state))
              ($other (let $closed (tp-inverse:release $branches) $other))))))
        ($other (IC:FitRefused InverseTask)))) (IC:FitRefused InverseRegion)))
(= (ic:fit Numeric:InversePrograms $original $region $sources $budget)
   (case (ic:prepare-fit Numeric:InversePrograms $original $region $sources)
     (((IC:PreparedSearch $state) (ic:resume $state $budget)) ($other $other))))
(= (ic:predict Numeric:InversePrograms $artifact $inputs) (ic:predict Numeric:Programs $artifact $inputs))
