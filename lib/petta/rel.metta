; Ordered bags of inert expression rows. Callbacks are pure, deterministic,
; single-valued functions, supplied as callable symbols. No scalar coercion or
; NULL/equality policy is imposed here; those belong to caller adapters.
!(import! &self (library list))

; Truth arguments are values, not short-circuit computations.
(= (rel:not $a)
   (if (rel-i:truth-value? $a) (rel-i:not-known $a)
       (Error rel:not (RelExpectedTruth $a))))
(= (rel-i:truth-value? $a)
   (if (== (get-metatype $a) Symbol)
       (or (== $a RelTrue) (or (== $a RelFalse) (== $a RelUnknown))) False))
(= (rel-i:not-known $a)
   (case $a ((RelTrue RelFalse) (RelFalse RelTrue) (RelUnknown RelUnknown)
     ($bad (Error rel:not (RelExpectedTruth $bad))))))
(= (rel:and $a $b)
   (if (and (rel-i:truth-value? $a) (rel-i:truth-value? $b)) (rel-i:and-known $a $b)
       (Error rel:and (RelExpectedTruthPair (cons-atom $a (cons-atom $b ()))))))
(= (rel-i:and-known $a $b)
   (case (cons-atom $a (cons-atom $b ()))
     (((RelTrue RelTrue) RelTrue) ((RelTrue RelFalse) RelFalse)
      ((RelTrue RelUnknown) RelUnknown) ((RelFalse RelTrue) RelFalse)
      ((RelFalse RelFalse) RelFalse) ((RelFalse RelUnknown) RelFalse)
      ((RelUnknown RelTrue) RelUnknown) ((RelUnknown RelFalse) RelFalse)
      ((RelUnknown RelUnknown) RelUnknown)
      ($bad (Error rel:and (RelExpectedTruthPair $bad))))))
(= (rel:or $a $b)
   (if (and (rel-i:truth-value? $a) (rel-i:truth-value? $b)) (rel-i:or-known $a $b)
       (Error rel:or (RelExpectedTruthPair (cons-atom $a (cons-atom $b ()))))))
(= (rel-i:or-known $a $b)
   (case (cons-atom $a (cons-atom $b ()))
     (((RelTrue RelTrue) RelTrue) ((RelTrue RelFalse) RelTrue)
      ((RelTrue RelUnknown) RelTrue) ((RelFalse RelTrue) RelTrue)
      ((RelFalse RelFalse) RelFalse) ((RelFalse RelUnknown) RelUnknown)
      ((RelUnknown RelTrue) RelTrue) ((RelUnknown RelFalse) RelUnknown)
      ((RelUnknown RelUnknown) RelUnknown)
      ($bad (Error rel:or (RelExpectedTruthPair $bad))))))

; PeTTa runtime dispatch can turn a raised callback error into zero answers.
; Collect the complete bag, never a capped prefix, and require exactly one.
; The carrier distinguishes invocation failure from ordinary callback values,
; including an inert (Error source reason) row, key or accumulator. Returned
; values still must satisfy the truth/Bool contracts where those are required.
(= (rel-i:one $callback $answers)
   (if (== (size-atom $answers) 1)
     (let $value (car-atom $answers) (RelOk $value))
     (Error (RelCallback $callback) (RelCallbackAnswers $answers))))
(= (rel-i:call1 $callback $row)
   (let $answers (collapse ($callback $row)) (rel-i:one $callback $answers)))
(= (rel-i:call2 $callback $left $right)
   (let $answers (collapse ($callback $left $right)) (rel-i:one $callback $answers)))
(= (rel-i:truth $result)
   (case $result
     (((Error $source $reason) (Error $source $reason))
      ((RelOk $value)
        (if (rel-i:truth-value? $value) $value
            (Error RelPredicate (RelExpectedTruth $value)))))))
(= (rel-i:bool $result)
   (case $result
     (((Error $source $reason) (Error $source $reason))
      ((RelOk $value)
        (if (== (get-metatype $value) Variable)
            (Error RelComparison (RelExpectedBool $value))
            (case $value ((True True) (False False)
              ($bad (Error RelComparison (RelExpectedBool $bad))))))))))
(= (rel-i:cons $head $tail)
   (case $tail (((Error $source $reason) (Error $source $reason))
     ((RelOk $rows) (let $next (cons-atom $head $rows) (RelOk $next))))))
(= (rel-i:append $left $right)
   (case $left (((Error $source $reason) (Error $source $reason))
     ((RelOk $rows) (case $right (((Error $source $reason) (Error $source $reason))
       ((RelOk $rest) (let $next (list:append $rows $rest) (RelOk $next)))))))))
(= (rel-i:publish $result)
   (case $result (((Error $source $reason) (Error $source $reason))
     ((RelOk $value) $value))))

(= (rel:select $predicate $rows)
   (rel-i:publish (rel-i:select $predicate $rows)))
(= (rel-i:select $predicate $rows)
   (if (== $rows ()) (RelOk ())
     (let ($head $tail) (decons-atom $rows)
       (let $answer (rel-i:call1 $predicate $head)
         (case (rel-i:truth $answer)
           ((RelTrue (let $rest (rel-i:select $predicate $tail) (rel-i:cons $head $rest)))
            (RelFalse (rel-i:select $predicate $tail))
            (RelUnknown (rel-i:select $predicate $tail))
            ($fault $fault)))))))
(= (rel:project $projection $rows)
   (rel-i:publish (rel-i:project $projection $rows)))
(= (rel-i:project $projection $rows)
   (if (== $rows ()) (RelOk ())
     (let ($head $tail) (decons-atom $rows)
       (case (rel-i:call1 $projection $head)
         (((Error $source $reason) (Error $source $reason))
          ((RelOk $value) (let $rest (rel-i:project $projection $tail) (rel-i:cons $value $rest))))))))
(= (rel:union-all $left $right) (list:append $left $right))

(= (rel:inner-join $predicate $projection $left $right)
   (rel-i:publish (rel-i:inner-join $predicate $projection $left $right)))

; Optional matching supplies an explicit caller-selected absence value to
; the projection. A returned empty tuple is an ordinary row, not no answer.
(= (rel:left-join $predicate $projection $missing $left $right)
   (rel-i:publish (rel-i:left-join $predicate $projection $missing $left $right)))
(= (rel-i:left-join $predicate $projection $missing $left $right)
   (if (== $left ()) (RelOk ())
     (let ($head $tail) (decons-atom $left)
       (case (rel-i:join-row $predicate $projection $head $right)
         (((Error $source $reason) (Error $source $reason))
          ((RelOk $block)
           (let $rows (if (== $block ())
                          (case (rel-i:call2 $projection $head $missing)
                            (((RelOk $row) (RelOk (cons-atom $row ()))) ($fault $fault)))
                          (RelOk $block))
             (rel-i:append $rows (rel-i:left-join $predicate $projection $missing $tail $right)))))))))
(= (rel-i:inner-join $predicate $projection $left $right)
   (if (== $left ()) (RelOk ())
     (let ($head $tail) (decons-atom $left)
       (case (rel-i:join-row $predicate $projection $head $right)
         (((Error $source $reason) (Error $source $reason))
          ((RelOk $block) (let $rest (rel-i:inner-join $predicate $projection $tail $right)
                    (rel-i:append (RelOk $block) $rest))))))))
(= (rel-i:join-row $predicate $projection $left $right)
   (if (== $right ()) (RelOk ())
     (let ($head $tail) (decons-atom $right)
       (let $answer (rel-i:call2 $predicate $left $head)
         (case (rel-i:truth $answer)
           ((RelTrue
              (case (rel-i:call2 $projection $left $head)
                (((Error $source $reason) (Error $source $reason))
                 ((RelOk $value) (let $rest (rel-i:join-row $predicate $projection $left $tail)
                           (rel-i:cons $value $rest))))))
            (RelFalse (rel-i:join-row $predicate $projection $left $tail))
            (RelUnknown (rel-i:join-row $predicate $projection $left $tail))
            ($fault $fault)))))))

(= (rel:exists $predicate $rows)
   (if (== $rows ()) RelFalse
     (let ($head $tail) (decons-atom $rows)
       (let $answer (rel-i:call1 $predicate $head)
         (case (rel-i:truth $answer)
           ((RelTrue RelTrue) (RelFalse (rel:exists $predicate $tail))
            (RelUnknown (rel:exists $predicate $tail)) ($fault $fault)))))))
(= (rel-i:matches $predicate $left $right)
   (if (== $right ()) RelFalse
     (let ($head $tail) (decons-atom $right)
       (let $answer (rel-i:call2 $predicate $left $head)
         (case (rel-i:truth $answer)
           ((RelTrue RelTrue) (RelFalse (rel-i:matches $predicate $left $tail))
            (RelUnknown (rel-i:matches $predicate $left $tail)) ($fault $fault)))))))
(= (rel:semi-join $predicate $left $right)
   (rel-i:publish (rel-i:exist-join RelTrue $predicate $left $right)))
(= (rel:anti-join $predicate $left $right)
   (rel-i:publish (rel-i:exist-join RelFalse $predicate $left $right)))
(= (rel-i:exist-join $keep $predicate $left $right)
   (if (== $left ()) (RelOk ())
     (let ($head $tail) (decons-atom $left)
       (case (rel-i:matches $predicate $head $right)
         (((Error $source $reason) (Error $source $reason))
          ($matched (let $rest (rel-i:exist-join $keep $predicate $tail $right)
                      (if (== $matched $keep) (rel-i:cons $head $rest) $rest))))))))

; Compare with retained representatives only; first representative wins.
(= (rel:distinct $equivalent $rows)
   (rel-i:publish (rel-i:distinct $equivalent $rows ())))
(= (rel-i:member $equivalent $row $seen)
   (if (== $seen ()) False
     (let ($head $tail) (decons-atom $seen)
       (let $answer (rel-i:call2 $equivalent $head $row)
         (case (rel-i:bool $answer)
           ((True True) (False (rel-i:member $equivalent $row $tail)) ($fault $fault)))))))
(= (rel-i:distinct $equivalent $rows $seen)
   (if (== $rows ()) (RelOk ())
     (let ($head $tail) (decons-atom $rows)
       (case (rel-i:member $equivalent $head $seen)
         ((True (rel-i:distinct $equivalent $tail $seen))
          (False (let* (($next (list:push $seen $head))
                        ($rest (rel-i:distinct $equivalent $tail $next)))
                   (rel-i:cons $head $rest)))
          ($fault $fault))))))

; Stable merge: take the right only if it strictly precedes the left.
(= (rel:order $less $rows)
   (rel-i:publish (rel-i:order $less $rows)))
(= (rel-i:order $less $rows)
   (if (<= (size-atom $rows) 1) (RelOk $rows)
     (let ($left $right) (list:split-half $rows)
       (case (rel-i:order $less $left)
         (((Error $source $reason) (Error $source $reason))
          ((RelOk $sorted-left) (case (rel-i:order $less $right)
            (((Error $source $reason) (Error $source $reason))
             ((RelOk $sorted-right) (rel-i:merge $less $sorted-left $sorted-right))))))))))
(= (rel-i:merge $less $left $right)
   (if (== $left ()) (RelOk $right)
     (if (== $right ()) (RelOk $left)
       (let* ((($lh $lt) (decons-atom $left)) (($rh $rt) (decons-atom $right))
              ($answer (rel-i:call2 $less $rh $lh)))
         (case (rel-i:bool $answer)
           ((True (let $rest (rel-i:merge $less $left $rt) (rel-i:cons $rh $rest)))
            (False (let $rest (rel-i:merge $less $lt $right) (rel-i:cons $lh $rest)))
            ($fault $fault)))))))
(= (rel:page $offset $count $rows)
   (let $suffix (list:drop $offset $rows) (list:take $count $suffix)))

; Pure values: each newly introduced group starts from the same independent
; initial value. Update exactly one group, without reordering any group.
(= (rel:group-fold $key $equivalent $initial $step $rows)
   (rel-i:publish (rel-i:groups $key $equivalent $initial $step $rows ())))
(= (rel-i:groups $key $equivalent $initial $step $rows $groups)
   (if (== $rows ()) (RelOk $groups)
     (let ($head $tail) (decons-atom $rows)
       (case (rel-i:call1 $key $head)
         (((Error $source $reason) (Error $source $reason))
          ((RelOk $value) (case (rel-i:update $equivalent $initial $step $value $head $groups)
            (((Error $source $reason) (Error $source $reason))
             ((RelOk $next) (rel-i:groups $key $equivalent $initial $step $tail $next))))))))))
(= (rel-i:update $equivalent $initial $step $key $row $groups)
   (if (== $groups ())
     (case (rel-i:call2 $step $initial $row)
       (((Error $source $reason) (Error $source $reason))
        ((RelOk $value) (RelOk ((RelGroup $key $value))))))
     (let* ((($head $tail) (decons-atom $groups))
            ((RelGroup $representative $acc) $head)
            ($answer (rel-i:call2 $equivalent $representative $key)))
       (case (rel-i:bool $answer)
         ((True (case (rel-i:call2 $step $acc $row)
                  (((Error $source $reason) (Error $source $reason))
                   ((RelOk $value) (let $next (cons-atom (RelGroup $representative $value) $tail)
                                    (RelOk $next))))))
          (False (let $rest (rel-i:update $equivalent $initial $step $key $row $tail)
                   (rel-i:cons $head $rest)))
          ($fault $fault))))))
(= (rel:running-fold $initial $step $rows)
   (rel-i:publish (rel-i:running-fold $initial $step $rows)))
(= (rel-i:running-fold $initial $step $rows)
   (if (== $rows ()) (RelOk ())
     (let ($head $tail) (decons-atom $rows)
       (case (rel-i:call2 $step $initial $head)
         (((Error $source $reason) (Error $source $reason))
          ((RelOk $next) (let $rest (rel-i:running-fold $next $step $tail)
                   (rel-i:cons $next $rest))))))))
