; Stored-scalar range candidates, followed by the existing owning matcher.
; The underlying full Space count is never replaced by a guessed range count.
!(import! &self "durable_query.metta")

(: kbq:begin-range (-> Atom Atom Atom Atom Atom Atom Atom Atom Number %Undefined%))
(= (kbq:begin-range $source $collection $arity $position $lower $upper $pattern $template $maximum)
  (if (and (durable-index:dimensions? $arity $position) (range-i:atomic? $pattern))
    (case $source
      (((KqSpaceViewV1 $view)
        (case (store:integer-window $lower $upper)
          ((StoreIntegerWindowEmptyV1 (range-i:open $view $collection $arity $position $lower $upper $pattern $template $maximum StoreIntegerWindowEmptyV1))
           ((StoreIntegerWindowV1 $first $last) (range-i:open $view $collection $arity $position $lower $upper $pattern $template $maximum (StoreIntegerWindowV1 $first $last)))
           ($failure $failure))))
       ($other (KbRefused ordinary-space-source-required))))
    (KbRefused scalar-range-plan)))
(: range-i:atomic? (-> Atom Bool))
(= (range-i:atomic? $pattern)
  (if (== (get-metatype $pattern) Expression)
    (if (> (size-atom $pattern) 0)
      (let (AtomDataV1 $head) (atom-data:item $pattern 0)
        (not (or (== $head ,) (== $head |)))) True) True))

; Reader validation admits historical V2 facts only as a complete scan.
(= (range-i:metadata $view $collection)
  (let* (((KnowledgeAddressV1 $metadata) (durable-space:metadata $collection))
         ((KnowledgeAddressV1 $prefix) (durable-space:prefix $collection)))
    (case (store:get $view $metadata 1048576)
      (((StoreValue $body)
        (case (store:decode $body)
          (((StoreDecoded $record)
            (case $record
              (((StoreSpaceV1 $stored $count) (range-i:fields $collection $prefix $stored $count () False ScanOnlyV1))
               ((StoreSpaceV2 $stored $count $indexes) (range-i:fields $collection $prefix $stored $count $indexes False ScanOnlyV1))
               ((StoreSpaceV3 $stored $count $indexes) (range-i:fields $collection $prefix $stored $count $indexes False ScanOnlyV1))
               ((StoreSpaceV4 $stored $count $indexes) (range-i:fields $collection $prefix $stored $count $indexes True RangeIndexesV1))
               ($bad (SpaceRefusedV1 metadata-format)))))
           ($failure $failure))))
       (StoreAbsent (SpaceRefusedV1 collection-absent))
       ($failure $failure)))))
(= (range-i:fields $collection $prefix $stored $count $indexes $ranges $mode)
  (case (durable-space:state-version $collection $prefix $stored $count $indexes $ranges)
    (((SpaceStateV1 $same $declared) (RangeMetadataV1 $prefix $same $declared $mode))
     ($failure $failure))))
(= (range-i:find-index $indexes $arity $position)
  (if (== $indexes ()) NoRangeIndexV1
    (let $index (car-atom $indexes)
      (if (knowledge:tagged? $index StoreSpaceRangeIndexV1 4)
        (let (StoreSpaceRangeIndexV1 $a $p $prefix) $index
          (if (and (== $a $arity) (== $p $position)) $index
            (range-i:find-index (cdr-atom $indexes) $arity $position)))
        (range-i:find-index (cdr-atom $indexes) $arity $position)))))
(= (range-i:open $view $collection $arity $position $lower $upper $pattern $template $maximum $window)
  (case (range-i:metadata $view $collection)
    (((RangeMetadataV1 $prefix $count $indexes $mode)
      (let* (($index (if (== $mode RangeIndexesV1) (range-i:find-index $indexes $arity $position) NoRangeIndexV1))
             ($config (RangeConfigV1 $view $collection $prefix $arity $position $lower $upper $pattern $template $maximum $index))
             ($sources (range-i:sources $index $window)))
        (KqReady (KqRangeStateV1 $config $sources RangeIdleV1 RangeIdleV1))))
     ($failure $failure))))
(= (range-i:sources $index $window)
  (if (== $index NoRangeIndexV1) (RangeFullV1)
    (let* (((StoreSpaceRangeIndexV1 $arity $position $prefix) $index)
           ($other (str:concat $prefix "/other/"))
           ($rest ((RangePostingV1 $other $other NoBound (str:byte-length $other)))))
      (case $window
        ((StoreIntegerWindowEmptyV1 $rest)
         ((StoreIntegerWindowV1 $first $last)
          (let* (($bucket (str:concat $prefix "/i64/"))
                 ($from (str:concat $bucket $first))
                 ($until (if (== $last NoBound) NoBound (str:concat $bucket $last)))
                 ($offset (+ (str:byte-length $bucket) 9)))
            (cons-atom (RangePostingV1 $bucket $from $until $offset) $rest))))))))

(= (range-i:close-source $source)
  (case $source
    ((RangeIdleV1 KqClosed)
     ((RangeFullStateV1 $state) (kbq:close-state $state))
     ((RangePostingStateV1 $scan $bucket $offset $position) (store:close $scan))
     ($bad KqClosed))))
(= (range-i:close (KqRangeStateV1 $config $pending $source $point))
  (let* (($_ (range-i:close-source $source))
         ($_ (if (== $point RangeIdleV1) KqClosed (kbq:close-state $point)))) KqClosed))
(= (range-i:fail $state $failure $keys $bytes)
  (let $_ (range-i:close $state) (KqFail $failure $keys $bytes)))

(= (range-i:advance (KqRangeStateV1 $config $pending $source $point))
  (let $state (KqRangeStateV1 $config $pending $source $point)
    (if (not (== $point RangeIdleV1))
      (case (kbq:advance $point)
        (((KqOut $row $next $k $b) (KqOut $row (KqRangeStateV1 $config $pending $source $next) $k $b))
         ((KqSkip $next $k $b) (KqSkip (KqRangeStateV1 $config $pending $source $next) $k $b))
         ((KqEnd $k $b) (KqSkip (KqRangeStateV1 $config $pending $source RangeIdleV1) $k $b))
         ((KqFail $failure $k $b) (range-i:fail $state $failure $k $b))))
      (if (== $source RangeIdleV1)
        (if (== $pending ()) (KqEnd 0 0) (range-i:start $state))
        (range-i:candidate $state)))))
(= (range-i:start (KqRangeStateV1 $config $pending $unused $point))
  (let* (((RangeConfigV1 $view $collection $prefix $arity $position $lo $hi $pattern $template $maximum $index) $config)
         ($rest (cdr-atom $pending)))
    (case (car-atom $pending)
      ((RangeFullV1
        (case (durable-space:cursor $view $collection $original $original)
          (((StoreQueryOpened $query $epoch $revision)
            (KqSkip (KqRangeStateV1 $config $rest (RangeFullStateV1 (KqSpaceStateV1 $query 0 1048576 0 0)) RangeIdleV1) 0 0))
           ($failure (KqFail $failure 0 0)))))
       ((RangePostingV1 $bucket $lower $upper $offset)
        (case (store:scan-open $view $lower $upper)
          (((StoreScan $scan) (KqSkip (KqRangeStateV1 $config $rest (RangePostingStateV1 $scan $bucket $offset 0) RangeIdleV1) 0 0))
           ($failure (KqFail $failure 0 0)))))
       ($bad (KqFail (KbRefused scalar-range-state) 0 0))))))
(= (range-i:candidate (KqRangeStateV1 $config $pending $source $point))
  (let $state (KqRangeStateV1 $config $pending $source $point)
    (case $source
      (((RangeFullStateV1 $inner)
        (case (kbq:advance $inner)
          (((KqOut (SpaceAnswerV1 $atom ($reference)) $next $k $b)
            (let* (((StoreOccurrenceV1 $epoch $key) $reference)
                   ($resume (KqRangeStateV1 $config $pending (RangeFullStateV1 $next) RangeIdleV1)))
              (range-i:consider $resume $key $atom NoPostingV1 $k $b)))
           ((KqSkip $next $k $b) (KqSkip (KqRangeStateV1 $config $pending (RangeFullStateV1 $next) RangeIdleV1) $k $b))
           ((KqEnd $k $b) (KqSkip (KqRangeStateV1 $config $pending RangeIdleV1 RangeIdleV1) $k $b))
           ((KqFail $failure $k $b) (range-i:fail $state $failure $k $b)))))
       ((RangePostingStateV1 $scan $bucket $offset $position)
        (case (store:scan-next $scan $position)
          ((StoreEnd (range-i:source-end $state))
           ((StoreKey $posting $length $next)
            (if (str:starts-with $posting $bucket)
              (if (and (== $length 0) (> (str:byte-length $posting) $offset))
                (let* (($key (str:byte-slice $posting $offset (str:byte-length $posting)))
                       ($resume (KqRangeStateV1 $config $pending (RangePostingStateV1 $scan $bucket $offset $next) RangeIdleV1)))
                  (range-i:fetch $resume $key $posting))
                (range-i:fail $state (KbRefused range-posting-format) 1 0))
              (range-i:source-end $state)))
           ($failure (range-i:fail $state $failure 0 0)))))
       ($bad (range-i:fail $state (KbRefused scalar-range-state) 0 0))))))
(= (range-i:source-end (KqRangeStateV1 $config $pending $source $point))
  (let $_ (range-i:close-source $source)
    (KqSkip (KqRangeStateV1 $config $pending RangeIdleV1 $point) 0 0)))
(= (range-i:fetch (KqRangeStateV1 $config $pending $source $point) $key $posting)
  (let* (($state (KqRangeStateV1 $config $pending $source $point))
         ((RangeConfigV1 $view $collection $prefix $arity $position $lo $hi $pattern $template $maximum $index) $config))
    (if (str:starts-with $key $prefix)
      (case (store:get $view $key 1048576)
        (((StoreValue $body)
          (case (store:decode $body)
            (((StoreDecoded $atom) (range-i:consider $state $key $atom $posting 1 (str:byte-length $body)))
             ($failure (range-i:fail $state $failure 1 (str:byte-length $body))))))
         (StoreAbsent (range-i:fail $state (KbRefused range-missing-occurrence) 1 0))
         ($failure (range-i:fail $state $failure 1 0))))
      (range-i:fail $state (KbRefused range-occurrence-domain) 1 0))))

(: range-i:consider (-> Atom String Atom Atom Number Number %Undefined%))
(= (range-i:consider (KqRangeStateV1 $config $pending $source $point) $key $atom $posting $keys $bytes)
  (let* (($state (KqRangeStateV1 $config $pending $source $point))
         ((RangeConfigV1 $view $collection $prefix $arity $position $lower $upper $pattern $template $maximum $index) $config))
    (if (== $posting NoPostingV1)
      (range-i:filter $state $key $atom $keys $bytes)
      (case (durable-index:range-one $index $key $atom)
        (((SpaceIndexPostingV1 $expected)
          (if (== $posting $expected) (range-i:filter $state $key $atom $keys $bytes)
            (range-i:fail $state (KbRefused range-posting-value) $keys $bytes)))
         ($bad (range-i:fail $state (KbRefused range-posting-value) $keys $bytes)))))))
(: range-i:filter (-> Atom String Atom Number Number %Undefined%))
(= (range-i:filter (KqRangeStateV1 $config $pending $source $point) $key $atom $keys $bytes)
  (let* (($state (KqRangeStateV1 $config $pending $source $point))
         ((RangeConfigV1 $view $collection $prefix $arity $position $lower $upper $pattern $template $maximum $index) $config))
    (case (durable-index:project $atom $arity $position)
      (((SpaceIndexFieldV1 $field)
        (case (store:scalar-range $field $lower $upper)
          ((StoreScalarWithinV1
            (case (store:space-point-query-open $view $key $pattern $template)
              (((StoreQueryOpened $query $epoch $revision)
                (KqSkip (KqRangeStateV1 $config $pending $source (KqSpaceStateV1 $query 0 $maximum 0 0)) $keys $bytes))
               ($failure (range-i:fail $state $failure $keys $bytes)))))
           (StoreScalarOutsideV1 (KqSkip $state $keys $bytes))
           ($failure (range-i:fail $state $failure $keys $bytes)))))
       ($outside (KqSkip $state $keys $bytes))))))

(: range-i:inspect (-> Atom Atom Atom %Undefined%))
(: range-i:source-info (-> Atom %Undefined%))
(= (range-i:inspect $config $source $point)
  ; Inspect only public data fields. Patterns/templates and owning native
  ; references are not part of the explanation packet.
  (let* (((AtomDataV1 $collection) (atom-data:item $config 2))
         ((AtomDataV1 $arity) (atom-data:item $config 4))
         ((AtomDataV1 $position) (atom-data:item $config 5))
         ((AtomDataV1 $lower) (atom-data:item $config 6))
         ((AtomDataV1 $upper) (atom-data:item $config 7))
         ((AtomDataV1 $index) (atom-data:item $config 11)))
    (KqRangeAccessV1 $collection $arity $position $lower $upper
      (if (== $index NoRangeIndexV1) CompleteScanV1 IntegerSeekAndOtherScalarFallbackV1)
      (range-i:source-info $source)
      (range-i:point-info $point))))
(= (range-i:source-info $source)
  (case $source
    ((RangeIdleV1 NoActiveRangeSourceV1)
     ((RangeFullStateV1 $inner) (range-i:point-info $inner))
     ((RangePostingStateV1 $scan $bucket $offset $position) (RangePostingAccessV1 $bucket $position))
     ($bad (KbRefused scalar-range-state)))))
(= (range-i:point-info $point)
  (case $point
    ((RangeIdleV1 NoActivePointV1)
     ((KqSpaceStateV1 $query $sequence $maximum $keys $bytes) (store:space-query-info $query))
     ($bad (KbRefused scalar-range-state)))))
