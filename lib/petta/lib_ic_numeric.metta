; Finite affine model discovery using the shared owned candidate search.
; NC1 includes inputs, mask, precision and either raw outputs or parameters.
; All fields needed by this decoder are charged by the common BV1 framing.
!(import! &self (library lib_ic_parameters))
!(import! &self (library lib_binary_value))
!(import! &self (library lib_ic_packed))
!(import! &self (library lib_tensor_program))
!(import! &self (library lib_ic_numeric_values))
!(import! &self (library lib_ic_numeric_arrays))

(= (ic-numeric:encode $value) (tensor:encode-bytes (tensor:convert $value dense)))

(= (ic-numeric:affine $scale $offset $input) (+ (* $scale $input) $offset))

(= (ic-numeric:compatible? $inputs $outputs $mask $tolerance)
   (if (and (ic-parameters:vector? f64 $inputs)
         (and (ic-parameters:vector? f64 $outputs)
           (and (ic-parameters:vector? bool $mask) (ic-parameters:vector? f64 $tolerance))))
     (if (and (== (tensor:shape $inputs) (tensor:shape $outputs))
           (and (== (tensor:shape $inputs) (tensor:shape $mask)) (== (tensor:shape $tolerance) (1))))
       (let (tensor:present $value) (tensor:at $tolerance 0) (>= $value 0.0)) False)
     False))

(= (ic:prepare-numeric $inputs $outputs $mask $tolerance)
   (case $inputs
     (((Numeric:Inputs $items) (ic-arrays:prepare $items $outputs $mask $tolerance))
      ($other (ic-numeric:prepare-vector $other $outputs $mask $tolerance)))))
(= (ic-numeric:prepare-vector $inputs $outputs $mask $tolerance)
   (let $precision (tensor:from-values f64 (1) ($tolerance))
     (if (ic-numeric:compatible? $inputs $outputs $mask $precision)
       (case (binary-value:pack
         (Numeric:Archive "NC1" (ic-numeric:encode $inputs) (ic-numeric:encode (tensor:cast $mask u8 exact))
           (ic-numeric:encode $precision) (Numeric:Raw (ic-numeric:encode $outputs))))
         (((Binary:TreeBytes $bytes) (IC:NumericArtifact $bytes))
          ($other (IC:NumericFault Codec))))
       (IC:NumericFault InvalidObservation))))

(= (ic-numeric:predicted $inputs $body)
   (case $body
     (((Numeric:Raw $bytes) (tensor:decode-bytes $bytes))
      ((Numeric:Program $bytes)
       (case (tensor-program:run $bytes ($inputs))
         (((TP:Outputs ((TP:Value "F64Tensor" $value))) $value)
          ($other (IC:NumericFault Program)))))
      ((Numeric:Affine $bytes)
        (let $parameters (tensor:decode-bytes $bytes)
          (if (ic-parameters:vector? f64 $parameters)
            (if (== (tensor:shape $parameters) (2))
              (let* (((tensor:present $scale) (tensor:at $parameters 0))
                     ((tensor:present $offset) (tensor:at $parameters 1)))
                ; Arithmetic can raise on overflow or produce a nonfinite
                ; value. Both decline the subsequent finite-tensor check.
                (catch (tensor:zip-map f64 ($inputs) ic-numeric:affine ($scale $offset))))
              (IC:NumericFault ParameterCount))
            (IC:NumericFault Parameters))))
      ($other (IC:NumericFault Body)))))

(= (ic-numeric:observe $bytes)
   (case (binary-value:unpack $bytes)
     (((BinaryValue:Value (Numeric:Archive "NC1" $input-bytes $mask-bytes $precision-bytes $body))
       (let* (($inputs (tensor:decode-bytes $input-bytes))
              ($mask (tensor:cast (tensor:decode-bytes $mask-bytes) bool exact))
              ($precision (tensor:decode-bytes $precision-bytes)))
         (if (ic-parameters:vector? f64 $inputs)
           (let $outputs (ic-numeric:predicted $inputs $body)
             (if (ic-numeric:compatible? $inputs $outputs $mask $precision)
               (IC:Some (Numeric:Values $inputs $mask $precision $outputs)) IC:None)) IC:None)))
      ($other IC:None))))

(= (ic-packed:observe IC:NumericArchive $bytes) (ic-numeric:observe $bytes))
(= (ic-packed:accepts? IC:NumericArchive $source $candidate)
   (case ($source $candidate)
     ((((Numeric:Values $inputs $mask $precision $original)
        (Numeric:Values $other-inputs $other-mask $other-precision $result))
       (if (and (== $inputs $other-inputs)
                (and (== $mask $other-mask) (== $precision $other-precision)))
         (let* (((tensor:present $tolerance) (tensor:at $precision 0))
                ($decisions (tensor:zip-map bool ($mask $original $result) ic-numeric:near ($tolerance)))
                ($all (tensor:view (tensor:from-values bool (1) (True))
                        (tensor:shape $mask) (0) 0)))
           (== $decisions $all)) False))
      ($other False))))

(= (ic-search:observation IC:NumericArchive $artifact) (ic-numeric:observe $artifact))
(= (ic-search:consider IC:NumericArchive $original $best $candidate)
   (case (ic-packed:check IC:NumericArchive $original $best $candidate)
     (((IC:PackedAccepted $next $before $after) (IC:CandidateAccepted $next))
      ((IC:PackedRejected $reason) (IC:CandidateRejected $reason)))))

(= (ic-numeric:materialize-program $original $family $forest)
   (case (tensor-program:pack $family $forest)
     (((TP:Artifact $program)
       (ic-numeric:program-candidate IC:NumericArchive $original $program)) ($other (IC:Refused InvalidProgram)))))

(= (ic-search:materialize IC:NumericArchive $original $proposal)
   (case $proposal
     (((IC:ParameterProposal ($scale $offset))
       (case ((ic-parameters:float $scale) (ic-parameters:float $offset))
         ((((IC:ParameterValue $a) (IC:ParameterValue $b))
           (case (binary-value:unpack $original)
             (((BinaryValue:Value (Numeric:Archive "NC1" $inputs $mask $precision $body))
               (case (binary-value:pack
                 (Numeric:Archive "NC1" $inputs $mask $precision
                   (Numeric:Affine (ic-numeric:encode (tensor:from-values f64 (2) ($a $b))))))
                 (((Binary:TreeBytes $candidate) (IC:Candidate $candidate))
                  ($other (IC:ProducerFault Codec)))))
              ($other (IC:ProducerFault Original)))))
          ($other (IC:ProducerFault ParameterConversion)))))
      ((TP:Blueprint $family $forest) (ic-numeric:materialize-program $original $family $forest))
      ($other (IC:ProducerFault ParameterCount)))))

(= (ic:prepare-fit Numeric:Affine $original $domains $sources)
   (if (and (== (get-metatype $domains) Expression) (== (size-atom $domains) 2))
     (case (ic-parameters:prepare $domains)
       (((IC:ParameterRegion $choices)
         (let* (($handle (work-new (ic-parameters:proposals $choices)))
                ($dependencies (cons-atom (context-space) $sources)))
           (case (ic:prepare IC:NumericArchive $original $dependencies 64 ((IC:Branch 0 $handle)))
             (((IC:PreparedSearch $state) (IC:PreparedSearch $state))
              ($failure (let $released (work-cancel $handle) $failure))))))
        ($other (IC:FitRefused ParameterDomains))))
     (IC:FitRefused ParameterDomains)))
(= (ic:fit Numeric:Affine $original $domains $sources $budget)
   (case (ic:prepare-fit Numeric:Affine $original $domains $sources)
     (((IC:PreparedSearch $state) (ic:resume $state $budget)) ($other $other))))

(= (ic:predict Numeric:Affine $artifact $inputs)
   (if (ic-parameters:vector? f64 $inputs)
     (case (ic-numeric:observe $artifact)
       (((IC:Some $observation)
         (case (binary-value:unpack $artifact)
           (((BinaryValue:Value (Numeric:Archive "NC1" $old-inputs $mask $precision (Numeric:Affine $parameters)))
             (let $result (ic-numeric:predicted $inputs (Numeric:Affine $parameters))
               (if (ic-parameters:vector? f64 $result) (IC:Prediction $result) (IC:NumericFault Prediction))))
            ($other (IC:NumericFault NoModel)))))
        ($other (IC:NumericFault NoModel))))
     (IC:NumericFault Inputs)))
