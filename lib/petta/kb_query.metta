; Composable queries over captured durable views. Plans and projections are
; data. A step advances at most one source row; pages also bound silent steps.
; Cursors own their scans and borrow their view. Consume each continuation once.
!(import! &self "kb.metta")
!(import! &self "query_space_source.metta")
!(import! &self "query_pipeline.metta")

; Encoding the pattern and continuation together preserves their variable
; sharing. Decoding for each candidate freshens query variables independently.
; In particular a binding from one row must not constrain the next row.
; Copy the row too: matching may bind its variables, while semi/anti return
; the original value and a KqRows tail may share variables with that value.
(= (kbq:match $program $row)
   (case (store:encode $row)
     (((StoreEncoded $bytes)
       (case (store:decode $bytes)
         (((StoreDecoded $fresh) (kbq:match-fresh $program $fresh))
          ($error (KbRefused query-row-codec)))))
      ($error (KbRefused query-row-codec)))))
(= (kbq:match-fresh $program $row)
   (case (store:decode $program)
     (((StoreDecoded (KqMatch $pattern $template))
       (case $row (($pattern (KqHit $template)) ($other KqMiss))))
      ($error (KbRefused query-program)))))
(= (kbq:open $view $plan $bytes)
   (case (kbq:source-validate $view)
     ((KbViewReady (kbq:open-ready $view $plan $bytes)) ($error $error))))
(= (kbq:open-ready $view $plan $bytes)
   (case (kbq:begin $view $plan $bytes)
     (((KqReady $state) (KqCursor $view $state 0 0 0)) ($error $error))))
(= (kbq:begin $view $plan $bytes)
   (if (not (knowledge:headed? $plan)) (KbRefused query-plan)
     (case $plan
       (((KqRows $rows)
         (if (== (get-metatype $rows) Expression) (KqReady (KqRowsState $rows))
             (KbRefused query-rows)))
        ((KqScan $selector $pattern $template)
         (case (store:encode (KqMatch $pattern $template))
           (((StoreEncoded $program)
             (case (kb:query-open $view $selector $bytes)
               (((KbCursor $v $scan $position $prefix $budget $rows $keys $decoded)
                 (KqReady (KqScanState
                   (KbCursor $v $scan $position $prefix $budget $rows $keys $decoded) $program)))
                ($error $error))))
            ($error $error))))
        ((KqSpace $collection $pattern $template)
         (kbq:begin-space $view $collection $pattern $template $bytes))
        ((KqRange $collection $arity $position $lower $upper $pattern $template)
         (kbq:begin-range $view $collection $arity $position $lower $upper $pattern $template $bytes))
        ((KqMap $source $callback) (kbq:begin-pipe $view $source map $callback () 0 $bytes))
        ((KqSelect $source $callback) (kbq:begin-pipe $view $source select $callback () 0 $bytes))
        ((KqDistinct $source $equivalent $maximum)
         (kbq:begin-pipe $view $source distinct $equivalent () $maximum $bytes))
        ((KqFold $source $initial $callback $maximum)
         (kbq:begin-pipe $view $source fold $callback $initial $maximum $bytes))
        ((KqGroup $source $key $equivalent $initial $step $maximum)
         (kbq:begin-pipe $view $source group (KqGroupConfigV1 $key $equivalent $initial $step) () $maximum $bytes))
        ((KqOrder $source $less $maximum)
         (kbq:begin-pipe $view $source order $less () $maximum $bytes))
        ((KqSlice $source $offset $count)
         (kbq:begin-pipe $view $source slice (KqSliceConfigV1 $offset $count) () 0 $bytes))
        ((KqUnion $plans) (kbq:begin-union $view $plans $bytes))
        ((KqBind $left $pattern $right)
         (kbq:begin-bind $view $left $pattern $right KqAbsent inner $bytes))
        ((KqOptional $left $pattern $right $missing)
         (kbq:begin-bind $view $left $pattern $right $missing optional $bytes))
        ((KqSemi $left $pattern $right)
         (kbq:begin-bind $view $left $pattern $right KqAbsent semi $bytes))
        ((KqAnti $left $pattern $right)
         (kbq:begin-bind $view $left $pattern $right KqAbsent anti $bytes))
        ($bad (KbRefused query-plan))))))
(= (kbq:begin-union $view $plans $bytes)
   (if (== (get-metatype $plans) Expression)
       (if (== $plans ()) (KqReady (KqRowsState ()))
         (case (store:encode (cdr-atom $plans))
           (((StoreEncoded $pending)
             (case (kbq:begin $view (car-atom $plans) $bytes)
               (((KqReady $active) (KqReady (KqUnionState $view $bytes $active $pending)))
                ($error $error))))
            ($error $error))))
       (KbRefused query-plans)))
(= (kbq:begin-bind $view $left $pattern $right $missing $mode $bytes)
   (case (store:encode (KqMatch $pattern (KqContinuation $right $missing)))
     (((StoreEncoded $program)
       (case (kbq:begin $view $left $bytes)
         (((KqReady $outer) (KqReady (KqBindState $view $bytes $outer $program $mode)))
          ($error $error))))
      ($error $error))))

; Conservative validation covers even unvisited negative/aggregate/path facts.
; These plans have no arbitrary effectful callbacks or external reads. A caller
; adding such computations must supply their additional dependency contract.
(= (kbq:cursor? $cursor)
   ; This validates record shape. Native operations still check owned handles;
   ; a printed NativeHandle expression is not an owning reference.
   (if (knowledge:tagged? $cursor KqCursor 6)
       (let (KqCursor $view $state $steps $keys $bytes) $cursor
         (if (and (not (== (get-metatype $view) Variable)) (knowledge:headed? $state))
             (if (and (kb:integer? $steps) (and (kb:integer? $keys) (kb:integer? $bytes)))
                 (and (>= $steps 0) (and (>= $keys 0) (>= $bytes 0))) False) False)) False))
(= (kbq:observe $cursor)
   (if (kbq:cursor? $cursor) (kbq:observe-ready $cursor) (KbRefused query-cursor)))
(= (kbq:observe-ready (KqCursor $view $state $steps $keys $bytes))
   (kbq:source-observe $view))
(= (kbq:work $cursor)
   (if (kbq:cursor? $cursor) (kbq:work-ready $cursor) (KbRefused query-cursor)))
(= (kbq:work-ready (KqCursor $view $state $steps $keys $bytes)) (KqWork $steps $keys $bytes))
(= (kbq:close $cursor)
   (if (kbq:cursor? $cursor) (kbq:close-ready $cursor) (KbRefused query-cursor)))
(= (kbq:close-ready (KqCursor $view $state $steps $keys $bytes))
   (let* (($_ (kbq:close-state $state)) ($_ (kbq:source-close-view $view))) KqClosed))
(= (kbq:close-state $state)
   (case $state
     (((KqScanState $source $program) (let $closed (kb:query-close $source) KqClosed))
      ((KqSpaceStateV1 $query $sequence $maximum $keys $bytes) (kbq:close-space-query $query))
      ((KqRangeStateV1 $config $pending $source $point) (range-i:close $state))
      ((KqPipeStateV1 $kind $active $config $data $maximum) (kbq:close-state $active))
      ((KqRowsState $rows) KqClosed)
      ((KqUnionState $view $bytes $active $pending) (kbq:close-state $active))
      ((KqBindState $view $bytes $outer $program $mode) (kbq:close-state $outer))
      ((KqInnerState $view $bytes $outer $program $mode $inner $missing $seen $row)
       (let* (($a (kbq:close-state $inner)) ($b (kbq:close-state $outer))) KqClosed))
      ($bad (KbRefused query-state)))))

; Internal steps return work deltas. Terminal and failed states close their
; resources; only nonterminal continuations retain ownership.
(= (kbq:advance $state)
   (case $state
     (((KqRowsState $rows)
       (if (== $rows ()) (KqEnd 0 0)
           (let ($head $tail) (decons-atom $rows)
             (KqOut $head (KqRowsState $tail) 0 0))))
      ((KqScanState $source $program) (kbq:advance-scan $source $program))
      ((KqSpaceStateV1 $query $sequence $maximum $keys $bytes)
       (kbq:advance-space $query $sequence $maximum $keys $bytes))
      ((KqRangeStateV1 $config $pending $source $point) (range-i:advance $state))
      ((KqPipeStateV1 $kind $active $config $data $maximum)
       (kbq:advance-pipe $kind $active $config $data $maximum))
      ((KqUnionState $view $bytes $active $pending)
       (kbq:advance-union $view $bytes $active $pending))
      ((KqBindState $view $bytes $outer $program $mode)
       (kbq:advance-bind $view $bytes $outer $program $mode))
      ((KqInnerState $view $bytes $outer $program $mode $inner $missing $seen $row)
       (kbq:advance-inner $view $bytes $outer $program $mode $inner $missing $seen $row))
      ($bad (KqFail (KbRefused query-state) 0 0)))))
(= (kbq:advance-scan (KbCursor $view $scan $position $prefix $budget $rows $keys $bytes) $program)
   (let $source (KbCursor $view $scan $position $prefix $budget $rows $keys $bytes)
     (case (kb:query-next $source)
       (((KbYield $row (KbCursor $v $s $p $f $b $r $k $d))
         (let $next (KbCursor $v $s $p $f $b $r $k $d)
           (case (kbq:match $program $row)
             (((KqHit $value) (KqOut $value (KqScanState $next $program) (- $k $keys) (- $d $bytes)))
              (KqMiss (KqSkip (KqScanState $next $program) (- $k $keys) (- $d $bytes)))
              ($error (let $closed (kb:query-close $next) (KqFail $error (- $k $keys) (- $d $bytes))))))))
        ((KbEnd (KbWork $r $k $d))
         (let $closed (kb:query-close $source) (KqEnd (- $k $keys) (- $d $bytes))))
        ($error (let $closed (kb:query-close $source) (KqFail $error 0 0)))))))
(= (kbq:advance-union $view $bytes $active $pending)
   (case (kbq:advance $active)
     (((KqOut $row $next $keys $decoded)
       (KqOut $row (KqUnionState $view $bytes $next $pending) $keys $decoded))
      ((KqSkip $next $keys $decoded)
       (KqSkip (KqUnionState $view $bytes $next $pending) $keys $decoded))
      ((KqEnd $keys $decoded)
       (case (store:decode $pending)
         (((StoreDecoded $plans)
           (case (kbq:begin-union $view $plans $bytes)
             (((KqReady $next) (KqSkip $next $keys $decoded))
              ($error (KqFail $error $keys $decoded)))))
          ($error (KqFail $error $keys $decoded)))))
      ($fault $fault))))
(= (kbq:advance-bind $view $bytes $outer $program $mode)
   (case (kbq:advance $outer)
     (((KqOut $row $next $keys $decoded)
       (case (kbq:match $program $row)
         (((KqHit (KqContinuation $plan $missing))
           (case (kbq:begin $view $plan $bytes)
             (((KqReady $inner)
               (KqSkip (KqInnerState $view $bytes $next $program $mode $inner $missing False $row) $keys $decoded))
              ($error (let $closed (kbq:close-state $next) (KqFail $error $keys $decoded))))))
          (KqMiss (KqSkip (KqBindState $view $bytes $next $program $mode) $keys $decoded))
          ($error (let $closed (kbq:close-state $next) (KqFail $error $keys $decoded))))))
      ((KqSkip $next $keys $decoded)
       (KqSkip (KqBindState $view $bytes $next $program $mode) $keys $decoded))
      ($terminal $terminal))))
(= (kbq:advance-inner $view $bytes $outer $program $mode $inner $missing $seen $original)
   (let $resume (KqBindState $view $bytes $outer $program $mode)
     (case (kbq:advance $inner)
       (((KqOut $row $next $keys $decoded)
         (case $mode
           ((semi (let $closed (kbq:close-state $next) (KqOut $original $resume $keys $decoded)))
            (anti (let $closed (kbq:close-state $next) (KqSkip $resume $keys $decoded)))
            ($other (KqOut $row
                      (KqInnerState $view $bytes $outer $program $mode $next $missing True $original) $keys $decoded)))))
        ((KqSkip $next $keys $decoded)
         (KqSkip (KqInnerState $view $bytes $outer $program $mode $next $missing $seen $original) $keys $decoded))
        ((KqEnd $keys $decoded)
         (if (and (== $mode optional) (== $seen False)) (KqOut $missing $resume $keys $decoded)
           (if (== $mode anti) (KqOut $original $resume $keys $decoded)
               (KqSkip $resume $keys $decoded))))
        ((KqFail $error $keys $decoded)
         (let $closed (kbq:close-state $outer) (KqFail $error $keys $decoded)))))))
(= (kbq:step $cursor)
   (if (kbq:cursor? $cursor) (kbq:step-ready $cursor) (KbRefused query-cursor)))
(= (kbq:step-ready (KqCursor $view $state $steps $keys $bytes))
   (case (kbq:program-check $view)
     ((StoreProgramCurrent
       (let $answer (kbq:advance $state)
         (kbq:checked-step $view $answer $steps $keys $bytes)))
      ($failure
       (let* (($_ (kbq:close-state $state)) ($_ (kbq:source-close-view $view)))
         (KqFailed $failure (KqWork $steps $keys $bytes)))))))
(= (kbq:checked-step $view $answer $steps $keys $bytes)
   (case (kbq:program-check $view)
     ((StoreProgramCurrent (kbq:step-result $view $answer $steps $keys $bytes))
      ($failure
       (let (KqDiscardedV1 $k $b) (kbq:discard-step $answer)
         (let $_ (kbq:source-close-view $view)
           (KqFailed $failure (KqWork (+ $steps 1) (+ $keys $k) (+ $bytes $b)))))))))
(= (kbq:discard-step $answer)
  (case $answer
    (((KqOut $row $next $k $b) (let $_ (kbq:close-state $next) (KqDiscardedV1 $k $b)))
     ((KqSkip $next $k $b) (let $_ (kbq:close-state $next) (KqDiscardedV1 $k $b)))
     ((KqEnd $k $b) (KqDiscardedV1 $k $b))
     ((KqFail $error $k $b) (KqDiscardedV1 $k $b)))))
(= (kbq:step-result $view $answer $steps $keys $bytes)
   (case $answer
     (((KqOut $row $next $extra $decoded)
       (KqYield $row (KqCursor $view $next (+ $steps 1) (+ $keys $extra) (+ $bytes $decoded))))
      ((KqSkip $next $extra $decoded)
       (KqContinue (KqCursor $view $next (+ $steps 1) (+ $keys $extra) (+ $bytes $decoded))))
      ((KqEnd $extra $decoded)
       (let $_ (kbq:source-close-view $view)
         (KqDone (KqWork (+ $steps 1) (+ $keys $extra) (+ $bytes $decoded)))))
      ((KqFail $error $extra $decoded)
       (let $_ (kbq:source-close-view $view)
         (KqFailed $error (KqWork (+ $steps 1) (+ $keys $extra) (+ $bytes $decoded))))))))

(= (kbq:page $cursor $count $fuel)
   (if (kbq:cursor? $cursor) (kbq:page-ready $cursor $count $fuel) (KbRefused query-cursor)))
(= (kbq:page-ready $cursor $count $fuel)
   (if (and (kb:integer? $count) (kb:integer? $fuel))
       (if (and (> $count 0) (>= $fuel 0)) (kbq:page-walk $cursor $count $fuel ())
           (KbRefused query-page-budget))
       (KbRefused query-page-budget)))
(= (kbq:page-walk $cursor $count $fuel $reversed)
   (if (== $count 0) (KqPage (list:reverse $reversed) (KqMore $cursor))
     (if (== $fuel 0) (KqPage (list:reverse $reversed) (KqPaused $cursor))
       (case (kbq:step-ready $cursor)
         (((KqYield $row $next) (kbq:page-walk $next (- $count 1) (- $fuel 1) (cons-atom $row $reversed)))
          ((KqContinue $next) (kbq:page-walk $next $count (- $fuel 1) $reversed))
          ((KqDone $work) (KqPage (list:reverse $reversed) (KqComplete $work)))
          ((KqFailed $error $work) (KqPage (list:reverse $reversed) (KqFailure $error $work))))))))

; Explanation distinguishes a caller-selected exact domain from unification.
; A dependent inner plan is explained only after its outer bindings exist.
(= (kbq:explain $plan)
   (if (knowledge:headed? $plan) (kbq:explain-value $plan) (KbRefused query-plan)))
(= (kbq:explain-value $plan)
   (case $plan
     (((KqRows $rows)
       (if (== (get-metatype $rows) Expression)
           (KqPlan values (explicit-materialization (size-atom $rows)))
           (KbRefused query-rows)))
      ((KqScan $selector $pattern $template)
       (KqPlan scan (kb:explain $selector) unification streamed))
      ((KqSpace $collection $pattern $template)
       (KqPlan ordinary-space $collection shared-unification declared-candidates-or-scan streamed))
      ((KqRange $collection $arity $position $lower $upper $pattern $template)
       (KqPlan stored-scalar-range $collection $arity $position $lower $upper shared-unification integer-seek-and-other-scalar-or-complete-scan streamed))
      ((KqMap $source $callback) (KqPlan map (kbq:explain $source) explicit-pure-callback streamed))
      ((KqSelect $source $callback) (KqPlan select (kbq:explain $source) explicit-pure-callback streamed))
      ((KqDistinct $source $equivalent $maximum)
       (KqPlan distinct (kbq:explain $source) explicit-equivalence (state-bytes $maximum) streamed))
      ((KqFold $source $initial $step $maximum)
       (KqPlan fold (kbq:explain $source) incremental-input blocking-output (state-bytes $maximum)))
      ((KqGroup $source $key $equivalent $initial $step $maximum)
       (KqPlan group (kbq:explain $source) incremental-input blocking-output (state-bytes $maximum)))
      ((KqOrder $source $less $maximum)
       (KqPlan order (kbq:explain $source) blocking-output canonical-row-ties (state-bytes $maximum)))
      ((KqSlice $source $offset $count) (KqPlan slice (kbq:explain $source) $offset $count streamed))
      ((KqUnion $plans)
       (if (== (get-metatype $plans) Expression)
           (KqPlan union-all (map-atom $plans $part (kbq:explain $part)))
           (KbRefused query-plans)))
      ((KqBind $left $pattern $right) (KqPlan nested-loop (kbq:explain $left) dependent streamed))
      ((KqOptional $left $pattern $right $missing) (KqPlan optional (kbq:explain $left) dependent streamed))
      ((KqSemi $left $pattern $right) (KqPlan semi (kbq:explain $left) dependent streamed))
      ((KqAnti $left $pattern $right) (KqPlan anti (kbq:explain $left) dependent streamed))
      ($bad (KbRefused query-plan)))))
