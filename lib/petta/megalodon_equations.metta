(= (mg:rewrite $theory $context $goal $eq $source $path $tactic) (let $equations (collapse (mg:source $theory $context $source)) (if (== $equations ()) (empty) (mg:convert $theory $context $goal $eq $path (Cv.equation (car-atom $equations)) $tactic))))
