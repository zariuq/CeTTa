; Maintenance over the same ordinary durable collections and publication
; owner. Temporary operations live in a native byte-index batch, not a bag
; containing the complete KB. No published data changes until finish.
!(import! &self "durable_space.metta")

(: durable-space:reindex-open (-> %Undefined% %Undefined% Atom Atom Number %Undefined%))
(: durable-reindex:metadata (-> %Undefined% Atom String String %Undefined%))
(= (durable-space:reindex-open $owner $view $collection $request $maximum)
  (let $command (SpaceReindexV1 $collection)
    (case (knowledge:receipt $view $request $command (durable-space:wire-limit))
      ((KnowledgeReceiptAbsentV1
        (case (durable-space:metadata $collection)
          (((KnowledgeAddressV1 $metadata)
            (case (durable-space:prefix $collection)
              (((KnowledgeAddressV1 $prefix)
                (durable-reindex:open-ready $owner $view $collection $request $metadata $prefix $maximum))
               ($failure $failure))))
           ($failure $failure))))
       ($prior (knowledge:replay-on $owner $view $prior))))))
(= (durable-reindex:open-ready $owner $view $collection $request $metadata $prefix $maximum)
  (case (durable-reindex:metadata $view $collection $metadata $prefix)
    (((SpaceReindexMetadataV1 $count $indexes)
      (case (store:view-clone $view)
        (((StoreSnapshot $copy $epoch $revision)
          (case (store:batch-open $owner $copy $maximum)
            (((StoreBatch $batch)
              (SpaceReindexOpenedV1
                (SpaceReindexStateV1 $copy $collection $request $metadata $prefix $count
                  $indexes $indexes ReindexIdleV1 Clearing 0 $batch)))
             ($failure (let $_ (store:close $copy) $failure)))))
         ($failure $failure))))
     ($failure $failure))))
(= (durable-reindex:metadata $view $collection $metadata $prefix)
  (case (store:get $view $metadata (durable-space:wire-limit))
    (((StoreValue $body)
      (case (store:decode $body)
        (((StoreDecoded $record)
          (case $record
            (((StoreSpaceV1 $stored $count) (durable-reindex:fields $collection $prefix $stored $count () False))
             ((StoreSpaceV2 $stored $count $indexes) (durable-reindex:fields $collection $prefix $stored $count $indexes False))
             ((StoreSpaceV3 $stored $count $indexes) (durable-reindex:fields $collection $prefix $stored $count $indexes False))
             ((StoreSpaceV4 $stored $count $indexes) (durable-reindex:fields $collection $prefix $stored $count $indexes True))
             ($bad (SpaceRefusedV1 metadata-format)))))
         ($failure $failure))))
     (StoreAbsent (SpaceRefusedV1 collection-absent))
     ($failure $failure))))
(= (durable-reindex:fields $collection $prefix $stored $count $indexes $ranges)
  (case (durable-space:state-version $collection $prefix $stored $count $indexes $ranges)
    (((SpaceStateV1 $same $declared) (SpaceReindexMetadataV1 $same $declared))
     ($failure $failure))))

(= (durable-reindex:state? $state) (knowledge:tagged? $state SpaceReindexStateV1 13))
(= (durable-reindex:close-active $active)
  (case $active
    ((ReindexIdleV1 ReindexClosedV1)
     ((ReindexScanV1 $scan $prefix $position) (store:close $scan))
     ((ReindexQueryV1 $query $sequence)
      (let* (($_ (store:space-query-cancel $query)) ($_ (store:close $query))) ReindexClosedV1))
     ($bad (SpaceRefusedV1 reindex-state)))))
(= (durable-space:reindex-close $state)
  (if (durable-reindex:state? $state)
    (let (SpaceReindexStateV1 $view $c $r $m $p $n $i $pending $active $phase $rows $batch) $state
      (let* (($_ (durable-reindex:close-active $active)) ($_ (store:close $view)) ($_ (store:close $batch))) ReindexClosedV1))
    (SpaceRefusedV1 reindex-state)))
(= (durable-reindex:fail $state $failure)
  (let $_ (durable-space:reindex-close $state) $failure))
(= (durable-space:reindex-progress $state)
  (if (durable-reindex:state? $state)
    (let (SpaceReindexStateV1 $v $c $r $m $p $count $i $pending $active $phase $rows $batch) $state
      (case (store:batch-info $batch)
        (((StoreBatchInfo $bytes $maximum $staged) (SpaceReindexProgressV1 $phase $rows $count $bytes $maximum $staged))
         ($failure $failure))))
    (SpaceRefusedV1 reindex-state)))
(= (durable-space:reindex-page $owner $state $steps)
  (if (and (durable-reindex:state? $state) (and (durable-index:integer? $steps) (> $steps 0)))
    (durable-reindex:page $owner $state $steps) (SpaceRefusedV1 reindex-page)))
(= (durable-reindex:page $owner $state $steps)
  (if (== $steps 0) (SpaceReindexMoreV1 $state (durable-space:reindex-progress $state))
    (case (durable-reindex:step $owner $state)
      (((SpaceReindexContinueV1 $next) (durable-reindex:page $owner $next (- $steps 1)))
       ($terminal $terminal)))))

(= (durable-reindex:step $owner (SpaceReindexStateV1 $view $collection $request $metadata $prefix $count $indexes $pending $active $phase $rows $batch))
  (let $state (SpaceReindexStateV1 $view $collection $request $metadata $prefix $count $indexes $pending $active $phase $rows $batch)
    (case $phase
      ((Clearing
        (case $active
          ((ReindexIdleV1
            (if (== $pending ())
              (case (durable-space:cursor $view $collection $atom $atom)
                (((StoreQueryOpened $query $epoch $revision)
                  (SpaceReindexContinueV1 (SpaceReindexStateV1 $view $collection $request $metadata $prefix $count $indexes () (ReindexQueryV1 $query 0) Filling $rows $batch)))
                 ($failure (durable-reindex:fail $state $failure))))
              (let (SpaceIndexPrefixV1 $index-prefix) (durable-index:index-prefix (car-atom $pending))
                (case (store:scan-open $view $index-prefix NoBound)
                  (((StoreScan $scan)
                    (SpaceReindexContinueV1 (SpaceReindexStateV1 $view $collection $request $metadata $prefix $count $indexes (cdr-atom $pending) (ReindexScanV1 $scan $index-prefix 0) Clearing $rows $batch)))
                   ($failure (durable-reindex:fail $state $failure)))))))
           ((ReindexScanV1 $scan $index-prefix $position)
            (case (store:scan-next $scan $position)
              ((StoreEnd (durable-reindex:scan-end $state $scan))
               ((StoreKey $key $bytes $next)
                (if (str:starts-with $key $index-prefix)
                  (case (store:batch-add $batch (ops (remove $key)))
                    ((StoreBatchStaged
                      (SpaceReindexContinueV1 (SpaceReindexStateV1 $view $collection $request $metadata $prefix $count $indexes $pending (ReindexScanV1 $scan $index-prefix $next) Clearing $rows $batch)))
                     ($failure (durable-reindex:fail $state $failure))))
                  (durable-reindex:scan-end $state $scan)))
               ($failure (durable-reindex:fail $state $failure)))))
           ($bad (durable-reindex:fail $state (SpaceRefusedV1 reindex-state))))))
       (Filling (durable-reindex:fill $state))
       (Ready (durable-reindex:finish $owner $state))
       ($bad (durable-reindex:fail $state (SpaceRefusedV1 reindex-state)))))))
(= (durable-reindex:scan-end (SpaceReindexStateV1 $v $c $r $m $p $n $i $pending $active $phase $rows $batch) $scan)
  (let $_ (store:close $scan)
    (SpaceReindexContinueV1 (SpaceReindexStateV1 $v $c $r $m $p $n $i $pending ReindexIdleV1 Clearing $rows $batch))))
(= (durable-reindex:fill (SpaceReindexStateV1 $view $c $r $m $p $count $indexes $pending (ReindexQueryV1 $query $sequence) $phase $rows $batch))
  (let $state (SpaceReindexStateV1 $view $c $r $m $p $count $indexes $pending (ReindexQueryV1 $query $sequence) Filling $rows $batch)
    (case (store:space-query-next $query $sequence 128 1048576)
      (((StoreQueryRow $same $atom ($reference))
        (let (StoreViewInfo $epoch $revision) (store:view-info $view)
          (case (durable-space:reference-key $reference $epoch $p)
            (((KnowledgeAddressV1 $key)
              (case (durable-index:postings $indexes $key $atom)
                (((SpaceIndexPostingsV1 $postings)
                  (let $ops (cons-atom ops (map-atom $postings $posting (put $posting "")))
                    (case (store:batch-add $batch $ops)
                      ((StoreBatchStaged
                        (durable-reindex:checkpoint $state $query (+ $sequence 1) (+ $rows 1)))
                       ($failure (durable-reindex:fail $state $failure))))))
                 ($failure (durable-reindex:fail $state $failure)))))
             ($failure (durable-reindex:fail $state $failure))))))
       (StoreQueryPaused (durable-reindex:checkpoint $state $query $sequence $rows))
       (StoreQueryEnd
        (let $_ (store:close $query)
          (if (== $rows $count)
            (SpaceReindexContinueV1 (SpaceReindexStateV1 $view $c $r $m $p $count $indexes () ReindexIdleV1 Ready $rows $batch))
            (durable-reindex:fail $state (SpaceRefusedV1 reindex-count)))))
       ($failure (durable-reindex:fail $state $failure))))))
(= (durable-reindex:checkpoint (SpaceReindexStateV1 $v $c $r $m $p $n $i $pending $active $phase $old $batch) $query $sequence $rows)
  (case (store:space-query-checkpoint $query)
    ((StoreQueryCheckpointed
      (SpaceReindexContinueV1 (SpaceReindexStateV1 $v $c $r $m $p $n $i $pending (ReindexQueryV1 $query $sequence) Filling $rows $batch)))
     ($failure (durable-reindex:fail (SpaceReindexStateV1 $v $c $r $m $p $n $i $pending $active $phase $old $batch) $failure)))))
(= (durable-reindex:finish $owner (SpaceReindexStateV1 $view $collection $request $metadata $prefix $count $indexes $pending $active $phase $rows $batch))
  (let* (($state (SpaceReindexStateV1 $view $collection $request $metadata $prefix $count $indexes $pending $active $phase $rows $batch))
         ($record (durable-space:descriptor $prefix $count $indexes)))
    (case (store:encode $record)
      (((StoreEncoded $body)
        (case (knowledge:receipt-address $request)
          (((KnowledgeAddressV1 $receipt-key)
            (let* (($command (SpaceReindexV1 $collection)) ($answer (SpaceReindexedV1 $collection $rows)))
              (case (store:encode (KnowledgeReceiptV1 $request $command $answer))
                (((StoreEncoded $receipt)
                  (case (store:batch-add $batch (ops (put $metadata $body) (put $receipt-key $receipt)))
                    ((StoreBatchStaged
                      (case (store:commit-batch $owner $view $batch)
                        (((StoreSnapshot $after $epoch $revision)
                          (let* (($_ (store:close $after)) ($_ (durable-space:reindex-close $state)))
                            (KnowledgeCommittedV1 $answer $epoch $revision)))
                         ($failure (durable-reindex:fail $state $failure)))))
                     ($failure (durable-reindex:fail $state $failure)))))
                 ($failure (durable-reindex:fail $state $failure))))))
           ($failure (durable-reindex:fail $state $failure)))))
       ($failure (durable-reindex:fail $state $failure))))))
