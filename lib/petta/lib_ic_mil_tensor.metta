; Functional MIL proposals share the existing numerical observation, TP1
; codec, complete-cost checker and owned fair controller. Primitive references
; are inert ordinals, never dynamically invoked evaluator symbols.
!(import! &self "../ilp/metagol_core.metta")
!(import! &self "../ilp/metagol_prime.metta")
!(import! &self (library lib_ic_numeric_program))
!(import! &self (library lib_tensor_program_compose))

(= (mil-tensor:declarations $bindings $index)
   (if (== (get-metatype $bindings) Expression)
     (if (== $bindings ()) (MIL.TensorDeclarations ())
       (case (car-atom $bindings)
         (((MIL.TensorPrimitive $name $bytes)
           (mil-tensor:declaration $name $bytes (cdr-atom $bindings) $index))
          ($bad-binding-row (IC:FitRefused Vocabulary))))) (IC:FitRefused Vocabulary)))
(= (mil-tensor:declaration $name $bytes $rest $index)
   (if (binary-schema:text? $name)
     (case ((tensor-program:unary-snapshot $bytes) (mil-tensor:declarations $rest (+ $index 1)))
       ((((TP:Unary $family $root $records $input $output $demand) (MIL.TensorDeclarations $tail))
         (let $row (MIL.TypeRow (MIL.TensorRef $index) (MIL.Rel $input $output))
           (let $rows (cons-atom $row $tail) (MIL.TensorDeclarations $rows))))
        ($bad-binding (IC:FitRefused Vocabulary)))) (IC:FitRefused Vocabulary)))
(= (mil-tensor:skeleton? $term)
   (case $term
     (((MIL.Hole $name)
       (case (binary:value-kind $name) ((Symbol True) (Natural True) (Text True) ($invalid-name False))))
      ((MIL.Id $inner) (mil-tensor:skeleton? $inner))
      ((MIL.Chain $left $right) (and (mil-tensor:skeleton? $left) (mil-tensor:skeleton? $right)))
      ($other-skeleton False))))
(= (mil-tensor:skeletons? $terms)
   (if (== (get-metatype $terms) Expression)
     (if (== $terms ()) True
       (and (mil-tensor:skeleton? (car-atom $terms)) (mil-tensor:skeletons? (cdr-atom $terms)))) False))

(= (mil-tensor:compile $bindings $program)
   (case $program
     (((MIL.TensorRef $index)
       (case (tensor-program:at $bindings $index)
         (((TP:Some (MIL.TensorPrimitive $name $bytes))
           (case (tensor-program:unary-snapshot $bytes)
             (((TP:Unary $f $r $rows $a $b $d) (TP:Artifact $bytes))
              ($invalid-primitive (TP:Fault Primitive)))))
          ($unknown-primitive (TP:Fault Primitive)))))
      ((MIL.Id $inner) (mil-tensor:compile $bindings $inner))
      ((MIL.Chain $earlier $later)
       (case ((mil-tensor:compile $bindings $earlier) (mil-tensor:compile $bindings $later))
         ((((TP:Artifact $first) (TP:Artifact $second)) (tensor-program:compose-strict $first $second))
          ($invalid-chain (TP:Fault Composition)))))
      ($unsupported-program (TP:Fault UnsupportedProgram)))))

; Only immutable type rows and structural skeletons enter a retained producer.
; Packed program handles, encoding and execution remain in materialization.
(= (mil-tensor:produce $vocabulary $skeletons $type)
   (if (== $skeletons ()) (superpose ())
     (let $program (mil:prime:typed-fill-vocabulary $vocabulary (car-atom $skeletons) $type)
       (IC:Proposal (MIL.TensorProgram $program)))))
(= (mil-tensor:produce $vocabulary $skeletons $type)
   (if (== $skeletons ()) (superpose ()) (mil-tensor:produce $vocabulary (cdr-atom $skeletons) $type)))

(= (ic-search:observation (MIL.TensorModel $domain $bindings) $artifact)
   (case (ic-search:observation $domain $artifact)
     (((IC:Some $observation) (IC:Some (MIL.TensorObservation $bindings $observation)))
      ($invalid-observation IC:None))))
(= (ic-search:consider (MIL.TensorModel $domain $bindings) $original $best $candidate)
   (ic-search:consider $domain $original $best $candidate))
(= (ic-search:materialize (MIL.TensorModel $domain $bindings) $original $proposal)
   (case $proposal
     (((MIL.TensorProgram $program)
       (case (mil-tensor:compile $bindings $program)
         (((TP:Artifact $bytes) (ic-numeric:program-candidate $domain $original $bytes))
          ((TP:Fault $reason) (IC:Refused $reason)))))
      ($invalid-proposal (IC:ProducerFault Proposal)))))

(= (mil-tensor:task $original)
   (case (ic-program:task-class $original)
     (((IC:TaskClass $domain $sort)
       (case (ic-search:observation $domain $original)
         (((IC:Some (Numeric:Values $inputs $mask $precision $outputs))
           (MIL.TensorTask $domain (MIL.Rel "F64Tensor" "F64Tensor")))
          ((IC:Some (Numeric:ArrayValues ((TP:Value $input $tensor)) $output $mask $criterion $values))
           (MIL.TensorTask $domain (MIL.Rel $input $output)))
          ($invalid-task (IC:FitRefused Task))))) ($invalid-domain (IC:FitRefused Task)))))
(= (mil-tensor:open $original $domain $bindings $rows $skeletons $type $sources)
   (let* (($dependencies (cons-atom (context-space) $sources))
          ($handle (work-new (mil-tensor:produce $rows $skeletons $type))))
     (case (ic:prepare (MIL.TensorModel $domain $bindings) $original $dependencies 64 ((IC:Branch 0 $handle)))
       (((IC:PreparedSearch $state) (IC:PreparedSearch $state))
        ($preparation-refusal (let $released (work-cancel $handle) $preparation-refusal))))))
(= (ic:prepare-fit Numeric:MIL $original (MIL.TensorRegion $bindings $skeletons) $sources)
   (if (mil-tensor:skeletons? $skeletons)
     (case ((mil-tensor:task $original) (mil-tensor:declarations $bindings 0))
       ((((MIL.TensorTask $domain $type) (MIL.TensorDeclarations $rows))
         (mil-tensor:open $original $domain $bindings $rows $skeletons $type $sources))
        ($invalid-region (IC:FitRefused Region)))) (IC:FitRefused Region)))
(= (ic:fit Numeric:MIL $original $region $sources $budget)
   (case (ic:prepare-fit Numeric:MIL $original $region $sources)
     (((IC:PreparedSearch $state) (ic:resume $state $budget)) ($failed-preparation $failed-preparation))))
(= (ic:predict Numeric:MIL $artifact $inputs) (ic:predict Numeric:Programs $artifact $inputs))
