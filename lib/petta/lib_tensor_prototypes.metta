; Ordered masked prototype operations over packed arrays. Inputs passed to
; row/column views are owned logical row-major matrices. Missing observations
; are explicit mask bits, not sparse holes or implicit numerical zeroes.
!(import! &self (library lib_tensor_program))
!(import! &self (library lib_ic_parameters))

(= (tp-prototypes:matrix? $sort $value)
   (if (tensor-program:value? $sort $value) (== (size-atom (tensor:shape $value)) 2) False))
(= (tp-prototypes:owned $sort $value)
   (if (tp-prototypes:matrix? $sort $value)
     (let $copy (tensor:copy $value)
       (let $dense (tensor:convert $copy dense)
         (if (tp-prototypes:matrix? $sort $dense) (TP:Some $dense) TP:None))) TP:None))
(= (tp-prototypes:row $matrix $index)
   (let $width (index-atom (tensor:shape $matrix) 1)
     (tensor:view $matrix ($width) (1) (* $index $width))))
(= (tp-prototypes:column $matrix $index)
   (let $shape (tensor:shape $matrix)
     (tensor:view $matrix ((index-atom $shape 0)) ((index-atom $shape 1)) $index)))
(= (tp-prototypes:seed-value $value $observed) (if $observed $value 0.0))
(= (tp-prototypes:seed $points $mask $row)
   (let* (($values (tp-prototypes:row $points $row)) ($observed (tp-prototypes:row $mask $row))
          ($seed (tensor:zip-map f64 ($values $observed) tp-prototypes:seed-value ())))
     (tensor:reshape $seed (1 (index-atom (tensor:shape $points) 1)))))
(= (tp-prototypes:squared $value $center $observed)
   (if $observed (let $difference (- $value $center) (* $difference $difference)) 0.0))
(= (tp-prototypes:distance $point $center $mask)
   (case (catch (ic-parameters:float (IC:FloatParameter
          (tensor:sum (tensor:zip-map f64 ($point $center $mask) tp-prototypes:squared ()) sequential))))
     (((IC:ParameterValue $number) (TP:Some $number)) ($invalid TP:None))))
(= (tp-prototypes:nearest $centers $point $mask $position $best)
   (if (== $position (index-atom (tensor:shape $centers) 0)) $best
     (case (tp-prototypes:distance $point (tp-prototypes:row $centers $position) $mask)
       (((TP:Some $distance)
         (let $next (case $best
                 ((TP:None (TP:Nearest $position $distance))
                  ((TP:Nearest $index $previous)
                    (if (< $distance $previous) (TP:Nearest $position $distance) $best))))
           (tp-prototypes:nearest $centers $point $mask (+ $position 1) $next)))
        ($invalid TP:None)))))
(= (tp-prototypes:weighted $group $value $label $observed)
   (if (and $observed (== $label $group)) $value 0.0))
(= (tp-prototypes:member $group $label $observed)
   (if (and $observed (== $label $group)) 1.0 0.0))
(= (tp-prototypes:mean $points $mask $labels $centers $group $coordinate)
   (let* (($column (tp-prototypes:column $points $coordinate))
          ($observed (tp-prototypes:column $mask $coordinate))
          ($weights (tensor:zip-map f64 ($labels $observed) tp-prototypes:member ($group)))
          ($count (tensor:sum $weights sequential)))
     (if (== $count 0.0)
       (case (tensor:at $centers (+ (* $group (index-atom (tensor:shape $centers) 1)) $coordinate))
         (((tensor:present $previous) (TP:Some $previous)) ($invalid TP:None)))
       (case (catch (let $total (tensor:sum
                 (tensor:zip-map f64 ($column $labels $observed) tp-prototypes:weighted ($group)) sequential)
               (ic-parameters:float (IC:FloatParameter (/ $total $count)))))
         (((IC:ParameterValue $value) (TP:Some $value)) ($invalid TP:None))))))

; Prediction uses the same declared first-minimum rule as fitting. The input
; row sequence is retained, including repeated rows and all-masked rows.
(= (tp-prototypes:assign $points $mask $centers $position $labels)
   (if (== $position (index-atom (tensor:shape $points) 0))
     (let $result (tensor:from-values i64 ($position) (list:reverse $labels)) (TP:Some $result))
     (case (tp-prototypes:nearest $centers (tp-prototypes:row $points $position)
              (tp-prototypes:row $mask $position) 0 TP:None)
       (((TP:Nearest $index $distance)
         (tp-prototypes:assign $points $mask $centers (+ $position 1) (cons-atom $index $labels)))
        ($invalid TP:None)))))
