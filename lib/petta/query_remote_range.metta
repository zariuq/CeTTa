; A remote range yields original facts, not server-matched substitutions.
; The linear server continuation and one local point matcher own each row.
(: remote-range:open (-> %Undefined% Atom Number Number Atom Atom Bool Atom Atom Number %Undefined%))
(= (remote-range:open $root $collection $arity $position $lower $upper $ordered $pattern $template $maximum)
  (if (and (durable-index:dimensions? $arity $position) (range-i:atomic? $pattern))
    (case (store:encode (KqMatch $pattern $template))
      (((StoreEncoded $program)
        (let* (($source (store:remote-related $root $collection))
               ($opened (store:remote-source-start $source DbRangeOpen
                 (DbRangeOpenV1 $collection $arity $position $lower $upper $ordered)))
               ($_ (store:close $source)))
          (case $opened
            (((StoreRemoteResource $job (DbRangeOpenedV1 0 $limit $chunk))
              (KqReady (KqRemoteRangeStateV1 $job $program $maximum 0
                (min $limit (store:value-byte-limit)) (min $chunk (act:artifact-chunk-size)) RangeIdleV1)))
             ((KbRefused $reason) (KbRefused $reason))
             ((DbRefusedV1 $reason) (KbRefused $reason))
             ($failure (KbRefused remote-range-open $failure))))))
       ($failure $failure)))
    (KbRefused scalar-range-plan)))
(= (remote-range:close (KqRemoteRangeStateV1 $job $program $maximum $sequence $limit $chunk $point))
  (let* (($_ (if (== $point RangeIdleV1) KqClosed (kbq:close-state $point)))
         ($_ (store:close $job))) KqClosed))
(= (remote-range:fail $state $failure $keys $bytes)
  (let $_ (remote-range:close $state) (KqFail $failure $keys $bytes)))
(= (remote-range:advance (KqRemoteRangeStateV1 $job $program $maximum $sequence $limit $chunk $point))
  (let $state (KqRemoteRangeStateV1 $job $program $maximum $sequence $limit $chunk $point)
    (if (== $point RangeIdleV1)
      (remote-range:next $state (store:remote-use $job DbRangeNext (DbRangeNextV1 $sequence)))
      (case (kbq:advance $point)
        (((KqOut $row $next $keys $bytes)
          (KqOut $row (KqRemoteRangeStateV1 $job $program $maximum $sequence $limit $chunk $next) $keys $bytes))
         ((KqSkip $next $keys $bytes)
          (KqSkip (KqRemoteRangeStateV1 $job $program $maximum $sequence $limit $chunk $next) $keys $bytes))
         ((KqEnd $keys $bytes)
          (KqSkip (KqRemoteRangeStateV1 $job $program $maximum $sequence $limit $chunk RangeIdleV1) $keys $bytes))
         ((KqFail $failure $keys $bytes) (remote-range:fail $state $failure $keys $bytes)))))))
(= (remote-range:next (KqRemoteRangeStateV1 $job $program $maximum $sequence $limit $chunk $point) $reply)
  (let $state (KqRemoteRangeStateV1 $job $program $maximum $sequence $limit $chunk $point)
    (case $reply
      (((DbRangeSkipV1 $same $keys $bytes)
        (if (== $same $sequence) (KqSkip $state $keys $bytes)
          (remote-range:fail $state (KbRefused range-sequence) $keys $bytes)))
       ((DbRangeRowV1 $same $body $identity $keys $bytes)
        (if (and (== $same $sequence) (and (<= $body $limit) (<= $identity $limit)))
          (case (remote-range:point $job $sequence $body $identity $chunk $program $maximum)
            (((KqReady $query)
              (KqSkip (KqRemoteRangeStateV1 $job $program $maximum (+ $sequence 1) $limit $chunk $query) $keys $bytes))
             ($failure (remote-range:fail $state $failure $keys $bytes))))
          (remote-range:fail $state (KbRefused range-sequence-or-record-policy) $keys $bytes)))
       ((DbRangeEndV1 $same $keys $bytes)
        (if (== $same $sequence)
          (let $_ (store:close $job) (KqEnd $keys $bytes))
          (remote-range:fail $state (KbRefused range-sequence) $keys $bytes)))
       ((DbRangeFailedV1 $failure $keys $bytes) (remote-range:fail $state $failure $keys $bytes))
       ($failure (remote-range:fail $state (KbRefused remote-range-source $failure) 0 0))))))
(= (remote-range:packet $job $sequence $part $length $maximum $offset $bytes)
  (if (== $offset $length) (StoreDecodedPacketV1 $bytes)
    (case (store:remote-use $job DbRangeRead (DbRangeReadV1 $sequence $part $offset $maximum))
      (((DbRangeChunkV1 (StoreCandidateChunk 0 $same $at $chunk))
        (let $size (str:byte-length $chunk)
          (if (and (and (== $same $part) (== $at $offset)) (and (> $size 0) (<= (+ $offset $size) $length)))
            (remote-range:packet $job $sequence $part $length $maximum (+ $offset $size) (str:concat $bytes $chunk))
            (KbRefused range-chunk-sequence))))
       ($failure (KbRefused range-chunk $failure))))))
(= (remote-range:point $job $sequence $body-size $identity-size $chunk $program $maximum)
  (case (remote-range:packet $job $sequence body $body-size $chunk 0 "")
    (((StoreDecodedPacketV1 $body)
      (case (remote-range:packet $job $sequence identity $identity-size $chunk 0 "")
        (((StoreDecodedPacketV1 $identity)
          (case (store:decode $body)
            (((StoreDecoded $atom)
              (case (store:decode $identity)
                (((StoreDecoded $reference) (remote-range:original $atom $reference $program $maximum))
                 ($failure $failure))))
             ($failure $failure))))
         ($failure $failure))))
     ($failure $failure))))
(: remote-range:original (-> Atom Atom String Number %Undefined%))
(= (remote-range:original $atom $reference $program $maximum)
  (case (store:source-single $atom $reference)
    (((StoreSourceOpened $source $_ $_)
      (let* (($space (store:source-space $source)) ($_ (store:close $source))
             ($opened (remote-range:query $space $program)) ($_ (store:close $space)))
        (case $opened
          (((StoreQueryOpened $query $_ $_) (KqReady (KqSpaceStateV1 $query 0 $maximum 0 0)))
           ($failure $failure)))))
     ($failure $failure))))
(= (remote-range:query $space $program)
  (case (store:decode $program)
    (((StoreDecoded (KqMatch $pattern $template)) (store:space-query-source $space $pattern $template))
     ($failure $failure))))
