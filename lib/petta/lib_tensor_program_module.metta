; A language's constructor sorts and argument slots govern the executable
; family contracts. Implementation recipes are supplied as the same inert
; data accepted by ordinary family registration, never as evaluator callbacks.
!(import! &self (library lib_tensor_program))
!(import! &self (library lib_scoped_module))

(= (tensor-program:implementation $name $implementations)
   (if (== $implementations ()) TP:None
     (case (car-atom $implementations)
       (((TP:Implementation $label $recipe)
         (if (== $label $name) (TP:Some $recipe)
           (tensor-program:implementation $name (cdr-atom $implementations)))) ($other TP:None)))))
(= (tensor-program:implementations? $rows $names)
   (if (== (get-metatype $rows) Expression)
     (if (== $rows ()) True
       (case (car-atom $rows)
         (((TP:Implementation $name $recipe)
           (and (binary-schema:text? $name)
             (and (not (binary-schema:member? $name $names))
               (let $later (cons-atom $name $names)
                 (tensor-program:implementations? (cdr-atom $rows) $later))))) ($other False)))) False))
(= (tensor-program:slot-sorts $slots)
   (if (== $slots ()) (TP:Some ())
     (case (car-atom $slots)
       (((Scoped:Slot () $sort)
         (case (tensor-program:slot-sorts (cdr-atom $slots))
           (((TP:Some $rest) (let $sorts (cons-atom $sort $rest) (TP:Some $sorts))) ($other TP:None))))
        ($other TP:None)))))
(= (tensor-program:project-operators $operators $implementations)
   (if (== $operators ()) (TP:Some ())
     (case (car-atom $operators)
       (((Scoped:Operator $name $result $slots)
         (case ((tensor-program:slot-sorts $slots)
                (tensor-program:implementation $name $implementations)
                (tensor-program:project-operators (cdr-atom $operators) $implementations))
           ((((TP:Some $inputs) (TP:Some $recipe) (TP:Some $rest))
             (let $rows (cons-atom (TP:Operator $name $inputs $result $recipe) $rest) (TP:Some $rows)))
            ($other TP:None)))) ($other TP:None)))))
(= (tensor-program:family-from-language $language $implementations)
   (if (tensor-program:implementations? $implementations ())
     (case (scoped:family-from-language $language ())
       (((IC:Some (Scoped:Family $sorts $operators ()))
         (case (tensor-program:project-operators $operators $implementations)
           (((TP:Some $rows)
             (let $family (TP:Family "TF1" $rows)
               (if (tensor-program:family? $family) (TP:Some $family) (TP:Fault Contract))))
            ($other (TP:Fault Projection))))) ($other (TP:Fault Language))))
     (TP:Fault Implementations)))
