; Evaluation-position source traversal. This inventory describes argument
; demand in the standard PeTTa profile, not purity or native execution rights.
; Binding declarations, case patterns, quotation and unknown operand roles
; are not rewrite sites. Bound source ordinals are retained at every site.
; PeTTa observes get-metatype after evaluating its argument. It can therefore
; retain a strict value observation in a skeleton; this grants no purity or
; arbitrary-syntax reflection permission, and redefinitions remain refused.
!(import! &self (library lib_source_scope))

(= (source-context:operations)
   (("+" 2) ("-" 2) ("*" 2) ("/" 2) ("%" 2) ("==" 2)
    ("<" 2) (">" 2) ("<=" 2) (">=" 2) ("if" 3)
    ("and" 2) ("or" 2) ("not" 1) ("get-metatype" 1)))
(= (source-context:call $term)
   (case $term
     (((Syntax:Expr $children)
       (if (== $children ()) Ctx:None
         (case (car-atom $children)
           (((Syntax:Literal Symbol $bytes)
             (let* (($name (binary:from-utf8 $bytes)) ($arguments (cdr-atom $children)))
               (Ctx:Call $name $arguments))) ($ctx-fallback-0 Ctx:None))))) ($ctx-fallback-1 Ctx:None))))
(= (source-context:split? $term)
   (source-context:split-with? (source-context:operations) $term))
(= (source-context:binding-head? $name)
   (binary-schema:member? $name
     ("let" "let*" "case" "map-atom" "filter-atom" "foldl-atom" "quote" "|->" "superpose")))
(= (source-context:split-with? $operations $term)
   (case (source-context:call $term)
     (((Ctx:Call $name $arguments)
       (if (binary-schema:member? ($name (size-atom $arguments)) $operations)
         (Ctx:Call $name $arguments) Ctx:None)) ($ctx-fallback-2 Ctx:None))))
(= (source-context:variables $term)
   (case $term
     (((Syntax:Variable $index) ($index))
      ((Syntax:Literal $kind $bytes) ())
      ((Syntax:Expr $children)
       (foldl-atom $children () $out $child (union-atom $out (source-context:variables $child)))))))
(= (source-context:available? $term $bound)
   (case $term
     (((Syntax:Variable $index) (binary-schema:member? $index $bound))
      ((Syntax:Literal $kind $bytes) True)
      ((Syntax:Expr $children)
       (foldl-atom $children True $valid $child (and $valid (source-context:available? $child $bound))))
      ($ctx-fallback-3 False))))
(= (source-context:path $path $index) (union-atom $path ($index)))
(= (source-context:walk-list-with $profile $form $path $bound $terms $index)
   (if (== $terms ()) ()
     (union-atom (source-context:walk-profile $profile $form (source-context:path $path $index) $bound (car-atom $terms))
       (source-context:walk-list-with $profile $form $path $bound (cdr-atom $terms) (+ $index 1)))))
(= (source-context:bindings-with $profile $form $path $bound $rows $index $body $body-path)
   (if (== $rows ()) (source-context:walk-profile $profile $form $body-path $bound $body)
     (case (car-atom $rows)
       (((Syntax:Expr ($pattern $value))
         (let* (($row-path (source-context:path $path $index))
                ($first (source-context:walk-profile $profile $form (source-context:path $row-path 1) $bound $value))
                ($next (union-atom $bound (source-context:variables $pattern))))
           (union-atom $first (source-context:bindings-with $profile $form $path $next (cdr-atom $rows)
             (+ $index 1) $body $body-path)))) ($ctx-fallback-4 ())))))
(= (source-context:cases-with $profile $form $path $bound $rows $index)
   (if (== $rows ()) ()
     (case (car-atom $rows)
       (((Syntax:Expr ($pattern $body))
         (let* (($row-path (source-context:path $path $index))
                ($next (union-atom $bound (source-context:variables $pattern))))
           (union-atom (source-context:walk-profile $profile $form (source-context:path $row-path 1) $next $body)
             (source-context:cases-with $profile $form $path $bound (cdr-atom $rows) (+ $index 1))))) ($ctx-fallback-5 ())))))
(= (source-context:walk $form $path $bound $term)
   (let* (($operations (source-context:operations)) ($profile (Ctx:Traversal $operations ())))
     (source-context:walk-profile $profile $form $path $bound $term)))
(= (source-context:walk-with $operations $form $path $bound $term)
   (let* (($ordinary (filter-atom $operations $entry
             (case $entry ((($name $arity) (not (source-context:binding-head? $name))) ($invalid False)))))
          ($profile (Ctx:Traversal $ordinary $operations)))
     (source-context:walk-profile $profile $form $path $bound $term)))
(= (source-context:walk-profile $profile $form $path $bound $term)
   (case $profile
     (((Ctx:Traversal $operations $syntax)
       (case (source-context:split-with? $operations $term)
     (((Ctx:Call $name $arguments)
       (let $site (if (source-context:available? $term $bound) ((Ctx:Site $form $path $bound $term)) ())
         (union-atom $site (source-context:walk-list-with $profile $form $path $bound $arguments 1))))
      ($ctx-fallback-6
       (case (source-context:call $term)
         (((Ctx:Call "let" ($pattern $value $body))
           (union-atom (source-context:walk-profile $profile $form (source-context:path $path 2) $bound $value)
             (source-context:walk-profile $profile $form (source-context:path $path 3)
               (union-atom $bound (source-context:variables $pattern)) $body)))
          ((Ctx:Call "let*" ((Syntax:Expr $rows) $body))
           (source-context:bindings-with $profile $form (source-context:path $path 1) $bound $rows 0 $body
             (source-context:path $path 2)))
          ((Ctx:Call "case" ($value (Syntax:Expr $rows)))
           (union-atom (source-context:walk-profile $profile $form (source-context:path $path 1) $bound $value)
             (source-context:cases-with $profile $form (source-context:path $path 2) $bound $rows 0)))
          ((Ctx:Call "map-atom" ($items (Syntax:Variable $index) $body))
           (source-context:map-with $profile $form $path $bound $items $index $body))
          ((Ctx:Call "filter-atom" ($items (Syntax:Variable $index) $body))
           (source-context:map-with $profile $form $path $bound $items $index $body))
          ((Ctx:Call "foldl-atom" ($items $initial (Syntax:Variable $acc) (Syntax:Variable $item) $step))
           (union-atom (source-context:walk-profile $profile $form (source-context:path $path 1) $bound $items)
             (union-atom (source-context:walk-profile $profile $form (source-context:path $path 2) $bound $initial)
               (source-context:walk-profile $profile $form (source-context:path $path 5) (union-atom $bound ($acc $item)) $step))))
          ((Ctx:Call "|->" ((Syntax:Expr ()) $body))
           (if (binary-schema:member? ("|->" 2) $syntax)
             (source-context:walk-profile $profile $form (source-context:path $path 2) $bound $body) ()))
          ((Ctx:Call "superpose" ((Syntax:Expr $answers)))
           (if (binary-schema:member? ("superpose" 1) $syntax)
             (source-context:walk-list-with $profile $form (source-context:path $path 1) $bound $answers 0) ()))
          ($ctx-fallback-7 ()))))))))))
(= (source-context:map-with $profile $form $path $bound $items $index $body)
   (union-atom (source-context:walk-profile $profile $form (source-context:path $path 1) $bound $items)
     (source-context:walk-profile $profile $form (source-context:path $path 3) (union-atom $bound ($index)) $body)))

; Replacements are admitted disjoint paths. The selected term is returned
; without traversing its newly introduced helper call or delayed arguments.
(= (source-context:lookup $replacements $form $path)
   (if (== $replacements ()) Ctx:None
     (case (car-atom $replacements)
       (((Ctx:Replacement $owner $where $value)
         (if (and (== $owner $form) (== $where $path)) (Ctx:Some $value)
           (source-context:lookup (cdr-atom $replacements) $form $path)))))))
(= (source-context:rewrite-term $replacements $form $path $term)
   (case (source-context:lookup $replacements $form $path)
     (((Ctx:Some $value) $value)
      (Ctx:None
       (case $term
         (((Syntax:Expr $children)
           (Syntax:Expr (source-context:rewrite-many $replacements $form $path $children 0))) ($ctx-fallback-8 $term)))))))
(= (source-context:rewrite-many $replacements $form $path $terms $index)
   (if (== $terms ()) ()
     (let* (($value (source-context:rewrite-term $replacements $form (source-context:path $path $index) (car-atom $terms)))
            ($rest (source-context:rewrite-many $replacements $form $path (cdr-atom $terms) (+ $index 1))))
       (cons-atom $value $rest))))
(= (source-context:rewrite-forms $replacements $forms $index)
   (if (== $forms ()) ()
     (case (car-atom $forms)
       (((Syntax:Form $names $term)
         (let* (($value (source-context:rewrite-term $replacements $index () $term))
                ($rest (source-context:rewrite-forms $replacements (cdr-atom $forms) (+ $index 1))))
           (cons-atom (Syntax:Form $names $value) $rest)))))))
(= (source-context:prefix? $prefix $path)
   (if (== $prefix ()) True
     (if (== $path ()) False
       (and (== (car-atom $prefix) (car-atom $path)) (source-context:prefix? (cdr-atom $prefix) (cdr-atom $path))))))
(= (source-context:covered? $selected $form $path)
   (if (== $selected ()) False
     (case (car-atom $selected)
       (((Ctx:Replacement $owner $where $value)
         (or (and (== $owner $form) (source-context:prefix? $where $path))
           (source-context:covered? (cdr-atom $selected) $form $path)))))))
