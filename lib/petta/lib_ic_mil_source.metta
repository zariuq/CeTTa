; Explicit source-backed MIL vocabulary. Preparation compiles lexical closures
; from a checked library prefix, never installs equations and never runs bodies.
; The portable SB1 dictionary charges source, reader, constructors and type rows.
; Execution and example testing remain ordinary relational MeTTa operations.
!(import! &self (library lib_ic_library_transfer))
!(import! &self (library lib_binary_value))
!(import! &self "../ilp/metagol_core.metta")
!(import! &self "../ilp/metagol_prime.metta")

(= (mil-source:operations)
   (union-atom (source-library:operations) (("get-metatype" 1) ("|->" 2) ("quote" 1))))
(= (mil-source:name? $name)
   (if (binary-schema:text? $name)
     (case (syntax:read (str:concat "(" (str:concat $name ")")))
       (((Syntax:Document $version $reader ((Syntax:Form () (Syntax:Expr ((Syntax:Literal Symbol $bytes))))))
         (== $bytes (binary:utf8 $name))) ($invalid False))) False))
(= (mil-source:prefix $count $forms)
   (if (== $count 0) ()
     (cons-atom (car-atom $forms) (mil-source:prefix (- $count 1) (cdr-atom $forms)))))
(= (mil-source:schema)
   (cons-atom (Binary:Form 9 MIL.SourceArchive (Text Bytes (Record Syntax:Document)))
     (source-codec:schema)))
(= (mil-source:pack $family $document)
   (case (binary-value:pack $family)
     (((Binary:TreeBytes $metadata)
       (binary-schema:encode (mil-source:schema) (Record MIL.SourceArchive)
         (MIL.SourceArchive "SB1" $metadata $document)))
      ($invalid (MIL.SourceRefused Family)))))
(= (mil-source:unpack $bytes)
   (case (binary-schema:decode (mil-source:schema) (Record MIL.SourceArchive) $bytes)
     (((Binary:Value (MIL.SourceArchive "SB1" $metadata $document))
       (case (binary-value:unpack $metadata)
         (((BinaryValue:Value $family)
           (if (source-codec:valid? $document) (MIL.SourceBundle $family $document)
             (MIL.SourceRefused InvalidSource)))
          ($invalid-family (MIL.SourceRefused Family)))))
      ($invalid (MIL.SourceRefused InvalidArchive)))))
(= (ic:source-background $artifact $family)
   (case (library-stack:view $artifact)
     (((Library:StackValue $layers (Syntax:Document $version $reader $forms) $original)
       (if (== $layers ()) (MIL.SourceRefused NoLearnedLibrary)
         (case (mil-source:pack $family
                 (Syntax:Document $version $reader (mil-source:prefix (size-atom $layers) $forms)))
           (((Binary:TreeBytes $bytes) (MIL.SourceBytes $bytes)) ($failed $failed)))))
      ($invalid (MIL.SourceRefused InvalidLibrary)))))

; Constructor rows describe data positions, not arbitrary external calls.
; The current source view is checked for equations overriding these heads.
(= (mil-source:constructors? $constructors $seen)
   (if (== (binary:value-kind $constructors) Expression)
     (if (== $constructors ()) True
       (case (car-atom $constructors)
         (((MIL.SourceConstructor $name $arity)
           (and (mil-source:name? $name)
             (and (not (syntax:intrinsic-head? (binary:from-symbol-utf8 (binary:utf8 $name))))
              (and (binary:unsigned? $arity)
               (and (not (binary-schema:member? $name $seen))
                 (and (not (foldl-atom (mil-source:operations) False $found $row
                               (or $found (== $name (car-atom $row)))))
                   (mil-source:constructors? (cdr-atom $constructors) (cons-atom $name $seen))))))))
          ($invalid False)))) False))
(= (mil-source:constructor-rows $constructors)
   (map-atom $constructors $row
     (case $row (((MIL.SourceConstructor $name $arity) ($name $arity))))))
(= (mil-source:helper-rows $forms)
   (if (== $forms ()) (MIL.SourceRows ())
     (case ((source-library:parse-clause (car-atom $forms)) (mil-source:helper-rows (cdr-atom $forms)))
       ((((IC:Some (Library:Clause $names $head $left $body $arity)) (MIL.SourceRows $later))
         (case $head
           (((Syntax:Literal Symbol $bytes)
             (let $row ((binary:from-utf8 $bytes) $arity)
               (MIL.SourceRows (cons-atom $row $later)))))))
        ($invalid (MIL.SourceRefused Definitions))))))
(= (mil-source:distinct-heads? $rows $seen)
   (if (== $rows ()) True
     (case (car-atom $rows)
       ((($name $arity)
         (and (mil-source:name? $name)
           (and (not (binary-schema:member? $name $seen))
             (mil-source:distinct-heads? (cdr-atom $rows) (cons-atom $name $seen)))))))))

; Admission follows code/value roles. Unknown operations and binding forms are
; refused. The admitted thunk has no binders; quotation is retained verbatim.
; This is deliberately smaller than the general source language.
(= (mil-source:term? $operations $constructors $arity $term)
   (case $term
     (((Syntax:Variable $index) (and (binary:unsigned? $index) (< $index $arity)))
      ((Syntax:Literal Symbol $bytes)
       (or (== $bytes (binary:utf8 "true"))
         (or (== $bytes (binary:utf8 "false"))
           (binary-schema:member? ((binary:from-utf8 $bytes) 0) $constructors))))
      ((Syntax:Literal $kind $bytes) (source-library:scalar-kind? $kind))
      ((Syntax:Expr ((Syntax:Variable $index)))
       (and (binary:unsigned? $index) (< $index $arity)))
      ((Syntax:Expr ()) True)
      ($other
       (case (source-context:call $term)
         (((Ctx:Call "quote" ($value)) (source-context:available? $value ()))
          ((Ctx:Call "|->" ((Syntax:Expr ()) $body))
           (mil-source:term? $operations $constructors $arity $body))
          ((Ctx:Call "superpose" ((Syntax:Expr $answers)))
           (mil-source:terms? $operations $constructors $arity $answers))
          ((Ctx:Call $name $arguments)
           (and (not (source-context:binding-head? $name))
             (and (binary-schema:member? ($name (size-atom $arguments)) $operations)
               (mil-source:terms? $operations $constructors $arity $arguments))))
          ($invalid False)))))))
(= (mil-source:terms? $operations $constructors $arity $terms)
   (if (== $terms ()) True
     (and (mil-source:term? $operations $constructors $arity (car-atom $terms))
       (mil-source:terms? $operations $constructors $arity (cdr-atom $terms)))))
; Static choice vectors contain code positions, not an evaluated call headed
; by their first alternative. Keep that vector explicit in the projection.
(= (mil-source:project $operations $term)
   (case (source-context:call $term)
     (((Ctx:Call "superpose" ((Syntax:Expr $alternatives)))
       (Binary:Node (binary:utf8 "SourceChoice")
         ((Binary:Node (binary:utf8 "SourceAlternatives")
            (map-atom $alternatives $alternative (mil-source:project $operations $alternative))))))
      ($other
       (case (source-context:split-with? $operations $term)
         (((Ctx:Call $name $arguments)
           (Binary:Node (binary:utf8 $name)
             (map-atom $arguments $argument (mil-source:project $operations $argument))))
          ($opaque (context-library:project-with () 0 $term))))))))
(= (mil-source:interface $operations $arity $body)
   (case (ic:prepare-trees Constructors ((mil-source:project $operations $body)))
     (((IC:ConstructorArchive $archive)
       (case (ic-archive:prepare $archive)
         (((IC:PreparedArchive $tree (IC:Catalog $v $o $signature $heads $literals)
              ((IC:Packet ((IC:Slot Root ByteTree)) ($node))))
           (case (library-transfer:pattern $heads $literals 0 $arity Value $node)
             (((Ctx:Template $pattern $demands)
               (case (ic-template:admit-list $signature ((IC:Slot Value ByteTree)) ($pattern) ())
                 (((IC:Some $bindings)
                   (if (== (size-atom $bindings) $arity)
                     (library-transfer:interface $bindings $demands $arity 0) Ctx:None))
                  ($invalid Ctx:None)))) ($invalid Ctx:None))))
          ($invalid Ctx:None)))) ($invalid Ctx:None))))
(= (mil-source:entries $operations $constructors $forms $index $offset)
   (if (== $forms ()) (MIL.SourceEntries () $offset)
     (case (source-library:parse-clause (car-atom $forms))
       (((IC:Some (Library:Clause $names (Syntax:Literal Symbol $name) $left $body $arity))
         (if (mil-source:term? $operations $constructors $arity $body)
           (case (mil-source:interface $operations $arity $body)
             (((Ctx:Interface $ports $ready)
               (let $next (+ $offset (+ (size-atom $names) (+ $arity 1)))
                 (case (mil-source:entries $operations $constructors (cdr-atom $forms) (+ $index 1) $next)
                   (((MIL.SourceEntries $later $count)
                     (let $entry (MIL.SourceEntry $index (binary:from-utf8 $name) $names $body $arity $ready $offset)
                       (MIL.SourceEntries (cons-atom $entry $later) $count)))
                    ($failed $failed)))))
              ($invalid-interface (MIL.SourceRefused UnsupportedInterface))))
           (MIL.SourceRefused UnsupportedBody)))
        ($invalid (MIL.SourceRefused Definitions))))))
(= (mil-source:entry $entries $name)
   (if (== $entries ()) MIL.SourceMissing
     (case (car-atom $entries)
       (((MIL.SourceEntry $index $actual $names $body $arity $ready $offset)
         (if (== $name $actual) (car-atom $entries) (mil-source:entry (cdr-atom $entries) $name)))))))

(= (mil-source:rebase $offset $term)
   (case $term
     (((Syntax:Variable $index) (Syntax:Variable (+ $offset $index)))
      ((Syntax:Literal $kind $bytes) $term)
      ((Syntax:Expr $children)
       (Syntax:Expr (map-atom $children $child (mil-source:rebase $offset $child)))))))
(= (mil-source:link-sites $entries $sites)
   (if (== $sites ()) ()
     (case (car-atom $sites)
       (((Ctx:Site $form $path $bound $term)
         (let $later (mil-source:link-sites $entries (cdr-atom $sites))
           (case (source-context:call $term)
             (((Ctx:Call $name $arguments)
               (case (mil-source:entry $entries $name)
                 (((MIL.SourceEntry $index $actual $names $body $arity $ready $offset)
                   (cons-atom (Ctx:Replacement $form (source-context:path $path 0) (Syntax:Variable $index)) $later))
                  ($not-helper $later)))) ($not-call $later)))))))))
(= (mil-source:lambda $parameters $body)
   (Syntax:Expr ((source-library:symbol "|->") (Syntax:Expr $parameters) $body)))
(= (mil-source:raw $operations $entries (MIL.SourceEntry $index $name $names $body $arity $ready $offset))
   (let* (($rebased (mil-source:rebase $offset $body))
          ($bound (map-atom (source-scope:indices $arity 0) $port (+ $offset $port)))
          ($sites (source-context:walk-with $operations 0 () $bound $rebased))
          ($replacements (mil-source:link-sites $entries $sites))
          ($linked (source-context:rewrite-term $replacements 0 () $rebased))
          ($parameters (map-atom $bound $port (Syntax:Variable $port))))
     (mil-source:lambda $parameters $linked)))
(= (mil-source:arguments $arity $ready $start $index)
   (if (== $index $arity) ()
     (let* (($value (Syntax:Variable (+ $start $index)))
            ($argument (if (binary-schema:member? (Ctx:Ready Value $index) $ready)
                         $value (context-library:delay $value)))
            ($later (mil-source:arguments $arity $ready $start (+ $index 1))))
       (cons-atom $argument $later))))
(= (mil-source:adapter (MIL.SourceEntry $index $name $names $body $arity $ready $offset))
   (let* (($argument (+ $offset (size-atom $names)))
          ($start (if (== $arity 1) $argument (+ $argument 1)))
          ($arguments (mil-source:arguments $arity $ready $start 0))
          ($call (Syntax:Expr (cons-atom (Syntax:Variable $index) $arguments)))
          ($adapted-body (if (== $arity 1) $call
                   (let $pattern (Syntax:Expr (cons-atom (source-library:symbol "MIL.Args")
                          (map-atom (source-scope:indices $arity 0) $port (Syntax:Variable (+ $start $port)))))
                     (Syntax:Expr ((source-library:symbol "let") $pattern (Syntax:Variable $argument) $call))))))
     (mil-source:lambda ((Syntax:Variable $argument)) $adapted-body)))
(= (mil-source:bind $operations $entries $ordered $body)
   (if (== $ordered ()) $body
     (case (car-atom $ordered)
       (((Library:Helper $name $ignored)
         (let* (($entry (mil-source:entry $entries $name))
                ($raw (mil-source:raw $operations $entries $entry))
                ($later (mil-source:bind $operations $entries (cdr-atom $ordered) $body)))
           (case $entry
             (((MIL.SourceEntry $index $n $names $term $arity $ready $offset)
               (Syntax:Expr ((source-library:symbol "let") (Syntax:Variable $index) $raw $later)))))))))))
(= (mil-source:list-code $values)
   (if (== $values ()) (Syntax:Expr ())
     (Syntax:Expr ((source-library:symbol "cons-atom") (car-atom $values)
                   (mil-source:list-code (cdr-atom $values))))))
(= (mil-source:position $values $needle $index)
   (if (== $values ()) $index
     (if (== (car-atom $values) $needle) $index
       (mil-source:position (cdr-atom $values) $needle (+ $index 1)))))
(= (mil-source:canonical $term $seen)
   (case $term
     (((Syntax:Variable $index)
       (let* (($position (mil-source:position $seen $index 0))
              ($next (if (== $position (size-atom $seen)) (union-atom $seen ($index)) $seen)))
         (MIL.SourceCanonical (Syntax:Variable $position) $next)))
      ((Syntax:Literal $kind $bytes) (MIL.SourceCanonical $term $seen))
      ((Syntax:Expr $children)
       (case (mil-source:canonicals $children $seen)
         (((MIL.SourceCanonical $terms $next) (MIL.SourceCanonical (Syntax:Expr $terms) $next))))))))
(= (mil-source:canonicals $terms $seen)
   (if (== $terms ()) (MIL.SourceCanonical () $seen)
     (case (mil-source:canonical (car-atom $terms) $seen)
       (((MIL.SourceCanonical $first $next)
         (case (mil-source:canonicals (cdr-atom $terms) $next)
           (((MIL.SourceCanonical $later $last)
             (MIL.SourceCanonical (cons-atom $first $later) $last)))))))))
(= (mil-source:render-factory $reader (MIL.SourceCanonical $term $seen))
   (let* (($names (map-atom (source-scope:indices (size-atom $seen) 0) $index
                    (Syntax:PlainName (str:concat "mil_source_" (str:number->string $index)))))
          ($document (Syntax:Document "ST1" $reader ((Syntax:Form $names $term))))
          ($text (syntax:write $document)))
     (if (== (syntax:read $text) $document)
       (let* (($code (parse $text)) ($factory (eval $code))) ($factory))
       (MIL.SourceRefused Unrenderable))))
(= (mil-source:factory $operations $entries $ordered $reader $count)
   (let* (($adapters (map-atom $entries $entry (mil-source:adapter $entry)))
          ($body (Syntax:Expr ((source-library:symbol "MIL.SourceCallables") (mil-source:list-code $adapters))))
          ($bound (mil-source:bind $operations $entries $ordered $body)))
     (if (source-context:available? $bound (source-scope:indices $count 0))
       (mil-source:render-factory $reader (mil-source:canonical (mil-source:lambda () $bound) ()))
       (MIL.SourceRefused VariableRange))))

; Query the visible source, including imports. A local atom enumeration does
; not contain imported equations and cannot establish this admission check.
(= (mil-source:overridden-at? $reader $name $arity $bare)
   (let* (($names (map-atom (source-scope:indices (+ $arity 1) 0) $index
                    (Syntax:PlainName (str:concat "mil_query_" (str:number->string $index)))))
          ($arguments (map-atom (source-scope:indices $arity 0) $index (Syntax:Variable $index)))
          ($left (if $bare (source-library:symbol $name)
                   (Syntax:Expr (cons-atom (source-library:symbol $name) $arguments))))
          ($term (Syntax:Expr ((source-library:symbol "=") $left (Syntax:Variable $arity))))
          ($document (Syntax:Document "ST1" $reader ((Syntax:Form $names $term))))
          ($pattern (parse (syntax:write $document))))
     (not (== (collapse (match (context-space) $pattern True)) ()))))
(= (mil-source:overridden? $reader $name $arity)
   (or (mil-source:overridden-at? $reader $name $arity False)
     (mil-source:overridden-at? $reader $name 0 True)))
(= (mil-source:standard? $reader $rows)
   (if (== $rows ()) True
     (case (car-atom $rows)
       ((($name $arity)
         (and (not (mil-source:overridden? $reader $name $arity))
           (mil-source:standard? $reader (cdr-atom $rows))))))))
(= (mil-source:frame-rows $helpers)
   (union-atom (("let" 3) ("MIL.SourceCallables" 1) ("true" 0) ("false" 0))
     (map-atom $helpers $row (case $row ((($name $arity) ("MIL.Args" $arity)))))))
(= (mil-source:bindings $entries $bindings $seen)
   (if (== (binary:value-kind $bindings) Expression)
     (if (== $bindings ()) (MIL.SourceTypes ())
       (case (car-atom $bindings)
         (((MIL.SourceBinding $name (MIL.Rel $input $output))
           (if (binary-schema:member? $name $seen) (MIL.SourceRefused DuplicateBinding)
             (case ((mil-source:entry $entries $name)
                    (mil-source:bindings $entries (cdr-atom $bindings) (cons-atom $name $seen)))
               ((((MIL.SourceEntry $index $n $names $body $arity $ready $offset) (MIL.SourceTypes $later))
                 (MIL.SourceTypes (cons-atom (MIL.TypeRow (MIL.SourceRef $index) (MIL.Rel $input $output)) $later)))
                ($invalid (MIL.SourceRefused Binding))))))
          ($invalid (MIL.SourceRefused Binding))))) (MIL.SourceRefused Binding)))
(= (mil-source:publish $guards $family $document $types $result)
   (case $result
     (((MIL.SourceCallables $callables)
       (if (ic-search:guards-current? $guards)
         (MIL.SourcePrepared $family $document $types (MIL.SourceRuntime $guards $callables))
         (MIL.SourceRefused SourceChanged)))
      ($failed $failed))))
(= (mil-source:environment $operations $data $forms)
   (case (mil-source:entries $operations $data $forms 0 (size-atom $forms))
     (((MIL.SourceEntries $entries $count)
       (let $helpers (map-atom $entries $entry
               (case $entry (((MIL.SourceEntry $i $n $ns $body $a $r $o) (Library:Helper $n $body)))))
         (case (library-stack:waves $helpers (size-atom $entries) ())
           (((Library:Waves $waves)
             (let $ordered (foldl-atom $waves () $out $wave (union-atom $out $wave))
               (MIL.SourceEnvironment $entries $count $ordered)))
            ($invalid (MIL.SourceRefused Dependencies))))))
      ($failed $failed))))
(= (mil-source:prepare-entries $guards $family $document $reader $operations $data $bindings $forms)
   (case (mil-source:environment $operations $data $forms)
     (((MIL.SourceEnvironment $entries $count $ordered)
       (case (mil-source:bindings $entries $bindings ())
         (((MIL.SourceTypes $types)
           (mil-source:publish $guards $family $document $types
             (mil-source:factory $operations $entries $ordered $reader $count)))
          ($invalid (MIL.SourceRefused Dependencies)))))
      ($failed $failed))))
(= (mil-source:prepare $guards $family $document)
   (case ($family $document)
     ((((MIL.SourceFamily $constructors $bindings) (Syntax:Document "ST1" $reader $forms))
       (if (and (source-library:current-reader? $reader) (mil-source:constructors? $constructors ()))
         (case (mil-source:helper-rows $forms)
           (((MIL.SourceRows $helpers)
             (let* (($data (mil-source:constructor-rows $constructors))
                    ($operations (union-atom (mil-source:operations) (union-atom $data $helpers))))
               (if (and (not (== $forms ())) (mil-source:distinct-heads? $operations ()))
                 (if (mil-source:standard? $reader
                       (union-atom (mil-source:frame-rows $helpers) (union-atom $data (mil-source:operations))))
                   (mil-source:prepare-entries $guards $family $document $reader $operations $data $bindings $forms)
                   (MIL.SourceRefused NonstandardOperators))
                 (MIL.SourceRefused Names))))
            ($failed $failed)))
         (MIL.SourceRefused Family)))
      ($invalid (MIL.SourceRefused Family)))))
(= (ic:prepare-background Source:MIL $bytes $sources)
   (case ((mil-source:unpack $bytes) (ic-search:guards (cons-atom (context-space) $sources)))
     ((((MIL.SourceBundle $family $document) (IC:Some $guards))
       (mil-source:prepare $guards $family $document))
      ($invalid (MIL.SourceRefused Preparation)))))

(= (mil:run (MIL.SourceRuntime $guards $callables) (MIL.SourceRef $index) $input)
   (if (ic-search:guards-current? $guards)
     (case (ic-template:operator $callables $index)
       (((IC:Some $callable)
         (let $output ($callable $input)
           (if (ic-search:guards-current? $guards) $output (superpose ()))))
        ($missing (superpose ())))) (superpose ())))
(= (mil:run (MIL.SourceRuntime $guards $callables) (MIL.HO1 MIL.MapOp $program) $input)
   (mil:map-run (MIL.SourceRuntime $guards $callables) $program $input))
(= (ic:run-background (MIL.SourcePrepared $family $document $types (MIL.SourceRuntime $guards $callables)) $program $input)
   (if (ic-search:guards-current? $guards)
     (let $outputs (mil:outputs (MIL.SourceRuntime $guards $callables) $program $input)
       (if (ic-search:guards-current? $guards) (MIL.SourceOutputs $outputs) (MIL.SourceRefused SourceChanged)))
     (MIL.SourceRefused SourceChanged)))
