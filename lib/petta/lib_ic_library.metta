; Whole-body source helpers for the explicit entered-value profile. Source
; variables retain their original form-local identities. Learning returns a
; reviewable source artifact; it never installs equations into an application.
!(import! &self (library lib_ic_source_archive))
!(import! &self (library lib_source_scope))
!(import! &self (library str))

(= (source-library:operations)
   (("+" 2) ("-" 2) ("*" 2) ("/" 2) ("%" 2)
    ("==" 2) ("<" 2) (">" 2) ("<=" 2) (">=" 2)
    ("if" 3) ("and" 2) ("or" 2) ("not" 1) ("superpose" 1)
    ("cons-atom" 2) ("union-atom" 2) ("car-atom" 1) ("cdr-atom" 1)
    ("size-atom" 1) ("index-atom" 2) ("println!" 1)))
(= (source-library:literal-symbol? $term $name)
   (case $term
     (((Syntax:Literal Symbol $bytes) (== $bytes (binary:utf8 $name))) ($other False))))
(= (source-library:scalar-kind? $kind)
   (or (== $kind I64) (or (== $kind F64) (or (== $kind BigInt)
     (or (== $kind Rational) (or (== $kind Bool) (== $kind String)))))))

(= (source-library:ports? $arguments $index)
   (if (== $arguments ()) True
     (case (car-atom $arguments)
       (((Syntax:Variable $actual)
         (and (== $actual $index) (source-library:ports? (cdr-atom $arguments) (+ $index 1))))
        ($other False)))))
(= (source-library:plain-names? $names)
   (if (== $names ()) True
     (case (car-atom $names)
       (((Syntax:PlainName $name) (source-library:plain-names? (cdr-atom $names))) ($other False)))))

(= (source-library:parse-clause $form)
   (case $form
     (((Syntax:Form $names (Syntax:Expr ($equals (Syntax:Expr $left) $body)))
       (if (and (source-library:literal-symbol? $equals "=") (not (== $left ())))
         (let ($head $arguments) (decons-atom $left)
           (case $head
             (((Syntax:Literal Symbol $bytes)
               (let $count (size-atom $arguments)
                 (if (and (not (syntax:intrinsic-head? (binary:from-symbol-utf8 $bytes)))
                          (and (<= $count (size-atom $names))
                            (and (source-library:plain-names? $names)
                              (source-library:ports? $arguments 0))))
                   (IC:Some (Library:Clause $names $head $left $body $count)) IC:None)))
              ($other IC:None)))) IC:None))
      ($other IC:None))))
(= (source-library:clause $form)
   (case (source-library:parse-clause $form)
     (((IC:Some (Library:Clause $names $head $left $body $count))
       (if (source-scope:valid? (source-library:operations) $count (size-atom $names) $body)
         (IC:Some (Library:Clause $names $head $left $body $count)) IC:None))
      ($other IC:None))))

(= (source-library:annotated? $head $forms)
   (if (== $forms ()) False
     (or
       (case (car-atom $forms)
         (((Syntax:Form $names (Syntax:Expr ($colon $subject $type)))
           (and (source-library:literal-symbol? $colon ":") (== $subject $head)))
          ($other False)))
       (source-library:annotated? $head (cdr-atom $forms)))))
(= (source-library:sites $all $forms $index)
   (if (== $forms ()) ()
     (let $rest (source-library:sites $all (cdr-atom $forms) (+ $index 1))
       (case (source-library:clause (car-atom $forms))
         (((IC:Some (Library:Clause $names $head $left $body $count))
           (if (source-library:annotated? $head $all) $rest
             (cons-atom (Library:Site $index $count $body) $rest)))
          ($other $rest))))))

; Source terms are the units of factoring. Variable leaves carry their source
; occurrence so independent rules cannot accidentally share a rigid variable.
(= (source-library:project $origin $ports $names $term)
   (case $term
     (((Syntax:Variable $index)
       (if (< $index $ports)
         (Binary:Leaf (binary:pack-fields
           ((binary:utf8 "Variable") (binary:unsigned $origin) (binary:unsigned $index))))
         (case (ic-template:operator $names $index)
           (((IC:Some (Syntax:PlainName $name))
             (Binary:Leaf (binary:pack-fields
               ((binary:utf8 "Local") (binary:unsigned (- $index $ports)) (binary:utf8 $name)))))))))
      ((Syntax:Literal $kind $bytes)
       (Binary:Leaf (binary:pack-fields ((binary:utf8 "Literal") (binary:symbol-utf8 $kind) $bytes))))
      ((Syntax:Expr $children)
       (let $values (source-library:project-many $origin $ports $names $children)
         (Binary:Node (binary:utf8 "Expr") $values))))))
(= (source-library:project-many $origin $ports $names $terms)
   (if (== $terms ()) ()
     (let* (($head (source-library:project $origin $ports $names (car-atom $terms)))
            ($rest (source-library:project-many $origin $ports $names (cdr-atom $terms))))
       (cons-atom $head $rest))))
(= (source-library:forest $forms $sites)
   (if (== $sites ()) ()
     (case (car-atom $sites)
       (((Library:Site $origin $ports $body)
         (case (ic-template:operator $forms $origin)
           (((IC:Some (Syntax:Form $names $term))
             (let* (($tree (source-library:project $origin $ports $names $body))
                    ($rest (source-library:forest $forms (cdr-atom $sites))))
               (cons-atom $tree $rest))))))))))

(= (ic:prepare-library $document)
   (if (source-codec:valid? $document)
     (case $document
       (((Syntax:Document $version $reader $forms)
         (if (source-library:current-reader? $reader)
           (let $sites (source-library:sites $forms $forms 0)
             (case (ic:prepare-trees (source-library:forest $forms $sites))
               (((IC:TreeArchive $archive) (Library:Prepared $document $archive $sites))
                ($other (Library:Refused InvalidProjection)))))
           (Library:Refused DifferentReader)))))
     (Library:Refused InvalidSource)))
(= (source-library:current-reader? $reader)
   (case $reader
     (((Syntax:Reader "petta" $version "")
       (case (syntax:read "")
         (((Syntax:Document $v $current ()) (== $reader $current)) ($other False))))
      ($other False))))

; Decode only a whole scalar/parameter image. A compound computation cannot
; move into a helper argument, even if its source operator is otherwise pure.
(= (source-library:image $origin $ports $tree)
   (case $tree
     (((Binary:Leaf $bytes)
       (case (binary:unpack-fields $bytes)
         (((Binary:Fields ($tag $first $last))
           (if (== $tag (binary:utf8 "Variable"))
             (let* (($owner (binary:from-unsigned $first)) ($index (binary:from-unsigned $last)))
               (if (and (== $owner $origin) (and (binary:unsigned? $index) (< $index $ports)))
                 (IC:Some (Syntax:Variable $index)) IC:None))
             (if (== $tag (binary:utf8 "Literal"))
               (let $kind (binary:from-symbol-utf8 $first)
                 (if (source-library:scalar-kind? $kind)
                   (IC:Some (Syntax:Literal $kind $last)) IC:None)) IC:None)))
          ($other IC:None))))
      ($other IC:None))))

(= (source-library:parameter-index $holes $role $index $position)
   (if (== $holes ()) IC:None
     (case (car-atom $holes)
       (((IC:Binding $actual $number $sort)
         (if (and (== $role $actual) (== $index $number)) (IC:Some $position)
           (source-library:parameter-index (cdr-atom $holes) $role $index (+ $position 1))))))))
(= (source-library:template $heads $literals $holes $pattern)
   (case $pattern
     (((IC:Hole $role $index)
       (case (source-library:parameter-index $holes $role $index 0)
         (((IC:Some $position) (IC:Some (Syntax:Variable $position))) ($other IC:None))))
      ((IC:Node $index $children)
       (case (ic-template:operator $heads $index)
         (((IC:Some (IC:LiteralRef $literal))
           (case (ic-template:operator $literals $literal)
             (((IC:Some (IC:Literal U8 $bytes))
               (case (binary:unpack-fields $bytes)
                 (((Binary:Fields ($tag $kind $value))
                   (if (and (== $children ()) (== $tag (binary:utf8 "Literal")))
                     (IC:Some (Syntax:Literal (binary:from-symbol-utf8 $kind) $value))
                     (if (and (== $children ()) (== $tag (binary:utf8 "Local")))
                       (let* (($local-index (binary:from-unsigned $kind)) ($next (+ (size-atom $holes) $local-index)))
                         (if (and (binary:unsigned? $local-index) (binary:unsigned? $next))
                           (IC:Some (Syntax:Variable $next)) IC:None)) IC:None)))
                  ($other IC:None))))
              ($other IC:None))))
          ((IC:Some (IC:Name "Binary:Node"))
           (if (== $children ()) IC:None
             (case ((ic-tree-archive:recover $heads $literals (car-atom $children))
                    (source-library:templates $heads $literals $holes (cdr-atom $children)))
               ((((IC:Some (Binary:Leaf $tag)) (IC:Some $terms))
                 (if (== $tag (binary:utf8 "Expr")) (IC:Some (Syntax:Expr $terms)) IC:None))
                ($other IC:None)))))
          ($other IC:None))))
      ($other IC:None))))
(= (source-library:templates $heads $literals $holes $patterns)
   (if (== $patterns ()) (IC:Some ())
     (case ((source-library:template $heads $literals $holes (car-atom $patterns))
            (source-library:templates $heads $literals $holes (cdr-atom $patterns)))
       ((((IC:Some $term) (IC:Some $rest))
         (let $terms (cons-atom $term $rest) (IC:Some $terms)))
        ($other IC:None)))))

; Rigid local leaves carry their own original display names. They are never
; captures supplied at a helper call. Sites with different local inventories
; therefore cannot silently share one newly named local variable.
(= (source-library:local-items $heads $literals $pattern)
   (case $pattern
     (((IC:Hole $role $index) (IC:Some ()))
      ((IC:Node $index $children)
       (case (ic-template:operator $heads $index)
         (((IC:Some (IC:LiteralRef $literal))
           (case (ic-template:operator $literals $literal)
             (((IC:Some (IC:Literal U8 $bytes))
               (case (binary:unpack-fields $bytes)
                 (((Binary:Fields ($tag $number $text))
                   (if (== $tag (binary:utf8 "Local"))
                     (let* (($ordinal (binary:from-unsigned $number)) ($name (binary:from-utf8 $text)))
                       (if (and (binary:unsigned? $ordinal) (binary-schema:text? $name))
                         (IC:Some ((Library:Local $ordinal (Syntax:PlainName $name)))) IC:None))
                     (IC:Some ())))
                  ($other (IC:Some ()))))) ($other IC:None))))
          ((IC:Some $operator) (source-library:local-items-many $heads $literals $children))
          ($other IC:None)))) ($other IC:None))))
(= (source-library:local-items-many $heads $literals $patterns)
   (if (== $patterns ()) (IC:Some ())
     (case ((source-library:local-items $heads $literals (car-atom $patterns))
            (source-library:local-items-many $heads $literals (cdr-atom $patterns)))
       ((((IC:Some $first) (IC:Some $rest))
         (let $items (union-atom $first $rest) (IC:Some $items))) ($other IC:None)))))
(= (source-library:local-names $items $names)
   (if (== $items ()) (IC:Some $names)
     (case (car-atom $items)
       (((Library:Local $index $name)
         (if (== $index (size-atom $names))
           (let $later (union-atom $names (cons-atom $name ()))
             (source-library:local-names (cdr-atom $items) $later))
           (case (ic-template:operator $names $index)
             (((IC:Some $known)
               (if (== $known $name) (source-library:local-names (cdr-atom $items) $names) IC:None))
              ($other IC:None))))) ($other IC:None)))))

(= (source-library:arguments $heads $literals $holes $environment $origin $ports)
   (if (== $holes ()) (IC:Some ())
     (case (car-atom $holes)
       (((IC:Binding $role $index $sort)
         (case (ic-template:lookup $environment $role $index)
           (((IC:Some $node)
             (case (ic-tree-archive:recover $heads $literals $node)
               (((IC:Some $tree)
                 (case ((source-library:image $origin $ports $tree)
                        (source-library:arguments $heads $literals (cdr-atom $holes)
                          $environment $origin $ports))
                   ((((IC:Some $term) (IC:Some $rest))
                     (let $terms (cons-atom $term $rest) (IC:Some $terms)))
                    ($other IC:None))))
                ($other IC:None))))
            ($other IC:None))))))))

(= (source-library:parameter-names-from $prefix $count $index)
   (if (== $index $count) ()
     (let* (($name (str:concat $prefix (str:number->string $index)))
            ($rest (source-library:parameter-names-from $prefix $count (+ $index 1))))
       (cons-atom (Syntax:PlainName $name) $rest))))
(= (source-library:overlaps? $first $second)
   (if (== $first ()) False
     (or (binary-schema:member? (car-atom $first) $second)
         (source-library:overlaps? (cdr-atom $first) $second))))
(= (source-library:fresh-parameters $prefix $count $locals)
   (let $names (source-library:parameter-names-from $prefix $count 0)
     (if (source-library:overlaps? $names $locals)
       (source-library:fresh-parameters (str:concat $prefix "p") $count $locals) $names)))
(= (source-library:variables $count $index)
   (if (== $index $count) ()
     (let $rest (source-library:variables $count (+ $index 1))
       (cons-atom (Syntax:Variable $index) $rest))))
(= (source-library:symbol $name) (Syntax:Literal Symbol (binary:utf8 $name)))
(= (source-library:definition $name $count $locals $body)
   (let* (($parameters (source-library:fresh-parameters "p" $count $locals))
          ($names (union-atom $parameters $locals))
          ($ports (source-library:variables $count 0))
          ($left (cons-atom (source-library:symbol $name) $ports)))
     (Syntax:Form $names
       (Syntax:Expr ((source-library:symbol "=") (Syntax:Expr $left) $body)))))

(= (source-library:mentions? $name $value)
   (case $value
     (((Syntax:Literal Symbol $bytes) (== $bytes (binary:utf8 $name)))
      ($other
       (if (== (get-metatype $value) Expression)
         (source-library:mentions-many? $name $value) False)))))
(= (source-library:mentions-many? $name $values)
   (if (== $values ()) False
     (or (source-library:mentions? $name (car-atom $values))
         (source-library:mentions-many? $name (cdr-atom $values)))))
(= (source-library:name? $name)
   (if (and (binary-schema:text? $name) (str:starts-with $name "ic-learned:"))
     (case (syntax:read (str:concat "(" (str:concat $name ")")))
       (((Syntax:Document $version $reader ((Syntax:Form () (Syntax:Expr ((Syntax:Literal Symbol $bytes))))))
         (== $bytes (binary:utf8 $name)))
        ($other False))) False))

; Whole right-hand sides are disjoint sites. No statement is installed, and
; unsupported or nonmatching source forms retain their original position.
(= (source-library:replace-form $name $signature $heads $literals $holes $locals $patterns $origin $ports $packet $form)
   (case $packet
     (((IC:Packet $slots $sources)
       (case (ic-template:match $signature $slots $patterns $sources)
         (((IC:Some $environment)
           (case (source-library:arguments $heads $literals $holes $environment $origin $ports)
             (((IC:Some $arguments)
               (case (source-library:parse-clause $form)
                 (((IC:Some (Library:Clause $names $head $left $old $count))
                   (if (== (list:drop $count $names) $locals)
                     (let* (($call (cons-atom (source-library:symbol $name) $arguments))
                            ($entry-names (list:take $count $names)))
                       (Library:Replacement (Syntax:Form $entry-names
                         (Syntax:Expr ((source-library:symbol "=") (Syntax:Expr $left) (Syntax:Expr $call)))) 1))
                     (Library:Replacement $form 0)))
                  ($other (Library:Replacement $form 0)))))
              ($other (Library:Replacement $form 0)))))
          ($other (Library:Replacement $form 0)))))
      ($other (Library:Replacement $form 0)))))
(= (source-library:rewrite $name $signature $heads $literals $holes $locals $patterns
       $forms $index $sites $packets)
   (if (== $forms ()) (Library:Rewritten () 0)
     (if (== $sites ()) (Library:Rewritten $forms 0)
       (case (car-atom $sites)
         (((Library:Site $origin $ports $body)
           (let* (($here (== $index $origin))
                  ($later-sites (if $here (cdr-atom $sites) $sites))
                  ($later-packets (if $here (cdr-atom $packets) $packets))
                  ($later (source-library:rewrite $name $signature $heads $literals $holes $locals $patterns
                    (cdr-atom $forms) (+ $index 1) $later-sites $later-packets))
                  ($replacement (if $here
                    (source-library:replace-form $name $signature $heads $literals $holes $locals $patterns
                      $origin $ports (car-atom $packets) (car-atom $forms))
                    (Library:Replacement (car-atom $forms) 0))))
             (case ($replacement $later)
               ((((Library:Replacement $form $count) (Library:Rewritten $rest $found))
                 (let $next (cons-atom $form $rest) (Library:Rewritten $next (+ $count $found)))))))))))))

; LC1 extends the existing source schema, rather than wrapping every source
; node in a second value codec. The complete helper and rewritten source count.
(= (source-library:schema)
   (cons-atom (Binary:Form 9 Library:Archive (Text Text (Record Syntax:Document))) (source-codec:schema)))
(= (source-library:pack $name $document) (source-library:pack-codec "LC1" $name $document))
(= (source-library:pack-codec $codec $name $document)
   (case (binary-schema:encode (source-library:schema) (Record Library:Archive)
           (Library:Archive $codec $name $document))
     (((Binary:TreeBytes $payload) (source-archive:envelope $codec $payload)) ($other IC:None))))

(= (source-library:substitute $arguments $ports $term)
   (case $term
     (((Syntax:Variable $index)
       (if (< $index (size-atom $arguments)) (ic-template:operator $arguments $index)
         (let $next (+ $ports (- $index (size-atom $arguments)))
           (if (binary:unsigned? $next) (IC:Some (Syntax:Variable $next)) IC:None))))
      ((Syntax:Literal $kind $bytes) (IC:Some $term))
      ((Syntax:Expr $children)
       (case (source-library:substitute-many $arguments $ports $children)
         (((IC:Some $terms) (IC:Some (Syntax:Expr $terms))) ($other IC:None))))
      ($other IC:None))))
(= (source-library:substitute-many $arguments $ports $terms)
   (if (== $terms ()) (IC:Some ())
     (case ((source-library:substitute $arguments $ports (car-atom $terms))
            (source-library:substitute-many $arguments $ports (cdr-atom $terms)))
       ((((IC:Some $term) (IC:Some $rest))
         (let $next (cons-atom $term $rest) (IC:Some $next))) ($other IC:None)))))
(= (source-library:call-arguments? $ports $arguments)
   (if (== $arguments ()) True
     (and
       (case (car-atom $arguments)
         (((Syntax:Variable $index) (and (binary:unsigned? $index) (< $index $ports)))
          ((Syntax:Literal $kind $bytes) (source-library:scalar-kind? $kind)) ($other False)))
       (source-library:call-arguments? $ports (cdr-atom $arguments)))))

(= (source-library:expand-form $name $arity $locals $body $all $form)
   (case (source-library:parse-clause $form)
     (((IC:Some (Library:Clause $names $head $left (Syntax:Expr $call) $ports))
       (if (and (not (== $call ())) (source-library:literal-symbol? (car-atom $call) $name))
         (let $arguments (cdr-atom $call)
           (if (and (== (size-atom $arguments) $arity)
                    (and (== $ports (size-atom $names)) (and (source-library:call-arguments? $ports $arguments)
                      (not (source-library:annotated? $head $all)))))
             (case (source-library:substitute $arguments $ports $body)
               (((IC:Some $restored)
                 (let $original-names (union-atom $names $locals)
                   (if (source-scope:valid? (source-library:operations) $ports (size-atom $original-names) $restored)
                     (IC:Some (Library:Replacement
                       (Syntax:Form $original-names (Syntax:Expr
                         ((source-library:symbol "=") (Syntax:Expr $left) $restored))) 1)) IC:None)))
                ($other IC:None))) IC:None))
         (IC:Some (Library:Replacement $form 0))))
      ($other (IC:Some (Library:Replacement $form 0))))))
(= (source-library:expand-forms $name $arity $locals $body $all $forms)
   (if (== $forms ()) (IC:Some (Library:Rewritten () 0))
     (case ((source-library:expand-form $name $arity $locals $body $all (car-atom $forms))
            (source-library:expand-forms $name $arity $locals $body $all (cdr-atom $forms)))
       ((((IC:Some (Library:Replacement $form $count)) (IC:Some (Library:Rewritten $rest $later)))
         (let $next (cons-atom $form $rest) (IC:Some (Library:Rewritten $next (+ $count $later)))))
        ($other IC:None)))))
(= (source-library:restored-document $name $version $reader $result)
   (case $result
     (((IC:Some (Library:Rewritten $expanded $count))
       (let $source (Syntax:Document $version $reader $expanded)
         (if (and (>= $count 2)
                  (and (source-codec:valid? $source) (not (source-library:mentions? $name $source))))
           (IC:Some $source) IC:None)))
      ($other IC:None))))
(= (source-library:restore-forms $name $version $reader $forms)
   (if (== $forms ()) IC:None
     (case (source-library:clause (car-atom $forms))
       (((IC:Some (Library:Clause $names $head $left $body $arity))
         (if (source-library:literal-symbol? $head $name)
           (let $rest (cdr-atom $forms)
             (source-library:restored-document $name $version $reader
               (source-library:expand-forms $name $arity (list:drop $arity $names) $body $rest $rest))) IC:None))
        ($other IC:None)))))
(= (source-library:restore $name $document)
   (if (and (source-library:name? $name) (source-codec:valid? $document))
     (case $document
       (((Syntax:Document $version $reader $forms)
         (if (source-library:current-reader? $reader)
           (source-library:restore-forms $name $version $reader $forms) IC:None)))) IC:None))

(= (source-library:restore-codec "LC1" $name $document) (source-library:restore $name $document))
(= (source-library:decode-helper $codec $payload)
   (if (== $codec (binary:utf8 "LM1"))
     (case (library-stack:decode $payload)
       (((IC:Some $source) (IC:Some $source)) ($unsupported-stack IC:None)))
     (source-library:decode-single $codec $payload)))
(= (source-library:decode-single $codec $payload)
   (case (binary-schema:decode (source-library:schema) (Record Library:Archive) $payload)
     (((Binary:Value (Library:Archive $version $name $document))
       (if (== $codec (binary:utf8 $version))
         (case (source-library:restore-codec $version $name $document)
           (((IC:Some $source) (IC:Some $source)) ($other IC:None))) IC:None)) ($other IC:None))))
(= (ic:library-unpack $bytes)
   (case (binary:unpack-fields $bytes)
     (((Binary:Fields ($version $codec $payload))
       (if (== $version (binary:utf8 "SIC1"))
         (if (or (== $codec (binary:utf8 "ST1")) (== $codec (binary:utf8 "IC1")))
           (source-archive:decode-payload $codec $payload)
           (source-library:decode-helper $codec $payload)) IC:None))
      ($other IC:None))))
(= (ic-packed:observe IC:LibraryArchive $artifact) (ic:library-unpack $artifact))
(= (ic-packed:accepts? IC:LibraryArchive $original $candidate) (== $original $candidate))
(= (ic:library-check $original $current $candidate)
   (ic-packed:check IC:LibraryArchive $original $current $candidate))

(= (source-library:finish-factor $document $name $body $holes $locals $rewritten)
   (case ($document $rewritten)
     ((((Syntax:Document $version $reader $original) (Library:Rewritten $forms $count))
       (if (>= $count 2)
         (let* (($definition (source-library:definition $name (size-atom $holes) $locals $body))
                ($all (cons-atom $definition $forms))
                ($candidate (Syntax:Document $version $reader $all)))
           (if (== (source-library:restore $name $candidate) (IC:Some $document))
             (let $bytes (source-library:pack $name $candidate) (Library:Candidate $bytes $count))
             (Library:Refused Reconstruction)))
         (Library:Refused InsufficientSupport))))))
(= (ic:factor-library $prepared $name $patterns)
   (case $prepared
     (((Library:Prepared (Syntax:Document $version $reader $forms) $archive $sites)
       (let $document (Syntax:Document $version $reader $forms)
         (if (and (source-library:name? $name) (not (source-library:mentions? $name $document)))
           (case (ic-archive:prepare $archive)
             (((IC:PreparedArchive $tree (IC:Catalog $v $o $signature $heads $literals) $packets)
               (case (ic-template:admit-list $signature ((IC:Slot Root ByteTree)) $patterns ())
                 (((IC:Some $unordered)
                   (let $holes (list:reverse $unordered)
                     (case ((source-library:templates $heads $literals $holes $patterns)
                            (source-library:local-items-many $heads $literals $patterns))
                       ((((IC:Some ($body)) (IC:Some $local-items))
                         (case (source-library:local-names $local-items ())
                           (((IC:Some $locals)
                             (if (source-scope:valid? (source-library:operations) (size-atom $holes)
                                   (+ (size-atom $holes) (size-atom $locals)) $body)
                               (source-library:finish-factor $document $name $body $holes $locals
                                 (source-library:rewrite $name $signature $heads $literals $holes $locals $patterns
                                   $forms 0 $sites $packets))
                               (Library:Refused UnsupportedBody))) ($other (Library:Refused LocalInventory)))))
                        ($other (Library:Refused UnsupportedTemplate))))))
                  ($other (Library:Refused InvalidTemplate)))))
              ($other (Library:Refused InvalidProjection))))
           (Library:Refused InvalidName))))
      ($other (Library:Refused InvalidTask)))))

(= (source-library:seed $prepared $name $left $right)
   (case $prepared
     (((Library:Prepared $document $archive $sites)
       (case (ic-archive:prepare $archive)
         (((IC:PreparedArchive $tree (IC:Catalog $version $observation $signature $heads $literals) $packets)
           (if (and (binary:unsigned? $left) (binary:unsigned? $right))
             (case ((ic-template:operator $packets $left) (ic-template:operator $packets $right))
               ((((IC:Some (IC:Packet $slots $ls)) (IC:Some (IC:Packet $same $rs)))
                 (if (== $slots $same)
                   (case (ic-template:generalize $signature $slots $ls $rs)
                     (((IC:Generalized $patterns $l $r) (ic:factor-library $prepared $name $patterns))
                      ($other (Library:Refused InvalidSeed))))
                   (Library:Refused DifferentSlots)))
                ($other (Library:Refused InvalidIndex))))
             (Library:Refused InvalidIndex)))
          ($other (Library:Refused InvalidProjection)))))
      ($other (Library:Refused InvalidTask)))))

; A linear retained producer keeps pair order independent of FIFO scheduling.
; It emits indices only; source interpretation stays outside the producer.
(= (source-library:pairs $count $left $right)
   (if (< $left $count)
     (if (< $right $count) (source-library:emit-pair $count $left $right)
       (source-library:pairs $count (+ $left 1) (+ $left 2))) (superpose ())))
(= (source-library:emit-pair $count $left $right) (IC:Proposal (Library:Seed $left $right)))
(= (source-library:emit-pair $count $left $right) (source-library:pairs $count $left (+ $right 1)))

(= (ic-search:observation (Library:Model $prepared $name) $artifact)
   (case $prepared
     (((Library:Prepared (Syntax:Document $version $reader $forms) $archive $sites)
       (if (source-library:current-reader? $reader) (ic:library-unpack $artifact) IC:None))
      ($other IC:None))))
(= (ic-search:consider (Library:Model $prepared $name) $original $best $candidate)
   (case (ic:library-check $original $best $candidate)
     (((IC:PackedAccepted $next $before $after) (IC:CandidateAccepted $next))
      ((IC:PackedRejected $reason) (IC:CandidateRejected $reason)))))
(= (ic-search:materialize (Library:Model $prepared $name) $original $proposal)
   (case $proposal
     (((Library:Seed $left $right)
       (case (source-library:seed $prepared $name $left $right)
         (((Library:Candidate $bytes $support) (IC:Candidate $bytes))
          ((Library:Refused $reason) (IC:Refused $reason)))))
      ($other (IC:ProducerFault InvalidLibraryProposal)))))
(= (source-library:learn-named $document $name $quantum)
   (case (ic:prepare-library $document)
     (((Library:Prepared $source $archive $sites)
       (if (and (source-library:name? $name) (not (source-library:mentions? $name $source)))
           (let* (($model (Library:Model (Library:Prepared $source $archive $sites) $name))
                  ($original (ic:source-pack $source))
                  ($environment (context-space))
                  ($handle (work-new (source-library:pairs (size-atom $sites) 0 1))))
             (case (ic:prepare $model $original ($environment) $quantum ((IC:Branch 0 $handle)))
               (((IC:PreparedSearch $state) (IC:PreparedSearch $state))
                ($other (let $released (work-cancel $handle) $other)))))
           (IC:SearchRefused InvalidLibraryName)))
      ($other (IC:SearchRefused InvalidLibraryTask)))))
(= (ic:learn-library $document $suffix $quantum)
   (if (binary-schema:text? $suffix)
     (source-library:learn-named $document (str:concat "ic-learned:" $suffix) $quantum)
     (IC:SearchRefused InvalidLibraryName)))

(= (ic:export-library $bytes)
   (case (binary:unpack-fields $bytes)
     (((Binary:Fields ($version $codec $payload))
       (if (and (== $version (binary:utf8 "SIC1"))
                (not (or (== $codec (binary:utf8 "ST1")) (== $codec (binary:utf8 "IC1")))))
         (source-library:export-codec $codec $payload)
         (Library:Refused NoLearnedLibrary)))
      ($other (Library:Refused InvalidArtifact)))))
(= (source-library:export-codec $codec $payload)
   (if (== $codec (binary:utf8 "LM1"))
     (case (library-stack:export $payload)
       (((Library:ExportMany $layers $document $text $original)
         (Library:ExportMany $layers $document $text $original))
        ((Library:Refused $reason) (Library:Refused $reason))
        ($unsupported-stack (Library:Refused InvalidArtifact))))
     (case (binary-schema:decode (source-library:schema) (Record Library:Archive) $payload)
       (((Binary:Value (Library:Archive $label $name $document))
         (case (if (== $codec (binary:utf8 $label))
                 (source-library:restore-codec $label $name $document) IC:None)
           (((IC:Some $original)
             (let $text (syntax:write $document)
               (if (== (syntax:read $text) $document)
                 (Library:Export $name $document $text $original)
                 (Library:Refused Unrenderable))))
            ($other (Library:Refused InvalidArtifact)))))
        ($other (Library:Refused InvalidArtifact))))))
