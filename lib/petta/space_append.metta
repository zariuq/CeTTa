; Bounded persistent admission from one captured occurrence source. Schema,
; postings and receipts remain ordinary MeTTa data; only the spool is native.
!(import! &self "space_transfer.metta")

(= (append-i:close $resources)
  (if (== $resources ()) True
    (let* (($_ (store:close (car-atom $resources)))
           ($_ (append-i:close (cdr-atom $resources)))) True)))
(= (append-i:fail $resources $failure)
  (let $_ (append-i:close $resources) $failure))

(= (durable-space:append-open $owner $view $collection $request $command $source $disk)
  (case (knowledge:receipt $view $request $command (durable-space:wire-limit))
    ((KnowledgeReceiptAbsentV1
      (let* (((KnowledgeAddressV1 $metadata) (durable-space:metadata $collection))
             ((KnowledgeAddressV1 $prefix) (durable-space:prefix $collection)))
        (case (durable-space:state $view $collection $metadata $prefix)
          (((SpaceStateV1 $count $indexes)
            (case (store:get $view $metadata (store:value-byte-limit))
              (((StoreValue $bytes)
                (case (store:decode $bytes)
                  (((StoreDecoded $record)
                    (append-i:admit $owner $view $source $disk
                      (SpaceAppendTargetV1 $collection $request $command $metadata $prefix $record $indexes $count)))
                   ($failure $failure))))
               ($failure $failure))))
           ($failure $failure)))))
     ($prior (knowledge:replay-on $owner $view $prior)))))
(= (append-i:admit $owner $view $source $disk $target)
  (let* (((SpaceAppendTargetV1 $collection $request $_ $_ $_ $_ $_ $_) $target)
         ((KnowledgeAddressV1 $mapping) (transfer:map-prefix $collection $request)))
    (case (durable-space:empty-prefix? $view $mapping)
      ((True (append-i:watch $owner $view $source $disk $target))
       (False (SpaceRefusedV1 orphaned-import-map))
       ($failure $failure)))))
(= (append-i:watch $owner $view $source $disk $target)
  (case (store:program-watch-open)
    (((StoreProgramWatch $watch)
      (case (store:owner-clone $owner)
        (((StoreOpened $copy)
          (case (store:view-clone $view)
            (((StoreSnapshot $captured $_ $_)
              (append-i:source $copy $captured $watch $source $disk $target))
             ($failure (append-i:fail ($copy $watch) $failure)))))
         ($failure (append-i:fail ($watch) $failure)))))
     ($failure $failure))))
(= (append-i:source $owner $view $watch $space $disk $target)
  (case (store:source-open $space)
    (((StoreSourceOpened $source $count $maximum)
      (case (store:source-scan $source)
        (((StoreCandidateOpened $cursor $_)
          (let $_ (store:close $source)
            (case (store:batch-open $owner $view $disk)
              (((StoreBatch $batch)
                (SpaceAppendOpenedV1
                  (SpaceAppendStateV1 (SpaceAppendOwnersV1 $owner $view $watch) $target
                    (SpaceAppendInputV1 $cursor $count) (SpaceAppendSpoolV1 $batch 0 0))))
               ($failure (append-i:fail ($cursor $view $owner $watch) $failure))))))
         ($failure (append-i:fail ($source $view $owner $watch) $failure)))))
     ($failure (append-i:fail ($view $owner $watch) $failure)))))

(= (durable-space:append-close
     (SpaceAppendStateV1 (SpaceAppendOwnersV1 $owner $view $watch) $target
       (SpaceAppendInputV1 $cursor $count) (SpaceAppendSpoolV1 $batch $rows $operations)))
  (append-i:close ($cursor $batch $view $watch $owner)))
(= (append-i:abort $state $failure)
  (let $_ (durable-space:append-close $state) $failure))
(= (append-i:current? $batch $operations)
  (case (store:batch-info $batch)
    (((StoreBatchInfo $bytes $maximum $actual) (== $operations $actual)) ($failure False))))
(= (durable-space:append-info
     (SpaceAppendStateV1 $owners $target (SpaceAppendInputV1 $cursor $count)
       (SpaceAppendSpoolV1 $batch $rows $operations)))
  (case (store:batch-info $batch)
    (((StoreBatchInfo $bytes $maximum $actual)
      (SpaceAppendInfoV1 $rows $count $bytes $actual)) ($failure $failure))))
(= (durable-space:append-next $state)
  (case $state
    (((SpaceAppendStateV1 $owners $target (SpaceAppendInputV1 $cursor $count)
        (SpaceAppendSpoolV1 $batch $rows $operations))
      (if (append-i:current? $batch $operations)
        (case (store:candidate-next $cursor $rows 1)
          ((StoreCandidatePaused (SpaceAppendMoreV1 $state))
           (StoreCandidateEnd
            (if (== $rows $count) (SpaceAppendReadyV1 $state)
              (append-i:abort $state (SpaceRefusedV1 append-count))))
           ((StoreCandidateRow $same $body-size $identity-size)
            (if (and (== $same $rows) (< $rows $count))
              (append-i:row $state $rows $cursor)
              (append-i:abort $state (SpaceRefusedV1 append-sequence))))
           ($failure (append-i:abort $state $failure))))
        (append-i:abort $state (SpaceRefusedV1 append-stale-state))))
     ($failure (SpaceRefusedV1 append-state)))))
(= (append-i:row $state $sequence $cursor)
  (case (store:candidate-packet $cursor $sequence body)
    (((StoreCandidatePacket $_ body $body)
      (case (store:candidate-packet $cursor $sequence identity)
        (((StoreCandidatePacket $_ identity $bytes)
          (case (store:decode $bytes)
            (((StoreDecoded $identity)
              (if (knowledge:ground-identity? $identity)
                (append-i:stage $state $body $identity)
                (append-i:abort $state (SpaceRefusedV1 append-identity))))
             ($failure (append-i:abort $state $failure)))))
         ($failure (append-i:abort $state $failure)))))
     ($failure (append-i:abort $state $failure)))))
(= (append-i:stage $state $body $origin)
  (let* (((SpaceAppendStateV1 (SpaceAppendOwnersV1 $owner $view $watch) $target $input
            (SpaceAppendSpoolV1 $batch $rows $operations)) $state)
         ((SpaceAppendTargetV1 $collection $request $command $metadata $prefix $record $indexes $initial) $target))
    (case (store:decode $body)
      (((StoreDecoded $atom)
        (case (store:encode $atom)
          (((StoreEncoded $canonical)
            (if (== $canonical $body)
              (let (KnowledgeAddressV1 $key) (knowledge:address $prefix (SpaceOccurrenceKeyV1 $request $rows))
                (case (store:get $view $key 0)
                  ((StoreAbsent
                    (case (durable-index:postings $indexes $key $atom)
                      (((SpaceIndexPostingsV1 $postings)
                        (append-i:stage-ops $state $key $body $origin $postings))
                       ($failure (append-i:abort $state $failure)))))
                   ($present (append-i:abort $state (SpaceRefusedV1 occurrence-exists))))))
              (append-i:abort $state (SpaceRefusedV1 noncanonical-import-atom))))
           ($failure (append-i:abort $state $failure)))))
       ($failure (append-i:abort $state $failure))))))
(= (append-i:stage-ops $state $key $body $origin $postings)
  (let* (((SpaceAppendStateV1 $owners $target $input (SpaceAppendSpoolV1 $batch $rows $operations)) $state)
         ((SpaceAppendOwnersV1 $owner $view $watch) $owners)
         ((SpaceAppendTargetV1 $collection $request $command $metadata $prefix $record $indexes $initial) $target)
         ((KnowledgeAddressV1 $mapping) (transfer:map-prefix $collection $request))
         ((KnowledgeAddressV1 $map-key) (knowledge:address $mapping $origin))
         ((StoreViewInfo $epoch $_) (store:view-info $view))
         ((StoreEncoded $map-body) (store:encode (SpaceImportMappingV1 $origin (StoreOccurrenceV1 $epoch $key))))
         ($ops (cons-atom ops (cons-atom (put $key $body)
                 (cons-atom (put $map-key $map-body) (map-atom $postings $posting (put $posting "")))))))
    (case (store:batch-add $batch $ops)
      ((StoreBatchStaged
        (SpaceAppendMoreV1 (SpaceAppendStateV1 $owners $target $input
          (SpaceAppendSpoolV1 $batch (+ $rows 1) (+ $operations (- (size-atom $ops) 1))))))
       ($failure (append-i:abort $state $failure))))))

; Preserve the admitted metadata version when updating its count. Legacy
; layouts that need reindexing remain refused by durable-space:state.
(= (append-i:descriptor $record $count)
  (case $record
    (((StoreSpaceV1 $prefix $_) (StoreSpaceV1 $prefix $count))
     ((StoreSpaceV2 $prefix $_ $indexes) (StoreSpaceV2 $prefix $count $indexes))
     ((StoreSpaceV3 $prefix $_ $indexes) (StoreSpaceV3 $prefix $count $indexes))
     ((StoreSpaceV4 $prefix $_ $indexes) (StoreSpaceV4 $prefix $count $indexes))
     ($unknown (SpaceRefusedV1 append-metadata)))))
(= (durable-space:append-finish $state)
  (let* (((SpaceAppendStateV1 (SpaceAppendOwnersV1 $owner $view $watch) $target
            (SpaceAppendInputV1 $cursor $count) (SpaceAppendSpoolV1 $batch $rows $operations)) $state)
         ((SpaceAppendTargetV1 $collection $request $command $metadata $prefix $record $indexes $initial) $target))
    (if (and (append-i:current? $batch $operations)
             (and (== $rows $count) (<= (+ $initial $rows) 9223372036854775807)))
      (case (store:candidate-next $cursor $rows 0)
        ((StoreCandidateEnd (append-i:publish $state))
         ($incomplete (append-i:abort $state (SpaceRefusedV1 append-incomplete)))))
      (append-i:abort $state (SpaceRefusedV1 append-incomplete)))))
(= (append-i:publish $state)
  (let* (((SpaceAppendStateV1 (SpaceAppendOwnersV1 $owner $view $watch) $target $input
            (SpaceAppendSpoolV1 $batch $rows $operations)) $state)
         ((SpaceAppendTargetV1 $collection $request $command $metadata $prefix $record $indexes $initial) $target)
         ($descriptor (append-i:descriptor $record (+ $initial $rows))))
    (case (store:encode $descriptor)
      (((StoreEncoded $body)
        (let* (((KnowledgeAddressV1 $receipt-key) (knowledge:receipt-address $request))
               ($answer (DbTransactionValuesV1 (True)))
               ((StoreEncoded $receipt) (store:encode (KnowledgeReceiptV1 $request $command $answer))))
          (case (store:batch-add $batch (ops (put $metadata $body) (put $receipt-key $receipt)))
            ((StoreBatchStaged
              (let* (($result (store:commit-batch-guarded $owner $view $watch $batch))
                     ($_ (durable-space:append-close $state)))
                (case $result
                  (((StoreSnapshot $after $epoch $revision)
                    (let $_ (store:close $after) (KnowledgeCommittedV1 $answer $epoch $revision)))
                   ($failure $failure)))))
             ($failure (append-i:abort $state $failure))))))
       ($failure (append-i:abort $state $failure))))))
