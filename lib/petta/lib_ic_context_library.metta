(= (ic-search:consider (Library:DeferredModel $prepared $name) $original $best $candidate)
   (case (ic:library-check $original $best $candidate)
     (((IC:PackedAccepted $next $before $after) (IC:CandidateAccepted $next))
      ((IC:PackedRejected $reason) (IC:CandidateRejected $reason)))))
(= (ic-search:materialize (Library:DeferredModel $prepared $name) $original $proposal)
   (case $proposal
     (((Library:Seed $left $right)
       (case (context-library:seed $prepared $name $left $right)
         (((Library:Candidate $bytes $support) (IC:Candidate $bytes))
          ((Library:Refused $reason) (IC:Refused $reason))))) ($ctx-fallback-56 (IC:ProducerFault InvalidLibraryProposal)))))
(= (ic:learn-library Deferred $document $suffix $quantum)
   (if (binary-schema:text? $suffix)
     (case (ic:prepare-library Deferred $document)
       (((Library:DeferredPrepared $source $archive $sites)
         (let $name (str:concat "ic-learned:" $suffix)
           (if (and (source-library:name? $name) (not (source-library:mentions? $name $source)))
             (let* (($prepared (Library:DeferredPrepared $source $archive $sites))
                    ($original (ic:source-pack $source))
                    ($handle (work-new (source-library:pairs (size-atom $sites) 0 1))))
               (case (ic:prepare (Library:DeferredModel $prepared $name) $original ((context-space)) $quantum ((IC:Branch 0 $handle)))
                 (((IC:PreparedSearch $state) (IC:PreparedSearch $state))
                  ($ctx-fallback-57 (let $closed (work-cancel $handle) $ctx-fallback-57))))) (IC:SearchRefused InvalidLibraryName))))
        ($ctx-fallback-59 $ctx-fallback-59))) (IC:SearchRefused InvalidLibraryName)))
