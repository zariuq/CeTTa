                 (((Syntax:Literal Symbol $head) (not (context-library:reserved? (binary:from-utf8 $head))))
                  ($not-a-call-head True)))))
            ((Syntax:Literal Symbol $head) (not (context-library:reserved? (binary:from-utf8 $head))))
            ($other-left True))) True)) ($other-form True))))
(= (context-library:standard-document? $document)
   (case $document
     (((Syntax:Document $version $reader $forms)
       (foldl-atom $forms True $valid $form (and $valid (context-library:standard-form? $form)))) ($not-a-document False))))

(= (context-library:sites $all $forms $index)
   (if (== $forms ()) ()
     (let $later (context-library:sites $all (cdr-atom $forms) (+ $index 1))
       (case (source-library:parse-clause (car-atom $forms))
         (((IC:Some (Library:Clause $names $head $left $body $ports))
