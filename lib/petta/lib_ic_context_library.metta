     (((Syntax:Form $names (Syntax:Expr ($marker $left $body)))
       (if (or (source-library:literal-symbol? $marker "=") (source-library:literal-symbol? $marker ":"))
         (case $left
           (((Syntax:Expr $children)
             (if (== $children ()) True
