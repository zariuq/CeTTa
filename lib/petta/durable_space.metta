; Durable atom collections, queried through ordinary Space operations.
; Native store capabilities own authority; collection names and occurrence
; references are identifiers only. Each commit validates the whole revision.
!(import! &self "knowledge.metta")
!(import! &self "durable_indexes.metta")
!(import! &self (library list))

; The CAV1 codec refuses packets beyond one MiB before any publication.
(= (durable-space:wire-limit) 1048576)
(: durable-space:create (-> %Undefined% %Undefined% Atom Atom %Undefined%))
(: durable-space:capture (-> %Undefined% Atom %Undefined%))
(: durable-space:cursor (-> %Undefined% Atom Atom Atom %Undefined%))
(= (durable-space:metadata $collection) (knowledge:address "space/meta/v1/" $collection))
(= (durable-space:prefix $collection)
  (case (knowledge:address "space/rows/v1/" $collection)
    (((KnowledgeAddressV1 $key) (KnowledgeAddressV1 (str:concat $key "/"))) ($error $error))))

(= (durable-space:capture $view $collection)
  (case (durable-space:metadata $collection)
    (((KnowledgeAddressV1 $key) (store:space-view $view $key)) ($error $error))))

(= (durable-space:cursor $view $collection $pattern $template)
  (case (durable-space:metadata $collection)
    (((KnowledgeAddressV1 $key) (store:space-query-open $view $key $pattern $template)) ($error $error))))

; Read one original occurrence, not an instantiated match template. The view
; supplies authority; epoch/collection/reference checks prevent cross-domain
; reads. The encoded byte count describes this additional point read.
(: durable-space:read (-> %Undefined% Atom Atom Number %Undefined%))
(= (durable-space:read $view $collection $reference $maximum)
  (case (durable-space:prefix $collection)
    (((KnowledgeAddressV1 $prefix)
      (case (store:view-info $view)
        (((StoreViewInfo $epoch $revision)
          (case (durable-space:reference-key $reference $epoch $prefix)
            (((KnowledgeAddressV1 $key)
              (case (store:get $view $key $maximum)
                (((StoreValue $body)
                  (case (store:decode $body)
                    (((StoreDecoded $atom) (SpaceOccurrenceReadV1 $atom (str:byte-length $body)))
                     ($failure $failure))))
                 (StoreAbsent SpaceOccurrenceAbsentV1)
                 ($failure $failure))))
             ($failure $failure))))
         ($failure $failure))))
     ($failure $failure))))

; One bounded first-answer probe over the shared matcher. A paused/failed
; search is never absence. The temporary cursor closes on every outcome.
(: durable-space:probe (-> %Undefined% Atom Atom Atom Number %Undefined%))
(= (durable-space:probe $view $collection $pattern $template $transitions)
  (case (durable-space:cursor $view $collection $pattern $template)
    (((StoreQueryOpened $query $epoch $revision)
      (let* (($answer (store:space-query-next $query 0 $transitions 1048576))
             ($_ (store:space-query-cancel $query)) ($_ (store:close $query)))
        (case $answer
          (((StoreQueryRow $sequence $value $identities) (SpaceProbeFoundV1 $value $identities))
           (StoreQueryEnd SpaceProbeAbsentV1)
           ($failure $failure)))))
     ($failure $failure))))

; A new collection must have neither metadata nor orphaned rows. The scan
; reads at most one key at/after the prefix and closes on every outcome.
(= (durable-space:empty-prefix? $view $prefix)
  (case (store:scan-open $view $prefix NoBound)
    (((StoreScan $scan)
      (let* (($first (store:scan-next $scan 0)) ($_ (store:close $scan)))
        (case $first
          ((StoreEnd True)
           ((StoreKey $key $length $next) (not (str:starts-with $key $prefix)))
           ($error $error)))))
     ($error $error))))

(= (durable-space:descriptor $prefix $count $indexes)
  (if (== $indexes ()) (StoreSpaceV1 $prefix $count)
    (if (durable-index:has-range? $indexes) (StoreSpaceV4 $prefix $count $indexes)
      (StoreSpaceV3 $prefix $count $indexes))))
(= (durable-space:index-prefixes-empty? $view $indexes)
  (if (== $indexes ()) True
    (let (SpaceIndexPrefixV1 $prefix) (durable-index:index-prefix (car-atom $indexes))
      (case (durable-space:empty-prefix? $view $prefix)
        ((True (durable-space:index-prefixes-empty? $view (cdr-atom $indexes)))
         ($error $error))))))
(= (durable-space:create $owner $view $collection $request)
  (durable-space:create-with $owner $view $collection $request (SpaceCreateV1 $collection) ()))
(: durable-space:create-indexed (-> %Undefined% %Undefined% Atom Atom Atom %Undefined%))
(= (durable-space:create-indexed $owner $view $collection $request $specs)
  (case (durable-index:descriptors $collection $specs)
    (((SpaceIndexesV1 $indexes)
      (durable-space:create-with $owner $view $collection $request (SpaceCreateIndexedV1 $collection $specs) $indexes))
     ($error $error))))
(= (durable-space:create-with $owner $view $collection $request $command $indexes)
  (case (knowledge:receipt $view $request $command (durable-space:wire-limit))
    ((KnowledgeReceiptAbsentV1
      (case (durable-space:metadata $collection)
        (((KnowledgeAddressV1 $key)
          (case (durable-space:prefix $collection)
            (((KnowledgeAddressV1 $prefix)
              (case (store:get $view $key 0)
                ((StoreAbsent
                  (case (durable-space:empty-prefix? $view $prefix)
                    ((True
                      (case (durable-space:index-prefixes-empty? $view $indexes)
                        ((True
                          (let $record (durable-space:descriptor $prefix 0 $indexes)
                            (case (store:encode $record)
                              (((StoreEncoded $body)
                                (knowledge:publish-whole-ready $owner $view $request $command
                                  (SpaceCreatedV1 $collection) (ops (put $key $body))))
                               ($error $error)))))
                         (False (SpaceRefusedV1 orphaned-index-postings))
                         ($error $error))))
                     (False (SpaceRefusedV1 orphaned-occurrences))
                     ($error $error))))
                 ((StoreValue $body) (SpaceRefusedV1 collection-exists))
                 ((StoreTooLarge $length) (SpaceRefusedV1 collection-exists))
                 ($error $error))))
             ($error $error))))
         ($error $error))))
     ($result (knowledge:replay-on $owner $view $result)))))

; The writer validates the exact descriptor it will preserve, including
; canonical index domains for this collection, before staging any edits.
(= (durable-space:state $view $collection $key $prefix)
  (case (store:get $view $key (durable-space:wire-limit))
    (((StoreValue $body)
      (case (store:decode $body)
        (((StoreDecoded $record)
          (if (knowledge:headed? $record)
            (case $record
              (((StoreSpaceV1 $stored $count)
                (durable-space:state-fields $collection $prefix $stored $count ()))
               ((StoreSpaceV3 $stored $count $indexes)
                (durable-space:state-version $collection $prefix $stored $count $indexes False))
               ((StoreSpaceV4 $stored $count $indexes)
                (durable-space:state-version $collection $prefix $stored $count $indexes True))
               ((StoreSpaceV2 $stored $count $indexes)
                (SpaceRefusedV1 index-upgrade-required))
               ($other (SpaceRefusedV1 metadata-format))))
            (SpaceRefusedV1 metadata-format)))
         ($error $error))))
     (StoreAbsent (SpaceRefusedV1 collection-absent))
     ($error $error))))
(= (durable-space:state-version $collection $prefix $stored $count $indexes $ranges)
  (case (durable-space:state-fields $collection $prefix $stored $count $indexes)
    (((SpaceStateV1 $same $declared)
      (if (or $ranges (not (durable-index:has-range? $declared)))
        (SpaceStateV1 $same $declared) (SpaceRefusedV1 metadata-format)))
     ($failure $failure))))
(= (durable-space:state-fields $collection $prefix $stored $count $indexes)
  (if (and (durable-index:integer? $count) (durable-index:exact? $stored))
    (if (and (== $stored $prefix) (>= $count 0))
      (if (durable-index:valid? $collection $indexes) (SpaceStateV1 $count $indexes)
        (SpaceRefusedV1 index-format))
      (SpaceRefusedV1 metadata-format))
    (SpaceRefusedV1 metadata-format)))

(= (durable-space:count $view $key $prefix)
  (case (store:get $view $key (durable-space:wire-limit))
    (((StoreValue $body)
      (case (store:decode $body)
        (((StoreDecoded $record)
          (if (knowledge:tagged? $record StoreSpaceV1 3)
            (let (StoreSpaceV1 $stored $count) $record
              (case (store:key-i64 $count)
                (((StoreKeyBytes $integer)
                  (if (and (== $stored $prefix) (>= $count 0)) (SpaceCountV1 $count)
                    (SpaceRefusedV1 metadata-format)))
                 ($other (SpaceRefusedV1 metadata-format)))))
            (SpaceRefusedV1 metadata-format)))
         ($error $error))))
     (StoreAbsent (SpaceRefusedV1 collection-absent))
     ($error $error))))

(= (durable-space:exists $view $key)
  (case (store:get $view $key 0)
    ((StoreAbsent (SpaceExistsV1 False))
     ((StoreValue $body) (SpaceExistsV1 True))
     ((StoreTooLarge $length) (SpaceExistsV1 True))
     ($error $error))))

(= (durable-space:reference-key $reference $epoch $prefix)
  (if (knowledge:tagged? $reference StoreOccurrenceV1 3)
    (let (StoreOccurrenceV1 $stored $key) $reference
      (if (and (== (get-type $key) String) (== $stored $epoch))
        (if (str:starts-with $key $prefix) (KnowledgeAddressV1 $key)
          (SpaceRefusedV1 occurrence-collection))
        (SpaceRefusedV1 occurrence-reference)))
    (SpaceRefusedV1 occurrence-reference)))

; Insertion identities include the durable request id. A successful retry
; resolves its immutable receipt, including after deletion; it cannot reuse
; the same occurrence for a new insertion. Distinct requests may store equal
; payloads. Updates/deletes use the stable reference returned by insertion.
(= (durable-space:edit $view $epoch $prefix $request $change)
  (if (knowledge:headed? $change)
    (case $change
      (((SpaceInsertV1 $local $atom)
        (case (knowledge:address $prefix (SpaceOccurrenceKeyV1 $request $local))
          (((KnowledgeAddressV1 $key)
            (case (durable-space:exists $view $key)
              (((SpaceExistsV1 False)
                (case (store:encode $atom)
                  (((StoreEncoded $body)
                    (SpaceEditV1 $key 1 (put $key $body) (CreatedV1 (StoreOccurrenceV1 $epoch $key))))
                   ($error $error))))
               ((SpaceExistsV1 True) (SpaceRefusedV1 occurrence-exists))
               ($error $error))))
           ($error $error))))
       ((SpaceUpdateV1 $reference $atom)
        (case (store:encode $atom)
          (((StoreEncoded $body) (durable-space:existing-edit $view $epoch $prefix $reference (SpaceBodyV1 $body)))
           ($error $error))))
       ((SpaceDeleteV1 $reference)
        (durable-space:existing-edit $view $epoch $prefix $reference SpaceDeleteBodyV1))
       ($bad (SpaceRefusedV1 edit-format))))
    (SpaceRefusedV1 edit-format)))

(= (durable-space:existing-edit $view $epoch $prefix $reference $body)
  (case (durable-space:reference-key $reference $epoch $prefix)
    (((KnowledgeAddressV1 $key)
      (case (durable-space:exists $view $key)
        (((SpaceExistsV1 True)
          (case $body
            (((SpaceBodyV1 $bytes) (SpaceEditV1 $key 0 (put $key $bytes) NoCreatedV1))
             (SpaceDeleteBodyV1 (SpaceEditV1 $key -1 (remove $key) NoCreatedV1)))))
         ((SpaceExistsV1 False) (SpaceRefusedV1 occurrence-absent))
         ($error $error))))
     ($error $error))))

(= (durable-space:seen? $key $keys)
  (if (== $keys ()) False
    (if (== $key (car-atom $keys)) True (durable-space:seen? $key (cdr-atom $keys)))))
(= (durable-space:stage $view $epoch $prefix $request $changes $seen $count $ops $created)
  (durable-space:stage-indexed $view $epoch $prefix $request $changes $seen $count $ops $created ()))
(= (durable-space:stage-indexed $view $epoch $prefix $request $changes $seen $count $ops $created $indexes)
  (if (== (get-metatype $changes) Expression)
    (if (== $changes ()) (SpacePreparedV1 $count (list:reverse $ops) (list:reverse $created))
      (case (durable-space:edit $view $epoch $prefix $request (car-atom $changes))
        (((SpaceEditV1 $key $delta $operation $new)
          (if (durable-space:seen? $key $seen) (SpaceRefusedV1 repeated-occurrence)
            (if (< (+ $count $delta) 0) (SpaceRefusedV1 metadata-count)
              (case (durable-index:operations $view $indexes $key $delta $operation)
                (((SpaceIndexOperationsV1 $postings)
                  (let $all (cons-atom $operation $postings)
                    (durable-space:stage-indexed $view $epoch $prefix $request (cdr-atom $changes)
                      (cons-atom $key $seen) (+ $count $delta)
                      (list:append (list:reverse $all) $ops)
                      (case $new (((CreatedV1 $reference) (cons-atom $reference $created)) (NoCreatedV1 $created)))
                      $indexes)))
                 ($error $error))))))
         ($error $error))))
    (SpaceRefusedV1 edit-list)))

; CHANGES is data, including quoted rules, callable expressions and open atoms.
(= (durable-space:publish $owner $view $request $command $key $prefix $next $ops $created)
  (durable-space:publish-indexed $owner $view $request $command $key $prefix $next $ops $created ()))
(= (durable-space:publish-indexed $owner $view $request $command $key $prefix $next $ops $created $indexes)
  (durable-space:publish-policy $owner $view $request $command $key $prefix $next $ops $created $indexes NoProgramWatchV1))
(= (durable-space:publish-policy $owner $view $request $command $key $prefix $next $ops $created $indexes $policy)
  (case (store:key-i64 $next)
    (((StoreKeyBytes $integer)
      (let $record (durable-space:descriptor $prefix $next $indexes)
      (case (store:encode $record)
        (((StoreEncoded $body)
          (knowledge:publish-whole-policy $owner $view $request $command
            (SpaceAppliedV1 $created) (cons-atom ops (cons-atom (put $key $body) $ops)) $policy))
         ($error $error)))))
     ($other (SpaceRefusedV1 metadata-count)))))

(: durable-space:commit (-> %Undefined% %Undefined% Atom Atom Atom %Undefined%))
(= (durable-space:commit $owner $view $collection $request $changes)
  (let $command (SpaceCommitV1 $collection $changes)
    (durable-space:commit-command $owner $view $collection $request $command $changes)))

; Trusted application policies can identify the original operation separately
; from its query-derived edits. Resolve this same versioned command before
; rechecking a retry; owner authority is still required for publication.
(: durable-space:commit-command (-> %Undefined% %Undefined% Atom Atom Atom Atom %Undefined%))
(= (durable-space:commit-command $owner $view $collection $request $command $changes)
  (durable-space:commit-policy $owner $view $collection $request $command $changes NoProgramWatchV1))
(: durable-space:commit-policy (-> %Undefined% %Undefined% Atom Atom Atom Atom Atom %Undefined%))
(= (durable-space:commit-policy $owner $view $collection $request $command $changes $policy)
    (case (knowledge:receipt $view $request $command (durable-space:wire-limit))
      ((KnowledgeReceiptAbsentV1
        (case (durable-space:metadata $collection)
          (((KnowledgeAddressV1 $key)
            (case (durable-space:prefix $collection)
              (((KnowledgeAddressV1 $prefix)
                (case (durable-space:state $view $collection $key $prefix)
                  (((SpaceStateV1 $count $indexes)
                    (case (store:view-info $view)
                      (((StoreViewInfo $epoch $revision)
                        (case (durable-space:stage-indexed $view $epoch $prefix $request $changes () $count () () $indexes)
                          (((SpacePreparedV1 $next $ops $created)
                            (durable-space:publish-policy $owner $view $request $command $key $prefix $next $ops $created $indexes $policy))
                           ($error $error))))
                       ($error $error))))
                   ($error $error))))
               ($error $error))))
           ($error $error))))
       ($result (knowledge:replay-on $owner $view $result)))))
