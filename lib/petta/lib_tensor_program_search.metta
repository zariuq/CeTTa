; A declared finite chronological-DAG region. Children select earlier nodes
; of their required sorts; all roots and repeated grammar choices survive.
; Encoding, numerical execution and candidate checking stay outside producers.
!(import! &self (library lib_tensor_program))
!(import! &self (library lib_ic_parameters))

(= (tp-grammar:inputs $sorts $index)
   (if (== $sorts ()) (TP:Seeds () ())
     (if (tensor-program:sort? (car-atom $sorts))
       (case (tp-grammar:inputs (cdr-atom $sorts) (+ $index 1))
         (((TP:Seeds $records $types)
           (let* (($record (tensor-program:input (car-atom $sorts) $index))
                  ($rows (cons-atom $record $records)) ($known (cons-atom (car-atom $sorts) $types)))
             (TP:Seeds $rows $known))) ($other $other))) (TP:Fault InputSort))))
(= (tp-grammar:constants $values)
   (if (== $values ()) (TP:Seeds () ())
     (case (car-atom $values)
       (((TP:ConstantSeed $sort $value)
         (case ((tensor-program:constant $sort $value) (tp-grammar:constants (cdr-atom $values)))
           ((((Binary:Leaf $bytes) (TP:Seeds $records $types))
             (let* (($rows (cons-atom (Binary:Leaf $bytes) $records)) ($known (cons-atom $sort $types)))
               (TP:Seeds $rows $known))) ($other (TP:Fault Constant))))) ($other (TP:Fault Constant))))))
(= (tp-grammar:alternatives $family $index $values)
   (if (== $values ()) (TP:Some ())
     (case (tensor-program:operator $family $index)
       (((TP:Some (TP:Operator $name $inputs $output $recipe))
         (case (tensor-program:contract $recipe)
           (((TP:Contract $expected $result $kind)
             (if (tensor-program:parameters? $kind (car-atom $values))
               (case (tp-grammar:alternatives $family $index (cdr-atom $values))
                 (((TP:Some $tail)
                   (let* (($tag (tensor-program:bytes (TP:Apply $index (car-atom $values))))
                          ($instructions (cons-atom (TP:Instruction $inputs $output $tag) $tail)))
                     (TP:Some $instructions))) ($other $other))) (TP:Fault Parameters))) ($other (TP:Fault Operator)))))
        ($other (TP:Fault Operator))))))
(= (tp-grammar:domains $family $domains)
   (if (== $domains ()) (TP:Some ())
     (case (car-atom $domains)
       (((TP:Domain $index $values)
         (if (and (== (get-metatype $values) Expression)
                  (not (== (tensor-program:operator $family $index) TP:None)))
           (case ((tp-grammar:alternatives $family $index $values) (tp-grammar:domains $family (cdr-atom $domains)))
             ((((TP:Some $first) (TP:Some $rest))
               (let $instructions (union-atom $first $rest) (TP:Some $instructions))) ($other (TP:Fault Domains))))
           (TP:Fault Domains))) ($other (TP:Fault Domains))))))
(= (tensor-program:prepare-region $family $input-sorts $constants $domains $maximum)
   (if (and (tensor-program:family? $family)
         (and (binary:unsigned? $maximum)
           (and (== (get-metatype $input-sorts) Expression)
             (and (== (get-metatype $constants) Expression) (== (get-metatype $domains) Expression)))))
     (case ((tp-grammar:inputs $input-sorts 0) (tp-grammar:constants $constants) (tp-grammar:domains $family $domains))
       ((((TP:Seeds $inputs $input-types) (TP:Seeds $fixed $fixed-types) (TP:Some $instructions))
         (let* (($records (union-atom $inputs $fixed)) ($types (union-atom $input-types $fixed-types)))
           (TP:Region $family $records $types $instructions $maximum))) ($other (TP:Fault Region))))
     (TP:Fault Region)))

(= (tp-grammar:instructions? $family $instructions)
   (if (== (get-metatype $instructions) Expression)
     (if (== $instructions ()) True
       (case (car-atom $instructions)
         (((TP:Instruction $inputs $output $tag)
           (and (== (tensor-program:node-type $family $tag $inputs) (TP:Some $output))
                (tp-grammar:instructions? $family (cdr-atom $instructions)))) ($other False)))) False))
(= (tensor-program:region? $region)
   (case $region
     (((TP:Region $family $records $types $instructions $maximum)
       (and (tensor-program:family? $family)
         (and (binary:unsigned? $maximum)
           (and (== (get-metatype $records) Expression)
             (and (== (tensor-program:check-records $family () $records) (TP:Some $types))
                  (tp-grammar:instructions? $family $instructions)))))) ($other False))))

(= (tp-grammar:indices $types $wanted $index)
   (if (== $types ()) ()
     (let $rest (tp-grammar:indices (cdr-atom $types) $wanted (+ $index 1))
       (if (== (car-atom $types) $wanted) (cons-atom $index $rest) $rest))))
(= (tp-grammar:choices $types $wanted)
   (if (== $wanted ()) ()
     (let* (($first (tp-grammar:indices $types (car-atom $wanted) 0))
            ($rest (tp-grammar:choices $types (cdr-atom $wanted)))) (cons-atom $first $rest))))
(= (tp-grammar:append-children $records $types $used $output $tag $tuples)
   (if (== $tuples ()) ()
     (let* (($next-records (union-atom $records (cons-atom (Binary:Node $tag (car-atom $tuples)) ())))
            ($next-types (union-atom $types (cons-atom $output ())))
            ($rest (tp-grammar:append-children $records $types $used $output $tag (cdr-atom $tuples))))
       (cons-atom (TP:Builder $next-records $next-types (+ $used 1)) $rest))))
(= (tp-grammar:children $records $types $used $instructions)
   (if (== $instructions ()) ()
     (case (car-atom $instructions)
       (((TP:Instruction $inputs $output $tag)
         (let* (($domains (tp-grammar:choices $types $inputs))
                ($tuples (collapse (ic-parameters:enumerate $domains)))
                ($first (tp-grammar:append-children $records $types $used $output $tag $tuples))
                ($rest (tp-grammar:children $records $types $used (cdr-atom $instructions))))
           (union-atom $first $rest)))))))
(= (tp-grammar:walk $wanted $family $instructions $maximum $frontier)
   (if (== $frontier ()) (superpose ())
     (case (car-atom $frontier)
       (((TP:Builder $records $types $used)
         (let $roots (tp-grammar:indices $types $wanted 0)
           (tp-grammar:roots $wanted $family $instructions $maximum $records $types $used $roots (cdr-atom $frontier))))))))
(= (tp-grammar:roots $wanted $family $instructions $maximum $records $types $used $roots $frontier)
   (if (== $roots ())
     (if (< $used $maximum)
       (let* (($children (tp-grammar:children $records $types $used $instructions))
              ($next (union-atom $children $frontier))) (tp-grammar:walk $wanted $family $instructions $maximum $next))
       (tp-grammar:walk $wanted $family $instructions $maximum $frontier))
     (tp-grammar:emit $wanted $family $instructions $maximum $records $types $used $roots $frontier)))
(= (tp-grammar:emit $wanted $family $instructions $maximum $records $types $used $roots $frontier)
   (let $selected (cons-atom (car-atom $roots) ())
     (IC:Proposal (TP:Blueprint $family (Dag:Forest $selected $records)))))
(= (tp-grammar:emit $wanted $family $instructions $maximum $records $types $used $roots $frontier)
   (tp-grammar:roots $wanted $family $instructions $maximum $records $types $used (cdr-atom $roots) $frontier))
(= (tensor-program:proposals-for $wanted (TP:Region $family $records $types $instructions $maximum))
   (if (tensor-program:sort? $wanted)
     (tp-grammar:walk $wanted $family $instructions $maximum ((TP:Builder $records $types 0)))
     (TP:Fault RootSort)))
(= (tensor-program:proposals $region) (tensor-program:proposals-for "F64Tensor" $region))
