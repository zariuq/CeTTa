; Numerical DAG discovery shares NC1/NC2 observations, complete-byte acceptance,
; owned scheduling and original-task precision with finite parameter fitting.
!(import! &self (library lib_ic_numeric))
!(import! &self (library lib_tensor_program_search))
(= (ic:prepare-fit Numeric:Programs $original $region $sources)
   (if (tensor-program:region? $region)
    (case (ic-program:task-class $original)
     (((IC:TaskClass $model $sort)
       (if (tensor-program:sort? $sort)
        (let* (($handle (work-new (tensor-program:proposals-for $sort $region)))
              ($dependencies (cons-atom (context-space) $sources)))
         (case (ic:prepare $model $original $dependencies 64 ((IC:Branch 0 $handle)))
           (((IC:PreparedSearch $state) (IC:PreparedSearch $state))
            ($other (let $released (work-cancel $handle) $other)))))
        (IC:FitRefused Region)))
      ($other (IC:FitRefused Task))))
    (IC:FitRefused Region)))
(= (ic-program:task-class $original)
   (case (binary-value:unpack $original)
     (((BinaryValue:Value (Numeric:Archive "NC1" $inputs $mask $precision $body))
       (IC:TaskClass IC:NumericArchive "F64Tensor"))
      ((BinaryValue:Value (Numeric:ArrayArchive "NC2" $inputs $sort $mask $criterion $body))
       (IC:TaskClass IC:ArrayArchive $sort))
      ($other IC:None))))
(= (ic:fit Numeric:Programs $original $region $sources $budget)
   (case (ic:prepare-fit Numeric:Programs $original $region $sources)
     (((IC:PreparedSearch $state) (ic:resume $state $budget)) ($other $other))))
(= (ic:predict Numeric:Programs $artifact $inputs)
   (case (binary-value:unpack $artifact)
     (((BinaryValue:Value (Numeric:ArrayArchive "NC2" $old-inputs $sort $mask $criterion $body))
       (ic-arrays:predict $artifact $inputs))
      ($other (ic-numeric:predict-program-vector $artifact $inputs)))))
(= (ic-numeric:predict-program-vector $artifact $inputs)
   (if (ic-parameters:vector? f64 $inputs)
     (case (ic-numeric:observe $artifact)
       (((IC:Some $observation)
         (case (binary-value:unpack $artifact)
           (((BinaryValue:Value (Numeric:Archive "NC1" $old $mask $precision (Numeric:Program $program)))
             (let $result (ic-numeric:predicted $inputs (Numeric:Program $program))
               (if (ic-parameters:vector? f64 $result) (IC:Prediction $result) (IC:NumericFault Prediction))))
            ($other (IC:NumericFault NoModel))))) ($other (IC:NumericFault NoModel))))
     (IC:NumericFault Inputs)))
