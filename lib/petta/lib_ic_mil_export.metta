; Reviewable MP1 source export. The entry consumes values through an Atom
; demand declaration; that declaration grants no purity or execution admission.
; Source helpers remain lexical, and export never installs a definition.
!(import! &self (library lib_ic_mil_program))

(= (mil-export:compile $entries (MIL.SourceRef $index) $input $next)
   (case (ic-template:operator $entries $index)
     (((IC:Some $entry)
       (MIL.SourceCode (Syntax:Expr ((mil-source:adapter $entry) $input)) $next))
      ($missing (MIL.ExportRefused Reference)))))
(= (mil-export:compile $entries (MIL.Id $inner) $input $next)
   (mil-export:compile $entries $inner $input $next))
(= (mil-export:compile $entries (MIL.Chain $left $right) $input $next)
   (case (mil-export:compile $entries $left $input (+ $next 1))
     (((MIL.SourceCode $first $middle)
       (case (mil-export:compile $entries $right (Syntax:Variable $next) $middle)
         (((MIL.SourceCode $second $last)
           (MIL.SourceCode (Syntax:Expr ((source-library:symbol "let")
             (Syntax:Variable $next) $first $second)) $last))
          ($failed $failed)))) ($failed $failed))))
(= (mil-export:compile $entries (MIL.Choice $left $right) $input $next)
   (case (mil-export:compile $entries $left $input $next)
     (((MIL.SourceCode $first $middle)
       (case (mil-export:compile $entries $right $input $middle)
         (((MIL.SourceCode $second $last)
           (MIL.SourceCode (Syntax:Expr ((source-library:symbol "superpose")
             (Syntax:Expr ($first $second)))) $last))
          ($failed $failed)))) ($failed $failed))))
(= (mil-export:map $entries $inner $input $next)
   (case (mil-export:compile $entries $inner (Syntax:Variable $next) (+ $next 1))
     (((MIL.SourceCode $body $last)
       (MIL.SourceCode (Syntax:Expr ((source-library:symbol "map-atom")
         $input (Syntax:Variable $next) $body)) $last))
      ($failed $failed))))
(= (mil-export:compile $entries (MIL.Map $inner) $input $next)
   (mil-export:map $entries $inner $input $next))
(= (mil-export:compile $entries (MIL.HO1 MIL.MapOp $inner) $input $next)
   (mil-export:map $entries $inner $input $next))

(= (mil-export:declared? $reader $name)
   (let* (($document (Syntax:Document "ST1" $reader
             ((Syntax:Form ((Syntax:PlainName "mil_export_type"))
               (Syntax:Expr ((source-library:symbol ":") (source-library:symbol $name) (Syntax:Variable 0)))))))
          ($pattern (parse (syntax:write $document))))
     (not (== (collapse (match (context-space) $pattern True)) ()))))
(= (mil-export:name? $reader $name $document)
   (and (source-library:name? $name)
     (and (not (source-library:mentions? $name $document))
       (and (not (mil-source:overridden? $reader $name 1))
         (not (mil-export:declared? $reader $name))))))
(= (mil-export:declaration $name)
   (Syntax:Form () (Syntax:Expr ((source-library:symbol ":") (source-library:symbol $name)
     (Syntax:Expr ((source-library:symbol "->") (source-library:symbol "Atom") (source-library:symbol "%Undefined%")))))))
(= (mil-export:render $reader $name (MIL.SourceCanonical $term $seen) $model $before $after)
   (let* (($names (map-atom (source-scope:indices (size-atom $seen) 0) $index
                    (Syntax:PlainName (str:concat "mil_export_" (str:number->string $index)))))
          ($document (Syntax:Document "ST1" $reader
             ((mil-export:declaration $name) (Syntax:Form $names $term))))
          ($text (syntax:write $document)))
     (if (== (syntax:read $text) $document)
       (case (syntax:pack $document)
         (((Binary:TreeBytes $bytes)
           (MIL.ProgramExport $name $document $text $model
             (MIL.ExportCosts $before $after (index-atom (tensor:shape $bytes) 0) (str:byte-length $text))))
          ($failed (MIL.ExportRefused Codec)))) (MIL.ExportRefused Unrenderable))))
(= (mil-export:document $family $document $program $name $model $before $after)
   (case ($family $document)
     ((((MIL.SourceFamily $constructors $bindings) (Syntax:Document "ST1" $reader $forms))
       (if (and (mil-export:name? $reader $name $document)
                (mil-source:standard? $reader (("map-atom" 3))))
         (let* (($data (mil-source:constructor-rows $constructors))
                ($helpers (mil-source:helper-rows $forms)))
           (case $helpers
             (((MIL.SourceRows $rows)
               (let $operations (union-atom (mil-source:operations) (union-atom $data $rows))
                 (case (mil-source:environment $operations $data $forms)
                   (((MIL.SourceEnvironment $entries $count $ordered)
                     (case (mil-export:compile $entries $program (Syntax:Variable $count) (+ $count 1))
                       (((MIL.SourceCode $code $next)
                         (let* (($body (mil-source:bind $operations $entries $ordered $code))
                                ($definition (Syntax:Expr ((source-library:symbol "=")
                                  (Syntax:Expr ((source-library:symbol $name) (Syntax:Variable $count))) $body))))
                           (if (source-context:available? $definition (source-scope:indices $next 0))
                             (mil-export:render $reader $name (mil-source:canonical $definition ()) $model $before $after)
                             (MIL.ExportRefused VariableRange)))) ($failed $failed))))
                    ($failed $failed))))) ($failed (MIL.ExportRefused Background)))))
         (MIL.ExportRefused NameOrEnvironment))) ($failed (MIL.ExportRefused Background)))))
(= (mil-export:verified $model $name $before $after)
   (case (mil-program:unpack $model)
     (((MIL.Task $header $type $mode $inputs $negative $forbidden (MIL.SourceProgram $background $program))
       (case (ic:prepare-background Source:MIL $background ())
         (((MIL.SourcePrepared $family $document $types (MIL.SourceRuntime $guards $callables))
           (let $export (mil-export:document $family $document $program $name $model $before $after)
             (if (ic-search:guards-current? $guards) $export (MIL.ExportRefused SourceChanged))))
          ($failed (MIL.ExportRefused Background))))) ($failed (MIL.ExportRefused NoModel)))))
(= (mil-export:standard?)
   (and (== (collapse (match (context-space) (= (map-atom $items $item $body) $result) True)) ())
     (== (collapse (match (context-space) (= map-atom $result) True)) ())))
(= (ic:export-library Source:MIL $original $model $name)
   (if (source-library:name? $name)
     (if (mil-export:standard?)
       (case (ic:verify Source:MIL $original $model)
         (((IC:SourceVerified $bytes $before $after)
           (mil-export:verified $bytes $name $before $after))
          ((IC:SourceRejected $reason) (MIL.ExportRefused $reason))
          ($failed (MIL.ExportRefused Verification)))) (MIL.ExportRefused Environment))
     (MIL.ExportRefused Name)))
