; Reuse an exported library without learning from the receiving program. The
; joint constructor catalogue is transient; the final source archive includes
; the complete unchanged definitions and every rewritten source form.
!(import! &self (library lib_ic_library_stack))

(= (library-transfer:port $arity $role $term)
   (case $term
     (((Syntax:Variable $index) (library-transfer:port-at $arity $role $index Ready))
      ((Syntax:Expr ((Syntax:Variable $index))) (library-transfer:port-at $arity $role $index Delayed))
      ($not-a-port Ctx:None))))
(= (library-transfer:port-at $arity $role $index $mode)
   (if (and (binary:unsigned? $index) (< $index $arity))
     (Ctx:Template (IC:Hole $role $index) ((Ctx:Demand $role $index $mode))) Ctx:None))
(= (library-transfer:pattern $heads $literals $origin $arity $role (IC:Node $index $children))
   (case (ic-template:operator $heads $index)
     (((IC:Some (IC:LiteralRef $literal))
       (if (== $children ())
         (case (ic-template:operator $literals $literal)
           (((IC:Some (IC:Literal U8 $bytes))
             (case (context-library:leaf $origin (source-scope:indices $arity 0) $bytes)
               (((IC:Some $term)
                 (if (source-context:available? $term ())
                   (Ctx:Template (IC:Node $index ()) ())
                   (library-transfer:port $arity $role $term))) ($bad-leaf Ctx:None))))
            ($not-bytes Ctx:None))) Ctx:None))
      ((IC:Some (IC:Name $name))
       (case (library-transfer:patterns $heads $literals $origin $arity $children)
         (((Ctx:Templates $patterns $demands) (Ctx:Template (IC:Node $index $patterns) $demands))
          ($bad-children Ctx:None)))) ($bad-head Ctx:None))))
(= (library-transfer:patterns $heads $literals $origin $arity $nodes)
   (if (== $nodes ()) (Ctx:Templates () ())
     (case ((library-transfer:pattern $heads $literals $origin $arity Value (car-atom $nodes))
            (library-transfer:patterns $heads $literals $origin $arity (cdr-atom $nodes)))
       ((((Ctx:Template $first $here) (Ctx:Templates $rest $later))
         (Ctx:Templates (cons-atom $first $rest) (union-atom $here $later))) ($bad-patterns Ctx:None)))))

; Keep the exported parameter order, rather than renumbering by the order in
; which a new target happens to match. Every port has one demand convention.
(= (library-transfer:binding-at $bindings $index)
   (if (== $bindings ()) IC:None
     (case (car-atom $bindings)
       (((IC:Binding $role $actual $sort)
         (if (== $index $actual) (IC:Some (IC:Binding $role $actual $sort))
           (library-transfer:binding-at (cdr-atom $bindings) $index)))))))
(= (library-transfer:interface $bindings $demands $arity $index)
   (if (== $index $arity) (Ctx:Interface () ())
     (case ((library-transfer:binding-at $bindings $index)
            (library-transfer:interface $bindings $demands $arity (+ $index 1)))
       ((((IC:Some (IC:Binding $role $index ByteTree)) (Ctx:Interface $ports $ready))
         (let* (($is-ready (binary-schema:member? (Ctx:Demand $role $index Ready) $demands))
                ($is-delayed (binary-schema:member? (Ctx:Demand $role $index Delayed) $demands)))
           (if (== $is-ready $is-delayed) Ctx:None
             (Ctx:Interface (cons-atom (IC:Binding $role $index ByteTree) $ports)
               (if $is-ready (cons-atom (Ctx:Ready $role $index) $ready) $ready)))))
        ($invalid-interface Ctx:None)))))
(= (library-transfer:emit $source $sites $archive $definition $name $arity)
   (case (ic-archive:prepare $archive)
     (((IC:PreparedArchive $tree (IC:Catalog $version $observation $signature $heads $literals) $packets)
       (case (ic-template:operator $packets (size-atom $sites))
         (((IC:Some (IC:Packet ((IC:Slot Root ByteTree)) ($body)))
           (case (library-transfer:pattern $heads $literals (size-atom $sites) $arity Root $body)
             (((Ctx:Template $pattern $demands)
               (case (ic-template:admit-list $signature ((IC:Slot Root ByteTree)) ($pattern) ())
                 (((IC:Some $bindings)
                   (if (== (size-atom $bindings) $arity)
                     (case (library-transfer:interface $bindings $demands $arity 0)
                       (((Ctx:Interface $ports $ready)
                         (context-library:rewrite (Ctx:Projection $source $sites $signature $heads $literals $packets)
                           $name $definition ($pattern) $ports $ready 1))
                        ($bad-ports (Library:Refused UnsupportedInterface))))
                     (Library:Refused UnusedParameters))) ($bad-template (Library:Refused UnsupportedTemplate)))))
              ($unsupported-body (Library:Refused UnsupportedTemplate)))))
          ($missing-body (Library:Refused InvalidProjection))))) ($bad-archive (Library:Refused InvalidProjection)))))
(= (library-transfer:prepare $source $sites $definition $name $body $arity)
   (let* (($forest (context-library:forest $sites 0))
          ($helper (context-library:project (size-atom $sites) $body)))
     (case (ic:prepare-trees Constructors (union-atom $forest ($helper)))
       (((IC:ConstructorArchive $archive) (library-transfer:emit $source $sites $archive $definition $name $arity))
        ($bad-preparation (Library:Refused InvalidProjection))))))
(= (library-transfer:materialize $name $definition $reader $document)
   (case (context-library:source-sites $document)
     (((Ctx:Source (Syntax:Document $version $actual $forms) $sites)
       (if (== $actual $reader)
         (if (source-library:mentions? $name $document) (Library:Refused NameCollision)
           (case (source-library:parse-clause $definition)
             (((IC:Some (Library:Clause $names $head $left $body $arity))
               (library-transfer:prepare $document $sites $definition $name $body $arity))
              ($bad-definition (Library:Refused UnsupportedHelper))))) (Library:Refused DifferentReader)))
      ($source-refusal $source-refusal))))
(= (library-transfer:document $name $definition $reader $document)
   (case (library-transfer:materialize $name $definition $reader $document)
     (((Library:SourceRewrite $rewritten $support)
       (let $bytes (source-library:pack-codec "LC2" $name $rewritten) (Library:Candidate $bytes $support)))
      ($failed-rewrite $failed-rewrite))))

(= (library-transfer:collides? $layers $document)
   (if (== $layers ()) False
     (case (car-atom $layers)
       (((Library:Layer $codec $name)
         (or (source-library:mentions? $name $document)
           (library-transfer:collides? (cdr-atom $layers) $document)))))))
(= (library-transfer:fixed-prefix? $layers $expected $actual)
   (if (== $layers ()) True
     (if (or (== $expected ()) (== $actual ())) False
       (and (== (car-atom $expected) (car-atom $actual))
         (library-transfer:fixed-prefix? (cdr-atom $layers) (cdr-atom $expected) (cdr-atom $actual))))))

; Replay oldest first, including admitted sites in earlier helper bodies.
; Each step uses the existing LC2 transfer and exact local reconstruction.
(= (library-transfer:replay $stages $reader $layers $document $support)
   (if (== $stages ()) (Library:Replay $layers $document $support)
     (case (car-atom $stages)
       (((Library:Stage $codec $name $definition)
         (case (library-transfer:materialize $name $definition $reader $document)
           (((Library:SourceRewrite $after $here)
             (let* (($next (cons-atom (Library:Layer "LC2" $name) $layers))
                    ($total (+ $support $here)))
               (library-transfer:replay (cdr-atom $stages) $reader $next $after $total)))
            ((Library:Refused $reason) (Library:Refused (Library:TransferStep $name $reason)))
            ($bad-proposal (Library:Refused InvalidTransfer)))))
        ($bad-stage (Library:Refused InvalidTransfer))))))
(= (library-transfer:publish $expected-layers $expected-document $original $replayed)
   (case ($expected-document $replayed)
     ((((Syntax:Document $version $reader $expected)
         (Library:Replay $layers (Syntax:Document $actual-version $actual-reader $forms) $support))
       (let $document (Syntax:Document $actual-version $actual-reader $forms)
         (if (and (== $version $actual-version) (== $reader $actual-reader))
           (if (and (== (map-atom $layers $layer (case $layer (((Library:Layer $codec $name) $name))))
                        (map-atom $expected-layers $layer (case $layer (((Library:Layer $codec $name) $name)))))
                    (library-transfer:fixed-prefix? $expected-layers $expected $forms))
             (let $bytes (library-stack:pack $layers $document)
               (if (== (ic:library-unpack $bytes) (IC:Some $original))
                 (Library:Candidate $bytes $support) (Library:Refused Reconstruction)))
             (Library:Refused ChangedDefinitions))
           (Library:Refused DifferentReader))))
      (($expected (Library:Refused $reason)) (Library:Refused $reason))
      ($bad-replay (Library:Refused InvalidTransfer)))))
(= (library-transfer:stack $layers $source $document)
   (case (context-library:source-sites $document)
     (((Ctx:Source (Syntax:Document $version $reader $forms) $sites)
       (case $source
         (((Syntax:Document $donor-version $donor-reader $donor-forms)
           (if (== $reader $donor-reader)
             (if (library-transfer:collides? $layers $document) (Library:Refused NameCollision)
               (case (library-stack:stages $layers $source)
                 (((Library:Stages $stages)
                   (library-transfer:publish $layers $source $document
                     (library-transfer:replay (list:reverse $stages) $reader () $document 0)))
                  ($failed-stages $failed-stages)))) (Library:Refused DifferentReader)))
          ($bad-source (Library:Refused InvalidArtifact)))))
      ($source-refusal $source-refusal))))
(= (ic:reuse-library Deferred $artifact $document)
   (case (ic:export-library $artifact)
     (((Library:Export $name (Syntax:Document $version $reader $forms) $text $original)
       (if (== $forms ()) (Library:Refused NoLearnedLibrary)
         (library-transfer:document $name (car-atom $forms) $reader $document)))
      ((Library:ExportMany $layers $source $text $original) (library-transfer:stack $layers $source $document))
      ($artifact-refusal $artifact-refusal))))
