; Durable identified relations. Selectors are inert data; query cursors own a
; scan and borrow a captured view. All row/index changes share one publication.
!(import! &self "knowledge.metta")
!(import! &self (library list))
!(import! &self (library rel))

(= (kb:fact-prefix) "kb/fact/v1/")
(= (kb:relation-prefix $relation) (knowledge:address "kb/relation/v1/" $relation))
(= (kb:argument-prefix $relation $position $value)
   (knowledge:address "kb/argument/v1/"
     (cons-atom $relation (cons-atom $position (cons-atom $value ())))))
(= (kb:fact-key $identity) (knowledge:address (kb:fact-prefix) $identity))
(= (kb:equal $a $b)
   (if (and (knowledge:ground-identity? $a) (knowledge:ground-identity? $b))
       (kb:alpha-equal $a $b) (KbRefused nonground-equality)))
; Separate-term CAV encoding compares open terms modulo alpha-renaming. It
; cannot observe the identity of a variable shared with another live term.
(= (kb:alpha-equal $a $b)
   (case (knowledge:same $a $b) (((KnowledgeEqualV1 $same) $same) ($error $error))))
(= (kb:integer? $value)
   (case (get-metatype $value)
     ((Grounded (case (store:key-i64 $value) (((StoreKeyBytes $bytes) True) ($other False))))
      ($other False))))

(= (kb:fact $view $identity $bytes)
   (case (kb:fact-key $identity)
     (((KnowledgeAddressV1 $key)
       (case (store:get $view $key $bytes)
         ((StoreAbsent KbAbsent)
          ((StoreValue $body)
           (case (store:decode $body)
             (((StoreDecoded (KbFact $id $relation $fields))
               (if (kb:equal $id $identity) (KbFact $id $relation $fields)
                   (KbRefused fact-identity)))
              ($bad (KbRefused fact-format)))))
          ($error $error))))
      ($error $error))))

; Prepare every supplied edit before deduplication: an invalid edit cannot be
; hidden by a later replacement. Last edit of an identity wins within a batch.
(= (kb:edit $change)
   (if (knowledge:headed? $change) (kb:edit-value $change) (KbRefused edit-format)))
(= (kb:edit-value $change)
   (case $change
     (((KbPut $id $relation $fields)
       (if (and (knowledge:ground-identity? $relation) (== (get-metatype $fields) Expression))
           (case (kb:fact-key $id)
             (((KnowledgeAddressV1 $key)
               (case (store:encode (KbFact $id $relation $fields))
                 (((StoreEncoded $body) (KbEdit $key $id (KbFact $id $relation $fields) $body))
                  ($error $error))))
              ($error $error)))
           (KbRefused row-format)))
      ((KbDelete $id)
       (case (kb:fact-key $id)
         (((KnowledgeAddressV1 $key) (KbEdit $key $id KbAbsent "")) ($error $error))))
      ($bad (KbRefused edit-format)))))
(= (kb:edits $changes $reversed)
   (if (== (get-metatype $changes) Expression)
       (kb:edits-value $changes $reversed) (KbRefused edit-list)))
(= (kb:edits-value $changes $reversed)
   (if (== $changes ()) (KbEdits $reversed)
     (case (kb:edit (car-atom $changes))
       (((KbEdit $key $id $fact $body)
         (kb:edits (cdr-atom $changes) (cons-atom (KbEdit $key $id $fact $body) $reversed)))
        ($error $error)))))
; A stable key sort puts equal identities together; reversed input puts the
; last edit first within each group. No persistent new-space is allocated.
(= (kb:edit-key-less (KbEdit $a $ai $af $ab) (KbEdit $b $bi $bf $bb))
   (< (str:compare $a $b) 0))
(= (kb:unique-edits $sorted $previous $result)
   (if (== $sorted ()) (list:reverse $result)
     (let* ((($edit $rest) (decons-atom $sorted)) ((KbEdit $key $id $fact $body) $edit))
       (if (== $previous (KbPreviousKey $key))
           (kb:unique-edits $rest $previous $result)
           (kb:unique-edits $rest (KbPreviousKey $key) (cons-atom $edit $result))))))

; Complete CAV values delimit relation/argument keys. Each posting suffix is
; another complete CAV identity. Covering values make range validation observe
; all field changes, not merely a set of matching identifiers.
(= (kb:index-entry $prefix $id-bytes $body)
   (case $prefix
     (((KnowledgeAddressV1 $bytes) (KbEntry (str:concat $bytes $id-bytes) $body))
      ($error $error))))
(= (kb:argument-entries $relation $fields $position $id-bytes $body $reversed)
   (if (== $fields ()) (KbEntries (list:reverse $reversed))
     (let ($value $rest) (decons-atom $fields)
       (if (knowledge:ground-identity? $value)
           (case (kb:index-entry (kb:argument-prefix $relation $position $value) $id-bytes $body)
             (((KbEntry $key $bytes)
               (kb:argument-entries $relation $rest (+ $position 1) $id-bytes $body
                 (cons-atom (KbEntry $key $bytes) $reversed)))
              ($error $error)))
           (kb:argument-entries $relation $rest (+ $position 1) $id-bytes $body $reversed)))))
(= (kb:entries $fact)
   (if (== (get-metatype $fact) Variable) (KbRefused fact-format) (kb:entries-value $fact)))
(= (kb:entries-value $fact)
   (case $fact
     ((KbAbsent (KbEntries ()))
      ((KbFact $id $relation $fields)
       (case ((store:encode $id) (store:encode $fact))
         ((((StoreEncoded $id-bytes) (StoreEncoded $body))
           (case (kb:index-entry (kb:relation-prefix $relation) $id-bytes $body)
             (((KbEntry $key $bytes)
               (kb:argument-entries $relation $fields 0 $id-bytes $body ((KbEntry $key $bytes))))
              ($error $error))))
          ($error (KbRefused row-encoding)))))
      ($bad (KbRefused fact-format)))))
(= (kb:entry-operations $mode $entries)
   (map-atom $entries $entry
     (let (KbEntry $key $body) $entry (if (== $mode put) (put $key $body) (remove $key)))))
(= (kb:entry-scopes $entries)
   (map-atom $entries $entry (let (KbEntry $key $body) $entry (point $key))))
(= (kb:stage-one $view $edit $budget)
   (let (KbEdit $key $id $new $body) $edit
     (case (kb:fact $view $id $budget)
       ((KbAbsent (kb:stage-entries $key KbAbsent $new $body))
        ((KbFact $old-id $relation $fields)
         (kb:stage-entries $key (KbFact $old-id $relation $fields) $new $body))
        ($error $error)))))
(= (kb:stage-entries $key $old $new $body)
   (case ((kb:entries $old) (kb:entries $new))
     ((((KbEntries $before) (KbEntries $after))
       (let* (($remove (kb:entry-operations remove $before))
              ($put (kb:entry-operations put $after))
              ($fact (if (== $new KbAbsent) (remove $key) (put $key $body))))
         (KbDelta (cons-atom $fact (list:append $remove $put))
                  (cons-atom (point $key) (list:append (kb:entry-scopes $before) (kb:entry-scopes $after)))
                  ((point $key)))))
      ($error (KbRefused index-encoding)))))
(= (kb:stage $view $edits $budget $ops $writes $reads)
   (if (== $edits ()) (KbDelta (list:reverse $ops) (list:reverse $writes) (list:reverse $reads))
     (case (kb:stage-one $view (car-atom $edits) $budget)
       (((KbDelta $more $extra-writes $extra-reads)
         (kb:stage $view (cdr-atom $edits) $budget (list:append (list:reverse $more) $ops)
                   (list:append (list:reverse $extra-writes) $writes)
                   (list:append (list:reverse $extra-reads) $reads)))
        ($error $error)))))
; Selectors choose exact structural access paths. General pattern matching is
; layered on these streams and must not mistake structural equality for unify.
(= (kb:explain $selector)
   (if (or (== $selector KbAll) (knowledge:headed? $selector))
       (kb:explain-value $selector) (KbRefused selector-format)))
(= (kb:explain-value $selector)
   (case $selector
     ((KbAll (KbAccess facts (kb:fact-prefix)))
      ((KbRelation $relation)
       (case (kb:relation-prefix $relation)
         (((KnowledgeAddressV1 $prefix) (KbAccess relation $prefix)) ($error $error))))
      ((KbArgument $relation $position $value)
       (if (kb:integer? $position)
           (if (< $position 0) (KbRefused argument-position)
             (case (kb:argument-prefix $relation $position $value)
               (((KnowledgeAddressV1 $prefix) (KbAccess argument $prefix)) ($error $error))))
           (KbRefused argument-position)))
      ($bad (KbRefused selector-format)))))
(= (kb:observe-selector $view $selector)
   (case (kb:explain $selector)
     (((KbAccess $kind $prefix) (KnowledgeObservedOnV2 $view () (reads (prefix $prefix))))
      ($error $error))))
(= (kb:observe-empty $view) (KnowledgeObservedOnV2 $view () (reads)))
(= (kb:observe-facts $view $identities $budget)
   (if (== (get-metatype $identities) Expression)
       (kb:observe-facts-value $view $identities $budget) (KbRefused identity-list)))
(= (kb:observe-facts-value $view $identities $budget)
   (if (== $identities ()) (kb:observe-empty $view)
     (let $id (car-atom $identities)
       (case (kb:fact-key $id)
         (((KnowledgeAddressV1 $key)
           (case (kb:fact $view $id $budget)
             ((KbAbsent (kb:observe-fact-next $view $id KbAbsent $key (cdr-atom $identities) $budget))
              ((KbFact $identity $relation $fields)
               (kb:observe-fact-next $view $id (KbFact $identity $relation $fields) $key (cdr-atom $identities) $budget))
              ($error $error))))
          ($error $error))))))
(= (kb:observe-fact-next $view $id $fact $key $rest $budget)
   (case (kb:observe-facts $view $rest $budget)
     (((KnowledgeObservedOnV2 $captured $points $reads)
       (KnowledgeObservedOnV2 $captured (cons-atom (KbObservedFact $id $fact) $points)
         (cons-atom reads (cons-atom (point $key) (cdr-atom $reads)))))
      ($error $error))))
(= (kb:observation? $value)
   (if (knowledge:tagged? $value KnowledgeObservedOnV2 4)
     (let (KnowledgeObservedOnV2 $view $points $reads) $value
       (and (not (== (get-metatype $view) Variable))
         (and (== (get-metatype $points) Expression)
           (if (knowledge:headed? $reads)
             (and (== (car-atom $reads) reads) (knowledge:ground-identity? $reads)) False)))) False))
(= (kb:observe-merge $left $right)
   (if (and (kb:observation? $left) (kb:observation? $right))
     (let* (((KnowledgeObservedOnV2 $view $a $reads-a) $left)
            ((KnowledgeObservedOnV2 $other $b $reads-b) $right))
       (if (== $view $other)
         (KnowledgeObservedOnV2 $view (list:append $a $b)
           (cons-atom reads (list:append (cdr-atom $reads-a) (cdr-atom $reads-b))))
         (KnowledgeRefusedV1 observation-view)))
     (KnowledgeRefusedV1 bound-observation-required)))

; Validate a borrowed view without reading an application key or creating a
; new resource. Publisher-domain and commit validation remain separate.
(= (kb:validate-view $view)
   (case (store:view-info $view)
     (((StoreViewInfo $epoch $revision) KbViewReady)
      ($error $error))))
(= (kb:query-open $view $selector $budget)
   (case (kb:explain $selector)
     (((KbAccess $kind $prefix)
       (case (store:scan-open $view $prefix NoBound)
         (((StoreScan $scan) (KbCursor $view $scan 0 $prefix $budget 0 0 0))
          ($error $error))))
      ($error $error))))
; Detect key/body incongruence without loading any other row. Covering posts
; must name this row's own identity and one of its actual indexed values.
(= (kb:row-key? $key $id $relation $fields)
   (if (and (knowledge:ground-identity? $id) (knowledge:ground-identity? $relation))
       (if (== (get-metatype $fields) Expression)
           (case (store:encode $id)
             (((StoreEncoded $id-bytes)
               (if (== $key (str:concat (kb:fact-prefix) $id-bytes)) True
                 (case (kb:relation-prefix $relation)
                   (((KnowledgeAddressV1 $relation-prefix)
                     (if (== $key (str:concat $relation-prefix $id-bytes)) True
                         (kb:argument-key? $key $id-bytes $relation $fields 0)))
                    ($bad False)))))
              ($bad False))) False) False))
(= (kb:argument-key? $key $id-bytes $relation $fields $position)
   (if (== $fields ()) False
     (let ($value $rest) (decons-atom $fields)
       (if (knowledge:ground-identity? $value)
           (case (kb:argument-prefix $relation $position $value)
             (((KnowledgeAddressV1 $prefix)
               (if (== $key (str:concat $prefix $id-bytes)) True
                   (kb:argument-key? $key $id-bytes $relation $rest (+ $position 1))))
              ($bad False)))
           (kb:argument-key? $key $id-bytes $relation $rest (+ $position 1))))))
(= (kb:query-next (KbCursor $view $scan $position $prefix $budget $rows $examined $bytes))
   (case (store:scan-next $scan $position)
     ((StoreEnd (KbEnd (KbWork $rows $examined $bytes)))
      ((StoreKey $key $size $next)
       (if (str:starts-with $key $prefix)
           (case (store:get $view $key $budget)
             (((StoreValue $body)
               (case (store:decode $body)
                 (((StoreDecoded (KbFact $id $relation $fields))
                   (if (kb:row-key? $key $id $relation $fields)
                       (KbYield (KbFact $id $relation $fields)
                         (KbCursor $view $scan $next $prefix $budget (+ $rows 1) (+ $examined 1) (+ $bytes $size)))
                       (KbRefused index-identity)))
                  ($bad (KbRefused fact-format)))))
              ($error $error)))
           (KbEnd (KbWork $rows (+ $examined 1) $bytes))))
      ($error $error))))
(= (kb:query-close (KbCursor $view $scan $position $prefix $budget $rows $examined $bytes))
   (store:close $scan))
(= (kb:query-page $cursor $count)
   (if (kb:integer? $count)
       (if (> $count 0) (kb:page-walk $cursor $count ()) (KbRefused positive-page-size))
       (KbRefused positive-page-size)))
(= (kb:page-walk $cursor $remaining $reversed)
   (if (== $remaining 0) (KbPage (list:reverse $reversed) (KbMore $cursor))
     (case (kb:query-next $cursor)
       (((KbYield $row $next) (kb:page-walk $next (- $remaining 1) (cons-atom $row $reversed)))
        ((KbEnd $work) (KbPage (list:reverse $reversed) (KbComplete $work)))
        ($error $error)))))
(= (kb:query-all $cursor $reversed)
   (case (kb:query-next $cursor)
     (((KbYield $row $next) (kb:query-all $next (cons-atom $row $reversed)))
      ((KbEnd $work) (KbRows (list:reverse $reversed) $work))
      ($error $error))))
(= (kb:select $view $selector $budget)
   (case (kb:query-open $view $selector $budget)
     (((KbCursor $v $scan $position $prefix $bytes $rows $examined $decoded)
       (let* (($cursor (KbCursor $v $scan $position $prefix $bytes $rows $examined $decoded))
              ($answer (kb:query-all $cursor ())) ($closed (kb:query-close $cursor))) $answer))
      ($error $error))))
