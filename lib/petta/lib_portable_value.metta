; PV1 extends the portable value codec explicitly; BV1 is unchanged. Signed
; machine integers, F64 scalars and tensors use the existing packed CTN1 codec.
; Variable and runtime-handle identities are not portable values. Decoding
; constructs expressions as data and never invokes a decoded head.
!(import! &self (library lib_binary_value))
!(import! &self (library tensor))

(= (portable-value:kinds)
   (BinaryValue:Symbol BinaryValue:Text BinaryValue:Natural BinaryValue:Bytes
    BinaryValue:Expression PortableValue:Scalar PortableValue:Tensor))
(= (portable-value:schema)
   ((Binary:Form 1 BinaryValue:Symbol (Symbol))
    (Binary:Form 2 BinaryValue:Text (Text))
    (Binary:Form 3 BinaryValue:Natural (Natural))
    (Binary:Form 4 BinaryValue:Bytes (Bytes))
    (Binary:Form 5 BinaryValue:Expression ((Vector (Either (portable-value:kinds)))))
    (Binary:Form 6 BinaryValue:Archive (Text (Either (portable-value:kinds))))
    (Binary:Form 7 PortableValue:Scalar (Symbol Bytes))
    (Binary:Form 8 PortableValue:Tensor (Symbol Bytes))))
(= (portable-value:scalar $dtype $value)
   (let* (($tensor (tensor:from-values $dtype () ($value))) ($bytes (tensor:encode-bytes $tensor)))
     (if (binary-tree:bytes? $bytes) (BinaryValue:Some (PortableValue:Scalar $dtype $bytes))
       (BinaryValue:Fault UnsupportedValue))))
(= (portable-value:tensor $value)
   (let* (($dtype (tensor:dtype $value)) ($dense (tensor:convert $value dense))
          ($storage (if (== $dtype bool) (tensor:cast $dense u8 exact)
                      (if (== $dtype index) (tensor:cast $dense i64 exact) $dense)))
          ($bytes (tensor:encode-bytes $storage)))
     (if (binary-tree:bytes? $bytes) (BinaryValue:Some (PortableValue:Tensor $dtype $bytes))
       (BinaryValue:Fault UnsupportedValue))))
(= (portable-value:to-form $value)
   (case (binary:portable-kind $value)
     ((Expression
       (case (portable-value:to-forms $value)
         (((BinaryValue:Some $children) (BinaryValue:Some (BinaryValue:Expression $children)))
          ($failed $failed))))
      (Integer (portable-value:scalar i64 $value))
      (Float (portable-value:scalar f64 $value))
      (Tensor (portable-value:tensor $value))
      ($basic (binary-value:to-form $value)))))
(= (portable-value:to-forms $values)
   (if (== $values ()) (BinaryValue:Some ())
     (case ((portable-value:to-form (car-atom $values)) (portable-value:to-forms (cdr-atom $values)))
       ((((BinaryValue:Some $first) (BinaryValue:Some $rest))
         (BinaryValue:Some (cons-atom $first $rest)))
        (($failed (BinaryValue:Some $rest)) $failed)
        (($first $failed) $failed)))))
(= (portable-value:from-form $form)
   (case $form
     (((BinaryValue:Expression $children) (portable-value:from-forms $children))
      ((PortableValue:Scalar $dtype $bytes)
       (if (or (== $dtype i64) (== $dtype f64))
         (let $tensor (tensor:decode-bytes $bytes)
           (if (tensor:is-tensor $tensor)
             (if (and (== (tensor:dtype $tensor) $dtype) (== (tensor:shape $tensor) ()))
               (case (tensor:at $tensor ())
                 (((tensor:present $value) (BinaryValue:Value $value))
                  ($missing (BinaryValue:Fault InvalidValue)))) (BinaryValue:Fault InvalidValue))
             (BinaryValue:Fault InvalidValue))) (BinaryValue:Fault InvalidValue)))
      ((PortableValue:Tensor $dtype $bytes)
       (let $storage (tensor:decode-bytes $bytes)
         (if (tensor:is-tensor $storage)
           (let* (($stored (tensor:dtype $storage))
                  ($tensor (if (and (== $dtype bool) (== $stored u8)) (tensor:cast $storage bool exact)
                             (if (and (== $dtype index) (== $stored i64)) (tensor:cast $storage index exact)
                               (if (== $dtype $stored) $storage PV:Invalid)))))
             (if (tensor:is-tensor $tensor) (BinaryValue:Value $tensor) (BinaryValue:Fault InvalidValue)))
           (BinaryValue:Fault InvalidValue))))
      ($basic (binary-value:from-form $form)))))
(= (portable-value:from-forms $forms)
   (if (== $forms ()) (BinaryValue:Value ())
     (case ((portable-value:from-form (car-atom $forms)) (portable-value:from-forms (cdr-atom $forms)))
       ((((BinaryValue:Value $first) (BinaryValue:Value $rest))
         (BinaryValue:Value (cons-atom $first $rest)))
        ($failed (BinaryValue:Fault InvalidValue))))))
(= (portable-value:pack $value)
   (case (portable-value:to-form $value)
     (((BinaryValue:Some $form)
       (binary-schema:encode (portable-value:schema) (Record BinaryValue:Archive)
         (BinaryValue:Archive "PV1" $form))) ($failed $failed))))
(= (portable-value:unpack $bytes)
   (case (binary-schema:decode (portable-value:schema) (Record BinaryValue:Archive) $bytes)
     (((Binary:Value (BinaryValue:Archive "PV1" $form))
       (case (portable-value:from-form $form)
         (((BinaryValue:Value $value)
           (case (portable-value:pack $value)
             (((Binary:TreeBytes $canonical)
               (if (== $canonical $bytes) (BinaryValue:Value $value) (BinaryValue:Fault Noncanonical)))
              ($invalid (BinaryValue:Fault InvalidValue)))))
          ($failed $failed))))
      ((Binary:Value $other) (BinaryValue:Fault Version))
      ($failed $failed))))
