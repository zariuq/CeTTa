; Bounded data-derived prototype discovery. The stored model is an ordinary
; TP1 row-gather program inside NC2: centroids and every row assignment count.
; Farthest-first seeds and Lloyd updates are proposals, not acceptance evidence.
!(import! &self (library lib_ic_numeric_program))
!(import! &self (library lib_tensor_prototypes))

(= (tp-cluster:family)
   (TP:Family "TF1" ((TP:Operator "GatherRows" ("F64Tensor" "I64Tensor") "F64Tensor" TP:GatherRows))))
(= (tp-cluster:source $original)
   (case (binary-value:unpack $original)
     (((BinaryValue:Value (Numeric:ArrayArchive "NC2" () "F64Tensor" $stored-mask $criterion (Numeric:Raw $payload)))
       (case (ic-arrays:observe $original)
         (((IC:Some (Numeric:ArrayValues () "F64Tensor" $mask $comparison $points))
           (if (and (tp-prototypes:matrix? "F64Tensor" $points)
                    (> (index-atom (tensor:shape $points) 0) 0)) (TP:Points $points $mask) TP:None))
          ($invalid TP:None)))) ($invalid TP:None))))
(= (tp-cluster:indices? $values $count)
   (if (== (get-metatype $values) Expression)
     (if (== $values ()) True
       (and (binary:unsigned? (car-atom $values))
         (and (< (car-atom $values) $count) (tp-cluster:indices? (cdr-atom $values) $count)))) False))
(= (tp-cluster:counts? $values $count)
   (if (== (get-metatype $values) Expression)
     (if (== $values ()) True
       (and (binary:unsigned? (car-atom $values))
         (and (> (car-atom $values) 0)
           (and (<= (car-atom $values) $count) (tp-cluster:counts? (cdr-atom $values) $count))))) False))
(= (tp-cluster:region? $region $count)
   (case $region
     (((TP:ClusterRegion $counts $starts $updates)
       (and (tp-cluster:counts? $counts $count)
         (and (tp-cluster:indices? $starts $count) (binary:unsigned? $updates)))) ($invalid False))))
(= (tp-cluster:centers? $points $centers $maximum)
   (if (tp-prototypes:matrix? "F64Tensor" $centers)
     (let $shape (tensor:shape $centers)
       (and (> (index-atom $shape 0) 0)
         (and (<= (index-atom $shape 0) $maximum)
           (== (index-atom $shape 1) (index-atom (tensor:shape $points) 1))))) False))
(= (tp-cluster:distinct? $values)
   (if (== $values ()) True
     (and (not (ic-search:member? (car-atom $values) (cdr-atom $values)))
          (tp-cluster:distinct? (cdr-atom $values)))))
(= (tp-cluster:scalars? $values)
   (if (== (get-metatype $values) Expression)
     (if (== $values ()) True
       (case (ic-parameters:float (IC:FloatParameter (car-atom $values)))
         (((IC:ParameterValue $value) (tp-cluster:scalars? (cdr-atom $values))) ($invalid False)))) False))
(= (tp-cluster:farthest? $farthest $position $chosen)
   (case $farthest
     ((TP:None True)
      ((TP:Farthest $index $distance)
       (if (and (binary:unsigned? $index) (< $index $position))
         (if (ic-search:member? $index $chosen) False
           (case (ic-parameters:float (IC:FloatParameter $distance))
             (((IC:ParameterValue $number) (>= $number 0.0)) ($invalid False)))) False))
      ($invalid False))))
(= (tp-cluster:scan? $points $counts $updates $mode $count $iteration $centers $chosen $position $labels $farthest)
   (if (and (ic-search:member? $count $counts) (tp-cluster:centers? $points $centers $count))
     (if (and (binary:unsigned? $iteration) (<= $iteration $updates))
       (if (and (binary:unsigned? $position) (<= $position (index-atom (tensor:shape $points) 0)))
         (case $mode
           ((Seed
             (if (and (== $iteration 0) (== $labels ()))
               (if (tp-cluster:indices? $chosen (index-atom (tensor:shape $points) 0))
                 (and (tp-cluster:distinct? $chosen)
                   (and (== (size-atom $chosen) (index-atom (tensor:shape $centers) 0))
                        (tp-cluster:farthest? $farthest $position $chosen))) False) False))
            (Fit
             (if (and (== $chosen ()) (== $farthest TP:None))
               (if (tp-cluster:indices? $labels $count)
                 (and (== (index-atom (tensor:shape $centers) 0) $count)
                      (== (size-atom $labels) $position)) False) False))
            ($invalid False))) False) False) False))
(= (tp-cluster:label? $groups $label) (and (>= $label 0) (< $label $groups)))
(= (tp-cluster:labels? $labels $rows $groups)
   (if (ic-parameters:vector? i64 $labels)
     (if (== (tensor:shape $labels) ($rows))
       (let* (($valid (tensor:zip-map bool ($labels) tp-cluster:label? ($groups)))
              ($all (tensor:view (tensor:from-values bool () (True)) ($rows) (0) 0)))
         (== $valid $all)) False) False))
(= (tp-cluster:update? $points $counts $updates $iteration $centers $labels $group $coordinate $values)
   (if (tp-cluster:centers? $points $centers (index-atom (tensor:shape $points) 0))
     (let* (($shape (tensor:shape $centers)) ($groups (index-atom $shape 0)) ($width (index-atom $shape 1)))
       (if (and (ic-search:member? $groups $counts)
                (and (binary:unsigned? $iteration) (< $iteration $updates)))
         (if (and (binary:unsigned? $group) (binary:unsigned? $coordinate))
           (if (or (and (== $group $groups) (== $coordinate 0))
                   (or (and (< $group $groups) (< $coordinate $width))
                       (and (== $width 0) (and (== $group 0) (== $coordinate 0)))))
             (if (tp-cluster:scalars? $values)
               (and (== (size-atom $values) (+ (* $group $width) $coordinate))
                    (tp-cluster:labels? $labels (index-atom (tensor:shape $points) 0) $groups)) False)
             False) False) False)) False))
(= (tp-cluster:next $priority $proposal) (IC:Continue $priority $proposal))
(= (tp-cluster:begin $points $mask $count $start)
   (let $center (tp-prototypes:seed $points $mask $start)
     (tp-cluster:next $count (TP:ClusterScan Seed $count 0 $center ($start) 0 () TP:None))))
(= (tp-cluster:farthest $chosen $position $distance $best)
   (if (ic-search:member? $position $chosen) $best
     (case $best
       ((TP:None (TP:Farthest $position $distance))
        ((TP:Farthest $previous $previous-distance)
         (if (> $distance $previous-distance) (TP:Farthest $position $distance) $best))))))
(= (tp-cluster:program $centers $labels)
   (case ((tensor-program:constant "F64Tensor" $centers)
          (tensor-program:compact-constant "I64Tensor" $labels))
     ((((Binary:Leaf $center-bytes) (Binary:Leaf $label-bytes))
       (tensor-program:pack (tp-cluster:family)
         (Dag:Forest (2) ((Binary:Leaf $center-bytes) (Binary:Leaf $label-bytes)
                         (tensor-program:node 0 () (0 1)))))) ($invalid (TP:Fault ClusterProgram)))))
(= (tp-cluster:assigned $original $centers $labels $iteration $updates)
   (case (tp-cluster:program $centers $labels)
     (((TP:Artifact $program)
       (case (ic-numeric:program-candidate IC:ArrayArchive $original $program)
         (((IC:Candidate $bytes)
           (if (< $iteration $updates)
             (IC:Responses ((IC:Candidate $bytes)
               (tp-cluster:next (index-atom (tensor:shape $centers) 0)
                 (TP:ClusterUpdate $iteration $centers $labels 0 0 ()))))
             (IC:Responses ((IC:Candidate $bytes))))) ($failed $failed)))) ($invalid (IC:Refused ClusterProgram)))))
(= (tp-cluster:scanned $original $points $mask $mode $count $iteration $centers $chosen $labels $farthest $updates)
   (if (== $mode Seed)
     (if (< (index-atom (tensor:shape $centers) 0) $count)
       (case $farthest
         (((TP:Farthest $position $distance)
           (let $next (tensor:concatenate $centers (tp-prototypes:seed $points $mask $position) 0)
             (tp-cluster:next $count (TP:ClusterScan Seed $count 0 $next
               (cons-atom $position $chosen) 0 () TP:None)))) ($invalid (IC:Refused ClusterSeed))))
       (tp-cluster:next $count (TP:ClusterScan Fit $count $iteration $centers () 0 () TP:None)))
     (let $assignments (tensor:from-values i64 ((index-atom (tensor:shape $points) 0)) (list:reverse $labels))
       (tp-cluster:assigned $original $centers $assignments $iteration $updates))))
(= (tp-cluster:scan $original $points $mask $mode $count $iteration $centers $chosen $position $labels $farthest $updates $quantum)
   (if (== $position (index-atom (tensor:shape $points) 0))
     (tp-cluster:scanned $original $points $mask $mode $count $iteration $centers $chosen $labels $farthest $updates)
     (if (== $quantum 0)
       (tp-cluster:next $count (TP:ClusterScan $mode $count $iteration $centers $chosen $position $labels $farthest))
       (case (tp-prototypes:nearest $centers (tp-prototypes:row $points $position)
                (tp-prototypes:row $mask $position) 0 TP:None)
         (((TP:Nearest $group $distance)
           (let* (($next-labels (if (== $mode Fit) (cons-atom $group $labels) $labels))
                  ($next-farthest (if (== $mode Seed) (tp-cluster:farthest $chosen $position $distance $farthest) $farthest)))
             (tp-cluster:scan $original $points $mask $mode $count $iteration $centers $chosen
               (+ $position 1) $next-labels $next-farthest $updates (- $quantum 1))))
          ($invalid (IC:Refused ClusterDistance)))))))
(= (tp-cluster:update $points $mask $iteration $centers $labels $group $coordinate $values $quantum)
   (let* (($shape (tensor:shape $centers)) ($count (index-atom $shape 0)) ($width (index-atom $shape 1)))
     (if (or (== $group $count) (== $width 0))
       (let $next (tensor:from-values f64 $shape (list:reverse $values))
         (if (tensor-program:value? "F64Tensor" $next)
           (if (== (tensor:encode-bytes $next) (tensor:encode-bytes $centers)) (IC:Responses ())
             (tp-cluster:next $count (TP:ClusterScan Fit $count (+ $iteration 1) $next () 0 () TP:None)))
           (IC:Refused ClusterUpdate)))
       (if (== $quantum 0)
         (tp-cluster:next $count (TP:ClusterUpdate $iteration $centers $labels $group $coordinate $values))
         (case (tp-prototypes:mean $points $mask $labels $centers $group $coordinate)
           (((TP:Some $value)
             (let* (($last (== (+ $coordinate 1) $width))
                    ($next-group (if $last (+ $group 1) $group))
                    ($next-coordinate (if $last 0 (+ $coordinate 1))))
               (tp-cluster:update $points $mask $iteration $centers $labels $next-group $next-coordinate
                 (cons-atom $value $values) (- $quantum 1)))) ($invalid (IC:Refused ClusterMean))))))))

(= (ic-search:observation (TP:ClusterModel $region) $artifact)
   (case (ic-arrays:observe $artifact)
     (((IC:Some $observation) (IC:Some (TP:ClusterObservation $region $observation))) ($invalid IC:None))))
(= (ic-search:consider (TP:ClusterModel $region) $original $best $candidate)
   (ic-search:consider IC:ArrayArchive $original $best $candidate))
(= (tp-cluster:materialize $original $region $proposal $points $mask)
   (if (tp-cluster:region? $region (index-atom (tensor:shape $points) 0))
     (case $region
     (((TP:ClusterRegion $counts $starts $updates)
       (case $proposal
         (((TP:ClusterSeed $count $start)
           (if (and (ic-search:member? $count $counts) (ic-search:member? $start $starts))
             (tp-cluster:begin $points $mask $count $start) (IC:ProducerFault ClusterSeed)))
          ((TP:ClusterScan $mode $count $iteration $centers $chosen $position $labels $farthest)
           (case (tp-prototypes:owned "F64Tensor" $centers)
             (((TP:Some $dense)
               (if (tp-cluster:scan? $points $counts $updates $mode $count $iteration $dense $chosen $position $labels $farthest)
                 (tp-cluster:scan $original $points $mask $mode $count $iteration $dense $chosen $position $labels $farthest $updates 64)
                 (IC:ProducerFault ClusterCursor))) ($invalid (IC:ProducerFault ClusterCursor)))))
          ((TP:ClusterUpdate $iteration $centers $labels $group $coordinate $values)
           (case (tp-prototypes:owned "F64Tensor" $centers)
             (((TP:Some $dense)
               (if (tp-cluster:update? $points $counts $updates $iteration $dense $labels $group $coordinate $values)
                 (tp-cluster:update $points $mask $iteration $dense $labels $group $coordinate $values 64)
                 (IC:ProducerFault ClusterCursor))) ($invalid (IC:ProducerFault ClusterCursor)))))
          ($invalid (IC:ProducerFault ClusterProposal)))))))
     (IC:ProducerFault ClusterRegion)))
(= (ic-search:materialize (TP:ClusterModel $region) $original $proposal)
   (case (tp-cluster:source $original)
     (((TP:Points $points $mask) (tp-cluster:materialize $original $region $proposal $points $mask))
      ($invalid (IC:ProducerFault ClusterTask)))))
(= (tp-cluster:seeds $count $starts)
   (if (== $starts ()) ()
     (let $handle (work-new (ic-search:from-list ((IC:Proposal (TP:ClusterSeed $count (car-atom $starts))))))
       (cons-atom (IC:Branch $count $handle) (tp-cluster:seeds $count (cdr-atom $starts))))))
(= (tp-cluster:branches $counts $starts)
   (if (== $counts ()) ()
     (union-atom (tp-cluster:seeds (car-atom $counts) $starts) (tp-cluster:branches (cdr-atom $counts) $starts))))
(= (tp-cluster:release $branches)
   (if (== $branches ()) ()
     (case (car-atom $branches)
       (((IC:Branch $priority $handle) (let $closed (work-cancel $handle) (tp-cluster:release (cdr-atom $branches))))))))
(= (ic:prepare-fit Numeric:Clusters $original $region $sources)
   (if (== (get-metatype $sources) Expression)
     (case (tp-cluster:source $original)
     (((TP:Points $points $mask)
       (if (tp-cluster:region? $region (index-atom (tensor:shape $points) 0))
         (case $region
           (((TP:ClusterRegion $counts $starts $updates)
             (let $branches (tp-cluster:branches $counts $starts)
               (case (ic:prepare (TP:ClusterModel $region) $original (cons-atom (context-space) $sources) 64 $branches)
                 (((IC:PreparedSearch $state) (IC:PreparedSearch $state))
                  ($failed (let $closed (tp-cluster:release $branches) $failed))))))))
         (IC:FitRefused ClusterRegion))) ($invalid (IC:FitRefused ClusterTask))))
     (IC:FitRefused ClusterSources)))
(= (ic:fit Numeric:Clusters $original $region $sources $budget)
   (case (ic:prepare-fit Numeric:Clusters $original $region $sources)
     (((IC:PreparedSearch $state) (ic:resume $state $budget)) ($failed $failed))))

; A predictive prototype model has one declared GatherRows node over two
; literal tensors. No caller cache or uncharged external table is consulted.
(= (tp-cluster:model $artifact)
   (case (binary-value:unpack $artifact)
     (((BinaryValue:Value (Numeric:ArrayArchive "NC2" () "F64Tensor" $mask $criterion (Numeric:Program $program)))
       (case (binary-value:unpack $program)
         (((BinaryValue:Value (TP:Program "TP1"
              (TP:Family "TF1" ((TP:Operator $name ("F64Tensor" "I64Tensor") "F64Tensor" TP:GatherRows)))
              (Dag:Forest (2) ((Binary:Leaf $centers) (Binary:Leaf $labels) (Binary:Node $tag (0 1))))))
           (case ((tensor-program:leaf () $centers) (binary-value:unpack $tag) (ic-arrays:observe $artifact))
             ((((TP:Value "F64Tensor" $values) (BinaryValue:Value (TP:Apply 0 ())) (IC:Some $observation))
               (if (and (tp-prototypes:matrix? "F64Tensor" $values) (> (index-atom (tensor:shape $values) 0) 0))
                 (TP:Some $values) TP:None)) ($invalid TP:None)))) ($invalid TP:None)))) ($invalid TP:None))))
(= (tp-cluster:predict $artifact $points $mask)
   (case ((tp-cluster:model $artifact) (tp-prototypes:owned "F64Tensor" $points) (tp-prototypes:owned "BoolTensor" $mask))
     ((((TP:Some $centers) (TP:Some $values) (TP:Some $observed))
       (if (and (== (tensor:shape $values) (tensor:shape $observed))
                (== (index-atom (tensor:shape $values) 1) (index-atom (tensor:shape $centers) 1)))
         (case (tp-prototypes:assign $values $observed $centers 0 ())
           (((TP:Some $labels)
             (let $reconstruction (tensor:gather-rows $centers (tensor:cast $labels index exact))
               (IC:ClusterPrediction $labels $reconstruction))) ($invalid (IC:NumericFault Prediction))))
         (IC:NumericFault Inputs))) ($invalid (IC:NumericFault NoModel)))))
(= (ic:predict Numeric:Clusters $artifact $inputs)
   (case $inputs
     (((Numeric:Points $points $mask) (tp-cluster:predict $artifact $points $mask))
      ($points
       (if (tp-prototypes:matrix? "F64Tensor" $points)
         (let* (($shape (tensor:shape $points))
                ($mask (tensor:view (tensor:from-values bool () (True)) $shape (0 0) 0)))
           (tp-cluster:predict $artifact $points $mask)) (IC:NumericFault Inputs))))))
