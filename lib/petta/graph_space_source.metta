; Edge iteration for the existing MeTTa graph walker over captured ordinary
; Spaces. Only this adapter knows the collection and native query interface.
!(import! &self "durable_query.metta")

(: kbg:open-space (-> %Undefined% Atom Number Atom Number Number %Undefined%))
(: kbg-space:project (-> Atom Atom Number Atom Number Atom %Undefined%))
(= (kbg:open-space $view $collection $arity $plan $bytes $states)
  (if (and (kb:integer? $arity) (knowledge:ground-identity? $collection))
    (if (and (> $arity 0) (<= $arity 65536))
      (case (kbg:plan $plan)
        (((KgSetup (KgRelation $relation $from $to) $start $direction $mode)
          (if (and (< (+ $from 1) $arity) (< (+ $to 1) $arity))
            (case (store:view-clone $view)
              (((StoreSnapshot $copy $epoch $revision)
                (let* (($source (KgSpaceV1 $copy $collection $arity))
                       ($cursor (kbg:open $source $plan $bytes $states)))
                  (if (kbg:cursor? $cursor)
                    (case (store:program-watch-open)
                      (((StoreProgramWatch $watch)
                        (let (KgCursor $base $config $mode $frontier $active $work) $cursor
                          (KgCursor (KgSpaceV2 $copy $collection $arity $watch) $config $mode $frontier $active $work)))
                       ($failure (let $_ (kbg:close $cursor) $failure))))
                    (let $_ (store:close $copy) $cursor))))
               ($failure $failure)))
            (KbRefused graph-field-position)))
         ($failure $failure)))
      (KbRefused graph-arity))
    (KbRefused graph-source)))
(= (kbg:source-validate $source)
  (if (knowledge:tagged? $source KgSpaceV1 4)
    (let (KgSpaceV1 $view $collection $arity) $source
      (case (durable-space:cursor $view $collection $row $row)
        (((StoreQueryOpened $query $epoch $revision)
          (let $_ (store:close $query) KbViewReady))
         ($failure $failure))))
    (kb:validate-view $source)))
(= (kbg:source-close-view $source)
  (if (knowledge:tagged? $source KgSpaceV2 5)
    (let (KgSpaceV2 $view $collection $arity $watch) $source
      (let* (($_ (store:close $view)) ($_ (store:close $watch))) KgClosed))
    (if (knowledge:tagged? $source KgSpaceV1 4)
      (let (KgSpaceV1 $view $collection $arity) $source (store:close $view)) KgClosed)))
(= (kbg:base-source $source)
  (if (knowledge:tagged? $source KgSpaceV2 5)
    (let (KgSpaceV2 $view $collection $arity $watch) $source
      (KgSpaceV1 $view $collection $arity)) $source))
(= (kbg:program-check $source)
  (if (knowledge:tagged? $source KgSpaceV2 5)
    (let (KgSpaceV2 $view $collection $arity $watch) $source (store:program-watch-check $watch)) StoreProgramCurrent))
(= (kbg:read-context $cursor)
  (if (kbg:cursor? $cursor)
    (let (KgCursor $source $config $mode $frontier $active $work) $cursor
      (case $source
        (((KgSpaceV2 $view $collection $arity $watch) (durable-query:context $view $watch))
         ($other (KbRefused program-observation-required))))) (KbRefused graph-cursor)))
(= (kbg:source-observe $source $relation)
  (if (knowledge:tagged? $source KgSpaceV2 5)
    (kbg:source-observe (kbg:base-source $source) $relation)
   (if (knowledge:tagged? $source KgSpaceV1 4)
    (let (KgSpaceV1 $view $collection $arity) $source
      (case (store:view-info $view)
        (((StoreViewInfo $epoch $revision) (KgSpaceObservationV1 $epoch $revision $collection))
         ($failure $failure))))
    (kb:observe-selector $source (KbRelation $relation)))))
; Observed counters describe the current adjacency scan, not a cost forecast
; or the total graph traversal. The ordinary KgWork carries cumulative visits
; and decoded bytes, including the additional original-occurrence reads.
(= (kbg:inspect-space $cursor)
  (if (kbg:cursor? $cursor)
    (let (KgCursor $source $config $mode $frontier $active $work) $cursor
      (kbg:inspect-source $source $config $mode $frontier $active $work)) (KbRefused graph-cursor)))
(= (kbg:inspect-source $source $config $mode $frontier $active $work)
  (case $source
    (((KgSpaceV2 $view $collection $arity $watch)
      (kbg:inspect-source (KgSpaceV1 $view $collection $arity) $config $mode $frontier $active $work))
     ((KgSpaceV1 $view $collection $arity)
      (case (store:view-info $view)
        (((StoreViewInfo $epoch $revision)
          (let $access
            (case $active
              (((KgScan (KgSpaceScanV1 $v $c $a $r $p $s $query $n $k $b $points) $path)
                (store:space-query-info $query))
               ($idle KgNoActiveScanV1)))
            (KgSpaceInspectionV1 $epoch $revision $collection $arity $work $access)))
         ($failure $failure))))
     ($failure (KbRefused graph-source)))))

; Recursive activations supply distinct holes. A repeated placeholder would
; accidentally equate unrelated endpoint/property fields.
(= (kbg-space:fields $remaining $index $position $start)
  (if (== $remaining 0) ()
    (let $tail (kbg-space:fields (- $remaining 1) (+ $index 1) $position $start)
      (if (== $index $position) (cons-atom $start $tail) (cons-atom $fresh $tail)))))
(= (kbg:source-open $source (KbArgument $relation $position $start) $bytes)
  (if (knowledge:tagged? $source KgSpaceV1 4)
    (let (KgSpaceV1 $view $collection $arity) $source
      (let* (((KgDataV1 $probe) (if (durable-index:exact? $start) (KgDataV1 $start) (KgDataV1 $unbound)))
             ($fields (kbg-space:fields (- $arity 1) 0 $position $probe))
             ($safe-head (and (durable-index:exact? $relation) (not (or (== $relation ,) (== $relation |)))))
             ($pattern (if $safe-head (cons-atom $relation $fields) $whole)))
        (case (durable-space:cursor $view $collection $pattern ())
          (((StoreQueryOpened $query $epoch $revision)
            (KgSpaceScanV1 $view $collection $arity $relation $position $start $query 0 0 0 0))
           ($failure $failure)))))
    (kb:query-open $source (KbArgument $relation $position $start) $bytes)))
(= (kbg:source-scan? $scan)
  (if (knowledge:tagged? $scan KgSpaceScanV1 12)
    (let (KgSpaceScanV1 $view $collection $arity $relation $position $start $query $sequence $keys $native $points) $scan
      (and (kbg:nonnegative? $sequence) (and (kbg:nonnegative? $keys)
        (and (kbg:nonnegative? $native) (kbg:nonnegative? $points)))))
    (if (knowledge:tagged? $scan KbCursor 9)
      (let (KbCursor $v $s $position $prefix $budget $rows $keys $bytes) $scan
        (and (kbg:nonnegative? $position) (and (kbg:nonnegative? $budget)
          (and (kbg:nonnegative? $rows) (and (kbg:nonnegative? $keys) (kbg:nonnegative? $bytes)))))) False)))
(= (kbg:source-work $scan)
  (case $scan
    (((KgSpaceScanV1 $v $c $a $r $p $s $q $n $keys $native $points) (KgSourceWork $keys (+ $native $points)))
     ((KbCursor $v $s $p $f $b $n $keys $bytes) (KgSourceWork $keys $bytes)))))
(= (kbg:source-close $scan)
  (if (knowledge:tagged? $scan KgSpaceScanV1 12)
    (let (KgSpaceScanV1 $v $c $a $r $p $s $q $n $k $b $points) $scan
      (let* (($_ (store:space-query-cancel $q)) ($_ (store:close $q))) KgClosed))
    (kb:query-close $scan)))

; Return the actual ground edge projection. Unification is a candidate
; selector: it may instantiate an open stored field or promote numbers.
(= (kbg-space:project $identity $atom $arity $relation $position $start)
  (if (== (get-metatype $atom) Expression)
    (if (== (size-atom $atom) $arity)
      (let* ((($head $fields) (decons-atom $atom))
             ((KgDataV1 $selected) (kbg:data-at $fields $position)))
        (if (and (knowledge:ground-identity? $head) (knowledge:ground-identity? $selected))
          (if (and (kb:equal $head $relation) (kb:equal $selected $start))
            (KbFact $identity $head $fields) KgNotEdge) KgNotEdge)) KgNotEdge) KgNotEdge))
(= (kbg:source-next $scan $maximum)
  (if (knowledge:tagged? $scan KgSpaceScanV1 12)
    (kbg-space:next $scan (if (> $maximum 1048576) 1048576 $maximum))
    (kb:query-next $scan)))
(= (kbg-space:next (KgSpaceScanV1 $view $collection $arity $relation $position $start $query $sequence $keys $native $points) $maximum)
  (let* (($answer (store:space-query-next $query $sequence 1 $maximum))
         ($checkpoint (store:space-query-checkpoint $query)))
    (if (== $checkpoint StoreQueryCheckpointed)
      (case (store:space-query-info $query)
        (((StoreQueryInfo $scans $indexes $examined $decoded $overflow)
          (if $overflow (KbRefused graph-statistics-overflow)
          (let $next (KgSpaceScanV1 $view $collection $arity $relation $position $start $query $sequence $examined $decoded $points)
            (case $answer
              ((StoreQueryPaused (KbContinue $next))
               (StoreQueryEnd (KbEnd (KbWork 0 $examined (+ $decoded $points))))
               ((StoreQueryRow $same $ignored ($identity))
                (case (durable-space:read $view $collection $identity $maximum)
                  (((SpaceOccurrenceReadV1 $atom $bytes)
                    (let* (($after (KgSpaceScanV1 $view $collection $arity $relation $position $start $query (+ $sequence 1) $examined $decoded (+ $points $bytes)))
                           ($fact (kbg-space:project $identity $atom $arity $relation $position $start)))
                      (if (== $fact KgNotEdge) (KbContinue $after) (KbYield $fact $after))))
                   ($failure (KgSourceFailureV1 $failure $examined (+ $decoded $points))))))
               ($failure (KgSourceFailureV1 $failure $examined (+ $decoded $points))))))))
         ($failure (KbRefused (GraphStatisticsV1 $failure)))))
      $checkpoint)))
