; Historical source ranges use a complete original-candidate scan. Cardinality
; remains the source's full count; no filtered count is manufactured.
(: plain-range:open (-> %Undefined% Atom Number Number Atom Atom Atom Atom Number %Undefined%))
(= (plain-range:open $space $collection $arity $position $lower $upper $pattern $template $maximum)
  (if (and (== $collection data) (range-i:atomic? $pattern))
    (case (store:encode (KqMatch $pattern $template))
      (((StoreEncoded $program) (plain-range:prepare $space $arity $position $lower $upper $program $maximum))
       ($failure $failure)))
    (KbRefused scalar-range-plan)))
(= (plain-range:raw-open $space $arity $position $lower $upper)
  (plain-range:prepare $space $arity $position $lower $upper RawRangeValuesV1 (store:value-byte-limit)))
(= (plain-range:prepare $space $arity $position $lower $upper $program $maximum)
  (if (durable-index:dimensions? $arity $position)
    (case (store:integer-window $lower $upper)
      ((StoreIntegerWindowEmptyV1 (plain-range:source $space $arity $position $lower $upper $program $maximum))
       ((StoreIntegerWindowV1 $_ $_) (plain-range:source $space $arity $position $lower $upper $program $maximum))
       ($failure $failure)))
    (KbRefused scalar-range-plan)))
(= (plain-range:source $space $arity $position $lower $upper $program $maximum)
  (case (store:source-open $space)
    (((StoreSourceOpened $source $_ $_)
      (let* (($opened (store:source-scan $source)) ($_ (store:close $source)))
        (case $opened
          (((StoreCandidateOpened $cursor $sequence)
            (KqReady (KqPlainRangeStateV1 $cursor $sequence $arity $position $lower $upper $program $maximum RangeIdleV1)))
           ($failure $failure)))))
     ($failure $failure))))
(= (plain-range:close (KqPlainRangeStateV1 $cursor $sequence $arity $position $lower $upper $program $maximum $point))
  (let* (($_ (if (== $point RangeIdleV1) KqClosed (kbq:close-state $point)))
         ($_ (store:close $cursor))) KqClosed))
(= (plain-range:fail $state $failure $keys $bytes)
  (let $_ (plain-range:close $state) (KqFail $failure $keys $bytes)))
(= (plain-range:advance (KqPlainRangeStateV1 $cursor $sequence $arity $position $lower $upper $program $maximum $point))
  (let $state (KqPlainRangeStateV1 $cursor $sequence $arity $position $lower $upper $program $maximum $point)
    (if (== $point RangeIdleV1)
      (plain-range:next $state (store:candidate-next $cursor $sequence 1))
      (case (kbq:advance $point)
        (((KqOut $row $next $keys $bytes)
          (KqOut $row (KqPlainRangeStateV1 $cursor $sequence $arity $position $lower $upper $program $maximum $next) $keys $bytes))
         ((KqSkip $next $keys $bytes)
          (KqSkip (KqPlainRangeStateV1 $cursor $sequence $arity $position $lower $upper $program $maximum $next) $keys $bytes))
         ((KqEnd $keys $bytes)
          (KqSkip (KqPlainRangeStateV1 $cursor $sequence $arity $position $lower $upper $program $maximum RangeIdleV1) $keys $bytes))
         ((KqFail $failure $keys $bytes) (plain-range:fail $state $failure $keys $bytes)))))))
(= (plain-range:next (KqPlainRangeStateV1 $cursor $sequence $arity $position $lower $upper $program $maximum $point) $answer)
  (let $state (KqPlainRangeStateV1 $cursor $sequence $arity $position $lower $upper $program $maximum $point)
    (case $answer
      ((StoreCandidatePaused (KqSkip $state 0 0))
       (StoreCandidateEnd (let $_ (store:close $cursor) (KqEnd 0 0)))
       ((StoreCandidateRow $same $body-size $identity-size)
        (if (== $same $sequence)
          (let* (((StoreCandidatePacket $_ body $body) (store:candidate-packet $cursor $sequence body))
                 ((StoreCandidatePacket $_ identity $identity) (store:candidate-packet $cursor $sequence identity))
                 ((StoreDecoded $atom) (store:decode $body)) ((StoreDecoded $reference) (store:decode $identity))
                 ($next (KqPlainRangeStateV1 $cursor (+ $sequence 1) $arity $position $lower $upper $program $maximum RangeIdleV1)))
            (plain-range:filter $next $atom $reference $body-size))
          (plain-range:fail $state (KbRefused range-sequence) 0 0)))
       ($failure (plain-range:fail $state $failure 0 0))))))
(: plain-range:filter (-> Atom Atom Atom Number %Undefined%))
(= (plain-range:filter (KqPlainRangeStateV1 $cursor $sequence $arity $position $lower $upper $program $maximum $point) $atom $identity $bytes)
  (let $state (KqPlainRangeStateV1 $cursor $sequence $arity $position $lower $upper $program $maximum $point)
    (case (durable-index:project $atom $arity $position)
      (((SpaceIndexFieldV1 $field)
        (case (store:scalar-range $field $lower $upper)
          ((StoreScalarWithinV1 (plain-range:matched $state $atom $identity $bytes))
           (StoreScalarOutsideV1 (KqSkip $state 1 $bytes))
           ($failure (plain-range:fail $state $failure 1 $bytes)))))
       ($outside (KqSkip $state 1 $bytes))))))
(: plain-range:matched (-> Atom Atom Atom Number %Undefined%))
(= (plain-range:matched (KqPlainRangeStateV1 $cursor $sequence $arity $position $lower $upper $program $maximum $point) $atom $identity $bytes)
  (let $state (KqPlainRangeStateV1 $cursor $sequence $arity $position $lower $upper $program $maximum $point)
    (if (== $program RawRangeValuesV1)
      (KqOut (SpaceOriginalV1 $atom $identity) $state 1 $bytes)
      (case (remote-range:original $atom $identity $program $maximum)
        (((KqReady $query)
          (KqSkip (KqPlainRangeStateV1 $cursor $sequence $arity $position $lower $upper $program $maximum $query) 1 $bytes))
         ($failure (plain-range:fail $state $failure 1 $bytes)))))))
