; Named finite tensor parameters in a chronological TP1 template. Domains are
; snapshotted as checked constant records before work is retained. Producers
; enumerate occurrence indices, never packed values or decoded call heads.
!(import! &self (library lib_ic_numeric_program))

(= (tp-parameters:constants $sort $values)
   (if (== (get-metatype $values) Expression)
     (if (== $values ()) (TP:Some ())
       (case ((tensor-program:constant $sort (car-atom $values))
              (tp-parameters:constants $sort (cdr-atom $values)))
         ((((Binary:Leaf $bytes) (TP:Some $rest))
           (let $choices (cons-atom (Binary:Leaf $bytes) $rest) (TP:Some $choices)))
          ($invalid (TP:Fault ParameterValues))))) (TP:Fault ParameterValues)))
(= (tp-parameters:domains $domains $names)
   (if (== (get-metatype $domains) Expression)
     (if (== $domains ()) (TP:Some ())
       (case (car-atom $domains)
         (((TP:ParameterDomain $name $sort $values)
           (if (and (binary-schema:text? $name)
                 (and (tensor-program:sort? $sort) (not (binary-schema:member? $name $names))))
             (let $later-names (cons-atom $name $names)
               (case ((tp-parameters:constants $sort $values)
                      (tp-parameters:domains (cdr-atom $domains) $later-names))
                 ((((TP:Some $choices) (TP:Some $rest))
                   (let* (($row (TP:ParameterChoices $name $sort $choices))
                          ($rows (cons-atom $row $rest))) (TP:Some $rows)))
                  ($invalid (TP:Fault ParameterDomains))))) (TP:Fault ParameterDomains)))
          ($invalid (TP:Fault ParameterDomains))))) (TP:Fault ParameterDomains)))
(= (tp-parameters:lookup $rows $name $position)
   (if (== $rows ()) TP:None
     (case (car-atom $rows)
       (((TP:ParameterChoices $key $sort $choices)
         (if (== $key $name) (TP:Some $position)
           (tp-parameters:lookup (cdr-atom $rows) $name (+ $position 1))))))))
(= (tp-parameters:normalize-record $rows $record)
   (case $record
     (((TP:Parameter $name)
       (case (tp-parameters:lookup $rows $name 0)
         (((TP:Some $index) (TP:Some (TP:ParameterSlot $index))) ($missing TP:None))))
      ((Binary:Leaf $bytes) (TP:Some $record))
      ((Binary:Node $bytes $children) (TP:Some $record))
      ($invalid TP:None))))
(= (tp-parameters:normalize $rows $records)
   (if (== (get-metatype $records) Expression)
     (if (== $records ()) (TP:Some ())
       (case ((tp-parameters:normalize-record $rows (car-atom $records))
              (tp-parameters:normalize $rows (cdr-atom $records)))
         ((((TP:Some $first) (TP:Some $rest))
           (let $result (cons-atom $first $rest) (TP:Some $result))) ($invalid TP:None)))) TP:None))

(= (tp-parameters:constant? $sort $record)
   (case $record
     (((Binary:Leaf $bytes)
       (case (binary-value:unpack $bytes)
         (((BinaryValue:Value (TP:Constant $actual $payload))
           (and (== $actual $sort) (== (tensor-program:leaf-type $bytes) (TP:Some $sort))))
          ($invalid False)))) ($invalid False))))
(= (tp-parameters:constants? $sort $choices)
   (if (== (get-metatype $choices) Expression)
     (if (== $choices ()) True
       (and (tp-parameters:constant? $sort (car-atom $choices))
            (tp-parameters:constants? $sort (cdr-atom $choices)))) False))
(= (tp-parameters:rows? $rows $names)
   (if (== (get-metatype $rows) Expression)
     (if (== $rows ()) True
       (case (car-atom $rows)
         (((TP:ParameterChoices $name $sort $choices)
           (if (and (binary-schema:text? $name)
                 (and (tensor-program:sort? $sort) (not (binary-schema:member? $name $names))))
             (let $later (cons-atom $name $names)
               (and (tp-parameters:constants? $sort $choices)
                    (tp-parameters:rows? (cdr-atom $rows) $later))) False)) ($invalid False)))) False))
(= (tp-parameters:record-type $family $rows $types $record)
   (case $record
     (((TP:ParameterSlot $index)
       (case (tensor-program:at $rows $index)
         (((TP:Some (TP:ParameterChoices $name $sort $choices)) (TP:Some $sort)) ($invalid TP:None))))
      ((Binary:Leaf $bytes) (tensor-program:record-type $family $types $record))
      ((Binary:Node $bytes $children)
       (if (tensor-program:naturals? $children)
         (tensor-program:record-type $family $types $record) TP:None))
      ($invalid TP:None))))
(= (tp-parameters:types $family $rows $types $records)
   (if (== (get-metatype $records) Expression)
     (if (== $records ()) (TP:Some $types)
       (case (tp-parameters:record-type $family $rows $types (car-atom $records))
         (((TP:Some $sort)
           (let $later (union-atom $types (cons-atom $sort ()))
             (tp-parameters:types $family $rows $later (cdr-atom $records)))) ($invalid TP:None)))) TP:None))
(= (tp-parameters:used? $index $records)
   (if (== $records ()) False
     (or (== (car-atom $records) (TP:ParameterSlot $index))
         (tp-parameters:used? $index (cdr-atom $records)))))
(= (tp-parameters:all-used? $count $index $records)
   (if (== $index $count) True
     (and (tp-parameters:used? $index $records)
          (tp-parameters:all-used? $count (+ $index 1) $records))))
(= (tensor-program:parameter-region? $region)
   (case $region
     (((TP:ParameterRegion $family (Dag:Forest $roots $records) $rows)
       (if (and (tensor-program:family? $family)
             (and (tp-parameters:rows? $rows ())
                  (and (tensor-program:naturals? $roots) (== (size-atom $roots) 1))))
         (case (tp-parameters:types $family $rows () $records)
           (((TP:Some $types)
             (and (not (== (tensor-program:select-types $types $roots) TP:None))
                  (tp-parameters:all-used? (size-atom $rows) 0 $records))) ($invalid False))) False))
      ($invalid False))))
(= (tensor-program:prepare-parameters $family (Dag:Forest $roots $records) $domains)
   (case (tp-parameters:domains $domains ())
     (((TP:Some $rows)
       (case (tp-parameters:normalize $rows $records)
         (((TP:Some $template)
           (let $region (TP:ParameterRegion $family (Dag:Forest $roots $template) $rows)
             (if (tensor-program:parameter-region? $region) $region (TP:Fault ParameterTemplate))))
          ($invalid (TP:Fault ParameterTemplate))))) ($invalid $invalid))))
(= (tp-parameters:result-sort (TP:ParameterRegion $family (Dag:Forest $roots $records) $rows))
   (case (tp-parameters:types $family $rows () $records)
     (((TP:Some $types)
       (case (tensor-program:select-types $types $roots)
         (((TP:Some ($sort)) (TP:Some $sort)) ($invalid TP:None)))) ($invalid TP:None))))

(= (tp-parameters:indices $count $index)
   (if (== $index $count) ()
     (let $rest (tp-parameters:indices $count (+ $index 1)) (cons-atom $index $rest))))
(= (tp-parameters:choice-indices $rows)
   (if (== $rows ()) ()
     (case (car-atom $rows)
       (((TP:ParameterChoices $name $sort $choices)
         (let* (($first (tp-parameters:indices (size-atom $choices) 0))
                ($rest (tp-parameters:choice-indices (cdr-atom $rows)))) (cons-atom $first $rest)))))))
(= (tp-parameters:produce $domains)
   (let $assignment (ic-parameters:enumerate $domains)
     (IC:Proposal (TP:ParameterAssignment $assignment))))
(= (tp-parameters:select $rows $assignment)
   (if (== (get-metatype $assignment) Expression)
     (if (== $rows ()) (if (== $assignment ()) (TP:Some ()) TP:None)
       (if (== $assignment ()) TP:None
         (case (car-atom $rows)
           (((TP:ParameterChoices $name $sort $choices)
             (case ((tensor-program:at $choices (car-atom $assignment))
                    (tp-parameters:select (cdr-atom $rows) (cdr-atom $assignment)))
               ((((TP:Some $first) (TP:Some $rest))
                 (let $values (cons-atom $first $rest) (TP:Some $values))) ($invalid TP:None)))))))) TP:None))
(= (tp-parameters:instantiate-record $values $record)
   (case $record
     (((TP:ParameterSlot $index) (tensor-program:at $values $index))
      ($ordinary (TP:Some $ordinary)))))
(= (tp-parameters:instantiate $values $records)
   (if (== $records ()) (TP:Some ())
     (case ((tp-parameters:instantiate-record $values (car-atom $records))
            (tp-parameters:instantiate $values (cdr-atom $records)))
       ((((TP:Some $first) (TP:Some $rest))
         (let $result (cons-atom $first $rest) (TP:Some $result))) ($invalid TP:None)))))

(= (ic-search:observation (TP:ParameterModel $domain $region) $artifact)
   (case (ic-search:observation $domain $artifact)
     (((IC:Some $value) (IC:Some (TP:ParameterObservation $region $value))) ($invalid IC:None))))
(= (ic-search:consider (TP:ParameterModel $domain $region) $original $best $candidate)
   (ic-search:consider $domain $original $best $candidate))
(= (ic-search:materialize (TP:ParameterModel $domain $region) $original $proposal)
   (case ($region $proposal)
     ((((TP:ParameterRegion $family (Dag:Forest $roots $records) $rows) (TP:ParameterAssignment $assignment))
       (case (tp-parameters:select $rows $assignment)
         (((TP:Some $values)
           (case (tp-parameters:instantiate $values $records)
             (((TP:Some $concrete)
               (case (tensor-program:pack $family (Dag:Forest $roots $concrete))
                 (((TP:Artifact $bytes) (ic-numeric:program-candidate $domain $original $bytes))
                  ($invalid (IC:Refused ParameterProgram))))) ($invalid (IC:ProducerFault ParameterTemplate)))))
          ($invalid (IC:ProducerFault ParameterAssignment))))) ($invalid (IC:ProducerFault ParameterProposal)))))
(= (ic:prepare-fit Numeric:ParameterizedPrograms $original $region $sources)
   (if (tensor-program:parameter-region? $region)
     (case ($region (ic-program:task-class $original))
       ((((TP:ParameterRegion $family $forest $rows) (IC:TaskClass $domain $sort))
         (if (== (tp-parameters:result-sort $region) (TP:Some $sort))
          (let* (($dependencies (cons-atom (context-space) $sources))
                ($choices (tp-parameters:choice-indices $rows))
                ($handle (work-new (tp-parameters:produce $choices))))
           (case (ic:prepare (TP:ParameterModel $domain $region) $original $dependencies 64 ((IC:Branch 0 $handle)))
             (((IC:PreparedSearch $state) (IC:PreparedSearch $state))
              ($refusal (let $closed (work-cancel $handle) $refusal)))))
          (IC:FitRefused Task))) ($invalid (IC:FitRefused Task))))
     (IC:FitRefused ParameterRegion)))
(= (ic:fit Numeric:ParameterizedPrograms $original $region $sources $budget)
   (case (ic:prepare-fit Numeric:ParameterizedPrograms $original $region $sources)
     (((IC:PreparedSearch $state) (ic:resume $state $budget)) ($refusal $refusal))))
(= (ic:predict Numeric:ParameterizedPrograms $artifact $inputs)
   (ic:predict Numeric:Programs $artifact $inputs))
