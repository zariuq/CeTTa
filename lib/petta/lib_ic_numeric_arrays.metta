; NC2 observations: ordered typed inputs, arbitrary-rank targets, explicit
; masks and either numeric tolerance or exact nonfloating labels. All stored
; arrays have complete support. Dense conversion refuses holes; it never fills
; them. Model bytes are data, not evidence of fitting an external dataset.
!(import! &self (library lib_ic_parameters))
!(import! &self (library lib_tensor_program))
!(import! &self (library lib_ic_packed))
!(import! &self (library lib_ic_numeric_values))

(= (ic-arrays:kind $value)
   (if (tensor:is-tensor $value)
     (case (tensor:dtype $value)
       ((f64 (IC:Some "F64Tensor")) (bool (IC:Some "BoolTensor"))
        (i64 (IC:Some "I64Tensor")) ($other IC:None))) IC:None))
(= (ic-arrays:canonical $sort $value)
   (if (tensor-program:value? $sort $value)
     (let $dense (tensor:convert $value dense)
       (if (tensor-program:value? $sort $dense) (IC:Some (TP:Value $sort $dense)) IC:None)) IC:None))
(= (ic-arrays:encode $value)
   (case (ic-arrays:kind $value)
     (((IC:Some $sort)
       (case (ic-arrays:canonical $sort $value)
         (((IC:Some (TP:Value $actual $dense))
           (case (tensor-program:constant $sort $dense)
             (((Binary:Leaf $bytes) (IC:Some $bytes)) ($other IC:None)))) ($other IC:None))))
      ($other IC:None))))
(= (ic-arrays:decode $bytes)
   (case (binary-value:unpack $bytes)
     (((BinaryValue:Value (TP:Constant $sort $payload))
       (case (tensor-program:decode-constant $sort $payload)
         (((TP:Value $actual $value) (IC:Some (TP:Value $actual $value))) ($other IC:None))))
      ($other IC:None))))
(= (ic-arrays:encode-many $values)
   (if (== $values ()) (IC:Some ())
     (case ((ic-arrays:encode (car-atom $values)) (ic-arrays:encode-many (cdr-atom $values)))
       ((((IC:Some $first) (IC:Some $rest))
         (let $bytes (cons-atom $first $rest) (IC:Some $bytes))) ($other IC:None)))))
(= (ic-arrays:decode-many $values)
   (if (== (get-metatype $values) Expression)
     (if (== $values ()) (IC:Some ())
       (case ((ic-arrays:decode (car-atom $values)) (ic-arrays:decode-many (cdr-atom $values)))
         ((((IC:Some $first) (IC:Some $rest))
           (let $decoded (cons-atom $first $rest) (IC:Some $decoded))) ($other IC:None)))) IC:None))
(= (ic-arrays:raw-inputs $values)
   (map-atom $values $item (case $item (((TP:Value $sort $value) $value)))))
(= (ic-arrays:input-sorts $values)
   (map-atom $values $item (case $item (((TP:Value $sort $value) $sort)))))

(= (ic-arrays:encode-criterion $sort $criterion)
   (case $criterion
     ((Numeric:Exact
       (if (or (== $sort "BoolTensor") (== $sort "I64Tensor")) (IC:Some Numeric:Exact) IC:None))
      ((Numeric:Absolute $tolerance)
       (if (== $sort "F64Tensor")
         (let $precision (tensor:from-values f64 (1) ($tolerance))
           (if (ic-parameters:vector? f64 $precision)
             (let (tensor:present $number) (tensor:at $precision 0)
               (if (>= $number 0.0)
                 (case (ic-arrays:encode $precision)
                   (((IC:Some $bytes) (IC:Some (Numeric:Absolute $bytes))) ($other IC:None))) IC:None))
             IC:None)) IC:None))
      ($other IC:None))))
(= (ic-arrays:decode-criterion $sort $criterion)
   (case $criterion
     ((Numeric:Exact
       (if (or (== $sort "BoolTensor") (== $sort "I64Tensor")) (IC:Some Numeric:Exact) IC:None))
      ((Numeric:Absolute $bytes)
       (if (== $sort "F64Tensor")
         (case (ic-arrays:decode $bytes)
           (((IC:Some (TP:Value "F64Tensor" $precision))
             (if (== (tensor:shape $precision) (1))
               (let (tensor:present $number) (tensor:at $precision 0)
                 (if (>= $number 0.0) (IC:Some (Numeric:Absolute $precision)) IC:None)) IC:None))
            ($other IC:None))) IC:None))
      ($other IC:None))))
(= (ic-arrays:prepare $inputs $output $mask $criterion)
   (if (and (== (get-metatype $inputs) Expression)
            (and (tensor-program:value? "BoolTensor" $mask) (tensor:is-tensor $output)))
     (case (ic-arrays:kind $output)
       (((IC:Some $sort)
         (if (== (tensor:shape $output) (tensor:shape $mask))
           (case ((ic-arrays:encode-many $inputs) (ic-arrays:encode $output) (ic-arrays:encode $mask)
                  (ic-arrays:encode-criterion $sort $criterion))
             ((((IC:Some $stored-inputs) (IC:Some $stored-output) (IC:Some $stored-mask) (IC:Some $comparison))
               (case (binary-value:pack
                 (Numeric:ArrayArchive "NC2" $stored-inputs $sort $stored-mask $comparison (Numeric:Raw $stored-output)))
                 (((Binary:TreeBytes $bytes) (IC:NumericArtifact $bytes)) ($other (IC:NumericFault Codec)))))
              ($other (IC:NumericFault Observation)))) (IC:NumericFault Shape))) ($other (IC:NumericFault Output))))
     (IC:NumericFault Observation)))
(= (ic-arrays:body $inputs $body)
   (case $body
     (((Numeric:Raw $bytes) (ic-arrays:decode $bytes))
      ((Numeric:Program $bytes)
       (case (tensor-program:run $bytes (ic-arrays:raw-inputs $inputs))
         (((TP:Outputs ((TP:Value $sort $value))) (ic-arrays:canonical $sort $value)) ($other IC:None))))
      ($other IC:None))))
(= (ic-arrays:observe $bytes)
   (case (binary-value:unpack $bytes)
     (((BinaryValue:Value (Numeric:ArrayArchive "NC2" $stored-inputs $sort $stored-mask $comparison $body))
       (case ((ic-arrays:decode-many $stored-inputs) (ic-arrays:decode $stored-mask)
              (ic-arrays:decode-criterion $sort $comparison))
         ((((IC:Some $inputs) (IC:Some (TP:Value "BoolTensor" $mask)) (IC:Some $criterion))
           (case (ic-arrays:body $inputs $body)
             (((IC:Some (TP:Value $actual $output))
               (if (and (== $actual $sort) (== (tensor:shape $output) (tensor:shape $mask)))
                 (IC:Some (Numeric:ArrayValues $inputs $sort $mask $criterion $output)) IC:None)) ($other IC:None))))
          ($other IC:None)))) ($other IC:None))))
(= (ic-arrays:equal $mask $expected $actual) (if $mask (== $expected $actual) True))
(= (ic-arrays:compare $mask $criterion $expected $actual)
   (if (== $expected $actual) True
     (let* (($shape (tensor:shape $mask)) ($strides (map-atom $shape $dimension 0))
            ($all (tensor:view (tensor:from-values bool () (True)) $shape $strides 0)))
       (if (and (== $criterion Numeric:Exact) (== $mask $all)) False
         (let $decisions
           (case $criterion
             ((Numeric:Exact (tensor:zip-map bool ($mask $expected $actual) ic-arrays:equal ()))
              ((Numeric:Absolute $precision)
               (let (tensor:present $tolerance) (tensor:at $precision 0)
                 (tensor:zip-map bool ($mask $expected $actual) ic-numeric:near ($tolerance))))))
           (== $decisions $all))))))
(= (ic-packed:observe IC:ArrayArchive $bytes) (ic-arrays:observe $bytes))
(= (ic-packed:accepts? IC:ArrayArchive $source $candidate)
   (case ($source $candidate)
     ((((Numeric:ArrayValues $inputs $sort $mask $criterion $expected)
        (Numeric:ArrayValues $other-inputs $other-sort $other-mask $other-criterion $actual))
       (if (and (== $inputs $other-inputs)
             (and (== $sort $other-sort) (and (== $mask $other-mask) (== $criterion $other-criterion))))
         (ic-arrays:compare $mask $criterion $expected $actual) False)) ($other False))))
(= (ic-search:observation IC:ArrayArchive $bytes) (ic-arrays:observe $bytes))
(= (ic-search:consider IC:ArrayArchive $original $best $candidate)
   (case (ic-packed:check IC:ArrayArchive $original $best $candidate)
     (((IC:PackedAccepted $value $before $after) (IC:CandidateAccepted $value))
      ((IC:PackedRejected $reason) (IC:CandidateRejected $reason)))))
(= (ic-search:materialize IC:ArrayArchive $original $proposal)
   (case $proposal
     (((TP:Blueprint $family $forest)
       (case (tensor-program:pack $family $forest)
         (((TP:Artifact $program)
           (ic-numeric:program-candidate IC:ArrayArchive $original $program)) ($other (IC:Refused InvalidProgram)))))
      ($other (IC:ProducerFault Proposal)))))
(= (ic-arrays:new-inputs $values)
   (if (== (get-metatype $values) Expression)
     (if (== $values ()) (IC:Some ())
       (case (ic-arrays:kind (car-atom $values))
         (((IC:Some $sort)
           (case ((ic-arrays:canonical $sort (car-atom $values)) (ic-arrays:new-inputs (cdr-atom $values)))
             ((((IC:Some $first) (IC:Some $rest))
               (let $inputs (cons-atom $first $rest) (IC:Some $inputs))) ($other IC:None)))) ($other IC:None)))) IC:None))
(= (ic-arrays:predict $artifact $values)
   (case ((ic-arrays:observe $artifact) (ic-arrays:new-inputs $values))
     ((((IC:Some (Numeric:ArrayValues $old-inputs $sort $mask $criterion $old-output)) (IC:Some $inputs))
       (if (== (ic-arrays:input-sorts $old-inputs) (ic-arrays:input-sorts $inputs))
         (case (binary-value:unpack $artifact)
           (((BinaryValue:Value (Numeric:ArrayArchive "NC2" $stored $wanted $stored-mask $comparison (Numeric:Program $program)))
             (case (ic-arrays:body $inputs (Numeric:Program $program))
               (((IC:Some (TP:Value $actual $prediction))
                 (if (== $actual $wanted) (IC:Prediction $prediction) (IC:NumericFault Prediction)))
                ($other (IC:NumericFault Prediction))))) ($other (IC:NumericFault NoModel))))
         (IC:NumericFault Inputs))) ($other (IC:NumericFault NoModel)))))
