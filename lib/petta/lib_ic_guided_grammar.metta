; The existing finite ranked grammar, filtered during traversal by one or
; more guide forests. Hole positions, roles and sorts retain their meanings.
; Only structural data is inspected; archive materialization remains outside
; retained producers. Guide occurrences are not evidence deduplication.
!(import! &self (library lib_ic_grammar))

; One binding stores the ordered vector of values across the guides. Reusing
; it checks every guide at once, without copying one environment per guide.
(= (ic-guided:children $operator $sources)
   (if (== $sources ()) (IC:Some ())
     (case (car-atom $sources)
       (((IC:Node $actual $children)
         (if (== $operator $actual)
           (case (ic-guided:children $operator (cdr-atom $sources))
             (((IC:Some $rest) (IC:Some (cons-atom $children $rest))) ($different-tail IC:None))) IC:None))
        ($not-a-node IC:None)))))
(= (ic-guided:uncons $forests)
   (if (== $forests ()) (IC:Columns () ())
     (let $first (car-atom $forests)
       (if (== $first ()) IC:None
         (case (ic-guided:uncons (cdr-atom $forests))
           (((IC:Columns $heads $tails)
             (IC:Columns (cons-atom (car-atom $first) $heads) (cons-atom (cdr-atom $first) $tails)))
            ($empty-row IC:None)))))))

(= (ic-guided:term $signature $role $sort $depth (IC:HoleState $position $holes) $environment $sources)
   (if (< $position 9223372036854775807)
     (case (ic-template:assign $environment $role $position $sources)
       (((IC:Some $captures)
         (IC:GuidedExpansion (IC:Hole $role $position)
           (IC:HoleState (+ $position 1) (cons-atom (IC:Binding $role $position $sort) $holes)) $captures))
        ($inconsistent-fresh (superpose ())))) (IC:GrammarFault Capacity)))
(= (ic-guided:term $signature $role $sort $depth (IC:HoleState $position $holes) $environment $sources)
   (if (< $position 9223372036854775807)
     (case (ic-grammar:choose $holes)
       (((IC:Binding $old-role $index $old-sort)
         (if (and (== $role $old-role) (== $sort $old-sort))
           (case (ic-template:assign $environment $role $index $sources)
             (((IC:Some $captures)
               (IC:GuidedExpansion (IC:Hole $role $index) (IC:HoleState (+ $position 1) $holes) $captures))
              ($inconsistent-reuse (superpose ())))) (superpose ()))))) (superpose ())))
(= (ic-guided:term $signature $role $sort $depth $state $environment $sources)
   (if (and (> $depth 0) (not (== $sources ())))
     (case (car-atom $sources)
       (((IC:Node $index $children)
         (case (ic-template:operator $signature $index)
           (((IC:Some (IC:Operator $actual $slots))
             (if (== $sort $actual)
               (case (ic-guided:children $index $sources)
                 (((IC:Some $forests)
                   (case (ic-guided:many $signature $slots (- $depth 1) $state $environment $forests)
                     (((IC:GuidedExpansion $patterns $next $captures)
                       (IC:GuidedExpansion (IC:Node $index $patterns) $next $captures))
                      ((IC:GrammarFault $reason) (IC:GrammarFault $reason)))))
                  ($different-operator (superpose ())))) (superpose ())))
            ($missing-operator (superpose ()))))) ($malformed-source (superpose ()))) ) (superpose ())))
(= (ic-guided:many $signature $slots $depth $state $environment $forests)
   (if (== $slots ())
     (if (ic-guided:empty-forests? $forests)
       (IC:GuidedExpansion () $state $environment) (superpose ()))
     (case (ic-guided:uncons $forests)
       (((IC:Columns $heads $tails)
         (case (car-atom $slots)
           (((IC:Slot $role $sort)
             (case (ic-guided:term $signature $role $sort $depth $state $environment $heads)
               (((IC:GuidedExpansion $pattern $middle $captures)
                 (case (ic-guided:many $signature (cdr-atom $slots) $depth $middle $captures $tails)
                   (((IC:GuidedExpansion $patterns $next $finished)
                     (IC:GuidedExpansion (cons-atom $pattern $patterns) $next $finished))
                    ((IC:GrammarFault $tail-reason) (IC:GrammarFault $tail-reason)))))
                ((IC:GrammarFault $head-reason) (IC:GrammarFault $head-reason))))))))
        ($missing-column (superpose ()))))))
(= (ic-guided:empty-forests? $forests)
   (if (== $forests ()) True
     (and (== (car-atom $forests) ()) (ic-guided:empty-forests? (cdr-atom $forests)))))
(= (ic-guided:admitted? $signature $slots $sources $depth)
   (and (ic-template:signature? $signature)
     (and (ic-template:slots? $slots)
       (and (binary:unsigned? $depth)
         (if (== (get-metatype $sources) Expression)
           (and (not (== $sources ()))
             (foldl-atom $sources True $valid $forest
               (and $valid (ic-template:sources? $signature $slots $forest)))) False)))))
(= (ic-grammar:guided $signature $slots $sources $depth)
   (if (ic-guided:admitted? $signature $slots $sources $depth)
     (case (ic-guided:many $signature $slots $depth (IC:HoleState 0 ()) () $sources)
       (((IC:GuidedExpansion $patterns $state $captures) (IC:Template $patterns))
        ((IC:GrammarFault $reason) (IC:GrammarFault $reason)))) (IC:GrammarFault InvalidGuides)))
