; Portable collection copies over captured byte cursors and the ordinary
; atomic publisher. Exported payloads stay encoded data, including open atoms.
; Exact identity-preserving disaster recovery uses store:backup instead.
!(import! &self "durable_space.metta")

(: transfer:hash (-> Atom %Undefined%))
(= (transfer:hash $value)
  (case (store:encode $value)
    (((StoreEncoded $bytes) (SpaceTransferHashV1 (str:sha256 $bytes))) ($failure $failure))))
(: transfer:specs (-> Atom %Undefined%))
(= (transfer:specs $indexes)
  (if (== $indexes ()) ()
    (let* (($first (car-atom $indexes))
           ((SpaceIndexSpecV1 $spec) (durable-index:spec-of $first))
           ($rest (cdr-atom $indexes))
           ($tail (transfer:specs $rest))) (cons-atom $spec $tail))))
(: transfer:budget? (-> Atom Bool))
(= (transfer:budget? $n)
  (if (durable-index:integer? $n) (and (>= $n 64) (<= $n 131072)) False))
(: transfer:identifier? (-> Atom Bool))
(= (transfer:identifier? $value)
  (case (knowledge:address "" $value)
    (((KnowledgeAddressV1 $key) True) ($failure False))))
(: transfer:text-size? (-> Atom Number Bool))
(= (transfer:text-size? $text $length)
  (if (== (get-type $text) String) (== (str:byte-length $text) $length) False))
(: transfer:header? (-> Atom Bool))
(= (transfer:header? $header)
  (if (knowledge:tagged? $header SpaceExportHeaderV1 6)
    (let (SpaceExportHeaderV1 $epoch $revision $collection $count $specs) $header
      (if (and (transfer:text-size? $epoch 32) (knowledge:ground-identity? $header))
        (if (and (durable-index:integer? $revision) (durable-index:integer? $count))
          (if (and (>= $revision 0) (>= $count 0))
            (case (durable-index:descriptors $collection $specs)
              (((SpaceIndexesV1 $indexes) True) ($failure False))) False) False) False)) False))

(: durable-space:export-open (-> %Undefined% Atom Atom %Undefined%))
(= (durable-space:export-open $view $collection $maximum)
  (if (and (transfer:budget? $maximum) (transfer:identifier? $collection))
    (let* (((KnowledgeAddressV1 $metadata) (durable-space:metadata $collection))
           ((KnowledgeAddressV1 $prefix) (durable-space:prefix $collection)))
      (case (durable-space:state $view $collection $metadata $prefix)
        (((SpaceStateV1 $count $indexes)
          (let* (((StoreViewInfo $epoch $revision) (store:view-info $view))
                 ($specs (transfer:specs $indexes))
                 ($header (SpaceExportHeaderV1 $epoch $revision $collection $count $specs)))
            (case (store:encode $header)
              (((StoreEncoded $bytes)
                (if (<= (str:byte-length $bytes) $maximum)
                  (let $digest (str:sha256 $bytes)
                    (transfer:export-start $view $header $prefix $maximum $digest))
                  (SpaceRefusedV1 transfer-frame-limit)))
               ($failure $failure)))))
         ($failure $failure)))) (SpaceRefusedV1 transfer-frame-limit)))
(: transfer:export-start (-> Atom Atom Atom Atom Atom %Undefined%))
(= (transfer:export-start $view $header $prefix $maximum $digest)
  (case (store:view-clone $view)
    (((StoreSnapshot $copy $epoch $revision)
      (case (store:scan-open $copy $prefix NoBound)
        (((StoreScan $scan)
          (SpaceExportOpenedV1 (SpaceExportStateV1 $copy $scan $header $prefix 0 0 $digest $maximum) $header))
         ($failure (let $_ (store:close $copy) $failure)))))
     ($failure $failure))))
(: durable-space:export-close (-> Atom %Undefined%))
(= (durable-space:export-close $state)
  (if (knowledge:tagged? $state SpaceExportStateV1 9)
    (let (SpaceExportStateV1 $view $scan $h $p $n $position $digest $max) $state
      (let* (($_ (store:close $scan)) ($_ (store:close $view))) SpaceExportClosedV1))
    (SpaceRefusedV1 export-state)))
(: transfer:export-fail (-> Atom Atom %Undefined%))
(= (transfer:export-fail $state $failure)
  (let $_ (durable-space:export-close $state) $failure))
(: transfer:export-end (-> Atom %Undefined%))
(= (transfer:export-end $state)
  (let* (((SpaceExportStateV1 $v $scan $header $p $rows $position $digest $max) $state)
         ((SpaceExportHeaderV1 $e $r $c $count $specs) $header)
         ($_ (durable-space:export-close $state)))
    (if (== $rows $count) (SpaceExportCompleteV1 (SpaceExportEndV1 $rows $digest))
      (SpaceRefusedV1 export-count))))
(: durable-space:export-next (-> Atom %Undefined%))
(= (durable-space:export-next $state)
  (if (knowledge:tagged? $state SpaceExportStateV1 9)
    (let (SpaceExportStateV1 $view $scan $header $prefix $rows $position $digest $maximum) $state
      (case (store:scan-next $scan $position)
        ((StoreEnd (transfer:export-end $state))
         ((StoreKey $key $length $next)
          (if (str:starts-with $key $prefix)
            (transfer:export-row $state $key $next)
            (transfer:export-end $state)))
         ($failure (transfer:export-fail $state $failure)))))
    (SpaceRefusedV1 export-state)))
(: transfer:export-row (-> Atom Atom Atom %Undefined%))
(= (transfer:export-row $state $key $next)
  (let (SpaceExportStateV1 $view $scan $header $prefix $rows $position $digest $maximum) $state
    (case (store:get $view $key $maximum)
      (((StoreValue $body)
        (let* (((SpaceExportHeaderV1 $epoch $r $c $count $specs) $header)
               ($row (SpaceExportRowV1 $rows (StoreOccurrenceV1 $epoch $key) $body)))
          (case (store:encode $row)
            (((StoreEncoded $bytes)
              (if (<= (str:byte-length $bytes) $maximum)
                (case (transfer:hash (SpaceExportLinkV1 $digest $row))
                  (((SpaceTransferHashV1 $hash)
                    (let $following (+ $rows 1)
                      (SpaceExportMoreV1 (SpaceExportStateV1 $view $scan $header $prefix $following $next $hash $maximum) $row)))
                   ($failure (transfer:export-fail $state $failure))))
                (transfer:export-fail $state (SpaceRefusedV1 transfer-frame-limit))))
             ($failure (transfer:export-fail $state $failure))))))
       ($failure (transfer:export-fail $state $failure))))))

; A logical copy gives destination memberships fresh identities. Original
; references INSIDE payloads remain original references; never rewrite terms
; implicitly. A durable origin map provides explicit reference translation.
(: transfer:map-prefix (-> Atom Atom %Undefined%))
(= (transfer:map-prefix $collection $request)
  (case (knowledge:address "space/import/map/v1/" (SpaceImportMapV1 $collection $request))
    (((KnowledgeAddressV1 $key) (KnowledgeAddressV1 (str:concat $key "/"))) ($failure $failure))))
(: durable-space:import-origin (-> %Undefined% Atom Atom Atom %Undefined%))
(= (durable-space:import-origin $view $collection $request $origin)
  (if (and (transfer:identifier? $collection) (and (transfer:identifier? $request) (transfer:identifier? $origin)))
  (let* (((KnowledgeAddressV1 $prefix) (transfer:map-prefix $collection $request))
         ((KnowledgeAddressV1 $key) (knowledge:address $prefix $origin)))
    (case (store:get $view $key (durable-space:wire-limit))
      (((StoreValue $body)
        (case (store:decode $body)
          (((StoreDecoded $record)
            (if (knowledge:tagged? $record SpaceImportMappingV1 3)
              (let (SpaceImportMappingV1 $stored $destination) $record
                (let* (((StoreViewInfo $epoch $revision) (store:view-info $view))
                       ((KnowledgeAddressV1 $rows) (durable-space:prefix $collection)))
                  (if (== $stored $origin)
                    (case (durable-space:reference-key $destination $epoch $rows)
                      (((KnowledgeAddressV1 $same) (StoreDecoded $record))
                       ($failure (SpaceRefusedV1 import-map-format))))
                    (SpaceRefusedV1 import-map-format))))
              (SpaceRefusedV1 import-map-format)))
           ($failure $failure))))
       (StoreAbsent SpaceImportOriginAbsentV1) ($failure $failure))))
    (SpaceRefusedV1 import-identity)))

(: durable-space:import-open (-> %Undefined% %Undefined% Atom Atom Atom Atom Atom %Undefined%))
(= (durable-space:import-open $owner $view $collection $request $header $expected $maximum)
  (let $command (SpaceImportV1 $collection $header $expected)
    (case (knowledge:receipt $view $request $command (durable-space:wire-limit))
      ((KnowledgeReceiptAbsentV1
        (if (and (transfer:header? $header) (and (transfer:text-size? $expected 64) (transfer:identifier? $collection)))
          (transfer:import-target $owner $view $collection $request $header $expected $maximum)
          (SpaceRefusedV1 import-header)))
       ($prior (knowledge:replay-on $owner $view $prior))))))
(: transfer:import-target (-> Atom Atom Atom Atom Atom Atom Atom %Undefined%))
(= (transfer:import-target $owner $view $collection $request $header $expected $maximum)
  (let* (((SpaceExportHeaderV1 $e $r $source $count $specs) $header)
         ((KnowledgeAddressV1 $metadata) (durable-space:metadata $collection))
         ((KnowledgeAddressV1 $prefix) (durable-space:prefix $collection))
         ((KnowledgeAddressV1 $mapping) (transfer:map-prefix $collection $request)))
    (case (durable-space:exists $view $metadata)
      (((SpaceExistsV1 False)
        (case (durable-index:descriptors $collection $specs)
          (((SpaceIndexesV1 $indexes)
            (case (durable-space:empty-prefix? $view $prefix)
              ((True
                (case (durable-space:index-prefixes-empty? $view $indexes)
                  ((True
                    (case (durable-space:empty-prefix? $view $mapping)
                      ((True (transfer:import-start $owner $view $collection $request $header $expected $indexes $metadata $prefix $mapping $maximum))
                       (False (SpaceRefusedV1 orphaned-import-map)) ($failure $failure))))
                   (False (SpaceRefusedV1 orphaned-index-postings)) ($failure $failure))))
               (False (SpaceRefusedV1 orphaned-occurrences)) ($failure $failure))))
           ($failure $failure))))
       ((SpaceExistsV1 True) (SpaceRefusedV1 collection-exists)) ($failure $failure)))))
(: transfer:import-start (-> Atom Atom Atom Atom Atom Atom Atom Atom Atom Atom Atom %Undefined%))
(= (transfer:import-start $owner $view $c $request $header $expected $indexes $metadata $prefix $mapping $maximum)
  (case (store:view-clone $view)
    (((StoreSnapshot $copy $epoch $revision)
      (case (store:batch-open $owner $copy $maximum)
        (((StoreBatch $batch)
          (case (transfer:hash $header)
            (((SpaceTransferHashV1 $digest)
              (SpaceImportOpenedV1 (SpaceImportStateV1 $copy $c $request $header $expected $indexes $metadata $prefix $mapping 0 NoPreviousV1 $digest $batch 0)))
             ($failure (let* (($_ (store:close $batch)) ($_ (store:close $copy))) $failure)))))
         ($failure (let $_ (store:close $copy) $failure))))) ($failure $failure))))
(: durable-space:import-close (-> Atom %Undefined%))
(= (durable-space:import-close $state)
  (if (knowledge:tagged? $state SpaceImportStateV1 15)
    (let (SpaceImportStateV1 $v $c $r $h $expected $i $m $p $map $seq $last $hash $batch $staged) $state
      (let* (($_ (store:close $batch)) ($_ (store:close $v))) SpaceImportClosedV1))
    (SpaceRefusedV1 import-state)))
(: transfer:import-fail (-> Atom Atom %Undefined%))
(= (transfer:import-fail $state $failure)
  (let $_ (durable-space:import-close $state) $failure))
(: durable-space:import-progress (-> Atom %Undefined%))
(= (durable-space:import-progress $state)
  (if (knowledge:tagged? $state SpaceImportStateV1 15)
  (let (SpaceImportStateV1 $v $c $r $h $expected $i $m $p $map $seq $last $hash $batch $staged) $state
    (case (store:batch-info $batch)
      (((StoreBatchInfo $bytes $maximum $operations) (SpaceImportProgressV1 $seq $bytes $maximum $operations)) ($failure $failure))))
    (SpaceRefusedV1 import-state)))
; Refuse an old embedded state after its shared spool has advanced. A copied
; state must not publish operations omitted from its own count/hash history.
(: transfer:current? (-> Atom Bool))
(= (transfer:current? $state)
  (let (SpaceImportStateV1 $v $c $r $h $expected $i $m $p $map $seq $last $hash $batch $staged) $state
    (case (store:batch-info $batch)
      (((StoreBatchInfo $bytes $maximum $actual) (== $actual $staged)) ($failure False)))))
(: transfer:row? (-> Atom Atom Atom Atom Bool))
(= (transfer:row? $header $sequence $last $row)
  (if (knowledge:tagged? $row SpaceExportRowV1 4)
    (let* (((SpaceExportRowV1 $n $reference $body) $row)
           ((SpaceExportHeaderV1 $epoch $r $collection $count $specs) $header))
      (if (and (knowledge:ground-identity? $reference) (and (durable-index:integer? $n) (== (get-type $body) String)))
        (if (and (== $n $sequence) (< $n $count))
          (let (KnowledgeAddressV1 $prefix) (durable-space:prefix $collection)
            (case (durable-space:reference-key $reference $epoch $prefix)
              (((KnowledgeAddressV1 $key)
                (if (== $last NoPreviousV1) True (> (str:compare $key $last) 0)))
               ($failure False)))) False) False)) False))
(: durable-space:import-row (-> Atom Atom %Undefined%))
(= (durable-space:import-row $state $row)
  (if (knowledge:tagged? $state SpaceImportStateV1 15)
    (let (SpaceImportStateV1 $v $c $r $header $expected $i $m $p $map $seq $last $hash $batch $staged) $state
      (if (and (transfer:current? $state) (transfer:row? $header $seq $last $row))
        (case (store:encode $row)
          (((StoreEncoded $wire)
            (if (<= (str:byte-length $wire) 131072)
              (transfer:stage-row $state $row)
              (transfer:import-fail $state (SpaceRefusedV1 transfer-frame-limit))))
           ($failure (transfer:import-fail $state $failure))))
        (transfer:import-fail $state (SpaceRefusedV1 import-row))))
    (SpaceRefusedV1 import-state)))
(: transfer:stage-row (-> Atom Atom %Undefined%))
(= (transfer:stage-row $state $row)
  (let* (((SpaceImportStateV1 $view $c $request $header $expected $indexes $metadata $prefix $mapping $sequence $last $digest $batch $staged) $state)
         ((SpaceExportRowV1 $seq $origin $body) $row))
    (case (store:decode $body)
      (((StoreDecoded $atom)
        (case (store:encode $atom)
          (((StoreEncoded $canonical)
            (if (== $body $canonical)
              (let* (((KnowledgeAddressV1 $key) (knowledge:address $prefix (SpaceOccurrenceKeyV1 $request $seq)))
                     ((StoreViewInfo $epoch $revision) (store:view-info $view))
                     ($reference (StoreOccurrenceV1 $epoch $key)))
                (case (durable-index:postings $indexes $key $atom)
                  (((SpaceIndexPostingsV1 $postings)
                    (let* (((KnowledgeAddressV1 $map-key) (knowledge:address $mapping $origin))
                           ((StoreEncoded $map-body) (store:encode (SpaceImportMappingV1 $origin $reference)))
                           ($operations (cons-atom ops (cons-atom (put $key $body) (cons-atom (put $map-key $map-body) (map-atom $postings $posting (put $posting "")))))))
                      (case (store:batch-add $batch $operations)
                        ((StoreBatchStaged
                          (case (transfer:hash (SpaceExportLinkV1 $digest $row))
                            (((SpaceTransferHashV1 $hash)
                              (let* (((StoreOccurrenceV1 $oe $ok) $origin) ($next (+ $sequence 1))
                                     ($staged-next (+ $staged (- (size-atom $operations) 1))))
                                (SpaceImportMoreV1 (SpaceImportStateV1 $view $c $request $header $expected $indexes $metadata $prefix $mapping $next $ok $hash $batch $staged-next)
                                  (SpaceImportMappingV1 $origin $reference))))
                             ($failure (transfer:import-fail $state $failure)))))
                         ($failure (transfer:import-fail $state $failure))))))
                   ($failure (transfer:import-fail $state $failure)))))
              (transfer:import-fail $state (SpaceRefusedV1 noncanonical-import-atom))))
           ($failure (transfer:import-fail $state $failure)))))
       ($failure (transfer:import-fail $state $failure))))))
(: durable-space:import-finish (-> %Undefined% Atom Atom %Undefined%))
(= (durable-space:import-finish $owner $state $footer)
  (if (knowledge:tagged? $state SpaceImportStateV1 15)
    (let* (((SpaceImportStateV1 $view $c $request $header $expected $indexes $metadata $prefix $map $rows $last $digest $batch $staged) $state)
           ((SpaceExportHeaderV1 $e $r $source $count $specs) $header))
      (if (and (and (transfer:current? $state) (knowledge:ground-identity? $footer))
               (and (== $footer (SpaceExportEndV1 $rows $digest)) (and (== $rows $count) (== $digest $expected))))
        (transfer:publish $owner $state)
        (transfer:import-fail $state (SpaceRefusedV1 import-incomplete-or-digest))))
    (SpaceRefusedV1 import-state)))
(: transfer:publish (-> Atom Atom %Undefined%))
(= (transfer:publish $owner $state)
  (let* (((SpaceImportStateV1 $view $c $request $header $expected $indexes $metadata $prefix $map $rows $last $digest $batch $staged) $state)
         ($record (durable-space:descriptor $prefix $rows $indexes)))
    (case (store:encode $record)
      (((StoreEncoded $body)
        (let* (((KnowledgeAddressV1 $receipt-key) (knowledge:receipt-address $request))
               ($command (SpaceImportV1 $c $header $expected))
               ($answer (SpaceImportedV1 $c $rows $header $expected))
               ((StoreEncoded $receipt) (store:encode (KnowledgeReceiptV1 $request $command $answer))))
          (case (store:batch-add $batch (ops (put $metadata $body) (put $receipt-key $receipt)))
            ((StoreBatchStaged
              (case (store:commit-batch $owner $view $batch)
                (((StoreSnapshot $after $epoch $revision)
                  (let* (($_ (store:close $after)) ($_ (durable-space:import-close $state)))
                    (KnowledgeCommittedV1 $answer $epoch $revision)))
                 ($failure (transfer:import-fail $state $failure)))))
             ($failure (transfer:import-fail $state $failure))))))
       ($failure (transfer:import-fail $state $failure))))))
