; Source-backed MIL models for declared finite example observations. MP1 pays
; for queries, negative constraints, the complete SB1 dictionary and the program.
; Raw labels remain a literal data baseline, not a claimed predictive model.
; Fitting admits the closed effect-free source family, not arbitrary callbacks.
!(import! &self (library lib_ic_mil_source))
!(import! &self (library lib_portable_value))

(= (mil-program:examples $rows)
   (if (== (binary:portable-kind $rows) Expression)
     (if (== $rows ()) (MIL.ExampleColumns () ())
       (case ((car-atom $rows) (mil-program:examples (cdr-atom $rows)))
         ((((MIL.Ex $input $output) (MIL.ExampleColumns $inputs $outputs))
           (MIL.ExampleColumns (cons-atom $input $inputs) (cons-atom $output $outputs)))
          ($invalid (MIL.ProgramRefused Examples))))) (MIL.ProgramRefused Examples)))
(= (mil-program:mode? $mode) (or (== $mode MIL.Functional) (== $mode MIL.Relational)))
(= (mil-program:pack $header $body)
   (case (portable-value:pack (MIL.SourceTaskArchive "MP1" $header $body))
     (((Binary:TreeBytes $bytes) (IC:SourceArtifact $bytes))
      ($invalid (MIL.ProgramRefused Codec)))))
(= (ic:prepare-examples Source:MIL $type (MIL.Examples $positive $negative $mode))
   (if (mil-program:mode? $mode)
     (case ((mil-program:examples $positive) (mil-program:examples $negative) (binary-value:pack $type))
       ((((MIL.ExampleColumns $inputs $outputs) (MIL.ExampleColumns $negative-inputs $forbidden)
           (Binary:TreeBytes $type-bytes))
         (case ((portable-value:pack (MIL.SourceQueries $type $mode $inputs $negative))
                (portable-value:pack $outputs))
           ((((Binary:TreeBytes $header) (Binary:TreeBytes $labels))
             (mil-program:pack $header (MIL.SourceLiteral $labels)))
            ($invalid (MIL.ProgramRefused Values)))))
        ($invalid (MIL.ProgramRefused Examples)))) (MIL.ProgramRefused Mode)))
(= (mil-program:queries $header)
   (case (portable-value:unpack $header)
     (((BinaryValue:Value (MIL.SourceQueries (MIL.Rel $input $output) $mode $inputs $negative))
       (if (and (mil-program:mode? $mode) (== (binary:portable-kind $inputs) Expression))
         (case (mil-program:examples $negative)
           (((MIL.ExampleColumns $negative-inputs $forbidden)
             (MIL.Queries (MIL.Rel $input $output) $mode $inputs $negative-inputs $forbidden))
            ($invalid (MIL.ProgramRefused Header)))) (MIL.ProgramRefused Header)))
      ($invalid (MIL.ProgramRefused Header)))))
(= (mil-program:unpack $artifact)
   (case (portable-value:unpack $artifact)
     (((BinaryValue:Value (MIL.SourceTaskArchive "MP1" $header $body))
       (case (mil-program:queries $header)
         (((MIL.Queries $type $mode $inputs $negative-inputs $forbidden)
           (MIL.Task $header $type $mode $inputs $negative-inputs $forbidden $body))
          ($invalid $invalid))))
      ($invalid (MIL.ProgramRefused Artifact)))))

; The constructor check excludes native heads; these remaining source heads
; are either the fixed standard operators or equation-free declared data.
; Removing println! follows actual source roles, including quoted data.
(= (mil-program:safe? $family $document)
   (case ($family $document)
     ((((MIL.SourceFamily $constructors $bindings) (Syntax:Document $v $reader $forms))
       (case (mil-source:helper-rows $forms)
         (((MIL.SourceRows $helpers)
           (let* (($base (filter-atom (mil-source:operations) $row (not (== (car-atom $row) "println!"))))
                  ($data (mil-source:constructor-rows $constructors))
                  ($operations (union-atom $base (union-atom $data $helpers))))
             (foldl-atom $forms True $valid $form
               (and $valid (case (source-library:parse-clause $form)
                 (((IC:Some (Library:Clause $names $head $left $body $arity))
                   (mil-source:term? $operations $data $arity $body)) ($invalid False)))))))
          ($invalid False)))) ($invalid False))))
(= (mil-program:background $background)
   (case (ic:prepare-background Source:MIL $background ())
     (((MIL.SourcePrepared $family $document $types $semantics)
       (if (mil-program:safe? $family $document)
         (MIL.ProgramBackground $types $semantics) (MIL.ProgramRefused Effects)))
      ($invalid (MIL.ProgramRefused Background)))))

; Closed finite-composition grammar. Unbounded closure is not silently run by
; this task decoder; its existing authored MIL interface remains available.
(= (mil-program:shape $program)
   (case $program
     (((MIL.SourceRef $index)
       (if (binary:unsigned? $index) (MIL.ProgramShape (MIL.PrimitiveTerm $program)) MIL.BadShape))
      ((MIL.Id $inner)
       (case (mil-program:shape $inner)
         (((MIL.ProgramShape $term) (MIL.ProgramShape (MIL.Id $term))) ($invalid MIL.BadShape))))
      ((MIL.Chain $left $right) (mil-program:shape-pair Chain $left $right))
      ((MIL.Choice $left $right) (mil-program:shape-pair Choice $left $right))
      ((MIL.Map $inner)
       (case (mil-program:shape $inner)
         (((MIL.ProgramShape $term) (MIL.ProgramShape (MIL.Map $term))) ($invalid MIL.BadShape))))
      ((MIL.HO1 MIL.MapOp $inner)
       (case (mil-program:shape $inner)
         (((MIL.ProgramShape $term) (MIL.ProgramShape (MIL.HO1 MIL.MapOp $term))) ($invalid MIL.BadShape))))
      ($invalid MIL.BadShape))))
(= (mil-program:shape-pair $kind $left $right)
   (case ((mil-program:shape $left) (mil-program:shape $right))
     ((((MIL.ProgramShape $first) (MIL.ProgramShape $second))
       (MIL.ProgramShape (if (== $kind Chain) (MIL.Chain $first $second) (MIL.Choice $first $second))))
      ($invalid MIL.BadShape))))
(= (mil-program:skeleton? $term)
   (case $term
     (((MIL.Hole $name)
       (case (binary:value-kind $name) ((Symbol True) (Natural True) (Text True) ($invalid False))))
      ((MIL.PrimitiveTerm $program)
       (case (mil-program:shape $program) (((MIL.ProgramShape $closed) True) ($invalid False))))
      ((MIL.Id $inner) (mil-program:skeleton? $inner))
      ((MIL.Chain $first $second) (and (mil-program:skeleton? $first) (mil-program:skeleton? $second)))
      ((MIL.Choice $first $second) (and (mil-program:skeleton? $first) (mil-program:skeleton? $second)))
      ((MIL.Map $inner) (mil-program:skeleton? $inner))
      ((MIL.HO1 MIL.MapOp $inner) (mil-program:skeleton? $inner))
      ($invalid False))))
(= (mil-program:skeletons? $skeletons)
   (if (== (binary:value-kind $skeletons) Expression)
     (foldl-atom $skeletons True $valid $term (and $valid (mil-program:skeleton? $term))) False))
(= (mil-program:typed? $types $program $type)
   (case (mil-program:shape $program)
     (((MIL.ProgramShape $skeleton)
       (not (== (collapse (mil:prime:typed-fill-vocabulary $types $skeleton $type)) ())))
      ($invalid False))))
(= (mil-program:current? $semantics)
   (case $semantics
     (((MIL.SourceRuntime $guards $callables) (ic-search:guards-current? $guards)) ($invalid False))))
(= (mil-program:run-rows $semantics $program $inputs)
   (if (mil-program:current? $semantics)
    (if (== $inputs ()) (IC:Some ())
     (case (catch (MIL.ProgramOutputs (mil:outputs $semantics $program (car-atom $inputs))))
       (((MIL.ProgramOutputs $outputs)
         (case (portable-value:pack $outputs)
           (((Binary:TreeBytes $closed)
             (case (mil-program:run-rows $semantics $program (cdr-atom $inputs))
               (((IC:Some $later) (IC:Some (cons-atom $outputs $later))) ($invalid IC:None))))
            ($invalid IC:None)))) ($raised IC:None)))) IC:None))
(= (mil-program:observe-body $header $type $inputs $negative-inputs $body)
   (case $body
     (((MIL.SourceLiteral $labels)
       (case (portable-value:unpack $labels)
         (((BinaryValue:Value $outputs)
           (if (and (== (binary:portable-kind $outputs) Expression) (== (size-atom $outputs) (size-atom $inputs)))
             (IC:Some (MIL.RawObservation $header $labels $outputs)) IC:None))
          ($invalid IC:None))))
      ((MIL.SourceProgram $background $program)
       (case (mil-program:background $background)
         (((MIL.ProgramBackground $types $semantics)
           (if (mil-program:typed? $types $program $type)
             (case ((mil-program:run-rows $semantics $program $inputs)
                    (mil-program:run-rows $semantics $program $negative-inputs))
               ((((IC:Some $positive) (IC:Some $negative))
                 (IC:Some (MIL.ProgramObservation $header $positive $negative))) ($invalid IC:None))) IC:None))
          ($invalid IC:None)))) ($invalid IC:None))))
(= (mil-program:observe $artifact)
   (case (mil-program:unpack $artifact)
     (((MIL.Task $header $type $mode $inputs $negative-inputs $forbidden $body)
       (mil-program:observe-body $header $type $inputs $negative-inputs $body)) ($invalid IC:None))))
(= (mil-program:positives? $mode $labels $answers)
   (if (== $labels ()) (== $answers ())
     (if (== $answers ()) False
       (and (if (== $mode MIL.Functional)
               (and (not (== (car-atom $answers) ()))
                    (mil:list-all-equal (car-atom $labels) (car-atom $answers)))
               (mil:list-member (car-atom $labels) (car-atom $answers)))
            (mil-program:positives? $mode (cdr-atom $labels) (cdr-atom $answers))))))
(= (mil-program:negatives? $forbidden $answers)
   (if (== $forbidden ()) (== $answers ())
     (if (== $answers ()) False
       (and (not (mil:list-member (car-atom $forbidden) (car-atom $answers)))
         (mil-program:negatives? (cdr-atom $forbidden) (cdr-atom $answers))))))
(= (mil-program:accepts? $source $candidate)
   (case ($source $candidate)
     ((((MIL.RawObservation $header $labels $outputs) (MIL.RawObservation $actual $other $values))
       (and (== $header $actual) (== $labels $other)))
      (((MIL.RawObservation $header $labels $outputs) (MIL.ProgramObservation $actual $positive $negative))
       (if (== $header $actual)
         (case (mil-program:queries $header)
           (((MIL.Queries $type $mode $inputs $negative-inputs $forbidden)
             (and (mil-program:positives? $mode $outputs $positive) (mil-program:negatives? $forbidden $negative)))
            ($invalid False))) False))
      ($invalid False))))

(= (ic-packed:observe IC:SourceExamples $artifact) (mil-program:observe $artifact))
(= (ic-packed:accepts? IC:SourceExamples $source $candidate) (mil-program:accepts? $source $candidate))
(= (ic:verify Source:MIL $original $candidate)
   (case (ic-packed:check IC:SourceExamples $original $original $candidate)
     (((IC:PackedAccepted $bytes $before $after) (IC:SourceVerified $bytes $before $after))
      ((IC:PackedRejected $reason) (IC:SourceRejected $reason)))))
(= (mil-program:proposal $original $background $program)
   (case (mil-program:unpack $original)
     (((MIL.Task $header $type $mode $inputs $negative-inputs $forbidden (MIL.SourceLiteral $labels))
       (case (mil-program:pack $header (MIL.SourceProgram $background $program))
         (((IC:SourceArtifact $bytes) (IC:Candidate $bytes)) ($invalid (IC:ProducerFault Codec)))))
      ($invalid (IC:ProducerFault Task)))))
(= (mil-program:produce $types $skeletons $type)
   (if (== $skeletons ()) (superpose ())
     (let $program (mil:prime:typed-fill-vocabulary $types (car-atom $skeletons) $type)
       (IC:Proposal (MIL.ProgramProposal $program)))))
(= (mil-program:produce $types $skeletons $type)
   (if (== $skeletons ()) (superpose ()) (mil-program:produce $types (cdr-atom $skeletons) $type)))
(= (mil-program:in-family? $background $artifact)
   (case (mil-program:unpack $artifact)
     (((MIL.Task $header $type $mode $inputs $negative-inputs $forbidden (MIL.SourceLiteral $labels)) True)
      ((MIL.Task $header $type $mode $inputs $negative-inputs $forbidden (MIL.SourceProgram $actual $program))
       (== $actual $background)) ($invalid False))))
(= (ic-search:observation (MIL.SourceModel $background $skeletons) $artifact)
   (if (and (mil-program:skeletons? $skeletons) (mil-program:in-family? $background $artifact))
     (case ((mil-program:background $background) (mil-program:observe $artifact))
       ((((MIL.ProgramBackground $types $semantics) (IC:Some $observation))
         (IC:Some (MIL.SearchObservation $background $skeletons $observation))) ($invalid IC:None))) IC:None))
(= (ic-search:consider (MIL.SourceModel $background $skeletons) $original $best $candidate)
   (if (and (mil-program:in-family? $background $best) (mil-program:in-family? $background $candidate))
     (case (ic-packed:check IC:SourceExamples $original $best $candidate)
       (((IC:PackedAccepted $bytes $before $after) (IC:CandidateAccepted $bytes))
        ((IC:PackedRejected $reason) (IC:CandidateRejected $reason))))
     (IC:CandidateRejected ChangedVocabulary)))
(= (ic-search:materialize (MIL.SourceModel $background $skeletons) $original $proposal)
   (case $proposal
     (((MIL.ProgramProposal $program) (mil-program:proposal $original $background $program))
      ($invalid (IC:ProducerFault Proposal)))))
(= (mil-program:open $original $background $skeletons $type $sources $types)
   (let $handle (work-new (mil-program:produce $types $skeletons $type))
     (case (ic:prepare (MIL.SourceModel $background $skeletons) $original
             (cons-atom (context-space) $sources) 64 ((IC:Branch 0 $handle)))
       (((IC:PreparedSearch $state) (IC:PreparedSearch $state))
        ($failed (let $closed (work-cancel $handle) $failed))))))
(= (ic:prepare-fit Source:MIL $original (MIL.SourceRegion $background $skeletons) $sources)
   (if (mil-program:skeletons? $skeletons)
     (case ((mil-program:unpack $original) (mil-program:background $background))
       ((((MIL.Task $header $type $mode $inputs $negative-inputs $forbidden (MIL.SourceLiteral $labels))
           (MIL.ProgramBackground $types $semantics))
         (mil-program:open $original $background $skeletons $type $sources $types))
        (($task (MIL.ProgramRefused $reason)) (IC:FitRefused $reason))
        ($invalid (IC:FitRefused SourceTask)))) (IC:FitRefused Region)))
(= (ic:fit Source:MIL $original $region $sources $budget)
   (case (ic:prepare-fit Source:MIL $original $region $sources)
     (((IC:PreparedSearch $state) (ic:resume $state $budget)) ($failed $failed))))
(= (ic:predict Source:MIL $artifact $inputs)
   (case ((mil-program:unpack $artifact) (portable-value:pack $inputs))
     ((((MIL.Task $header $type $mode $training $negative-inputs $forbidden (MIL.SourceProgram $background $program))
         (Binary:TreeBytes $checked-inputs))
       (case (mil-program:background $background)
         (((MIL.ProgramBackground $types $semantics)
           (if (and (mil-program:typed? $types $program $type) (== (binary:portable-kind $inputs) Expression))
             (case (mil-program:run-rows $semantics $program $inputs)
               (((IC:Some $predictions) (IC:Predictions $predictions)) ($invalid (IC:FitRefused Prediction))))
             (IC:FitRefused Inputs))) ($invalid (IC:FitRefused Background)))))
      (((MIL.Task $header $type $mode $training $negative-inputs $forbidden (MIL.SourceProgram $background $program)) $bad-inputs)
       (IC:FitRefused Inputs))
      ($invalid (IC:FitRefused NoModel)))))
