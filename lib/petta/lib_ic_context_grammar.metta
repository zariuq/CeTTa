; Corpus-guided source templates and calling-convention alternatives. The
; common IC controller owns every producer and continuation. Parsing, source
; projection, byte encoding and candidate checking stay outside generators.
!(import! &self (library lib_ic_context_library))
!(import! &self (library lib_ic_guided_grammar))

(= (source-grammar:later $first $tail $left $right $mode)
   (if (== $tail ()) (superpose ())
     (case (cons-atom $first (cons-atom (car-atom $tail) ()))
       ((((IC:Packet $slots ((IC:Node $head $children))) (IC:Packet $slots ((IC:Node $other $arguments))))
         (if (== (== $head $other) (== $mode SameHead))
           (Library:GuidePair $left $right (cons-atom (IC:Node $head $children) ())
             (cons-atom (IC:Node $other $arguments) ()))
           (superpose ())))))))
(= (source-grammar:later $first $tail $left $right $mode)
   (if (== $tail ()) (superpose ())
     (source-grammar:later $first (cdr-atom $tail) $left (+ $right 1) $mode)))
(= (source-grammar:pairs $packets $index $mode)
   (if (== $packets ()) (superpose ())
     (source-grammar:later (car-atom $packets) (cdr-atom $packets) $index (+ $index 1) $mode)))
(= (source-grammar:pairs $packets $index $mode)
   (if (== $packets ()) (superpose ()) (source-grammar:pairs (cdr-atom $packets) (+ $index 1) $mode)))
(= (source-grammar:produce $signature $packets $depth $mode $kind)
   (case (source-grammar:pairs $packets 0 $mode)
     (((Library:GuidePair $left $right $first $second)
       (if (== $kind Seeds) (IC:Proposal (Library:Seed $left $right))
         (case (ic-guided:many $signature ((IC:Slot Root ByteTree)) $depth (IC:HoleState 0 ()) ()
                 (cons-atom $first (cons-atom $second ())))
           (((IC:GuidedExpansion $patterns $state $captures)
             (IC:Proposal (Library:GuidedTemplate $patterns $left $right)))
            ((IC:GrammarFault $reason) (IC:ProducerFault $reason)))))))))

(= (source-grammar:eligible $prepared $patterns $left $right)
   (case $prepared
     (((Library:DeferredPrepared $document $archive $sites)
       (case (ic-archive:prepare $archive)
         (((IC:PreparedArchive $tree (IC:Catalog $version $observation $signature $heads $literals) $packets)
           (case ((ic-template:operator $packets $left) (ic-template:operator $packets $right)
                  (ic-template:operator $sites $left) (ic-template:operator $sites $right))
             ((((IC:Some (IC:Packet $slots $first)) (IC:Some (IC:Packet $slots $second))
                (IC:Some (Ctx:ValueSite $lo $lp $lb $lports $lt)) (IC:Some (Ctx:ValueSite $ro $rp $rb $rports $rt)))
               (case ((ic-template:admit-list $signature $slots $patterns ())
                      (ic-template:match $signature $slots $patterns $first)
                      (ic-template:match $signature $slots $patterns $second))
                 ((((IC:Some $holes) (IC:Some $ls) (IC:Some $rs))
                   (Ctx:Choices (context-library:ready-holes $heads $literals $holes $ls $rs
                     (Ctx:Origin $left $lb $lports) (Ctx:Origin $right $rb $rports))))
                  ($bad-template (Library:Refused InvalidTemplate)))))
              ($bad-guides (Library:Refused InvalidGuides))))) ($bad-archive (Library:Refused InvalidProjection)))))
      ($bad-task (Library:Refused InvalidTask)))))
(= (source-grammar:response $result)
   (case $result
     (((Library:Candidate $bytes $support) (IC:Candidate $bytes))
      ((Library:Refused $reason) (IC:Refused $reason)) ($invalid-response (IC:ProducerFault InvalidLibraryResponse)))))
(= (ic-search:observation (Library:GrammarModel $prepared $name) $artifact)
   (ic-search:observation (Library:DeferredModel $prepared $name) $artifact))
(= (ic-search:consider (Library:GrammarModel $prepared $name) $original $best $candidate)
   (ic-search:consider (Library:DeferredModel $prepared $name) $original $best $candidate))
(= (ic-search:materialize (Library:GrammarModel $prepared $name) $original $proposal)
   (case $proposal
     (((Library:Seed $left $right)
       (ic-search:materialize (Library:DeferredModel $prepared $name) $original $proposal))
      ((Library:GuidedTemplate $patterns $left $right)
       (case (source-grammar:eligible $prepared $patterns $left $right)
         (((Ctx:Choices $ready)
           (if (== $ready ()) (source-grammar:response (context-library:factor $prepared $name $patterns ()))
             (IC:Continue 1 (Library:ModeChoices $patterns $ready ()))))
          ($invalid-guides (source-grammar:response $invalid-guides)))))
      ((Library:ModeChoices $patterns $remaining $chosen)
       (if (== $remaining ()) (source-grammar:response (context-library:factor $prepared $name $patterns $chosen))
         (IC:Responses
           (cons-atom (IC:Continue 1 (Library:ModeChoices $patterns (cdr-atom $remaining) (cons-atom (car-atom $remaining) $chosen)))
             (cons-atom (IC:Continue 1 (Library:ModeChoices $patterns (cdr-atom $remaining) $chosen)) ())))))
      ($bad-proposal (IC:ProducerFault InvalidLibraryProposal)))))

(= (source-grammar:open $prepared $name $depth $quantum $signature $packets)
   (case $prepared
     (((Library:DeferredPrepared $document $archive $sites)
       (let* (($seed-same (work-new (source-grammar:produce $signature $packets $depth SameHead Seeds)))
              ($grammar-same (work-new (source-grammar:produce $signature $packets $depth SameHead Grammar)))
              ($seed-other (work-new (source-grammar:produce $signature $packets $depth OtherHead Seeds)))
              ($grammar-other (work-new (source-grammar:produce $signature $packets $depth OtherHead Grammar))))
         (case (ic:prepare (Library:GrammarModel $prepared $name) (ic:source-pack $document) ((context-space)) $quantum
                 ((IC:Branch 0 $seed-same) (IC:Branch 1 $grammar-same) (IC:Branch 2 $seed-other) (IC:Branch 3 $grammar-other)))
           (((IC:PreparedSearch $state) (IC:PreparedSearch $state))
            ($refusal
             (let* (($closed-first (work-cancel $seed-same)) ($closed-second (work-cancel $grammar-same))
                    ($closed-third (work-cancel $seed-other)) ($closed-fourth (work-cancel $grammar-other))) $refusal)))))))))
(= (ic:learn-library Deferred $document $suffix (IC:Grammar $depth) $quantum)
   (if (and (binary-schema:text? $suffix) (binary:unsigned? $depth))
     (case (ic:prepare-library Deferred $document)
       (((Library:DeferredPrepared $original $archive $sites)
         (let $name (str:concat "ic-learned:" $suffix)
           (if (and (source-library:name? $name) (not (source-library:mentions? $name $original)))
             (case (ic-archive:prepare $archive)
               (((IC:PreparedArchive $tree (IC:Catalog $version $observation $signature $heads $literals) $packets)
                 (source-grammar:open (Library:DeferredPrepared $original $archive $sites) $name $depth $quantum $signature $packets))
                ($invalid-projection (IC:SearchRefused InvalidLibraryTask))))
             (IC:SearchRefused InvalidLibraryName)))) ($source-refusal $source-refusal)))
     (IC:SearchRefused InvalidGrammar)))
