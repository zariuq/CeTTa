; Composition of unary typed tensor programs. The later root must propagate
; a failed input before any competing failure. This property is derived from
; ordered data dependencies, not a caller's purity or strictness declaration.
!(import! &self (library lib_tensor_program))

(= (tp-compose:reverse-at $values $index)
   (if (and (binary:unsigned? $index) (< $index (size-atom $values)))
     (TP:Some (index-atom $values (- (- (size-atom $values) 1) $index))) TP:None))
(= (tp-compose:select $values $indices)
   (if (== $indices ()) (TP:Some ())
     (case ((tp-compose:reverse-at $values (car-atom $indices))
            (tp-compose:select $values (cdr-atom $indices)))
       ((((TP:Some $head) (TP:Some $tail))
         (let $selected (cons-atom $head $tail) (TP:Some $selected)))
        ($bad-selection TP:None)))))

; A validated constant leaf always supplies a value. An operation on constant
; arguments can still fail, so it is not automatically classified as total.
; The first non-total argument controls failure propagation at every node.
(= (tp-compose:dominance $arguments)
   (if (== $arguments ()) Other
     (case (car-atom $arguments)
       ((Total (tp-compose:dominance (cdr-atom $arguments)))
        (InputDominant InputDominant) ($other-state Other)))))
(= (tp-compose:scan $records $input $states)
   (if (== $records ()) (TP:Flow $input $states)
     (case (car-atom $records)
       (((Binary:Leaf $bytes)
         (case (binary-value:unpack $bytes)
           (((BinaryValue:Value (TP:Input $sort 0))
             (if (or (== $input TP:NoInput) (== $input (TP:InputSort $sort)))
               (tp-compose:scan (cdr-atom $records) (TP:InputSort $sort)
                 (cons-atom InputDominant $states)) (TP:Fault InputSort)))
            ((BinaryValue:Value (TP:Constant $sort $payload))
             (tp-compose:scan (cdr-atom $records) $input (cons-atom Total $states)))
            ($bad-leaf (TP:Fault NonUnary)))))
        ((Binary:Node $tag $children)
         (case (tp-compose:select $states $children)
           (((TP:Some $arguments)
             (tp-compose:scan (cdr-atom $records) $input
               (cons-atom (tp-compose:dominance $arguments) $states)))
            ($bad-dependencies (TP:Fault References)))))
        ($bad-record (TP:Fault Records))))))

; The native DAG handle is closed before a snapshot leaves this operation.
(= (tensor-program:unary-snapshot $bytes)
   (case (tensor-program:unpack $bytes)
     (((TP:Loaded $family $handle)
       (let* (($forest (dag:export $handle)) ($closed (dag:close $handle)))
         (case $forest
           (((Dag:Forest ($root) $records)
             (case ((tensor-program:check-records $family () $records)
                    (tp-compose:scan $records TP:NoInput ()))
               ((((TP:Some $types) (TP:Flow (TP:InputSort $input-sort) $states))
                 (case ((tensor-program:at $types $root) (tp-compose:reverse-at $states $root))
                   ((((TP:Some $output-sort) (TP:Some $demand))
                     (TP:Unary $family $root $records $input-sort $output-sort $demand))
                    ($invalid-root (TP:Fault Root)))))
                ($not-unary (TP:Fault NonUnary)))))
            ($not-single-root (TP:Fault RootCount))))))
      ($invalid-program $invalid-program))))

(= (tp-compose:tag $codes $offset $bytes)
   (case (binary-value:unpack $bytes)
     (((BinaryValue:Value (TP:Apply $index $parameters))
       (case (tensor-program:at $codes (+ $offset $index))
         (((TP:Some $next)
           (let $encoded (tensor-program:bytes (TP:Apply $next $parameters)) (TP:Some $encoded)))
          ($bad-operator TP:None)))) ($bad-tag TP:None))))
(= (tp-compose:relabel $records $codes $offset)
   (if (== $records ()) (TP:Some ())
     (case (car-atom $records)
       (((Binary:Leaf $bytes)
         (case (tp-compose:relabel (cdr-atom $records) $codes $offset)
           (((TP:Some $tail)
             (let $leaf-records (cons-atom (Binary:Leaf $bytes) $tail) (TP:Some $leaf-records)))
            ($bad-leaf-tail TP:None))))
        ((Binary:Node $tag $children)
         (case ((tp-compose:tag $codes $offset $tag) (tp-compose:relabel (cdr-atom $records) $codes $offset))
           ((((TP:Some $next) (TP:Some $tail))
             (let $node-records (cons-atom (Binary:Node $next $children) $tail) (TP:Some $node-records)))
            ($bad-node-tail TP:None)))) ($bad-relabel TP:None)))))

; Alias vectors and output records are accumulated in reverse order. Input
; leaves become aliases to the earlier root; repeated edges remain repeated.
(= (tp-compose:link $records $codes $offset $earlier $aliases $output $count)
   (if (== $records ()) (TP:Linked $aliases $output)
     (case (car-atom $records)
       (((Binary:Leaf $bytes)
         (case (binary-value:unpack $bytes)
           (((BinaryValue:Value (TP:Input $sort 0))
             (tp-compose:link (cdr-atom $records) $codes $offset $earlier
               (cons-atom $earlier $aliases) $output $count))
            ((BinaryValue:Value (TP:Constant $sort $payload))
             (tp-compose:link (cdr-atom $records) $codes $offset $earlier
               (cons-atom $count $aliases) (cons-atom (Binary:Leaf $bytes) $output) (+ $count 1)))
            ($invalid-input (TP:Fault NonUnary)))))
        ((Binary:Node $tag $children)
         (case ((tp-compose:tag $codes $offset $tag) (tp-compose:select $aliases $children))
           ((((TP:Some $next) (TP:Some $references))
             (tp-compose:link (cdr-atom $records) $codes $offset $earlier
               (cons-atom $count $aliases) (cons-atom (Binary:Node $next $references) $output) (+ $count 1)))
            ($invalid-node (TP:Fault References)))))
        ($invalid-record (TP:Fault Records))))))

(= (tp-compose:combine
     (TP:Unary (TP:Family $left-version $left-ops) $left-root $left-records $input $middle $left-demand)
     (TP:Unary (TP:Family $right-version $right-ops) $right-root $right-records $wanted $output $right-demand))
   (if (== $middle $wanted)
     (if (== $right-demand InputDominant)
       (case (list:factorize (union-atom $left-ops $right-ops))
         (((List:Factorization $operators $codes $firsts)
           (let $family (TP:Family "TF1" $operators)
             (if (tensor-program:family? $family)
               (case (tp-compose:relabel $left-records $codes 0)
                 (((TP:Some $before)
                   (case (tp-compose:link $right-records $codes (size-atom $left-ops) $left-root ()
                           (list:reverse $before) (size-atom $before))
                     (((TP:Linked $aliases $reversed)
                       (case (tp-compose:reverse-at $aliases $right-root)
                         (((TP:Some $root)
                           (let* (($roots (cons-atom $root ())) ($records (list:reverse $reversed)))
                             (TP:Blueprint $family (Dag:Forest $roots $records))))
                          ($bad-final-root (TP:Fault Root)))))
                      ($failed-link $failed-link))))
                  ($failed-relabel (TP:Fault Operators))))
               (TP:Fault OperatorConflict))))
          ($failed-factorization (TP:Fault Operators))))
       (TP:Fault NonStrict)) (TP:Fault ComposeSort)))

(= (tensor-program:compose-strict $earlier $later)
   (case ((tensor-program:unary-snapshot $earlier) (tensor-program:unary-snapshot $later))
     ((((TP:Unary $f $r $a $i $m $d) (TP:Unary $g $s $b $j $o $e))
       (case (tp-compose:combine (TP:Unary $f $r $a $i $m $d) (TP:Unary $g $s $b $j $o $e))
         (((TP:Blueprint $family $forest) (tensor-program:pack $family $forest))
          ($refusal $refusal))))
      ($bad-snapshots (TP:Fault InvalidComposition)))))
