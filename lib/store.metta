; Generic SQLite-free byte storage. MeTTa owns record encodings, indexes,
; queries, transitions and durable application receipts.
; The directory already exists durably and is private to the owner.
(: __cetta_lib_store_open (-> String String Atom))
(: __cetta_lib_store_snapshot (-> Atom Atom))
(: __cetta_lib_store_view_info (-> Atom Atom))
(: __cetta_lib_store_view_clone (-> Atom Atom))
(: __cetta_lib_store_check_view (-> Atom Atom Atom))
(: __cetta_lib_store_program_watch_open (-> Atom))
(: __cetta_lib_store_program_watch_clone (-> Atom Atom))
(: __cetta_lib_store_program_watch_check (-> Atom Atom))
(: __cetta_lib_store_commit_guarded (-> Atom Atom Atom Atom Atom))
(: __cetta_lib_store_space_view (-> Atom String Atom))
(: __cetta_lib_store_space_query_open (-> Atom String Atom Atom Atom))
(: __cetta_lib_store_space_point_query_open (-> Atom String Atom Atom Atom))
(: __cetta_lib_store_space_query_next (-> Atom Number Number Number Atom))
(: __cetta_lib_store_space_query_checkpoint (-> Atom Atom))
(: __cetta_lib_store_space_query_cancel (-> Atom Atom))
(: __cetta_lib_store_space_query_info (-> Atom Atom))
(: __cetta_lib_store_commit (-> Atom Atom Atom Atom))
(: __cetta_lib_store_batch_open (-> Atom Atom Number Atom))
(: __cetta_lib_store_batch_add (-> Atom Atom Atom))
(: __cetta_lib_store_batch_info (-> Atom Atom))
(: __cetta_lib_store_commit_batch (-> Atom Atom Atom Atom))
(: __cetta_lib_store_commit_scoped (-> Atom Atom Atom Atom Atom Atom))
(: __cetta_lib_store_get (-> Atom String Number Atom))
(: __cetta_lib_store_blob_open (-> Atom String Atom))
(: __cetta_lib_store_blob_read (-> Atom Number Number Atom))
(: __cetta_lib_store_scan_open (-> Atom Atom Atom Atom))
(: __cetta_lib_store_scan_reverse_open (-> Atom Atom Atom Atom))
(: __cetta_lib_store_scan_next (-> Atom Number Atom))
(: __cetta_lib_store_recover (-> Atom Atom))
(: __cetta_lib_store_compact (-> Atom Atom))
(: __cetta_lib_store_collect (-> Atom Atom))
(: __cetta_lib_store_backup (-> Atom String Atom))
(: __cetta_lib_store_close (-> Atom Atom))
(: __cetta_lib_store_encode (-> Atom Atom))
(: __cetta_lib_store_decode (-> String Atom))
(: __cetta_lib_store_key_i64 (-> Number Atom))
(: __cetta_lib_store_key_to_i64 (-> String Atom))
(: __cetta_lib_store_scalar_order (-> Atom Atom Atom))
(: __cetta_lib_store_scalar_range (-> Atom Atom Atom Atom))
(: __cetta_lib_store_integer_window (-> Atom Atom Atom))

(= (store:scalar-order $left $right)
   (function (case (__cetta_lib_store_scalar_order $left $right) (($result (return $result))))))
(= (store:scalar-range $value $lower $upper)
   (function (case (__cetta_lib_store_scalar_range $value $lower $upper) (($result (return $result))))))
(= (store:integer-window $lower $upper)
   (function (case (__cetta_lib_store_integer_window $lower $upper) (($result (return $result))))))

(= (store:open $path $mode)
   (function (case (__cetta_lib_store_open $path $mode) (($result (return $result))))))
(= (store:snapshot $store)
   (function (case (__cetta_lib_store_snapshot $store) (($result (return $result))))))
; Captured coordinates only; this neither takes a new snapshot nor validates
; a publisher or a later transaction's read dependencies.
(= (store:view-info $view)
   (function (case (__cetta_lib_store_view_info $view) (($result (return $result))))))
; Independent owning handle to this captured root, not a newer snapshot.
(= (store:view-clone $view)
   (function (case (__cetta_lib_store_view_clone $view) (($result (return $result))))))
(= (store:check-view $store $view)
   (function (case (__cetta_lib_store_check_view $store $view) (($result (return $result))))))
(= (store:space-point-query-open $view $key $pattern $template)
   (function (case (__cetta_lib_store_space_point_query_open $view $key $pattern $template) (($result (return $result))))))
(= (store:program-watch-open)
   (function (case (__cetta_lib_store_program_watch_open) (($result (return $result))))))
(= (store:program-watch-clone $watch)
   (function (case (__cetta_lib_store_program_watch_clone $watch) (($result (return $result))))))
(= (store:program-watch-check $watch)
   (function (case (__cetta_lib_store_program_watch_check $watch) (($result (return $result))))))
(= (store:commit-guarded $store $view $watch $ops)
   (function (case (__cetta_lib_store_commit_guarded $store $view $watch $ops) (($result (return $result))))))
; The named metadata record is (StoreSpaceV1 prefix occurrence-count), encoded
; with store:encode in the same captured store as the atom rows. Each value
; under prefix is one CAV1 atom and its key is the occurrence identity. The
; resulting read-only Space owns its snapshot independently of the handles.
(= (store:space-view $view $metadata-key)
   (function (case (__cetta_lib_store_space_view $view $metadata-key) (($result (return $result))))))
; A request-owned cursor over that same captured Space/matcher. Query syntax
; is held data; row templates are instantiated without evaluation. Sequence
; retries replay the last offered row until the next sequence is requested.
; Checkpoint between pages/work quanta to retire earlier arena allocations.
(: store:space-query-open (-> %Undefined% String Atom Atom %Undefined%))
(= (store:space-query-open $view $metadata-key $pattern $template)
   (function (case (__cetta_lib_store_space_query_open $view $metadata-key $pattern $template) (($result (return $result))))))
(= (store:space-query-next $query $sequence $transitions $maximum-bytes)
   (function (case (__cetta_lib_store_space_query_next $query $sequence $transitions $maximum-bytes) (($result (return $result))))))
(= (store:space-query-checkpoint $query)
   (function (case (__cetta_lib_store_space_query_checkpoint $query) (($result (return $result))))))
(= (store:space-query-cancel $query)
   (function (case (__cetta_lib_store_space_query_cancel $query) (($result (return $result))))))
(= (store:space-query-info $query)
   (function (case (__cetta_lib_store_space_query_info $query) (($result (return $result))))))
(= (store:commit $store $view $ops)
   (function (case (__cetta_lib_store_commit $store $view $ops) (($result (return $result))))))
; Volatile operation data, staged through bounded messages, then published
; once through the same captured-view owner. Close discards an uncommitted batch.
(= (store:batch-open $store $view $maximum-bytes)
   (function (case (__cetta_lib_store_batch_open $store $view $maximum-bytes) (($result (return $result))))))
(: store:batch-add (-> %Undefined% Atom %Undefined%))
(= (store:batch-add $batch $ops)
   (function (case (__cetta_lib_store_batch_add $batch $ops) (($result (return $result))))))
(= (store:batch-info $batch)
   (function (case (__cetta_lib_store_batch_info $batch) (($result (return $result))))))
(= (store:commit-batch $store $view $batch)
   (function (case (__cetta_lib_store_commit_batch $store $view $batch) (($result (return $result))))))
(= (store:commit-scoped $store $view $reads $writes $ops)
   (function (case (__cetta_lib_store_commit_scoped $store $view $reads $writes $ops) (($result (return $result))))))
(= (store:get $view $key $bytes)
   (function (case (__cetta_lib_store_get $view $key $bytes) (($result (return $result))))))
(= (store:blob-open $view $key)
   (function (case (__cetta_lib_store_blob_open $view $key) (($result (return $result))))))
(= (store:blob-read $reader $offset $count)
   (function (case (__cetta_lib_store_blob_read $reader $offset $count) (($result (return $result))))))
(= (store:scan-open $view $lower $upper)
   (function (case (__cetta_lib_store_scan_open $view $lower $upper) (($result (return $result))))))
(= (store:scan-reverse-open $view $lower $upper)
   (function (case (__cetta_lib_store_scan_reverse_open $view $lower $upper) (($result (return $result))))))
(= (store:scan-next $scan $position)
   (function (case (__cetta_lib_store_scan_next $scan $position) (($result (return $result))))))
(= (store:recover $store)
   (function (case (__cetta_lib_store_recover $store) (($result (return $result))))))
(= (store:compact $store)
   (function (case (__cetta_lib_store_compact $store) (($result (return $result))))))
(= (store:collect $store)
   (function (case (__cetta_lib_store_collect $store) (($result (return $result))))))
; Captured revision -> self-contained store in an empty private directory.
; UNKNOWN needs destination recovery; never overwrite or silently retry.
(= (store:backup $view $destination)
   (function (case (__cetta_lib_store_backup $view $destination) (($result (return $result))))))
(= (store:close $handle)
   (function (case (__cetta_lib_store_close $handle) (($result (return $result))))))
; CAV1 convenience codec, with the existing portable-wire bounds. Large
; payloads stay available through raw byte values and verified blob readers.
(= (store:encode $value)
   (function (case (__cetta_lib_store_encode $value) (($result (return $result))))))
(= (store:decode $bytes)
   (function (case (__cetta_lib_store_decode $bytes) (($result (return $result))))))
; Fixed-width signed integer order embedding; schema/layout belongs to callers.
(= (store:key-i64 $integer)
   (function (case (__cetta_lib_store_key_i64 $integer) (($result (return $result))))))
(= (store:key->i64 $bytes)
   (function (case (__cetta_lib_store_key_to_i64 $bytes) (($result (return $result))))))
