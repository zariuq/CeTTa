; An owned JSON service client for MeTTa hosts. The checking process keeps
; its own theory; only protocol data crosses the boundary.
!(import! &self json)
!(import! &self str)
!(import! &self system)
!(import! &self proc)
!(import! &self fs)
!(import! &self path)

(= (math:client-open $binary $workspace $timeout)
   (math:client-open $binary $workspace $timeout "" 1048576))
(= (math:client-open $binary $workspace $timeout $lean-root)
   (math:client-open $binary $workspace $timeout $lean-root 1048576))
(= (math:client-open $binary $workspace $timeout $lean-root $bytes)
     (let* (($executable (fs:canonical-path $binary)) ($directory (path:dirname $executable))
            ($near (path:join $directory "tools/math_space.py"))
            ($parent (path:dirname $directory))
            ($script (if (fs:exists $near) $near (path:join $parent "tools/math_space.py")))
            ($seconds (str:number->string $timeout))
            ($last (cons-atom $seconds ())) ($tail (cons-atom "--timeout" $last))
            ($work-value (cons-atom $workspace $tail)) ($work (cons-atom "--workspace-root" $work-value))
            ($binary-value (cons-atom $binary $work)) ($selected (cons-atom "--binary" $binary-value))
            ($script-value (cons-atom $script $selected)) ($base (cons-atom "python3" $script-value))
            ($extra-value (cons-atom $lean-root ())) ($extra (cons-atom "--lean-root" $extra-value))
            ($argv (if (== $lean-root "") $base (union-atom $base $extra))))
       (function
         (case (proc:spawn $argv ((lifetime owner) (mode stream) (max-bytes $bytes)))
           (($owner (return (Math:Client $owner $timeout $bytes))))))))
(= (math:client-failure $state $reason)
   (JsonObject ((JsonPair "schema" "prime.math-space.reply.v1") (JsonPair "id" "")
                (JsonPair "state" $state) (JsonPair "reason" $reason))))
(= (math:client-stop $owner)
   (chain (proc:cancel $owner) $cancelled
     (chain (proc:close $owner) $closed ())))
(= (math:client-frame $owner $deadline $bytes $buffer)
   (let* (($now (system:monotonic-ns)) ($size (str:byte-length $buffer)))
     (if (>= $now $deadline)
       (chain (math:client-stop $owner) $stopped (math:client-failure "uncertain" "client-deadline"))
       (if (> $size $bytes)
         (chain (math:client-stop $owner) $stopped (math:client-failure "uncertain" "client-response-limit"))
         (if (str:ends-with $buffer "\n") (json:parse $buffer)
           (chain (proc:read $owner stderr 0) $diagnostic
             (case (proc:read $owner stdout 20)
               (((proc:chunk $part)
                  (let $next (str:concat $buffer $part)
                    (math:client-frame $owner $deadline $bytes $next)))
                (proc:pending (math:client-frame $owner $deadline $bytes $buffer))
                ($other (math:client-failure "uncertain" "client-closed"))))))))))
(= (math:client-call (Math:Client $owner $timeout $bytes) $request-text)
   (let* (($size (str:byte-length $request-text)) ($line (str:concat $request-text "\n"))
          ($now (system:monotonic-ns)) ($deadline (+ $now (* $timeout 1000000000))))
     (if (>= $size $bytes) (math:client-failure "unfinished" "client-input-limit")
       (case (proc:write $owner $line)
         (((proc:queued $count) (math:client-frame $owner $deadline $bytes ""))
          (proc:backpressure (math:client-failure "unfinished" "client-backpressure"))
          ($other (let $detail (repr $other)
             (JsonObject ((JsonPair "schema" "prime.math-space.reply.v1") (JsonPair "id" "") (JsonPair "state" "unavailable") (JsonPair "reason" "client-write-failed")
                          (JsonPair "detail" $detail))))))))))
(= (math:client-close $client) (math:client-close $client 1000))
(= (math:client-close (Math:Client $owner $timeout $bytes) $grace)
   (chain (proc:close-input $owner) $input
     (chain (proc:wait $owner $grace) $waited
       (chain (proc:cancel $owner) $cancelled (proc:close $owner)))))

(CommandSpec 1 "math" "math:client-call" 2 2
  "(math:client-call client request-json)"
  "Drive the selected Prime mathematical workspace; receive structured checking data." "")
