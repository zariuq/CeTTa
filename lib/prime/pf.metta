; Generated by tools/prime_scope_migration.py from lib/pf.metta; do not edit.
(scope:profile lexical-fresh per-call reference)

; Proof verbs for the set: proof language.
;
; The checker owns names, hypotheses and lemma instantiation:
;   (pf:fix x body)        (pf:assume h body)        (pf:have h proof body)
;   (pf:by name p1 ... pk) a known fact or hypothesis, instantiated by
;                          matching its conclusion against the goal
; and, in a theory whose space declares (set:rule eq-subst), the rule of
; substitution:
;   (pf:eq-subst P e h)    P b from e : eq A a b and h : P a, at any carrier
; The verbs below are ordinary programs that return core proof terms;
; nothing they produce is believed until the checker has seen it.  The
; equational verbs expand to the two equality axioms of a carrier, refl and
; substitution, so a theory needs no congruence, symmetry or transitivity
; axioms.
;
;   (pf:theory &t (decl ...))          declare the object theory in a space
;   (pf:equality &t A refl subst)      publish refl and substitution for A
;   (pf:equality &t A refl subst p)    the same, with refl a theorem proved
;                                      by p, where the theory proves it
;   (pf:refl A a)                      eq A a a
;   (pf:sym A a b p)                   eq A b a from p : eq A a b
;   (pf:trans A a b c p q)             eq A a c from p, q
;   (pf:cong A B F a b p)              eq B (F a) (F b) from p : eq A a b
;   (pf:calc A t0 (= t1 j1) ...)       an equational chain in carrier A;
;      a justification j is a proof term, (by name p ...), (sym j) when j
;      proves the step reversed, or (cong A' F a b p) for the step
;      F a = F b in carrier A
;   (pf:induction principle motive base step)
;   (pf:rests-on &t name)              the laws and axioms a theorem's
;                                      native package rests on, through the
;                                      theorems it cites by name

(= (pf:theory $space $decls) (let $added (map-atom $decls $d (add-atom $space $d)) ()))

; publish a theorem, or check a proof, through the judgments
; The verbs in a proof are expanded to core terms bottom-up before the
; judgment reads the proof as data.  Expansion is explicit so that it does
; not depend on the evaluator's order: children first, then the node if its
; head is a verb, then the verb's output again.
(= (pf:verbs) (pf:calc-from pf:calc-chain pf:step pf:cong pf:sym pf:trans
               pf:refl pf:subst-with pf:apply pf:at pf:induction-from))
; Values are forced with let before they are compared, deconstructed or
; passed on: an atom builtin in argument position reaches its callee as
; syntax, not as its value.
(= (pf:member $x $list)
   (if (== $list ()) False
       (let $h (car-atom $list)
         (if (== $h $x) True
             (let $rest (cdr-atom $list) (pf:member $x $rest)){$rest})){$h}))
(= (pf:verb-head $t)
   (let $h (car-atom $t)
     (if (== (get-metatype $h) Symbol)
         (let $verbs (pf:verbs) (pf:member $h $verbs)){$verbs}
         False)))

; A list is walked as syntax: the walker's parameter is Data, so the tail of a
; term such as (mapf (lam y b) nil), the list ((lam y b) nil), stays held
; through car-atom and cdr-atom and is never run as an application.
(: pf:expand-tail (-> (Data Atom) (Data Atom)))
(= (pf:expand-list $t) (pf:expand-tail $t))
(= (pf:expand-tail $t)
   (if (== $t ()) ()
       (let $h (car-atom $t)
         (let $rest (cdr-atom $t)
           (let $eh (pf:expand $h)
             (let $et (pf:expand-tail $rest)
               (cons-atom $eh $et)){$et}){$eh}){$rest}){$h}))

(= (pf:expand $t)
   (if (== (get-metatype $t) Expression)
       (if (== $t ()) ()
           (let $node (pf:expand-list $t)
             (let $head (car-atom $node)
               (if (== $head pf:induction)
                   (let $P (index-atom $node 1)
                   (let $M (index-atom $node 2)
                   (let $r1 (cdr-atom $node)
                   (let $r2 (cdr-atom $r1)
                   (let $cases (cdr-atom $r2)
                   (let $out (pf:induction-from (pf:all-elim (pf:known $P) $M) $cases)
                     (pf:expand $out)){$out}){$cases}){$r2}){$r1}){$M}){$P}
               (if (== $head pf:calc)
                   (let $A (index-atom $node 1)
                   (let $t0 (index-atom $node 2)
                   (let $r1 (cdr-atom $node)
                   (let $r2 (cdr-atom $r1)
                   (let $steps (cdr-atom $r2)
                   (let $out (pf:calc-from $A $t0 $steps)
                     (pf:expand $out)){$out}){$steps}){$r2}){$r1}){$t0}){$A}
                   (if (pf:verb-head $node)
                       (let $out $node (if (== $out $node) $node (pf:expand $out))){$out}
                       $node)))){$head}){$node})
       $t))

; Syntax is handed to a judgment quoted: the evaluator then leaves it
; alone even where a constant shares its name with a builtin.
(: pf:theorem (-> Atom Atom Atom Atom %Undefined%))
(= (pf:theorem $space $name $prop $proof)
   (let $p (pf:expand $proof)
     (let $qp (cons-atom quote ($p))
       (let $qprop (cons-atom quote ($prop))
         (set:theorem $space $name $qprop $qp)))))
(: pf:proves (-> Atom Atom Atom %Undefined%))
(= (pf:proves $space $proof $prop)
   (let $p (pf:expand $proof)
     (let $qp (cons-atom quote ($p))
       (let $qprop (cons-atom quote ($prop))
         (set:proves $space $qp $qprop)))))

; The binders of the two axioms are chosen apart from the carrier, so that a
; carrier that mentions a binder's name (a type named P, or a) is not
; captured by it: each is the first of base, base1, base2, ... that the
; carrier does not mention.
; The chosen binder names are symbols computed here, so each statement is
; built from them, (all A (lam x body)) by pf:all: a lambda's parameter is
; its own (lexical), and no substitution may replace it.
(= (pf:equality $space $A $refl $subst)
   (let $P (pf:binder-apart P $A)
   (let $x (pf:binder-apart a $A)
   (let $y (pf:binder-apart b $A)
   (let $refl-statement (pf:all $A $x (eq $A $x $x))
   (let $r (set:axiom $space $refl $refl-statement)
   (let $subst-statement (pf:substitution-statement $A $P $x $y)
     (let $s (set:axiom $space $subst $subst-statement)
       (let $t (add-atom &self (pf:equality-of $A $refl $subst))
         ($r $s))))))))))
; A carrier whose reflexivity the theory proves, as extensionality proves it
; for set: reflexivity is published as a theorem with the given proof, so
; that no provable statement is declared, and only substitution is an axiom.
(= (pf:equality $space $A $refl $subst $refl-proof)
   (let $P (pf:binder-apart P $A)
   (let $x (pf:binder-apart a $A)
   (let $y (pf:binder-apart b $A)
   (let $refl-statement (pf:all $A $x (eq $A $x $x))
   (let $r (pf:theorem $space $refl $refl-statement $refl-proof)
   (let $subst-statement (pf:substitution-statement $A $P $x $y)
     (let $s (set:axiom $space $subst $subst-statement)
       (let $t (add-atom &self (pf:equality-of $A $refl $subst))
         ($r $s))))))))))
; (all A (lam x body)) with the name x as its binder.
(: pf:all (-> Atom Atom Atom Atom))
(= (pf:all $A $x $body)
   (let $binder (cons-atom lam ($x $body))
     (cons-atom all ($A $binder))))
; all P : A -> prop. all x y : A. eq A x y -> P x -> P y
(: pf:substitution-statement (-> Atom Atom Atom Atom Atom))
(= (pf:substitution-statement $A $P $x $y)
   (let $inner (pf:all $A $y (imp (eq $A $x $y) (imp ($P $x) ($P $y))))
     (let $middle (pf:all $A $x $inner)
       (pf:all (-> $A prop) $P $middle))))
(= (pf:binder-apart $base $t) (pf:binder-apart-from $base $base 0 $t))
(= (pf:binder-apart-from $base $name $k $t)
   (if (pf:mentions $t $name)
       (let $k1 (+ $k 1)
         (let $next (parse (format-args "{}{}" ($base $k1)))
           (pf:binder-apart-from $base $next $k1 $t)){$next}){$k1}
       $name))
; whether the symbol s occurs in t; t is walked as syntax
(: pf:mentions-tail (-> (Data Atom) Atom Bool))
(= (pf:mentions $t $s)
   (if (== $t $s) True
       (if (== (get-metatype $t) Expression)
           (pf:mentions-tail $t $s)
           False)))
(= (pf:mentions-tail $t $s)
   (if (== $t ()) False
       (let $h (car-atom $t)
         (let $rest (cdr-atom $t)
           (if (pf:mentions $h $s) True (pf:mentions-tail $rest $s))){$rest}){$h}))
; the carrier is compared after the match, so that an arrow carrier is
; never placed inside a query pattern
(= (pf:at refl $A) (let $rows (collapse (match &self (pf:equality-of $c $r $s) ($c $r))) (pf:find-carrier $A $rows)))
(= (pf:at subst $A) (let $rows (collapse (match &self (pf:equality-of $c $r $s) ($c $s))) (pf:find-carrier $A $rows)))
(= (pf:find-carrier $A $rows)
   (if (== $rows ()) (pf:no-equality-for $A)
       (let ($c $name) (car-atom $rows)
         (if (== $c $A) $name
             (let $rest (cdr-atom $rows) (pf:find-carrier $A $rest)){$rest})){$c $name}))

; substitute the symbol s by r in t, respecting lam binders of the same name;
; t is walked as syntax through a Data parameter
(: pf:subst-tail (-> Atom Atom (Data Atom) (Data Atom)))
(= (pf:subst-list $s $r $t) (pf:subst-tail $s $r $t))
(= (pf:subst-tail $s $r $t)
   (if (== $t ()) ()
       (let $h (car-atom $t)
         (let $rest (cdr-atom $t)
           (let $sh (pf:subst $s $r $h)
             (let $st (pf:subst-tail $s $r $rest)
               (cons-atom $sh $st)){$st}){$sh}){$rest}){$h}))

(= (pf:subst $s $r $t)
   (if (== $t $s) $r
       (if (== (get-metatype $t) Expression)
           (if (unify $t (lam $s $_) True False)
               $t
               (pf:subst-list $s $r $t))
           $t)))

; apply a context: a lambda is reduced, anything else is applied
(= (pf:apply $F $a)
   (if (unify $F (lam $y $body) True False)
       (unify $F (lam $y $body) (pf:subst $y $a $body) none)
       ($F $a)))

(= (pf:refl $A $a) (pf:all-elim (pf:known (pf:at refl $A)) $a))

; subst@A at P a b, applied to p : eq A a b, then to q : P a
(= (pf:subst-with $A $P $a $b $p $q)
   (pf:imp-elim
     (pf:imp-elim
       (pf:all-elim (pf:all-elim (pf:all-elim (pf:known (pf:at subst $A)) $P) $a) $b)
       $p)
     $q))

(= (pf:sym $A $a $b $p)
   (pf:subst-with $A (lam pf-z (eq $A pf-z $a)) $a $b $p (pf:refl $A $a)))

(= (pf:trans $A $a $b $c $p $q)
   (pf:subst-with $A (lam pf-z (eq $A $a pf-z)) $b $c $q $p))

; A lambda is a value, so the motive's body is computed before the lambda is
; built: F applied to the name pf-z, which the lambda then binds.  The
; lambda is built from that body (cons-atom): substitution into a lambda is
; capture-avoiding, so it would rename the binder instead.
(= (pf:cong $A $B $F $a $b $p)
   (let $Fa (pf:apply $F $a)
     (let $Fz (pf:apply $F pf-z)
       (let $motive (cons-atom lam (pf-z (eq $B $Fa $Fz)))
         (pf:subst-with $A $motive $a $b $p (pf:refl $B $Fa))))))

; ---- calc ----------------------------------------------------------------

(= (pf:step $A $from $to $j)
   (if (unify $j (sym $k) True False)
       (unify $j (sym $k) (pf:sym $A $to $from (pf:step $A $to $from $k)) none)
       (if (unify $j (cong $A2 $F $a $b $p) True False)
           (unify $j (cong $A2 $F $a $b $p) (pf:cong $A2 $A $F $a $b $p) none)
           (if (unify $j (by $name) True False)
               (unify $j (by $name) (pf:by $name) none)
               (if (unify $j (by $name $p1) True False)
                   (unify $j (by $name $p1) (pf:by $name $p1) none)
                   (if (unify $j (by $name $p1 $p2) True False)
                       (unify $j (by $name $p1 $p2) (pf:by $name $p1 $p2) none)
                       $j))))))

; (pf:calc A t0 step ...) takes any number of steps; the expander hands the
; steps to pf:calc-from as one list.

; the first step, then a chain of transitivity steps
(= (pf:calc-from $A $t0 $steps)
   (let (= $t1 $j1) (car-atom $steps)
     (let $p1 (pf:step $A $t0 $t1 $j1)
       (let $rest (cdr-atom $steps)
         (pf:calc-chain $A $t0 $t1 $p1 $rest)))))

(= (pf:calc-chain $A $t0 $tk $pk $steps)
   (if (== $steps ()) $pk
       (let (= $tn $jn) (car-atom $steps)
         (let $pn (pf:step $A $tk $tn $jn)
           (let $pkn (pf:trans $A $t0 $tk $tn $pk $pn)
             (let $rest (cdr-atom $steps)
               (pf:calc-chain $A $t0 $tn $pkn $rest)){$rest}){$pkn}){$pn}){$tn $jn}))

; ---- induction -----------------------------------------------------------

; (pf:induction principle motive case ...) takes one case per constructor;
; the expander folds the cases onto the instantiated principle.
(= (pf:induction-from $proof $cases)
   (if (== $cases ()) $proof
       (let $c (car-atom $cases)
         (let $rest (cdr-atom $cases)
           (pf:induction-from (pf:imp-elim $proof $c) $rest)){$rest}){$c}))

; ---- what a theorem rests on ---------------------------------------------

; A native package cites an earlier theorem by name, as a declared constant
; whose type is the theorem's statement, and assumes the laws and axioms its
; own proof uses.  What a theorem rests on is what its package assumes,
; with what the theorems it cites rest on: each name once, in the order the
; proof first meets it.  The package of a law or an axiom assumes its own
; name.  Every package is asked of the space, so each is checked there; a
; theorem it reaches that has no package gives no answer.
(= (pf:rests-on $space $name)
   (let $todo (cons-atom $name ()) (pf:rests-on-walk $space $todo () ())))
(: pf:rests-on-walk (-> Atom (Data Atom) (Data Atom) (Data Atom) (Data Atom)))
(= (pf:rests-on-walk $space $todo $seen $found)
   (if (== $todo ()) $found
       (let $name (car-atom $todo)
         (let $rest (cdr-atom $todo)
           (if (pf:member $name $seen)
               (pf:rests-on-walk $space $rest $seen $found)
               (let (SetNativeProofV1 $n $p $proof $term $type $context $rules $rows $digest)
                    (set:native-proof $space $name)
                 (let $cited (map-atom $rows $row (car-atom $row))
                   (let $seen1 (cons-atom $name $seen)
                     (if (pf:member $name $cited)
                         (let $last (cons-atom $name ())
                           (let $found1 (pf:append $found $last)
                             (pf:rests-on-walk $space $rest $seen1 $found1)){$found1}){$last}
                         (let $todo1 (pf:append $cited $rest)
                           (pf:rests-on-walk $space $todo1 $seen1 $found)){$todo1})){$seen1}){$cited}){$n $p $proof $term $type $context $rules $rows $digest})){$rest}){$name}))
(: pf:append (-> (Data Atom) (Data Atom) (Data Atom)))
(= (pf:append $xs $ys)
   (if (== $xs ()) $ys
       (let $h (car-atom $xs)
         (let $t (cdr-atom $xs)
           (let $rest (pf:append $t $ys)
             (cons-atom $h $rest)){$rest}){$t}){$h}))
