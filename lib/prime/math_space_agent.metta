; JSON commands are data. Only the operations below dispatch to the workspace.
(scope:profile lexical-fresh per-call reference)
!(import! &self "./math_space_views.metta")
!(import! &self "./math_space_files.metta")
!(import! &self "./math_space_providers.metta")

(= (math:request-schema $command)
   (case $command
     (("create" (("name" id))) ("summary" ())
      ("view" (("section" text) ("cursor" code) ("rows" positive) ("characters" positive)))
      ("inspect" (("name" id) ("characters" positive)))
      ("read" (("section" text) ("key" id) ("characters" positive)))
      ("goal" (("goal" id) ("checker" checker) ("statement" code) ("description" text)))
      ("propose" (("candidate" id) ("goal" id) ("strategy" id) ("proof" code)))
      ("check" (("candidate" id) ("budget" natural)))
      ("publish" (("attempt" id) ("name" symbol) ("budget" natural)))
      ("status" (("goal" id) ("budget" natural)))
      ("retry" (("previous" id) ("attempt" id) ("budget" natural)))
      ("resume" (("previous" id) ("attempt" id) ("budget" natural)))
      ("declare" (("source" code))) ("run" (("expression" code)))
      ("note" (("note" id) ("text" text) ("source" text)))
      ("link" (("source" id) ("relation" id) ("target" id)))
      ("save" (("path" id) ("budget" natural)))
      ("load" (("path" id) ("budget" natural)))
      ("lean-replay" (("target" id) ("certificate" id) ("milliseconds" positive) ("bytes" positive)))
      ($other (Math:Refused unknown-command)))))
(= (math:request-field? $kind $value)
   (case $kind
     ((text (== (std:get-type $value) String))
      (code (math:text-id? $value)) (id (math:text-id? $value))
      (natural (math:natural? $value))
      (positive (and (math:natural? $value) (> $value 0)))
      (checker (or (== $value "type") (== $value "hol")))
      (symbol (if (math:text-id? $value)
                (let $name (parse $value) (== (get-metatype $name) Symbol)) False))
      ($other False))))
(= (math:request-fields? $object $schema)
   (case $schema
     ((() True)
      ($some
        (let (($key $kind) $rest) (decons-atom $some)
          (let $value (json:get $object $key)
            (if (math:request-field? $kind $value)
              (math:request-fields? $object $rest) False)))))))
(= (math:request-valid? $request $schema)
   (if (math:unique-json-object $request)
     (let (JsonObject $pairs) $request
       (and (== (size-atom $pairs) (+ (size-atom $schema) 2))
            (math:request-fields? $request
              (union-atom (("id" id) ("command" id)) $schema)))) False))
(= (math:request-code $request $key)
   (let* (($text (json:get $request $key)) ($value (parse $text))) (math:code $value)))
(= (math:receipt-observation $target $certificate $reply)
   (let* (($workspace (system:getenv-or-default "CETTA_MATH_WORKSPACE_ROOT" ""))
          ($prefix (if (str:ends-with $workspace "/") $workspace (str:concat $workspace "/")))
          ($label (if (and (not (== $workspace "")) (str:starts-with $certificate $prefix))
                    (str:char-slice $certificate (str:char-length $prefix) (str:char-length $certificate))
                    unscoped-artifact))
          ($pin-text (system:getenv-or-default "CETTA_MATH_LEAN_PIN" "{}")) ($pins (json:parse $pin-text)))
     (Math:ReceiptObservation "lean4" "core" $target $label $pins $reply)))
(= (math:request-op $project $request $command)
   (case $command
     (("summary" (math:summary $project))
      ("view"
        (let* (($section (json:get $request "section")) ($text (json:get $request "cursor"))
               ($cursor (parse $text)) ($rows (json:get $request "rows"))
               ($characters (json:get $request "characters")))
          (math:view $project $section $cursor $rows $characters)))
      ("inspect"
        (let* (($name-text (json:get $request "name")) ($name (str:string->symbol $name-text))
               ($characters (json:get $request "characters")) ($data (math:inspect $project $name)))
          (math:render $data $characters)))
      ("read"
        (let* (($section (json:get $request "section")) ($key (json:get $request "key"))
               ($characters (json:get $request "characters")))
          (math:read-entry $project $section $key $characters)))
      ("goal"
        (let* (($goal (json:get $request "goal")) ($kind-text (json:get $request "checker"))
               ($kind (str:string->symbol $kind-text)) ($statement (math:request-code $request "statement"))
               ($description (json:get $request "description")))
          (math:goal $project $goal $kind $statement $description)))
      ("propose"
        (let* (($id (json:get $request "candidate")) ($goal (json:get $request "goal"))
               ($strategy (json:get $request "strategy")) ($proof (math:request-code $request "proof")))
          (math:propose $project $id $goal $strategy $proof)))
      ("check"
        (let* (($id (json:get $request "candidate")) ($budget (json:get $request "budget")))
          (math:check $project $id $budget)))
      ("publish"
        (let* (($id (json:get $request "attempt")) ($text (json:get $request "name"))
               ($name (parse $text)) ($budget (json:get $request "budget")))
          (math:publish $project $id $name $budget)))
      ("status"
        (let* (($goal (json:get $request "goal")) ($budget (json:get $request "budget")))
          (math:goal-status $project $goal $budget)))
      ("retry"
        (let* (($previous (json:get $request "previous")) ($next (json:get $request "attempt"))
               ($budget (json:get $request "budget"))) (math:retry $project $previous $next $budget)))
      ("resume"
        (let* (($previous (json:get $request "previous")) ($next (json:get $request "attempt"))
               ($budget (json:get $request "budget"))) (math:resume-attempt $project $previous $next $budget)))
      ("declare" (let $source (math:request-code $request "source") (math:declare $project $source)))
      ("run" (let $expression (math:request-code $request "expression") (math:run $project $expression)))
      ("note"
        (let* (($id (json:get $request "note")) ($text (json:get $request "text"))
               ($source (json:get $request "source"))) (math:note $project $id $text ($source))))
      ("link"
        (let* (($source (json:get $request "source")) ($relation (json:get $request "relation"))
               ($target (json:get $request "target"))) (math:link $project $source $relation $target)))
      ("save"
        (let* (($path (json:get $request "path")) ($budget (json:get $request "budget")))
          (math:save $project $path $budget)))
      ("lean-replay"
        (let* (($root (system:getenv-or-default "CETTA_MATH_LEAN_ROOT" ""))
               ($target (json:get $request "target")) ($certificate (json:get $request "certificate"))
               ($milliseconds (json:get $request "milliseconds")) ($bytes (json:get $request "bytes")))
          (if (== $root "") (Math:ProviderUnavailable lean-receipt-not-configured)
            (let $config (str:concat $root "/.cetta/lean-native/sysroot.txt")
              (case (fs:read-text-result $config 0 raw)
                ((("ok" $text)
                   (let* (($sysroot (str:trim $text))
                          ($guard (str:concat $root "/.cetta/lean-native/itp-guard"))
                          ($library (str:concat $root "/.cetta/lean-native/lib"))
                          ($backend (Math:LeanBackend $guard $library $sysroot "core"))
                          ($reply (math:lean-replay $backend $target $certificate $milliseconds $bytes))
                          ($request-id (json:get $request "id"))
                          ($note-id (str:concat "lean-receipt:" $request-id))
                          ($observation (math:receipt-observation $target $certificate $reply)))
                     (chain (math:remember-provider $project $note-id "lean4/core-receipt" $observation) $recorded $reply)))
                 ($other (Math:ProviderUnavailable lean-receipt-configuration))))))))
      ($other (Math:Refused unknown-command)))))
(= (math:request-execute $cell $request $command)
   (case $command
     (("create"
        (let* (($name (json:get $request "name")) ($project (math:new $name)))
          (chain (change-state! $cell $project) $changed (Math:WorkspaceCreated $name))))
      ("load"
        (let* (($path (json:get $request "path")) ($budget (json:get $request "budget")))
          (case (math:load $path $budget)
            (((Math:Loaded $project $revision)
               (chain (change-state! $cell $project) $changed (Math:WorkspaceLoaded $revision)))
             ($other $other)))))
      ($other (let $project (get-state $cell) (math:request-op $project $request $command))))))
(= (math:request $cell $request)
   (if (math:unique-json-object $request)
    (let* (($command (json:get $request "command")) ($schema (math:request-schema $command)))
     (case $schema
       (((Math:Refused $reason) $schema)
        ($fields
          (if (math:request-valid? $request $fields)
            (math:request-execute $cell $request $command)
            (Math:Refused request-schema))))))
    (Math:Refused request-json)))
(= (math:reply-state $reply)
   (case $reply
     (((Math:Attempt $id $goal $strategy $key $proof checked $raw) "checked")
      ((Math:Attempt $id $goal $strategy $key $proof (rejected $reason) $raw) "rejected-evidence")
      ((Math:Attempt $id $goal $strategy $key $proof (unfinished $reason) $raw) "unfinished")
      ((Math:Attempt $id $goal $strategy $key $proof (fault $reason) $raw) "fault")
      ((Math:Published $name $attempt) "published")
      ((Math:GoalStatus $goal checked $evidence) "checked")
      ((Math:GoalStatus $goal open $reason) "open")
      ((Math:Proposed $id $goal) "candidate")
      ((Math:Residual $code) "residual")
      ((Math:ActionNotEstablished $name) "not-admitted")
      ((Math:ForeignReceipt $backend $profile $target $reply) "checked-foreign")
      ((Math:ForeignRejected $backend $target $reason) "rejected-foreign-evidence")
      ((Math:ForeignProposal $backend $operation $request $reply) "candidate-foreign")
      ((Math:ProviderUnavailable $reason) "unavailable")
      ((Math:ProviderUnavailable $reason $details) "unavailable")
      ((Math:ProviderUnfinished $reason) "unfinished")
      ((Math:ProviderFault $reason) "fault")
      ((Math:Missing $kind $id) "missing")
      ((Math:Saved $path $digest) "saved")
      ((Math:WorkspaceLoaded $revision) "loaded")
      ((Math:Refused $reason) "refused")
      ((Math:Refused $reason $detail) "refused")
      ((Math:Stale $id $reason) "stale")
      ((Math:Conflict $kind $id) "conflict")
      ((Math:StoreConflict $path $expected $actual) "conflict")
      ((Math:RestoreFailed $reason) "restore-failed")
      ((Math:RestoreFailed $reason $details) "restore-failed")
      ((Math:RestoreFailed $reason $subject $details) "restore-failed")
      ((Math:PublicationFailed $name $details) "publication-failed")
      ((Math:StoreFailed $reason) "store-failed")
      ((Math:StoreFailed $reason $details) "store-failed")
      ((Math:StoreUncertain $stage $details $outcome) "uncertain")
      ($other "data"))))
(= (math:wire-id $request)
   (case $request
     (((JsonObject $pairs)
        (let $id (json:get $request "id")
          (if (== (std:get-type $id) String) $id "")))
      ($other ""))))
(= (math:response $request $reply $characters)
   (let* (($id (math:wire-id $request))
          ($state (math:reply-state $reply))
          ($view (math:render $reply $characters)))
     (case $view
       (((Math:Text $digest $length $coverage $text)
          (let $coverage-text (repr $coverage)
            (JsonObject ((JsonPair "schema" "prime.math-space.reply.v1")
              (JsonPair "id" $id) (JsonPair "state" $state)
              (JsonPair "result" $text) (JsonPair "sha256" $digest)
              (JsonPair "characters" $length) (JsonPair "coverage" $coverage-text)))))))))
(= (math:serve-line $cell $line $characters)
   (let* (($request (json:parse $line)) ($reply (math:request $cell $request))
          ($response (math:response $request $reply $characters)) ($wire (json:stringify $response)))
     (system:write stdout (str:concat $wire "\n"))))
(= (math:serve $cell $characters)
   (chain (system:read-line) $line
     (case $line
       ((end_of_file ())
        ($text
          (if (== (std:get-type $text) String)
            (chain (math:serve-line $cell $text $characters) $sent (math:serve $cell $characters))
            (Math:ServiceStopped input-unavailable)))))))
