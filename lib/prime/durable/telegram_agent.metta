                  ($bad (tg-agent:uncertain invalid-api-error)))){$n $bad})
              ($bad (tg-agent:uncertain invalid-api-error)))){$code $bad})
          ($bad (tg-agent:uncertain invalid-api-result)))){$bad})
      ($bad (tg-agent:uncertain malformed-api-result)))){$bad})
(= (tg-agent:message-result $object $chat)
   (case ((telegram:field $object "message_id") (telegram:field $object "chat"))
     ((((tg:some $number) (tg:some $target))
       (case ((telegram:integer $number) (telegram:field $target "id"))
