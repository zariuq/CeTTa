             (case $result
               (((tg-agent:delivered $id) (if (== (+ $position 1) $count) (tg-agent:idle) (tg-agent:sending $batch (+ $position 1) $count)))
                ($other (tg-agent:held $batch $position $count $result)))){$id $other}
             ((host:put 2 $outkey (tg-agent:delivery 1 $batch $position $result))) ())){$result})
        ($other Empty))){$batch $position $count $other}))))
