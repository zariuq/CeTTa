; Generated by tools/prime_scope_migration.py from lib/lib_random_closure.metta; do not edit.
(scope:profile lexical-fresh per-call reference)

; ============================================================================
; RANDOM CLOSURE RESPONSES LIBRARY FOR CETTA (--lang petta)
; ============================================================================
;
; Reusable MeTTa implementation of modular positive-Horn closure responses,
; commonality factorization, shared-choice conditioning, unnormalized evidence
; propagation, persistent binary product and slot trees with cached routing
; bounds, local component scenario replacement, and certified IEEE-754 Higham
; enclosure readout with automatic exact BigInt rational fallback.
;
; Complexity contract (for N components, fixed interface width & choice arity):
;   - rc:query (f64 fast path)             : O(1) in N (root tensor readout)
;   - rc:engine-update (d changed, f64)    : O(d log N) via SlotTree + ProductTree
;   - rc:engine-replace-component          : O(N) global peer-disjointness check
;                                            + O(1) single-component compile
;                                            + O(log N) SlotTree & ProductTree update
;   - First exact rational fallback        : O(N) lazy exact ProductTree build,
;                                            then O(d_dirty log N) incremental refresh
;
; Numerical contract:
;   - Nonzero leaf inputs & world weights are gated to [1e-290, 1e150] (zero
;     subnormal leaf underflow); each ProductTree node composes Higham Ch. 3
;     rounding-step counts (steps_L + steps_R + 1) and subtree upper bounds
;     (U_i >= 1.0) across the full product, shared-cause mixture, and signed
;     query extraction, rounding every interval endpoint outward.
;   - Any interval wider than 1e-12 (or relative width > 1e-10, near-zero,
;     out-of-range, or high-cancellation) automatically falls back to exact
;     BigInt rationals and returns both the exact Rat and a certified outward
;     IEEE-754 interval enclosure.
;
; Semantic & numerical reference:
;   - Mettapedia/Logic/RandomClosure.lean
;   - Mettapedia/Logic/RandomClosure/CertifiedExecution.lean
;   - Mettapedia/Logic/BDD/ClosureResponseCounting.lean
;   - Mettapedia/papers/RandomClosureResponses.tex
; ============================================================================

!(import! &self (library tensor))
!(import! &self (library list))
!(import! &self (library binary))

; ----------------------------------------------------------------------------
; 1. Exact Integer, Bitmask, Rational (BigInt) & Outward IEEE-754 Helpers
; ----------------------------------------------------------------------------

(= (rc:is-symbol $x)
   (== (get-metatype $x) Symbol))

(= (rc:is-expr $x)
   (== (get-metatype $x) Expression))

(= (rc:is-int $x)
   (if (== (get-metatype $x) Grounded)
       (if (== (get-type $x) Number)
           (!= (binary:portable-kind $x) Float)
           false)
       false))

(= (rc:int-abs $x)
   (if (< $x 0) (- 0 $x) $x))

(= (rc:max-int $a $b)
   (if (>= $a $b) $a $b))

(= (rc:int-div $a $b)
   (/ (- $a (% $a $b)) $b))

(= (rc:gcd $a $b)
   (if (== $b 0) $a (rc:gcd $b (% $a $b))))

(= (rc:pow2 $k)
   (if (<= $k 0) 1 (* 2 (rc:pow2 (- $k 1)))))

(= (rc:pow10 $k)
   (if (<= $k 0) 1 (* 10 (rc:pow10 (- $k 1)))))

(= (rc:ceil-log2 $n)
   (rc:ceil-log2-loop $n 1 0))

(= (rc:ceil-log2-loop $n $cap $acc)
   (if (>= $cap $n) $acc (rc:ceil-log2-loop $n (* 2 $cap) (+ $acc 1))))

(= (rc:bit-div2 $n)
   (/ (- $n (% $n 2)) 2))

(= (rc:bit-test $mask $i)
   (if (<= $mask 0) false
     (if (== $i 0)
         (== (% $mask 2) 1)
         (rc:bit-test (rc:bit-div2 $mask) (- $i 1)))))

(= (rc:bit-and $a $b)
   (if (or (== $a 0) (== $b 0)) 0
     (+ (if (and (== (% $a 2) 1) (== (% $b 2) 1)) 1 0)
        (* 2 (rc:bit-and (rc:bit-div2 $a) (rc:bit-div2 $b))))))

(= (rc:bit-or $a $b)
   (if (== $a 0) $b
     (if (== $b 0) $a
       (+ (if (or (== (% $a 2) 1) (== (% $b 2) 1)) 1 0)
          (* 2 (rc:bit-or (rc:bit-div2 $a) (rc:bit-div2 $b)))))))

(= (rc:bit-popcount $mask)
   (if (<= $mask 0) 0
     (+ (% $mask 2) (rc:bit-popcount (rc:bit-div2 $mask)))))

(= (rc:f64-max $a $b) (if (>= $a $b) $a $b))
(= (rc:f64-min $a $b) (if (<= $a $b) $a $b))
(= (rc:f64-abs $x)    (if (< $x 0.0) (- 0.0 $x) $x))

; Outward IEEE-754 binary64 rounding helpers for a single rounded result $s = fl(val)
; with |val| <= 1e150. The 8*u multiplicative pad + 1e-305 normal floor strictly
; dominates both 1 binary64 ULP and shortest-decimal print/parse roundtrip slack.
(= (rc:f64-round-down $s)
   (let* (($u  1.1102230246251565e-16)
          ($dn (- 1.0 (* 8.0 $u)))
          ($up (+ 1.0 (* 8.0 $u))))
     (- (if (>= $s 0.0) (* $s $dn) (* $s $up)) 1.0e-305)))

(= (rc:f64-round-up $s)
   (let* (($u  1.1102230246251565e-16)
          ($dn (- 1.0 (* 8.0 $u)))
          ($up (+ 1.0 (* 8.0 $u))))
     (+ (if (>= $s 0.0) (* $s $up) (* $s $dn)) 1.0e-305)))

; Canonical reduced rational constructor: (Rat num den) with den > 0.
(= (rc:rat $n $d)
   (if (or (not (rc:is-int $n)) (not (rc:is-int $d)))
       (RC:Unsupported invalid-rational-components ($n $d))
       (if (== $d 0)
           (RC:Unsupported zero-denominator ($n $d))
           (let* (($sn (if (< $d 0) (- 0 $n) $n))
                  ($sd (if (< $d 0) (- 0 $d) $d))
                  ($g  (rc:gcd (rc:int-abs $sn) $sd)))
             (Rat (/ $sn $g) (/ $sd $g))){$sn $sd $g})))

(= (rc:rat-valid? $r)
   (case $r
     (((Rat $n $d)
       (if (and (rc:is-int $n) (rc:is-int $d)) (> $d 0) false))
      ($other false))))

(= (rc:rat-prob-valid? $r)
   (case $r
     (((Rat $n $d)
       (if (and (rc:is-int $n) (rc:is-int $d))
           (and (> $d 0) (and (>= $n 0) (<= $n $d)))
           false))
      ($other false))))

(= (rc:rat-nonneg-valid? $r)
   (case $r
     (((Rat $n $d)
       (if (and (rc:is-int $n) (rc:is-int $d))
           (and (> $d 0) (>= $n 0))
           false))
      ($other false))))

(= (rc:rat-zero) (Rat 0 1))
(= (rc:rat-one)  (Rat 1 1))

(= (rc:rat-add (Rat $n1 $d1) (Rat $n2 $d2))
   (rc:rat (+ (* $n1 $d2) (* $n2 $d1)) (* $d1 $d2)))

(= (rc:rat-sub (Rat $n1 $d1) (Rat $n2 $d2))
   (rc:rat (- (* $n1 $d2) (* $n2 $d1)) (* $d1 $d2)))

(= (rc:rat-mul (Rat $n1 $d1) (Rat $n2 $d2))
   (if (or (== $n1 0) (== $n2 0))
       (Rat 0 1)
       (let* (($g1 (rc:gcd (rc:int-abs $n1) $d2))
              ($g2 (rc:gcd (rc:int-abs $n2) $d1)))
         (Rat (* (/ $n1 $g1) (/ $n2 $g2))
              (* (/ $d1 $g2) (/ $d2 $g1)))){$g1 $g2}))

(= (rc:rat-div (Rat $n1 $d1) (Rat $n2 $d2))
   (rc:rat (* $n1 $d2) (* $d1 $n2)))

(= (rc:rat-abs (Rat $n $d))
   (Rat (rc:int-abs $n) $d))

; Safe rational-to-f64 leaf conversion:
;   - 0 maps to exact 0.0;
;   - nonzero values require |n|, d <= 10^150 and |fl(n/d)| in [1e-290, 1e150]
;     so every leaf conversion is strictly normal (zero subnormal underflow)
;     with at most 3 IEEE-754 rounding steps.
(= (rc:max-f64-bigint) (rc:pow10 150))

(= (rc:rat->f64-checked (Rat $n $d))
   (if (== $n 0)
       (RC:F64Ok 0.0)
       (let $lim (rc:max-f64-bigint)
         (if (or (> (rc:int-abs $n) $lim) (> $d $lim))
             RC:F64OutOfRange
             (let* (($fv (/ (+ 0.0 $n) (+ 0.0 $d)))
                    ($av (rc:f64-abs $fv)))
               (if (or (isnan-math $fv)
                       (or (isinf-math $fv)
                           (or (< $av 1.0e-290) (> $av 1.0e150))))
                   RC:F64OutOfRange
                   (RC:F64Ok $fv))){$fv $av})){$lim}))

; ----------------------------------------------------------------------------
; 2. Sequence & Set Utilities
; ----------------------------------------------------------------------------

(= (rc:range $lo $hi)
   (if (>= $lo $hi) ()
     (cons-atom $lo (rc:range (+ $lo 1) $hi))))

(= (rc:member? $item $xs)
   (if (== (size-atom $xs) 0) false
     (if (== $item (car-atom $xs)) true
       (rc:member? $item (cdr-atom $xs)))))

(= (rc:index-of $item $xs)
   (rc:index-of-loop $item $xs 0))

(= (rc:index-of-loop $item $xs $idx)
   (if (== (size-atom $xs) 0) -1
     (if (== $item (car-atom $xs)) $idx
       (rc:index-of-loop $item (cdr-atom $xs) (+ $idx 1)))))

(= (rc:all-symbols? $xs)
   (if (not (rc:is-expr $xs)) false
     (foldl-atom $xs true $ok $x (and $ok (rc:is-symbol $x)))))

(= (rc:has-duplicates? $xs)
   (!= (size-atom (unique-atom $xs)) (size-atom $xs)))

(= (rc:intersects? $xs $ys)
   (foldl-atom $xs false $hit $x (or $hit (rc:member? $x $ys))))

(= (rc:replace-at $xs $idx $new-val)
   (rc:replace-at-loop $xs $idx $new-val 0))

(= (rc:replace-at-loop $xs $idx $new-val $cur)
   (if (== (size-atom $xs) 0) ()
     (let* (($h (car-atom $xs))
            ($t (cdr-atom $xs))
            ($head2 (if (== $cur $idx) $new-val $h))
            ($rest2 (rc:replace-at-loop $t $idx $new-val (+ $cur 1))))
       (cons-atom $head2 $rest2)){$h $t $head2 $rest2}))

; Ascending unique integer insertion & sort
(= (rc:insert-unique-int $x $sorted)
   (if (== (size-atom $sorted) 0) ($x)
     (let ($h $t) (decons-atom $sorted)
       (if (== $x $h) $sorted
         (if (< $x $h)
             (cons-atom $x $sorted)
             (let $rest (rc:insert-unique-int $x $t)
               (cons-atom $h $rest)){$rest}))){$h $t}))

(= (rc:sort-unique-ints $xs)
   (foldl-atom $xs () $acc $x (rc:insert-unique-int $x $acc)))

; Sort ((idx val) ...) pairs by ascending idx (last occurrence wins on duplicate idx)
(= (rc:insert-indexed-pair ($idx $val) $sorted)
   (if (== (size-atom $sorted) 0) (($idx $val))
     (let* (($first (car-atom $sorted))
            ($tail  (cdr-atom $sorted))
            (($fidx $fval) $first))
       (if (== $idx $fidx)
           (cons-atom ($idx $val) $tail)
           (if (< $idx $fidx)
               (cons-atom ($idx $val) $sorted)
               (let $rest (rc:insert-indexed-pair ($idx $val) $tail)
                 (cons-atom $first $rest)){$rest}))){$first $tail $fidx $fval}))

(= (rc:sort-indexed-pairs $pairs)
   (foldl-atom $pairs () $acc $p (rc:insert-indexed-pair $p $acc)))

(= (rc:unsupported? $x)
   (if (rc:is-expr $x)
       (if (> (size-atom $x) 0)
           (== (car-atom $x) RC:Unsupported)
           false)
       false))

; ----------------------------------------------------------------------------
; 3. Source Program Positivity & Scope Validation
; ----------------------------------------------------------------------------

(= (rc:validate-rule $comp-name $scope $choice-names $rule)
   (case $rule
     (((RC:Rule $head $body)
       (if (not (rc:is-symbol $head))
           (RC:Unsupported non-positive-or-non-symbol-head ($comp-name $rule))
           (if (not (rc:is-expr $body))
               (RC:Unsupported malformed-rule-body ($comp-name $rule))
               (if (not (rc:all-symbols? $body))
                   (RC:Unsupported non-positive-or-compound-literal ($comp-name $rule))
                   (if (not (rc:member? $head $scope))
                       (RC:Unsupported rule-derives-outside-scope ($comp-name $head))
                       (if (rc:member? $head $choice-names)
                           (RC:Unsupported base-choice-derived-by-rule ($comp-name $head))
                           (rc:validate-rule-body-scope $comp-name $scope $body)))))))
      ($other (RC:Unsupported malformed-rule ($comp-name $other))))))

(= (rc:validate-rule-body-scope $comp-name $scope $body)
   (if (== (size-atom $body) 0) RC:Valid
     (let ($lit $rest) (decons-atom $body)
       (if (not (rc:member? $lit $scope))
           (RC:Unsupported rule-reads-outside-scope ($comp-name $lit))
           (rc:validate-rule-body-scope $comp-name $scope $rest))){$lit $rest}))

(= (rc:validate-rules $comp-name $scope $choice-names $rules)
   (if (not (rc:is-expr $rules))
       (RC:Unsupported malformed-rules-list $comp-name)
       (rc:validate-rules-loop $comp-name $scope $choice-names $rules)))

(= (rc:validate-rules-loop $comp-name $scope $choice-names $rules)
   (if (== (size-atom $rules) 0) RC:Valid
     (let ($r $rest) (decons-atom $rules)
       (let $chk (rc:validate-rule $comp-name $scope $choice-names $r)
         (if (rc:unsupported? $chk) $chk
           (rc:validate-rules-loop $comp-name $scope $choice-names $rest))){$chk}){$r $rest}))

(= (rc:validate-components-loop $common $shared $comps $seen-names $owned-atoms)
   (if (== (size-atom $comps) 0) RC:Valid
     (let ($comp $rest) (decons-atom $comps)
       (case $comp
         (((RC:Component $name $choices $private $rules)
           (if (not (rc:is-symbol $name))
               (RC:Unsupported invalid-component-name $name)
               (if (rc:member? $name $seen-names)
                   (RC:Unsupported duplicate-component-identity $name)
                   (if (or (not (rc:all-symbols? $choices)) (not (rc:all-symbols? $private)))
                       (RC:Unsupported non-symbol-local-declaration $name)
                       (let $local (union-atom $choices $private)
                         (if (or (rc:has-duplicates? $local) (rc:intersects? $local $owned-atoms))
                             (RC:Unsupported shared-or-private-ownership-violation $name)
                             (let* (($scope (union-atom $common $local))
                                    ($all-choices (union-atom $choices $shared))
                                    ($rchk (rc:validate-rules $name $scope $all-choices $rules)))
                               (if (rc:unsupported? $rchk) $rchk
                                 (rc:validate-components-loop
                                   $common $shared $rest
                                   (cons-atom $name $seen-names)
                                   (union-atom $owned-atoms $local)))){$scope $all-choices $rchk})){$local}))))
          ($other (RC:Unsupported malformed-component $other)))){$name $choices $private $rules $other}){$comp $rest}))

(= (rc:validate-program $program)
   (case $program
     (((RC:Program $boundary $shared $components)
       (if (or (not (rc:all-symbols? $boundary)) (not (rc:all-symbols? $shared)))
           (RC:Unsupported non-symbol-interface-or-shared ($boundary $shared))
           (if (== (size-atom $boundary) 0)
               (RC:Unsupported empty-interface $boundary)
               (if (or (not (rc:is-expr $components)) (== (size-atom $components) 0))
                   (RC:Unsupported empty-components $components)
                   (let $common (union-atom $boundary $shared)
                     (if (rc:has-duplicates? $common)
                         (RC:Unsupported duplicate-interface-or-shared ($boundary $shared))
                         (rc:validate-components-loop $common $shared $components () $common))){$common}))))
      ($other (RC:Unsupported malformed-program $other)))))

; ----------------------------------------------------------------------------
; 4. Least Fixed-Point Closure, Intersection Hulls & Query Preparation
; ----------------------------------------------------------------------------

(= (rc:close-pass $compiled-rules $current)
   (foldl-atom $compiled-rules $current $acc $rule
     (let ($body-mask $head-bit) $rule
       (if (== (rc:bit-and $body-mask $acc) $body-mask)
           (rc:bit-or $acc $head-bit)
           $acc))))

(= (rc:close-rules $compiled-rules $current)
   (let $next (rc:close-pass $compiled-rules $current)
     (if (== $next $current) $current
       (rc:close-rules $compiled-rules $next))))

(= (rc:family-members $family $n-subsets)
   (foldl-atom (rc:range 0 $n-subsets) () $acc $i
     (if (rc:bit-test $family $i) (cons-atom $i $acc) $acc)))

(= (rc:pairwise-ands $members)
   (foldl-atom $members () $acc $a
     (foldl-atom $members $acc $acc2 $b
       (rc:insert-unique-int (rc:bit-and $a $b) $acc2))))

(= (rc:hull-fixpoint $members)
   (let $next (rc:sort-unique-ints (union-atom $members (rc:pairwise-ands $members)))
     (if (== (size-atom $next) (size-atom $members))
         $members
         (rc:hull-fixpoint $next))))

(= (rc:intersection-hull $family $width)
   (let* (($n-subsets (rc:pow2 $width))
          ($top (- $n-subsets 1))
          ($initial (rc:sort-unique-ints (cons-atom $top (rc:family-members $family $n-subsets))))
          ($closed (rc:hull-fixpoint $initial)))
     (foldl-atom $closed 0 $mask $m (+ $mask (rc:pow2 $m)))))

(= (rc:avoiding-subsets $width $seed-mask $query-idx)
   (let $n-subsets (rc:pow2 $width)
     (filter-atom (rc:range 0 $n-subsets) $t
       (and (== (rc:bit-and $seed-mask $t) $seed-mask)
            (not (rc:bit-test $t $query-idx))))))

(= (rc:selected-family $avoiding $selected)
   (let $n (size-atom $avoiding)
     (foldl-atom (rc:range 0 $n) 0 $fam $j
       (if (rc:bit-test $selected $j)
           (+ $fam (rc:pow2 (index-atom $avoiding $j)))
           $fam))))

(= (rc:query-coefficients $width $seed-mask $query-idx)
   (let* (($avoiding (rc:avoiding-subsets $width $seed-mask $query-idx))
          ($n-sel (rc:pow2 (size-atom $avoiding)))
          ($raw-pairs
            (map-atom (rc:range 0 $n-sel) $sel
              (let* (($fam  (rc:selected-family $avoiding $sel))
                     ($hull (rc:intersection-hull $fam $width))
                     ($sign (if (== (% (rc:bit-popcount $sel) 2) 1) -1 1)))
                ($hull $sign))))
          ($grouped (list:group-sums-number $raw-pairs)))
     (filter-atom $grouped $pair (!= (index-atom $pair 1) 0))))

(= (rc:atoms->seed-mask $boundary $seed-atoms)
   (if (not (rc:is-expr $seed-atoms))
       (RC:Unsupported invalid-query-seed $seed-atoms)
       (rc:atoms->seed-mask-loop $boundary (unique-atom $seed-atoms) 0)))

(= (rc:atoms->seed-mask-loop $boundary $atoms $acc)
   (if (== (size-atom $atoms) 0) $acc
     (let ($a $rest) (decons-atom $atoms)
       (let $idx (rc:index-of $a $boundary)
         (if (< $idx 0)
             (RC:Unsupported query-outside-interface $a)
             (rc:atoms->seed-mask-loop $boundary $rest (+ $acc (rc:pow2 $idx))))){$idx}){$a $rest}))

(= (rc:parse-query $boundary $query)
   (case $query
     (((RC:Query $seed-atoms $target-atom)
       (let $smask (rc:atoms->seed-mask $boundary $seed-atoms)
         (if (rc:unsupported? $smask) $smask
           (let $tidx (rc:index-of $target-atom $boundary)
             (if (< $tidx 0)
                 (RC:Unsupported query-outside-interface $target-atom)
                 (RC:QueryKey $smask $tidx))){$tidx})){$smask})
      ($other (RC:Unsupported malformed-query $other)))))

(= (rc:compile-component-rules $atoms $rules)
   (map-atom $rules $rule
     (let (RC:Rule $head $body) $rule
       (let* (($uniq-body (unique-atom $body))
              ($bmask (foldl-atom $uniq-body 0 $m $a (+ $m (rc:pow2 (rc:index-of $a $atoms)))))
              ($hbit  (rc:pow2 (rc:index-of $head $atoms))))
         ($bmask $hbit)))))

; Evaluates isolated local probe truth table (seed = empty) across (h, world)
; for a private atom of a component: returns tuple over h of tuples over world of bool.
(= (rc:component-isolated-probe-table $boundary $shared $comp $private-atom)
   (let (RC:Component $name $choices $private $rules) $comp
     (if (not (rc:member? $private-atom $private))
         (RC:Unsupported probe-atom-not-private ($name $private-atom))
         (let* (($width (size-atom $boundary))
                ($n-choices (size-atom $choices))
                ($n-shared (size-atom $shared))
                ($atoms (union-atom (union-atom (union-atom $boundary $choices) $shared) $private))
                ($target-idx (rc:index-of $private-atom $atoms))
                ($compiled-rules (rc:compile-component-rules $atoms $rules))
                ($w-shift (rc:pow2 $width))
                ($h-shift (rc:pow2 (+ $width $n-choices))))
           (map-atom (rc:range 0 (rc:pow2 $n-shared)) $h
             (map-atom (rc:range 0 (rc:pow2 $n-choices)) $world
               (let $closed (rc:close-rules $compiled-rules (+ (* $world $w-shift) (* $h $h-shift)))
                 (rc:bit-test $closed $target-idx))))){$width $n-choices $n-shared $atoms $target-idx $compiled-rules $w-shift $h-shift})))

(= (rc:response-profiles $width $n-choices $n-shared $compiled-rules)
   (let* (($n-shared-worlds (rc:pow2 $n-shared))
          ($n-choice-worlds (rc:pow2 $n-choices))
          ($n-seeds         (rc:pow2 $width))
          ($boundary-mask   (- $n-seeds 1))
          ($w-shift         (rc:pow2 $width))
          ($h-shift         (rc:pow2 (+ $width $n-choices))))
     (map-atom (rc:range 0 $n-shared-worlds) $h
       (map-atom (rc:range 0 $n-choice-worlds) $world
         (let $base (+ (* $world $w-shift) (* $h $h-shift))
           (foldl-atom (rc:range 0 $n-seeds) 0 $fixed $seed
             (let $closed-b (rc:bit-and (rc:close-rules $compiled-rules (+ $base $seed)) $boundary-mask)
               (if (== $closed-b $seed)
                   (+ $fixed (rc:pow2 $seed))
                   $fixed))))))))

; Builds exact acceptance world-index lists and dense f64 (columns x 2^choices) matrix.
(= (rc:build-acceptance $profiles $families $n-choice-worlds)
   (let* (($exact-rows
            (foldl-atom $profiles () $acc-h $profile
              (let $rows-h
                (map-atom $families $fam
                  (foldl-atom (rc:range 0 $n-choice-worlds) () $acc-w $w
                    (let $fixed (index-atom $profile $w)
                      (if (== (rc:bit-and $fam $fixed) $fam)
                          (union-atom $acc-w ($w))
                          $acc-w))))
                (union-atom $acc-h $rows-h))))
          ($columns (size-atom $exact-rows))
          ($flat-f64
            (foldl-atom $profiles () $facc-h $profile
              (foldl-atom $families $facc-h $facc-f $fam
                (let $row-vals
                  (map-atom (rc:range 0 $n-choice-worlds) $w
                    (let $fixed (index-atom $profile $w)
                      (if (== (rc:bit-and $fam $fixed) $fam) 1.0 0.0)))
                  (union-atom $facc-f $row-vals)))))
          ($f64-mat (tensor:from-values f64 ($columns $n-choice-worlds) $flat-f64)))
     (RC:AcceptanceData $exact-rows $f64-mat)))

(= (rc:cache-lookup $key $cache)
   (if (== (size-atom $cache) 0) RC:CacheMiss
     (let* (($entry (car-atom $cache))
            (($ekey $eval) $entry))
       (if (== $key $ekey) (RC:CacheHit $eval)
         (rc:cache-lookup $key (cdr-atom $cache)))){$entry $ekey $eval}))

(= (rc:compile-single-component $boundary $shared $families $comp $cache)
   (let (RC:Component $name $choices $private $rules) $comp
     (let* (($width (size-atom $boundary))
            ($n-choices (size-atom $choices))
            ($n-shared (size-atom $shared))
            ($atoms (union-atom (union-atom (union-atom $boundary $choices) $shared) $private))
            ($compiled-rules (rc:compile-component-rules $atoms $rules))
            ($pkey (RC:ProfileKey $width $n-choices $n-shared (size-atom $atoms) $compiled-rules)))
       (case (rc:cache-lookup $pkey $cache)
         (((RC:CacheHit ($profiles $exact-rows $f64-mat))
           (RC:CompileStep
             (RC:CompiledComponent $name $n-choices $profiles $f64-mat $exact-rows)
             $cache))
          (RC:CacheMiss
           (let* (($profiles (rc:response-profiles $width $n-choices $n-shared $compiled-rules))
                  ((RC:AcceptanceData $exact-rows $f64-mat)
                   (rc:build-acceptance $profiles $families (rc:pow2 $n-choices)))
                  ($entry ($pkey ($profiles $exact-rows $f64-mat))))
             (RC:CompileStep
               (RC:CompiledComponent $name $n-choices $profiles $f64-mat $exact-rows)
               (cons-atom $entry $cache))){$profiles $exact-rows $f64-mat $entry}))){$profiles $exact-rows $f64-mat})))

(= (rc:compile-components-cached $boundary $shared $families $comps $cache $acc)
   (if (== (size-atom $comps) 0) $acc
     (let ($c $rest) (decons-atom $comps)
       (let (RC:CompileStep $compiled $cache2)
            (rc:compile-single-component $boundary $shared $families $c $cache)
         (rc:compile-components-cached
           $boundary $shared $families $rest $cache2 (union-atom $acc ($compiled)))){$compiled $cache2}){$c $rest}))

(= (rc:build-prepared-query $families $qkey $coeff-pairs)
   (let* (($n-fam (size-atom $families))
          ($indexed
            (map-atom $coeff-pairs $pair
              (let ($hull $c) $pair
                ((rc:index-of $hull $families) $c))))
          ($coeff-l1
            (foldl-atom $indexed 0 $s $pair
              (let ($idx $c) $pair (+ $s (rc:int-abs $c)))))
          ($dense-signed
            (map-atom (rc:range 0 $n-fam) $i
              (rc:lookup-coeff-f64 $i $indexed false)))
          ($dense-abs
            (map-atom (rc:range 0 $n-fam) $i
              (rc:lookup-coeff-f64 $i $indexed true)))
          ($extract-mat
            (tensor:from-values f64 (2 $n-fam) (union-atom $dense-signed $dense-abs))))
     (RC:PreparedQuery $qkey $indexed $extract-mat $coeff-l1)))

(= (rc:lookup-coeff-f64 $idx $indexed $take-abs)
   (if (== (size-atom $indexed) 0) 0.0
     (let* (($first (car-atom $indexed))
            (($i $c) $first))
       (if (== $idx $i)
           (+ 0.0 (if $take-abs (rc:int-abs $c) $c))
           (rc:lookup-coeff-f64 $idx (cdr-atom $indexed) $take-abs))){$first $i $c}))

(= (rc:parse-and-coeff-queries $boundary $width $queries $acc)
   (if (== (size-atom $queries) 0) $acc
     (let ($q $rest) (decons-atom $queries)
       (let $qkey (rc:parse-query $boundary $q)
         (if (rc:unsupported? $qkey) $qkey
           (let (RC:QueryKey $smask $tidx) $qkey
             (let $coeffs (rc:query-coefficients $width $smask $tidx)
               (rc:parse-and-coeff-queries
                 $boundary $width $rest (union-atom $acc (($qkey $coeffs))))){$coeffs}){$smask $tidx})){$qkey}){$q $rest}))

(= (rc:prepare $program $queries)
   (let $vchk (rc:validate-program $program)
     (if (rc:unsupported? $vchk) $vchk
       (if (or (not (rc:is-expr $queries)) (== (size-atom $queries) 0))
           (RC:Unsupported empty-or-malformed-queries $queries)
           (let (RC:Program $boundary $shared $components) $program
             (let* (($width (size-atom $boundary))
                    ($qraw (rc:parse-and-coeff-queries $boundary $width (unique-atom $queries) ())))
               (if (rc:unsupported? $qraw) $qraw
                 (let* (($empty-hull (rc:intersection-hull 0 $width))
                        ($all-hulls
                          (foldl-atom $qraw ($empty-hull) $hacc $qc
                            (let ($qk $cpairs) $qc
                              (union-atom $hacc (map-atom $cpairs $p (car-atom $p))))))
                        ($families (rc:sort-unique-ints $all-hulls))
                        ($norm-idx (rc:index-of $empty-hull $families))
                        ($shared-cases (rc:pow2 (size-atom $shared)))
                        ($columns (* (size-atom $families) $shared-cases))
                        ($prep-queries
                          (map-atom $qraw $qc
                            (let ($qk $cpairs) $qc
                              (rc:build-prepared-query $families $qk $cpairs))))
                        ($compiled-comps
                          (rc:compile-components-cached $boundary $shared $families $components () ())))
                   (RC:Prepared
                     $program $width $families $norm-idx $shared-cases $columns
                     $prep-queries $compiled-comps)){$empty-hull $all-hulls $families $norm-idx $shared-cases $columns $prep-queries $compiled-comps})){$width $qraw}){$boundary $shared $components}))))

; ----------------------------------------------------------------------------
; 5. Choice State Normalization & Unnormalized World/Row Evaluation
; ----------------------------------------------------------------------------

(= (rc:evidence-flag-valid? $e)
   (or (== $e none) (or (== $e true) (== $e false))))

; Normalizes (RC:LocalState probs evidence), (RC:WeightedState pairs), or
; (RC:ConditionedWorldState n_choices per_h_world_rat_tuples)
(= (rc:normalize-state $expected-len $state)
   (case $state
     (((RC:LocalState $probs $evidence)
       (if (or (not (rc:is-expr $probs)) (not (rc:is-expr $evidence)))
           (RC:Unsupported malformed-local-state $state)
           (if (or (!= (size-atom $probs) $expected-len) (!= (size-atom $evidence) $expected-len))
               (RC:Unsupported choice-count-mismatch ($expected-len $state))
               (rc:local-to-weighted-loop $probs $evidence ()))))
      ((RC:WeightedState $pairs)
       (if (not (rc:is-expr $pairs))
           (RC:Unsupported malformed-weighted-state $state)
           (if (!= (size-atom $pairs) $expected-len)
               (RC:Unsupported choice-count-mismatch ($expected-len $state))
               (rc:validate-weighted-pairs $pairs ()))))
      ((RC:ConditionedWorldState $nc $per-h-worlds)
       (if (!= $nc $expected-len)
           (RC:Unsupported choice-count-mismatch ($expected-len $state))
           (let $expected-worlds (rc:pow2 $expected-len)
             (rc:validate-conditioned-worlds $expected-len $expected-worlds $per-h-worlds ())){$expected-worlds}))
      ($other (RC:Unsupported malformed-state $other)))))

(= (rc:validate-conditioned-worlds $nc $expected-worlds $per-h $acc)
   (if (== (size-atom $per-h) 0)
       (RC:ConditionedWorldState $nc $acc)
       (let $wlist (car-atom $per-h)
         (if (or (not (rc:is-expr $wlist)) (!= (size-atom $wlist) $expected-worlds))
             (RC:Unsupported malformed-conditioned-world-weights $wlist)
             (if (not (foldl-atom $wlist true $ok $r (and $ok (rc:rat-nonneg-valid? $r))))
                 (RC:Unsupported invalid-conditioned-world-weight $wlist)
                 (rc:validate-conditioned-worlds
                   $nc $expected-worlds (cdr-atom $per-h) (union-atom $acc ($wlist)))))){$wlist}))

(= (rc:local-to-weighted-loop $probs $evs $acc)
   (if (== (size-atom $probs) 0) (RC:WeightedState $acc)
     (let* (($p (car-atom $probs))
            ($e (car-atom $evs)))
       (if (not (rc:rat-prob-valid? $p))
           (RC:Unsupported invalid-choice-probability $p)
           (if (not (rc:evidence-flag-valid? $e))
               (RC:Unsupported invalid-evidence-flag $e)
               (let* (($comp (rc:rat-sub (rc:rat-one) $p))
                      ($wa (if (== $e true) (rc:rat-zero) $comp))
                      ($wp (if (== $e false) (rc:rat-zero) $p)))
                 (rc:local-to-weighted-loop
                   (cdr-atom $probs) (cdr-atom $evs) (union-atom $acc (($wa $wp))))){$comp $wa $wp}))){$p $e}))

(= (rc:validate-weighted-pairs $pairs $acc)
   (if (== (size-atom $pairs) 0) (RC:WeightedState $acc)
     (let $first (car-atom $pairs)
       (case $first
         ((($wa $wp)
           (if (and (rc:rat-nonneg-valid? $wa) (rc:rat-nonneg-valid? $wp))
               (rc:validate-weighted-pairs (cdr-atom $pairs) (union-atom $acc (($wa $wp))))
               (RC:Unsupported invalid-choice-weight-pair $first)))
          ($other (RC:Unsupported malformed-choice-weight-pair $other)))){$wa $wp $other}){$first}))

(= (rc:default-shared-state $n-shared)
   (RC:WeightedState
     (map-atom (rc:range 0 $n-shared) $i ((Rat 1 2) (Rat 1 2)))))

; Exact rational world weights: Kronecker expansion (absent ++ present)
(= (rc:world-weights-rat (RC:WeightedState $pairs))
   (foldl-atom $pairs ((Rat 1 1)) $cur $pair
     (let ($wa $wp) $pair
       (let* (($absent  (map-atom $cur $v (rc:rat-mul $v $wa)))
              ($present (map-atom $cur $v (rc:rat-mul $v $wp))))
         (union-atom $absent $present)))))

; f64 world weights with strict normal-range [1e-290, 1e150] underflow/overflow guard
(= (rc:pairs->f64 $pairs $acc)
   (if (== (size-atom $pairs) 0) (RC:F64PairsOk $acc)
     (let ($wa $wp) (car-atom $pairs)
       (case ((rc:rat->f64-checked $wa) (rc:rat->f64-checked $wp))
         ((((RC:F64Ok $fa) (RC:F64Ok $fp))
           (rc:pairs->f64 (cdr-atom $pairs) (union-atom $acc (($fa $fp)))))
          ($bad RC:F64OutOfRange))){$fa $fp $bad}){$wa $wp}))

(= (rc:mul-list-f64-checked $cur $f $acc)
   (if (== (size-atom $cur) 0) (RC:F64ListOk $acc)
     (let $v (car-atom $cur)
       (if (or (== $v 0.0) (== $f 0.0))
           (rc:mul-list-f64-checked (cdr-atom $cur) $f (union-atom $acc (0.0)))
           (let $p (* $v $f)
             (if (or (isnan-math $p)
                     (or (isinf-math $p)
                         (or (< $p 1.0e-290) (> $p 1.0e150))))
                 RC:F64OutOfRange
                 (rc:mul-list-f64-checked (cdr-atom $cur) $f (union-atom $acc ($p))))){$p})){$v}))

(= (rc:kronecker-f64-checked $fpairs $cur)
   (if (== (size-atom $fpairs) 0) (RC:F64ListOk $cur)
     (let ($fa $fp1) (car-atom $fpairs)
       (case (rc:mul-list-f64-checked $cur $fa ())
         (((RC:F64ListOk $absent)
           (case (rc:mul-list-f64-checked $cur $fp1 ())
             (((RC:F64ListOk $present)
               (rc:kronecker-f64-checked (cdr-atom $fpairs) (union-atom $absent $present)))
              (RC:F64OutOfRange RC:F64OutOfRange))){$present})
          (RC:F64OutOfRange RC:F64OutOfRange))){$absent}){$fa $fp1}))

(= (rc:sum-f64-list-checked $vals $acc)
   (if (== (size-atom $vals) 0) (RC:F64SumOk $acc)
     (let $next (+ $acc (car-atom $vals))
       (if (or (isnan-math $next) (or (isinf-math $next) (> $next 1.0e150)))
           RC:F64OutOfRange
           (rc:sum-f64-list-checked (cdr-atom $vals) $next))){$next}))

(= (rc:world-weights-f64-with-sum (RC:WeightedState $pairs))
   (case (rc:pairs->f64 $pairs ())
     (((RC:F64PairsOk $fpairs)
       (case (rc:kronecker-f64-checked $fpairs (1.0))
         (((RC:F64ListOk $vals)
           (case (rc:sum-f64-list-checked $vals 0.0)
             (((RC:F64SumOk $wsum)
               (let $len (size-atom $vals)
                 (RC:F64WeightsWithSum (tensor:from-values f64 ($len) $vals) $wsum)){$len})
              (RC:F64OutOfRange RC:F64OutOfRange))){$wsum})
          (RC:F64OutOfRange RC:F64OutOfRange))){$vals})
      (RC:F64OutOfRange RC:F64OutOfRange))))

(= (rc:world-weights-f64 $wstate)
   (case (rc:world-weights-f64-with-sum $wstate)
     (((RC:F64WeightsWithSum $wt $wsum) (RC:F64Weights $wt))
      (RC:F64OutOfRange RC:F64OutOfRange))))

(= (rc:rats->f64-list $rats $acc)
   (if (== (size-atom $rats) 0) (RC:F64ListOk $acc)
     (case (rc:rat->f64-checked (car-atom $rats))
       (((RC:F64Ok $fv)
         (rc:rats->f64-list (cdr-atom $rats) (union-atom $acc ($fv))))
        (RC:F64OutOfRange RC:F64OutOfRange))){$fv}))

(= (rc:tensor-scalar $t $idx)
   (case (tensor:at $t $idx)
     (((tensor:present $v) $v)
      ($other 0.0))))

(= (rc:f64-tensor-max-checked $t $len $idx $vmax)
   (if (>= $idx $len) (RC:F64MaxOk $vmax)
     (let $v (rc:tensor-scalar $t $idx)
       (if (or (isnan-math $v)
               (or (isinf-math $v)
                   (or (< $v 0.0)
                       (or (> $v 1.0e150)
                           (and (> $v 0.0) (< $v 1.0e-290))))))
           RC:F64OutOfRange
           (rc:f64-tensor-max-checked $t $len (+ $idx 1) (rc:f64-max $vmax $v)))){$v}))

; Wraps a validated leaf tensor with its Higham rounding-step budget and
; entrywise upper bound U_leaf >= 1.0 (covering both exact and rounded entries).
(= (rc:wrap-f64-leaf-row $row-tensor $columns $n-choices)
   (let $m-leaf (+ (* 4 $n-choices) (+ (rc:pow2 $n-choices) 3))
     (if (> $m-leaf 1000000)
         RC:F64OutOfRange
         (case (rc:f64-tensor-max-checked $row-tensor $columns 0 0.0)
           (((RC:F64MaxOk $vmax)
             (let* (($u 1.1102230246251565e-16)
                    ($pad (+ 1.0 (* (+ 0.0 (+ (* 2 $m-leaf) 8)) $u)))
                    ($ub (rc:f64-max 1.0 (rc:f64-round-up (* $vmax $pad)))))
               (if (or (isnan-math $ub) (or (isinf-math $ub) (> $ub 1.0e150)))
                   RC:F64OutOfRange
                   (RC:F64Row (RC:F64Vec $row-tensor $m-leaf $ub)))){$u $pad $ub})
            (RC:F64OutOfRange RC:F64OutOfRange))){$vmax})))

(= (rc:conditioned-rows-f64-loop $f64-mat $n-fam $n-worlds $per-h $h $acc)
   (if (== (size-atom $per-h) 0) (RC:F64RawTensor $acc)
     (case (rc:rats->f64-list (car-atom $per-h) ())
       (((RC:F64ListOk $fvals)
         (let* (($wt (tensor:from-values f64 ($n-worlds) $fvals))
                ($sub-mat (tensor:view $f64-mat ($n-fam $n-worlds) ($n-worlds 1) (* (* $h $n-fam) $n-worlds)))
                ($part (tensor:matvec $sub-mat $wt))
                ($next (if (== $h 0) $part (tensor:concatenate $acc $part 0))))
           (rc:conditioned-rows-f64-loop $f64-mat $n-fam $n-worlds (cdr-atom $per-h) (+ $h 1) $next)){$wt $sub-mat $part $next})
        (RC:F64OutOfRange RC:F64OutOfRange))){$fvals}))

(= (rc:local-rows-f64 (RC:CompiledComponent $name $n-choices $profiles $f64-mat $exact-rows) $wstate)
   (let $columns (size-atom $exact-rows)
     (case $wstate
       (((RC:WeightedState $pairs)
         (case (rc:world-weights-f64 $wstate)
           (((RC:F64Weights $wtensor)
             (rc:wrap-f64-leaf-row (tensor:matvec $f64-mat $wtensor) $columns $n-choices))
            (RC:F64OutOfRange RC:F64OutOfRange))){$wtensor})
        ((RC:ConditionedWorldState $nc $per-h)
         (let* (($scases (size-atom $profiles))
                ($n-fam  (rc:int-div $columns $scases))
                ($n-worlds (rc:pow2 $n-choices)))
           (if (!= (size-atom $per-h) $scases)
               (RC:Unsupported conditioned-shared-world-mismatch ((size-atom $per-h) $scases))
               (case (rc:conditioned-rows-f64-loop $f64-mat $n-fam $n-worlds $per-h 0 ())
                 (((RC:F64RawTensor $raw-t)
                   (rc:wrap-f64-leaf-row $raw-t $columns $n-choices))
                  (RC:F64OutOfRange RC:F64OutOfRange))){$raw-t})){$scases $n-fam $n-worlds})))))

(= (rc:local-rows-rat (RC:CompiledComponent $name $n-choices $profiles $f64-mat $exact-rows) $wstate)
   (case $wstate
     (((RC:WeightedState $pairs)
       (let* (($weights (rc:world-weights-rat $wstate))
              ($n-worlds (size-atom $weights))
              ($total
                (foldl-atom $pairs (Rat 1 1) $t $pair
                  (let ($wa $wp) $pair (rc:rat-mul $t (rc:rat-add $wa $wp))))))
         (map-atom $exact-rows $selected
           (if (== (size-atom $selected) $n-worlds)
               $total
               (foldl-atom $selected (Rat 0 1) $sum $w
                 (rc:rat-add $sum (index-atom $weights $w)))))){$weights $n-worlds $total})
      ((RC:ConditionedWorldState $nc $per-h)
       (let* (($scases (size-atom $profiles))
              ($n-fam  (rc:int-div (size-atom $exact-rows) $scases)))
         (foldl-atom (rc:range 0 $scases) () $acc-h $h
           (let* (($weights-h (index-atom $per-h $h))
                  ($rows-h
                    (map-atom (rc:range 0 $n-fam) $f
                      (let $selected (index-atom $exact-rows (+ (* $h $n-fam) $f))
                        (foldl-atom $selected (Rat 0 1) $sum $w
                          (rc:rat-add $sum (index-atom $weights-h $w)))))))
             (union-atom $acc-h $rows-h)))){$scases $n-fam}))))

; ----------------------------------------------------------------------------
; 6. Persistent Binary ProductTree & Indexed SlotTree
; ----------------------------------------------------------------------------
;
; ProductTree nodes cache (lo mid hi) routing bounds and mode-specific entries:
;   - f64 mode entry : (RC:F64Vec tensor rounding_steps subtree_upper_bound)
;   - rat mode entry : tuple of exact (Rat num den)
;   (RC:PTLeaf idx entry)
;   (RC:PTNode lo mid hi left right entry)
;
; SlotTree indexes per-component (CompiledComponent, WeightedState) pairs in a
; balanced binary tree so rc:engine-update performs O(d log N) lookups and
; updates with zero O(N) list scans or list copies on the f64 fast path.

(= (rc:f64-mul $a $b) (* $a $b))

(= (rc:f64-vec-mul $left-vec $right-vec)
   (tensor:zip-map f64 ($left-vec $right-vec) rc:f64-mul ()))

(= (rc:rat-vec-mul $left-vec $right-vec)
   (let $n (size-atom $left-vec)
     (map-atom (rc:range 0 $n) $i
       (rc:rat-mul (index-atom $left-vec $i) (index-atom $right-vec $i)))))

(= (rc:pt-entry (RC:PTLeaf $idx $entry)) $entry)
(= (rc:pt-entry (RC:PTNode $lo $mid $hi $left $right $entry)) $entry)

(= (rc:pt-vec $node)
   (let $entry (rc:pt-entry $node)
     (case $entry
       (((RC:F64Vec $vec $steps $ub) $vec)
        ($rat-vec $rat-vec)))))

(= (rc:pt-count (RC:PTLeaf $idx $entry)) 1)
(= (rc:pt-count (RC:PTNode $lo $mid $hi $left $right $entry)) (+ (- $hi $lo) 1))

(= (rc:pt-left  (RC:PTNode $lo $mid $hi $left $right $entry)) $left)
(= (rc:pt-right (RC:PTNode $lo $mid $hi $left $right $entry)) $right)

(= (rc:pt-combine-entry f64 (RC:F64Vec $vl $sl $ubl) (RC:F64Vec $vr $sr $ubr))
   (let* (($steps (+ (+ $sl $sr) 1))
          ($u 1.1102230246251565e-16)
          ($ub-raw (rc:f64-round-up (* $ubl $ubr))))
     (if (or (> $ubl 1.0e150)
             (or (> $ubr 1.0e150)
                 (or (isnan-math $ub-raw)
                     (or (isinf-math $ub-raw) (> $ub-raw 1.0e150)))))
         ; Sentinel > 1e150 forces certified exact rational fallback at readout
         ; while keeping valid leaf tensors intact for O(log N) future updates.
         (RC:F64Vec $vl $steps 1.0e151)
         (RC:F64Vec (rc:f64-vec-mul $vl $vr) $steps $ub-raw))))

(= (rc:pt-combine-entry rat $l $r) (rc:rat-vec-mul $l $r))

(= (rc:pt-build $mode $rows)
   (rc:pt-build-range $mode $rows 0 (- (size-atom $rows) 1)))

(= (rc:pt-build-range $mode $rows $lo $hi)
   (if (== $lo $hi)
       (RC:PTBuildResult (RC:PTLeaf $lo (index-atom $rows $lo)) 0)
       (let* (($mid (+ $lo (rc:int-div (- $hi $lo) 2)))
              ((RC:PTBuildResult $left $vl)  (rc:pt-build-range $mode $rows $lo $mid))
              ((RC:PTBuildResult $right $vr) (rc:pt-build-range $mode $rows (+ $mid 1) $hi))
              ($prod (rc:pt-combine-entry $mode (rc:pt-entry $left) (rc:pt-entry $right))))
         (RC:PTBuildResult
           (RC:PTNode $lo $mid $hi $left $right $prod)
           (+ 1 (+ $vl $vr)))){$mid $left $vl $right $vr $prod}))

(= (rc:split-updates-at $mid $sorted-updates)
   (rc:split-updates-loop $mid $sorted-updates () ()))

(= (rc:split-updates-loop $mid $updates $left-acc $right-acc)
   (if (== (size-atom $updates) 0)
       ($left-acc $right-acc)
       (let* (($first (car-atom $updates))
              (($idx $val) $first))
         (if (<= $idx $mid)
             (rc:split-updates-loop $mid (cdr-atom $updates) (union-atom $left-acc ($first)) $right-acc)
             (rc:split-updates-loop $mid (cdr-atom $updates) $left-acc (union-atom $right-acc ($first))))){$first $idx $val}))

(= (rc:pt-update-batch $mode $tree $sorted-updates)
   (if (== (size-atom $sorted-updates) 0)
       (RC:PTUpdateResult $tree 0)
       (case $tree
         (((RC:PTLeaf $idx $old-entry)
           (let (($uidx $new-entry)) $sorted-updates
             (RC:PTUpdateResult (RC:PTLeaf $idx $new-entry) 0)){$uidx $new-entry})
          ((RC:PTNode $lo $mid $hi $left $right $old-entry)
           (let* ((($lups $rups) (rc:split-updates-at $mid $sorted-updates))
                  ((RC:PTUpdateResult $left2 $vl)
                   (if (== (size-atom $lups) 0)
                       (RC:PTUpdateResult $left 0)
                       (rc:pt-update-batch $mode $left $lups)))
                  ((RC:PTUpdateResult $right2 $vr)
                   (if (== (size-atom $rups) 0)
                       (RC:PTUpdateResult $right 0)
                       (rc:pt-update-batch $mode $right $rups)))
                  ($prod (rc:pt-combine-entry $mode (rc:pt-entry $left2) (rc:pt-entry $right2))))
             (RC:PTUpdateResult
               (RC:PTNode $lo $mid $hi $left2 $right2 $prod)
               (+ 1 (+ $vl $vr)))){$lups $rups $left2 $vl $right2 $vr $prod}))){$idx $old-entry $lo $mid $hi $left $right}))

; Indexed SlotTree for O(log N) per-component compiled-metadata & state access
(= (rc:slot-build $ccomps $wstates)
   (rc:slot-build-range $ccomps $wstates 0 (- (size-atom $ccomps) 1)))

(= (rc:slot-build-range $ccomps $wstates $lo $hi)
   (if (== $lo $hi)
       (RC:SlotLeaf $lo (index-atom $ccomps $lo) (index-atom $wstates $lo))
       (let* (($mid (+ $lo (rc:int-div (- $hi $lo) 2)))
              ($left  (rc:slot-build-range $ccomps $wstates $lo $mid))
              ($right (rc:slot-build-range $ccomps $wstates (+ $mid 1) $hi)))
         (RC:SlotNode $lo $mid $hi $left $right)){$mid $left $right}))

(= (rc:slot-count (RC:SlotLeaf $idx $cc $ws)) 1)
(= (rc:slot-count (RC:SlotNode $lo $mid $hi $left $right)) (+ (- $hi $lo) 1))

(= (rc:slot-get (RC:SlotLeaf $idx $cc $ws) $qidx) ($cc $ws))
(= (rc:slot-get (RC:SlotNode $lo $mid $hi $left $right) $qidx)
   (if (<= $qidx $mid)
       (rc:slot-get $left $qidx)
       (rc:slot-get $right $qidx)))

(= (rc:slot-update-states $stree $sorted-ws-updates)
   (if (== (size-atom $sorted-ws-updates) 0)
       $stree
       (case $stree
         (((RC:SlotLeaf $idx $cc $old-ws)
           (let (($uidx $new-ws)) $sorted-ws-updates
             (RC:SlotLeaf $idx $cc $new-ws)){$uidx $new-ws})
          ((RC:SlotNode $lo $mid $hi $left $right)
           (let* ((($lups $rups) (rc:split-updates-at $mid $sorted-ws-updates))
                  ($left2  (if (== (size-atom $lups) 0) $left  (rc:slot-update-states $left $lups)))
                  ($right2 (if (== (size-atom $rups) 0) $right (rc:slot-update-states $right $rups))))
             (RC:SlotNode $lo $mid $hi $left2 $right2)){$lups $rups $left2 $right2}))){$idx $cc $old-ws $lo $mid $hi $left $right}))

(= (rc:slot-replace-one (RC:SlotLeaf $idx $old-cc $old-ws) $tidx $new-cc $new-ws)
   (RC:SlotLeaf $idx $new-cc $new-ws))
(= (rc:slot-replace-one (RC:SlotNode $lo $mid $hi $left $right) $tidx $new-cc $new-ws)
   (if (<= $tidx $mid)
       (RC:SlotNode $lo $mid $hi (rc:slot-replace-one $left $tidx $new-cc $new-ws) $right)
       (RC:SlotNode $lo $mid $hi $left (rc:slot-replace-one $right $tidx $new-cc $new-ws))))

(= (rc:slot-all-f64-rows (RC:SlotLeaf $idx $cc $ws))
   (case (rc:local-rows-f64 $cc $ws)
     (((RC:F64Row $entry) (RC:F64RowsOk ($entry)))
      (RC:F64OutOfRange RC:F64OutOfRange))))
(= (rc:slot-all-f64-rows (RC:SlotNode $lo $mid $hi $left $right))
   (case (rc:slot-all-f64-rows $left)
     (((RC:F64RowsOk $lrows)
       (case (rc:slot-all-f64-rows $right)
         (((RC:F64RowsOk $rrows) (RC:F64RowsOk (union-atom $lrows $rrows)))
          (RC:F64OutOfRange RC:F64OutOfRange))){$rrows})
      (RC:F64OutOfRange RC:F64OutOfRange))))

(= (rc:slot-all-rat-rows (RC:SlotLeaf $idx $cc $ws))
   ((rc:local-rows-rat $cc $ws)))
(= (rc:slot-all-rat-rows (RC:SlotNode $lo $mid $hi $left $right))
   (union-atom (rc:slot-all-rat-rows $left) (rc:slot-all-rat-rows $right)))

; ----------------------------------------------------------------------------
; 7. Engine Lifecycle: Construction, Belief/Evidence Update & Scenario Change
; ----------------------------------------------------------------------------

(= (rc:normalize-all-states $compiled-comps $states $idx $acc)
   (if (== (size-atom $compiled-comps) 0) (RC:StatesOk $acc)
     (let* (((RC:CompiledComponent $name $n-choices $prof $fmat $erows) (car-atom $compiled-comps))
            ($st (car-atom $states))
            ($norm (rc:normalize-state $n-choices $st)))
       (if (rc:unsupported? $norm) $norm
         (rc:normalize-all-states
           (cdr-atom $compiled-comps) (cdr-atom $states) (+ $idx 1) (union-atom $acc ($norm))))){$name $n-choices $prof $fmat $erows $st $norm}))

(= (rc:engine-new $prepared $states)
   (rc:engine-new-with-shared $prepared $states default))

(= (rc:engine-new-with-shared $prepared $states $shared-opt)
   (if (rc:unsupported? $prepared) $prepared
     (let (RC:Prepared $prog $width $fams $nidx $scases $cols $pqs $ccomps) $prepared
       (if (or (not (rc:is-expr $states)) (!= (size-atom $states) (size-atom $ccomps)))
           (RC:Unsupported component-state-count-mismatch ((size-atom $ccomps) (size-atom $states)))
           (let (RC:Program $boundary $shared $raw-comps) $prog
             (let* (($n-shared (size-atom $shared))
                    ($sh-norm
                      (if (== $shared-opt default)
                          (rc:default-shared-state $n-shared)
                          (rc:normalize-state $n-shared $shared-opt))))
               (if (rc:unsupported? $sh-norm) $sh-norm
                 (let $st-norm (rc:normalize-all-states $ccomps $states 0 ())
                   (if (rc:unsupported? $st-norm) $st-norm
                     (let* (((RC:StatesOk $wstates) $st-norm)
                            ($stree (rc:slot-build $ccomps $wstates)))
                       (case ((rc:slot-all-f64-rows $stree)
                              (rc:world-weights-f64 $sh-norm))
                         ((((RC:F64RowsOk $frows) (RC:F64Weights $sh-ftensor))
                           (let (RC:PTBuildResult $ftree $visits) (rc:pt-build f64 $frows)
                             (RC:Engine
                               $prepared $stree $sh-norm true $ftree
                               RC:NoExactTree () $visits 0)){$ftree $visits})
                          ($out-of-range
                           (let* (($rrows (rc:slot-all-rat-rows $stree))
                                  ((RC:PTBuildResult $etree $visits) (rc:pt-build rat $rrows)))
                             (RC:Engine
                               $prepared $stree $sh-norm false RC:NoF64Tree
                               $etree () $visits 0)){$rrows $etree $visits}))){$frows $sh-ftensor $out-of-range}){$wstates $stree})){$st-norm})){$n-shared $sh-norm}){$boundary $shared $raw-comps})){$prog $width $fams $nidx $scases $cols $pqs $ccomps}))

(= (rc:prepare-update-batch $stree $n-comps $updates $ws-ups-acc $frows-acc $dirty-acc $track-dirty $f64-ok)
   (if (== (size-atom $updates) 0)
       (RC:BatchPrepared $ws-ups-acc $frows-acc $dirty-acc $f64-ok)
       (let ($first $rest) (decons-atom $updates)
         (case $first
           ((($idx $new-state)
             (if (or (not (rc:is-int $idx)) (or (< $idx 0) (>= $idx $n-comps)))
                 (RC:Unsupported unknown-component-update $idx)
                 (let* ((($cc $old-ws) (rc:slot-get $stree $idx))
                        ((RC:CompiledComponent $name $nc $prof $fm $er) $cc)
                        ($norm (rc:normalize-state $nc $new-state)))
                   (if (rc:unsupported? $norm) $norm
                     (let* (($ws-ups2 (union-atom $ws-ups-acc (($idx $norm))))
                            ($dirty2  (if $track-dirty (rc:insert-unique-int $idx $dirty-acc) ())))
                       (if $f64-ok
                           (case (rc:local-rows-f64 $cc $norm)
                             (((RC:F64Row $fentry)
                               (rc:prepare-update-batch
                                 $stree $n-comps $rest $ws-ups2
                                 (union-atom $frows-acc (($idx $fentry))) $dirty2 $track-dirty true))
                              (RC:F64OutOfRange
                               (rc:prepare-update-batch
                                 $stree $n-comps $rest $ws-ups2 () $dirty2 $track-dirty false)))){$fentry}
                           (rc:prepare-update-batch
                             $stree $n-comps $rest $ws-ups2 () $dirty2 $track-dirty false))){$ws-ups2 $dirty2})){$cc $old-ws $name $nc $prof $fm $er $norm}))
            ($other (RC:Unsupported malformed-update-entry $other)))){$idx $new-state $other}){$first $rest}))

; Update one or more component states: $changed-pairs = ((idx new_state) ...),
; and optional shared state ($shared-opt = keep or a state).
; Runs in O(d log N) on the f64 fast path with zero O(N) list scans or copies.
(= (rc:engine-update $engine $changed-pairs $shared-opt)
   (if (rc:unsupported? $engine) $engine
     (let (RC:Engine $prepared $stree $sh-state $fvalid $ftree $etree $edirty $lastv $fb) $engine
       (if (not (rc:is-expr $changed-pairs))
           (RC:Unsupported malformed-update-list $changed-pairs)
           (let (RC:Prepared $prog $width $fams $nidx $scases $cols $pqs $ccomps) $prepared
             (let (RC:Program $boundary $shared $raw-comps) $prog
               (let $sh-norm
                    (if (== $shared-opt keep)
                        $sh-state
                        (rc:normalize-state (size-atom $shared) $shared-opt))
                 (if (rc:unsupported? $sh-norm) $sh-norm
                   (let* (($sh-f64-ok
                            (case (rc:world-weights-f64 $sh-norm)
                              (((RC:F64Weights $t) true)
                               (RC:F64OutOfRange false))){$t})
                          ($n-comps (rc:slot-count $stree))
                          ($track-dirty (!= $etree RC:NoExactTree))
                          ($sorted-changes (rc:sort-indexed-pairs $changed-pairs))
                          ($bprep (rc:prepare-update-batch
                                    $stree $n-comps $sorted-changes () () $edirty
                                    $track-dirty (and $fvalid $sh-f64-ok))))
                     (if (rc:unsupported? $bprep) $bprep
                       (let* (((RC:BatchPrepared $ws-ups $fups $edirty2 $still-f64) $bprep)
                              ($stree2 (rc:slot-update-states $stree $ws-ups)))
                         (if $still-f64
                             (let (RC:PTUpdateResult $ftree2 $visits)
                                  (rc:pt-update-batch f64 $ftree $fups)
                               (RC:Engine
                                 $prepared $stree2 $sh-norm true $ftree2
                                 $etree $edirty2 $visits $fb)){$ftree2 $visits}
                             ; Rebuild f64 tree if weights came back into f64 range, else keep exact-only
                             (case ((rc:slot-all-f64-rows $stree2)
                                    (rc:world-weights-f64 $sh-norm))
                               ((((RC:F64RowsOk $frows) (RC:F64Weights $swt))
                                 (let (RC:PTBuildResult $ftree2 $visits) (rc:pt-build f64 $frows)
                                   (RC:Engine
                                     $prepared $stree2 $sh-norm true $ftree2
                                     $etree $edirty2 $visits $fb)){$ftree2 $visits})
                                ($still-big
                                 (RC:Engine
                                   $prepared $stree2 $sh-norm false RC:NoF64Tree
                                   $etree $edirty2 0 $fb)))){$frows $swt $still-big})){$ws-ups $fups $edirty2 $still-f64 $stree2})){$sh-f64-ok $n-comps $track-dirty $sorted-changes $bprep})){$sh-norm}){$boundary $shared $raw-comps}){$prog $width $fams $nidx $scases $cols $pqs $ccomps})){$prepared $stree $sh-state $fvalid $ftree $etree $edirty $lastv $fb}))

; Validates replacing component $target-idx in an already-validated RC:Program
; in O(N) checks rather than O(N^2) union-accumulation.
(= (rc:validate-component-against-peers $boundary $shared $raw-comps $target-idx $new-comp)
   (case $new-comp
     (((RC:Component $name $choices $private $rules)
       (if (not (rc:is-symbol $name))
           (RC:Unsupported invalid-component-name $name)
           (if (or (not (rc:all-symbols? $choices)) (not (rc:all-symbols? $private)))
               (RC:Unsupported non-symbol-local-declaration $name)
               (let* (($common (union-atom $boundary $shared))
                      ($local  (union-atom $choices $private)))
                 (if (or (rc:has-duplicates? $local) (rc:intersects? $local $common))
                     (RC:Unsupported shared-or-private-ownership-violation $name)
                     (let $peer-chk
                          (rc:check-peers-disjoint $raw-comps 0 $target-idx $name $local)
                       (if (rc:unsupported? $peer-chk) $peer-chk
                         (rc:validate-rules
                           $name (union-atom $common $local) (union-atom $choices $shared) $rules))){$peer-chk})){$common $local})))
      ($other (RC:Unsupported malformed-component $other)))))

(= (rc:check-peers-disjoint $raw-comps $cur $target-idx $name $local)
   (if (== (size-atom $raw-comps) 0) RC:Valid
     (let ($peer $rest) (decons-atom $raw-comps)
       (if (== $cur $target-idx)
           (rc:check-peers-disjoint $rest (+ $cur 1) $target-idx $name $local)
           (let (RC:Component $pname $pchoices $ppriv $prules) $peer
             (if (== $name $pname)
                 (RC:Unsupported duplicate-component-identity $name)
                 (if (or (rc:intersects? $local $pchoices) (rc:intersects? $local $ppriv))
                     (RC:Unsupported shared-or-private-ownership-violation $name)
                     (rc:check-peers-disjoint $rest (+ $cur 1) $target-idx $name $local)))){$pname $pchoices $ppriv $prules})){$peer $rest}))

; Local Component Scenario Replacement:
; Re-validates global peer-ownership disjointness (O(N)), compiles ONLY
; component $idx against the retained prepared family bank (O(1)), and updates
; ONLY leaf $idx in SlotTree and ProductTree (O(log N) tree visits).
(= (rc:engine-replace-component $engine $idx $new-component $new-state)
   (if (rc:unsupported? $engine) $engine
     (let (RC:Engine $prepared $stree $sh-state $fvalid $ftree $etree $edirty $lastv $fb) $engine
       (let (RC:Prepared $prog $width $fams $nidx $scases $cols $pqs $ccomps) $prepared
         (let $n-comps (rc:slot-count $stree)
           (if (or (not (rc:is-int $idx)) (or (< $idx 0) (>= $idx $n-comps)))
               (RC:Unsupported unknown-component-index $idx)
               (let (RC:Program $boundary $shared $raw-comps) $prog
                 (let $vchk (rc:validate-component-against-peers $boundary $shared $raw-comps $idx $new-component)
                   (if (rc:unsupported? $vchk) $vchk
                     (let* (($raw-comps2 (rc:replace-at $raw-comps $idx $new-component))
                            ($prog2 (RC:Program $boundary $shared $raw-comps2))
                            ((RC:CompileStep $new-cc $unused-cache)
                             (rc:compile-single-component $boundary $shared $fams $new-component ()))
                            ((RC:CompiledComponent $cname $nc $prof $fmat $erows) $new-cc)
                            ($norm-st (rc:normalize-state $nc $new-state)))
                       (if (rc:unsupported? $norm-st) $norm-st
                         (let* (($ccomps2  (rc:replace-at $ccomps $idx $new-cc))
                                ($prepared2
                                  (RC:Prepared $prog2 $width $fams $nidx $scases $cols $pqs $ccomps2))
                                ($stree2   (rc:slot-replace-one $stree $idx $new-cc $norm-st))
                                ($edirty2  (if (!= $etree RC:NoExactTree)
                                               (rc:insert-unique-int $idx $edirty)
                                               ())))
                           (if $fvalid
                               (case (rc:local-rows-f64 $new-cc $norm-st)
                                 (((RC:F64Row $fentry)
                                   (let (RC:PTUpdateResult $ftree2 $visits)
                                        (rc:pt-update-batch f64 $ftree (($idx $fentry)))
                                     (RC:Engine
                                       $prepared2 $stree2 $sh-state true $ftree2
                                       $etree $edirty2 $visits $fb)){$ftree2 $visits})
                                  (RC:F64OutOfRange
                                   (RC:Engine
                                     $prepared2 $stree2 $sh-state false RC:NoF64Tree
                                     $etree $edirty2 0 $fb)))){$fentry}
                               (RC:Engine
                                 $prepared2 $stree2 $sh-state false RC:NoF64Tree
                                 $etree $edirty2 0 $fb))){$ccomps2 $prepared2 $stree2 $edirty2})){$raw-comps2 $prog2 $new-cc $unused-cache $cname $nc $prof $fmat $erows $norm-st})){$vchk}){$boundary $shared $raw-comps})){$n-comps}){$prog $width $fams $nidx $scases $cols $pqs $ccomps}){$prepared $stree $sh-state $fvalid $ftree $etree $edirty $lastv $fb}))

; ----------------------------------------------------------------------------
; 8. Shared-Cause Mixture, Compositional Higham Enclosure & Exact Fallback
; ----------------------------------------------------------------------------

(= (rc:find-prepared-query $qkey $pqs)
   (if (== (size-atom $pqs) 0) RC:QueryNotPrepared
     (let* (($pq (car-atom $pqs))
            ((RC:PreparedQuery $k $ec $fmat $cl1) $pq))
       (if (== $qkey $k) $pq
         (rc:find-prepared-query $qkey (cdr-atom $pqs)))){$pq $k $ec $fmat $cl1}))

(= (rc:mix-shared-f64 (RC:F64Vec $root-tensor $tree-steps $ub-tree) $scases $n-fam $n-sh $sh-state)
   (if (> $ub-tree 1.0e150)
       RC:F64OutOfRange
       (if (== $scases 1)
           (RC:F64Mixed $root-tensor $tree-steps $ub-tree)
           (case (rc:world-weights-f64-with-sum $sh-state)
             (((RC:F64WeightsWithSum $wsh $wsum)
               (let* (($m-sh (+ (* 4 $n-sh) (+ $scases 1)))
                      ($u 1.1102230246251565e-16)
                      ($sh-pad (+ 1.0 (* (+ 0.0 (+ (* 2 $m-sh) 8)) $u)))
                      ($ub-sh (rc:f64-max 1.0 (rc:f64-round-up (* $wsum $sh-pad))))
                      ($ub-mixed (rc:f64-round-up (* $ub-tree $ub-sh))))
                 (if (or (isnan-math $ub-mixed) (or (isinf-math $ub-mixed) (> $ub-mixed 1.0e150)))
                     RC:F64OutOfRange
                     (let* (($reshaped   (tensor:reshape $root-tensor ($scases $n-fam)))
                            ($transposed (tensor:permute $reshaped (1 0))))
                       (RC:F64Mixed (tensor:matvec $transposed $wsh) (+ $tree-steps $m-sh) $ub-mixed)){$reshaped $transposed})){$m-sh $u $sh-pad $ub-sh $ub-mixed})
              (RC:F64OutOfRange RC:F64OutOfRange))){$wsh $wsum})))

(= (rc:mix-shared-rat $root-rats $scases $n-fam $sh-state)
   (if (== $scases 1)
       $root-rats
       (let $weights (rc:world-weights-rat $sh-state)
         (map-atom (rc:range 0 $n-fam) $col
           (foldl-atom (rc:range 0 $scases) (Rat 0 1) $sum $h
             (rc:rat-add
               $sum
               (rc:rat-mul
                 (index-atom $weights $h)
                 (index-atom $root-rats (+ (* $h $n-fam) $col))))))){$weights}))

(= (rc:extract-rat $mixed-rats $norm-idx $exact-coeffs)
   (let* (($num
            (foldl-atom $exact-coeffs (Rat 0 1) $acc $pair
              (let ($idx $c) $pair
                (rc:rat-add $acc (rc:rat-mul (Rat $c 1) (index-atom $mixed-rats $idx))))))
          ($den (index-atom $mixed-rats $norm-idx)))
     ($num $den)))

; Compositional IEEE-754 Higham forward-error enclosure check (Higham Ch. 3).
; Every intermediate bound and endpoint is rounded strictly outward.
; Accuracy gate: width <= 1e-12 and lo > 0 and width <= 1e-10 * lo.
(= (rc:try-f64-enclosure $num $den $amp $rounding-steps $ub-mixed $uflow-count $coeff-l1)
   (if (or (> $rounding-steps 10000000)
           (or (> $ub-mixed 1.0e150)
               (or (< $ub-mixed 1.0)
                   (or (isnan-math $num)
                       (or (isnan-math $den)
                           (or (isnan-math $amp)
                               (or (isnan-math $ub-mixed)
                                   (or (isinf-math $num)
                                       (or (isinf-math $den)
                                           (or (isinf-math $amp) (isinf-math $ub-mixed)))))))))))
       RC:NeedsFallback
       (let* (($u  1.1102230246251565e-16)
              ($up (+ 1.0 (* 8.0 $u)))
              ($dn (- 1.0 (* 8.0 $u)))
              ($mu (* (* (+ 0.0 $rounding-steps) $u) $up)))
         (if (>= $mu 0.01)
             RC:NeedsFallback
             (let* (($one-minus-mu (* (- 1.0 $mu) $dn))
                    ($gamma (* (/ $mu $one-minus-mu) $up))
                    ($one-minus-gam (* (- 1.0 $gamma) $dn))
                    ($factor (* (/ $gamma $one-minus-gam) $up))
                    ($uflow-base (* (* (+ 0.0 $uflow-count) (* 1.0e-305 $ub-mixed)) $up))
                    ($cl1 (rc:max-int 1 $coeff-l1))
                    ($uflow-num (* (* (+ 0.0 $cl1) $uflow-base) $up))
                    ($d-num (* (+ (* $factor (rc:f64-abs $amp)) $uflow-num) $up))
                    ($d-den (* (+ (* $factor (rc:f64-abs $den)) $uflow-base) $up)))
               (if (<= $den $d-den)
                   RC:NeedsFallback
                   (let* (($den-lo (rc:f64-round-down (- $den $d-den)))
                          ($den-hi (rc:f64-round-up   (+ $den $d-den))))
                     (if (<= $den-lo 1.0e-250)
                         RC:NeedsFallback
                         (let* (($num-lo (rc:f64-round-down (- $num $d-num)))
                                ($num-hi (rc:f64-round-up   (+ $num $d-num))))
                           (if (or (< $num-hi (- 0.0 $d-den)) (> $num-lo (+ $den-hi $d-den)))
                               RC:NeedsFallback
                               (let* (($raw-lo (rc:f64-round-down
                                                 (/ $num-lo (if (>= $num-lo 0.0) $den-hi $den-lo))))
                                      ($raw-hi (rc:f64-round-up
                                                 (/ $num-hi (if (>= $num-hi 0.0) $den-lo $den-hi))))
                                      ($lo (rc:f64-max 0.0 $raw-lo))
                                      ($hi (rc:f64-min 1.0 $raw-hi))
                                      ($width (- $hi $lo)))
                                 (if (and (<= $width 1.0e-12)
                                          (and (> $lo 0.0)
                                               (<= $width (* 1.0e-10 $lo))))
                                     (RC:EnclosureOk (RC:Interval $lo $hi))
                                     RC:NeedsFallback)){$raw-lo $raw-hi $lo $hi $width})){$num-lo $num-hi})){$den-lo $den-hi})){$one-minus-mu $gamma $one-minus-gam $factor $uflow-base $cl1 $uflow-num $d-num $d-den})){$u $up $dn $mu}))

; Outward f64 lower/upper bounds for 1 <= n <= d <= 10^150
(= (rc:small-rat-lo $n $d)
   (let* (($u 1.1102230246251565e-16)
          ($dn (- 1.0 (* 8.0 $u)))
          ($up (+ 1.0 (* 8.0 $u)))
          ($fn-lo (* (+ 0.0 $n) $dn))
          ($fd-hi (* (+ 0.0 $d) $up)))
     (rc:f64-max 0.0 (rc:f64-round-down (/ $fn-lo $fd-hi)))))

(= (rc:small-rat-hi $n $d)
   (let* (($u 1.1102230246251565e-16)
          ($dn (- 1.0 (* 8.0 $u)))
          ($up (+ 1.0 (* 8.0 $u)))
          ($fn-hi (* (+ 0.0 $n) $up))
          ($fd-lo (* (+ 0.0 $d) $dn)))
     (rc:f64-min 1.0 (rc:f64-round-up (/ $fn-hi $fd-lo)))))

(= (rc:divide-interval-by-1e100-k (RC:Interval $lo $hi) $k)
   (if (<= $k 0)
       (RC:Interval $lo $hi)
       (let* (($u 1.1102230246251565e-16)
              ($dn (- 1.0 (* 8.0 $u)))
              ($up (+ 1.0 (* 8.0 $u)))
              ($p100 (+ 0.0 (rc:pow10 100)))
              ($p100-lo (* $p100 $dn))
              ($p100-hi (* $p100 $up))
              ($lo2 (rc:f64-max 0.0 (rc:f64-round-down (/ $lo $p100-hi))))
              ($hi2 (rc:f64-min 1.0 (rc:f64-round-up   (/ $hi $p100-lo)))))
         (rc:divide-interval-by-1e100-k (RC:Interval $lo2 $hi2) (- $k 1))){$u $dn $up $p100 $p100-lo $p100-hi $lo2 $hi2}))

; Certified outward IEEE-754 interval enclosure for arbitrary-precision BigInt
; probabilities (Rat $n $d) with 0 <= n <= d and d > 0 (including multi-thousand-digit
; numerators and denominators such as 1 - (9999/10000)^1024).
(= (rc:rat->interval (Rat $n $d))
   (if (<= $n 0)
       (RC:Interval 0.0 0.0)
       (if (>= $n $d)
           (RC:Interval 1.0 1.0)
           (let $lim (rc:max-f64-bigint)
             (if (<= $d $lim)
                 (RC:Interval (rc:small-rat-lo $n $d) (rc:small-rat-hi $n $d))
                 (if (< (* $n (rc:pow10 290)) $d)
                     (RC:Interval 0.0 1.0e-290)
                     (let* (($decade-shifts
                              (if (>= (* $n (rc:pow10 100)) $d)
                                  0
                                  (if (>= (* $n (rc:pow10 200)) $d) 1 2)))
                            ($scale-exp (+ 130 (* 100 $decade-shifts)))
                            ($s130 (rc:pow10 130))
                            ($scaled-num (* $n (rc:pow10 $scale-exp)))
                            ($q (rc:int-div $scaled-num $d))
                            ($rem (% $scaled-num $d))
                            ($q-hi (if (== $rem 0) $q (+ $q 1)))
                            ($base-iv
                              (RC:Interval
                                (if (<= $q 0) 0.0 (rc:small-rat-lo $q $s130))
                                (rc:small-rat-hi $q-hi $s130))))
                       (rc:divide-interval-by-1e100-k $base-iv $decade-shifts)){$decade-shifts $scale-exp $s130 $scaled-num $q $rem $q-hi $base-iv}))){$lim})))

(= (rc:ensure-exact-tree $stree $etree $edirty)
   (if (== $etree RC:NoExactTree)
       (let* (($rrows (rc:slot-all-rat-rows $stree))
              ((RC:PTBuildResult $built $v) (rc:pt-build rat $rrows)))
         ($built $v)){$rrows $built $v}
       (if (== (size-atom $edirty) 0)
           ($etree 0)
           (let* (($rups
                    (map-atom $edirty $idx
                      (let ($cc $ws) (rc:slot-get $stree $idx)
                        ($idx (rc:local-rows-rat $cc $ws)))))
                  ((RC:PTUpdateResult $updated $v) (rc:pt-update-batch rat $etree $rups)))
             ($updated $v)){$rups $updated $v})))

; Exact BigInt rational query readout: returns (RC:QueryOutcome $answer $engine2)
(= (rc:query-exact-stateful $engine $query)
   (if (rc:unsupported? $engine) (RC:QueryOutcome $engine $engine)
     (let (RC:Engine $prepared $stree $sh-state $fvalid $ftree $etree $edirty $lastv $fb) $engine
       (let (RC:Prepared $prog $width $fams $nidx $scases $cols $pqs $ccomps) $prepared
         (let (RC:Program $boundary $shared $raw-comps) $prog
           (let $qkey (rc:parse-query $boundary $query)
             (if (rc:unsupported? $qkey)
                 (RC:QueryOutcome $qkey $engine)
                 (let $pq (rc:find-prepared-query $qkey $pqs)
                   (if (== $pq RC:QueryNotPrepared)
                       (RC:QueryOutcome (RC:Unsupported undeclared-query $query) $engine)
                       (let* (((RC:PreparedQuery $k $ecoeffs $fmat $cl1) $pq)
                              (($etree2 $ev) (rc:ensure-exact-tree $stree $etree $edirty))
                              ($mixed (rc:mix-shared-rat (rc:pt-vec $etree2) $scases (size-atom $fams) $sh-state))
                              (($num-r $den-r) (rc:extract-rat $mixed $nidx $ecoeffs))
                              ((Rat $dn $dd) $den-r)
                              ($engine2
                                (RC:Engine $prepared $stree $sh-state $fvalid $ftree $etree2 () $lastv $fb)))
                         (if (== $dn 0)
                             (RC:QueryOutcome RC:ImpossibleEvidence $engine2)
                             (let $ans-rat (rc:rat-div $num-r $den-r)
                               (RC:QueryOutcome (RC:ExactAnswer $ans-rat) $engine2)){$ans-rat})){$k $ecoeffs $fmat $cl1 $etree2 $ev $mixed $num-r $den-r $dn $dd $engine2})){$pq})){$qkey}){$boundary $shared $raw-comps}){$prog $width $fams $nidx $scases $cols $pqs $ccomps}){$prepared $stree $sh-state $fvalid $ftree $etree $edirty $lastv $fb}))

(= (rc:query-exact $engine $query)
   (let (RC:QueryOutcome $ans $eng2) (rc:query-exact-stateful $engine $query) $ans))

; Primary two-tier query: O(1) root f64 tensor readout with compositional Higham
; enclosure, falling back automatically to exact BigInt rationals whenever needed.
(= (rc:query-stateful $engine $query)
   (if (rc:unsupported? $engine) (RC:QueryOutcome $engine $engine)
     (let (RC:Engine $prepared $stree $sh-state $fvalid $ftree $etree $edirty $lastv $fb) $engine
       (let (RC:Prepared $prog $width $fams $nidx $scases $cols $pqs $ccomps) $prepared
         (let (RC:Program $boundary $shared $raw-comps) $prog
           (let $qkey (rc:parse-query $boundary $query)
             (if (rc:unsupported? $qkey)
                 (RC:QueryOutcome $qkey $engine)
                 (let $pq (rc:find-prepared-query $qkey $pqs)
                   (if (== $pq RC:QueryNotPrepared)
                       (RC:QueryOutcome (RC:Unsupported undeclared-query $query) $engine)
                       (let (RC:PreparedQuery $k $ecoeffs $extract-mat $coeff-l1) $pq
                         (if $fvalid
                             (let* (($n-fam   (size-atom $fams))
                                    ($n-sh    (size-atom $shared))
                                    ($n-comps (rc:pt-count $ftree)))
                               (case (rc:mix-shared-f64 (rc:pt-entry $ftree) $scases $n-fam $n-sh $sh-state)
                                 (((RC:F64Mixed $mixed-t $mix-steps $ub-mixed)
                                   (let* (($ext-t (tensor:matvec $extract-mat $mixed-t))
                                          ($num   (rc:tensor-scalar $ext-t 0))
                                          ($amp   (rc:tensor-scalar $ext-t 1))
                                          ($den   (rc:tensor-scalar $mixed-t $nidx))
                                          ($m-total (+ $mix-steps (+ $n-fam 2)))
                                          ($uflow-count (+ $n-comps (+ (* 2 $scases) $n-fam))))
                                     (case (rc:try-f64-enclosure
                                             $num $den $amp $m-total $ub-mixed $uflow-count $coeff-l1)
                                       (((RC:EnclosureOk $interval)
                                         (RC:QueryOutcome (RC:Answer $interval none false) $engine))
                                        (RC:NeedsFallback
                                         (rc:run-fallback $engine $query)))){$interval}){$ext-t $num $amp $den $m-total $uflow-count})
                                  (RC:F64OutOfRange
                                   (rc:run-fallback $engine $query)))){$mixed-t $mix-steps $ub-mixed}){$n-fam $n-sh $n-comps}
                             (rc:run-fallback $engine $query))){$k $ecoeffs $extract-mat $coeff-l1})){$pq})){$qkey}){$boundary $shared $raw-comps}){$prog $width $fams $nidx $scases $cols $pqs $ccomps}){$prepared $stree $sh-state $fvalid $ftree $etree $edirty $lastv $fb}))

(= (rc:run-fallback $engine $query)
   (let (RC:Engine $prepared $stree $sh-state $fvalid $ftree $etree $edirty $lastv $fb) $engine
     (let $bumped
          (RC:Engine $prepared $stree $sh-state $fvalid $ftree $etree $edirty $lastv (+ $fb 1))
       (let (RC:QueryOutcome $exact-out $eng2) (rc:query-exact-stateful $bumped $query)
         (case $exact-out
           ((RC:ImpossibleEvidence
             (RC:QueryOutcome RC:ImpossibleEvidence $eng2))
            ((RC:ExactAnswer $rat)
             (RC:QueryOutcome (RC:Answer (rc:rat->interval $rat) $rat true) $eng2))
            ($other
             (RC:QueryOutcome $other $eng2))))))))

(= (rc:query $engine $query)
   (let (RC:QueryOutcome $ans $eng2) (rc:query-stateful $engine $query) $ans))

; Introspection helpers for tests, allocation/sharing checks & diagnostics
(= (rc:engine-prepared (RC:Engine $p $st $sh $fv $ft $et $ed $lv $fb)) $p)
(= (rc:engine-tree (RC:Engine $p $st $sh $fv $ft $et $ed $lv $fb)) $ft)
(= (rc:engine-last-visits (RC:Engine $p $st $sh $fv $ft $et $ed $lv $fb)) $lv)
(= (rc:engine-fallbacks (RC:Engine $p $st $sh $fv $ft $et $ed $lv $fb)) $fb)
(= (rc:prepared-family-count (RC:Prepared $prog $w $fams $ni $sc $cols $pqs $ccs)) (size-atom $fams))
(= (rc:prepared-columns (RC:Prepared $prog $w $fams $ni $sc $cols $pqs $ccs)) $cols)
