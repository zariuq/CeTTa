; ── ordinary data helpers ─────────────────────────────────────────────────

; The empty context <0, [], []>.
(= (mg:empty-context) (Megalodon.context 0 (types) (hypotheses)))

; The two parts of (Megalodon.theory THEORY AUTHORITY).
(= (mg:use $pair) (let (Megalodon.theory $theory $authority) $pair $theory))
(= (mg:authority $pair) (let (Megalodon.theory $theory $authority) $pair $authority))

; (let $v (mg:new-theory PROFILE) (new-state $v)), for a bind! name that
; holds one theory in every dialect: !(bind! &th (mg:new-theory-state egal))
; and then (get-state &th).
(= (mg:new-theory-state $profile) (let $pair (mg:new-theory $profile) (new-state $pair)))

; The hypotheses of a context, innermost first.
(= (mg:hypotheses (Megalodon.context $depth $types $hypotheses)) (cdr-atom $hypotheses))

; ── tactics ──────────────────────────────────────────────────────────────
; A tactic is data, run by (mg:run TACTIC THEORY CONTEXT GOAL).  Its answer
; is a theorem of CONTEXT |- GOAL up to conversion (a theorem states the
; kernel's proposition, which may be GOAL's normal form); no answer when it
; finds no proof.  Tactics are untrusted search: every theorem comes from a
; checked native rule, a refused rule gives no answer, and nothing else
; becomes a theorem.
;   Tac.assumption            a hypothesis convertible with the goal
;   (Tac.exact THEOREM)       THEOREM, when it states the goal in CONTEXT
;   (Tac.intro TACTIC)        introduce the goal's implication, term or type
;                             binder (unfolding definitions if need be) and
;                             prove the body by TACTIC
;   (Tac.intros TACTIC)       introduce every leading binder, then TACTIC
;   (Tac.apply SOURCE TACTIC) backchain: SOURCE states P1 -> .. -> Pn -> GOAL;
;                             TACTIC proves each Pi
;   (Tac.first TACTIC TACTIC) the first tactic with an answer
;   (Tac.auto DEPTH (lemmas NAME ..))
;                             assumption, introduction and backchaining on
;                             the hypotheses and the named knowns, at most
;                             DEPTH backchaining steps deep
; A SOURCE is (From.hyp I), (From.known NAME), (From.theorem THEOREM),
; (From.instance SOURCE (terms M ..)) or (From.type-instance SOURCE (types A ..)).

(= (mg:run $tactic $theory $context $goal)
   (case $tactic
     ((Tac.assumption (mg:assumption $theory $context $goal))
      ((Tac.exact $given) (mg:exact $theory $context $goal $given))
      ((Tac.intro $body-tactic) (mg:intro $theory $context $goal $body-tactic))
      ((Tac.intros $body-tactic) (mg:intros $theory $context $goal $body-tactic))
      ((Tac.apply $source $premise-tactic) (mg:apply $theory $context $goal $source $premise-tactic))
      ((Tac.first $one $two) (mg:first $theory $context $goal $one $two))
      ((Tac.auto $depth $lemmas) (mg:auto $theory $context $goal $depth $lemmas))
      ($other (Error (mg:run $other) (MegalodonMalformed "unknown tactic"))))){$body-tactic})

; The first answer of ONE, else TWO's.
(= (mg:first $theory $context $goal $one $two)
   (let $found (collapse (mg:run $one $theory $context $goal))
     (if (== $found ()) (mg:run $two $theory $context $goal) (car-atom $found))))

; assumption: the innermost hypothesis convertible with GOAL.
(= (mg:assumption $theory $context $goal)
   (mg:assumption-at $theory $context $goal (mg:hypotheses $context) 0))
(= (mg:assumption-at $theory $context $goal $rest $index)
   (if (== $rest ())
       (empty)
       (case (mg:try-convertible $theory $context (car-atom $rest) $goal)
         (((Error $call $why) (empty))
          ($same (if $same
                     (mg:hyp $theory $context $index)
                     (mg:assumption-at $theory $context $goal (cdr-atom $rest) (+ $index 1)))))){$call $why $same}))

; exact: a theorem already in hand.
(= (mg:exact $theory $context $goal $theorem)
   (if (== (mg:context $theorem) $context)
       (case (mg:try-convertible $theory $context (mg:proposition $theorem) $goal)
         (((Error $call $why) (empty))
          ($same (if $same $theorem (empty))))){$call $why $same}
       (empty)))

; intro: one binder of the goal, closed by the matching checked rule.
(= (mg:intro $theory $context $goal $tactic)
   (case $goal
     (((Tm.imp $antecedent $consequent)
       (mg:intro-imp $theory $context $antecedent $consequent $tactic))
      ((Tm.all $type $body) (mg:intro-all $theory $context $type $body $tactic))
      ((Tm.typeAll $body) (mg:intro-type $theory $context $body $tactic))
      ($other (mg:intro-unfolded $theory $context $other $tactic)))){$body})
(= (mg:intro-unfolded $theory $context $goal $tactic)
   (case (mg:try-normalize $theory $goal)
     (((Error $call $why) (empty))
      ($normal (if (== $normal $goal) (empty) (mg:intro $theory $context $normal $tactic))))))
(= (mg:intro-imp $theory $context $antecedent $consequent $tactic)
   (case (mg:try-proof-binder $theory $context $antecedent)
     (((Error $call $why) (empty))
      ($inner (mg:close-imp (mg:run $tactic $theory $inner $consequent) $antecedent)))))
(= (mg:close-imp $theorem $antecedent)
   (case (mg:try-proof-lam-of $theorem $antecedent)
     (((Error $call $why) (empty)) ($closed $closed))))
(= (mg:intro-all $theory $context $type $body $tactic)
   (case (mg:try-term-binder $theory $context $type)
     (((Error $call $why) (empty))
      ($inner (mg:close-all (mg:run $tactic $theory $inner $body) $type)))))
(= (mg:close-all $theorem $type)
   (case (mg:try-term-lam-at $theorem $type)
     (((Error $call $why) (empty)) ($closed $closed))))
(= (mg:intro-type $theory $context $body $tactic)
   (case (mg:try-type-binder $theory $context)
     (((Error $call $why) (empty))
      ($inner (mg:close-type (mg:run $tactic $theory $inner $body))))))
(= (mg:close-type $theorem)
   (case (mg:try-type-lam $theorem)
     (((Error $call $why) (empty)) ($closed $closed))))

; intros: every leading binder.
(= (mg:intros $theory $context $goal $tactic)
   (case $goal
     (((Tm.imp $a $b) (mg:intro $theory $context $goal (Tac.intros $tactic)))
      ((Tm.all $a $b) (mg:intro $theory $context $goal (Tac.intros $tactic)))
      ((Tm.typeAll $b) (mg:intro $theory $context $goal (Tac.intros $tactic)))
      ($other (mg:run $tactic $theory $context $other)))){$a $b})

; Sources of backchaining.
(= (mg:source $theory $context $source)
   (case $source
     (((From.hyp $index)
       (case (mg:try-hyp $theory $context $index) (((Error $call $why) (empty)) ($h $h))){$call $why $h})
      ((From.known $name)
       (case (mg:try-known-in $theory $context $name) (((Error $call $why) (empty)) ($k $k))){$call $why $k})
      ((From.theorem $given) $given)
      ((From.instance $inner $terms)
       (mg:instantiate (mg:source $theory $context $inner) (cdr-atom $terms)))
      ((From.type-instance $inner $types)
       (mg:instantiate-types (mg:source $theory $context $inner) (cdr-atom $types)))
      ($other (Error (mg:source $other) (MegalodonMalformed "unknown source"))))){$inner})

; THEOREM instantiated at terms M .. (termApp), and at types A .. (typeApp),
; in order.
(= (mg:instantiate $theorem $terms)
   (if (== $terms ())
       $theorem
       (case (mg:try-term-app $theorem (car-atom $terms))
         (((Error $call $why) (empty))
          ($next (mg:instantiate $next (cdr-atom $terms))))){$call $why $next}))
(= (mg:instantiate-types $theorem $types)
   (if (== $types ())
       $theorem
       (case (mg:try-type-app $theorem (car-atom $types))
         (((Error $call $why) (empty))
          ($next (mg:instantiate-types $next (cdr-atom $types))))){$call $why $next}))

; apply: modus ponens on SOURCE's premises until its conclusion is GOAL.
(= (mg:apply $theory $context $goal $source $tactic)
   (mg:backchain $theory $context $goal (mg:source $theory $context $source) $tactic))
(= (mg:backchain $theory $context $goal $theorem $tactic)
   (let $prop (mg:proposition $theorem)
     (case (mg:try-convertible $theory $context $prop $goal)
       (((Error $call $why) (empty))
        ($same (if $same
                   $theorem
                   (mg:backchain-premise $theory $context $goal $theorem $prop $tactic)))))))
(= (mg:backchain-premise $theory $context $goal $theorem $prop $tactic)
   (case $prop
     (((Tm.imp $premise $rest)
       (case (mg:try-proof-app $theorem (mg:run $tactic $theory $context $premise))
         (((Error $call $why) (empty))
          ($next (mg:backchain $theory $context $goal $next $tactic)))){$call $why $next})
      ($other (empty)))))

; auto: a short composite search.
(= (mg:auto $theory $context $goal $depth $lemmas)
   (if (< $depth 1)
       (empty)
       (let $assumed (collapse (mg:assumption $theory $context $goal))
         (if (== $assumed ())
             (let $introduced (collapse (mg:intro $theory $context $goal (Tac.auto $depth $lemmas)))
               (if (== $introduced ())
                   (mg:auto-hyps $theory $context $goal (- $depth 1) $lemmas
                                 (mg:hypotheses $context) 0)
                   (car-atom $introduced))){$introduced}
             (car-atom $assumed))){$assumed}))
(= (mg:auto-hyps $theory $context $goal $depth $lemmas $rest $index)
   (if (== $rest ())
       (mg:auto-lemmas $theory $context $goal $depth $lemmas (cdr-atom $lemmas))
       (let $found (collapse (mg:apply $theory $context $goal (From.hyp $index)
                                       (Tac.auto $depth $lemmas)))
         (if (== $found ())
             (mg:auto-hyps $theory $context $goal $depth $lemmas (cdr-atom $rest) (+ $index 1))
             (car-atom $found))){$found}))
(= (mg:auto-lemmas $theory $context $goal $depth $lemmas $rest)
   (if (== $rest ())
       (empty)
       (let $found (collapse (mg:apply $theory $context $goal (From.known (car-atom $rest))
                                       (Tac.auto $depth $lemmas)))
         (if (== $found ())
             (mg:auto-lemmas $theory $context $goal $depth $lemmas (cdr-atom $rest))
             (car-atom $found))){$found}))

; Prove a closed CLAIM by TACTIC and publish it as the known NAME.
(= (mg:prove-by $theory $name $claim $tactic)
   (let $found (collapse (mg:run $tactic $theory (mg:empty-context) $claim))
     (if (== $found ())
         (Error (mg:prove-by $name $claim) (MegalodonUnproved "the tactic found no proof"))
         (mg:publish-claim $theory (car-atom $found) $name $claim))))
