; Reusable Prime curriculum library. Fixtures import this module. Its
; proofs run in &curriculum and do not replace a fixture's &thy.
!(import! &self ../pf.metta)
!(bind! &curriculum (new-space))
!(set:inductive &curriculum bool (u 0) (: true bool) (: false bool))
!(set:inductive &curriculum nat (u 0) (: zero nat) (: succ (-> nat nat)))
!(pf:equality &curriculum bool refl@bool subst@bool)
!(pf:equality &curriculum nat refl@nat subst@nat)
!(set:define &curriculum truth prop (= truth (all prop (lam p (imp p p)))))
!(set:define &curriculum falsum prop (= falsum (all prop (lam p p))))
!(set:define &curriculum and (-> prop prop prop) (= (and $p $q) (all prop (lam r (imp (imp $p (imp $q r)) r)))))
!(set:inductive &curriculum pair (u 0) (: mkpair (-> nat bool pair)))
!(set:define &curriculum proj1 (-> pair nat) (= (proj1 (mkpair $a $b)) $a))
!(pf:equality &curriculum pair refl@pair subst@pair)
!(pf:theorem &curriculum and-elim-l (all prop (lam p (all prop (lam q (imp (and p q) p))))) (pf:fix p (pf:fix q (pf:assume h (pf:imp-elim (pf:all-elim h p) (pf:assume hp (pf:assume hq hp)))))))
!(pf:theorem &curriculum eq-refl (all bool (lam x (eq bool x x))) (pf:fix x (pf:refl bool x)))
!(pf:theorem &curriculum cong (all (-> nat nat) (lam f (all nat (lam x (all nat (lam y (imp (eq nat x y) (eq nat (f x) (f y))))))))) (pf:fix f (pf:fix x (pf:fix y (pf:assume h (pf:cong nat nat f x y h))))))
!(pf:theorem &curriculum pair-proj (all nat (lam a (all bool (lam b (eq nat (proj1 (mkpair a b)) a))))) (pf:fix a (pf:fix b (pf:refl nat a))))
!(pf:theorem &curriculum neg-unproved (all prop (lam p p)) (pf:fix p (pf:assume h h)))
!(pf:theorem &curriculum neg-wrong-exact (all prop (lam a (all prop (lam b (imp a b))))) (pf:fix a (pf:fix b (pf:assume h h))))
!(pf:theorem &curriculum neg-falsum falsum (pf:assume h h))
!(set:define &curriculum add (-> nat nat nat) (= (add zero $n) $n) (= (add (succ $m) $n) (succ (add $m $n))))
!(pf:theorem &curriculum add-sz (eq nat (add zero (succ zero)) (succ zero)) (pf:refl nat (succ zero)))
!(pf:theorem &curriculum add-two (eq nat (add (succ (succ zero)) (succ zero)) (succ (succ (succ zero)))) (pf:refl nat (succ (succ (succ zero)))))
!(pf:theorem &curriculum add-swap (eq nat (add (succ zero) (succ (succ zero))) (add (succ (succ zero)) (succ zero))) (pf:refl nat (add (succ (succ zero)) (succ zero))))
!(set:inductive &curriculum list (u 0) (: nil list) (: cons (-> nat list list)))
!(pf:equality &curriculum list refl@list subst@list)
!(set:define &curriculum append (-> list list list) (= (append nil $k) $k) (= (append (cons $x $l) $k) (cons $x (append $l $k))))
!(set:define &curriculum rev (-> list list) (= (rev nil) nil) (= (rev (cons $x $l)) (append (rev $l) (cons $x nil))))
!(pf:theorem &curriculum append-ex (eq list (append (cons zero (cons (succ zero) nil)) (cons (succ (succ zero)) nil)) (cons zero (cons (succ zero) (cons (succ (succ zero)) nil)))) (pf:refl list (cons zero (cons (succ zero) (cons (succ (succ zero)) nil)))))
!(pf:theorem &curriculum rev-ex (eq list (rev (cons zero (cons (succ zero) (cons (succ (succ zero)) nil)))) (cons (succ (succ zero)) (cons (succ zero) (cons zero nil)))) (pf:refl list (cons (succ (succ zero)) (cons (succ zero) (cons zero nil)))))
!(set:define &curriculum andb (-> bool bool bool) (= (andb true $y) $y) (= (andb false $y) false))
!(set:define &curriculum notb (-> bool bool) (= (notb true) false) (= (notb false) true))
!(set:define &curriculum is-zero (-> nat bool) (= (is-zero zero) true) (= (is-zero (succ $n)) false))
!(set:define &curriculum predn (-> nat nat) (= (predn zero) zero) (= (predn (succ $n)) $n))
!(set:define &curriculum if-zero (-> nat nat nat nat) (= (if-zero zero $z $s) $z) (= (if-zero (succ $n) $z $s) $s))
!(set:define &curriculum subk (-> nat nat nat) (= (subk zero $n) $n) (= (subk (succ $m) $n) (if-zero $n zero (subk $m (predn $n)))))
!(set:define &curriculum nat-eqb (-> nat nat bool) (= (nat-eqb $n $m) (andb (is-zero (subk $n $m)) (is-zero (subk $m $n)))))
!(set:define &curriculum leb (-> nat nat bool) (= (leb $n $m) (is-zero (subk $m $n))))
!(pf:theorem &curriculum nat-eqb-22 (eq bool (nat-eqb (succ (succ zero)) (succ (succ zero))) true) (pf:refl bool true))
!(pf:theorem &curriculum nat-eqb-23 (eq bool (nat-eqb (succ (succ zero)) (succ (succ (succ zero)))) false) (pf:refl bool false))
!(set:inductive &curriculum decision (u 0) (: yesd decision) (: nod decision))
!(pf:equality &curriculum decision refl@decision subst@decision)
!(set:define &curriculum and-yes (-> decision decision) (= (and-yes yesd) yesd) (= (and-yes nod) nod))
!(set:define &curriculum sumbool-and (-> decision decision decision) (= (sumbool-and yesd $b) (and-yes $b)) (= (sumbool-and nod $b) nod))
!(pf:theorem &curriculum sumbool-and-yes (eq decision (sumbool-and yesd yesd) yesd) (pf:refl decision yesd))
!(set:define &curriculum four-witness nat (= four-witness (succ (succ zero))))
!(pf:theorem &curriculum four-cert (eq nat (add four-witness four-witness) (succ (succ (succ (succ zero))))) (pf:refl nat (succ (succ (succ (succ zero))))))
!(pf:theorem &curriculum sig-val-four (eq nat four-witness (succ (succ zero))) (pf:refl nat (succ (succ zero))))
!(set:define &curriculum sigma-pair pair (= sigma-pair (mkpair (succ (succ (succ zero))) true)))
!(pf:theorem &curriculum sigma-pair-fst (eq nat (proj1 sigma-pair) (succ (succ (succ zero)))) (pf:refl nat (succ (succ (succ zero)))))
!(set:define &curriculum witness-three nat (= witness-three (succ (succ (succ zero)))))
!(pf:theorem &curriculum witness-three-val (eq nat witness-three (succ (succ (succ zero)))) (pf:refl nat (succ (succ (succ zero)))))
!(set:define &curriculum mul (-> nat nat nat) (= (mul zero $m) zero) (= (mul (succ $n) $m) (add $m (mul $n $m))))
!(set:inductive &curriculum aexp (u 0) (: anum (-> nat aexp)) (: avar (-> nat aexp)) (: aplus (-> aexp aexp aexp)) (: aminus (-> aexp aexp aexp)) (: amult (-> aexp aexp aexp)))
!(set:define &curriculum aeval (-> (-> nat nat) aexp nat) (= (aeval $st (anum $n)) $n) (= (aeval $st (avar $x)) ($st $x)) (= (aeval $st (aplus $a $b)) (add (aeval $st $a) (aeval $st $b))) (= (aeval $st (aminus $a $b)) (subk (aeval $st $b) (aeval $st $a))) (= (aeval $st (amult $a $b)) (mul (aeval $st $a) (aeval $st $b))))
!(set:inductive &curriculum bexp (u 0) (: btrue bexp) (: bfalse bexp) (: beq (-> aexp aexp bexp)) (: ble (-> aexp aexp bexp)) (: bnot (-> bexp bexp)) (: band (-> bexp bexp bexp)))
!(set:define &curriculum beval (-> (-> nat nat) bexp bool) (= (beval $st btrue) true) (= (beval $st bfalse) false) (= (beval $st (beq $a $b)) (nat-eqb (aeval $st $a) (aeval $st $b))) (= (beval $st (ble $a $b)) (leb (aeval $st $a) (aeval $st $b))) (= (beval $st (bnot $b)) (notb (beval $st $b))) (= (beval $st (band $a $b)) (andb (beval $st $a) (beval $st $b))))
!(pf:theorem &curriculum aeval-plus (eq nat (aeval (lam x (succ (succ zero))) (aplus (avar zero) (anum (succ zero)))) (succ (succ (succ zero)))) (pf:refl nat (succ (succ (succ zero)))))
!(pf:theorem &curriculum beval-eq (eq bool (beval (lam x (succ (succ zero))) (beq (avar zero) (anum (succ (succ zero))))) true) (pf:refl bool true))
!(pf:theorem &curriculum nat-eqb-refl (all nat (lam n (eq bool (nat-eqb n n) true))) (pf:induction nat-ind (lam n (eq bool (nat-eqb n n) true)) (pf:refl bool true) (pf:fix k (pf:assume ih ih))))
!(set:define &curriculum if-bool (-> bool nat nat nat) (= (if-bool true $a $b) $a) (= (if-bool false $a $b) $b))
!(set:define &curriculum state (u 0) (= state (-> nat nat)))
!(set:define &curriculum empty (-> nat nat) (= empty (lam x zero)))
!(set:define &curriculum update (-> (-> nat nat) nat nat (-> nat nat)) (= (update $st $x $v) (lam y (if-bool (nat-eqb $x y) $v ($st y)))))
!(set:define &curriculum read-state (-> (-> nat nat) nat nat) (= (read-state $st $x) ($st $x)))
!(pf:theorem &curriculum empty-zero (eq nat (read-state empty zero) zero) (pf:refl nat zero))
!(pf:theorem &curriculum update-hit (eq nat (read-state (update empty zero (succ zero)) zero) (succ zero)) (pf:refl nat (succ zero)))
!(set:inductive &curriculum com (u 0) (: cskip com) (: casgn (-> nat aexp com)) (: cseq (-> com com com)) (: cif (-> bexp com com com)) (: cwhile (-> bexp com com)))
!(set:define &curriculum prog com (= prog (cseq (casgn zero (anum (succ (succ zero)))) (casgn (succ zero) (aplus (avar zero) (anum (succ zero)))))))
