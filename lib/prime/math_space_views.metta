; Bounded, revision-bound views for mathematical programming clients.
; Stored attempts describe past checks. Use math:goal-status for a fresh one.
(scope:profile lexical-fresh per-call reference)
!(import! &self "./math_space_store.metta")

(= (math:view-key $project)
   (let* (($scope (math:theory-key $project)) ($records (math:records $project))
          ($revision (_minimal-space-revision $records)))
     (Math:ViewKey $scope $revision)))
(= (math:view-row $section $row)
   (case ($section $row)
     ((("goals" (Math:Goal $id $kind $statement $description)) (math:singleton $row))
      (("candidates" (Math:Candidate $id $goal $strategy $key $proof)) (math:singleton $row))
      (("attempts" (Math:Attempt $id $goal $strategy $key $proof $verdict $raw))
        ((Math:ObservedAttempt $id $goal $strategy $key $verdict)))
      (("history" (Math:PriorAttempt $id $goal $strategy $key $proof $verdict $raw))
        ((Math:HistoricalAttempt $id $goal $strategy $verdict)))
      (("notes" (Math:Note $id $text $sources)) (math:singleton $row))
      (("links" (Math:Link $source $relation $target)) (math:singleton $row))
      (("publications" (Math:Event $index (Math:Publication $name $goal $kind $statement $proof)))
        ((Math:RecordedPublication $name $goal $kind $statement)))
      ($other ()))))
(= (math:view-rows $project $section)
   (if (== $section "definitions")
     (let* (($theory (math:theory $project))
            ($rows (new ($name $statement $origin $proof $deps $revision $signature)
              (collapse (match $theory
                (hol:known $name $statement $origin $proof $deps $revision $signature)
                (Math:Declaration $name $statement $origin $deps)))))) $rows)
     (let* (($records (math:records $project)) ($rows (collapse (get-atoms $records))))
       (foldl-atom $rows () $all $row
         (union-atom $all (math:view-row $section $row))))))
(= (math:section? $section)
   (case $section
     (("definitions" True) ("goals" True) ("candidates" True)
      ("attempts" True) ("history" True) ("notes" True) ("links" True)
      ("publications" True) ($other False))))
(= (math:drop $rows $count)
   (if (or (== $count 0) (== $rows ())) $rows
     (let* (($tail (cdr-atom $rows)) ($next (- $count 1))) (math:drop $tail $next))))
(= (math:take $rows $count)
   (if (or (== $count 0) (== $rows ())) ()
     (let* ((($head $tail) (decons-atom $rows)) ($next (- $count 1))
            ($rest (math:take $tail $next))) (cons-atom $head $rest))))
(= (math:render $value $characters)
   (let* (($text (repr $value)) ($digest (str:sha256 $text))
          ($length (str:char-length $text)))
     (if (<= $length $characters) (Math:Text $digest $length complete $text)
       (let $prefix (str:char-slice $text 0 $characters)
         (Math:Text $digest $length clipped $prefix)))))
(= (math:render-rows $rows $characters)
   (case $rows
     ((() ())
      ($some (let* ((($head $tail) (decons-atom $some))
                     ($entry (math:render $head $characters))
                     ($rest (math:render-rows $tail $characters)))
               (cons-atom $entry $rest))))))
(= (math:cursor-offset $key $section $cursor)
   (case $cursor
     ((start (Math:Offset 0))
      ((Math:Cursor $previous $stored-section $offset)
        (if (and (=alpha $previous $key) (== $stored-section $section))
          (if (math:natural? $offset) (Math:Offset $offset) (Math:Refused invalid-cursor))
          (Math:Stale cursor view-changed)))
      ($other (Math:Refused invalid-cursor)))))
(= (math:view-at $project $section $key $offset $limit $characters)
   (let* (($rows (math:view-rows $project $section)) ($total (size-atom $rows))
          ($remaining (math:drop $rows $offset)) ($selected (math:take $remaining $limit))
          ($items (math:render-rows $selected $characters))
          ($next (+ $offset (size-atom $selected))) ($after (math:view-key $project)))
     (if (=alpha $key $after)
       (Math:Page $section $key $total $offset $items
         (if (< $next $total) (Math:Cursor $key $section $next) end))
       (Math:Stale cursor view-changed))))
(= (math:view $project $section $cursor $limit $characters)
   (if (and (math:section? $section)
            (and (math:natural? $limit) (and (> $limit 0)
                 (and (math:natural? $characters) (> $characters 0)))))
     (let $key (math:view-key $project)
       (case (math:cursor-offset $key $section $cursor)
         (((Math:Offset $offset) (math:view-at $project $section $key $offset $limit $characters))
          ($other $other))))
     (Math:Refused invalid-view-arguments)))
(= (math:summary $project)
   (let* (($name (math:name $project)) ($key (math:view-key $project))
          ($goals (math:view-rows $project "goals")) ($goal-count (size-atom $goals))
          ($candidates (math:view-rows $project "candidates")) ($candidate-count (size-atom $candidates))
          ($attempts (math:view-rows $project "attempts")) ($attempt-count (size-atom $attempts))
          ($publications (math:view-rows $project "publications")) ($publication-count (size-atom $publications)))
     (Math:Workspace $name $key (goals $goal-count) (candidates $candidate-count)
       (observed-attempts $attempt-count) (recorded-publications $publication-count))))
(= (math:read-entry $project $section $key $characters)
   (if (and (math:natural? $characters) (> $characters 0))
     (let $value
       (case $section
         (("goals" (math:goal-entry $project $key))
          ("candidates" (math:candidate-entry $project $key))
          ("attempts" (math:attempt-entry $project $key))
          ("history" (math:prior-attempt $project $key))
          ($other (Math:Refused unknown-record-section))))
       (case $value
         (((Math:Refused $reason) $value)
          ($other (math:render $value $characters)))))
     (Math:Refused invalid-read-arguments)))

; The CommandSpec shape is shared with GödelClaw's discovery API. Importing
; these facts describes commands; it does not invoke them or grant authority.
(CommandSpec 1 "math" "math:summary" 1 1 "(math:summary project)" "Inspect workspace counts and current revision." "")
(CommandSpec 1 "math" "math:view" 5 5 "(math:view project section cursor rows characters)" "Retrieve a bounded page; changed scopes expire cursors." "")
(CommandSpec 1 "math" "math:goal" 5 5 "(math:goal project id checker quoted-statement description)" "Record a conjecture, without asserting it." "")
(CommandSpec 1 "math" "math:propose" 5 5 "(math:propose project id goal strategy quoted-proof)" "Record proposed evidence as data." "")
(CommandSpec 1 "math" "math:check" 3 3 "(math:check project candidate budget)" "Check a candidate against its exact current task." "")
(CommandSpec 1 "math" "math:publish" 4 4 "(math:publish project attempt theorem-name budget)" "Recheck evidence and publish through the selected native checker." "")
(CommandSpec 1 "math" "math:goal-status" 3 3 "(math:goal-status project goal budget)" "Check a recorded publication against the current goal." "")
(CommandSpec 1 "math" "math:read-entry" 4 4 "(math:read-entry project section id characters)" "Retrieve named research data, including retained candidate evidence." "")
(CommandSpec 1 "math" "math:declare" 2 2 "(math:declare project quoted-declaration)" "Admit a datatype or definition using the native checker." "")
(CommandSpec 1 "math" "math:run" 2 2 "(math:run project quoted-expression)" "Compute in the admitted scope; unsupported terms remain data." "")
(CommandSpec 1 "math" "math:save" 3 3 "(math:save project path budget)" "Validate and atomically save a checkpoint, detecting concurrent writers." "")
(CommandSpec 1 "math" "math:load" 2 2 "(math:load path budget)" "Reconstruct a fresh scope and recheck published evidence." "")
