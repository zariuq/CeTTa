        ("unsigned" (lang-internal:number $kind $text))
        ($other (LangProtocolErrorV1 ScalarKind $other))))))
(= (lang-internal:number $kind $text)
   (let $value (str:string->number $text)
     (if (langdef:host-value? $kind $value) (LangValueV1 $value) (LangProtocolErrorV1 Scalar $text))))
(= (lang-internal:values $values)
   (case $values
     ((() (LangValuesV1 ()))
      ((cons $head $tail)
        (case ((lang-internal:value $head) (lang-internal:values $tail))
          ((((LangValueV1 $value) (LangValuesV1 $rest)) (LangValuesV1 (cons-atom $value $rest)))
           ($other (LangProtocolErrorV1 Values $other)))){$value $rest $other})
      ($other (LangProtocolErrorV1 Values $other)))){$other})
(= (lang-internal:output $record)
   (let $name (lang-internal:json-field $record "relation")
     (if (langdef:host-value? "string" $name)
       (case (lang-internal:values (lang-internal:json-array (lang-internal:json-field $record "values")))
         (((LangValuesV1 $values) (LangValueV1 (cons-atom (str:string->symbol $name) $values)))
          ($other $other))){$values $other}
       (LangProtocolErrorV1 Relation $record))))
(= (lang-internal:outputs $outputs)
   (case $outputs
     ((() (LangOutputsV1 ()))
      ((cons $head $tail)
        (case ((lang-internal:output $head) (lang-internal:outputs $tail))
          ((((LangValueV1 $value) (LangOutputsV1 $rest)) (LangOutputsV1 (cons-atom $value $rest)))
           ($other (LangProtocolErrorV1 Outputs $other)))){$value $rest $other})
      ($other (LangProtocolErrorV1 Outputs $other)))){$other})
(= (lang-internal:finish LangIsolatedV1 $outputs)
   (LangStepV1 (LangDoneV1 $outputs)))
(= (lang-internal:finish (LangPublishV1 $output) $outputs)
   (LangStepV1 (LangPublicationV1 $output $outputs $outputs)))

; Each unit below commits at most one fact and retains the remaining list.
; Existing duplicate occurrences are unaffected by insert-if-absent.
(= (lang-internal:publish-unit $destination $head $tail $outputs)
   (case (add-atom-nodup $destination $head)
     ((() (LangStepV1 (LangPublicationV1 $destination $tail $outputs)))
      ($refusal (LangPublicationErrorV1 $destination $head $tail $outputs $refusal)))))

(= (lang-internal:begin-read $language $source $sink $rows $budget)
 (let $cursor (langdef:source-cursor (LangCursorStateV1
       (LangReadV1 $language $source $sink $rows 4000000 65536 4096 NoSourceForestV1)))
   (lang-internal:work $cursor $budget)))

(= (lang-internal:diagnostic $source $error)
   (case $error
     (((LangSourceErrorV1 $message) (LangSourceErrorV1 (SourceDiagnosticV1 $source $message)))
      ($other $other))))
