     (case
       $stored
       (((LangCursorStateV1 $state)
           (case
             $state
             (((LangFailedV1 $retained-state $failure) $failure)
               ((LangDoneV1 $outputs) (LangCompleteV1 $outputs))
               ((LangPublicationV1 $output () $outputs)
                 (let
                   $_
                   (lang-internal:set-cursor $cursor (LangDoneV1 $outputs))
                   (LangCompleteV1 $outputs)){$_})
               ($other
                 (if
                   (== $budget 0)
                   (LangPendingV1 $cursor)
                   (case
                     (lang-internal:unit $state)
                     (((LangStepV1 $next)
                         (let
                           $_
                           (lang-internal:set-cursor $cursor $next)
                           (lang-internal:work $cursor (- $budget 1))){$_})
                       ($failure
                         (let
                           $_
                           (lang-internal:set-cursor $cursor (LangFailedV1 $state $failure))
                           $failure){$_}))){$next $failure})))){$retained-state $failure $outputs $output $other})
         ($other (LangArgumentErrorV1 ContinuationCursor $other)))){$other}))

(= (lang-internal:unit $state)
   (case
     $state
     (((LangReadV1 $language $source $sink $rows $work $results $depth $forest)
         (lang-internal:read $language $source $sink $rows $work $results $depth))
       ((LangVerifyV1 $language $source $sink $rows $values $forest $forest-wire $identity-wire $rounds)
         (lang-internal:verify $language $source $sink $rows $values $forest $forest-wire $identity-wire $rounds))
       ((LangExecutionV1 $language $source $forest $program $wire $dictionary $machine $sink)
         (let
           $answers
           (collapse (evalc (gslt:snapshot:advance $machine 1 100) $program))
           (case
             $answers
             ((($next)
                 (lang-internal:after-tick
                   $language
                   $source
                   $forest
                   $program
                   $wire
                   $dictionary
                   $next
                   $sink))
               ($other (LangRuntimeErrorV1 Step $other)))){$next $other}){$answers})
       ((LangPublicationV1 $output (cons $head $tail) $outputs)
         (lang-internal:publish-unit $output $head $tail $outputs))
       ($other (LangRuntimeErrorV1 State $other)))){$language $source $sink $rows $forest $other})
