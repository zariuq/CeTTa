   (case $machine
     (((SnapshotClosure $status $round $plan $standard $request $metadata $relation $static $facts $keys $history $runner)
        (case $status
          ((SnapshotComplete (lang-internal:observe (lang-internal:components $language) $wire $dictionary $facts $sink))
           (SnapshotPending (LangStepV1 (LangExecutionV1 $language $source $forest $program $wire $dictionary $machine $sink)))
           ($other (LangRuntimeErrorV1 Status $other)))){$other})
      ($other (LangRuntimeErrorV1 State $machine)))){$other})

