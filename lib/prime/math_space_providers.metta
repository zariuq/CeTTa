; Proposal clients for the Mathematics AI ATP API. Responses stay research
; data; checking or transporting a proof is a separate operation.
(scope:profile lexical-fresh per-call reference)
!(import! &self "./math_space_store.metta")
!(import! &self proc)
!(import! &self io)

(= (math:peniel-path $operation)
   (case $operation
     ((tactics "/gnn/predict_tactic") (score "/pln/evaluate") (prove "/prove")
      ($other (Math:Refused unknown-provider-operation)))))
(= (math:peniel-tactics $goal $count)
   (if (and (math:text-id? $goal)
            (and (math:natural? $count) (and (>= $count 1) (<= $count 20))))
     (JsonObject ((JsonPair "goal" $goal) (JsonPair "top_k" $count)))
     (Math:Refused provider-request)))
(= (math:provider-hypotheses? $hypotheses)
   (if (== (get-metatype $hypotheses) Expression)
     (foldl-atom $hypotheses True $valid $hypothesis
       (and $valid (math:text-id? $hypothesis))) False))
(= (math:peniel-score $expression $hypotheses)
   (if (and (math:text-id? $expression) (math:provider-hypotheses? $hypotheses))
     (JsonObject ((JsonPair "expression" $expression) (JsonPair "hypotheses" (JsonArray $hypotheses))))
     (Math:Refused provider-request)))
(= (math:peniel-prove $goal $hypotheses $depth $nodes)
   (if (and (and (math:text-id? $goal) (math:provider-hypotheses? $hypotheses))
            (and (math:natural? $depth) (and (> $depth 0) (and (math:natural? $nodes) (> $nodes 0)))))
     (JsonObject ((JsonPair "goal" $goal) (JsonPair "hypotheses" (JsonArray $hypotheses))
                  (JsonPair "max_depth" $depth) (JsonPair "max_nodes" $nodes)))
     (Math:Refused provider-request)))
(= (math:provider-body $text)
   (let $reply (json:parse $text)
     (if (math:unique-json-object $reply) (Math:ProviderBody $reply)
       (Math:ProviderFault invalid-json))))
(= (math:provider-curl $url $body $milliseconds $bytes)
   (let $observation
     (proc:run ("curl" "--silent" "--show-error" "--fail" "--request" "POST"
                  "--header" "Content-Type: application/json" "--data-binary" "@-" "--" $url)
       ((lifetime owner) (stdin $body) (timeout-ms $milliseconds) (max-bytes $bytes)))
     (case $observation
       (((proc:result (proc:exited 0) proc:normal $out $err
           (proc:capture $seen $kept $es $ek proc:eof proc:eof (proc:input $size $sent)))
          (if (and (== $seen $kept) (and (== $es $ek) (== $size $sent)))
            (math:provider-body $out) (Math:ProviderUnfinished incomplete-capture)))
        ((proc:result $termination proc:timed-out $out $err $capture)
          (Math:ProviderUnfinished deadline))
        ($other (Math:ProviderUnavailable process $observation))))))
(= (math:provider-native-result $result)
   (case $result
     (((http:response $status $text)
        (if (and (>= $status 200) (< $status 300)) (math:provider-body $text)
          (Math:ProviderUnavailable http-status $status)))
      ((Error $call (http:error transport 28 $message)) (Math:ProviderUnfinished deadline))
      ((Error $call (http:error response-too-large $limit)) (Math:ProviderUnfinished response-limit))
      ($other (Math:ProviderUnavailable native-http $other)))))
(= (math:provider-native $url $body $milliseconds $bytes)
   (let $capabilities (io:capabilities)
     (if (== (intersection-atom (http) $capabilities) ())
       (Math:ProviderUnavailable native-http)
       (case (io:submit (http:request "POST" $url ((http:header "Content-Type" "application/json"))
                        $body $milliseconds $bytes))
         (((io:pending $id)
            (case (io:wait $id $milliseconds)
              (((io:event $received $result) (math:provider-native-result $result))
               ($other
                 (chain (io:cancel $id) $cancelled (Math:ProviderUnfinished deadline))))))
          ($other (Math:ProviderUnavailable native-http $other)))))))
(= (math:peniel-call $mode $endpoint $operation $request $milliseconds $bytes)
   (if (and (math:text-id? $endpoint)
            (and (math:unique-json-object $request)
              (and (math:natural? $milliseconds) (and (> $milliseconds 0)
                (and (math:natural? $bytes) (> $bytes 0))))))
     (case (math:peniel-path $operation)
       (((Math:Refused $why) (Math:Refused $why))
        ($path
          (let* (($base (if (str:ends-with $endpoint "/")
                         (str:char-slice $endpoint 0 (- (str:char-length $endpoint) 1)) $endpoint))
                 ($url (str:concat $base $path)) ($body (json:stringify $request))
                 ($result (case $mode
                    ((curl (math:provider-curl $url $body $milliseconds $bytes))
                     (native (math:provider-native $url $body $milliseconds $bytes))
                     ($other (Math:Refused provider-transport))))))
            (case $result
              (((Math:ProviderBody $reply) (Math:ForeignProposal "lean4" $operation $request $reply))
               ($other $other)))))))
     (Math:Refused provider-request)))
(= (math:remember-provider $project $id $source $observation)
   (let* (($code (math:code $observation)) ($sources (math:singleton $source)))
     (math:note $project $id $code $sources)))

(= (math:string-array? $value)
   (case $value
     (((JsonArray $rows)
        (foldl-atom $rows True $valid $row (and $valid (== (std:get-type $row) String))))
      ($other False))))
(= (math:lean-receipt-reply $profile $target $reply)
   (if (and (== (json:get $reply "schema") "ai-math.itp.v1")
            (== (json:get $reply "target") $target))
     (let* (($kind (json:get $reply "kind")) ($reason (json:get $reply "reason")))
       (case $kind
         (("checked"
            (let* (($policy (json:get $reply "policy")) ($statement (json:get $reply "statement"))
                   ($used (json:get $reply "used")) ($axioms (json:get $reply "axioms"))
                   ($levels (json:get $reply "levels")))
              (if (and (== $policy "compiled-source-order")
                       (and (== (std:get-type $statement) String)
                         (and (math:string-array? $used)
                           (and (math:string-array? $axioms) (math:string-array? $levels)))))
                (Math:ForeignReceipt "lean4" $profile $target $reply)
                (Math:ProviderFault receipt-policy))))
          ("unfinished" (Math:ProviderUnfinished $reason))
          ($other
            (case $reason
              (("source-order" (Math:ForeignRejected "lean4" $target $reason))
               ("statement-mismatch" (Math:ForeignRejected "lean4" $target $reason))
               ("inadmissible-certificate-declaration" (Math:ForeignRejected "lean4" $target $reason))
               ("kernel-replay" (Math:ForeignRejected "lean4" $target $reason))
               ("sorry" (Math:ForeignRejected "lean4" $target $reason))
               ("untrusted-axioms" (Math:ForeignRejected "lean4" $target $reason))
               ($other (Math:ProviderUnavailable lean-receipt $reason))))))))
     (Math:ProviderFault receipt-identity)))
(= (math:lean-replay $backend $target $certificate $milliseconds $bytes)
   (case $backend
     (((Math:LeanBackend $guard $library $sysroot $profile)
        (if (and (math:text-id? $target) (and (math:text-id? $certificate)
              (and (math:natural? $milliseconds) (and (> $milliseconds 0)
                (and (math:natural? $bytes) (> $bytes 0))))))
          (let* (($request (JsonObject ((JsonPair "schema" "ai-math.itp.v1")
                   (JsonPair "target" $target) (JsonPair "operation" "check") (JsonPair "profile" $profile))))
                 ($input (json:stringify $request)) ($lean-path (str:concat "LEAN_PATH=" $library))
                 ($lean-sysroot (str:concat "LEAN_SYSROOT=" $sysroot))
                 ($observation (proc:run ("env" $lean-path $lean-sysroot $guard "--certificate" $certificate)
                    ((lifetime owner) (stdin $input) (timeout-ms $milliseconds) (max-bytes $bytes)))))
            (case $observation
              (((proc:result (proc:exited 0) proc:normal $out $err
                  (proc:capture $seen $kept $es $ek proc:eof proc:eof (proc:input $size $sent)))
                 (if (and (== $seen $kept) (and (== $es $ek) (== $size $sent)))
                   (case (math:provider-body $out)
                     (((Math:ProviderBody $reply) (math:lean-receipt-reply $profile $target $reply))
                      ($other $other)))
                   (Math:ProviderUnfinished incomplete-capture)))
               ((proc:result $termination proc:timed-out $out $err $capture)
                 (Math:ProviderUnfinished deadline))
               ($other (Math:ProviderUnavailable lean-receipt-process $observation)))))
          (Math:Refused receipt-request)))
      ($other (Math:Refused receipt-backend)))))
