; Prime demand declarations for the shared native rho execution service.
(scope:profile lexical-fresh per-call reference)
!(import! &self rho)
!(import! &self lts)

(: rhometta:transitions (-> Atom Proc))
(: rhometta:run (-> Atom Proc))
(: rhometta:run-canonical (-> Atom Atom))
(: rhometta:values (-> Proc Atom))
(: rhometta:eval (-> Atom Atom))
(: rhometta:trace-2 (-> Atom Proc))
(: rhometta:is-normal-form (-> Atom Bool))
(: rhometta:is-can-step (-> Atom Bool))

(= (rhometta:eval $payload)
   (rho:eval-payload (quote $payload){$payload}))
(= (rhometta:transitions $state)
   (__cetta_lib_rhometta_transitions $state))
(= (rhometta:run $state)
   (__cetta_lib_rhometta_run $state))
(= (rhometta:run-canonical $state)
   (__cetta_lib_rhometta_run_canonical $state))
(= (rhometta:values $state)
   (__cetta_lib_rhometta_values $state))
(= (rhometta:trace-2 $state)
   (lts:trace-2 rhometta:transitions $state))
(= (rhometta:is-normal-form $state)
   (lts:is-normal-form rhometta:transitions $state))
(= (rhometta:is-can-step $state)
   (lts:is-can-step rhometta:transitions $state))
