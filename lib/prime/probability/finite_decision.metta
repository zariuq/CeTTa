              (let $child (bayes:diagonal-execution $kernel (bayes:lookup $observation $branches) $next)
                ((($next $observation) ($next $observation)) $child))))))
     (bayes:step $table $children)))
(= (bayes:exact-plans $prior $kernel $reward $allowed $plans)
