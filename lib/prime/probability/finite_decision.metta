(= (bayes:metric-covered? () $metric) True)
(= (bayes:metric-covered? $table $metric)
   (let ((($first $second) $mass) $rest) (decons-atom $table)
     (and (if (== $mass 0) True (bayes:metric-has? $metric $first $second))
