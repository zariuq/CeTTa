               (if (<= 0 $weight)
                 (bayes:interval (+ (* $weight $lo) $tailLo) (+ (* $weight $hi) $tailHi))
                 (bayes:interval (+ (* $weight $hi) $tailLo) (+ (* $weight $lo) $tailHi))))
             ($failure $failure))){$tailLo $tailHi $failure}) ($failure $failure))){$failure}))
