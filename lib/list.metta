; Finite sequences: the children of an ordinary expression, or the elements
; of a list value.  An operation given a list value returns a list value and
; one given an expression returns an expression; append and the other
; operations over two sequences return the kind of the first.
;
; Algebraic domain: list operations range over Expression atoms and list
; values, each identified with the free monoid of finite Atom sequences. On
; that domain:
;   append has the empty sequence as identity and is associative;
;   reverse is an involution and preserves length;
;   cons/first/rest satisfy first(cons x xs)=x and rest(cons x xs)=xs.
; first, rest, at, and cons retain the native partiality of car-atom,
; cdr-atom, index-atom, and cons-atom outside their stated domains.

; Group numeric pairs in first-key order, reducing each key's occurrences
; in their input order, starting from integer zero. This does not reassociate
; floating-point additions. Unsupported values and integer overflow restart
; through the authored fold before any native result is published.
(: __cetta_lib_list_group_sums (-> Atom Atom))
(: __cetta_lib_list_group_sums_blocks (-> Atom Atom))
(= (list:group-sums-number-blocks $blocks)
   (function
     (let $items (tuple:from $blocks)
       (case (__cetta_lib_list_group_sums_blocks $items)
         (((List:GroupedSums $rows) (return $rows))
          ($other
            (let* (($flat (foldl-atom $items () $out $block (union-atom $out $block)))
                   ($fallback-rows (list:group-sums-number-reference $flat)))
              (return $fallback-rows))))))))
(= (list:group-sums-number $entries)
   (function
     (let $items (tuple:from $entries)
       (case (__cetta_lib_list_group_sums $items)
         (((List:GroupedSums $rows) (return $rows))
          ($other (let $fallback-rows (list:group-sums-number-reference $items)
                    (return $fallback-rows))))))))
(= (list:group-sums-number-reference $entries)
   (let* (($all-keys (map-atom $entries $row (car-atom $row)))
          ($keys (unique-atom $all-keys)))
     (map-atom $keys $key
       (let* (($rows (filter-atom $entries $row
                        (let $row-key (car-atom $row) (== $row-key $key))))
              ($amount (foldl-atom $rows 0 $total $row
                         (let $value (index-atom $row 1) (+ $total $value)))))
         ($key $amount)))))

; Stable first-matching-key encoding. Codes retain every occurrence; keys
; follow first introduction, and firsts records each key's source position.
; The native table requires matching-compatible stable keys. Other keys use
; this ordered search, rather than silently changing equality or deduplicating
; the input. A code identifies a representative, not a mutable space entry.
(: __cetta_lib_list_factorize (-> Atom Atom))
(= (list:factorize $xs)
   (function
     (let $items (tuple:from $xs)
       (case (__cetta_lib_list_factorize $items)
         (((List:Factorization $keys $codes $firsts)
            (return (List:Factorization $keys $codes $firsts)))
          ($other (let $answer (list:factorize-reference $items) (return $answer))))))))
(= (list:factorize-reference $xs)
   (list-internal:factorize (tuple:from $xs) 0 () () ()))
(= (list-internal:key-position $key $keys $position)
   (if (== (size-atom $keys) 0) List:NewKey
     (if (== $key (car-atom $keys)) (List:KeyPosition $position)
       (list-internal:key-position $key (cdr-atom $keys) (+ $position 1)))))
(= (list-internal:factorize $remaining $position $keys $reversed $firsts)
   (if (== (size-atom $remaining) 0)
     (List:Factorization $keys (list:reverse $reversed) $firsts)
     (let* (($key (car-atom $remaining)) ($tail (cdr-atom $remaining)))
       (case (list-internal:key-position $key $keys 0)
         (((List:KeyPosition $code)
            (list-internal:factorize $tail (+ $position 1) $keys
              (cons-atom $code $reversed) $firsts))
          (List:NewKey
            (list-internal:factorize $tail (+ $position 1)
              (union-atom $keys (cons-atom $key ()))
              (cons-atom (size-atom $keys) $reversed)
              (union-atom $firsts (cons-atom $position ())))))))))

; The list value of an expression's elements, and the expression of a
; list value's.  Each evaluates its argument once, as any call does, and
; answers data: the natives hold the value they are given, and the
; expression a list becomes is not evaluated again.  A list to keep as
; written is written as a list literal.
(: __cetta_lib_list_from_expression (-> Atom Atom))
(: __cetta_lib_list_to_expression (-> Atom Atom))
(= (list:from $xs)
   (__cetta_lib_list_from_expression $xs))

(= (tuple:from $xs)
   (__cetta_lib_list_to_expression $xs))

(= (list:is-list $xs)
   (== (get-metatype $xs) List))

; The sequence of $items, of the kind of $xs.
(= (list:like $xs $items)
   (if (list:is-list $xs)
       (list:from $items)
       $items))

(= (list:is-empty $xs)
   (== (size-atom $xs) 0))

(= (list:first $xs)
   (car-atom $xs))

(= (list:rest $xs)
   (cdr-atom $xs))

(= (list:len $xs)
   (size-atom $xs))

(= (list:at $xs $index)
   (index-atom $xs $index))

(= (list:cons $head $tail)
   (cons-atom $head $tail))

(= (list:push $xs $item)
   (union-atom $xs ($item)))

(= (list:append $lhs $rhs)
   (union-atom $lhs $rhs))

(= (list:reverse $xs)
   (let $items (tuple:from $xs)
     (list:like $xs (list:reverse-acc $items ()))))

(= (list:reverse-acc $xs $acc)
   (if (== $xs ())
       $acc
       (let ($head $tail) (decons-atom $xs)
         (let $next (eval (cons-atom $head $acc))
           (list:reverse-acc $tail $next)))))

; Structural equality is the default equivalence for list filtering.  The
; explicit predicate argument on the -by forms also admits alpha, key-only,
; or domain-specific equivalences without changing the list representation.
(= (list:atom-equal $left $right)
   (== $left $right))

(= (list:remove-all-by $same $item $xs)
   (let $items (tuple:from $xs)
     (list:like $xs (list:remove-all-by-walk $same $item $items))))

(= (list:remove-all-by-walk $same $item $xs)
   (if (== $xs ())
       ()
       (let ($head $tail) (decons-atom $xs)
         (let $drop ($same $item $head)
           (if $drop
               (list:remove-all-by-walk $same $item $tail)
               (let $rest
                    (list:remove-all-by-walk $same $item $tail)
                 (eval (cons-atom $head $rest))))))))

(= (list:remove-all $item $xs)
   (remove-all-atom $item $xs))

; unique-atom is the linear expected-time fast path.  It preserves the first
; occurrence and uses structural equality on closed atoms; open atoms are
; identified modulo alpha-renaming.  unique-by exposes other equivalences.
(= (list:unique $xs)
   (unique-atom $xs))

(= (list:unique-by $same $xs)
   (let $items (tuple:from $xs)
     (list:like $xs (list:unique-by-walk $same $items))))

(= (list:unique-by-walk $same $xs)
   (if (== $xs ())
       ()
       (let ($head $tail) (decons-atom $xs)
         (let $remaining
              (list:remove-all-by-walk $same $head $tail)
           (let $rest
                (list:unique-by-walk $same $remaining)
             (eval (cons-atom $head $rest)))))))

; The prefix action of the natural numbers on finite sequences.  A request
; beyond the sequence length returns the whole sequence; a non-positive
; request returns the empty prefix.
(= (list:take $count $xs)
   (let $items (tuple:from $xs)
     (list:like $xs (list:take-walk $count $items))))

(= (list:take-walk $count $xs)
   (if (<= $count 0)
       ()
       (if (== $xs ())
           ()
           (let ($head $tail) (decons-atom $xs)
             (let $rest
                  (list:take-walk (- $count 1) $tail)
               (eval (cons-atom $head $rest)))))))

; The complementary suffix action; non-positive requests keep the sequence.
(= (list:drop $count $xs)
   (let $items (tuple:from $xs)
     (list:like $xs (list:drop-walk $count $items))))
(= (list:drop-walk $count $xs)
   (if (<= $count 0) $xs
     (if (== $xs ()) ()
       (let ($head $tail) (decons-atom $xs)
         (list:drop-walk (- $count 1) $tail)))))

; Efficient order-statistic filtering for already-computed numeric keys.
; Each child is `(key payload)`.  Selection is by descending key, but output
; retains the input occurrence order; earlier occurrences win boundary ties.
(= (list:retain-top-k-keyed $entries $count)
   (retain-top-k-keyed-atom $entries $count))

(= (list:key-by $key-function $xs)
   (let $items (tuple:from $xs)
     (list:like $xs
       (map-atom $items $item
         (metta
           (let $key ($key-function $item)
             (let $value (cons-atom $item ())
               (cons-atom $key $value)))
           %Undefined% (context-space))))))

(= (list:unkey $entries)
   (unkey-atom $entries))

; Project each occurrence and combine the results in source order.  This is
; the explicit-monoid form of foldMap: dynamic MeTTa supplies the identity and
; combination operation rather than recovering them from a type class.  The
; ordinary left fold is authoritative, including choices and effects.
(= (list:fold-map $project $combine $identity $xs)
   (let $items (tuple:from $xs)
     (list:fold-map-walk $project $combine $identity $items)))

(= (list:fold-map-walk $project $combine $accumulator $xs)
   (if (== $xs ())
       $accumulator
       (let ($head $tail) (decons-atom $xs)
         (let $value ($project $head)
           (let $next ($combine $accumulator $value)
             (list:fold-map-walk $project $combine $next $tail))))))

(= (list-internal:number-add $left $right) (+ $left $right))

; Numeric addition is the first optimized fold-map instance.  A prepared
; implementation may fuse projection and folding only when the projection is
; pure and single-valued and every intermediate sum remains in the exact
; unboxed Int/Float fragment; otherwise the authored fold-map below remains
; authoritative from the first occurrence.
(= (list:sum-by $key-function $xs)
   (let $items (tuple:from $xs)
     (list:sum-by-walk $key-function $items)))

(= (list:sum-by-walk $key-function $xs)
   (_minimal-sum-by $xs $key-function))

(= (_minimal-sum-by $xs $key-function)
   (list:fold-map $key-function list-internal:number-add 0 $xs))

; Schwartzian order-statistic filtering: evaluate the key function exactly
; once per occurrence, select in the native keyed representation, and return
; the selected values in their original occurrence order.
(= (list:retain-top-k-by-number $key-function $xs $count)
   (let $items (tuple:from $xs)
     (list:like $xs
       (list:retain-top-k-by-number-walk $key-function $items $count))))

(= (list:retain-top-k-by-number-walk $key-function $xs $count)
   (function
     (chain (metta $xs %Undefined% (context-space)) $__list_top_k_items
       (chain (metta $count %Undefined% (context-space)) $__list_top_k_count
         (eval
           (_minimal-retain-top-k-by-number
             $__list_top_k_items $__list_top_k_count $__list_top_k_item
             (metta ($key-function $__list_top_k_item)
               %Undefined% (context-space))))))))

; The native path may fuse keying, bounded selection, and key erasure only
; after proving that every item has one pure key.  This equation remains the
; complete relational meaning when that proof is unavailable.
; The item variable and the key come from the caller, so the map is the
; library's own (map-atom's definition, written out): its parameter is the
; variable the caller passed.  A literal `(map-atom L $item T)` would give
; Prime's template a parameter of its own, which the key does not mention.
; The key is an Atom parameter, held syntax: only an explicit eval opens it
; as code, once per item.
(= (_minimal-retain-top-k-by-number $xs $count $item $key)
   (chain
     (metta
       (function
         (eval
           (_minimal-map-atom $xs $item
             (metta
               (let $score (eval $key)
                 (let $value (cons-atom $item ())
                   (cons-atom $score $value)))
               %Undefined% (context-space)))))
       %Undefined% (context-space))
     $keyed
     (chain
       (eval (retain-top-k-keyed-atom $keyed $count))
       $retained
       (chain (eval (unkey-atom $retained)) $result
         (return $result)))))

; The default order is stable shortlex over common parseable Atom syntax.
; Domain orders such as numeric order, KBO, or WPO remain explicit through
; sort-by rather than being confused with the default serialization order.
(= (list:sort $xs)
   (sort-atom $xs))

; Stable merge sort over expression-backed finite sequences.  The ordering
; argument is a binary predicate denoting "left precedes or ties right".
; Keeping ties on the left makes equal-key occurrences retain their order.
(= (list:split-half $xs)
   (let $items (tuple:from $xs)
     (let ($left $right) (list:split-half-walk $items $items ())
       (let $left-part (list:like $xs $left)
         (let $right-part (list:like $xs $right)
           ($left-part $right-part))))))

(= (list:split-half-walk $slow $fast $left-reversed)
   (if (== $fast ())
       (let $left (list:reverse $left-reversed)
         ($left $slow))
       (let ($fast-head $fast-tail) (decons-atom $fast)
         (if (== $fast-tail ())
             (let $left (list:reverse $left-reversed)
               ($left $slow))
             (let ($slow-head $slow-tail) (decons-atom $slow)
               (let ($fast-second $fast-rest) (decons-atom $fast-tail)
                 (let $next-left
                      (eval (cons-atom $slow-head $left-reversed))
                   (list:split-half-walk
                     $slow-tail $fast-rest $next-left))))))))

(= (list:merge-by $precedes $left $right)
   (let $left-items (tuple:from $left)
     (let $right-items (tuple:from $right)
       (list:like $left
         (list:merge-by-walk $precedes $left-items $right-items)))))

(= (list:merge-by-walk $precedes $left $right)
   (if (== $left ())
       $right
       (if (== $right ())
           $left
           (let ($left-head $left-tail) (decons-atom $left)
             (let ($right-head $right-tail) (decons-atom $right)
               (let $take-left
                    ($precedes $left-head $right-head)
                 (if $take-left
                     (let $rest
                          (list:merge-by-walk
                            $precedes $left-tail $right)
                       (eval (cons-atom $left-head $rest)))
                     (let $rest
                          (list:merge-by-walk
                            $precedes $left $right-tail)
                       (eval (cons-atom $right-head $rest))))))))))

(= (list:sort-by $precedes $xs)
   (let $items (tuple:from $xs)
     (list:like $xs (list:sort-by-walk $precedes $items))))

(= (list:sort-by-walk $precedes $xs)
   (if (== $xs ())
       ()
       (let ($head $tail) (decons-atom $xs)
         (if (== $tail ())
             $xs
             (let ($left $right)
                  (list:split-half-walk $xs $xs ())
               (let $sorted-left
                    (list:sort-by-walk $precedes $left)
                 (let $sorted-right
                      (list:sort-by-walk $precedes $right)
                   (list:merge-by-walk
                     $precedes $sorted-left $sorted-right))))))))

(= (list:number-ascending $left $right)
   (<= $left $right))

(= (list:number-descending $left $right)
   (>= $left $right))

(= (list:sort-numbers $xs)
   (sort-numbers-atom $xs))

; Binary partition of an ascending numeric sequence. The caller supplies
; sorted, totally ordered numbers (no NaN); sorting belongs at preparation,
; not at every query. Duplicate occurrences are counted independently.
; The returned index is the number of elements strictly below the bound.
(= (list:lower-bound-number $xs $bound)
   (list:lower-bound-number-in $xs $bound 0 (size-atom $xs)))

(= (list:lower-bound-number-in $xs $bound $lo $hi)
   (if (>= $lo $hi) $lo
     (let* (($distance (- $hi $lo))
            ($middle (+ $lo (/ (- $distance (% $distance 2)) 2))))
       (if (< (index-atom $xs $middle) $bound)
         (list:lower-bound-number-in $xs $bound (+ $middle 1) $hi)
         (list:lower-bound-number-in $xs $bound $lo $middle)))))

; An expression takes the primitive's own path; a list value's elements do,
; and a list returns.  The variable and the body come from the caller, so
; the map and the fold are the library's own (map-atom's and foldl-atom's
; definitions, written out): their parameters are the variables the caller
; passed.  A literal `(map-atom L $var T)` would give Prime's template a
; parameter of its own, which the caller's body does not mention.
(= (list:map $xs $var $body)
   (if (list:is-list $xs)
       (let $items (tuple:from $xs)
         (let $mapped
              (function
                (eval
                  (_minimal-map-atom $items $var
                    (metta $body %Undefined% (context-space)))))
           (list:from $mapped)))
       (function
         (eval
           (_minimal-map-atom $xs $var
             (metta $body %Undefined% (context-space)))))))

(= (list:filter $xs $var $body)
   (if (list:is-list $xs)
       (let $items (tuple:from $xs)
         (let $kept
              (filter-atom $items $var (metta $body %Undefined% (context-space)))
           (list:from $kept)))
       (filter-atom $xs $var (metta $body %Undefined% (context-space)))))

(= (list:foldl $xs $init $acc $item $step)
   (if (list:is-list $xs)
       (let $items (tuple:from $xs)
         (function
           (chain (context-space) $space
             (eval
               (_minimal-foldl-atom $items $init $acc $item $step $space)))))
       (function
         (chain (context-space) $space
           (eval (_minimal-foldl-atom $xs $init $acc $item $step $space))))))

; Use the registered library primitives in every profile. The raw grounded
; spellings belong to extended dialect vocabularies, not primary PeTTa.
(: __cetta_lib_list_range (-> %Undefined% Expression))
(: __cetta_lib_list_range (-> %Undefined% %Undefined% Expression))
(: __cetta_lib_list_repeat (-> %Undefined% Atom Expression))
(= (list:range $end)
   (__cetta_lib_list_range $end))

(= (list:range $start $end)
   (__cetta_lib_list_range $start $end))

(= (list:repeat $count $item)
   (__cetta_lib_list_repeat $count $item))
