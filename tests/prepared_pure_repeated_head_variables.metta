; Equation heads that repeat a variable: every occurrence after the first
; matches only a value equal to the first one.  Unequal values leave the
; equation unmatched, which fails in PeTTa and stands for itself in HE.
(= (same $x $x) yes)
(= (twin (P $x $x)) $x)
(= (triple $a $a $a) ok)
(= (contains $x (Cons $x $t)) found)
(= (contains $x (Cons $y $t)) (contains $x $t))
(= (edge a b) True)
(= (edge b c) True)
(= (edge a c) True)
(= (edge c d) True)
(= (hop a) b)
(= (hop a) c)
(= (hop b) c)
(= (hop c) d)
(= (hop d) end)
(= (hop end) end)
(= (reach $x $x $n) (Found $x))
(= (reach $x $y (S $n)) (let $z (hop $x) (reach $z $y $n)))
(= (both $x $x) (superpose (L R)))
(= (pick (Cons $x $xs)) $x)
(= (pick (Cons $x $xs)) (pick $xs))
(= (pair-same $l) (let $a (pick $l) (let $b (pick $l) (same $a $b))))
(= (dup-head (cons $x (cons $x $t))) $x)
(= (ends-same (cons $x $t) $x) yes)
!(same 1 1)
!(same 1 2)
!(same "a" "a")
!(same a a)
!(same a b)
!(same (f (g 1)) (f (g 1)))
!(same (f (g 1)) (f (g 2)))
!(same () ())
!(same (+ 1 1) 2)
!(twin (P 3 3))
!(twin (P 3 4))
!(triple 5 5 5)
!(triple 5 5 6)
!(contains 1 (Cons 1 (Cons 2 (Cons 1 Nil))))
!(contains 3 (Cons 1 (Cons 2 Nil)))
!(reach a d (S (S (S Z))))
!(both 7 7)
!(both 7 8)
!(pair-same (Cons 1 (Cons 2 (Cons 1 Nil))))
!(dup-head (1 1 2))
!(dup-head (1 2 3))
!(dup-head (() () 3))
!(ends-same (4 5) 4)
!(ends-same (4 5) 5)
