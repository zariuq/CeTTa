!(import! &self hol)
!(import! &self set)
!(bind! &logic (new-space))
!(add-atom &logic (hol:profile base))
!(add-atom &logic (: K U0))
!(add-atom &logic (type:stored (item K)))
!(bind! &sets (new-space))
!(add-atom &sets (set:profile prime-common))
!(add-atom &sets (: L U0))
!(add-atom &sets (type:stored (entry L)))
!(hol:try (hol:irrelevant &logic K bogus))
!(set:try (set:irrelevant &sets L bogus))

; Independent theory contexts remain stable across parallel judgments.
!(msort (collapse (hyperpose
    ((hol:try (hol:irrelevant &logic K bogus))
     (set:try (set:irrelevant &sets L bogus))
     (hol:try (hol:irrelevant &logic K bogus))
     (set:try (set:irrelevant &sets L bogus))
     (hol:try (hol:irrelevant &logic K bogus))
     (set:try (set:irrelevant &sets L bogus))
     (hol:try (hol:irrelevant &logic K bogus))
     (set:try (set:irrelevant &sets L bogus))
     (hol:try (hol:irrelevant &logic K bogus))
     (set:try (set:irrelevant &sets L bogus))
     (hol:try (hol:irrelevant &logic K bogus))
     (set:try (set:irrelevant &sets L bogus))
     (hol:try (hol:irrelevant &logic K bogus))
     (set:try (set:irrelevant &sets L bogus))
     (hol:try (hol:irrelevant &logic K bogus))
     (set:try (set:irrelevant &sets L bogus))))))
