; Calls that may stream their answers, and the boundaries that keep a call on
; the completed path: unmatched calls, typed heads, Empty and errors beside
; answers, stored rows with variables and numbers compared by value.

(edge a b)
(edge b c)
(edge c d)
(rule (kin $x) (link $x))
(kinship ann)
(= (reach $x) (match &self (edge $x $y) $y))
(= (reach $x) (match &self (edge $x $y) (reach $y)))
!(let $answers (collapse (reach a)) (sort-atom $answers))
(= (only a) yes)
!(collapse (only a))
!(collapse (only z))
(= (wrap $x) (only $x))
!(collapse (wrap a))
!(collapse (wrap z))
(: typed (-> Symbol Symbol))
(= (typed $x) (match &self (edge $x $y) $y))
!(collapse (typed a))
(= (gap $x) (match &self (edge $x $y) (if (== $y c) (empty) $y)))
!(collapse (gap a))
!(collapse (gap b))
(= (risky $x) (match &self (edge $x $y) (if (== $y c) (Error $y no) $y)))
!(collapse (risky b))
!(collapse (superpose ((risky a) (risky b))))
(= (derive $x) (match &self (rule (kin $x) $out) $out))
!(collapse (derive ann))
(val 2.0)
(= (has $n) (match &self (val $n) present))
!(collapse (has 2))
