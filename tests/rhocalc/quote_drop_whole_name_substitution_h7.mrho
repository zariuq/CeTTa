; H7.2 A quote of a single drop of a free name is that name (quote-drop).  The
; receive binds $b, which its body does not use, so COMM substitutes nothing
; there: the send's channel @{*$x} normalizes to the free name $x.
(rho:par
  (rho:recv (rho:quote rho:nil) $b
    (rho:send
      (rho:quote (rho:drop $x))
      rho:nil))
  (rho:send
    (rho:quote rho:nil)
    (rho:send (rho:quote rho:nil) rho:nil)))
