; All seven source term constructors; value is bvalue OR nvalue.
!(import! &self pf)
!(bind! &thy (new-space))
!(set:inductive &thy tm (u 0) (: ttrue tm) (: tfalse tm) (: tif (-> tm tm tm tm)) (: tzero tm) (: tsucc (-> tm tm)) (: tpred (-> tm tm)) (: tiszero (-> tm tm)))
!(set:define &thy truth prop (= truth (all prop (lam p (imp p p)))))
!(set:define &thy falsum prop (= falsum (all prop (lam p p))))
!(set:define &thy or (-> prop prop prop) (= (or $p $q) (all prop (lam r (imp (imp $p r) (imp (imp $q r) r))))))
!(set:define &thy bvalue (-> tm prop) (= (bvalue ttrue) truth) (= (bvalue tfalse) truth) (= (bvalue (tif $c $t $e)) falsum) (= (bvalue tzero) falsum) (= (bvalue (tsucc $t)) falsum) (= (bvalue (tpred $t)) falsum) (= (bvalue (tiszero $t)) falsum))
!(set:define &thy nvalue (-> tm prop) (= (nvalue ttrue) falsum) (= (nvalue tfalse) falsum) (= (nvalue (tif $c $t $e)) falsum) (= (nvalue tzero) truth) (= (nvalue (tsucc $t)) (nvalue $t)) (= (nvalue (tpred $t)) falsum) (= (nvalue (tiszero $t)) falsum))
!(set:define &thy value (-> tm prop) (= (value $t) (or (bvalue $t) (nvalue $t))))
!(set:eq &thy (value ttrue) (or truth falsum))
!(set:eq &thy (value (tsucc (tsucc tzero))) (or falsum truth))
!(set:eq &thy (value (tsucc ttrue)) (or falsum falsum))
!(set:eq &thy (value (tif ttrue tzero tzero)) (or falsum falsum))
!(set:check &thy value (-> tm prop))
