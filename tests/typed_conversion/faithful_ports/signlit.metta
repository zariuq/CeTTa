; Signed literals of an updated valuation, for every original valuation and index.
!(import! &self pf)
!(bind! &thy (new-space))
!(set:inductive &thy nat (u 0) (: zero nat) (: succ (-> nat nat)))
!(set:inductive &thy bool (u 0) (: true bool) (: false bool))
!(set:define &thy andb (-> bool bool bool) (= (andb true $b) $b) (= (andb false $b) false))
!(set:define &thy is-zero (-> nat bool) (= (is-zero zero) true) (= (is-zero (succ $n)) false))
!(set:define &thy predn (-> nat nat) (= (predn zero) zero) (= (predn (succ $n)) $n))
!(set:define &thy if-zero (-> nat nat nat nat) (= (if-zero zero $z $s) $z) (= (if-zero (succ $n) $z $s) $s))
!(set:define &thy subk (-> nat nat nat) (= (subk zero $n) $n) (= (subk (succ $m) $n) (if-zero $n zero (subk $m (predn $n)))))
!(set:define &thy nat-eqb (-> nat nat bool) (= (nat-eqb $n $m) (andb (is-zero (subk $n $m)) (is-zero (subk $m $n)))))
!(set:define &thy if-bool (-> bool bool bool bool) (= (if-bool true $a $b) $a) (= (if-bool false $a $b) $b))
!(set:define &thy setv (-> (-> nat bool) nat bool nat bool) (= (setv $v $n $b $m) (if-bool (nat-eqb $n $m) $b ($v $m))))
!(pf:equality &thy nat refl@nat subst@nat)
!(pf:equality &thy bool refl@bool subst@bool)
!(set:inductive &thy form (u 0) (: FVar (-> nat form)) (: Bot form) (: Imp (-> form form form)))
!(pf:equality &thy form refl@form subst@form)
!(set:define &thy Neg (-> form form) (= (Neg $a) (Imp $a Bot)))
!(set:define &thy if-form (-> bool form form form) (= (if-form true $a $b) $a) (= (if-form false $a $b) $b))
!(set:define &thy signLit (-> (-> nat bool) nat form) (= (signLit $v $n) (if-form ($v $n) (FVar $n) (Neg (FVar $n)))))
!(pf:theorem &thy sub-diag (all nat (lam n (eq nat (subk n n) zero)))
 (pf:induction nat-ind (lam n (eq nat (subk n n) zero))
  (pf:refl nat zero) (pf:fix k (pf:assume ih (pf:by ih)))))
!(pf:theorem &thy eqb-diag (all nat (lam n (eq bool (nat-eqb n n) true)))
 (pf:fix n (pf:cong nat bool (lam r (andb (is-zero r) (is-zero r))) (subk n n) zero (pf:all-elim (pf:known sub-diag) n))))
!(pf:theorem &thy signLit-setv-true (all (-> nat bool) (lam v (all nat (lam n (eq form (signLit (setv v n true) n) (FVar n))))))
 (pf:fix v (pf:fix n (pf:cong bool form (lam b (if-form (if-bool b true (v n)) (FVar n) (Neg (FVar n)))) (nat-eqb n n) true (pf:all-elim (pf:known eqb-diag) n)))))
!(pf:theorem &thy signLit-setv-false (all (-> nat bool) (lam v (all nat (lam n (eq form (signLit (setv v n false) n) (Neg (FVar n)))))))
 (pf:fix v (pf:fix n (pf:cong bool form (lam b (if-form (if-bool b false (v n)) (FVar n) (Neg (FVar n)))) (nat-eqb n n) true (pf:all-elim (pf:known eqb-diag) n)))))
