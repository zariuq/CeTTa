; Functional typing contexts retain every type and every context entry.
!(import! &self pf)
!(bind! &thy (new-space))
!(set:inductive &thy nat (u 0) (: zero nat) (: succ (-> nat nat)))
!(set:inductive &thy bool (u 0) (: true bool) (: false bool))
!(set:define &thy andb (-> bool bool bool) (= (andb true $b) $b) (= (andb false $b) false))
!(set:define &thy is-zero (-> nat bool) (= (is-zero zero) true) (= (is-zero (succ $n)) false))
!(set:define &thy predn (-> nat nat) (= (predn zero) zero) (= (predn (succ $n)) $n))
!(set:define &thy if-zero (-> nat nat nat nat) (= (if-zero zero $z $s) $z) (= (if-zero (succ $n) $z $s) $s))
!(set:define &thy subk (-> nat nat nat) (= (subk zero $n) $n) (= (subk (succ $m) $n) (if-zero $n zero (subk $m (predn $n)))))
!(set:define &thy nat-eqb (-> nat nat bool) (= (nat-eqb $n $m) (andb (is-zero (subk $n $m)) (is-zero (subk $m $n)))))
!(set:inductive &thy ty (u 0) (: TBase ty) (: TArrow (-> ty ty ty)))
!(set:inductive &thy option (u 0) (: none option) (: some (-> ty option)))
!(set:define &thy if-option (-> bool option option option) (= (if-option true $a $b) $a) (= (if-option false $a $b) $b))
!(set:define &thy update (-> (-> nat option) nat ty nat option) (= (update $G $x $T $y) (if-option (nat-eqb $x $y) (some $T) ($G $y))))
!(pf:equality &thy nat refl@nat subst@nat)
!(pf:equality &thy bool refl@bool subst@bool)
!(pf:equality &thy option refl@option subst@option)
!(pf:theorem &thy sub-diag (all nat (lam n (eq nat (subk n n) zero)))
 (pf:induction nat-ind (lam n (eq nat (subk n n) zero))
  (pf:refl nat zero) (pf:fix k (pf:assume ih (pf:by ih)))))
!(pf:theorem &thy eqb-diag (all nat (lam n (eq bool (nat-eqb n n) true)))
 (pf:fix n (pf:cong nat bool (lam r (andb (is-zero r) (is-zero r))) (subk n n) zero (pf:all-elim (pf:known sub-diag) n))))
!(pf:theorem &thy update-eq (all (-> nat option) (lam G (all nat (lam x (all ty (lam T (eq option (update G x T x) (some T))))))))
 (pf:fix G (pf:fix x (pf:fix T (pf:cong bool option (lam b (if-option b (some T) (G x))) (nat-eqb x x) true (pf:all-elim (pf:known eqb-diag) x))))))
