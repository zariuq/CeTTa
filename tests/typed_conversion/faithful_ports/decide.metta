; Exhaustive valuation enumeration from the source decision program.
; Its global correctness theorem remains a separate obligation.
!(import! &self pf)
!(bind! &thy (new-space))
!(set:inductive &thy nat (u 0) (: zero nat) (: succ (-> nat nat)))
!(set:inductive &thy bool (u 0) (: true bool) (: false bool))
!(set:define &thy andb (-> bool bool bool) (= (andb true $b) $b) (= (andb false $b) false))
!(set:define &thy is-zero (-> nat bool) (= (is-zero zero) true) (= (is-zero (succ $n)) false))
!(set:define &thy predn (-> nat nat) (= (predn zero) zero) (= (predn (succ $n)) $n))
!(set:define &thy if-zero (-> nat nat nat nat) (= (if-zero zero $z $s) $z) (= (if-zero (succ $n) $z $s) $s))
!(set:define &thy subk (-> nat nat nat) (= (subk zero $n) $n) (= (subk (succ $m) $n) (if-zero $n zero (subk $m (predn $n)))))
!(set:define &thy nat-eqb (-> nat nat bool) (= (nat-eqb $n $m) (andb (is-zero (subk $n $m)) (is-zero (subk $m $n)))))
!(set:define &thy if-bool (-> bool bool bool bool) (= (if-bool true $a $b) $a) (= (if-bool false $a $b) $b))
!(set:define &thy setv (-> (-> nat bool) nat bool nat bool) (= (setv $v $n $b $m) (if-bool (nat-eqb $n $m) $b ($v $m))))
!(set:inductive &thy form (u 0) (: Var (-> nat form)) (: Bot form) (: Imp (-> form form form)))
!(set:inductive &thy nlist (u 0) (: nnil nlist) (: ncons (-> nat nlist nlist)))
!(set:inductive &thy vlist (u 0) (: vnil vlist) (: vcons (-> (-> nat bool) vlist vlist)))
!(set:define &thy impb (-> bool bool bool) (= (impb true $b) $b) (= (impb false $b) true))
!(set:define &thy eval (-> (-> nat bool) form bool) (= (eval $v (Var $n)) ($v $n)) (= (eval $v Bot) false) (= (eval $v (Imp $a $b)) (impb (eval $v $a) (eval $v $b))))
!(set:define &thy nappend (-> nlist nlist nlist) (= (nappend nnil $ys) $ys) (= (nappend (ncons $n $ns) $ys) (ncons $n (nappend $ns $ys))))
!(set:define &thy vappend (-> vlist vlist vlist) (= (vappend vnil $ys) $ys) (= (vappend (vcons $v $vs) $ys) (vcons $v (vappend $vs $ys))))
!(set:define &thy vars (-> form nlist) (= (vars (Var $n)) (ncons $n nnil)) (= (vars Bot) nnil) (= (vars (Imp $a $b)) (nappend (vars $a) (vars $b))))
!(set:define &thy map-setv (-> nat bool vlist vlist) (= (map-setv $n $b vnil) vnil) (= (map-setv $n $b (vcons $v $vs)) (vcons (setv $v $n $b) (map-setv $n $b $vs))))
!(set:define &thy allAssign (-> nlist (-> nat bool) vlist) (= (allAssign nnil $v0) (vcons $v0 vnil)) (= (allAssign (ncons $n $ns) $v0) (vappend (map-setv $n true (allAssign $ns $v0)) (map-setv $n false (allAssign $ns $v0)))))
!(set:define &thy forall-eval (-> form vlist bool) (= (forall-eval $a vnil) true) (= (forall-eval $a (vcons $v $vs)) (andb (eval $v $a) (forall-eval $a $vs))))
!(set:define &thy decide_valid (-> form bool) (= (decide_valid $a) (forall-eval $a (allAssign (vars $a) (lam n false)))))
!(set:eq &thy (decide_valid (Imp (Var zero) (Var zero))) true)
!(set:eq &thy (decide_valid (Var zero)) false)
!(set:eq &thy (decide_valid (Imp (Var zero) (Var (succ zero)))) false)
!(set:eq &thy (decide_valid (Imp (Imp (Imp (Var zero) (Var (succ zero))) (Var zero)) (Var zero))) true)
!(type:check &thy (refl false) (id bool (decide_valid (Var zero)) true))
