; De Bruijn shifting, with a cutoff that increases beneath every binder.
!(bind! &thy (new-space))
!(set:inductive &thy nat (u 0) (: zero nat) (: succ (-> nat nat)))
!(set:inductive &thy bool (u 0) (: true bool) (: false bool))
!(set:inductive &thy Tm (u 0) (: var (-> nat Tm)) (: lam (-> Tm Tm)) (: app (-> Tm Tm Tm)))
!(set:define &thy add (-> nat nat nat) (= (add zero $n) $n) (= (add (succ $m) $n) (succ (add $m $n))))
!(set:define &thy is-zero (-> nat bool) (= (is-zero zero) true) (= (is-zero (succ $n)) false))
!(set:define &thy predn (-> nat nat) (= (predn zero) zero) (= (predn (succ $n)) $n))
!(set:define &thy if-zero (-> nat nat nat nat) (= (if-zero zero $z $s) $z) (= (if-zero (succ $n) $z $s) $s))
!(set:define &thy subk (-> nat nat nat) (= (subk zero $n) $n) (= (subk (succ $m) $n) (if-zero $n zero (subk $m (predn $n)))))
!(set:define &thy lt (-> nat nat bool) (= (lt $k $cut) (is-zero (subk $cut (succ $k)))))
!(set:define &thy if-Tm (-> bool Tm Tm Tm) (= (if-Tm true $a $b) $a) (= (if-Tm false $a $b) $b))
!(set:define &thy shiftAbove (-> nat nat Tm Tm)
  (= (shiftAbove $cut $inc (var $k)) (if-Tm (lt $k $cut) (var $k) (var (add $k $inc))))
  (= (shiftAbove $cut $inc (lam $b)) (lam (shiftAbove (succ $cut) $inc $b)))
  (= (shiftAbove $cut $inc (app $f $a)) (app (shiftAbove $cut $inc $f) (shiftAbove $cut $inc $a))))
!(set:define &thy shift (-> nat Tm Tm) (= (shift $inc $t) (shiftAbove zero $inc $t)))
!(set:eq &thy (shift (succ zero) (lam (var zero))) (lam (var zero)))
!(set:eq &thy (shift (succ zero) (lam (var (succ zero)))) (lam (var (succ (succ zero)))))
!(set:eq &thy (shift (succ zero) (app (var zero) (lam (var (succ zero))))) (app (var (succ zero)) (lam (var (succ (succ zero))))))
!(set:eq &thy (shift (succ zero) (lam (lam (app (var (succ zero)) (var (succ (succ zero))))))) (lam (lam (app (var (succ zero)) (var (succ (succ (succ zero))))))))
!(set:eq &thy (shiftAbove (succ zero) (succ (succ zero)) (app (var zero) (var (succ zero)))) (app (var zero) (var (succ (succ (succ zero))))))
!(set:check &thy shiftAbove (-> nat nat Tm Tm))
!(set:check &thy shift (-> nat Tm Tm))
