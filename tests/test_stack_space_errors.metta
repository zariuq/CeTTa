!(bind! &bag (new-space))
!(assertEqualToResult (space:stack:peek &bag) ((Error (space:stack:peek &bag) (BadType (Space stack) (Space atom)))))
!(bind! &stk (new-space stack))
!(assertEqualToResult (space:stack:pop &stk) ((Error (space:stack:pop &stk) EmptyStackSpace)))
!(assertEqualToResult (space:stack:get &stk 0) ((Error (space:stack:get &stk 0) IndexOutOfBounds)))
!(assertEqualToResult (space:stack:truncate &stk 1) ((Error (space:stack:truncate &stk 1) IndexOutOfBounds)))
!(assertEqualToResult (space:stack:get &stk foo) ((Error (space:stack:get &stk foo) ExpectedNonNegativeIndex)))
