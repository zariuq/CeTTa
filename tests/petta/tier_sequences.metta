; Ordered sequencing, value bindings, and their enclosing equation scope.
(= (seq-last) (progn (superpose (left left right)) ignored (superpose (a b))))
(= (seq-first) (prog1 (superpose (left left right)) ignored (superpose (a b))))
(= (seq-nest $n) (Box (progn ignored (prog1 (+ $n 2) ignored (+ $n 3)))))
(= (seq-tail $n) (if (== $n 0) done (progn ignored true (seq-tail (- $n 1)))))
(= (seq-cut) (progn (superpose (a b)) ignored (cut) kept))
(= (seq-cut) rejected)
(= (seq-cut-field) (Box (prog1 kept ignored (cut) (superpose (a b)))))
(= (seq-cut-field) rejected)
(= (seq-inner) (progn ignored (cut) inner))
(= (seq-inner) rejected)
(= (seq-outer) (progn (superpose (a b)) (seq-inner) tail))
(= (seq-outer) outside)
(= (seq-fail) (prog1 kept (empty) (println! unreachable)))
(= (seq-raise) (prog1 kept ignored (/ 1 0)))
(= (seq-early) (progn (println! unreachable-output) ignored fixed))
(= (seq-early-first) (prog1 fixed ignored (println! unreachable-first)))
(= (seq-effect) (progn (println! first-effect) ignored (println! second-effect) done))
(= (seq-effect-choice) (prog1 (superpose (one two)) ignored (println! last-effect)))
(= (value-let $n) (Box (let $x (+ $n 1) (progn ignored (+ $x 2)))))
(= (value-lets $n) (Box (let* (($x (+ $n 1)) ($y (+ $x 2))) (+ $x $y))))
(= (value-let-choice) (Box (let $x (superpose (a a b)) (prog1 $x ignored))))
(= (value-let-pattern) (Box (let (Pair $x $x) (superpose ((Pair a a) (Pair a b))) $x)))
(= (value-let-if $n) (Box (let $x (+ $n 1) (if (< $x 4) small large))))
(= (value-let-cut) (Box (let $x kept (progn ignored (cut) $x))))
(= (value-let-cut) rejected)
(= (value-let-inert $x) (Box (let $y $x $y)))
(= (seq-live) (progn ignored old))
(= (seq-live-value) (Box (let $x (seq-live) (prog1 $x ignored))))
!(collapse (seq-last))
!(collapse (seq-first))
!(seq-nest 7)
!(seq-tail 10000)
!(collapse (seq-cut))
!(collapse (seq-cut-field))
!(collapse (seq-outer))
!(collapse (seq-fail))
!(let (Error $kind $context) (catch (seq-raise)) $kind)
!(collapse (let impossible (seq-early) yes))
!(collapse (let impossible (seq-early-first) yes))
!(seq-effect)
!(collapse (seq-effect-choice))
!(value-let 7)
!(value-lets 7)
!(collapse (value-let-choice))
!(collapse (value-let-pattern))
!(value-let-if 1)
!(value-let-if 7)
!(collapse (value-let-cut))
!(value-let-inert (quote (progn (println! inert) (+ 1 2))))
!(collapse (seq-live-value))
!(add-atom &self (= (seq-live) (progn ignored another newer)))
!(collapse (seq-live-value))
!(remove-atom &self (= (seq-live) (progn ignored another newer)))
!(collapse (seq-live-value))
