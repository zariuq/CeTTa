; An opaque field does not hide the ordinary ground fields of its row.
!(import! &self seal)
!(let $factory (seal:new image-test) (bind! &image-factory (new-state $factory)))
(= (image-sealer) (let (seal:facets $seal $open) (get-state &image-factory) $seal))
(= (image-opener) (let (seal:facets $seal $open) (get-state &image-factory) $open))
!(bind! &image-rows (new-space))
(= (image-fill $owner $n)
   (if (== $n 0) done
       (let $written (add-atom &image-rows (image $owner (key $n) (value $n)))
         (image-fill $owner (- $n 1)))))
!(image-fill (image-sealer) 96)
(= (image-read $key) (match &image-rows (image $owner $key $value) $value))
!(numeric-key (collapse (image-read (key 55))))
!(missing-key (collapse (image-read (key 97))))
!(let $owner (image-sealer)
   (add-atom &image-rows (image $owner (tree (leaf "alpha") (leaf "beta")) (payload 7))))
!(let $owner (image-sealer)
   (add-atom &image-rows (image $owner (tree (leaf "beta") (leaf "alpha")) (payload 8))))
!(string-key (collapse (image-read (tree (leaf "alpha") (leaf "beta")))))
!(other-key (collapse (image-read (tree (leaf "beta") (leaf "alpha")))))
!(key-count (foldall + (match &image-rows
   (image $owner (tree (leaf "alpha") (leaf "beta")) $value) 1) 0))
!(let $owner (image-sealer)
   (add-atom &image-rows (image $owner (same a a) yes)))
!(let $owner (image-sealer)
   (add-atom &image-rows (image $owner (same a b) no)))
(= (image-repeated) (match &image-rows (image $owner (same $x $x) $value) $value))
!(repeated-field (collapse (image-repeated)))
!(let ($owner $value)
      (match &image-rows (image $owner (key 55) $value) (quote ($owner $value)))
   (remove-atom &image-rows (image $owner (key 55) $value)))
!(removed-key (collapse (image-read (key 55))))
!(let $owner (image-sealer)
   (add-atom &image-rows (image $owner (key 55) (value replaced))))
!(reinserted-key (collapse (image-read (key 55))))
; A bound opaque field owns its native lease after its stored row goes away.
!(bind! &image-held (new-space))
!(let $owner (seal:seal (image-sealer) (payload retained))
   (add-atom &image-held (held $owner)))
(= (image-hold)
   (match &image-held (held $owner)
     (let $removed (remove-atom &image-held (held $owner))
       (seal:unseal (image-opener) $owner))))
!(retained-owner (collapse (image-hold)))
