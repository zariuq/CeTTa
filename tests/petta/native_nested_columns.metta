; Patterns holding variables inside a term, collected: matched part by part
; on the native path, as on the ordinary one.  A row holding a variable, or
; a part that is not a value equal only to itself, inside such a term leaves
; the query to the ordinary path.
(edge (pair 0 1) 2)
(edge (pair 1 1) 3)
(edge (pair 0 0) 4)
(edge (pair (pair 0 1) 0) 5)
(edge 0 1)
(lab (pair 1 1) a 7)
!(let $h (collapse (match &self (edge (pair 0 $y) $z) (r $y $z))) (sort-atom $h))
!(let $h (collapse (match &self (edge (pair $x $x) $z) (r $x $z))) (sort-atom $h))
!(let $h (collapse (match &self (edge (pair (pair $x $y) $x) $z) (r $x $y $z))) (sort-atom $h))
!(let $h (collapse (match &self (, (edge (pair $x $x) $z) (lab (pair $x $x) $l $w)) (r $x $l $w))) (sort-atom $h))
!(bind! &t (new-space set))
!(size-atom (collapse (match &self (edge (pair $x $y) $z) (let $_ (add-atom &t (left $x)) (add-atom &t (right $y))))))
!(let $h (collapse (match &t $a $a)) (sort-atom $h))
(edge (pair $open 9) 9)
!(let $h (collapse (match &self (edge (pair $x 9) $z) (r $x $z))) (sort-atom $h))
(edge (pair 1.5 2) 8)
!(let $h (collapse (match &self (edge (pair $x 2) $z) (r $x $z))) (sort-atom $h))
