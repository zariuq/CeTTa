; An argument declared Atom arrives as written, and a variable bound to it is
; compared as that value: a closed (collapse (match ...)) it holds is never
; run as an existence observer.
(pmq 2)
(: rec (-> Atom %Undefined%))
(= (rec $e)
   (if (== (get-metatype $e) Expression)
       (if (== $e ()) (lit ())
         (let $head (car-atom $e)
           (if (== $head collapse)
               (let ($e1) (cdr-atom $e) (coll (rec $e1)))
               (if (== $head match)
                   (let ($s $p $t) (cdr-atom $e) (mat $s $p (rec $t)))
                   (other $e)))))
       (lit $e)))
!(rec (collapse (match &self (pmq 1) kept)))
!(rec (collapse (match &self (pmq $x) kept)))
!(rec (collapse (match &self (pmq 2) kept)))
(: rec2 (-> Atom %Undefined%))
(= (rec2 $e)
   (if (== (get-metatype $e) Expression)
       (let $head (car-atom $e)
         (if (== $head collapse)
             (let ($e1) (cdr-atom $e) (coll (rec2 $e1)))
             (other $e)))
       (lit $e)))
!(rec2 (collapse (match &self (pmq 1) kept)))

(: empty-test (-> Atom %Undefined%))
(= (empty-test $e) (if (== $e ()) empty not-empty))
!(empty-test (collapse (match &self (pmq 1) kept)))
!(empty-test ())
(: compared (-> Atom %Undefined%))
(= (compared $e) (== $e ()))
!(compared (collapse (match &self (pmq 1) kept)))
(: differs (-> Atom %Undefined%))
(= (differs $e) (!= $e ()))
!(differs (collapse (match &self (pmq 1) kept)))

; Positive controls: a written observer is the match's answer.
!(== (collapse (match &self (pmq 1) kept)) ())
!(== (collapse (match &self (pmq 2) kept)) ())
(= (written-observer $n) (== (collapse (match &self (pmq $n) kept)) ()))
!(written-observer 1)
!(written-observer 2)
