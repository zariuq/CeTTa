!(import! &self (library lib_transform))
(= (observe-free $answers)
   (let (r 1 $a) (superpose $answers)
     (let (r 2 $b) (superpose $answers) (let $a 5 $b))))
(= (observe-box $answers)
   (let (r 1 (box $a)) (superpose $answers)
     (let (r 2 (box $b)) (superpose $answers) (let $a 5 $b))))
!(bind! &s (new-space))
!(add-atom &s (p 1))
!(add-atom &s (p 2))
!(read-transform (observe-free (collapse (transform &s (p $x) (r $x $new)))))
!(read-match (observe-free (collapse (match &s (p $x) (r $x $new)))))
!(captured-transform
   (let $held (quote (box $n))
      (observe-box (collapse (transform &s (p $x) (r $x $held))))))
!(captured-match
   (let $held (quote (box $n))
      (observe-box (collapse (match &s (p $x) (r $x $held))))))
!(all-transform (observe-free (collapse (transform &s (all (p $x)) (r $x $new)))))
!(take-transform (observe-free (collapse (transform &s (take (p $x)) (r $x $new)))))
!(remaining (collapse (match &s (p $x) $x)))
