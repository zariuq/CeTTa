; Guards whose function a program spells with more than one equation:
; one more equation answering nothing, or a declared type changing nothing
; the test answers, reads as the plain spelling; equations and types that
; do change what the call answers keep the ordinary path.
!(bind! &t (new-space set))
!(bind! &r (new-space set))
!(bind! &w (new-space set))
!(add-atom &r (rt 1 0))
!(add-atom &r (rt 2 0))
!(add-atom &r (rt 3 1))
!(add-atom &r (rt 3 2))
!(add-atom &r (rt 3 3))
!(add-atom &t (sat f0 3))
!(add-atom &w (fr f0 0 3))
(: in (-> Atom Atom Bool))
(= (in $f $x) (not (== (collapse (once (match &t (sat $f $x) t))) ())))
(= (in $f $x) (empty))
(= (round $f $k $k1)
   (size-atom (collapse (match &w (fr $f $k $y) (match &r (rt $y $x)
     (if (in $f $x) (empty) (let $_ (add-atom &t (sat $f $x)) (add-atom &w (fr $f $k1 $x)))))))))
!(round f0 0 1)
!(round f0 1 2)
!(round f0 2 3)
!(sort-atom (collapse (match &t (sat f0 $x) $x)))
; a second equation that answers: the call is no single truth
!(bind! &a (new-space set))
!(add-atom &a (got 1))
(= (twice-in $x) (not (== (collapse (match &a (got $x) t)) ())))
(= (twice-in $x) False)
!(size-atom (collapse (match &r (rt $y $x) (if (twice-in $x) (empty) (add-atom &a (got $x))))))
!(sort-atom (collapse (match &a (got $x) $x)))
; a declared result held as data
!(bind! &b (new-space set))
!(add-atom &b (got 1))
(: held-in (-> Atom Atom))
(= (held-in $x) (not (== (collapse (match &b (got $x) t)) ())))
!(size-atom (collapse (match &r (rt $y $x) (if (held-in $x) (empty) (add-atom &b (got $x))))))
!(sort-atom (collapse (match &b (got $x) $x)))
; a checked argument the call's argument does not have
!(bind! &c (new-space set))
!(add-atom &c (got 1))
(: num-in (-> Number Atom Bool))
(= (num-in $n $x) (not (== (collapse (match &c (got $x) t)) ())))
!(size-atom (collapse (match &r (rt $y $x) (if (num-in f0 $x) (empty) (add-atom &c (got $x))))))
!(sort-atom (collapse (match &c (got $x) $x)))
