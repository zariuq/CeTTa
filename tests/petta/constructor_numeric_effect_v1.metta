; Observations distinguish raised numeric failures from Error-shaped data.
; Error payload wording is implementation-specific; only the delimiter and
; returned data are observed here. Expected observations come from SWI-PeTTa.
(= (constructor-effect:observe $value)
   (if (= $value (cons Error $_)) constructor-effect:raised $value))
(= (constructor-effect:arg $value) $value)
(= (constructor-effect:activation $value) (box (+ 1 $value)))
(= (constructor-effect:slot $value) (+ 1 $value))
(= (constructor-effect:two) 2)
(= (constructor-effect:item) first)
(= (constructor-effect:item) second)
!(constructor-effect:observe (catch (box (+ 1 not-a-number))))
!(constructor-effect:observe (catch (constructor-effect:activation not-a-number)))
!(constructor-effect:observe (catch (box (constructor-effect:slot not-a-number))))
!(constructor-effect:observe (catch (box (+ (constructor-effect:two) not-a-number))))
!(constructor-effect:observe (catch (box (/ 1 0))))
!(constructor-effect:observe (catch (box (< 1 not-a-number))))
!(constructor-effect:observe (catch (let 0 (+ 1 not-a-number) wrong)))
!(box (Error bad reason))
!(box (car-atom (quote ((Error bad reason) unused))))
!(box (intersection-atom (quote (Error bad reason)) (quote (Error bad reason))))
!(box (constructor-effect:arg (quote (Error bad reason))))
!(box (constructor-effect:observe (catch (+ 1 not-a-number))))
!(box (quote (+ 1 not-a-number)))
!(collapse (box (constructor-effect:item)))
!(box (+ 1 2))
!(constructor-effect:observe (catch (box (+ (quote (Error bad reason)) 1))))
!(constructor-effect:observe
   (catch (let $ignored (+ 1 not-a-number) (println! constructor-effect:wrong-continuation))))
