(: suffix (-> Atom Atom %Undefined%))
(= (suffix $count $items)
   (if (== $count 0) $items
     (case $items ((Stop Stop) ((Cell $head $tail)
       (let $previous (- $count 1) (suffix $previous $tail)))))))
(: guarded-suffix (-> Atom Atom String))
(= (guarded-suffix $count $items)
   (if (== $count 0) $items
     (case $items ((Stop Stop) ((Cell $head $tail)
       (let $previous (- $count 1) (guarded-suffix $previous $tail)))))))
(: suffix-two (-> Atom Atom %Undefined%))
(= (suffix-two $count $items)
   (if (== $count 0) $items
     (case $items ((Stop Stop) ((Cell $head $tail)
       (let $previous (- $count 2) (suffix-two $previous $tail)))))))
!(suffix 2 (Cell a (Cell b (Cell c Stop))))
!(suffix 0 Other)
!(suffix 8 (Cell a Stop))
!(suffix -1 (Cell a (Cell b Stop)))
!(suffix-two 2 (Cell a (Cell b (Cell c Stop))))
!(collapse (guarded-suffix 0 (Cell a Stop)))
!(once (suffix 1 $open))
!(sort-atom (collapse (let $tag (superpose (first second))
   (let $tail $tag (suffix 1 (Cell ignored $tail))))))
!(let $items (Cell ignored $tail)
   (let $answer (suffix 1 $items) (let $tail Stop $answer)))
!(collapse (suffix 1 Other))
