; Calls, collections and answers that carry many variables.  Each variable
; is found among those already met in constant time, and a call with more
; than a thousand variables runs on the tier.  Every answer is SWI-PeTTa's.

(= (count-cells () $acc) $acc)
(= (count-cells (cons $x $xs) $acc) (count-cells $xs (+ $acc 1)))
(= (open-terms $a $b) (if (< $a $b) (cons-atom (w $a $v) (open-terms (+ $a 1) $b)) ()))
(= (gen-open $n) (if (> $n 0) (superpose ((g $n $v) (gen-open (- $n 1)))) (empty)))

