; Partial logical lists require exact unification after candidate selection.
(= (cell-view (cons $head $tail) $head $tail) OK)
(= (build) (let OK (cell-view $p Row $tail) $p))
(= (count-rows $s) (let $p (build) (length (collapse (match $s $p $p)))))
(= (fold-rows $s) (let $p (build) (foldall + (match $s $p 1) 0)))
!(add-atom &rows (Row))
!(add-atom &rows (Row a))
!(add-atom &rows (Row a))
!(add-atom &rows (Row a b))
!(add-atom &rows (Other a))
!(count-rows &rows)
!(fold-rows &rows)
(= (fill $n) (if (== $n 0) OK (progn (add-atom &rows (Noise $n)) (fill (- $n 1)))))
!(fill 40)
!(count-rows &rows)
!(fold-rows &rows)
