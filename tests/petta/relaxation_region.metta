; Least values per key, kept by functions of the shape a shortest-path
; search writes: a frontier relaxes its keys' edges, and each improvement is
; stored at once.  The least values the rounds reach do not depend on the
; order the frontier and the edges come in.
!(bind! &w (new-space set))
!(bind! &s (new-space set))
(e a b 4)
(e a c 1)
(e c b 2)
(e b d 5)
(e c d 8)
(e d f 3)
(e b f 9)
(e c c 0)
(e a b 6)
!(size-atom (collapse (match &self (e $u $v $c) (add-atom &w (e $u $v $c)))))
!(add-atom &s (sd a 0))
(= (improve $v $nd)
   (let $cur (collapse (match &s (sd $v $y) $y))
     (if (== $cur ())
         (let $_ (add-atom &s (sd $v $nd)) $v)
         (let ($y) $cur
           (if (< $nd $y)
               (let* (($_ (remove-atom &s (sd $v $y))) ($_ (add-atom &s (sd $v $nd)))) $v)
               (empty))))))
(= (relax $u) (match &s (sd $u $d) (match &w (e $u $v $c) (improve $v (+ $d $c)))))
(= (rounds $front)
   (let $next (collapse (unique (let $u (superpose $front) (relax $u))))
     (if (== $next ()) done (rounds $next))))
!(rounds (a))
!(sort-atom (collapse (match &s (sd $v $d) ($v $d))))
; Converged: a frontier stores nothing more.
!(collapse (let $u (superpose (a b c d f)) (relax $u)))
!(size-atom (collapse (let $u (superpose (f d)) (relax $u))))
; A key no value reaches, and a frontier key with no value.
!(collapse (let $u (superpose (z)) (relax $u)))
; Weights that are not integers: the evaluator relaxes them.
!(bind! &w2 (new-space set))
!(bind! &s2 (new-space set))
!(add-atom &w2 (h p q 1.5))
!(add-atom &w2 (h q r 2))
!(add-atom &s2 (sv p 0))
(= (better $v $nd)
   (let $cur (collapse (match &s2 (sv $v $y) $y))
     (if (== $cur ())
         (let $_ (add-atom &s2 (sv $v $nd)) $v)
         (let ($y) $cur
           (if (< $nd $y)
               (let* (($_ (remove-atom &s2 (sv $v $y))) ($_ (add-atom &s2 (sv $v $nd)))) $v)
               (empty))))))
(= (step $u) (match &s2 (sv $u $d) (match &w2 (h $u $v $c) (better $v (+ $d $c)))))
!(collapse (let $u (superpose (p)) (step $u)))
!(collapse (let $u (superpose (q)) (step $u)))
!(sort-atom (collapse (match &s2 (sv $v $d) ($v $d))))
; A key holding two values meets no improvement, as `(let ($y) $cur ...)`
; meets none: the evaluator relaxes it.
!(bind! &w3 (new-space set))
!(bind! &s3 (new-space set))
!(add-atom &w3 (g m x 1))
!(add-atom &w3 (g n x 1))
!(add-atom &s3 (tv m 2))
!(add-atom &s3 (tv n 0))
!(add-atom &s3 (tv x 5))
!(add-atom &s3 (tv x 7))
(= (lower $v $nd)
   (let $cur (collapse (match &s3 (tv $v $y) $y))
     (if (== $cur ())
         (let $_ (add-atom &s3 (tv $v $nd)) $v)
         (let ($y) $cur
           (if (< $nd $y)
               (let* (($_ (remove-atom &s3 (tv $v $y))) ($_ (add-atom &s3 (tv $v $nd)))) $v)
               (empty))))))
(= (push $u) (match &s3 (tv $u $d) (match &w3 (g $u $v $c) (lower $v (+ $d $c)))))
!(collapse (let $u (superpose (m n)) (push $u)))
!(sort-atom (collapse (match &s3 (tv $v $d) ($v $d))))
