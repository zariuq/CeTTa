!(bind! &assoc (new-space))
!(add-atom &assoc (p a))
!(add-atom &assoc (p b))
!(add-atom &assoc (r a))
!(add-atom &assoc (q a))
(= (assoc-read)
   (match &assoc (, (p $x) (, (r $x) (q $x))) $x))
!(nested (collapse (let $x (assoc-read)
    (let $r (add-atom &assoc (r b))
      (let $q (add-atom &assoc (q b)) $x)))))
!(grouped (sort-atom (collapse (match &assoc (, (, (p $x) (r $x)) (q $x)) $x))))
!(flat (sort-atom (collapse (match &assoc (, (p $x) (r $x) (q $x)) $x))))
