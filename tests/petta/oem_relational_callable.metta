!(bind! &lexical-rows (new-space))
!(add-atom &lexical-rows (item first))
!(add-atom &lexical-rows (item first))
!(add-atom &lexical-rows (item second))
(= (captured-choices $left $right)
   (let $step (|-> ($unused) (match &lexical-rows (item $value) (Triple $left $right $value)))
     ($step ignored)))
!(collapse (let $answer (captured-choices $live $live) (let $live done $answer)))
!(bind! &lexical-effects (new-space))
(= (captured-effects $left $right)
   (let $step (|-> ($value)
        (let $unit (add-atom &lexical-effects (Seen $left $right $value))
          (superpose (($left $value) ($right $value)))))
     ($step payload)))
!(collapse (captured-effects left right))
!(collapse (match &lexical-effects $item $item))
(= (lexical-changing $item) (Old $item))
(= (captured-mutation $left $right)
   (let $step (|-> ($item) (Pair $left (lexical-changing (Pair $right $item))))
     (let $first ($step before)
       (let $unit (add-atom &self (= (lexical-changing $item) (New $item)))
         (Both $first (collapse ($step after)))))))
!(captured-mutation left right)
(= (captured-removal $left $right)
   (let $step (|-> ($item) (remove-atom &lexical-effects (Seen $left $right $item)))
     ($step payload)))
!(captured-removal left right)
!(collapse (match &lexical-effects $item $item))
(= (captured-admit-loop $remaining $left $right)
   (if (< $remaining 1) done
     (let $step (|-> ($item) (add-atom &lexical-effects (Event $left $right $item)))
       (let $unit ($step $remaining)
         (captured-admit-loop (- $remaining 1) $left $right)))))
!(captured-admit-loop 1000 left right)
!(size-atom (collapse (match &lexical-effects (Event left right $n) $n)))
(= (captured-cut $left $right)
   (let $item (superpose (first second))
     (let $step (|-> ($value) (let $unit (cut) (Triple $left $right $value)))
       ($step $item))))
!(collapse (captured-cut left right))
(: lexical-number (-> Number Number))
(= (lexical-number $number) $number)
(= (captured-typed $left $right)
   (let $step (|-> ($value) (Triple $left $right (lexical-number $value)))
     ($step "bad")))
!(collapse (captured-typed left right))
(= (captured-literal $left $right)
   (let $step (|-> ($unused)
        (let $unit (match &lexical-rows (item second) true)
          (Record $left $right 1729 "leased literal")))
     ($step ignored)))
!(let $answer (captured-literal $live $live) (let $live done $answer))

!(import! &self (library json))
!(import! &self (library str))
(= (captured-native-json)
   (let $parse (|-> ($text) (__cetta_lib_json_parse_v1 $text))
     (let $first ($parse "7")
       (Pair $first ($parse "8")))))
!(captured-native-json)
(= (captured-native-string)
   (let $join (|-> ($left $right) (__cetta_lib_str concat $left $right))
     (let $first ($join "ce" "tta")
       (Pair $first ($join $first "!")))))
!(captured-native-string)

(= (native-json-box $node) (JsonBox $node $node))
(= (captured-native-json-body)
   (let $parse (|-> ($text) (native-json-box (__cetta_lib_json_parse_v1 $text)))
     (let $first ($parse "7")
       (Pair $first ($parse "8")))))
!(captured-native-json-body)
(= (native-wide-record $text $c $d) (Record $text $c $d $text))
(= (captured-native-wide-body)
   (let $join (|-> ($a $b $c $d)
        (native-wide-record (__cetta_lib_str concat $a $b) $c $d))
     (let $first ($join "ce" "tta" left right)
       (Pair $first ($join "Me" "TTa" right left)))))
!(captured-native-wide-body)

; Non-parameter variables stay with the enclosing form. Reusing this open
; capture for different results fails instead of inventing private locals.
(= (captured-native-shared-local)
   (let $parse (|-> ($text)
        (let $node (__cetta_lib_json_parse_v1 $text) (JsonBox $node $node)))
     (let $first ($parse "7") (Pair $first ($parse "8")))))
!(collapse (captured-native-shared-local))

(= (native-cut-box $node) (JsonBox $node $node))
(= (native-cut-box $node) (JsonBox $node $node))
(= (captured-native-body-once)
   (let $parse (|-> ($text) (native-cut-box (__cetta_lib_json_parse_v1 $text)))
     (collapse (once ($parse "7")))))
!(captured-native-body-once)

(= (relational-json-result $node) (JsonResult $node 7 7))
(= (relational-json-result $node) (JsonResult $node 7 7))
(= (relational-json-result $node) (JsonResult $node 9 9))
(= (captured-relational-prefix)
   (let $parse (|-> ($text) (relational-json-result (__cetta_lib_json_parse_v1 $text)))
     (collapse (let (JsonResult (JsonNumberV1 "1") $z 9) ($parse "1") (Result $z)))))
!(captured-relational-prefix)
(= (captured-relational-bound)
   (let $parse (|-> ($text) (relational-json-result (__cetta_lib_json_parse_v1 $text)))
     (collapse (let (JsonResult (JsonNumberV1 "1") 7 7) ($parse "1") Accepted))))
!(captured-relational-bound)
(= (captured-relational-sharing)
   (let $parse (|-> ($text) (relational-json-result (__cetta_lib_json_parse_v1 $text)))
     (size-atom (collapse (let (JsonResult $node $z $z) ($parse "1") (Result $node $z))))))
!(captured-relational-sharing)
(= (captured-relational-refusal)
   (let $parse (|-> ($text) (relational-json-result (__cetta_lib_json_parse_v1 $text)))
     (collapse (let (JsonResult (JsonNumberV1 "2") $z $z) ($parse "1") (Result $z)))))
!(captured-relational-refusal)
(= (captured-relational-once)
   (let $parse (|-> ($text) (relational-json-result (__cetta_lib_json_parse_v1 $text)))
     (collapse (once (let (JsonResult (JsonNumberV1 "1") $z 9) ($parse "1") (Result $z))))))
!(captured-relational-once)
