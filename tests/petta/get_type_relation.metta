; get-type is the reference's relation over the space's declarations: a
; number, a string or a truth value has its type; a variable any type; an
; application of a declared function whose arguments have the declared types
; has its result type; any other expression the expression of its elements'
; types; and every atom its declared types.  A value is typed as it is, never
; evaluated.
(: f (-> Number Number))
(= (f $x) $x)
(: Cons (-> Number Lst Lst))
(: Nil Lst)
(: id2 (-> $t $t))
(: pairT (-> $a $a Bool))
(: under (-> %Undefined% Number))
(: seed Seed)
(: seed Other)
!(get-type +)
!(get-type f)
!(get-type (quote (+ 1 2)))
!(get-type (quote (f 1)))
!(get-type (quote (f a)))
!(get-type (quote (g 1)))
!(get-type (quote (car-atom (1 2))))
!(get-type (quote (1 "s" True)))
!(get-type ())
!(get-type (+ 1 2))
!(let $e (sread "(* 2 3)") (get-type $e))
!(get-type (quote (Cons 1 (Cons 2 Nil))))
!(get-type (quote (Cons a Nil)))
!(get-type (quote (id2 1)))
!(get-type (quote (pairT 1 2)))
!(get-type (quote (pairT 1 "s")))
!(get-type (quote (under a)))
!(get-type (quote (seed seed)))
!(get-type seed)
!(get-type (quote (1 (2 (3 (4))))))
!(get-type ((quote a) b))
!(get-type (Pt 1 2))
!(get-type (f (quote (1 2))))
!(get-type ((f f) 1))
