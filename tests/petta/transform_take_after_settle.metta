; A two-take rule fires where a join match finds its rows, right after a
; removal settled the space: the marks it left reached the live rows, so the
; rows were contracted and the space's indexes carried over.  The second
; take's reader begins while the first one's is open, and reads the rows as
; they stand.  The space keeps more than a handful of rows, and the first
; take's pattern is one the space selects by another index.
!(import! &self (library lib_transform))
(= (seen $x) (saw $x))
!(bind! &p (new-space))
!(add-atom &p (junk 0))
!(add-atom &p (junk 1))
!(add-atom &p (junk 2))
!(add-atom &p (junk 3))
!(add-atom &p (junk 4))
!(add-atom &p (junk 5))
!(add-atom &p (junk 6))
!(add-atom &p (junk 7))
!(add-atom &p (junk 8))
!(add-atom &p (junk 9))
!(add-atom &p (junk 10))
!(add-atom &p (junk 11))
!(add-atom &p (junk 12))
!(add-atom &p (junk 13))
!(add-atom &p (junk 14))
!(add-atom &p (junk 15))
!(add-atom &p (junk 16))
!(add-atom &p (junk 17))
!(add-atom &p (junk 18))
!(add-atom &p (junk 19))
!(add-atom &p (junk 20))
!(add-atom &p (junk 21))
!(add-atom &p (junk 22))
!(add-atom &p (junk 23))
!(add-atom &p (junk 24))
!(add-atom &p (junk 25))
!(add-atom &p (junk 26))
!(add-atom &p (junk 27))
!(add-atom &p (junk 28))
!(add-atom &p (junk 29))
!(add-atom &p (st on (s z) w0))
!(add-atom &p (st on (s (s z)) w1))
!(add-atom &p (st on (s (s (s z))) w2))
!(add-atom &p (alt (s (s z)) (v 0) h0))
!(add-atom &p (alt (s (s (s z))) (v 1) h1))
!(add-atom &p (alt (s (s (s (s z)))) (v 2) h2))
!(add-atom &p (alt (s (s z)) (v 3) h0))
!(add-atom &p (alt (s (s (s z))) (v 4) h1))
!(add-atom &p (alt (s (s (s (s z)))) (v 5) h2))
!(add-atom &p (alt (s (s z)) (v 6) h0))
!(add-atom &p (alt (s (s (s z))) (v 7) h1))
!(add-atom &p (alt (s (s (s (s z)))) (v 8) h2))
!(add-atom &p (alt (s (s z)) (v 9) h0))
!(add-atom &p (alt (s (s (s z))) (v 10) h1))
!(add-atom &p (alt (s (s (s (s z)))) (v 11) h2))
!(add-atom &p (alt (s (s z)) (v 12) h0))
!(add-atom &p (alt (s (s (s z))) (v 13) h1))
!(add-atom &p (alt (s (s (s (s z)))) (v 14) h2))
!(add-atom &p (alt (s (s z)) (v 15) h0))
!(add-atom &p (alt (s (s (s z))) (v 16) h1))
!(add-atom &p (alt (s (s (s (s z)))) (v 17) h2))
!(add-atom &p (alt (s (s z)) (v 18) h0))
!(add-atom &p (alt (s (s (s z))) (v 19) h1))
; a read of the rows the second take reads, before the removal
!(warm (sort-atom (collapse (transform &p (alt (s $d) $w $h) (seen $d)))))
!(remove-atom &p (junk $i))
!(join (sort-atom (collapse (match &p (, (st on (s $d) $x) (alt (s $d) $w $h)) $d))))
!(fires (collapse (transform &p (, (take (st on (s $d) $x)) (take (alt (s $d) $w $h))) (pair $d $w) &p)))
!(paired (sort-atom (collapse (match &p (pair $d $w) $d))))
!(st-left (sort-atom (collapse (match &p (st on $d $x) $d))))
; controls: a rule no join meets fires nothing, and one more firing finds
; nothing left to pair
!(no-join (collapse (transform &p (, (take (st on (s $d) $x)) (take (alt (s $d) $w none))) (pair $d $w) &p)))
!(again (collapse (transform &p (, (take (st on (s $d) $x)) (take (alt (s $d) $w $h))) (pair $d $w) &p)))
!(alt-left (size-atom (collapse (match &p (alt $d $w $h) $d))))
