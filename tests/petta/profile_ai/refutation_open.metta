; Outside the side conditions of refutation: Z has two declarations, so
; the declarations are not functional and no call is refuted.  The answers
; are those of refutation.metta.
(: List (-> Type Type))
(: Nil (List $a))
(: Cons (-> $a (List $a) (List $a)))
(: build (-> Number (List Number) (List Number)))
(= (build $n $acc) (if (== $n 0) $acc (build (- $n 1) (Cons $n $acc))))
(: Nat Type)
(: Z Nat)
(: Z Zero)
(: S (-> Nat Nat))
(: natchk (-> Nat Number))
(= (natchk $n) 1)
(: chkS (-> (List String) Number))
(= (chkS $l) 2)
(: echk (-> Expression Number))
(= (echk $e) 4)
(: tostr (-> Number String))
(= (tostr $n) (if (== $n 0) "zero" (tostr (- $n 1))))
(: h (-> Number Number))
(= (h $n) (tostr $n))
!(natchk (build 3 Nil))
!(chkS (build 0 Nil))
!(chkS (build 2 Nil))
!(echk (build 1 Nil))
!(h 3)
!(tostr 2)
