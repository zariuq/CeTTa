; PeTTa's ai profile against the default profile, row by row.  In ai a
; function's declaration types the answers of its calls and never an
; unevaluated application of it: a held call is typed as the tuple of its
; elements' types, so it fails a guard at a sort (e02, e04, e08, e17, e18,
; e20, e21) and get-type answers its tuple type (e14).  A constructor's
; declaration still types the data built with it, a function's name keeps
; its arrow type, and an argument that runs is typed by its answer.  The
; rows e29-e32 are calls whose declared result has another head path than
; the parameter that receives it: they fail in both profiles.
(: List (-> Type Type))
(: Nil (List $a))
(: Cons (-> $a (List $a) (List $a)))
(: build (-> Number (List Number) (List Number)))
(= (build $n $acc) (if (== $n 0) $acc (build (- $n 1) (Cons $n $acc))))
(: sum (-> (List Number) Number))
(= (sum Nil) 0)
(= (sum (Cons $x $xs)) (+ $x (sum $xs)))
(: chk (-> (List Number) Bool))
(= (chk $l) True)
(: chkS (-> (List String) Bool))
(= (chkS $l) True)
(: hold (-> Atom Atom))
(= (hold $x) $x)
(: echk (-> Expression Bool))
(= (echk $e) True)
(: idt (-> $t $t))
(= (idt $x) $x)
(: pair (-> Number (List Number) (List Number)))
(: mk (-> Number (List Number) (List Number)))
(= (mk $x $l) (Cons $x $l))
(: mkq (-> (List Number)))
(= (mkq) (quote (build 1 Nil)))
(: noisy (-> (List Number)))
(= (noisy) (let $u (println! noisy-ran) (Cons 1 Nil)))
(: inc (-> Number Number))
(= (inc $x) (+ $x 1))
(: app1 (-> (-> Number Number) Number Number))
(= (app1 $f $x) ($f $x))
(: Nat Type)
(: Z Nat)
(: S (-> Nat Nat))
(: one (-> Nat))
(= (one) (S Z))
(: natchk (-> Nat Bool))
(= (natchk $n) True)
(: mylist (List Number))
(= mylist (Cons 1 Nil))
(stored (build 1 Nil))
!(collapse (let $r (chk (build 1 Nil)) (e01 $r)))
!(collapse (let $r (catch (chk (hold (build 1 Nil)))) (e02 $r)))
!(collapse (let $r (chk (hold (Cons 1 Nil))) (e03 $r)))
!(collapse (let $r (catch (chk (hold (Cons 5 (build 1 Nil))))) (e04 $r)))
!(collapse (let $r (catch (chk (hold (Cons 1 (Snoc Nil 2))))) (e05 $r)))
!(collapse (let $r (chk (hold (Cons 1 (pair 2 Nil)))) (e06 $r)))
!(collapse (let $r (sum (Cons 1 (pair 2 Nil))) (e07 $r)))
!(collapse (let $r (catch (chk (hold (mk 2 Nil)))) (e08 $r)))
!(collapse (let $r (chk (mk 2 Nil)) (e09 $r)))
!(collapse (let $r (hold (build 1 Nil)) (e10 $r)))
!(collapse (let $r (echk (hold (build 1 Nil))) (e11 $r)))
!(collapse (let $r (idt (hold (build 1 Nil))) (e12 $r)))
!(collapse (let $r (get-type (build 1 Nil)) (e13 $r)))
!(collapse (let $r (get-type (quote (build 1 Nil))) (e14 $r)))
!(collapse (let $r (app1 inc 3) (e15 $r)))
!(collapse (let $r (get-type inc) (e16 $r)))
!(collapse (let $r (catch (chk (match &self (stored $x) $x))) (e17 $r)))
!(collapse (let $r (catch (mkq)) (e18 $r)))
!(collapse (let $r (natchk (one)) (e19 $r)))
!(collapse (let $r (catch (natchk (quote (one)))) (e20 $r)))
!(collapse (let $r (catch (sum (hold (build 1 Nil)))) (e21 $r)))
!(collapse (let $r (sum (build 3 Nil)) (e22 $r)))
!(collapse (let $r (chk mylist) (e23 $r)))
!(collapse (let $r (sum mylist) (e24 $r)))
!(collapse (let $r (get-metatype build) (e25 $r)))
!(collapse (let $r (get-metatype Cons) (e26 $r)))
!(collapse (let $r (get-metatype mylist) (e27 $r)))
!(collapse (let $r (get-type (quote (Cons 1 Nil))) (e28 $r)))
!(collapse (let $r (natchk (build 1 Nil)) (e29 $r)))
!(collapse (let $r (chkS (build 0 Nil)) (e30 $r)))
!(collapse (let $r (echk (build 1 Nil)) (e31 $r)))
!(collapse (let $r (natchk (noisy)) (e32 $r)))
