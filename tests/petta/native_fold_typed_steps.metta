; A declared step that integer items, accumulators and results meet once,
; through Number, an unchecked %Undefined% or _, or type variables, lets the
; native fold stand in for its applications; any other declaration keeps
; the protocol's checks of every step.
(item 1)
(item 2)
(item 3)
(: su (-> Number Number %Undefined%))
(= (su $i $a) (+ $i $a))
!(foldall su (match &self (item $x) $x) 0)
(: sv (-> $a $b $a))
(= (sv $i $a) (+ $i $a))
!(foldall sv (match &self (item $x) $x) 0)
(: ss (-> Number Number String))
(= (ss $i $a) (+ $i $a))
!(collapse (foldall ss (match &self (item $x) $x) 0))
(: sa (-> Atom Number Number))
(= (sa $i $a) (+ $i $a))
!(collapse (foldall sa (match &self (item $x) $x) 0))
(: st (-> Number Number Number))
(: st (-> $a $a $a))
(= (st $i $a) (+ $i $a))
!(collapse (foldall st (match &self (item $x) $x) 0))
(mixed 1)
(mixed "s")
(mixed 3)
(: sm (-> $a $a $a))
(= (sm $i $a) (+ $i $a))
!(collapse (foldall sm (match &self (mixed $x) $x) 0))
