!(import! &self (library lib_transform))
!(import! &self (library lib_flow))
!(bind! &jobs (new-space))
!(flow:for-each (superpose (build check deploy)) (|-> ($j) (add-atom &jobs (job $j 2))))
!(add-atom &jobs (worker alice))
!(add-atom &jobs (worker bob))
(= (run-round) (transform &jobs (, (take (job $j $left)) (read (worker $w)) (let true (> $left 0)) (let $rest (- $left 1))) (, (worked $w $j) (job $j $rest)) &jobs))
!(flow:until-quiet (run-round))
!(flow:for-match &jobs (worked $w $j) (println! (share $w $j)))
!(sort-atom (collapse (match &jobs (job $j 0) $j)))
!(bind! &budget (new-state 3))
!(flow:while (> (get-state &budget) 0) (flow:then (println! (tick (get-state &budget))) (change-state! &budget (- (get-state &budget) 1))))
!(get-state &budget)
