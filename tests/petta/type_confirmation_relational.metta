; Wildcards are chosen before a result request binds a declaration variable.
(: (confirmation-pattern a) A)
(: (confirmation-pattern b) A)
(: confirmation-wild (-> %Undefined% Result))
(: confirmation-any (-> _ Result))
(: confirmation-shared (-> $t $t))
!(test (collapse (let Result (get-type (quote (confirmation-wild (confirmation-pattern $x)))) (is-var $x))) (True))
!(test (collapse (let Result (get-type (quote (confirmation-any (confirmation-pattern $x)))) (is-var $x))) (True))
!(test (collapse (let %Undefined% (get-type (quote (confirmation-shared (confirmation-pattern $x)))) wrong)) ())
(: confirmation-request (-> Number A))
!(test (collapse (let $x (get-type (quote (confirmation-request $x))) $x)) (A))
; Rows that repeat one declaration are one declaration, so the repeated
; %Undefined% row confirms once.
(: confirmation-mixed A)
(: confirmation-mixed %Undefined%)
(: confirmation-mixed B)
(: confirmation-mixed %Undefined%)
!(test (collapse (let %Undefined% (get-type confirmation-mixed) found)) (found))
!(test (collapse (let Missing (get-type confirmation-mixed) wrong)) ())

; Both absence probes stop at the first witness and preserve classifier effects.
!(bind! &confirmation-effects (new-state 0))
(= (get-type (confirmation-effect-value))
   (let $u (change-state! &confirmation-effects (+ (get-state &confirmation-effects) 1)) A))
(= (get-type (confirmation-effect-value))
   (let $u (change-state! &confirmation-effects (+ (get-state &confirmation-effects) 1)) A))
(= (get-type (confirmation-effect-value))
   (let $u (change-state! &confirmation-effects (+ (get-state &confirmation-effects) 1)) A))
(: confirmation-effect-call (-> A Result))
!(test (collapse (let %Undefined% (get-type (quote (confirmation-effect-call (confirmation-effect-value)))) wrong)) ())
!(test (get-state &confirmation-effects) 2)

; A bound request constrains the premises; an unbound request waits for its candidate.
(: %Undefined% NotUndefined)
(: (confirmation-reflect $x) (-> $x $x))
!(test (collapse (let %Undefined% (get-type (quote ((confirmation-reflect $x) $x))) wrong)) ())
!(test (collapse (let $t (get-type (quote ((confirmation-reflect $x) $x))) (== $t $x))) (True))
