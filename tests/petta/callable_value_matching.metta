; Public expression patterns cannot decompose a callable execution value.
(= (matching-captured $k) (box (|-> ($x) (+ $k $x))))
(= (matching-named $x $y) ($x $y))
(= (matching-fields ($h $d $b)) leaked)
(= (matching-cons (cons $h $t)) leaked)
(= (matching-nested (box ($h $d $b))) leaked)
(= (matching-same $x $x) true)
!(collapse (let $f (|-> ($x) $x) (let ($h $d $b) $f leaked)))
!(collapse (let $f (|-> ($x) $x) (let (cons $h $t) $f leaked)))
!(collapse (let $f (|-> ($x) $x) (let (box ($h $d $b)) (box $f) leaked)))
!(collapse (let $f (|-> ($x) $x) (matching-fields $f)))
!(collapse (let $f (|-> ($x) $x) (matching-cons $f)))
!(collapse (let $f (|-> ($x) $x) (matching-nested (box $f))))
!(collapse (let $f (|-> () 42) (let ($h $d $b) $f leaked)))
!(collapse (let $f (|-> () 42) (let (cons $h $t) $f leaked)))
!(collapse (let $f (|-> () 42) (let (box ($h $d $b)) (box $f) leaked)))
!(collapse (let $f (|-> () 42) (matching-fields $f)))
!(collapse (let $f (|-> () 42) (matching-cons $f)))
!(collapse (let $f (|-> () 42) (matching-nested (box $f))))
!(collapse (let $f (matching-named 1) (let ($h $d $b) $f leaked)))
!(collapse (let $f (matching-named 1) (let (cons $h $t) $f leaked)))
!(collapse (let $f (matching-named 1) (let (box ($h $d $b)) (box $f) leaked)))
!(collapse (let $f (matching-named 1) (matching-fields $f)))
!(collapse (let $f (matching-named 1) (matching-cons $f)))
!(collapse (let $f (matching-named 1) (matching-nested (box $f))))
!(collapse (let (box $f) (matching-captured 2) (let ($h $d $b) $f leaked)))
!(collapse (let (box $f) (matching-captured 2) (let (cons $h $t) $f leaked)))
!(collapse (let (box $f) (matching-captured 2) (let (box ($h $d $b)) (box $f) leaked)))
!(collapse (let (box $f) (matching-captured 2) (matching-fields $f)))
!(collapse (let (box $f) (matching-captured 2) (matching-cons $f)))
!(collapse (let (box $f) (matching-captured 2) (matching-nested (box $f))))
!(collapse (let $f (|-> ($x) $x) (let $g $f (== $g $f))))
!(collapse (let $f (|-> ($x) $x) (let (box $g) (box $f) (== $g $f))))
!(collapse (let $f (|-> ($x) $x) (matching-same $f $f)))
!(collapse (let $f (|-> () 42) (let $g $f (== $g $f))))
!(collapse (let $f (|-> () 42) (let (box $g) (box $f) (== $g $f))))
!(collapse (let $f (|-> () 42) (matching-same $f $f)))
!(collapse (let $f (matching-named 1) (let $g $f (== $g $f))))
!(collapse (let $f (matching-named 1) (let (box $g) (box $f) (== $g $f))))
!(collapse (let $f (matching-named 1) (matching-same $f $f)))
!(collapse (let (box $f) (matching-captured 2) (let $g $f (== $g $f))))
!(collapse (let (box $f) (matching-captured 2) (let (box $g) (box $f) (== $g $f))))
!(collapse (let (box $f) (matching-captured 2) (matching-same $f $f)))
!(collapse (matching-same (|-> ($x) $x) (|-> ($x) $x)))
!(collapse (let $f (matching-named 1) (let $g (matching-named 2) (matching-same $f $g))))
!(collapse (let (box $f) (matching-captured 2) (let (box $g) (matching-captured 3) (matching-same $f $g))))
!(collapse (matching-fields (quote (Lam Nat (idx 0)))))
!(collapse (matching-fields (quote (partial matching-named (1)))))
!(collapse (matching-cons (quote (partial matching-named (1)))))
!(collapse (matching-nested (box (quote (Lam Nat (idx 0))))))
!(size-atom (quote (Lam (PeTTa.CallableV1 1) (idx 0))))
!(is-expr (quote (PeTTa.NullaryCallableV1 1 42)))
!(collapse (let (cons $h $t) (quote (Lam Nat (idx 0))) $h))

; Admission into a space preserves both opacity and whole-value identity.
!(collapse (let $f (|-> ($x) $x) (progn (add-atom &matching-flat-store (box $f)) (match &matching-flat-store (box ($h $d $b)) leaked))))
!(collapse (let $f (matching-named 1) (progn (add-atom &matching-cons-store (box $f)) (match &matching-cons-store (box (cons $h $t)) leaked))))
!(collapse (let $f (|-> ($x) $x) (progn (add-atom &matching-identity-store (box $f)) (match &matching-identity-store (box $g) (== $f $g)))))
!(collapse (let $f (matching-named 1) (progn (add-atom &matching-application-store (box $f)) (match &matching-application-store (box $g) ($g 2)))))

; Removal uses the same stored matcher and must preserve nominal identity.
!(let $f (|-> ($a $b) (+ $a $b)) (progn (add-atom &matching-remove-closed (row $f)) (remove-atom &matching-remove-closed (row $f)) (collapse (get-atoms &matching-remove-closed))))
!(let $f (|-> () 42) (progn (add-atom &matching-remove-nullary (row $f)) (remove-atom &matching-remove-nullary (row $f)) (collapse (get-atoms &matching-remove-nullary))))
!(let $f (matching-named 1) (progn (add-atom &matching-remove-partial (row $f)) (remove-atom &matching-remove-partial (row $f)) (collapse (get-atoms &matching-remove-partial))))
!(let (box $f) (matching-captured 2) (progn (add-atom &matching-remove-capture (row $f)) (remove-atom &matching-remove-capture (row $f)) (collapse (get-atoms &matching-remove-capture))))
!(let $f (|-> ($a $b) (+ $a $b)) (progn (add-atom &matching-remove-vars (row (nested $f $x $x))) (match &matching-remove-vars (row $g) (progn (remove-atom &matching-remove-vars (row $g)) (collapse (get-atoms &matching-remove-vars))))))
!(let $f (|-> ($x) $x) (let $g (|-> ($x) $x) (progn (add-atom &matching-remove-distinct (row $f)) (remove-atom &matching-remove-distinct (row $g)) (size-atom (collapse (get-atoms &matching-remove-distinct))))))
!(let $f (matching-named 1) (progn (add-atom &matching-remove-data (row $f)) (remove-atom &matching-remove-data (row (quote (partial matching-named (1))))) (size-atom (collapse (get-atoms &matching-remove-data)))))
