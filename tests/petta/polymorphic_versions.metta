; A formal whose type variables no other formal and no result names is
; private: each call guards it with fresh variables, and the guard passes
; once exactly when the value is typed at some closed instance.  A typed
; function's calls to itself on such a value's typed fields meet it again.
(: List (-> Type Type))
(: Nil (List $a))
(: Cons (-> $a (List $a) (List $a)))
(: len (-> (List $a) Number))
(= (len Nil) 0)
(= (len (Cons $x $xs)) (+ 1 (len $xs)))
!(len (Cons 1 (Cons 2 (Cons 3 Nil))))
!(len (Cons "x" Nil))
!(len Nil)
!(collapse (len (Cons 1 (Cons "x" Nil))))
!(collapse (len (foo)))
!(collapse (len (superpose ((Cons 1 Nil) (Cons "a" (Cons "b" Nil)) Nil))))
(: sum (-> (List $a) Number))
(= (sum Nil) 0)
(= (sum (Cons $x $xs)) (+ $x (sum $xs)))
!(sum (Cons 4 (Cons 5 Nil)))
(: Tree (-> Type Type))
(: Leaf (-> $a (Tree $a)))
(: Node (-> (Tree $a) (Tree $a) (Tree $a)))
(: leaves (-> (Tree $a) Number))
(= (leaves (Leaf $v)) 1)
(= (leaves (Node $l $r)) (+ (leaves $l) (leaves $r)))
!(leaves (Node (Leaf 1) (Node (Leaf 2) (Leaf 3))))
!(leaves (Node (Leaf "a") (Leaf "b")))
!(collapse (leaves (Node (Leaf 1) (Leaf "b"))))
; Not private: the variable occurs twice in the formal, or in two formals.
(: Pair (-> Type Type Type))
(: MkPair (-> $a $b (Pair $a $b)))
(: same (-> (Pair $a $a) Number))
(= (same (MkPair $x $y)) 1)
!(collapse (same (MkPair 1 2)))
!(collapse (same (MkPair 1 "x")))
(: both (-> (List $a) (List $a) Number))
(= (both Nil Nil) 0)
(= (both (Cons $x $xs) (Cons $y $ys)) (+ 1 (both $xs $ys)))
!(collapse (both (Cons 1 Nil) (Cons 2 Nil)))
!(collapse (both (Cons 1 Nil) (Cons "x" Nil)))
; A variable shared with the result: a body building (Cons $n $acc) fixes
; it at Number, whose closed instance has a version.  A call enters that
; version only with arguments typed once at the instance; others keep the
; protocol, which answers nothing where a later call's guard fails.
(: build (-> Number (List $a) (List $a)))
(= (build $n $acc) (if (== $n 0) $acc (build (- $n 1) (Cons $n $acc))))
!(build 3 Nil)
!(build 2 (Cons 7 Nil))
!(collapse (build 2 (Cons "a" Nil)))
!(collapse (build 0 (Cons "a" Nil)))
!(collapse (build (superpose (0 1)) (Cons "a" Nil)))
(: app (-> (List $a) (List $a) (List $a)))
(= (app Nil $ys) $ys)
(= (app (Cons $x $xs) $ys) (Cons $x (app $xs $ys)))
!(app (Cons 1 (Cons 2 Nil)) (Cons 3 Nil))
!(app (Cons "a" Nil) (Cons "b" Nil))
!(collapse (app (Cons 1 Nil) (Cons "b" Nil)))
!(app Nil Nil)
