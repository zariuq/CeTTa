; PeTTa's arithmetic is SWI-Prolog's is/2 in every build: exp and the math
; functions give SWI's values and number types, the named constants
; evaluate, and a string, an expression, a symbol naming no constant or an
; unbound operand raises SWI's error, as does an undefined, infinite or
; zero-divided result.
(= (outcome $x) (case $x (((Error $formal $context) (error $formal)) ($value $value))))
!(exp 0)
!(exp 1)
!(exp 0.5)
!(exp -1000)
!(exp pi)
!(outcome (catch (exp "a")))
!(outcome (catch (exp (1))))
!(outcome (catch (exp foo)))
!(outcome (catch (exp $x)))
!(outcome (catch (exp 1000)))
!(outcome (catch (exp nan)))
!(sqrt-math 16)
!(pow-math 2 10)
!(pow-math 2 -1)
!(pow-math 2.0 3)
!(pow-math 2 100)
!(log-math 2 8)
!(abs-math -3)
!(round-math 2.5)
!(round-math -2.5)
!(trunc-math 1.0e20)
!(floor-math -2.5)
!(ceil-math 2.1)
!(sin-math 0)
!(outcome (catch (sqrt-math -1)))
!(outcome (catch (sqrt-math "s")))
!(outcome (catch (asin-math 2)))
!(outcome (catch (log-math 10 0)))
!(outcome (catch (pow-math 0 -1)))
!(outcome (catch (pow-math 10.0 400)))
!(+ pi 0)
!(* e 1)
!(/ 7 2)
!(/ 6 2)
!(% -7 2)
!(outcome (catch (+ 1 foo)))
!(outcome (catch (+ 1 "a")))
!(outcome (catch (* 1 (2))))
!(outcome (catch (/ 1 0)))
!(outcome (catch (/ 0.0 0.0)))
!(outcome (catch (% 1 0)))
!(outcome (catch (% 7.5 2)))
!(outcome (catch (* 1.0e308 10.0)))
!(min 2 1)
!(max 1 2.0)
!(implies true false)
!(implies false false)
!(collapse (implies $a true))
!(=? (f $x b) (f a $y))
!(=? (f $x $x) (f a b))
