;; Equality observes the list a chain of cons cells spells: a closed chain
;; equals the list it spells, nested or not, and differs from any other list;
;; an open or improper chain stays a chain; a quote keeps what it quotes.
(= (two $a $b) (cons $a (cons $b ())))
(= (three $a $b $c) (cons $a (cons $b (cons $c ()))))
(= (same $x $y) (== $x $y))
(= (wrapped $x $y) (== (box $x) (box $y)))
!(same (two 1 2) (1 2))
!(same (two 1 2) (two 1 2))
!(same (1 2) (two 1 2))
!(same (two 1 2) (1 3))
!(same (two 1 2) (1 2 3))
!(same (three 1 2 3) (1 2))
!(same (two (two 1 2) 3) ((1 2) 3))
!(same (two (two 1 2) 3) ((1 3) 3))
!(wrapped (two a b) (a b))
!(wrapped (two a b) (b a))
!(same (cons 1 (2 3)) (1 2 3))
!(same (cons 1 foo) (cons 1 foo))
!(same (cons 1 foo) (1 foo))
!(same (cons 1 foo) (cons 1 bar))
!(same (two 1 2) ())
!(same (cons () ()) (()))
!(same (two "s" 2.5) ("s" 2.5))
!(same (two x y) (x y z))
!(same (quote (1 2)) (quote (1 2)))
