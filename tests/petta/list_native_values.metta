; foldl, foldl-atom, map-atom and maplist hand each element and accumulator
; to their callable or body as a value, as SWI-PeTTa's foldl/4 and maplist
; do: a value that spells a call is not called again.
(= (foo) 42)
(= (f $x $acc) (cons $x $acc))
(= (g $x $acc) ($x $acc))
(= (mk) (quote ((foo) 1)))
(= (wrapit $x) ($x))
(= (mm $l) (maplist wrapit $l))
(= (ma $l) (map-atom $l $x ($x)))
(= (fa $l) (foldl-atom $l () $acc $x (cons $x $acc)))
(= (fl $l) (foldl f $l ()))
(= (ma2 $l) (map-atom $l $x (let $y $x ($y $y))))
!(foldl f (quote ((foo) 1)) ())
!(foldl g (mk) start)
!(foldl f (1 2) (quote (foo)))
!(let $l (quote ((foo))) (foldl g $l z))
!(foldl (|-> ($x $acc) (cons $x $acc)) (1 2) ())
!(foldl + (1 2 3) 0)
!(foldl-atom (quote ((foo) 1)) () $acc $x (cons $x $acc))
!(foldl-atom (1 2) (quote (foo)) $acc $x (cons $x $acc))
!(foldl-atom (1 2 3) 0 $acc $x (+ $acc $x))
!(map-atom (quote ((foo) 1)) $x ($x))
!(map-atom (1 2 3) $x (+ $x 1))
!(map-atom (1 2) $x (let $y $x ($y $y)))
!(maplist wrapit (quote ((foo) 1)))
!(mm (quote ((foo) 1)))
!(ma (quote ((foo) 1)))
!(fa (quote ((foo) 1)))
!(fl (quote ((foo) 1)))
!(ma2 (1 2))
