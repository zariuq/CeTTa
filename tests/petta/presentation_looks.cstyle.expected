import!(&self, library{lib_transform});
import!(&self, library{lib_flow});
atom edge{a, b};
atom edge{b, c};
len([]) = 0;
len(cons{$h, $t}) = 1 + len($t);
len(cons(x, cons(y, [])));
collapse(match &self { edge{$x, $y} => pair($x, $y) });
show-held : Atom -> Atom;
show-held($x) = $x;
twice($x) = 2 * $x;
show-held(twice{3});
no-such-function(twice(3));
build($x, $y) = built;
steps($xs) = $xs;
steps(build(check, deploy));
show-held(build{check, deploy});
collapse(superpose([twice(1), twice(2)]));
get-metatype(twice(3));
atom color{red};
add-atom(&self, color{green});
collapse(match &self { color{$c} => $c });
bind!(&s, new-space());
add-atom(&s, job{j1, 2});
add-atom(&s, job{j2, 0});
add-atom(&s, busy{j2});
collapse(match &s { job{$j, $n} => $n + 1 });
collapse(transform &s { job{$j, $n}, absent busy{$j} => free($j) });
transform &s { take job{$j, 0}, read busy{$j} => done{$j} } into &s;
collapse(transform &s { once { job{$j, $n} } => $j });
collapse(transform &s { collect { job{$j, $n} } into $all => size-atom($all) });
for ($x of [a, b]) { println!(item($x)) };
for ($x of [twice(1), b]) { println!(item($x)) };
for ($x in twice(2)) { println!(answer($x)) };
do { println!(first); second };
for (job{$j, $n} from &s) { println!(has($j)) };
