; Structural observations and boolean unification refine values, not syntax.
!(let $flag (translatePredicate (set_prolog_flag occurs_check true)) configured)
(= (observe $x) (Flags (is-var $x) (is-expr $x) (is-ground $x) (is-space $x)))
(= (observe-computed) (Flags (is-var (+ 2 3)) (is-expr (cons a ())) (is-ground (progn ignored 7)) (is-space (prog1 &self ignored))))
(= (observe-choice) (Box (is-expr (superpose (a () (Pair a b) () $free)))))
(= (refine) (progn (= (Pair $x $x) (Pair a a)) ignored (Result $x (is-var $x))))
(= (rollback) (let $r (= (Pair $x $x) (Pair a b)) (Result $r (is-var $x))))
(= (rollback-old $x) (let $r (= (Pair $x $x) (Pair a b)) (Result $r (is-var $x))))
(= (rollback-alias) (progn (= $x $y) (let $r (= (Pair $x $y) (Pair a b)) (Result $r (is-var $x) (is-var $y)))))
(= (refine-choice) (let $v (superpose (a b a)) (let $r (= $x $v) (Result $r $x))))
(= (rollback-then-bind) (progn (= (Pair $x $x) (Pair a b)) (= $x good) (Result $x)))
(= (equal-values $x $y) (Box (= $x $y)))
(= (equal-computed) (Box (= (+ 2 3) (prog1 5 ignored))))
(= (equal-choice) (Box (= (superpose (a a b)) (superpose (a b)))))
(= (equal-occurs) (let $r (= $x (cons a $x)) (Result $r (is-var $x))))
(= (equal-early) (prog1 (= a a) (println! unreachable-equal)))
(= (equal-effect) (= (progn (println! equality-left) a) (progn (println! equality-right) a)))
(= (equal-cut) (progn (= $x a) (cut) (Result $x)))
(= (equal-cut) rejected)
(= (numbers $a $b) (Numbers (min $a $b) (max $a $b) (% $a $b)))
(= (numbers-computed) (Numbers (min (+ 3 4) (prog1 9 ignored)) (max (progn ignored 7) (+ 3 6))))
(= (number-choice) (min (superpose (9 2 9)) (superpose (4 7))))
(= (number-error) (progn ignored (min 1 not-a-number)))
(= (number-effect) (min (progn (println! min-left) 3.5) (progn (println! min-right) 2.5)))
(= (undefined $x) (Box (// (+ $x 1) 2) (numeric-eq $x $x)))
!(observe $free)
!(observe ())
!(observe (Pair $free b))
!(observe (cons a $tail))
!(observe &self)
!(observe &)
!(observe "&self")
!(observe-computed)
!(collapse (observe-choice))
!(refine)
!(rollback)
!(rollback-old $free)
!(rollback-alias)
!(collapse (refine-choice))
!(rollback-then-bind)
!(equal-values (quote (cons a (b))) (quote (cons a (b))))
!(equal-values (cons a (b)) (a b))
!(equal-values 1 1.0)
!(equal-values (Pair a b) (Pair a c))
!(equal-computed)
!(collapse (equal-choice))
!(equal-occurs)
!(collapse (let false (equal-early) yes))
!(equal-effect)
!(collapse (equal-cut))
!(numbers 7 3)
!(numbers -7 3)
!(numbers-computed)
!(collapse (number-choice))
!(let (Error $kind $context) (catch (number-error)) $kind)
!(number-effect)
!(undefined 6)
