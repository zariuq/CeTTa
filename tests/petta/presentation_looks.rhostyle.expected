import library[lib_transform] in &self;
import library[lib_flow] in &self;
@{ edge[a, b] };
@{ edge[b, c] };
contract len([]) = { 0 };
contract len(cons[$h, $t]) = { 1 + len($t) };
len(cons(x, cons(y, [])));
collapse(for (edge[$x, $y] <<- &self) { pair($x, $y) });
show-held : Atom -> Atom;
contract show-held($x) = { $x };
contract twice($x) = { 2 * $x };
show-held(twice[3]);
no-such-function(twice(3));
contract build($x, $y) = { built };
contract steps($xs) = { $xs };
steps(build(check, deploy));
show-held(build[check, deploy]);
collapse(superpose([twice(1), twice(2)]));
get-metatype(twice(3));
@{ color[red] };
&self!(color[green]);
collapse(for (color[$c] <<- &self) { $c });
new &s;
&s!(job[j1, 2]);
&s!(job[j2, 0]);
&s!(busy[j2]);
collapse(for (job[$j, $n] <<- &s) { $n + 1 });
collapse(select { job[$j, $n] <<- &s where count(busy[$j] <<- &s) == 0 => free($j) });
select { job[$j, 0] <- &s & @{ busy[$j] } <<- &s => &s!(done[$j]) };
collapse(select { once { job[$j, $n] <<- &s } => $j });
collapse(select { collect { job[$j, $n] <<- &s } into $all => size-atom($all) });
foreach ($x of [a, b]) { stdout!(item($x)) };
foreach ($x of [twice(1), b]) { stdout!(item($x)) };
foreach ($x <- twice(2)) { stdout!(answer($x)) };
let _ <- stdout!(first) in { second };
for (job[$j, $n] <= &s) { stdout!(has($j)) };
