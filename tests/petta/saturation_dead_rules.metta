; A saturation region whose rule reads, from each of two premises, a
; relation and its reverse view that no fact of K holds yet: the rule cannot
; fire while the region runs, which needs no coverage of it.
(sc GStud Stud)
(sc Stud Pers)
(ex Advd Pers adv Fac)
(inv adv advOf)
(ty GStud s1)
(ty Fac f1)
(ty GStud s2)
(tr adv s1 f1)
!(bind! &kb (new-space set))
(= (add-ty $c $x)
   (if (== (collapse (match &kb (ty $c $x) t)) ())
       (let $_ (add-atom &kb (ty $c $x)) (fire-ty $c $x))
       (empty)))
(= (add-tr $p $s $o)
   (if (== (collapse (match &kb (tr $p $s $o) t)) ())
       (let* (($_ (add-atom &kb (tr $p $s $o))) ($_ (add-atom &kb (rtr $p $o $s)))) (fire-tr $p $s $o))
       (empty)))
(= (fire-ty $c $x) (match &self (sc $c $d) (add-ty $d $x)))
(= (fire-ty $a $x) (match &self (ex $c $a $p $d) (match &kb (tr $p $x $y) (match &kb (ty $d $y) (add-ty $c $x)))))
(= (fire-ty $d $y) (match &self (ex $c $a $p $d) (match &kb (rtr $p $y $x) (match &kb (ty $a $x) (add-ty $c $x)))))
(= (fire-tr $p $s $o) (match &self (inv $p $q) (add-tr $q $o $s)))
(= (fire-tr $p $x $y) (match &self (ex $c $a $p $d) (match &kb (ty $d $y) (match &kb (ty $a $x) (add-ty $c $x)))))
!(size-atom (collapse (match &self (ty $c $x) (add-ty $c $x))))
!(sort-atom (collapse (match &kb (ty $c $x) ($c $x))))
!(size-atom (collapse (match &self (tr $p $s $o) (add-tr $p $s $o))))
!(sort-atom (collapse (match &kb (ty $c $x) ($c $x))))
!(sort-atom (collapse (match &kb (tr $p $s $o) ($p $s $o))))
; A relation fact K holds without its reverse view: the rule can fire, and
; read from its two premises it is two rules, so the run is depth first.
!(bind! &kb2 (new-space set))
!(add-atom &kb2 (tr p x1 y1))
(ex2 C A p D)
(seed2 A x1)
(seed2 D y1)
(= (add-ty2 $c $x)
   (if (== (collapse (match &kb2 (ty $c $x) t)) ())
       (let $_ (add-atom &kb2 (ty $c $x)) (fire-ty2 $c $x))
       (empty)))
(= (fire-ty2 $a $x) (match &self (ex2 $c $a $p $d) (match &kb2 (tr $p $x $y) (match &kb2 (ty $d $y) (add-ty2 $c $x)))))
(= (fire-ty2 $d $y) (match &self (ex2 $c $a $p $d) (match &kb2 (rtr $p $y $x) (match &kb2 (ty $a $x) (add-ty2 $c $x)))))
!(size-atom (collapse (match &self (seed2 $c $x) (add-ty2 $c $x))))
!(sort-atom (collapse (match &kb2 (ty $c $x) ($c $x))))
