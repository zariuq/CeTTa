; A term built in Prolog that is not a finite tree crosses into MeTTa as the
; term it is: == compares such terms by their unfoldings, numbers by value and
; every NaN as one value, argument order and zero-argument compounds kept.
; Operations read a node of such a term as its term one level open, and
; unification meets two of them by their unfoldings.  A free variable of
; such a term is a variable of the program: binding it anywhere binds it in
; the term.  Run-time dispatch leaves no cyclic data, a match answers no
; cyclic template, and a space refuses such a term.  The answers are
; SWI-PeTTa's.
(item 1)
(item 2)
!(let $_ (translatePredicate (= $c (f $c))) (== $c $c))
!(let* (($_ (translatePredicate (= $c (f 1 $c)))) ($_ (translatePredicate (= $d (f 1.0 $d))))) (== $c $d))
!(let* (($_ (translatePredicate (= $c (f 1 $c)))) ($_ (translatePredicate (= $d (f 1 (f 1 $d)))))) (== $c $d))
!(let* (($_ (translatePredicate (= $c (f 1 $c)))) ($_ (translatePredicate (= $d (f 2 $d))))) (== $c $d))
!(let* (($_ (translatePredicate (is $n nan))) ($_ (translatePredicate (= $c (f $n $c))))) (== $c $c))
!(let* (($_ (translatePredicate (= $c (f (g $c))))) ($_ (translatePredicate (= $h (g (f $h))))) ($_ (translatePredicate (= $d (f $h))))) (== $c $d))
!(let* (($_ (translatePredicate (compound_name_arguments $z z ()))) ($_ (translatePredicate (= $c (f $z $c))))) (== $c $c))
!(let* (($_ (translatePredicate (compound_name_arguments $z z ()))) ($_ (translatePredicate (compound_name_arguments $q q ()))) ($_ (translatePredicate (= $c (f $z $c)))) ($_ (translatePredicate (= $d (f $q $d))))) (== $c $d))
!(let* (($_ (translatePredicate (= $c (f $c a)))) ($_ (translatePredicate (= $d (f a $d))))) (== $c $d))
!(let* (($_ (translatePredicate (= $c (f $c)))) ($_ (translatePredicate (= $d (f $d))))) (!= $c $d))
!(let $_ (translatePredicate (= $c (f $c))) (car-atom $c))
!(let $_ (translatePredicate (= $c (a b $c))) (size-atom $c))
!(let $_ (translatePredicate (= $c (a b $c))) (== (index-atom $c 2) $c))
!(let* (($_ (translatePredicate (= $c (f $c)))) ($_ (translatePredicate (= $d (g $c))))) (== (index-atom $d 1) $c))
!(let $_ (translatePredicate (= $c (f $c))) (car-atom (index-atom $c 1)))
!(let $_ (translatePredicate (= $c (a b $c))) (size-atom (index-atom $c 2)))
!(let $_ (translatePredicate (= $c (a b $c))) (index-atom (index-atom $c 2) 0))
!(let $_ (translatePredicate (= $c (f $c))) (get-metatype (index-atom $c 1)))
!(let $_ (translatePredicate (= $c [a|$c])) (get-metatype $c))
!(let $_ (translatePredicate (= $c [a|$c])) (is-expr $c))
!(let $_ (translatePredicate (= $c (a b $c))) (let ($x $y $z) (index-atom $c 2) (== $z $c)))
!(let* (($_ (translatePredicate (= $c (a b $c)))) ($_ (translatePredicate (= $d (a b (a b $d)))))) (let $c $d yes))
!(let* (($_ (translatePredicate (= $c (a b $c)))) ($_ (translatePredicate (= $d (a b (a c $d)))))) (let $c $d yes))
!(let $_ (translatePredicate (= $c [a|$c])) (let ($x $y) $c no))
!(let $_ (translatePredicate (= $c (a b $c))) (is-ground $c))
!(let $_ (translatePredicate (= $c (a b $c))) (collapse (index-atom (msort ($c 1 z)) 2)))
!(let* (($_ (translatePredicate (= $c (f $c)))) ($_ (translatePredicate (= $d (f (f $d)))))) (size-atom (unique-atom (cons-atom $c (cons-atom $d ())))))
!(let $_ (translatePredicate (= $c (f $c))) (catch (add-atom &self (cyc $c))))
!(let $_ (translatePredicate (= $c (f $c))) (collapse (match &self (item $x) ($x $c))))
!(let $_ (translatePredicate (= $c (f $x $c))) ok)
!(let* (($_ (translatePredicate (= $c (f $x $c)))) ($_ (translatePredicate (= $d (f $y $d))))) (== $c $d))
!(let* (($_ (translatePredicate (= $c (f $x $c)))) ($_ (translatePredicate (= $d (f $x $d))))) (== $c $d))
!(let* (($_ (translatePredicate (= $c (f $x $c)))) ($_ (translatePredicate (= $x 1)))) (== $c $c))
!(let* (($_ (translatePredicate (= $c (f $x $c)))) ($_ (translatePredicate (= $x 1))) ($_ (translatePredicate (= $d (f 1 $d))))) (== $c $d))
!(let* (($_ (translatePredicate (= $c (f $x $c)))) ($x 7) ($_ (translatePredicate (= $d (f 7 $d))))) (== $c $d))
!(let* (($_ (translatePredicate (= $c (f $x $c)))) ($_ (translatePredicate (= $x 1)))) (index-atom $c 1))
!(let* (($_ (translatePredicate (= $c (f $x $c)))) ($x 7)) (index-atom (index-atom $c 2) 1))
!(let* (($_ (translatePredicate (= $c (f $x $c)))) ($_ (translatePredicate (= $d (f 3 $d)))) ($c $d)) $x)
!(let* (($_ (translatePredicate (= $c ($x a $c)))) ((3 $y $z) $c)) (== $z $c))
!(let* (($_ (translatePredicate (= $c (f $x $c)))) ($_ (translatePredicate (= $d (f $y $d)))) ($c $d)) (== $x $y))
!(let $_ (translatePredicate (= $c (f $x $c))) (is-ground $c))
!(let $_ (translatePredicate (= $c (f $x $c))) (get-metatype (index-atom $c 2)))
!(let $_ (translatePredicate (= $c (f $x $c))) (size-atom (unique-atom (cons-atom $c (cons-atom $c ())))))
!(let* (($_ (translatePredicate (= $c (f $x $c)))) ($_ (translatePredicate (= $x 9)))) (translatePredicate (== $c (f 9 $c))))
!(let* (($_ (translatePredicate (= $c (f $x $c)))) ($_ (translatePredicate (= $c (f 4 $w))))) $x)
!(let* (($_ (translatePredicate (= $c ($x $y $c)))) ($x $y)) (== (index-atom $c 0) (index-atom $c 1)))
