; PeTTa min and max select one of their operands by the numeric order of what
; they stand for: a constant stays itself ((min pi 4) is pi), integers and
; floats compare exactly, -0.0 is below 0 and 0.0, a NaN operand propagates,
; and on a tie min answers its first operand and max its second, so
; (min a b) and (max a b) are a stable sort of a and b.  SWI-PeTTa computes
; them as arithmetic instead (swi_differences entry 17).
!(min 2 2.0)
!(min 2.0 2)
!(max 2 2.0)
!(max 2.0 2)
!(min -0.0 0.0)
!(min 0.0 -0.0)
!(max -0.0 0.0)
!(max 0.0 -0.0)
!(min 0 -0.0)
!(min -0.0 0)
!(max 0 -0.0)
!(max -0.0 0)
!(min 0.0 0)
!(max 0 0.0)
!(min 1 2.5)
!(min 3 2.5)
!(min 9223372036854775807 9223372036854775808)
!(max 9007199254740993 9007199254740992.0)
!(min 9223372036854775809 9.223372036854775808e18)
!(max 9.223372036854775808e18 9223372036854775809)
!(min (min 9223372036854775809 9.223372036854775808e18) 9223372036854775808)
!(min 9223372036854775809 (min 9.223372036854775808e18 9223372036854775808))
!(min -9223372036854775808 -9.223372036854775808e18)
!(max -9223372036854775808 -9.223372036854775808e18)
!(min inf 100000000000000000000000000000000000000000000000000)
!(max -inf -100000000000000000000000000000000000000000000000000)
!(min pi 3.141592653589793)
!(min pi 4)
!(max e 1)
!(min 4 pi)
!(max nan 1.0)
!(min 1.0 nan)
!(min inf 1)
!(min 3 3)
!(== pi (min pi 4))
!(== 2 (min 2 2.0))
!(== 2.0 (min 2.0 2))
(= (mn $a $b) (min $a $b))
(= (mx $a $b) (max $a $b))
!(mn 2 2.0)
!(mn 0.0 -0.0)
!(mx -0.0 0.0)
!(mn 0 -0.0)
!(mx 0 -0.0)
!(mx 2.0 2)
!(mn pi 4)
!(mx nan 1.0)
(= (minmax-loop $remaining $value)
   (if (< $remaining 1) $value
     (minmax-loop (- $remaining 1) (max (min $value 2.5) 0.5))))
!(minmax-loop 100 1.5)
