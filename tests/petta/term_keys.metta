; Lookups keyed by ground terms: rows whose key column holds a term, rows
; whose key column holds a term with variables (which match by
; unification), numbers inside terms, and keys no row holds.
!(bind! &fm (new-space))
!(add-atom &fm (memo q1 (cell a (cell b nil)) 2 found-ab))
!(add-atom &fm (memo q1 (cell a nil) 2 found-a))
!(add-atom &fm (memo q1 (cell b nil) 2 found-b))
!(add-atom &fm (memo q2 (cell a nil) 2 other-q))
!(add-atom &fm (memo q1 (cell $x (cell $x nil)) 2 found-twin))
!(add-atom &fm (memo q1 (pair 1 2) 3 found-int))
!(add-atom &fm (memo q1 (pair 1.0 2) 3 found-float))
!(add-atom &fm (memo q1 ("s" (t)) 4 found-string))
(= (look $q $u $n) (collapse (match &fm (memo $q $u $n $l) $l)))
(= (looked $q $u $n) (sort (look $q $u $n)))
!(looked q1 (cell a (cell b nil)) 2)
!(looked q1 (cell a nil) 2)
!(looked q2 (cell a nil) 2)
!(looked q1 (cell b (cell b nil)) 2)
!(looked q1 (cell c nil) 2)
!(looked q1 (pair 1 2) 3)
!(looked q1 (pair 1.0 2) 3)
!(looked q1 ("s" (t)) 4)
!(looked q3 (cell a nil) 2)
!(looked q1 (cell a nil) 5)
