; A value bound to a variable is data.  An operation given the variable, alone
; or inside a data expression, reads the value and never evaluates it again;
; an operand written as a call is evaluated once.  Each directive answers as
; SWI-PeTTa does.
(= (alpha-of $e) (is-alpha-member $e ()))
(= (alpha-in $e $list) (is-alpha-member $e $list))
!(alpha-member-value (collapse (let $e (quote (k (superpose (a b)))) (is-alpha-member $e ()))))
!(alpha-member-arith (collapse (let $e (quote (k (+ 1 2))) (is-alpha-member $e ((k 3))))))
!(alpha-member-list-value (collapse (let $e (quote ((k (+ 1 2)))) (is-alpha-member (k 3) $e))))
!(alpha-member-list-value-found (collapse (let $e (quote ((k (+ 1 2)))) (is-alpha-member (k (+ 1 2)) $e))))
!(alpha-member-in-data (collapse (let $e (quote (k (superpose (a b)))) (is-alpha-member (w $e) ((w (k a)))))))
!(alpha-member-parameter (collapse (alpha-of (quote (k (superpose (a b)))))))
!(alpha-member-two-parameters (collapse (alpha-in (quote (k (+ 1 2))) (quote ((k (+ 1 2)))))))
!(alpha-member-written-call (collapse (is-alpha-member (k (+ 1 2)) ((k 3)))))
!(alpha-member-written-choice (sort-atom (collapse (is-alpha-member (k (superpose (a b))) ((k b))))))
!(alpha-member-binds (collapse (let $e (quote (k $z)) (let $found (is-alpha-member $e ((j 1) (k 7) (k 8))) ($found $z)))))
!(alpha-member-free-variable (collapse (is-alpha-member $x (a b c))))
!(alpha-member-variable-item (collapse (is-alpha-member $x ($y $z))))
!(alpha-member-not (collapse (let $e (quote (k (superpose (a b)))) (not (is-alpha-member $e ())))))
!(member-value (collapse (let $e (quote (k (superpose (a b)))) (is-member $e ()))))
!(alpha-unique-value (collapse (let $e (quote ((k (superpose (a b))))) (alpha-unique-atom $e))))
!(msort-value (collapse (let $e (quote ((k (superpose (a b))))) (msort $e))))
!(exclude-value (sort-atom (collapse (let $e (quote (k (superpose (a b)))) (exclude-item $e ((k (superpose (a b))) z))))))
!(length-value (collapse (let $e (quote ((k (superpose (a b))))) (length $e))))
!(call-value (collapse (let $e (quote (k (superpose (a b)))) (w $e))))
; Forms the translator rewrites (unique, alpha-unique, trace!, and-then,
; or-else): a variable among their operands goes into the rewriting as a
; variable, so its value is one answer and is not run.
!(unique-value (collapse (let $e (quote (k (superpose (a b a)))) (unique $e))))
!(unique-written (sort-atom (collapse (unique (k (superpose (a b a)))))))
!(unique-value-inside (collapse (let $e (quote (k (superpose (a b)))) (unique (w $e)))))
!(alpha-unique-value (collapse (let $e (quote (k (superpose (a b a)))) (alpha-unique $e))))
!(trace-body-value (collapse (let $e (quote (k (superpose (a b)))) (trace! 1 $e))))
!(trace-message-value (collapse (let $e (quote (k (superpose (a b)))) (trace! $e 2))))
!(trace-written (sort-atom (collapse (trace! 3 (k (superpose (a b)))))))
!(and-then-value (collapse (let $e (quote (k (superpose (a b)))) (and-then True $e))))
!(or-else-value (collapse (let $e (quote (k (superpose (a b)))) (or-else $e 1))))
!(and-then-written (sort-atom (collapse (and-then (superpose (True False)) (k (superpose (a b)))))))
; forall: the generator's answers and the test's operand are values; a value
; passes when some answer of the test is true; the first failure stops it.
(= (idf $x) $x)
(= (never $x) False)
(= (is-pos $x) (> $x 0))
(= (is-ka (k a)) True)
(= (is-ka (k b)) True)
(= (is-ka (k (superpose (a b)))) False)
(= (noisy $x) (progn (println! (saw $x)) (> $x 0)))
(= (entry) (let $c (collapse (cons-atom read (cons-atom r (cons-atom (v 1) ())))) (let (($mode $s $a)) $c $mode)))
!(forall-all-true (forall (superpose (1 2 3)) is-pos))
!(forall-one-false (forall (superpose (1 -2 3)) is-pos))
!(forall-no-answers (forall (empty) is-pos))
!(forall-value-generator (let $e (quote (k (superpose (a b)))) (forall $e is-ka)))
!(forall-value-in-call (let $e (quote (k (superpose (a b)))) (forall (idf $e) is-ka)))
!(forall-written-data (forall (k (superpose (a b))) is-ka))
!(forall-stops-at-first-failure (forall (superpose (1 -2 3)) noisy))
!(forall-lambda-test (forall (superpose (1 2)) (|-> ($x) (> $x 0))))
!(forall-partial-test (forall (superpose (1 2)) (< 0)))
!(forall-test-not-boolean (forall (superpose (1 2)) idf))
!(forall-nested-collapse-fails (forall (entry) never))
!(forall-test-variable (let $t is-pos (forall (superpose (1 2 3)) $t)))
!(forall-outer-binding (let $limit 2 (forall (superpose (3 4)) (< $limit))))
; case: a call written in an arm's pattern is evaluated; a variable's value
; standing in a pattern is matched as it is.
!(case-written-pattern-call (collapse (case (k 3) (((k (+ 1 2)) hit) ($o miss)))))
!(case-written-pattern-choice (sort-atom (collapse (case (k a) (((k (superpose (a b))) hit) ($o miss))))))
!(case-pattern-value (collapse (let $e (quote (k (superpose (a b)))) (case (k (superpose (a b))) (($e hit) ($o miss))))))
!(case-pattern-value-equal (collapse (let $e (quote (k (+ 1 2))) (case (quote (k (+ 1 2))) (($e hit) ($o miss))))))
!(case-pattern-value-inside (collapse (let $e (quote (+ 1 2)) (case (k 3) (((k $e) hit) ($o miss))))))
; foldall: every answer of the generator is a value; a match, a let or a let*
; runs whole inside the fold; of any other generator the arguments are
; evaluated before the fold, so their choices are the caller's.
(= (acc $a $x) (cons $x $a))
(= (gen) (superpose (1 2 3)))
(= (mk) (quote (k (superpose (a b)))))
(= (wrap $x) (idf $x))
(n 1)
(n 2)
!(foldall-function-generator (collapse (foldall acc (gen) ())))
!(foldall-superpose (collapse (foldall acc (superpose (1 2 3)) ())))
!(foldall-match (collapse (foldall + (match &self (n $x) $x) 0)))
!(foldall-let (collapse (foldall acc (let $x (superpose (1 2)) (* $x 2)) ())))
!(foldall-code-like-answer (collapse (foldall acc (mk) ())))
!(foldall-code-like-through-call (collapse (foldall acc (wrap (mk)) ())))
!(foldall-argument-choice (sort-atom (collapse (foldall acc (idf (superpose (1 2))) ()))))
!(foldall-data-argument-choice (sort-atom (collapse (foldall acc (k (superpose (a b))) ()))))
!(foldall-value-generator (collapse (let $e (quote (k (superpose (a b)))) (foldall acc $e ()))))
!(foldall-value-in-call (collapse (let $e (quote (k (superpose (a b)))) (foldall acc (idf $e) ()))))
!(foldall-initial-value (collapse (let $e (quote (k (superpose (a b)))) (foldall acc (superpose (1 2)) $e))))
!(foldall-initial-choice (sort-atom (collapse (foldall acc (superpose (1 2)) (superpose (() (z)))))))
!(foldall-lambda-step (collapse (foldall (|-> ($a $x) (+ $a $x)) (gen) 0)))
!(foldall-no-answers (collapse (foldall acc (empty) start)))
