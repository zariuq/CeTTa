; PeTTa's integer constraints in every build.  With all inputs known an
; operation computes; a linear equation in one unknown is solved, or has no
; answer when the unknown's coefficient does not divide; with more unknowns,
; or across a non-linear operation, the constraint waits until its
; variables are bound.  A reified comparison answers true and posts its
; constraint, or false when the constraint cannot hold.
(= (outcome $x) (case $x (((Error $formal $context) (error $formal)) ($value $value))))
!(#+ 2 3)
!(#- 2 3)
!(#* 2 3)
!(#div -7 2)
!(#// -7 2)
!(#mod -7 2)
!(#min 2 3)
!(#max 2 3)
!(#+ (+ 1 2) 3)
!(#< 2 3)
!(#> 2 3)
!(#= 2 2)
!(#\= 2 2)
!(let 5 (#+ $x 3) $x)
!(let 5 (#+ 3 $x) $x)
!(let 5 (#- $x 3) $x)
!(let 5 (#- 3 $x) $x)
!(let 6 (#* $x 3) $x)
!(let 6 (#* 3 $x) $x)
!(let 6 (#+ $x $x) $x)
!(let 0 (#* $x 0) done)
!(collapse (let 7 (#* $x 3) $x))
!(collapse (let 7 (#+ $x $x) $x))
!(collapse (#div 7 0))
!(let $r (#+ $x $y) (let $x 2 (let $y 3 $r)))
!(let $r (#+ $x $y) (let $r 5 (let $x 2 $y)))
!(collapse (let $r (#+ $x $y) (let $x 2 (let $y 3 (let $r 6 bad)))))
!(let $r (#* $x $y) (let $x 2 (let $y 3 $r)))
!(let 3 (#div $x 2) (let $x 7 ok))
!(collapse (let 3 (#div $x 2) (let $x 8 ok)))
!(let $t (#< $x 3) (let $x 1 $t))
!(collapse (let $t (#< $x 3) (let $x 5 $t)))
!(let $t (#= $x 3) ($t $x))
!(let false (#< 1 2) no-constraint)
(= (g $X $Y $Z) (append ((#+ $X $Z)) $Y))
!(let (g $X $Y 35) (42 2 3) ($X $Y))
!(let* (($r (#+ $x 35)) ($r 42)) $x)
!(let* (($r (#+ $x 1)) ($_ (translatePredicate (#< $r 3))) ($x 1)) yes)
!(collapse (let* (($r (#+ $x 1)) ($_ (translatePredicate (#< $r 3))) ($x 5)) no))
!(outcome (catch (#+ 1.5 2)))
!(outcome (catch (#< a 2)))
