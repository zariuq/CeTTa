; PeTTa argv/1 is a native projection of the current document and process
; arguments.  Its atom_number-compatible coercion is observed positively;
; empty and nonnumeric atoms remain symbols.
!(repra (argv 0))
!(argv 1)
!(argv 2)
!(argv 3)
!(argv 4)
!(argv 5)
!(repra (argv 6))
!(argv 7)
!(argv 8)
!(repra (argv 9))
!(argv 10)
!(argv 11)
!(argv 12)
!(argv 13)
!(argv 14)
!(repra (argv 15))
!(argv 16)
!(argv 17)
!(argv 18)
!(argv 19)
!(argv 20)
!(argv 21)
!(argv 22)
!(repra (argv 23))
!(repra (argv 24))
!(test (collapse (argv 99)) ())
!(test (collapse (argv -1)) ())
!(test (collapse (argv not-an-index)) ())
