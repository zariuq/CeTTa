!(import! &self (library lib_he))
(= (bounded-test:rule $x) (+ $x 1))
(= (bounded-test:rule $x) (+ $x 1))
(= (bounded-test:cached-call) (bounded-test:rule 5))
(= (bounded-test:run)
  (let* (($space (new-space))
         ($_ (assertEqual (collapse (bounded-test:cached-call)) (6 6)))
         ($_ (remove-atom &self (= (bounded-test:rule $x) (+ $x 1)) 1))
         ($_ (assertEqual (size-atom (collapse (match &self (= (bounded-test:rule $x) $body) $body))) 1))
         ($_ (assertEqual (collapse (bounded-test:cached-call)) (6)))
         ($_ (add-atom $space (edge a b)))
         ($_ (add-atom $space (edge a b)))
         ($_ (add-atom $space (edge a b)))
         ($_ (add-atom $space (other retained)))
         ($_ (remove-atom $space (edge a b) 0))
         ($_ (assertEqual (size-atom (collapse (match $space (edge a b) yes))) 3))
         ($_ (remove-atom $space (edge a b) 1))
         ($_ (assertEqual (size-atom (collapse (match $space (edge a b) yes))) 2))
         ($_ (remove-atom $space (edge a b) (+ 0 1)))
         ($_ (assertEqual (size-atom (collapse (match $space (edge a b) yes))) 1))
         ($_ (assertEqual (collapse (remove-atom $space (edge a b) -1)) ()))
         ($_ (assertEqual (collapse (remove-atom $space (edge a b) "one")) ()))
         ($_ (assertEqual (collapse (remove-atom $space (edge a b) 1.0)) ()))
         ($_ (assertEqual (collapse (remove-atom $space (edge a b) $unbound)) ()))
         ($_ (assertEqual (size-atom (collapse (match $space (edge a b) yes))) 1))
         ($_ (remove-atom $space (edge a b) 1000000000000000000000000000000000000000000000))
         ($_ (assertEqual (collapse (match $space (edge a b) yes)) ()))
         ($_ (assertEqual (collapse (match $space (other $x) $x)) (retained)))
         ($_ (remove-atom $space (absent $x) 2))
         ($_ (assertEqual (collapse (match $space (other $x) $x)) (retained)))
         ($_ (add-atom $space (edge a c))) ($_ (add-atom $space (edge a c)))
         ($_ (remove-atom $space (edge a $x)))
         ($_ (assertEqual (collapse (match $space (edge a $x) $x)) ()))
         ($_ (add-atom $space (chosen red)))
         ($_ (add-atom $space (token red)))
         ($_ (add-atom $space (token blue)))
         ($_ (remove-atom $space (token $which) (match $space (chosen $which) 1)))
         ($_ (assertEqual (collapse (match $space (token $which) $which)) (blue)))) BOUNDED_REMOVAL_OK))
!(bounded-test:run)
