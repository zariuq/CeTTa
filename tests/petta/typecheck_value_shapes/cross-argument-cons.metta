(: keep-tag (-[det]-> Number Number))
(= (keep-tag $n) $n)
(: cross-selector (-[$effect]-> Atom Expression (-[$effect]-> Number Number) Number))
(= (cross-selector $same () $k) ($k 0))
(= (cross-selector $same (cons $same $tail) $k) ($k 1))
(: bad-cross (-[det]-> Atom Atom Number))
(= (bad-cross $other $value)
   (if (is-expr $value) (cross-selector $other $value keep-tag) 0))
!(bad-cross b (a))
