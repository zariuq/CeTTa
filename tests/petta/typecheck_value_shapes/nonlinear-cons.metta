(: keep-tag (-[det]-> Number Number))
(= (keep-tag $n) $n)
(: nonlinear-selector (-[$effect]-> Expression (-[$effect]-> Number Number) Number))
(= (nonlinear-selector () $k) ($k 0))
(= (nonlinear-selector (cons $same $same) $k) ($k 1))
(: bad-nonlinear (-[det]-> Atom Number))
(= (bad-nonlinear $value)
   (if (is-expr $value) (nonlinear-selector $value keep-tag) 0))
!(bad-nonlinear (a))
