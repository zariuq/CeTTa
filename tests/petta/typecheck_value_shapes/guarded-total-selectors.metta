(: keep-tag (-[det]-> Number Number))
(= (keep-tag $n) $n)
(: single-selector (-[$effect]-> Expression (-[$effect]-> Number Number) Number))
(= (single-selector $value $k) ($k 7))
(: fallback-selector (-[$effect]-> Expression (-[$effect]-> Number Number) Number))
(= (fallback-selector $value $k) ($k 9))
(: guarded-total (-[det]-> Atom Number))
(= (guarded-total $value)
   (if (is-expr $value) (single-selector $value keep-tag) 0))
(: guarded-fallback (-[det]-> Atom Number))
(= (guarded-fallback $value)
   (if (is-expr $value) (fallback-selector $value keep-tag) 0))
!(guarded-total (a b))
!(guarded-total atom)
!(guarded-fallback (a b))
!(guarded-fallback atom)
