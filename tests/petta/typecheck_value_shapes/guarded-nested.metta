!(import! &self (library lib_roman))
(: count-leaf (-[det]-> Number Atom Number))
(= (count-leaf $n $_leaf) (+ $n 1))
(: guarded-count (-[det]-> Atom Number))
(= (guarded-count $value)
   (if (is-expr $value) (fold-nested count-leaf 0 $value) 0))
!(guarded-count (a (b c)))
!(guarded-count ())
!(guarded-count atom)
!(guarded-count $unbound)
!(let $built (cons a (cons b ())) (guarded-count $built))
!(let $built (cons a tail) (guarded-count $built))
