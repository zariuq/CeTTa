; Relations emptied down to a few facts answer as before and take facts
; again: two columns kept as bits, three kept as a table, and deep facts
; whose holes a table keeps.
(= (fill $i $n)
   (if (>= $i $n) done
       (let* (($j (+ $i 1))
              ($a (add-atom &self (pair $i $j)))
              ($b (add-atom &self (triple $i $j $i)))
              ($c (add-atom &self (deep $i (wrap $j)))))
         (fill (+ $i 1) $n))))
(= (drop $i $n)
   (if (>= $i $n) done
       (let* (($j (+ $i 1))
              ($a (remove-atom &self (pair $i $j)))
              ($b (remove-atom &self (triple $i $j $i)))
              ($c (remove-atom &self (deep $i (wrap $j)))))
         (drop (+ $i 1) $n))))
!(fill 0 5000)
!(size-atom (collapse (match &self (pair 5 $y) $y)))
!(drop 64 5000)
!(size-atom (collapse (match &self (pair $x $y) $x)))
!(size-atom (collapse (match &self (triple $x $y $z) $x)))
!(size-atom (collapse (match &self (deep $x $y) $x)))
!(collapse (match &self (pair 10 $y) $y))
!(collapse (match &self (triple $x 11 $z) ($x $z)))
!(collapse (match &self (deep 10 $y) $y))
!(collapse (match &self (pair 100 $y) $y))
!(fill 1000 1100)
!(size-atom (collapse (match &self (pair $x $y) $x)))
!(collapse (match &self (triple 1050 $y $z) ($y $z)))
!(collapse (match &self (deep $x (wrap 1051)) $x))
!(drop 0 2000)
!(size-atom (collapse (match &self (pair $x $y) $x)))
!(size-atom (collapse (match &self (triple $x $y $z) $x)))
!(fill 0 3)
!(collapse (match &self (pair $x $y) ($x $y)))
!(collapse (match &self (deep $x $y) ($x $y)))
