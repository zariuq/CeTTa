; Workers have their own named state. Spaces remain shared.
!(change-state! parent-value 10)
!(test (collapse (hyperpose ((car-atom (catch (get-state parent-value)))))) (Error))
!(test (collapse (hyperpose ((let $done (change-state! parent-value 11)
                                 (get-state parent-value))))) (11))
!(test (get-state parent-value) 10)
!(test (msort (collapse (hyperpose ((let $done (change-state! worker-value 1) (get-state worker-value))
                                  (let $done (change-state! worker-value 2) (get-state worker-value)))))) (1 2))
!(test (car-atom (catch (get-state worker-value))) Error)
!(test (collapse (hyperpose ((car-atom (catch (get-state worker-value)))))) (Error))
!(test (collapse (hyperpose ((let $done (change-state! outer-worker 17)
                              (let $inner (collapse (hyperpose ((car-atom (catch (get-state outer-worker))))))
                                ($inner (get-state outer-worker))))))) (((Error) 17)))
!(test (car-atom (catch (get-state outer-worker))) Error)
!(test (collapse (hyperpose ((let $done (add-atom &worker-space (row 7)) ok)))) (ok))
!(test (collapse (match &worker-space (row $x) $x)) (7))
!(test (collapse (hyperpose ((car-atom (catch (get-state missing-worker)))))) (Error))
!(test (get-state parent-value) 10)
