; Reads of a space by head over variables, lazily and through removals, give
; the rows a scan gives: every occurrence, with its bindings.  A space answers
; a bag, so each read is printed sorted.
(= (shown $x) (if (== (get-metatype $x) Variable) open $x))
!(bind! &s (new-space))
!(add-atom &s (job j0))
!(add-atom &s (job j1))
!(add-atom &s (job j2))
!(add-atom &s (job j3))
!(add-atom &s (job j4))
!(add-atom &s (job j5))
!(add-atom &s (job j6))
!(add-atom &s (job j7))
!(add-atom &s (job j8))
!(add-atom &s (job j9))
!(add-atom &s (job j10))
!(add-atom &s (job j11))
!(add-atom &s (job a b))
!(add-atom &s ($f j-open))
!(add-atom &s (job j3))
!(add-atom &s (other j1))
!(add-atom &s (job 1))
!(add-atom &s (job 1.0))
!(add-atom &s (job (nested x)))
!(add-atom &s (job $v))
!(add-atom &s (job))
!(add-atom &s (job j12))
!(add-atom &s (job j13))
!(add-atom &s (job j14))
!(add-atom &s (job j15))
!(add-atom &s (job j16))
!(add-atom &s (job j17))
!(add-atom &s (job j18))
!(add-atom &s (job j19))
!(add-atom &s (job j20))
!(add-atom &s (job j21))
!(add-atom &s (job j22))
!(add-atom &s (job j23))
!(add-atom &s (done x))
!(let $bag (collapse (match &s (job $j) (shown $j))) (sort-atom $bag))
!(size-atom (let $bag (collapse (match &s (job $j) $j)) (sort-atom $bag)))
!(let $bag (collapse (match &s (job $a $b) ($a $b))) (sort-atom $bag))
!(let $bag (collapse (match &s ($h j-open) (shown $h))) (sort-atom $bag))
!(let $one (collapse (once (match &s (job $j) $j))) (let $all (collapse (match &s (job $j) $j)) (and (== (size-atom $one) 1) (once (is-member (car-atom $one) $all)))))
!(let $bag (collapse (match &s (job 1) yes)) (sort-atom $bag))
!(let $bag (collapse (match &s (job $j $j) $j)) (sort-atom $bag))
!(remove-atom &s (job j3))
!(remove-atom &s (job j0))
!(let $one (collapse (once (match &s (job $j) $j))) (let $all (collapse (match &s (job $j) $j)) (and (== (size-atom $one) 1) (once (is-member (car-atom $one) $all)))))
!(let $bag (collapse (match &s (job $j) $j)) (sort-atom $bag))
!(let $bag (collapse (match &s (job $j) (let $_ (remove-atom &s (job $j)) $j))) (sort-atom $bag))
!(let $bag (collapse (match &s (job $j) $j)) (sort-atom $bag))
(= (drain $s $k) (let $js (collapse (once (match $s (other $j) $j)))
   (if (== $js ()) $k (let $j (car-atom $js) (let $_ (remove-atom $s (other $j)) (let $_2 (add-atom $s (other-done $j)) (drain $s (+ $k 1))))))))
!(add-atom &s (other o0))
!(add-atom &s (other o1))
!(add-atom &s (other o2))
!(add-atom &s (other o3))
!(add-atom &s (other o4))
!(add-atom &s (other o5))
!(add-atom &s (other o6))
!(add-atom &s (other o7))
!(add-atom &s (other o8))
!(add-atom &s (other o9))
!(add-atom &s (other o10))
!(add-atom &s (other o11))
!(add-atom &s (other o12))
!(add-atom &s (other o13))
!(add-atom &s (other o14))
!(add-atom &s (other o15))
!(add-atom &s (other o16))
!(add-atom &s (other o17))
!(add-atom &s (other o18))
!(add-atom &s (other o19))
!(add-atom &s (other o20))
!(add-atom &s (other o21))
!(add-atom &s (other o22))
!(add-atom &s (other o23))
!(add-atom &s (other o24))
!(add-atom &s (other o25))
!(add-atom &s (other o26))
!(add-atom &s (other o27))
!(add-atom &s (other o28))
!(add-atom &s (other o29))
!(drain &s 0)
!(let $bag (collapse (match &s (other-done $j) $j)) (sort-atom $bag))
!(size-atom (let $bag (collapse (match &s (other $j) $j)) (sort-atom $bag)))
