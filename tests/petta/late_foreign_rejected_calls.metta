!(callPredicate (Predicate (quote (consult "tests/petta/fixtures/late_foreign_continuation.pl"))))
(= (reject_fold_step $item $acc) (let $acc $item $acc))
(= (reject_fold_tail $x)
  (progn (import_prolog_function cold_dif)
    (let $f cold_dif (let $u ($f $x) (foldl reject_fold_step (1) $x)))))
(= (reject_fold_call $x)
  (progn (import_prolog_function cold_dif)
    (let $f cold_dif (let $u ($f $x) (Wrapped (foldl reject_fold_step (1) $x))))))
!(collapse (reject_fold_tail $x))
!(collapse (reject_fold_call $x))
(= (reject_head_delay $x)
  (progn (import_prolog_function cold_dif)
    (let $f cold_dif ($f $x))))
(= (reject_head_bind $x) (let $x 1 bound))
(= (reject_head_probe (reject_head_delay $x) (reject_head_bind $x)) (Answer $x))
!(collapse (reject_head_probe true bound))
