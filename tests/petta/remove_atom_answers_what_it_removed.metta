; Public removal selects every unifying occurrence. An unbound whole atom
; or equation head raises a catchable instantiation error without mutation.
!(bind! &rows (new-space))
!(add-atom &rows (t a))
!(add-atom &rows (t b))
!(add-atom &rows (r $v))
!(add-atom &rows (k 1))
!(add-atom &rows (k 1))
!(println! (absent (remove-atom &rows (missing 1))))
!(println! (bare (let (Error $formal $context) (catch (remove-atom &rows $x))
                    ($formal (get-metatype $context)))))
!(println! (after-bare (size-atom (collapse (get-atoms &rows)))))
!(println! (ground-meets-stored-variable (remove-atom &rows (r a))))
!(println! (equal-variable-copy (remove-atom &rows (r $w))))
!(println! (pattern-meets-two (let $removed (remove-atom &rows (t $w))
                              ($removed (get-metatype $w)))))
!(println! (exact (remove-atom &rows (k 1))))
!(println! (again (remove-atom &rows (k 1))))
!(println! (left (size-atom (collapse (get-atoms &rows)))))
(= (remove-through $store $pattern) (remove-atom $store $pattern))
!(add-atom &rows (through a))
!(add-atom &rows (through b))
!(println! (bound-pattern (let $pattern (through $value)
                         (remove-through &rows $pattern))))
!(println! (body-bare (let (Error $formal $context)
                          (catch (remove-through &rows $unbound)) $formal)))
!(println! (after-body (collapse (get-atoms &rows))))
(p a)
(q b)
!(println! (self-bare (let (Error $formal $context)
                          (catch (remove-atom &self $y)) $formal)))
!(println! (self-after (size-atom (collapse (match &self ($h $v) ($h $v))))))
(= (retained $x) $x)
!(println! (unknown-head (let (Error $formal $context)
                             (catch (remove-atom &self (= ($head $arg) $body)))
                          $formal)))
!(println! (unknown-left (let (Error $formal $context)
                             (catch (remove-atom &self (= $left $right)))
                          $formal)))
!(println! (unknown-open-head (let $left (cons-atom $head $args)
    (let $pattern (cons-atom = (cons-atom $left (cons-atom $body ())))
      (let (Error $formal $context) (catch (remove-atom &self $pattern)) $formal)))))
!(println! (definition-retained (retained 7)))
!(println! (caught-branch (let (Error $formal $context)
    (catch (progn (remove-atom &rows $unbound) (add-atom &rows (unexpected effect))))
    $formal)))
!(println! (after-caught-branch (collapse (get-atoms &rows))))
