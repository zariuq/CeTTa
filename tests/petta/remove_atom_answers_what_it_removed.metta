; Removal retains the pattern selector and consumes one occurrence.
; Bare variables retain their existing false answer.
!(bind! &rows (new-space))
!(add-atom &rows (t a))
!(add-atom &rows (t b))
!(add-atom &rows (r $v))
!(add-atom &rows (k 1))
!(add-atom &rows (k 1))
!(println! (absent (remove-atom &rows (missing 1))))
!(println! (bare (remove-atom &rows $x)))
!(println! (after-bare (size-atom (collapse (get-atoms &rows)))))
!(println! (ground-meets-stored-variable (remove-atom &rows (r a))))
!(println! (equal-variable-copy (remove-atom &rows (r $w))))
!(println! (pattern-meets-two (remove-atom &rows (t $w))))
!(println! (exact (remove-atom &rows (k 1))))
!(println! (again (remove-atom &rows (k 1))))
!(println! (exhausted (remove-atom &rows (k 1))))
!(println! (left (size-atom (collapse (get-atoms &rows)))))
(p a)
(q b)
!(println! (self-bare (remove-atom &self $y)))
!(println! (self-after (size-atom (collapse (match &self ($h $v) ($h $v))))))
