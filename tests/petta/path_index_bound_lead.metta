!(sort-atom (collapse (match &self (k a $v) $v)))
!(sort-atom (collapse (match &self (k b $v) $v)))
!(collapse (match &self (num 3 $v) $v))
!(collapse (match &self (num 3 $v) $v))
; Removal by marks: the lookups skip the marked rows.
!(remove-atom &self (k a 3))
!(sort-atom (collapse (match &self (k a $v) $v)))
!(remove-atom &self (num 3 v3))
!(collapse (match &self (num 3 $v) $v))
!(add-atom &self (k a 7))
!(sort-atom (collapse (match &self (k a $v) $v)))
!(add-atom &self (num 3 w3))
!(collapse (match &self (num 3 $v) $v))
; Enough removals to settle the marks.
!(remove-atom &self (filler f0 0))
!(remove-atom &self (filler f1 1))
