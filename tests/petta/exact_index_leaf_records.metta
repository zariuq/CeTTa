; A ground pattern over a space of more than sixteen rows is answered from
; the space's exact index, which looks each leaf up under the record it was
; stored as.  Floats, strings, big and small integers and compounds holding
; them are found and removed there as in a small space.
!(bind! &rows (new-space))
!(add-atom &rows (Row 0 0.5))
!(add-atom &rows (Row 1 1.0))
!(add-atom &rows (Row 2 2.5))
!(add-atom &rows (Row 3 "three"))
!(add-atom &rows (Row 4 (f 1.0)))
!(add-atom &rows (Row 5 123456789012345678901234567890))
!(add-atom &rows (Row 6 -0.0))
!(add-atom &rows (Row 7 7))
!(add-atom &rows (Pad 1)) !(add-atom &rows (Pad 2)) !(add-atom &rows (Pad 3))
!(add-atom &rows (Pad 4)) !(add-atom &rows (Pad 5)) !(add-atom &rows (Pad 6))
!(add-atom &rows (Pad 7)) !(add-atom &rows (Pad 8)) !(add-atom &rows (Pad 9))
!(add-atom &rows (Pad 10)) !(add-atom &rows (Pad 11)) !(add-atom &rows (Pad 12))
!(collapse (match &rows (Row 1 1.0) found))
!(collapse (match &rows (Row 2 2.5) found))
!(collapse (match &rows (Row 3 "three") found))
!(collapse (match &rows (Row 4 (f 1.0)) found))
!(collapse (match &rows (Row 5 123456789012345678901234567890) found))
!(collapse (match &rows (Row 7 7) found))
!(collapse (match &rows (Row 1 2.5) found))
!(remove-atom &rows (Row 1 1.0))
!(remove-atom &rows (Row 4 (f 1.0)))
!(sort-atom (collapse (match &rows (Row $k $v) $k)))
