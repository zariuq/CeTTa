; Applications whose head is computed or bound at run time: a tuple built
; under a variable head, a list head, a computed head, and the calls a bound
; head names (a function, a builtin, a lambda).  Choice zero in a
; single-answer function answers nothing.
(= (sq $x) (* $x $x))
(= (app $f $x) ($f $x))
(= (two $f $x $y) ($f $x $y))
(= (pair-of $s) (let ($a $r) (decons-atom $s) ($a $r)))
(= (edge $s)
   (let ($tag $r1) (decons-atom $s)
     (let ($id $r2) (decons-atom $r1)
       (let ($P $r3) (decons-atom $r2)
         (let ($Q $r4) (decons-atom $r3) ($P $Q))))))
(= (edges $subs)
   (if (== $subs ()) ()
       (let ($s $t) (decons-atom $subs)
         (let $e (edge $s) (let $es (edges $t) (cons-atom $e $es))))))
(= (direct $s) (let ($tag $id $P $Q) (first4 $s) (if (== $P $Q) False True)))
(= (first4 $s)
   (let ($tag $r1) (decons-atom $s)
     (let ($id $r2) (decons-atom $r1)
       (let ($P $r3) (decons-atom $r2)
         (let ($Q $r4) (decons-atom $r3) ($tag $id $P $Q))))))
(= (head-of $s) ((car-atom $s) x))
(= (run $n $s) (if (== $n 0) done (let $x (edge $s) (run (- $n 1) $s))))
(= (run $n $s) (if (< $n 0) never (empty)))
(= (hs $r $m) (if (<= $r (+ $m 1)) (max $r $m) (empty)))
(= (use $r) (let $x (hs $r 2) (+ $x 100)))
(= (alt $r) (hs $r 2))
(= (alt $r) 7)
(= (deep $r) (if (== (hs $r 2) 3) yes no))
; bound heads that head data
!(app s inv_1)
!(two foo 2 3)
!(app 7 x)
!(app "str" x)
!(pair-of (a b c))
!(pair-of ((a b) c))
!(edge (sub chain s inv_1 b))
!(edges ((sub chain s inv_1 b) (sub chain inv_1 a s) (sub identity s a)))
!(direct (sub chain s s b))
!(direct (sub chain s inv_1 b))
!(run 50 (sub chain s inv_1 b))
; computed heads
!(head-of (foo b))
!(head-of ((p q) b))
!((sub chain s) (sub chain t))
!((sq 3) 1)
!((+ 1 2) x)
; bound heads that name calls
!(app sq 5)
!(two + 2 3)
!(two == 1 1)
!(two cons-atom a (b))
!(app quote (sq 2))
!((|-> ($x) (+ $x 1)) 3)
!(let $f (|-> ($x) (+ $x 1)) ($f 3))
!(app (|-> ($x) (* $x 10)) 3)
; choice zero in single-answer functions
!(hs 1 2)
!(collapse (hs 9 2))
!(use 1)
!(collapse (use 9))
!(collapse (alt 9))
!(sort-atom (collapse (alt 1)))
!(deep 3)
!(collapse (deep 9))
