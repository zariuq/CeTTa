; Relational construction produces an internal list cell in CeTTa.
; Sort collected answers for comparison without constraining traversal order.
(= (cell-view (cons $head $tail) $head $tail) OK)
(= (build $tail) (let OK (cell-view $p Pair $tail) $p))
(= (scan $s $p) (match $s $p $p))
(= (scan-built $s $tail) (let $p (build $tail) (match $s $p $p)))
(= (scan-count $s $tail) (let $p (build $tail) (length (collapse (match $s $p $p)))))
(= (scan-fold $s $tail) (let $p (build $tail) (foldall + (match $s $p 1) 0)))
!(add-atom &tiny (Pair red square))
!(add-atom &tiny (Pair blue circle))
!(add-atom &tiny (Pair red square))
!(add-atom &tiny (Pair same same))
!(add-atom &tiny (Box (Pair red square)))
!(add-atom &tiny (Pair red square extra))
!(add-atom &tiny (Pair))
!(msort (collapse (scan-built &tiny ($a $b))))
!(msort (let $p (build ($a $b)) (collapse (scan &tiny $p))))
!(msort (let $p (build ($a $b)) (collapse (match &tiny $p $p))))
!(msort (collapse (scan-built &tiny ($a $a))))
!(msort (collapse (scan-built &tiny (missing $a))))
!(msort (let $p (build (red square)) (collapse (match &tiny (Box $p) (Box $p)))))
!(scan-count &tiny ($a $b))
!(scan-count &tiny ($a $a))
!(scan-fold &tiny ($a $b))
!(scan-fold &tiny ($a $a))
(= (fill $n) (if (== $n 0) OK (progn (add-atom &tiny (Noise $n)) (fill (- $n 1)))))
!(fill 40)
!(msort (collapse (scan-built &tiny ($a $b))))
!(msort (let $p (build ($a $b)) (collapse (match &tiny $p $p))))
!(msort (collapse (scan-built &tiny ($a $a))))
!(msort (collapse (scan-built &tiny (missing $a))))
!(msort (let $p (build (red square)) (collapse (match &tiny (Box $p) (Box $p)))))
!(scan-count &tiny ($a $b))
!(scan-count &tiny ($a $a))
!(scan-fold &tiny ($a $b))
!(scan-fold &tiny ($a $a))
; Runtime connective dispatch shares bindings across the two legs.
(= (query $space $pattern) (match $space $pattern $pattern))
(= (query-count $space $pattern) (length (collapse (query $space $pattern))))
!(query-count &tiny (, (Pair $x square) (Pair $x square)))
!(let $p (cons-atom , ((Pair $x square) (Pair $x square))) (query-count &tiny $p))
!(msort (collapse (query &tiny (, (Pair $x square) (Pair $x circle)))))
; A missing named space is a host match with no solutions, not exhaustion.
!(msort (collapse (query &missing (Pair $a $b))))
!(msort (collapse (query &missing $p)))
