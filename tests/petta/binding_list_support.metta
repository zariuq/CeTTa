(= (inspect-hidden $x)
   (let $box (Node $x $x)
     (let $x (cons-atom a ())
       (case $box (((Node (a) (a)) matched) ($other missed))))))
(= (inspect-alias $x $y)
   (let $box (Node $x $x)
     (let $x $y
       (let $y (cons-atom a ())
         (case $box (((Node (a) (a)) matched) ($other missed)))))))
(= (inspect-two $x $y)
   (let $box (Node $x $y)
     (let $x (cons-atom a ())
       (let $y (cons-atom b ())
         (case $box (((Node (a) (b)) matched) ($other missed)))))))
(= (ordinary-single $x)
   (let $box (Node $x $x)
     (let $x plain
       (case $box (((Node plain plain) matched) ($other missed))))))
!(inspect-hidden $live)
!(inspect-alias $live $alias)
!(inspect-two $left $right)
!(ordinary-single $live)
!(sort-atom (collapse
   (let $box (Node $live $live)
     (let $choice (superpose (a b))
       (let $live (cons-atom $choice ())
         (case $box (((Node (a) (a)) first) ((Node (b) (b)) second) ($other missed))))))))
