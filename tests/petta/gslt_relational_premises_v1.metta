(gslt-presentation-v1 RelationalPremisesV1
  (signature
    (operator LessV1 2)
    (operator CheckV1 2)
    (operator ColourV1 1)
    (operator ChooseV1 2)
    (operator SharedV1 2)
    (operator JoinV1 3)
    (operator LoopV1 1)
    (operator BeforeEmptyV1 1)
    (operator MissingV1 1)
    (operator z 0)
    (operator s 1)
    (operator red 0)
    (operator green 0)
    (operator cons 2))
  (equations)
  (rewrites
    (rule less-base (head (LessV1 z (s ?right))) (body))
    (rule less-step (head (LessV1 (s ?left) (s ?right)))
      (body (LessV1 ?left ?right)))
    (rule check-less (head (CheckV1 ?left ?right))
      (body (LessV1 ?left ?right)))
    (rule first-colour (head (ColourV1 red)) (body))
    (rule second-colour (head (ColourV1 green)) (body))
    (rule repeated-colour (head (ColourV1 green)) (body))
    (rule choose-colour (head (ChooseV1 ?token ?colour))
      (body (ColourV1 ?colour)))
    (rule shared-variable (head (SharedV1 ?value ?value)) (body))
    (rule joined-variables (head (JoinV1 ?input ?middle ?output))
      (body (SharedV1 ?input ?middle) (SharedV1 ?middle ?output)))
    (rule loop (head (LoopV1 ?value)) (body (LoopV1 ?value)))
    (rule before-empty (head (BeforeEmptyV1 ?value))
      (body (LoopV1 ?value) (MissingV1 ?value)))))
