(: tier-raw (-> Atom Atom))
(= (tier-raw $x) (Box $x))
(: tier-evaluated (-> %Undefined% %Undefined%))
(= (tier-evaluated $x) (+ $x 1))
(: tier-shared (-> $t $t %Undefined%))
(= (tier-shared $x $y) (Pair $x $y))
(: tier-reject-result (-> Number Number))
(= (tier-reject-result $x) rejected)
(: tier-overload (-> Number Atom))
(: tier-overload (-> Atom Atom))
(= (tier-overload $x) (Seen $x))
(= (tier-producer) (progn (println! argument) 6))

(= (tier-composition $free)
   (Results (tier-raw (+ 2 3))
            (tier-evaluated (progn ignored (+ 2 3)))
            (let $x (tier-evaluated 3) (tier-shared $x 7))))
!(tier-composition $free)
(= (tier-overloads $free) (tier-overload (tier-producer)))
!(collapse (tier-overloads $free))
(= (tier-sharing $free) (tier-shared 6 symbol))
!(collapse (tier-sharing $free))
(= (tier-result-failure $free) (tier-reject-result 6))
!(collapse (tier-result-failure $free))

(: tier-multi-value FirstType)
(: tier-multi-value SecondType)
(: tier-multi (-> $t %Undefined%))
(= (tier-multi $x) (progn (println! multi-consumer) (Multi $x)))
(= (tier-multi-caller $free) (tier-multi tier-multi-value))
!(collapse (tier-multi-caller $free))

; Intrinsic signature trials preserve ordering and independently fresh types.
(: tier-infer-choice Number)
(: tier-infer-choice String)
(: tier-infer-app (-> Number First))
(: tier-infer-app (-> String First))
(: tier-infer-app (-> Number Second))
(: tier-infer-outer (-> First WrappedFirst))
(: tier-infer-outer (-> Second WrappedSecond))
(: tier-infer-mono (-> Number Result))
(: tier-infer-pair (-> $a $a (Tagged $a)))
(: tier-infer-poly (-> $a (Box $a)))
(: tier-infer-zero (-> (Box $t)))
(: tier-infer-guard (-> $t Atom))
(= (tier-infer-guard $x) Accepted)
!(collapse (get-type (tier-infer-app tier-infer-choice)))
!(collapse (tier-infer-guard (tier-infer-app tier-infer-choice)))
!(collapse (get-type (tier-infer-outer (tier-infer-app tier-infer-choice))))
!(collapse (get-type (tier-infer-mono "bad")))
!(collapse (let ((-> Number Result) Number) (get-type (tier-infer-mono 7)) Row))
!(collapse (get-type ($same $same)))
!(collapse (get-type (tier-infer-mono $x)))
; Sharing the incoming requirement with the subject changes the judgment.
!(collapse (let $x (get-type (tier-infer-mono $x)) (Bound $x)))
!(collapse (get-type (tier-infer-pair $x 7)))
!(collapse (get-type (tier-infer-pair (tier-infer-mono 7) $x)))
!(collapse (let (Box Number) (get-type (tier-infer-poly $x))
               (let (Box String) (get-type (tier-infer-poly $x)) Fresh)))
!(collapse (let (Box Number) (get-type (tier-infer-zero))
               (let (Box String) (get-type (tier-infer-zero)) Fresh)))
!(collapse (get-type ((tier-infer-zero) (tier-infer-zero))))

(: 6 Foo)
(: tier-bound (-> Foo Foo))
(= (tier-bound $x) $x)
(= (tier-literal-check $free) (tier-bound 6))
!(get-type 6)
!(collapse (tier-literal-check $free))

(: tier-marker Atom)
(: tier-late-atom (-> $t $t Atom))
(= (tier-late-atom $x $y) (Pair $x $y))
(= (tier-literal-demand $free) (tier-late-atom tier-marker (tier-producer)))
!(collapse (tier-literal-demand $free))

(: tier-mixed-body (-> Number Atom))
(: tier-mixed-body (-> Number %Undefined%))
(= (tier-mixed-body $x) (+ $x 1))
(= (tier-held-family $free) (tier-mixed-body 6))
!(collapse (tier-held-family $free))

(: tier-identity (-> $t $t))
(= (tier-identity $x) $x)
(= (tier-loop $n $acc)
   (if (== $n 0) $acc
       (progn ignored
              (let $next (tier-identity (+ $acc 1))
                   (tier-loop (- $n 1) $next)))))
!(tier-loop 20 0)
(= (tier-dynamic $f $x) ($f $x))
!(collapse (tier-dynamic tier-bound rejected))
!(tier-dynamic tier-bound 6)

(: tier-change (-> Atom Atom))
(= (tier-change $x) (Changed $x))
(= (tier-mutating $free)
   (progn (tier-change (+ 2 3))
          (add-atom &self (: tier-change (-> %Undefined% Atom)))
          (tier-change (+ 2 3))))
!(collapse (tier-mutating $free))

(= (tier-first-declaration $x) (FirstDeclaration $x))
(= (tier-first-caller $free)
   (let $done (add-atom &self (: tier-first-declaration (-> Atom %Undefined%)))
        (tier-first-declaration (+ 1 2))))
!(tier-first-caller $free)

; Bound tuple requirements keep shared fields, branch order and open values.
(: tier-row-choice Number)
(: tier-row-choice String)
(: tier-row-shared (-> ($t $t) Atom))
(= (tier-row-shared $x) Accepted)
(: tier-row-independent (-> ($a $b) Atom))
(= (tier-row-independent $x) Accepted)
!(collapse (tier-row-shared (tier-row-choice tier-row-choice)))
!(collapse (tier-row-independent (tier-row-choice tier-row-choice)))
!(collapse (tier-row-shared ($open tier-row-choice)))
!(collapse (tier-row-shared (7 8)))
!(collapse (tier-row-shared (7 "wrong")))
!(collapse (tier-row-shared (7)))
(: tier-row-constructor (-> Number Atom))
!(collapse (tier-row-shared (tier-row-constructor 7)))

(= (get-type (TypedValue $x)) (progn (println! classifier) Foo))
(: tier-authored (-> Foo Foo))
(= (tier-authored $x) $x)
(= (tier-classifier $free) (tier-authored (TypedValue 6)))
!(collapse (tier-classifier $free))

; A foreign import changes call ownership without changing equation rows.
; Re-entering a previously compiled caller must consult the new authority.
(: tier_foreign_cached (-> %Undefined%))
(= (tier_foreign_cached) authored)
(= (tier-foreign-cached-caller $free) (tier_foreign_cached))
!(tier-foreign-cached-caller $free)
(= (tier-foreign-cache-change $free)
   (let $before (tier-foreign-cached-caller $free)
      (progn
         (assertzPredicate (Predicate (quote (tier_foreign_cached foreign))))
         (import_prolog_function tier_foreign_cached)
         (Results $before (tier-foreign-cached-caller $free)))))
!(tier-foreign-cache-change $free)
!(tier-foreign-cached-caller $free)
