(target &kb)
(= (redirect $n)
   (if (> $n 0)
       (let $s (match &self (target $t) $t)
         (let $_ (add-atom $s (item $n)) (redirect (- $n 1))))
       redirected))
(= (self-writer $n)
   (if (> $n 0) (let $_ (add-atom &self (noise $n)) (self-writer (- $n 1))) wrote-self))
(= (kb-writer $n)
   (if (> $n 0) (let $_ (add-atom &kb (other $n)) (kb-writer (- $n 1))) wrote-kb))
!(msort (collapse (hyperpose ((redirect 100) (self-writer 100) (kb-writer 100) (redirect 50)))))
!(size-atom (collapse (match &kb (item $x) $x)))
!(size-atom (collapse (match &kb (other $x) $x)))
!(size-atom (collapse (match &self (noise $x) $x)))
