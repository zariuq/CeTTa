; Twelve ordered-decision controls. Each result is a call of the imported helpers.
!(import! &self ../../lib/gslt_ordered_decision.metta)

(= (gslt:ordered:world-fallback)
   ((gslt:ordered:row k0 ())
    (gslt:ordered:row k1 ((gslt:ordered:occ id-4 fallback)))))
(= (gslt:ordered:world-inserted)
   ((gslt:ordered:row k0 ((gslt:ordered:occ id-9 inserted)))
    (gslt:ordered:row k1 ((gslt:ordered:occ id-4 fallback)))))
(= (gslt:ordered:world-singleton)
   ((gslt:ordered:row k0 ((gslt:ordered:occ id-1 seven)))))
(= (gslt:ordered:world-later-success)
   ((gslt:ordered:row k0 ((gslt:ordered:occ id-1 seven)))
    (gslt:ordered:row k1 ((gslt:ordered:occ id-2 seven)))))
(= (gslt:ordered:world-unrelated)
   ((gslt:ordered:row k0 ((gslt:ordered:occ id-1 seven)))
    (gslt:ordered:row k2 ((gslt:ordered:occ id-8 other)))))
(= (gslt:ordered:world-two)
   ((gslt:ordered:row k0 ((gslt:ordered:occ id-1 seven)))
    (gslt:ordered:row k1 ((gslt:ordered:occ id-2 nine)))))
(= (gslt:ordered:world-later-row-changed)
   ((gslt:ordered:row k0 ((gslt:ordered:occ id-1 seven)))
    (gslt:ordered:row k1 ((gslt:ordered:occ id-8 other)))))
(= (gslt:ordered:world-selected-changed)
   ((gslt:ordered:row k0 ((gslt:ordered:occ id-9 seven)))
    (gslt:ordered:row k1 ((gslt:ordered:occ id-2 nine)))))
(= (gslt:ordered:world-empty) ())
(= (gslt:ordered:forward) (k0 k1))
(= (gslt:ordered:reversed) (k1 k0))
(= (gslt:ordered:second-only) (k1))

(= (earlier-insertion)
   (let* (($before (gslt:ordered:first-success (gslt:ordered:world-fallback)
                     (gslt:ordered:forward)))
          ($after (gslt:ordered:first-success (gslt:ordered:world-inserted)
                    (gslt:ordered:forward))))
     (scenario-earlier-insertion
       (gslt:ordered:selected-answer $before)
       (gslt:ordered:selected-reads $before)
       (gslt:ordered:selected-answer $after)
       (gslt:ordered:reads-agree (gslt:ordered:world-inserted)
         (gslt:ordered:selected-reads $before)))))

(= (unrelated-later)
   (let* (($before (gslt:ordered:first-success (gslt:ordered:world-singleton)
                     (gslt:ordered:forward)))
          ($after (gslt:ordered:first-success (gslt:ordered:world-unrelated)
                    (gslt:ordered:forward))))
     (scenario-unrelated-later
       (gslt:ordered:selected-answer $before)
       (gslt:ordered:selected-answer $after)
       (== (gslt:ordered:selected-answer $before) (gslt:ordered:selected-answer $after))
       (gslt:ordered:reads-agree (gslt:ordered:world-unrelated)
         (gslt:ordered:selected-reads $before))
       (== (gslt:ordered:selected-answer $before)
           (gslt:ordered:concatenate-head (gslt:ordered:world-singleton)
             (gslt:ordered:forward))))))

(= (later-cardinality)
   (let* (($once (gslt:ordered:first-success (gslt:ordered:world-singleton)
                   (gslt:ordered:forward)))
          ($once-after (gslt:ordered:first-success (gslt:ordered:world-later-success)
                         (gslt:ordered:forward)))
          ($complete-before (gslt:ordered:complete-scan (gslt:ordered:world-singleton)
                              (gslt:ordered:forward)))
          ($complete-after (gslt:ordered:complete-scan (gslt:ordered:world-later-success)
                             (gslt:ordered:forward))))
     (scenario-later-cardinality
       (gslt:ordered:selected-answer $once)
       (gslt:ordered:selected-answer $once-after)
       (gslt:ordered:at-most-one (gslt:ordered:selected-answer $complete-before))
       (gslt:ordered:at-most-one (gslt:ordered:selected-answer $complete-after))
       (gslt:ordered:reads-agree (gslt:ordered:world-later-success)
         (gslt:ordered:selected-reads $once))
       (gslt:ordered:reads-agree (gslt:ordered:world-later-success)
         (gslt:ordered:selected-reads $complete-before)))))

(= (equal-payloads)
   (let* (($complete (gslt:ordered:complete-scan (gslt:ordered:world-later-success)
                       (gslt:ordered:forward)))
          ($stream (gslt:ordered:selected-answer $complete))
          ($first (car-atom $stream))
          ($second (car-atom (cdr-atom $stream))))
     (scenario-equal-payloads
       $stream
       (gslt:ordered:concatenate (gslt:ordered:world-later-success) (gslt:ordered:forward))
       (== (gslt:ordered:occ-payload $first) (gslt:ordered:occ-payload $second))
       (== (gslt:ordered:occ-id $first) (gslt:ordered:occ-id $second))
       (gslt:ordered:at-most-one-scan (gslt:ordered:world-later-success)
         (gslt:ordered:forward)))))

(= (reversed-order)
   (let* (($left (gslt:ordered:first-success (gslt:ordered:world-two) (gslt:ordered:forward)))
          ($right (gslt:ordered:first-success (gslt:ordered:world-two) (gslt:ordered:reversed))))
     (scenario-reversed-order
       (gslt:ordered:selected-answer $left)
       (gslt:ordered:selected-answer $right)
       (== (gslt:ordered:selected-answer $left) (gslt:ordered:selected-answer $right))
       (gslt:ordered:reads-agree (gslt:ordered:world-two)
         (gslt:ordered:selected-reads $left)))))

(= (empty-completion)
   (let* (($complete (gslt:ordered:complete-scan (gslt:ordered:world-empty)
                       (gslt:ordered:forward)))
          ($once (gslt:ordered:first-success (gslt:ordered:world-empty)
                   (gslt:ordered:forward))))
     (scenario-empty-completion
       (gslt:ordered:selected-answer $complete)
       (gslt:ordered:concatenate (gslt:ordered:world-empty) (gslt:ordered:forward))
       (gslt:ordered:selected-answer $once)
       (gslt:ordered:at-most-one (gslt:ordered:selected-answer $complete))
       (gslt:ordered:selected-reads $complete))))

(= (pause-resume-absence)
   (let* (($paused (gslt:ordered:pause-after-one (gslt:ordered:world-fallback)
                     (gslt:ordered:forward)))
          ($resumed (gslt:ordered:resume-residual (gslt:ordered:world-fallback)
                       (gslt:ordered:paused-residual $paused)))
          ($fresh (gslt:ordered:first-success (gslt:ordered:world-fallback)
                    (gslt:ordered:forward)))
          ($validated (gslt:ordered:resume-validated (gslt:ordered:world-fallback) $paused)))
     (scenario-pause-resume-absence
       (gslt:ordered:paused-reads $paused)
       (gslt:ordered:paused-residual $paused)
       (gslt:ordered:selected-answer $resumed)
       (gslt:ordered:selected-answer $fresh)
       (== (gslt:ordered:selected-answer $resumed) (gslt:ordered:selected-answer $fresh))
       (gslt:ordered:selected-answer $validated))))

(= (stale-or-foreign)
   (let* (($paused (gslt:ordered:pause-after-one (gslt:ordered:world-fallback)
                     (gslt:ordered:forward)))
          ($stale (gslt:ordered:resume-validated (gslt:ordered:world-inserted) $paused))
          ($foreign (gslt:ordered:accept-plan gslt:ordered:first-success
                      (gslt:ordered:plan other-program (gslt:ordered:world-fallback)
                        (gslt:ordered:paused-reads $paused)
                        (gslt:ordered:paused-residual $paused))))
          ($matching (gslt:ordered:accept-plan gslt:ordered:first-success
                       (gslt:ordered:plan gslt:ordered:first-success
                         (gslt:ordered:world-fallback)
                         (gslt:ordered:paused-reads $paused)
                         (gslt:ordered:paused-residual $paused)))))
     (scenario-stale-or-foreign $stale $foreign
       (gslt:ordered:selected-answer $matching))))

(= (pause-resume-success)
   (let* (($paused (gslt:ordered:pause-after-one (gslt:ordered:world-two)
                     (gslt:ordered:forward)))
          ($resumed (gslt:ordered:resume-residual (gslt:ordered:world-two)
                       (gslt:ordered:paused-residual $paused)))
          ($fresh (gslt:ordered:first-success (gslt:ordered:world-two)
                    (gslt:ordered:forward)))
          ($validated (gslt:ordered:resume-validated (gslt:ordered:world-later-row-changed)
                        $paused))
          ($second (gslt:ordered:first-success (gslt:ordered:world-later-row-changed)
                     (gslt:ordered:second-only))))
     (scenario-pause-resume-success
       (gslt:ordered:paused-reads $paused)
       (gslt:ordered:paused-residual $paused)
       (gslt:ordered:selected-answer $resumed)
       (== (gslt:ordered:selected-answer $resumed) (gslt:ordered:selected-answer $fresh))
       (gslt:ordered:selected-answer $validated)
       (gslt:ordered:selected-answer $second)
       (== (gslt:ordered:selected-answer $validated) (gslt:ordered:selected-answer $second))
       (gslt:ordered:reads-agree (gslt:ordered:world-later-row-changed)
         (gslt:ordered:paused-reads $paused)))))

(= (pause-resume-same-payload)
   (let* (($paused (gslt:ordered:pause-after-one (gslt:ordered:world-later-success)
                     (gslt:ordered:forward)))
          ($resumed (gslt:ordered:resume-residual (gslt:ordered:world-later-success)
                       (gslt:ordered:paused-residual $paused)))
          ($second (gslt:ordered:first-success (gslt:ordered:world-later-success)
                     (gslt:ordered:second-only)))
          ($answer (gslt:ordered:selected-answer $resumed))
          ($other (gslt:ordered:selected-answer $second)))
     (scenario-pause-resume-same-payload
       (gslt:ordered:paused-residual $paused)
       $answer
       $other
       (== (gslt:ordered:occ-payload $answer) (gslt:ordered:occ-payload $other))
       (== (gslt:ordered:occ-id $answer) (gslt:ordered:occ-id $other))
       (== $answer $other))))

(= (changed-selected-row)
   (let* (($paused (gslt:ordered:pause-after-one (gslt:ordered:world-two)
                     (gslt:ordered:forward)))
          ($captured (gslt:ordered:resume-residual (gslt:ordered:world-two)
                        (gslt:ordered:paused-residual $paused)))
          ($refused (gslt:ordered:resume-validated (gslt:ordered:world-selected-changed)
                       $paused))
          ($replacement (gslt:ordered:first-success (gslt:ordered:world-selected-changed)
                          (gslt:ordered:forward)))
          ($tail (gslt:ordered:first-success (gslt:ordered:world-selected-changed)
                   (gslt:ordered:second-only))))
     (scenario-changed-selected-row
       (gslt:ordered:paused-reads $paused)
       (gslt:ordered:paused-residual $paused)
       (gslt:ordered:selected-answer $captured)
       $refused
       (gslt:ordered:selected-answer $replacement)
       (gslt:ordered:selected-answer $tail)
       (== (gslt:ordered:occ-payload (gslt:ordered:selected-answer $captured))
           (gslt:ordered:occ-payload (gslt:ordered:selected-answer $replacement)))
       (gslt:ordered:reads-agree (gslt:ordered:world-selected-changed)
         (gslt:ordered:paused-reads $paused)))))

(= (empty-residual)
   (let* (($paused (gslt:ordered:pause-after-one (gslt:ordered:world-empty) ()))
          ($resumed (gslt:ordered:resume-residual (gslt:ordered:world-empty)
                       (gslt:ordered:paused-residual $paused)))
          ($fresh (gslt:ordered:first-success (gslt:ordered:world-empty) ())))
     (scenario-empty-residual
       (gslt:ordered:paused-reads $paused)
       (gslt:ordered:paused-residual $paused)
       (gslt:ordered:selected-answer $resumed)
       (gslt:ordered:selected-answer $fresh)
       (== (gslt:ordered:selected-answer $resumed)
           (gslt:ordered:selected-answer $fresh)))))

!(earlier-insertion)
!(unrelated-later)
!(later-cardinality)
!(equal-payloads)
!(reversed-order)
!(empty-completion)
!(pause-resume-absence)
!(stale-or-foreign)
!(pause-resume-success)
!(pause-resume-same-payload)
!(changed-selected-row)
!(empty-residual)
