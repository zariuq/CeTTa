; SWI-PeTTa-derived conformance observations, including root and clause-body
; placement. These formerly pending cases run in the constructor gate.
(= (list-value:absent present) unused)
(= (list-value:zero-call) (LCons (list-value:absent missing) LNil))
(= (list-value:zero-empty) (LCons (empty) LNil))
(= (list-value:error-data) (LCons (Error bad reason) LNil))
(= (list-value:empty-data) (LCons Empty LNil))
!(collapse (list-value:zero-call))
!(collapse (list-value:zero-empty))
!(collapse (list-value:error-data))
!(collapse (list-value:empty-data))
!(collapse (LCons (list-value:absent missing) LNil))
!(collapse (LCons (empty) LNil))
!(collapse (LCons (Error bad reason) LNil))
!(collapse (LCons Empty LNil))
!(LCons (list-value:absent missing) LNil)
!(LCons (empty) LNil)
!(LCons (Error bad reason) LNil)
!(LCons Empty LNil)
!(collapse (list-value:box (list-value:absent missing)))
!(collapse (list-value:box (empty)))
!(list-value:box (Error bad reason))
!(list-value:box Empty)
!(catch (LCons (Error bad reason) LNil))
!(let $value (catch (LCons (+ 1 not-a-number) LNil))
   (if (= $value (cons Error $_)) list-value:caught-raised-error $value))
!(LCons (quote (list-value:absent missing)) LNil)
!(LCons (quote (empty)) LNil)
