; PeTTa lists are cons cells: a tail need not be a list, and an unbound
; tail can be bound later.  Every observation below is SWI-PeTTa's.
!(cons-atom a atom)
!(cons-atom a (cons-atom b atom))
!(car-atom (cons-atom a atom))
!(cdr-atom (cons-atom a atom))
!(decons-atom (cons-atom a atom))
!(decons (a b))
!(decons-atom ())
!(decons atom)
!(let $x (cons-atom a $t) (let $t (b) $x))
!(let $x (union-atom (a) $t) (let $t (z) $x))
!(union-atom () atom)
!(union-atom (a) atom)
!(union-atom (a b) (cons-atom c atom))
!(== (cons-atom a atom) (cons a atom))
!(== (cons a (b)) (a b))
!(repr (cons-atom a atom))
!(get-metatype (cons-atom a atom))
!(get-metatype (cons-atom a ()))
!(is-expr (cons-atom a atom))
!(is-expr (cons-atom a (b)))
!(is-member a (cons-atom a atom))
!(is-member z (cons-atom a atom))
!(is-member a atom)
!(subtraction-atom atom (a))
!(subtraction-atom (a b) atom)
!(once (size-atom (cons-atom a $t)))
!(let (cons $h $t) (a b c) ($h $t))
!(let (cons-atom $h $t) (a b c) ($h $t))
(= (unbound) $y)
(= (pair) (a b))
!(is-var (unbound))
!(is-ground (unbound))
!(is-expr (pair))
!(is-expr (+ 1 2))
