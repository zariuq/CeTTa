; Pattern removal and errors survive rewriting space operations as transforms.
!(bind! &rows (new-space))
!(add-atom &rows (item 7))
!(add-atom &rows (item 7))
!(add-atom &rows (other a))
!(add-atom &rows (other b))
!(test (remove-atom &rows (item 7)) true)
!(test (remove-atom &rows (item 7)) false)
!(test (let (Error $formal $context) (catch (remove-atom &rows $unbound))
            ($formal (get-metatype $context)))
        (instantiation_error Variable))
!(test (size-atom (collapse (get-atoms &rows))) 2)
!(test (remove-atom &rows (other $value)) true)
!(test (collapse (get-atoms &rows)) ())
(= (retained $x) $x)
!(test (let (Error $formal $context)
            (catch (remove-atom &self (= ($head $arg) $body))) $formal)
        instantiation_error)
!(test (let (Error $formal $context)
            (catch (remove-atom &self (= $left $right))) $formal)
        instantiation_error)
!(test (let $left (cons-atom $head $args)
    (let $pattern (cons-atom = (cons-atom $left (cons-atom $body ())))
      (let (Error $formal $context) (catch (remove-atom &self $pattern)) $formal)))
        instantiation_error)
!(test (retained 7) 7)
(= (repeated) yes)
(= (repeated) yes)
!(test (remove-atom &self (= (repeated) yes)) true)
!(test (collapse (repeated)) ((repeated)))
