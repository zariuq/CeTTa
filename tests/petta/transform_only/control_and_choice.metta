; Binding, branching, choice and collection around calls and a store.
(= (colour) red)
(= (colour) green)
(= (colour) blue)
!(test (collapse (colour)) (red green blue))
!(test (once (colour)) red)
!(test (collapse (let $c (colour) (if (== $c green) (empty) $c))) (red blue))
!(test (collapse (case (colour) ((red warm) (blue cold) ($other (plain $other))))) (warm (plain green) cold))
!(test (collapse (case (empty) ((1 one) (Empty none)))) (none))
!(test (let* (($a 1) ($b (+ $a 1)) (($c $d) (pair $b))) ($a $b $c $d)) (1 2 pair 2))
!(test (collapse (superpose (1 (+ 1 1) 3))) (1 2 3))

!(bind! &facts (new-space))
!(add-atom &facts (edge a b))
!(add-atom &facts (edge b c))
!(add-atom &facts (edge c d))
(= (path $x $y) (match &facts (edge $x $y) (step $x $y)))
(= (path $x $z) (match &facts (, (edge $x $y) (edge $y $z)) (two $x $y $z)))
!(test (collapse (path a $where)) ((step a b) (two a b c)))
!(test (collapse (let $x (superpose (a b)) (match &facts (edge $x $y) $y))) (b c))
!(test (let $_ (add-atom &facts (seen (+ 1 2))) (repr (collapse (match &facts (seen $e) $e)))) "((+ 1 2))")
!(test (let $_ (remove-atom &facts (edge b c)) (repr (sort-atom (collapse (match &facts (edge $x $y) (edge $x $y)))))) "((edge a b) (edge c d))")

!(bind! &counter (new-state 0))
(= (tick) (let $v (+ (get-state &counter) 1) (let $_ (change-state! &counter $v) $v)))
!(test (collapse (let $c (colour) (tick))) (1 2 3))
!(test (get-state &counter) 3)
