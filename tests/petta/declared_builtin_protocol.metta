; A builtin whose type the program declares meets that declaration as a
; typed function's call does: each argument at its domain, the value at the
; range, with multiplicity.  A grounded value whose class names the
; requirement meets it once; every other value takes the complete guard.
(: + (-> Number Number Number))
(= (inc $x) (+ $x 1))
!(collapse (inc 4))
!(collapse (inc 1.5))
!(collapse (inc 99999999999999999999))
!(collapse (inc "s"))
!(sort-atom (collapse (+ (superpose (1 "x" 2.5)) 0)))
(: slen (-> String Number))
(= (slen $s) 1)
!(collapse (slen "abc"))
!(collapse (slen 5))
(: h (-> Grounded Number))
(= (h $x) 1)
!(collapse (h 5))
!(collapse (h "q"))
(: k (-> Number Number))
(= (k $x) $x)
!(collapse (k (foo)))
!(collapse (k 3))
(: bad (-> Number Number))
(= (bad $x) "s")
!(collapse (bad 1))
(: ov (-> Number Number))
(: ov (-> String Number))
(= (ov $x) 7)
!(collapse (ov 3))
!(collapse (ov "s"))
!(collapse (ov sym))
(= (sum $n $acc) (if (== $n 0) $acc (sum (- $n 1) (+ $acc $n))))
!(collapse (sum 100 0))
(= (loop $n $f $acc) (if (== $n 0) $acc (loop (- $n 1) $f ($f (+ $acc 0)))))
!(collapse (loop 50 (|-> ($x) (+ $x 1)) 0))
