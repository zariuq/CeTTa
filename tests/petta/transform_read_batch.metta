!(import! &self (library lib_transform))
!(bind! &s (new-space))
!(add-atom &s (p a))
!(add-atom &s (p a))
!(add-atom &s (p b))
!(println! (let $answers (collapse (transform &s (p $x) (one $x)))
    (read-duplicates (sort-atom $answers))))
!(println! (let $answers (collapse (transform &s (, (p $x) (p $y)) (pair $x $y)))
    (join-duplicates (sort-atom $answers))))
!(println! (let $answers (collapse (transform &s (, (p $x) (p $x)) (same $x)))
    (repeated-leg (sort-atom $answers))))
!(println! (let $answers (collapse (transform &s (q $x) (missing $x)))
    (empty-read $answers)))
!(println! (let $answers (collapse (transform &s (p $x) held))
    (constant-template $answers)))
!(bind! &open (new-space))
!(add-atom &open (open $shared))
!(add-atom &open (p 7))
!(println! (let $answers (collapse (transform &open (p $x) (open-result $x)))
    (open-control $answers)))
!(bind! &other (new-space))
!(add-atom &other (q c))
!(println! (let $answers (collapse (transform &s (, (p $x) (read &other (q $y))) (cross $x $y)))
    (cross-space (sort-atom $answers))))
!(println! (let $answers (collapse (transform &other (, (q $x) (let $unit (add-atom &other (seen $x)))) (effect $x)))
    (effectful (sort-atom $answers))))
!(println! (let $answers (collapse (match &other (seen $x) $x))
    (effects (sort-atom $answers))))
!(println! (let $answers (collapse (match &s (p $x) $x))
    (unchanged-source (sort-atom $answers))))
!(println! (read-count
    (size-atom (collapse (transform &s (, (p $x) (p $y)) (pair $x $y))))))
!(println! (match-count
    (size-atom (collapse (match &s (, (p $x) (p $y)) (pair $x $y))))))
!(println! (split-count
    (size-atom (collapse (transform &s (p $x) (, (left $x) (right $x)))))))
!(println! (missing-count
    (size-atom (collapse (transform &s (q $x) (missing $x))))))
