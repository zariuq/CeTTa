; Spellings the tier admits by their normal form answer as written: a
; two-armed if (no else answers nothing, a non-Boolean condition included),
; a superpose of one alternative, and a let answering its own variable.
(= (sign $x) (if (> $x 0) pos))
(= (inc-pos $x) (+ 1 (if (> $x 0) 1)))
(= (when-true $x) (if $x yes))
(= (one $x) (superpose ((+ $x 1))))
(= (one-data $x) (superpose ((pair $x))))
(= (one-choice $x) (superpose ((superpose (1 2)))))
(= (one-empty $x) (superpose ((empty))))
(= (bound $x) (let $y (+ $x 1) $y))
(= (bound-choice $x) (let $y (superpose (1 2)) $y))
(= (loop $n $acc) (if (== $n 0) $acc (loop (- $n 1) (+ $acc (one $n)))))
!(sign 1)
!(sign -1)
!(collapse (sign -1))
!(inc-pos 1)
!(inc-pos -1)
!(when-true True)
!(when-true False)
!(when-true 7)
!(collapse (superpose ((sign 1) (sign -1) (sign 2))))
!(one 1)
!(one-data 1)
!(collapse (one-choice 0))
!(collapse (one-empty 0))
!(+ 1 (one 2))
!(bound 1)
!(collapse (bound-choice 0))
!(loop 200 0)
