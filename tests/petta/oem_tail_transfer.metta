; Tail calls retain the caller's result after a host effect, including branch and composed tuple results.
(= (ret_id $x) $x)
(= (ret_branch $x)
  (let $u (println! transfer_here)
    (if (== $x 0) (ret_id 11) (ret_id 22))))
(= (ret_nontail_control $x)
  (let $u (println! transfer_here)
    (if (== $x 0)
        (let $r (ret_id 11) $r)
        (let $r (ret_id 22) $r))))
!(ret_branch 0)
!(ret_branch 1)
!(ret_nontail_control 0)
!(ret_nontail_control 1)

(= (p $pattern) (p () $pattern))
(= (p $head $tail)
  (if (== $tail ()) (() ())
    (let ($h $t) (decons-atom $tail)
      (if (== $t ()) ($head ($h)) (p (union-atom $head ($h)) $t)))))
(= (wp $pattern) (let ($rest $last) (p $pattern) (Parts $rest $last)))
!(p (a b))
!(wp (a b))
!(p (cons-atom a (b)))
!(wp (cons-atom a (b)))
(= (sp $x) (let $tail (cons-atom b ()) (cons-atom a $tail)))
!(wp (sp z))
(= (composed $x) (let $passed (sp $x) (let ($rest $last) (p $passed) (Parts $passed $rest $last))))
!(composed z)

(= (ret_case $x)
  (let $u (println! case_transfer_here)
    (case $x ((0 (ret_id 33)) ($else (ret_id 44))))))
!(ret_case 0)
!(ret_case 1)
