;; A tabled-lattice relation joined by min or max selects as the functions
;; min and max do: by the value an answer stands for (a constant included),
;; and on a tie min keeps the join so far and max takes the later answer.
;; Each tabled join below equals the direct selection over the same answers
;; in the order they are derived.
!(import! &self (library lib_tabling))
(= (fold-join $op $acc $xs)
   (if (== $xs ()) $acc
     (fold-join $op (if (== $op min) (min $acc (car-atom $xs)) (max $acc (car-atom $xs)))
                (cdr-atom $xs))))
(= (direct $op $xs) (fold-join $op (car-atom $xs) (cdr-atom $xs)))

(= (cand pi-4) pi)
(= (cand pi-4) 4)
(= (cand 4-pi) 4)
(= (cand 4-pi) pi)
(= (cand int-float) 2)
(= (cand int-float) 2.0)
(= (cand float-int) 2.0)
(= (cand float-int) 2)
(= (cand zeros) 0.0)
(= (cand zeros) -0.0)
(= (cand zeros-) -0.0)
(= (cand zeros-) 0.0)
(= (cand three) 3)
(= (cand three) 1.0)
(= (cand three) 1)
(= (cand three) 2)
!(tabled-lattice (low $k) min)
(= (low $k) (cand $k))
!(tabled-lattice (high $k) max)
(= (high $k) (cand $k))
(= (row $k) ($k (low $k) (direct min (collapse (cand $k)))
                (high $k) (direct max (collapse (cand $k)))))
!(row pi-4)
!(row 4-pi)
!(row int-float)
!(row float-int)
!(row zeros)
!(row zeros-)
!(row three)
!(== (collapse (let $k (superpose (pi-4 4-pi int-float float-int zeros zeros- three))
                  (== (low $k) (direct min (collapse (cand $k))))))
     (True True True True True True True))

;; a cycle whose paths tie in value though held two ways: the fixpoint ends
(= (warc a) (b 1))
(= (warc a) (b 1.0))
(= (warc b) (a 1))
!(tabled-lattice (wd $x $y) min)
(= (wd $x $y) (let ($y $w) (warc $x) $w))
(= (wd $x $y) (let ($z $w) (warc $x) (let $d (wd $z $y) (+ $w $d))))
!(msort (collapse (let $c (wd a $y) ($y $c))))
;; longest paths on a DAG whose paths tie in value: max takes the later
(= (tarc s) (t 1))
(= (tarc s) (t 1.0))
(= (tarc t) (u 1))
!(tabled-lattice (tl $x $y) max)
(= (tl $x $y) (let ($y $w) (tarc $x) $w))
(= (tl $x $y) (let ($z $w) (tarc $x) (let $d (tl $z $y) (+ $w $d))))
!(msort (collapse (let $c (tl s $y) ($y $c))))
