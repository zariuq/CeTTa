import!(&self, library[lib_transform])
import!(&self, library[lib_flow])
atom edge[a, b]
atom edge[b, c]
def len([]):
    0
def len(cons[$h, $t]):
    1 + len($t)
len(cons(x, cons(y, [])))
collapse([pair($x, $y) for edge[$x, $y] in &self])
show-held :: Atom -> Atom
def show-held($x):
    $x
def twice($x):
    2 * $x
show-held(twice[3])
no-such-function(twice(3))
def build($x, $y):
    built
def steps($xs):
    $xs
steps(build(check, deploy))
show-held(build[check, deploy])
collapse(superpose([twice(1), twice(2)]))
get-metatype(twice(3))
atom color[red]
add-atom(&self, color[green])
collapse([$c for color[$c] in &self])
bind!(&s, new-space())
add-atom(&s, job[j1, 2])
add-atom(&s, job[j2, 0])
add-atom(&s, busy[j2])
collapse([$n + 1 for job[$j, $n] in &s])
collapse(transform &s:
    job[$j, $n]
    absent busy[$j]
yield free($j))
transform &s into &s:
    take job[$j, 0]
    read busy[$j]
yield done[$j]
collapse(transform &s:
    once:
        job[$j, $n]
yield $j)
collapse(transform &s:
    collect $all:
        job[$j, $n]
yield size-atom($all))
for $x in superpose([a, b]):
    println!(item($x))
for $x in superpose([twice(1), b]):
    println!(item($x))
for $x in twice(2):
    println!(answer($x))
do:
    println!(first)
    second
for job[$j, $n] from &s:
    println!(has($j))
