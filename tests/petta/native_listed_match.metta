; A list spread over a match, `(let PAT (superpose LIST) (match S P T))`,
; joined as a match over the list's rows: each row in its multiplicity,
; under the match's bindings.  A short list is spread row by row.
(e a b)
(e a c)
(e b c)
(e c d)
(e d a)
(e h s0)
(e s0 s1)
(e s0 t0)
(e h s1)
(e s1 s2)
(e s1 t1)
(e h s2)
(e s2 s3)
(e s2 t2)
(e h s3)
(e s3 s4)
(e s3 t3)
(e h s4)
(e s4 s5)
(e s4 t4)
(e h s5)
(e s5 s6)
(e s5 t5)
(e h s6)
(e s6 s7)
(e s6 t6)
(e h s7)
(e s7 s8)
(e s7 t7)
(e h s8)
(e s8 s9)
(e s8 t8)
(e h s9)
(e s9 s10)
(e s9 t9)
(e h s10)
(e s10 s11)
(e s10 t10)
(e h s11)
(e s11 s12)
(e s11 t11)
(e h s12)
(e s12 s13)
(e s12 t12)
(e h s13)
(e s13 s14)
(e s13 t13)
(e h s14)
(e s14 s15)
(e s14 t14)
(e h s15)
(e s15 s16)
(e s15 t15)
(e h s16)
(e s16 s17)
(e s16 t16)
(e h s17)
(e s17 s18)
(e s17 t17)
(e h s18)
(e s18 s19)
(e s18 t18)
(e h s19)
(e s19 s0)
(e s19 t19)
!(sort-atom (collapse (let $u (superpose (a b)) (match &self (e $u $v) $v))))
!(sort-atom (collapse (let $u (superpose (a a b)) (match &self (e $u $v) ($u $v)))))
!(sort-atom (collapse (let $u (superpose (s0 s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15 s16)) (match &self (e $u $v) ($u $v)))))
!(sort-atom (collapse (let ($u $w) (superpose ((s0 0) (s1 1) (s2 2) (s3 3) (s4 4) (s5 5) (s6 6) (s7 7) (s8 8) (s9 9) (s10 10) (s11 11) (s12 12) (s13 13) (s14 14) (s15 15) (s16 16) (s17 17))) (match &self (e $u $v) ($w $v)))))
!(collapse (let $u (superpose ()) (match &self (e $u $v) $v)))
!(size-atom (collapse (let $u (superpose (s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15 s16 s17 s18 s19)) (match &self (e $u $v) t))))
; A breadth-first search whose visit marks a vertex once and answers it:
; each level's frontier is the vertices first met, whichever edge met them.
!(bind! &s (new-space set))
!(bind! &d (new-space set))
!(add-atom &s (seen h))
(= (visit $v $k)
   (if (== (collapse (match &s (seen $v) t)) ())
       (let* (($_ (add-atom &s (seen $v))) ($_ (add-atom &d (dist $v $k)))) $v)
       (empty)))
(= (bfs $front $k)
   (let* (($k1 (+ $k 1))
          ($next (collapse (let $u (superpose $front) (match &self (e $u $v) (visit $v $k1))))))
     (if (== $next ()) $k (bfs $next $k1))))
!(bfs (h) 0)
!(sort-atom (collapse (match &d (dist $v $k) ($v $k))))
; A visit answering a variable its guard does not read keeps the ordinary
; path: which edge meets a vertex first would choose the answer.
!(bind! &s2 (new-space set))
(= (visit2 $u $v)
   (if (== (collapse (match &s2 (seen $v) t)) ())
       (let $_ (add-atom &s2 (seen $v)) ($u $v))
       (empty)))
!(sort-atom (collapse (let $u (superpose (s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15 s16 s17 s18 s19)) (match &self (e $u $v) (visit2 $u $v)))))
