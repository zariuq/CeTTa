!(import! &self str)

(= (export:observe $text $remaining $sum)
   (if (< $remaining 1)
       (StringObservation $sum (str:byte-length $text) (str:byte-slice $text 2 3))
       (let* (($size (str:byte-length $text))
              ($suffix (str:byte-slice $text 2 3))
              ($comparison (str:compare $text $text)))
         (if (== $comparison 0)
           (export:observe $text (- $remaining 1) (+ $sum $size))
           wrong))))
(= (export:source)
   (str:from-codepoints (65 0 66)))
(= (export:source)
   (str:from-codepoints (67 0 68)))
!(collapse (let $text (export:source) (export:observe $text 1000 0)))

(= (export:unicode $text $remaining)
   (if (< $remaining 1)
       (UnicodeObservation (str:byte-length $text)
         (== (str:byte-slice $text 0 2) (str:from-codepoints (955)))
         (== (str:byte-slice $text 2 3) (str:from-codepoints (0)))
         (== (str:byte-slice $text 3 4) "Z"))
       (let $size (str:byte-length $text)
         (if (== $size 4) (export:unicode $text (- $remaining 1)) wrong))))
!(let $text (str:from-codepoints (955 0 90)) (export:unicode $text 1000))

(= (export:carry $text $value)
   (let $size (str:byte-length $text)
     (let $slice (str:byte-slice $text 0 $size)
       (if (== $slice $text) (Kept $value $value) wrong))))
!(let $text (str:from-codepoints (65 0 66))
   (export:carry $text $unbound))
