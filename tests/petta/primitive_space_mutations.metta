; Primitive occurrences and expression rows occupy distinct shapes.
!(add-atom &mixed 42)
!(add-atom &mixed 42)
!(add-atom &mixed (42))
!(add-atom &mixed (#primitive 42))
!(add-atom &mixed "text")
!(add-atom &mixed marker)
!(add-atom &mixed ())
!(add-atom &mixed True)
!(test (collapse (match &mixed 42 found)) (found found))
!(test (remove-atom &mixed 42) True)
!(test (collapse (match &mixed 42 found)) ())
!(test (collapse (match &mixed (42) found)) (found))
!(test (collapse (match &mixed (#primitive $x) $x)) (42))
!(test (remove-atom &mixed 42) False)
!(test (remove-atom &mixed "text") True)
!(test (collapse (match &mixed "text" found)) ())
!(test (remove-atom &mixed marker) True)
!(test (collapse (match &mixed marker found)) ())
!(test (remove-atom &mixed ()) True)
!(test (collapse (match &mixed () found)) ())
!(test (remove-atom &mixed True) True)
!(test (size-atom (collapse (get-atoms &mixed))) 2)
!(test (collapse (match &mixed (42) found)) (found))
!(test (collapse (match &mixed (#primitive $x) $x)) (42))

; Removing a row does not remove an unrelated stored primitive.
!(add-atom &mixed 7)
!(test (remove-atom &mixed (#primitive $x)) True)
!(test (size-atom (collapse (get-atoms &mixed))) 2)
!(test (collapse (match &mixed (42) found)) (found))
!(test (collapse (match &mixed 7 found)) (found))
!(test (remove-atom &mixed (42)) True)
!(test (remove-atom &mixed 7) True)
!(test (collapse (get-atoms &mixed)) ())
