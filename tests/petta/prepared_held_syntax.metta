(: hc:hold (-> Atom %Undefined%))
(= (hc:hold $syntax) $syntax)
(= (hc:hold-site $n) (hc:hold (+ $n 2)))
!(hc:hold-site 10)

(: hc:run (-> Atom %Undefined%))
(= (hc:run $syntax) (eval $syntax))
(= (hc:run-site $n) (hc:run (+ $n 2)))
!(hc:run-site 10)

(: hc:both (-> Atom %Undefined%))
(= (hc:both $syntax) (Pair $syntax (eval $syntax)))
(= (hc:both-site $n) (hc:both (+ $n 2)))
!(hc:both-site 10)

(: hc:scope (-> Atom %Undefined%))
(= (hc:scope $syntax) (let $local 5 (eval $syntax)))
(= (hc:scope-site $local) (hc:scope (+ $local 1)))
!(hc:scope-site 10)

(: hc:bind-held (-> Atom %Undefined%))
(= (hc:bind-held $bound) (let $bound 99 (eval $bound)))
(= (hc:bind-site $value) (hc:bind-held $value))
!(collapse (hc:bind-site 3))
!(hc:bind-site 99)

(= (hc:tick $value) (let $_ (add-atom &hc-effects (mark $value)) $value))
(: hc:mixed (-> %Undefined% Atom %Undefined%))
(= (hc:mixed $value $syntax) (Triple $value $value (eval $syntax)))
(= (hc:mixed-site) (hc:mixed (hc:tick 7) (hc:tick 8)))
!(hc:mixed-site)
!(sort-atom (collapse (match &hc-effects (mark $value) $value)))

(: hc:choose (-> Atom Atom Atom %Undefined%))
(= (hc:choose $flag $yes $no) (if $flag (eval $yes) (eval $no)))
(= (hc:choose-site $n)
   (let $flag (> $n 0) (hc:choose $flag (hc:tick 11) (hc:tick 12))))
!(hc:choose-site 1)
!(hc:choose-site -1)
(= (hc:data-flag-site $n) (hc:choose (> $n 0) yes no))
!(hc:data-flag-site 1)
!(sort-atom (collapse (match &hc-effects (mark $value) $value)))
(= (hc:fault-site $n)
   (let $flag (> $n 0) (hc:choose $flag (+ $n 1) (/ 1 0))))
!(hc:fault-site 2)
!(case (catch (hc:fault-site -2)) (((Error $detail $context) caught) ($other unexpected)))

(: hc:select (-> Atom Atom Atom Atom %Undefined%))
(= (hc:select $space $pattern $yes $no)
   (if (is-space $space)
       (let $_cut (cut)
         (case (match $space $pattern $pattern)
           (($pattern (eval $yes)) (Empty (eval $no)))))
       (empty)))
(= (hc:select $left $right $yes $no)
   (if (= $left $right) (eval $yes) (eval $no)))
(= (hc:scalar-site $n)
   (let $flag (< $n 0) (hc:select $flag True (+ $n 100) (- $n 100))))
!(hc:scalar-site -1)
!(hc:scalar-site 1)
!(bind! &hc-space (new-space))
!(add-atom &hc-space (row a))
!(add-atom &hc-space (row b))
(= (hc:space-site) (hc:select &hc-space (row $value) (Found $value) missing))
!(sort-atom (collapse (hc:space-site)))

(: hc:unify (-> Atom Atom %Undefined%))
(= (hc:unify $left $right) (if (= $left $right) (Joined $left $right) missing))
(= (hc:alias-site)
   (let $result (hc:unify (Pair $x 1) (Pair 2 $y))
      (Aliases $result $x $y)))
!(hc:alias-site)
(: hc:twice (-> Atom %Undefined%))
(= (hc:twice $syntax) (Pair $syntax $syntax))
(= (hc:open-site) (hc:twice (Box $unknown)))
!(let (Pair (Box $left) (Box $right)) (hc:open-site)
   (let $left 7 (shared $right)))

(: hc:many (-> Atom %Undefined%))
(= (hc:many $argument) first)
(= (hc:many $argument) second)
(= (hc:many-site $n) (hc:many $n))
!(sort-atom (collapse (hc:many-site 3)))

(= (hc:cons-site $n) (hc:hold (cons $n ())))
!(hc:cons-site 5)
(= (hc:quote-site $n) (hc:hold (quote (+ $n 2))))
!(hc:quote-site 5)
(= (hc:eval-slot-site) (let $code (quote (+ 1 2)) (hc:run $code)))
!(hc:eval-slot-site)
(= (hc:space-value-site) (hc:run &hc-space))
!(let $value (hc:space-value-site) (get-metatype $value))
(= (hc:eq-one-site $n) (if (= $n 1) same different))
!(hc:eq-one-site 1)
!(hc:eq-one-site 1.0)
!(hc:eq-one-site "1")

; Relational head patterns must keep their evaluator semantics.
(= (hc:relational-head (+ 1 2)) matched)
(= (hc:relational-head $value) missed)
!(collapse (hc:relational-head 3))

; A preceding typed query must not poison later unchecked compilation.
!(: (hc:scalar-site -1) %Undefined%)
!(hc:scalar-site -1)

; Guard an eager parameter's value, after preparing its expression once.
(: hc:eager-guard (-> %Undefined% Atom %Undefined%))
(= (hc:eager-guard $space $fallback)
   (if (is-space $space) 41 (empty)))
(= (hc:eager-guard $value $fallback) $fallback)
(= (hc:space-id) &hc-space)
(= (hc:eager-space-site $n) (hc:eager-guard (hc:space-id) (+ $n 2)))
(= (hc:eager-number-site $n) (hc:eager-guard (+ $n 1) (+ $n 2)))
!(hc:eager-space-site 5)
!(hc:eager-number-site 5)

; Syntax construction must preserve a head supplied by the caller too.
(= (hc:head-site $head $n) (hc:hold ($head $n ())))
!(hc:head-site cons 5)
!(hc:hold (cons 5 ()))

; Cached inlining retains ownership of a helper whose definition changes.
!(add-atom &self (= (hc:run $syntax) extra))
!(sort-atom (collapse (hc:run-site 10)))
