; Output constraints belong to the translated equation LHS.  Opaque control
; results acquire their connection only when their runtime boundary is entered.
!(progn (translatePredicate (set_prolog_flag occurs_check True)) true)
(= (output-mark $label) (progn (println! $label) fixed-result))
(= (output-literal (output-mark literal-prefix)) accepted)
!(println! literal-conflict)
!(collapse (let rejected (output-literal fixed-result) reached))
!(println! literal-compatible)
!(collapse (let accepted (output-literal fixed-result) reached))

(= (output-sequence (output-mark sequence-prefix))
   (progn (println! sequence-body) accepted))
!(println! sequence-conflict)
!(collapse (let rejected (output-sequence fixed-result) reached))
!(println! sequence-compatible)
!(collapse (let accepted (output-sequence fixed-result) reached))

(= (output-bindings (output-mark bindings-prefix))
   (let* (($x (progn (println! binding-body) payload))) accepted))
!(println! bindings-conflict)
!(collapse (let rejected (output-bindings fixed-result) reached))
!(println! bindings-compatible)
!(collapse (let accepted (output-bindings fixed-result) reached))

(= (output-inner) (progn (println! inner-body) accepted))
(= (output-constructor (output-mark constructor-prefix))
   (box (output-inner) fixed))
!(println! constructor-sibling-conflict)
!(collapse (let (box $x wrong) (output-constructor fixed-result) reached))
!(println! constructor-hole-conflict)
!(collapse (let (box rejected fixed) (output-constructor fixed-result) reached))
!(println! constructor-compatible)
!(collapse (let (box accepted fixed) (output-constructor fixed-result) reached))

(= (output-shared (output-mark $x) $x) $x)
!(println! shared-output-input)
!(collapse (let wanted (output-shared fixed-result $x) $x))

(= (output-conditional (output-mark conditional-prefix))
   (if (progn (println! condition-body) True)
       (progn (println! branch-body) accepted)
       accepted))
!(println! conditional-conflict)
!(collapse (let rejected (output-conditional fixed-result) reached))
!(println! conditional-compatible)
!(collapse (let accepted (output-conditional fixed-result) reached))

(= (output-sealed (output-mark sealed-prefix))
   (sealed () (progn (println! sealed-body) accepted)))
!(println! sealed-conflict)
!(collapse (let rejected (output-sealed fixed-result) reached))
!(println! sealed-compatible)
!(collapse (let accepted (output-sealed fixed-result) reached))

(= (output-quoted (output-mark quoted-prefix)) (quote (cons a ())))
!(println! quoted-conflict)
!(collapse (let (quote (a)) (output-quoted fixed-result) reached))
!(println! quoted-compatible)
!(collapse (let (quote (cons a ())) (output-quoted fixed-result) reached))

; A source variable remains a value even when it carries callable syntax.
(= (output-value (output-mark value-prefix) $x) $x)
!(println! callable-value)
!(collapse (let (quote (output-inner))
    (output-value fixed-result (quote (output-inner))) reached))

(= (output-first (output-mark first-prefix))
   (prog1 (output-inner) (println! after-first)))
!(println! first-conflict)
!(collapse (let rejected (output-first fixed-result) reached))
!(println! first-compatible)
!(collapse (let accepted (output-first fixed-result) reached))

(: output-typed (-> Symbol Symbol))
(= (output-typed (output-mark typed-prefix))
   (progn (println! typed-body) accepted))
!(println! typed-conflict)
!(collapse (let rejected (output-typed fixed-result) reached))
!(println! typed-compatible)
!(collapse (let accepted (output-typed fixed-result) reached))

(: output-atom (-> Symbol Atom))
(= (output-atom (output-mark atom-prefix))
   (progn (println! atom-body) accepted))
!(println! atom-conflict)
!(collapse (let rejected (output-atom fixed-result) reached))
!(println! atom-compatible)
!(collapse (let (quote (progn (println! atom-body) accepted))
    (output-atom fixed-result) reached))

; A fixed intrinsic output uses the dialect's canonical truth representation.
(= (output-cut) (cut))
!(println! cut-compatible)
!(collapse (let true (output-cut) reached))
!(collapse (let True (output-cut) reached))
!(println! cut-conflict)
!(collapse (let false (output-cut) reached))
!(output-cut)

; A completed output match remains true under later bindings. Backtracking
; must restore the continuation together with the bindings that justify it.
(= (output-deferred $x)
   (let $y (progn (println! deferred-body) (superpose (a b a)))
     (let* (($z $y)) (quote (pair $x $z)))))
!(println! deferred-partial)
!(collapse (let (quote (pair shared $y)) (output-deferred shared) $y))
!(println! deferred-duplicates)
!(collapse (let (quote (pair shared a)) (output-deferred shared) reached))
!(println! deferred-conflict)
!(collapse (let (quote (other shared a)) (output-deferred shared) reached))

(= (output-deferred-cons $x)
   (progn (println! deferred-cons-body) (quote (box $x))))
!(println! deferred-cons)
!(collapse (let (quote (box (a b)))
   (output-deferred-cons (cons a (cons b ()))) reached))
