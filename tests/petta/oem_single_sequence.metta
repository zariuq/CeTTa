; One-child sequences keep the child's values, alternatives and cut scope.
(= (single-progn $x) (progn $x))
(= (single-prog1 $x) (prog1 $x))
(= (single-choice) (progn (superpose (left left right))))
(= (single-nested $x) (prog1 (progn (+ $x 1))))
(= (single-field $x) (Box (progn (+ $x 2))))
(= (single-tail $n) (if (== $n 0) done (progn (single-tail (- $n 1)))))
(= (single-cut) (progn (cut)))
(= (single-cut) rejected)
(= (single-field-cut) (Box (prog1 (cut))))
(= (single-field-cut) rejected)
(= (single-fail) (progn (empty)))
(= (single-raise) (prog1 (/ 1 0)))
(= (single-effect) (progn (println! single-effect)))
(= (multiple-progn) (progn (println! first-effect) (superpose (one two))))
(= (multiple-prog1) (prog1 (superpose (one two)) (println! last-effect)))
!(single-progn plain)
!(single-prog1 plain)
!(single-progn (quote (progn (println! inert))))
!(single-prog1 (quote (prog1 (println! inert))))
!(collapse (single-choice))
!(once (single-choice))
!(single-nested 7)
!(single-field 7)
!(single-tail 1000)
!(collapse (single-cut))
!(collapse (single-field-cut))
!(collapse (single-fail))
!(let (Error $kind $context) (catch (single-raise)) $kind)
!(single-effect)
!(collapse (multiple-progn))
!(collapse (multiple-prog1))
