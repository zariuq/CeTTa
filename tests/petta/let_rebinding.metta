; A variable a let bound stays bound for the rest of the body: a later let
; of it compares, (let $y e $y) compares where $y is bound, and a let in
; another branch binds it afresh.
(= (t7 $b) (+ (let $x 1 $x) (let $x $b $x)))
!(t7 1)
!(t7 2)
(= (t3 $a) (let $x $a (let $y $x (let $x 5 (+ $y 1)))))
!(t3 5)
!(t3 6)
(= (s $y) (let $y 3 $y))
!(s 4)
!(s 3)
(= (v $b) (+ (let $y 1 $y) (let $y $b (* 10 $y))))
!(v 2)
!(v 1)
(= (w $b) (+ (let $y 1 $y) (let $y $b $y)))
!(w 2)
!(w 1)
(= (br $c) (if $c (let $x 1 (+ $x 10)) (let $x 2 (+ $x 20))))
!(br True)
!(br False)
(= (br2 $c $b) (+ (if $c (let $x 1 $x) (let $x 2 $x)) (let $x $b $x)))
!(br2 True 1)
!(br2 True 2)
!(br2 False 2)
