(= (predicate-open $head) ($head 3))
!(is-var (car-atom (predicate-open $unknown)))
!(collapse (is-var (car-atom (predicate-open $unknown))))
!(pair (is-var (car-atom (predicate-open $unknown))) true)
!(is-ground (cdr-atom (predicate-open $unknown)))
!(is-expr (predicate-open $unknown))
!(is-var $unknown)
!(sort-atom (collapse (is-var (superpose ($unknown 3 (x))))))
!(sort-atom (collapse (is-expr (superpose ((x) 3 $unknown)))))
!(sort-atom (collapse (is-ground (superpose ((x) $unknown)))))
!(collapse (is-var (empty)))

!(bind! &predicate-effects (new-state 0))
(= (predicate-tick)
   (let $u (change-state! &predicate-effects (+ (get-state &predicate-effects) 1))
      (quote (payload value))))
!(is-expr (predicate-tick))
!(get-state &predicate-effects)
!(let $ready (quote (predicate-tick)) (is-expr $ready))
!(let $ready (quote (predicate-tick)) (is-var $ready))
!(get-state &predicate-effects)

; Argument bindings remain visible after the value is observed.
(= (predicate-bind-open 7) $fresh)
!(let $truth (is-var (predicate-bind-open $input)) (pair $truth $input))
(= (predicate-bind-ground 7) 7)
!(let $truth (is-ground (predicate-bind-ground $input)) (pair $truth $input))

; A strict call hands the observer a completed value, including quoted calls.
; Memoized equations also reach the search machine without an environment flag.
!(import! &self (library lib_memo))
(= (predicate-ready-f $x) 42)
(= (predicate-ready-v) $free)
(= (predicate-ready-s) &self)
(= (predicate-ready-call) (quote (predicate-ready-f 1)))
(= (predicate-ready-open) (quote (predicate-ready-f $u)))
(= (predicate-ready-var) (quote (predicate-ready-v)))
(= (predicate-ready-space) (quote (predicate-ready-s)))
(= (predicate-ready-effect) (quote (predicate-tick)))
(= (predicate-ready-observations $n)
   ((is-expr (predicate-ready-call))
    (is-ground (predicate-ready-open))
    (is-var (predicate-ready-var))
    (is-space (predicate-ready-space))
    (is-expr (predicate-ready-effect))))
!(memoize predicate-ready-observations)
!(predicate-ready-observations 0)
!(predicate-ready-observations 1)
!(get-state &predicate-effects)
!(transaction (is-expr (predicate-ready-effect)))
!(get-state &predicate-effects)
