; A let that destructures a value and puts the destructured head back into its
; result: the head is read by the let's pattern before the result is bound.
(= (copy $xs) (if (== $xs ()) () (let ($h $t) (decons-atom $xs) (cons-atom $h (copy $t)))))
(= (app $xs $ys)
   (if (== $xs ()) $ys
     (let ($x $more) (decons-atom $xs)
       (let $tail (app $more $ys) (cons-atom $x $tail)))))
(= (keep-pos $xs)
   (if (== $xs ()) ()
     (let* ((($h $t) (decons-atom $xs)) ($r (keep-pos $t)))
       (if (> $h 0) (cons-atom $h $r) $r))))
(= (swap2 $p) (let ($a $b) $p ($b $a)))
(= (first-rest $xs) (let ($h $t) (decons-atom $xs) (cons-atom $h $t)))
(= (pair-up $xs) (let* ((($h $t) (decons-atom $xs)) ($n (size-atom $t))) ($h $n)))
(= (wrap $xs) (size-atom (let ($h $t) (decons-atom $xs) (cons-atom $h (cons-atom $h $t)))))
(= (bar $x) (barred $x))
(= (tagged $xs) (let ($h $t) (decons-atom $xs) (Tagged (cons-atom $h $t) $t)))
(= (both $xs) (let ($h $t) (decons-atom $xs) ($h (cons-atom $h $t))))
!(copy (1 2 3 4 5))
!(copy ())
!(app (1 2) (3 4))
!(keep-pos (3 -1 4 -1 5))
!(swap2 (x y))
!(pair-up (a b c))
!(wrap (p q))
!(let (a $r) (first-rest (a b)) $r)
!(let ($p $q) (swap2 (1 2)) ($q $p))
!(let (bar $r) (first-rest (bar 7)) $r)
!(let (2 $n) (pair-up (2 x y z)) $n)
!(sort-atom (collapse (let ($h $t) (superpose ((1 2) (3 4))) (cons-atom $h $t))))
!(sort-atom (collapse (first-rest (superpose ((k 1) (j 2 3))))))
!(let (Tagged $l $r) (tagged (a b)) ($l $r))
!(let (Tagged (bar $y) $r) (tagged (bar 5)) $y)
!(both (p q))
!(let ($a ($b $c)) (both (p q)) ($a $b $c))
