!(bind! &first (new-space))
!(bind! &second (new-space))
!(test (import! &first str) true)
!(test (eval (str:starts-with "abc" "a") &first) true)
!(test (eval (str:starts-with "abc" "a") &second)
       (quote (str:starts-with "abc" "a")))
!(test (import! &second str) true)
!(test (eval (str:starts-with "abc" "a") &second) true)
!(test (str:starts-with "abc" "a") (quote (str:starts-with "abc" "a")))
!(test (import! &first str) true)
!(test (size-atom (collapse (match &first (= (str:starts-with $a $b) $body) t))) 1)
