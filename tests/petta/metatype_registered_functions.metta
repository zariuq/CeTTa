; SWI-PeTTa's get-metatype/2 reports a symbol Grounded when it is a truth
; value or names a registered function (fun/1): one of the builtins it
; registers as it loads, or a function the program defines in &self, from the
; moment the parse pass declares it until a removal leaves &self none of its
; equations.  Any other symbol, a token included, is a Symbol.  Every answer
; is SWI-PeTTa's, read directly and inside a relation.
(= (defined $x) $x)
(= (metatype-of $x) (get-metatype $x))
!(get-metatype &self)
!(get-metatype true)
!(get-metatype false)
!(get-metatype True)
!(get-metatype False)
!(get-metatype defined)
!(get-metatype later)
!(get-metatype undefined-symbol)
!(get-metatype +)
!(get-metatype superpose)
!(get-metatype let)
!(get-metatype match)
!(get-metatype cons)
!(get-metatype map-atom)
!(get-metatype get-metatype)
!(get-metatype empty)
!(get-metatype size-atom)
!(get-metatype #\=)
!(get-metatype collapse)
!(get-metatype if)
!(get-metatype once)
!(get-metatype foldall)
!(get-metatype "text")
!(get-metatype 1.5)
!(get-metatype $v)
!(get-metatype (a b))
!(get-metatype ())
!(metatype-of metatype-of)
!(metatype-of later)
!(metatype-of true)
!(metatype-of &self)
!(metatype-of +)
!(metatype-of plain)
!(let $f metatype-of (get-metatype $f))
!(add-atom &self (= (made-at-run-time) 1))
!(metatype-of made-at-run-time)
!(get-metatype made-at-run-time)
!(remove-atom &self (= (made-at-run-time) 1))
!(metatype-of made-at-run-time)
!(get-metatype made-at-run-time)
(= (later) 3)
