(= (path-add $flag $pair)
    (if (== $flag A)
        (let ($head $tail) $pair (+ $head $tail))
        (let ($head $tail) $pair (- $head $tail))))
(= (path-nested $flag $other $pair)
    (if (== $flag A)
        (if (== $other B)
            (let ($head $tail) $pair (+ $head $tail))
            (let ($head $tail) $pair (- $head $tail)))
        (let ($head $tail) $pair (* $head $tail))))
(= (path-wrap $value) (Wrap $value))
(= (path-prebound $pair)
    (let $head path-wrap
        (if (== A A)
            (let ($head $tail) $pair $tail)
            (let ($head $tail) $pair (Other $tail)))))
(= (path-condition-bind $pair)
    (if (let $head path-wrap True)
        (let ($head $tail) $pair $tail)
        (let ($head $tail) $pair (Other $tail))))
(= (path-condition-choice $pair)
    (if (superpose (True False))
        (let ($head $tail) $pair (+ $head $tail))
        (let ($head $tail) $pair (- $head $tail))))
(= (path-operand-choice $pair)
    (if (== (superpose (A B)) A)
        (let ($head $tail) $pair (+ $head $tail))
        (let ($head $tail) $pair (- $head $tail))))
(= (path-output $flag $pair)
    (if (== $flag A)
        (let ($head $tail) $pair (Observed $head $tail))
        (let ($head $tail) $pair (Other $head $tail))))
(= (path-earlier-binding $pair)
    (if (== A A)
        (let* (($head path-wrap) (($head $tail) $pair)) $tail)
        (let ($head $tail) $pair $tail)))
(= (path-alias $pair)
    (let $alias $head
        (let $alias path-wrap
            (if (== A A)
                (let ($head $tail) $pair $tail)
                (let ($head $tail) $pair (Other $tail))))))

!(path-add A (10 3))
!(path-add B (10 3))
!(collapse (path-add $flag (10 3)))
!(path-nested A B (10 3))
!(path-nested A C (10 3))
!(path-nested C B (10 3))
!(collapse (path-nested $flag $other (10 3)))
!(path-prebound (Wrap 7))
!(path-condition-bind (Wrap 7))
!(sort-atom (collapse (path-condition-choice (10 3))))
!(sort-atom (collapse (path-operand-choice (10 3))))
!(let (Observed path-wrap 7) (path-output A (Wrap 7)) demanded)
!(path-output A (Wrap 7))
!(path-earlier-binding (Wrap 7))
!(path-alias (Wrap 7))
