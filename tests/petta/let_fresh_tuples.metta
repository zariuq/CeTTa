; Let patterns of fresh variables inside functions the compiled tier runs:
; decons-atom met by a pair of fresh variables, over expressions, lists,
; cons cells, an Error-headed expression, the empty expression and an atom;
; fresh tuples of other sizes; and patterns that are not fresh tuples
; (a repeated variable, a variable bound before the let, a rigid head).
(= (split $xs) (let ($h $t) (decons-atom $xs) (pair $h $t)))
(= (second $xs) (let ($h $t) (decons-atom $xs) (let ($g $u) (decons-atom $t) $g)))
(= (walk $xs) (if (== $xs ()) end (let ($h $t) (decons-atom $xs) (step $h (walk $t)))))
(= (triple $x) (let ($a $b $c) $x (out $c $b $a)))
(= (single $x) (let ($a) $x (got $a)))
(= (same-pair $x) (let ($a $a) $x (twin $a)))
(= (after $k $x) (let ($k $v) $x (keyed $v)))
(= (rigid $x) (let (kv $k $v) $x (kv $v $k)))
(= (cons-split $n) (let ($h $t) (decons-atom (cons-atom $n (cons-atom b ()))) (pair $h $t)))
(= (sum-list $xs) (if (== $xs ()) 0 (let ($h $t) (decons-atom $xs) (+ $h (sum-list $t)))))
!(split (a b c))
!(split (a))
!(split ((x y) z))
!(collapse (split ()))
!(split (Error x y))
!(second (a b c))
!(collapse (second (a)))
!(walk (1 2 3))
!(triple (p q r))
!(collapse (triple (p q)))
!(single (z))
!(same-pair (s s))
!(collapse (same-pair (s t)))
!(after k (k 5))
!(collapse (after k (j 5)))
!(rigid (kv 1 2))
!(collapse (rigid (vk 1 2)))
!(cons-split a)
!(sum-list (1 2 3 4))
