!(import! &self (library lib_transform))
(= (show $s) (sort-atom (collapse (match $s $a $a))))
(= (count-of $s $p) (size-atom (collapse (match $s $p x))))

; Petri net: each transition is stored as transform data; a step fires every transition
!(bind! &net (new-space))
!(add-atom &net (tok p1))
!(add-atom &net (tok p1))
!(add-atom &net (tok p2))
!(add-atom &net (trans t1 (, (take (tok p1)) (take (tok p2))) (, (tok p3))))
!(add-atom &net (trans t2 (take (tok p3)) (, (tok p4) (tok p2))))
(= (fire $net $srcs $outs) (transform $net $srcs $outs $net))
(= (petri-step $net) (transform $net (all (trans $t $srcs $outs)) (fired $t (fire $net $srcs $outs))))
!(petri-1 (sort-atom (collapse (petri-step &net))))
!(petri-2 (sort-atom (collapse (petri-step &net))))
!(petri-3 (sort-atom (collapse (petri-step &net))))
!(petri-4 (sort-atom (collapse (petri-step &net))))
!(petri-tokens (sort-atom (collapse (match &net (tok $p) $p))))

; Datalog closure over a 3-cycle: one new path per commit, guarded by absence
!(bind! &g (new-space))
!(add-atom &g (edge a b))
!(add-atom &g (edge b c))
!(add-atom &g (edge c a))
!(closure-base (transform &g (all (, (edge $x $y) (absent (path $x $y)))) (path $x $y) &g))
(= (closure $g)
   (case (collapse (transform $g (, (path $x $y) (edge $y $z) (absent (path $x $z))) (path $x $z) $g))
     ((() done) ($_ (closure $g)))))
!(closure-run (closure &g))
!(closure-count (count-of &g (path $x $y)))

; the same closure in rounds: a round's absence guards read the round's snapshot
!(bind! &g2 (new-space))
!(add-atom &g2 (edge a b))
!(add-atom &g2 (edge b c))
!(add-atom &g2 (edge c a))
!(round-0 (transform &g2 (all (, (edge $x $y) (absent (path $x $y)))) (path $x $y) &g2))
!(round-1 (transform &g2 (all (, (path $x $y) (edge $y $z) (absent (path $x $z)))) (path $x $z) &g2))
!(round-2 (transform &g2 (all (, (path $x $y) (edge $y $z) (absent (path $x $z)))) (path $x $z) &g2))
!(round-3 (transform &g2 (all (, (path $x $y) (edge $y $z) (absent (path $x $z)))) (path $x $z) &g2))
!(round-count (count-of &g2 (path $x $y)))

; rules as data: saturation fires every stored rule until none fires
!(bind! &rules (new-space))
!(bind! &kb (new-space))
!(add-atom &kb (parent tom bob))
!(add-atom &kb (parent bob ann))
!(add-atom &kb (parent ann jim))
!(add-atom &rules (rule anc1 (, (parent $x $y) (absent (anc $x $y))) (anc $x $y)))
!(add-atom &rules (rule anc2 (, (anc $x $y) (parent $y $z) (absent (anc $x $z))) (anc $x $z)))
(= (try-rule $kb $srcs $tmpl) (transform $kb $srcs $tmpl $kb))
(= (saturate $rules $kb)
   (case (collapse (transform $rules (all (rule $n $srcs $tmpl)) (try-rule &kb $srcs $tmpl)))
     ((() done) ($_ (saturate $rules $kb)))))
!(saturate-run (saturate &rules &kb))
!(ancestors (sort-atom (collapse (match &kb (anc $x $y) ($x $y)))))

; stratified negation: reachability saturates first, then absence reads the result
!(bind! &r (new-space))
!(add-atom &r (node a))
!(add-atom &r (node b))
!(add-atom &r (node c))
!(add-atom &r (node d))
!(add-atom &r (edge a b))
!(add-atom &r (edge b c))
!(add-atom &r (reach a))
(= (reach-all $r)
   (case (collapse (transform $r (, (reach $x) (edge $x $y) (absent (reach $y))) (reach $y) $r))
     ((() done) ($_ (reach-all $r)))))
!(reach (reach-all &r))
!(unreachable (transform &r (all (, (node $x) (absent (reach $x)))) (unreachable $x) &r))
!(unreachable-store (sort-atom (collapse (match &r (unreachable $x) $x))))

; MM2's exec as a library: take an exec atom, fire every match of its sources into its templates
!(bind! &mm (new-space))
!(add-atom &mm (edge a b))
!(add-atom &mm (edge b c))
!(add-atom &mm (exec 0 (, (edge $x $y) (edge $y $z)) (, (edge $x $z) (did-round))))
(= (mm2-fire $s $ps $ts) (transform $s (all $ps) $ts $s))
(= (mm2-step $s) (transform $s (take (exec $k $ps $ts)) (mm2-fire $s $ps $ts)))
!(exec (collapse (mm2-step &mm)))
!(exec-store (show &mm))
!(exec-again (collapse (mm2-step &mm)))
