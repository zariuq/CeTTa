; Foreign term transport retains callable identity, code and ordered captures.
(= (foreign-named $x $y) (+ $x $y))
(= (foreign-captured $n) (box (|-> ($x) (+ $n $x))))
!(collapse (let $_ (let $f (|-> ($x) (+ $x 1)) (translatePredicate (atom $f))) true))
!(collapse (let $_ (let $f (|-> ($x) (+ $x 1)) (translatePredicate (compound $f))) true))
!(collapse (let $_ (let $f (|-> ($x) (+ $x 1)) (translatePredicate (is_list $f))) true))
!(collapse (let $f (|-> ($x) (+ $x 1)) (let $_ (translatePredicate (= $g $f)) ($g 2))))
!(collapse (let $_ (let $f (|-> () 42) (translatePredicate (atom $f))) true))
!(collapse (let $f (|-> () 42) (let $_ (translatePredicate (= $g $f)) ($g))))
!(collapse (let $_ (let $f (foreign-named 1) (translatePredicate (compound $f))) true))
!(collapse (let $_ (let $f (foreign-named 1) (translatePredicate (is_list $f))) true))
!(collapse (let $f (foreign-named 1) (let $_ (translatePredicate (= $g $f)) ($g 2))))
!(collapse (let (box $f) (foreign-captured 2) (let $_ (translatePredicate (= $g $f)) ($g 3))))
!(collapse (let $_ (let $f (|-> ($x $y) (+ $x $y)) (let $g ($f 1) (translatePredicate (compound $g)))) true))
!(collapse (let $f (|-> ($x $y) (+ $x $y)) (let $g ($f 1) (let $_ (translatePredicate (= $h $g)) ($h 2)))))
!(collapse (let $_ (let $f (|-> ($x) (+ $x 1)) (translatePredicate (assertz (Predicate (foreignstored $f))))) true))
!(collapse (let $_ (translatePredicate (foreignstored $g)) ($g 2)))
!(collapse (let $_ (translatePredicate (is_list (quote (partial foreign-named (1))))) true))
!(collapse (let $_ (translatePredicate (is_list (quote (Lam Nat (idx 0))))) true))
; Copies freshen shared variables; unification preserves their shared identity.
(= (foreign-capture-var $n) (box (|-> ($x) (+ $n $x))))
(= (foreign-capture-pair $a $b) (box (|-> ($x) (values $a $b $x))))
!(collapse (let (box $f) (foreign-capture-var $n) (let $_ (translatePredicate (= $n 2)) (let $_ (translatePredicate (= $g $f)) ($g 3)))))
!(collapse (let (box $f) (foreign-capture-pair $n $n) (let $g (copy_term $f) (let $_ (translatePredicate (= $n 2)) (let (values $a $b 3) ($g 3) (and (== $a $b) (== (get-metatype $a) Variable)))))))
!(collapse (let (box $f) (foreign-capture-pair $n $n) (let $_ (translatePredicate (= $g $f)) (let $_ (translatePredicate (= $n 2)) ($g 3)))))
!(collapse (let (box $f) (foreign-capture-pair (quote (+ 1 2)) (quote (partial foreign-capture-var (3)))) (let $_ (translatePredicate (= $g $f)) ($g 4))))
!(collapse (let (box $f) (foreign-capture-var 2) (let $g (copy_term $f) (== $f $g))))
!(collapse (let $f (|-> () 42) (progn (add-atom &foreign-nullary (box $f)) (match &foreign-nullary (box $g) ($g)))))
!(collapse (let $f (|-> ($x $y) (+ $x $y)) (let $g ($f 1) (let $h (copy_term $g) ($h 2)))))
