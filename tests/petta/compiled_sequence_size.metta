; Completed arguments keep their effects and ordered occurrences. Structural
; size reads leave nested held calls and open cell coordinates unevaluated.
(= (sized-pack $x) (Data $x $local $local))
(= (sized-count $value) (size-atom $value))
(= (sized-apply $operation $value) ($operation $value))
(= (sized-effect) (progn (println! "size-before") (sized-pack 17)))
(= (sized-held) (progn (println! "unexpected-size-execution") 99))
(= (sized-loop $n $value)
   (if (> $n 0) (+ (sized-count $value) (sized-loop (- $n 1) $value)) 0))
!(sized-count (sized-pack 17))
!(sized-apply size-atom (sized-pack 18))
!(collapse (sized-count (superpose ((sized-pack 1) (sized-pack 2) (sized-pack 1)))))
!(sized-count (sized-effect))
!(sized-count (quote ((sized-held) $held $held)))
!(sized-loop 256 (sized-pack 29))
!(sort-atom (collapse (let $value (superpose ((a $x) (b $y $y)))
  (let $count (sized-count $value) (Count $count (== $value $value))))))
!(sized-count ())
!(sized-count symbol)
!(sized-count (quote (Lam ($x) (+ $x 1))))
