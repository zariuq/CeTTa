; A counter machine whose state head keeps a relation once it has counted
; facts of both shapes, its second column then a hole holding (REG k v) or
; (IC i): each step's matches read kept facts by that hole, and a match
; whose fact is the last its pattern may meet runs its body without a frame.
; The registers it halts with, sorted.
(program 0 (JZ 2 5))
(program 1 (DEC 2))
(program 2 (INC 3))
(program 3 (INC 1))
(program 4 (JZ 0 0))
(program 5 (JZ 1 9))
(program 6 (DEC 1))
(program 7 (INC 2))
(program 8 (JZ 0 5))
(program 9 H)
(state 0 (REG 0 0))
(state 0 (REG 1 0))
(state 0 (REG 2 120))
(state 0 (REG 3 0))
(state 0 (REG 4 0))
(state 0 (IC 0))
(= (run $ts)
   (match &self (, (state $ts (IC $i)) (program $i $ins)) (perform $ins $ts $i)))
(= (perform H $ts $i) $ts)
(= (perform (INC $r) $ts $i) (advance $ts (+ $i 1) $r 1))
(= (perform (DEC $r) $ts $i) (advance $ts (+ $i 1) $r -1))
(= (perform (JZ $r $j) $ts $i)
   (match &self (state $ts (REG $r $v))
      (if (== $v 0) (advance $ts $j $r 0) (advance $ts (+ $i 1) $r 0))))
(= (advance $ts $ni $r $delta)
   (let $n (+ $ts 1)
        (let $copied (collapse (copy-register $ts $n $r $delta))
             (let $set (add-atom &self (state $n (IC $ni)))
                  (run $n)))))
(= (copy-register $ts $n $r $delta)
   (match &self (state $ts (REG $k $v))
      (let $nv (if (== $k $r) (+ $v $delta) $v)
           (add-atom &self (state $n (REG $k $nv))))))
!(let $halt (run 0)
   (sort-atom (collapse (match &self (state $halt (REG $r $v)) (register $r $v)))))
