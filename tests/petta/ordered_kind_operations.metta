!(bind! &stk (new-space stack))
!(bind! &fifo (new-space queue))
!(bind! &ranked (new-space priority))
!(add-atom &stk bottom)
!(add-atom &stk top)
!(add-atom &fifo front)
!(add-atom &fifo back)
!(add-atom &ranked z)
!(add-atom &ranked a)
!(stack (space:stack:peek &stk) (space:stack:pop &stk))
!(queue (space:queue:peek &fifo) (space:queue:pop &fifo))
!(priority (space:priority:peek &ranked) (space:priority:pop &ranked))
; A wrong kind stays data and cannot mutate another kind's store.
!(wrong-kind (let $answer (space:queue:pop &stk) (get-metatype $answer)))
!(stack-left (collapse (get-atoms &stk)))
!(queue-left (collapse (get-atoms &fifo)))
!(priority-left (collapse (get-atoms &ranked)))
