!(bind! &value-log (new-space))
(: forward-held (-> Atom %Undefined%))
(= (forward-held $data) (receive-held $data))
(= (receive-held $data) (got $data))
(= (written-code) (receive-held (+ 1 2)))
(= (written-effect) (let $_written (add-atom &value-log real) written))
!(outside (forward-held (add-atom &value-log outside)))
!(inside (transaction (forward-held (add-atom &value-log inside))))
!(written (transaction (written-code)))
!(bound (transaction (let $n (+ 10 1) (forward-held $n))))
!(effect-result (transaction (written-effect)))
!(rollback (collapse (transaction
   (let $_held (forward-held (+ 3 4))
     (let $_written (add-atom &value-log rolled-back) (empty))))))
!(store (collapse (get-atoms &value-log)))
(= (return-lambda $held) (|-> ($unused) (receive-held $held)))
!(over-applied (transaction (return-lambda (quote (+ 1 2)) 0)))
(= (read-pair ($a $b)) (pair $a $b))
(= (forward-pair $p) (read-pair $p))
!(cells (let $cell (cons-atom 1 $tail)
   (let $tail (2) (transaction (forward-pair $cell)))))
(= (bind-output done) accepted)
!(bound-output (transaction (let $_ (bind-output $out) $out)))
(= (same-arg $x $x) equal)
!(same-positive (transaction (let $_ (same-arg $out (box z)) $out)))
!(occurs-negative (collapse (transaction (same-arg $out (box $out)))))
(= (fresh-result) (box $local))
!(fresh (let ((box $x) (box $y))
    (collapse (let $_ (superpose (1 2)) (transaction (fresh-result))))
    (pair (=alpha (box $x) (box $y)) (== (box $x) (box $y)))))
