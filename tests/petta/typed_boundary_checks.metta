; A typed call's argument that is itself a call of a function whose one
; signature checks its range at the argument's closed type needs no second
; check, and a call whose body ran in its trusted version has its range
; proved.  The answers are the protocol's.
(: f (-> Number Number))
(= (f $x) "s")
(: g (-> Number Number))
(= (g $y) $y)
!(collapse (g (f 1)))
(: two (-> Number Number))
(= (two $x) (superpose (1 2)))
!(collapse (g (two 0)))
(: hole (-> Number Number))
(= (hole $x) $y)
!(collapse (let $r (g (hole 0)) (is-var $r)))
(: List (-> Type Type))
(: Nil (List $a))
(: Cons (-> $a (List $a) (List $a)))
(: build (-> Number (List Number) (List Number)))
(= (build $n $acc) (if (== $n 0) $acc (build (- $n 1) (Cons $n $acc))))
(: sum (-> (List Number) Number))
(= (sum Nil) 0)
(= (sum (Cons $x $xs)) (+ $x (sum $xs)))
!(sum (build 30 Nil))
!(collapse (sum (build 3 (Cons "a" Nil))))
(: bad (-> Number (List Number)))
(= (bad $n) (Cons "x" Nil))
!(collapse (sum (bad 1)))
(: Nat Type)
(: Z Nat)
(: S (-> Nat Nat))
(: fromint (-> Number Nat))
(= (fromint $n) (if (== $n 0) Z (S (fromint (- $n 1)))))
(: toint (-> Nat Number))
(= (toint Z) 0)
(= (toint (S $k)) (+ 1 (toint $k)))
!(toint (fromint 25))
; At a formal whose variables no other position of its signature names, a
; callee's checked range that matches it one way types the argument too.
(: lenP (-> (List $a) Number))
(= (lenP Nil) 0)
(= (lenP (Cons $x $xs)) (+ 1 (lenP $xs)))
(: buildP (-> Number (List $a) (List $a)))
(= (buildP $n $acc) (if (== $n 0) $acc (buildP (- $n 1) (Cons $n $acc))))
!(lenP (buildP 25 Nil))
(: mkbad (-> Number (List $a)))
(= (mkbad $n) (Cons 1 (Cons "x" Nil)))
!(collapse (lenP (mkbad 1)))
(: pairP (-> (List $a) (List $a) Number))
(= (pairP $x $y) 1)
!(collapse (pairP (buildP 2 Nil) (Cons "s" Nil)))
(: Tree2 (-> Type Type))
(: Leaf2 (-> $a (Tree2 $a)))
(: mktree (-> Number (Tree2 Number)))
(= (mktree $n) (Leaf2 $n))
!(collapse (lenP (mktree 3)))
