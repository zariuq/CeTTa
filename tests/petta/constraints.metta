; PeTTa's CLP(FD) operators and the constraints they leave.  A constraint
; posted on unbound variables holds until they are bound, by a Prolog goal or
; by MeTTa: a binding wakes the constraints that wait on it, once each and in
; the order they were posted, and they may bind other variables or refuse the
; binding; a branch that backtracks takes its constraints with it; a
; collection runs its body under the constraints posted before it, and each
; answer it collects is a copy that takes the constraints on its variables
; along; a hyperpose branch runs under them too, and its answers bring back
; what they bind and delay.  Delayed constraints survive the machine's
; collections.  The answers and printed effects are SWI-PeTTa's.
(= (post $y) (let $t (#+ $y 1) (#< $t 5)))
!(#+ 3 4)
!(#- 10 3)
!(#* 6 7)
!(#div 17 5)
!(#// -17 5)
!(#mod -17 5)
!(#min 3 9)
!(#max 3 9)
!(#< 1 2)
!(#> 1 2)
!(#= 3 3)
!(#\= 3 3)
!(let (#+ $x 35) 42 $x)
!(let* (($r (#+ $x 35)) ($_ (= $r 42))) $x)
!(let* (($r (#* $x 2)) ($r 10)) $x)
!(let* (($r (#- $x 3)) ($x 10)) $r)
!(let* (($c (#< $x 3)) ($x 1)) $c)
!(let* (($c (#= $x 3)) ($x 3)) $c)
!(sort-atom (collapse (let* (($r (#+ $x 1)) ($x (superpose (1 2 3)))) $r)))
!(let* (($r (#+ $x $y)) ($x 1) ($y 2)) $r)
!(let* (($r (#+ $x $y)) ($r 5) ($x 2)) $y)
!(let* (($c (#< $x 3)) ($x 5)) $c)
!(let* (($c (#< $x 3)) ($x 1)) $c)
!(let* (($r1 (#+ $x $y)) ($r2 (#+ $y $z)) ($x 1) ($y 2) ($z 3)) ($r1 $r2))
!(let* (($r1 (#+ $x $y)) ($r2 (#+ $y $z)) ($r1 5) ($r2 7) ($x 1)) ($y $z))
!(let* (($r (#+ $x 1)) ($_ (translatePredicate (#< $r 3))) ($x 5)) no)
!(sort-atom (collapse (let* (($r (#+ $x 1)) ($x (superpose (1 2 3))) ($_ (translatePredicate (#< $r 4)))) $r)))
!(let* (($r (#+ $x 1)) ($_ (translatePredicate (#< $r 3))) ($x 1)) yes)
!(let* (($c (post $y)) ($y 2)) ($c $y))
!(let* (($c (post $y)) ($y 10)) ($c $y))
!(msort (collapse (hyperpose ((let* (($r (#+ $x 1)) ($x 2)) $r) (let* (($r (#+ $y 5)) ($y 1)) $r)))))
!(msort (collapse (let* (($r (#+ $x 10)) ($x (superpose (1 2 3)))) $r)))
!(msort (collapse (let $r (#+ $x 10) (let $x (superpose (1 2)) $r))))
!(let* (($r (#+ $x 10)) ($q (sort-atom (collapse (let $x (superpose (1 2)) $r))))) ($q $x))
!(once (let* (($r (#+ $x 1)) ($x (superpose (1 2)))) $r))
!(size-atom (collapse (let* (($r (#+ $x 1)) ($x (superpose (1 2 3))) ($_ (translatePredicate (#< $r 3)))) $r)))
!(let* (($r (#+ $x 10)) ($q (sort-atom (collapse (let $x (superpose (1 2)) $r)))) ($x 5)) ($q $r))
!(let* (($l (collapse (let $r (#+ $x 1) ($x $r)))) ((($a $b)) $l) ($b 5)) $a)
!(foldall + (let* (($r (#+ $x 1)) ($x (superpose (1 2)))) $r) 0)
!(let* (($r (#+ $x 10)) ($q (collapse (sort-atom (collapse (let $x (superpose (1 2)) $r)))))) $q)
!(let* (($r (#+ $x 10)) ($q (collapse (let $x 1 $r)))) ($q $r))
!(let* (($r (#+ $x 10)) ($v (hyperpose ((let $x 1 ok))))) ($v $r))
!(let* (($r (#+ $x 10)) ($v (hyperpose ((let $x 1 $r))))) ($v $r))
!(let* (($r (#+ $x 10)) ($v (hyperpose ((let $x 1 (== $r 11)))))) $v)
!(let* (($v (hyperpose ((#+ $x 1)))) ($x 5)) $v)
!(let* (($r (#+ $x 10)) ($v (hyperpose ((let $x 1 (if (== $r 11) yes no)))))) $v)
