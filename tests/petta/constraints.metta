; SWI-PeTTa's CLP(FD) operators, attributes and delayed goals.  A constraint
; posted on unbound variables holds until they are bound, by Prolog or by
; MeTTa: a binding wakes the goals that wait on it, once each and in the
; order they were posted, and they may bind other variables or refuse the
; binding; attributes persist on their variable across calls; a branch that
; backtracks takes its constraints with it; a collection runs its body under
; the constraints posted before it, and each answer it collects is a copy
; that takes the constraints on its variables along; a hyperpose branch runs
; under them too, and its answers bring back what they bind and delay.  Delayed goals survive
; the machine's collections.  The answers and printed effects are
; SWI-PeTTa's.
(= (post $y) (let $t (#+ $y 1) (#< $t 5)))
(= (spin $n) (if (> $n 0) (let $v (translatePredicate (succ $n $m)) (let $w ($v $m) (spin (- $n 1)))) done))
!(#+ 3 4)
!(#- 10 3)
!(#* 6 7)
!(#div 17 5)
!(#// -17 5)
!(#mod -17 5)
!(#min 3 9)
!(#max 3 9)
!(#< 1 2)
!(#> 1 2)
!(#= 3 3)
!(#\= 3 3)
!(let (#+ $x 35) 42 $x)
!(let* (($r (#+ $x 35)) ($_ (translatePredicate (= $r 42)))) $x)
!(let* (($r (#+ $x 35)) ($_ (= $r 42))) $x)
!(let* (($r (#* $x 2)) ($r 10)) $x)
!(let* (($r (#- $x 3)) ($x 10)) $r)
!(let* (($c (#< $x 3)) ($x 1)) $c)
!(let* (($c (#= $x 3)) ($x 3)) $c)
!(let* (($_ (translatePredicate (freeze $x (Predicate (writeln woke))))) ($x 1)) done)
!(let* (($_ (translatePredicate (dif $x 1))) ($x 1)) no)
!(let* (($_ (translatePredicate (dif $x 1))) ($x 2)) yes)
!(let* (($_ (translatePredicate (dif $x $y))) ($x $y)) no)
!(let* (($_ (translatePredicate (dif $x $y))) ($x a) ($y b)) yes)
!(let* (($_ (translatePredicate (freeze $x (Predicate (writeln one))))) ($_ (translatePredicate (freeze $x (Predicate (writeln two))))) ($x 1)) ok)
!(let* (($_ (translatePredicate (when (Predicate (nonvar $x)) (Predicate (writeln when-fired))))) ($x a)) ok)
!(collapse (let* (($_ (translatePredicate (dif $x 2))) ($x (superpose (1 2 3)))) $x))
!(collapse (let* (($r (#+ $x 1)) ($x (superpose (1 2 3)))) $r))
!(let* (($_ (translatePredicate (put_attr $x my 5))) ($_ (translatePredicate (get_attr $x my $v)))) $v)
!(let* (($_ (translatePredicate (put_attr $x my 5))) ($y $x) ($_ (translatePredicate (get_attr $y my $v)))) $v)
!(let* (($r (#+ $x $y)) ($x 1) ($y 2)) $r)
!(let* (($r (#+ $x $y)) ($r 5) ($x 2)) $y)
!(let* (($c (#< $x 3)) ($x 5)) $c)
!(let* (($c (#< $x 3)) ($x 1)) $c)
!(let* (($r1 (#+ $x $y)) ($r2 (#+ $y $z)) ($x 1) ($y 2) ($z 3)) ($r1 $r2))
!(let* (($r1 (#+ $x $y)) ($r2 (#+ $y $z)) ($r1 5) ($r2 7) ($x 1)) ($y $z))
!(let* (($r (#+ $x 1)) ($_ (translatePredicate (#< $r 3))) ($x 5)) no)
!(collapse (let* (($r (#+ $x 1)) ($x (superpose (1 2 3))) ($_ (translatePredicate (#< $r 4)))) $r))
!(let* (($_ (translatePredicate (freeze $x (Predicate fail)))) ($x 1)) no)
!(let $_ (translatePredicate (put_attr $x my 5)) (let $_ (translatePredicate (get_attr $x my $v)) $v))
!(let* (($_ (translatePredicate (freeze $x (Predicate (writeln woke))))) ($_ (println! before)) ($_ (translatePredicate (= $x 1)))) done)
!(let* (($_ (translatePredicate (dif $x 1))) ($r (translatePredicate (= $x 1)))) $r)
!(let* (($_ (translatePredicate (dif $x 1))) ($r (translatePredicate (= $x 2)))) $x)
!(let* (($_ (translatePredicate (when (Predicate (nonvar $x)) (Predicate (writeln when-fired))))) ($_ (translatePredicate (= $x a)))) ok)
!(let* (($r (#+ $x 1)) ($_ (translatePredicate (#< $r 3))) ($x 1)) yes)
!(let* (($c (post $y)) ($y 2)) ($c $y))
!(let* (($c (post $y)) ($y 10)) ($c $y))
!(msort (collapse (hyperpose ((let* (($r (#+ $x 1)) ($x 2)) $r) (let* (($r (#+ $y 5)) ($y 1)) $r)))))
!(msort (collapse (let* (($r (#+ $x 10)) ($x (superpose (1 2 3)))) $r)))
!(msort (collapse (let $r (#+ $x 10) (let $x (superpose (1 2)) $r))))
!(let* (($r (#+ $x 10)) ($q (collapse (let $x (superpose (1 2)) $r)))) ($q $x))
!(once (let* (($r (#+ $x 1)) ($x (superpose (1 2)))) $r))
!(size-atom (collapse (let* (($r (#+ $x 1)) ($x (superpose (1 2 3))) ($_ (translatePredicate (#< $r 3)))) $r)))
!(let* (($r (#+ $x 10)) ($q (collapse (let $x (superpose (1 2)) $r))) ($x 5)) ($q $r))
!(let* (($_ (translatePredicate (dif $x 2))) ($q (collapse (let $x (superpose (1 2 3)) $x)))) $q)
!(let* (($l (collapse (let $r (#+ $x 1) ($x $r)))) ((($a $b)) $l) ($b 5)) $a)
!(foldall + (let* (($r (#+ $x 1)) ($x (superpose (1 2)))) $r) 0)
!(let* (($r (#+ $x 10)) ($q (collapse (collapse (let $x (superpose (1 2)) $r))))) $q)
!(let* (($r (#+ $x 10)) ($q (collapse (let $x 1 $r)))) ($q $r))
!(let* (($_ (translatePredicate (freeze $x (Predicate (writeln inner-woke))))) ($q (collapse (let $x (superpose (1 2)) $x)))) $q)
!(let* (($c (post $y)) ($_ (spin 20000)) ($y 2)) ($c $y))
!(let* (($c (post $y)) ($_ (spin 20000)) ($y 10)) ($c $y))
!(collapse (let* (($c (post $y)) ($z (superpose (a b))) ($_ (spin 10000)) ($y 2)) ($z $y)))
!(collapse (let* (($c (post $y)) ($_ (spin 10000)) ($y (superpose (1 2 3 4 5)))) $y))
!(let* (($r (#+ $x 10)) ($q (collapse (let* (($_ (spin 5000)) ($x (superpose (1 2)))) $r))) ($_ (spin 5000)) ($x 5)) ($q $r))
!(let* (($r (#+ $x 10)) ($v (hyperpose ((let $x 1 ok))))) ($v $r))
!(let* (($r (#+ $x 10)) ($v (hyperpose ((let $x 1 $r))))) ($v $r))
!(let* (($_ (translatePredicate (dif $x 1))) ($v (collapse (hyperpose ((let $x 1 a) (let $x 2 b)))))) $v)
!(let* (($r (#+ $x 10)) ($v (hyperpose ((let $x 1 (== $r 11)))))) $v)
!(let* (($_ (translatePredicate (dif $x 1))) ($v (hyperpose ((let $x 1 a) (let $x 2 b))))) ($v $x))
!(let* (($v (hyperpose ((#+ $x 1)))) ($x 5)) $v)
!(let* (($v (hyperpose ((let $_ (translatePredicate (dif $y 2)) ok)))) ($y 2)) $v)
!(let* (($v (hyperpose ((let $_ (translatePredicate (dif $y 2)) ok)))) ($y 3)) ($v $y))
!(let* (($r (#+ $x 10)) ($v (hyperpose ((let $x 1 (if (== $r 11) yes no)))))) $v)
