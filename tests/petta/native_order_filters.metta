; Order comparisons of integers as filters beside equality, as LDBC's BI 12
; keeps its comments: each reads as one native query or keeps the ordinary
; path, and the answers are the same.
!(bind! &p (new-space set))
!(add-atom &p (cmt c1 u1 1309478400500 12 t))
!(add-atom &p (cmt c2 u1 1309478300000 5 t))
!(add-atom &p (cmt c3 u2 1309478400900 25 t))
!(add-atom &p (cmt c4 u3 1309478400100 3 f))
!(add-atom &p (cmt c5 u2 1309478400200 19 t))
(= (ok $d $n) (and (> $d 1309478400000) (< $n 20)))
!(bind! &q (new-space set))
!(size-atom (collapse (match &p (cmt $c $who $d $n $f) (if (and (== $f t) (ok $d $n)) (add-atom &q (q $who $c)) (empty)))))
!(sort-atom (collapse (match &q (q $who $c) ($who $c))))
; each order holding, and failing under not and or
!(bind! &r (new-space set))
!(add-atom &r (n 1))
!(add-atom &r (n 2))
!(add-atom &r (n 3))
!(add-atom &r (n 4))
!(add-atom &r (n 5))
!(bind! &s (new-space set))
!(size-atom (collapse (match &r (, (n $x) (n $y)) (if (<= $x $y) (add-atom &s (le $x $y)) (empty)))))
!(size-atom (collapse (match &r (n $x) (if (>= $x 3) (add-atom &s (ge $x)) (empty)))))
!(size-atom (collapse (match &r (n $x) (if (not (< 3 $x)) (add-atom &s (nlt $x)) (empty)))))
!(size-atom (collapse (match &r (n $x) (if (or (< $x 2) (> $x 4)) (empty) (add-atom &s (mid $x))))))
!(sort-atom (collapse (match &s (le $x $y) ($x $y))))
!(sort-atom (collapse (match &s (ge $x) $x)))
!(sort-atom (collapse (match &s (nlt $x) $x)))
!(sort-atom (collapse (match &s (mid $x) $x)))
; values that are not integers keep the ordinary path, which compares them
!(bind! &v (new-space set))
!(add-atom &v (w a 0.5))
!(add-atom &v (w b 5.5))
!(add-atom &v (w c 2))
!(add-atom &v (w d 4))
!(bind! &u (new-space set))
!(size-atom (collapse (match &v (w $k $x) (if (< $x 3) (add-atom &u (small $k)) (empty)))))
!(sort-atom (collapse (match &u (small $k) $k)))
; a value that is no number: the ordinary path raises, so the native path
; declines and the error is the ordinary path's
!(bind! &x (new-space set))
!(add-atom &x (w a 1))
!(add-atom &x (w e abc))
!(add-atom &x (w f 2))
!(bind! &z (new-space set))
!(catch (size-atom (collapse (match &x (w $k $y) (if (< $y 3) (add-atom &z (low $k)) (empty))))))
!(sort-atom (collapse (match &z (low $k) $k)))
