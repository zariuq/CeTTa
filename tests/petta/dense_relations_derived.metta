; Facts a query derives into a set, enough of them for the set to keep their
; relation as bits, read back every way a program reads a relation: counts
; of the facts with either column fixed or both free, a conjunction over the
; derived relation, adds and removals by the program, and a relation of
; three columns derived beside it, which stays rows.  Matches that list the
; facts come last, as does a number of another kind in a fixed column.
!(bind! &d (new-space set))
(= (edges $k $n)
   (if (>= $k $n) done
       (let* (($v1 (% (* $k 7) 400))
              ($v2 (% (+ (* $k 13) 5) 400))
              ($v3 (% (+ (* $k 31) 11) 400))
              ($v4 (% (+ (* $k 17) 3) 400))
              ($v5 (% (+ (* $k 3) 1) 400))
              ($a (add-atom &self (edge $k $v1)))
              ($b (add-atom &self (edge $k $v2)))
              ($c (add-atom &self (edge $k $v3)))
              ($e (add-atom &self (edge $k $v4)))
              ($f (add-atom &self (edge $k $v5)))
              ($k1 (+ $k 1)))
         (edges $k1 $n))))
!(edges 0 400)
(= (paths) (match &self (, (edge $x $y) (edge $y $z)) (add-atom &d (path2 $x $z))))
(= (triangles)
   (match &self (, (edge $x $y) (edge $y $z) (edge $x $z))
          (add-atom &d (tri $x $y $z))))
!(let $r (collapse (paths)) done)
!(let $r (collapse (triangles)) done)
!(size-atom (collapse (match &d (path2 $x $z) t)))
!(size-atom (collapse (match &d (tri $x $y $z) t)))
!(size-atom (collapse (match &d (path2 5 $z) t)))
!(size-atom (collapse (match &d (path2 $x 5) t)))
!(size-atom (collapse (match &d (path2 0 0) t)))
!(size-atom (collapse (match &d (, (path2 $x $y) (path2 $y $x)) t)))
!(remove-atom &d (path2 0 0))
!(size-atom (collapse (match &d (path2 0 0) t)))
!(add-atom &d (path2 1000 1001))
!(add-atom &d (path2 1000 1001))
!(size-atom (collapse (match &d (path2 $x $z) t)))
!(size-atom (collapse (match &d (path2 1000 $z) t)))
!(collapse (match &d (path2 5 $z) $z))
!(collapse (match &d (path2 $x 5) $x))
!(collapse (match &d (path2 1000 $z) $z))
!(size-atom (collapse (match &d (path2 5.0 $z) $z)))
