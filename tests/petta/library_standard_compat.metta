!(import! &self (library lib_he))
!(import! &self (library lib_spaces))
!(if-equal alpha alpha equal unequal)
!(bind! &probe (new-space))
!(add-atom &probe (row one))
!(add-atom &probe (row two))
!(match-count &probe (row $value))
!(bind! &from (new-space))
!(bind! &to (new-space))
!(add-atom &from (moved one))
!(add-atom &from (kept two))
!(migrateAtoms &from &to (moved $value))
!(collapse (match &to $atom $atom))
!(collapse (match &from $atom $atom))
