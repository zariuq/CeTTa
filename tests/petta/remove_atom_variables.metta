; A removal unifies: removing (p a) takes a stored (p $x) too, and a
; removal with a variable takes every fact it meets, in the rows, as
; open facts, or in the relation a head keeps past its threshold, as
; stable-fixed SWI-PeTTa removes them.
(p $x)
(p a)
(p b)
!(remove-atom &self (p a))
!(collapse (match &self (p $y) $y))
(q a)
(q b)
!(remove-atom &self (q $z))
!(collapse (match &self (q $w) $w))
(r 1)
(r $v)
!(remove-atom &self (r $u))
!(collapse (match &self (r $s) $s))
