!(callPredicate (Predicate (quote (consult "tests/petta/fixtures/late_foreign_continuation.pl"))))
(= (rejected_effect) (progn (println! forbidden_operand_replay) effect_result))
(= (rejected_keep_item $item $acc) $item)
(= (rejected_fold_ready $x)
  (let $items (quote ((rejected_effect)))
    (let $initial (quote (rejected_effect))
      (progn (import_prolog_function cold_watch)
        (let $f cold_watch
          (let $u ($f $x)
            (let $folded (foldl rejected_keep_item $items $initial)
              (let $x 2 (Answer $folded)))))))))
!(collapse (rejected_fold_ready $x))
(= (rejected_fold_bind $item $acc) (let $acc $item $acc))
(= (rejected_fold_watch $x)
  (progn (import_prolog_function cold_watch)
    (let $f cold_watch (let $u ($f $x) (foldl rejected_fold_bind (2) $x)))))
!(collapse (rejected_fold_watch $x))
(= (rejected_head_watch $x)
  (progn (import_prolog_function cold_watch)
    (let $f cold_watch ($f $x))))
(= (rejected_head_bind $x) (let $x 2 bound))
(= (rejected_head_probe (rejected_head_watch $x) (rejected_head_bind $x)) (Answer $x))
!(collapse (rejected_head_probe true bound))
