; Maintained derived spaces (lib/petta/lib_support.metta): a view keeps its base
; facts and what exec directives derive from them; a derived atom stays exactly
; while it has a well-founded derivation from the current base facts.
!(import! &self (library lib_support))
!(import! &self (library lib_exec))
(= (show $s $p) (sort-atom (collapse (match $s $p $p))))

; Role-based access control: users are assigned roles, roles inherit roles,
; roles grant permissions.  admins and staff inherit each other (a cycle).
(= (rbac)
   ((exec assignment (, (assigned $u $r)) (, (has-role $u $r)))
    (exec inherit (, (has-role $u $r) (inherits $r $q)) (, (has-role $u $q)))
    (exec grant (, (has-role $u $r) (grants $r $p)) (, (can $u $p)))))
!(bind! &acl (new-space))
!(add-atom &acl (assigned alice admins))
!(add-atom &acl (assigned bob staff))
!(add-atom &acl (inherits admins staff))
!(add-atom &acl (inherits staff admins))
!(add-atom &acl (grants staff read-logs))
!(add-atom &acl (grants admins rotate-keys))
!(let* (($h (support:open &acl (rbac)))
        ($before (show &acl (can $u $p)))
        ($why (support:why $h (can alice rotate-keys)))
        ; alice's roles rest on each other round the cycle and on her
        ; assignment: revoking it removes every derived fact about her
        ((removed $gone) (support:retract $h (assigned alice admins)))
        ($after (show &acl (can $u $p)))
        ($bob (support:why $h (has-role bob admins)))
        ($none (support:why $h (can alice read-logs)))
        ((added $back) (support:assert $h (assigned alice admins)))
        ($again (show &acl (can $u $p))))
   ((before $before) (why $why) (removed (sort-atom $gone)) (after $after)
    (bob $bob) (none $none) (added (sort-atom $back)) (again $again)))
; a base fact that is also derived stays when retracted as a base fact
!(bind! &d (new-space))
!(add-atom &d (edge a b))
!(add-atom &d (edge b c))
!(add-atom &d (path a c))
(= (paths) ((exec one (, (edge $x $y)) (, (path $x $y)))
            (exec two (, (path $x $y) (edge $y $z)) (, (path $x $z)))))
!(let* (($h (support:open &d (paths)))
        ((removed $gone) (support:retract $h (path a c)))
        ($why (support:why $h (path a c))))
   ((removed $gone) (still (show &d (path $x $y))) (why $why)))

; Reachability over a ring of six routers with a stub router on a one-link
; spur: a ring link failing changes no reachability, the spur link failing cuts
; the stub off, and restoring it restores the routes.
(= (routing) ((exec hop (, (link $x $y)) (, (reach $x $y)))
              (exec step (, (reach $x $y) (link $y $z)) (, (reach $x $z)))))
!(bind! &net (new-space))
!(add-atom &net (link r1 r2)) !(add-atom &net (link r2 r1))
!(add-atom &net (link r2 r3)) !(add-atom &net (link r3 r2))
!(add-atom &net (link r3 r4)) !(add-atom &net (link r4 r3))
!(add-atom &net (link r4 r5)) !(add-atom &net (link r5 r4))
!(add-atom &net (link r5 r6)) !(add-atom &net (link r6 r5))
!(add-atom &net (link r6 r1)) !(add-atom &net (link r1 r6))
!(add-atom &net (link r3 stub)) !(add-atom &net (link stub r3))
(= (route-count) (size-atom (show &net (reach $x $y))))
(= (fresh $failed)
   (let* (($s (new-space))
          ($_a (collapse (match &net (link $x $y)
                   (if (is-alpha-member (link $x $y) $failed) () (add-atom $s (link $x $y))))))
          ($ds (routing))
          ($_r (exec:saturate $s $ds)))
     (sort-atom (collapse (match $s (reach $x $y) (reach $x $y))))))
!(let* (($h (support:open &net (routing)))
        ($all (route-count))
        ((removed $r1) (support:retract $h (link r1 r2)))
        ((removed $r2) (support:retract $h (link r2 r1)))
        ($ring (route-count))
        ($ok1 (== (show &net (reach $x $y)) (fresh ((link r1 r2) (link r2 r1)))))
        ((removed $s1) (support:retract $h (link r3 stub)))
        ((removed $s2) (support:retract $h (link stub r3)))
        ($cut (route-count))
        ($ok2 (== (show &net (reach $x $y)) (fresh ((link r1 r2) (link r2 r1) (link r3 stub) (link stub r3)))))
        ((added $a1) (support:assert $h (link r3 stub)))
        ((added $a2) (support:assert $h (link stub r3)))
        ($ok3 (== (show &net (reach $x $y)) (fresh ((link r1 r2) (link r2 r1))))))
   ((routes $all) (ring-link (size-atom $r1) (size-atom $r2) $ring $ok1)
    (spur-link (size-atom $s1) (size-atom $s2) $cut $ok2)
    (restored (size-atom $a1) (size-atom $a2) (route-count) $ok3)))
