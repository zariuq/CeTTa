; A list built with cons is the list it spells.  Flat patterns in equation
; heads, let and case patterns, and equality meet it element by element, as
; SWI-PeTTa's Prolog lists do; a PeTTa form written as a call argument is a
; call, and a quoted one stays data.
(= (f ($a $b $c)) $a)
(= (e3 (1 2 3)) yes)
(= (f2 ($a $b)) $a)
(= (f4 ($a $b $c $d)) $a)
(= (k3 (q ($a $b $c))) $a)
(= (sum3 ($a $b $c)) (+ $a (+ $b $c)))
(= (tl (cons $h $t)) $t)
(= (len ()) 0)
(= (len (cons $h $t)) (+ 1 (len $t)))
(= (pairs (($a $b) $rest)) $a)
(= (both ($a $b) ($c $d)) ($a $c))
(= (swap ($a $b)) ($b $a))
(= (mem $x (cons $x $t)) true)
(= (mem $x (cons $h $t)) (mem $x $t))
!(f (cons 1 (2 3)))
!(e3 (cons 1 (2 3)))
!(f2 (cons 1 (2)))
!(f4 (cons 1 (2 3 4)))
!(k3 (q (cons 1 (2 3))))
!(let ($a $b $c) (cons 1 (2 3)) $a)
!(== (cons 1 (2 3)) (1 2 3))
!(let $l (cons 1 (cons 2 (3))) (sum3 $l))
!(let $l (cons 0 (1 2)) (f $l))
!(f (tl (0 1 2 3)))
!(e3 (tl (0 1 2 3)))
!(f (cons 1 ()))
!(len (cons 1 (cons 2 ())))
!(let (cons $h $t) (1 2 3) ($h $t))
!(pairs (cons (cons 1 (2)) ((3 4))))
!(let $l (cons 1 $t) (f2 $l))
!(let $l (cons 1 $t) (f $l))
!(both (cons 1 (2)) (cons 3 (4)))
!(swap (cons 1 (2)))
!(once (mem 2 (cons 1 $t)))
!(case (cons 1 (2)) ((($a $b) $a)))
!(let $l (cons 1 $t) (case $l ((($a $b) $a))))
!(unique (superpose ((cons 1 (2)) (1 2))))
!(f (append (1) (2 3)))
!(f (msort (3 1 2)))
!(f2 (length (1 2 3)))
!(f4 (foldl + 0 (1 2 3)))
!(f (#+ 1 2))
!(f2 (is-expr (1 2)))
!(f (union (1 2) (3)))
!(foo (cons 1 (2 3)))
!(f (quote (cons 1 (2 3))))

; A prepared map may retain private cons spines between consumers. Indexed
; and length observations read logical elements, not the carrier's fields.
(= (carrier-rows $xs)
   (map-atom $xs $row
     (let ($ordinal (CarrierFields $value)) $row
       (cons-atom $ordinal (cons-atom $value ())))))
(= (carrier-observe $index)
   (let $rows (carrier-rows ((0 (CarrierFields 9)) (1 (CarrierFields 9))))
     (map-atom $rows $row (index-atom $row $index))))
!(carrier-observe 0)
!(carrier-observe 1)
!(let $rows (carrier-rows ((0 (CarrierFields 9)) (1 (CarrierFields 9))))
   (map-atom $rows $row (size-atom $row)))
!(collapse (carrier-observe 2))
!(collapse (carrier-observe -1))
!(collapse (carrier-observe 1.0))

; A lexical collection body reads a captured expression as its value, even
; when the expression's spelling names a callable builtin.
!(let $held (quote (+ 1 2)) (map-atom (a b) $x $held))
!(let $held (quote (== 1 1)) (filter-atom (a b) $x $held))

!(import! &self (library list))
!(let $spine (cons-atom (quote (+ 1 2)) (cons-atom kept ()))
   (Converted (tuple:from $spine)
     (get-metatype (list:from $spine))
     (tuple:from (list:from $spine))))
