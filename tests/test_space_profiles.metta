; A space is made strict or full.  A strict space keeps only what its kind
; needs and reads its rows for a general match; a full one keeps the general
; indexes too.  Stacks and queues are strict unless made full, the other
; kinds full unless made strict.  Every operation answers alike in both,
; in the same order where the kind keeps one.

(= (fill $space $k $n)
   (if (>= $k $n)
       ()
       (let $p (% $k 2)
            (let $_ (add-atom $space (item $k (parity $p)))
                 (fill $space (+ $k 1) $n)))))

(= (drain $space)
   (if (== (space-len $space) 0)
       ()
       (let $top (space-pop $space)
            (let $rest (drain $space) (cons-atom $top $rest)))))

!(bind! &stack (new-space stack))
!(bind! &stack-full (new-space stack full))
!(bind! &queue (new-space queue strict))
!(bind! &queue-full (new-space queue full))
!(bind! &bag (new-space atom strict))
!(bind! &bag-full (new-space atom full))
!(bind! &set (new-space set strict))

!(fill &stack 0 40)
!(fill &stack-full 0 40)
!(fill &queue 0 40)
!(fill &queue-full 0 40)
!(fill &bag 0 40)
!(fill &bag-full 0 40)
!(fill &set 0 40)
!(fill &set 0 40)

!(assertEqual (get-type &stack) (get-type &stack-full))
!(assertEqual (space-len &stack) (space-len &stack-full))
!(assertEqual (space-peek &stack) (space-peek &stack-full))
!(assertEqual (space-get &stack 7) (space-get &stack-full 7))
!(assertEqual (collapse (match &stack (item $k (parity 0)) $k))
              (collapse (match &stack-full (item $k (parity 0)) $k)))
!(assertEqual (collapse (match &stack (item 25 $p) $p))
              (collapse (match &stack-full (item 25 $p) $p)))
!(assertEqual (collapse (match &stack (item 26 (parity 0)) found))
              (collapse (match &stack-full (item 26 (parity 0)) found)))
!(assertEqual (collapse (match &stack $row $row))
              (collapse (match &stack-full $row $row)))
!(remove-atom &stack (item 13 (parity 1)))
!(remove-atom &stack-full (item 13 (parity 1)))
!(assertEqual (collapse (get-atoms &stack)) (collapse (get-atoms &stack-full)))
!(assertEqual (drain &stack) (drain &stack-full))

!(assertEqual (get-type &queue) (get-type &queue-full))
!(assertEqual (collapse (match &queue (item $k (parity 1)) $k))
              (collapse (match &queue-full (item $k (parity 1)) $k)))
!(remove-atom &queue (item 0 (parity 0)))
!(remove-atom &queue-full (item 0 (parity 0)))
!(assertEqual (space-peek &queue) (space-peek &queue-full))
!(assertEqual (drain &queue) (drain &queue-full))

!(assertEqual (space-len &bag) (space-len &bag-full))
!(assertEqual (collapse (match &bag (item 31 $p) $p))
              (collapse (match &bag-full (item 31 $p) $p)))
!(remove-atom &bag (item 31 (parity 1)))
!(remove-atom &bag-full (item 31 (parity 1)))
!(assertEqual (collapse (match &bag (item 31 $p) $p))
              (collapse (match &bag-full (item 31 $p) $p)))
!(assertEqual (space-len &set) 40)
!(assertEqual (collapse (match &set (item 39 $p) $p)) ((parity 1)))

!(assertEqualToResult (new-space stack sideways)
   ((Error (new-space stack sideways) UnknownSpaceProfile)))
!(assertEqualToResult (new-space native strict)
   ((Error (new-space native strict) UnknownSpaceProfile)))
