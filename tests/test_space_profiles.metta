; A space is made strict or full.  A strict space keeps only what its kind
; needs and reads its rows for a general match; a full one keeps the general
; indexes too.  Stacks, queues and priority spaces are strict unless made
; full, the other kinds full unless made strict.  Every operation answers
; alike in both: a read answers the same bag (compared here sorted, since no
; kind promises the order of answers), and a stack, a queue and a priority
; space show their order through their own operations, peek, pop, get and
; truncate; a priority space's order is that of its atoms, whichever way
; they arrived.

(= (fill $space $k $n)
   (if (>= $k $n)
       ()
       (let $p (% $k 2)
            (let $_ (add-atom $space (item $k (parity $p)))
                 (fill $space (+ $k 1) $n)))))

(= (drain $pop $space)
   (if (== (space-len $space) 0)
       ()
       (let $top ($pop $space)
            (let $rest (drain $pop $space) (cons-atom $top $rest)))))

!(bind! &stack (new-space stack))
!(bind! &stack-full (new-space stack full))
!(bind! &queue (new-space queue strict))
!(bind! &queue-full (new-space queue full))
!(bind! &bag (new-space atom strict))
!(bind! &bag-full (new-space atom full))
!(bind! &set (new-space set strict))

!(fill &stack 0 40)
!(fill &stack-full 0 40)
!(fill &queue 0 40)
!(fill &queue-full 0 40)
!(fill &bag 0 40)
!(fill &bag-full 0 40)
!(fill &set 0 40)
!(fill &set 0 40)

!(assertEqual (get-type &stack) (get-type &stack-full))
!(assertEqual (space-len &stack) (space-len &stack-full))
!(assertEqual (space:stack:peek &stack) (space:stack:peek &stack-full))
!(assertEqual (space:stack:get &stack 7) (space:stack:get &stack-full 7))
!(assertEqual (let $answers (collapse (match &stack (item $k (parity 0)) $k)) (sort-atom $answers))
              (let $others (collapse (match &stack-full (item $k (parity 0)) $k)) (sort-atom $others)))
!(assertEqual (let $answers (collapse (match &stack (item 25 $p) $p)) (sort-atom $answers))
              (let $others (collapse (match &stack-full (item 25 $p) $p)) (sort-atom $others)))
!(assertEqual (let $answers (collapse (match &stack (item 26 (parity 0)) found)) (sort-atom $answers))
              (let $others (collapse (match &stack-full (item 26 (parity 0)) found)) (sort-atom $others)))
!(assertEqual (let $answers (collapse (match &stack $row $row)) (sort-atom $answers))
              (let $others (collapse (match &stack-full $row $row)) (sort-atom $others)))
!(remove-atom &stack (item 13 (parity 1)))
!(remove-atom &stack-full (item 13 (parity 1)))
!(assertEqual (let $answers (collapse (get-atoms &stack)) (sort-atom $answers))
              (let $others (collapse (get-atoms &stack-full)) (sort-atom $others)))
!(assertEqual (drain space:stack:pop &stack) (drain space:stack:pop &stack-full))

!(assertEqual (get-type &queue) (get-type &queue-full))
!(assertEqual (let $answers (collapse (match &queue (item $k (parity 1)) $k)) (sort-atom $answers))
              (let $others (collapse (match &queue-full (item $k (parity 1)) $k)) (sort-atom $others)))
!(remove-atom &queue (item 0 (parity 0)))
!(remove-atom &queue-full (item 0 (parity 0)))
!(assertEqual (space:queue:peek &queue) (space:queue:peek &queue-full))
!(assertEqual (drain space:queue:pop &queue) (drain space:queue:pop &queue-full))

!(assertEqual (space-len &bag) (space-len &bag-full))
!(assertEqual (let $answers (collapse (match &bag (item 31 $p) $p)) (sort-atom $answers))
              (let $others (collapse (match &bag-full (item 31 $p) $p)) (sort-atom $others)))
!(remove-atom &bag (item 31 (parity 1)))
!(remove-atom &bag-full (item 31 (parity 1)))
!(assertEqual (let $answers (collapse (match &bag (item 31 $p) $p)) (sort-atom $answers))
              (let $others (collapse (match &bag-full (item 31 $p) $p)) (sort-atom $others)))
!(assertEqual (space-len &set) 40)
!(assertEqual (let $answers (collapse (match &set (item 39 $p) $p)) (sort-atom $answers))
              (sort-atom ((parity 1))))

!(bind! &prio (new-space priority))
!(bind! &prio-full (new-space priority full))
!(bind! &prio-down (new-space priority))
(= (fill-down $space $k)
   (if (< $k 0)
       ()
       (let $p (% $k 2)
            (let $_ (add-atom $space (item $k (parity $p)))
                 (fill-down $space (- $k 1))))))
!(fill &prio 0 40)
!(fill &prio-full 0 40)
!(fill-down &prio-down 39)
!(assertEqual (get-type &prio) (get-type &prio-full))
!(assertEqual (space-len &prio) (space-len &prio-full))
!(assertEqual (space:priority:peek &prio) (space:priority:peek &prio-full))
!(assertEqual (space:priority:peek &prio) (item 0 (parity 0)))
!(assertEqual (space:priority:get &prio 7) (space:priority:get &prio-full 7))
!(assertEqual (let $answers (collapse (match &prio (item $k (parity 1)) $k)) (sort-atom $answers))
              (let $others (collapse (match &prio-full (item $k (parity 1)) $k)) (sort-atom $others)))
!(assertEqual (let $answers (collapse (match &prio (item 26 (parity 0)) found)) (sort-atom $answers))
              (let $others (collapse (match &prio-full (item 26 (parity 0)) found)) (sort-atom $others)))
!(assertEqual (let $answers (collapse (match &prio $row $row)) (sort-atom $answers))
              (let $others (collapse (match &prio-full $row $row)) (sort-atom $others)))
!(assertEqual (let $answers (collapse (match &prio $row $row)) (sort-atom $answers))
              (let $others (collapse (match &prio-down $row $row)) (sort-atom $others)))
!(remove-atom &prio (item 13 (parity 1)))
!(remove-atom &prio-full (item 13 (parity 1)))
!(remove-atom &prio-down (item 13 (parity 1)))
!(assertEqual (let $answers (collapse (get-atoms &prio)) (sort-atom $answers))
              (let $others (collapse (get-atoms &prio-full)) (sort-atom $others)))
!(assertEqual (space:priority:get &prio 13) (item 14 (parity 0)))
!(assertEqual (drain space:priority:pop &prio-down) (drain space:priority:pop &prio-full))
!(assertEqual (space:priority:pop &prio) (item 0 (parity 0)))
!(assertEqual (space:priority:truncate &prio 3) ())
!(assertEqual (let $answers (collapse (get-atoms &prio)) (sort-atom $answers))
              (sort-atom ((item 1 (parity 1)) (item 2 (parity 0)) (item 3 (parity 1)))))

!(assertEqualToResult (new-space stack sideways)
   ((Error (new-space stack sideways) UnknownSpaceProfile)))
!(assertEqualToResult (new-space native strict)
   ((Error (new-space native strict) UnknownSpaceProfile)))
