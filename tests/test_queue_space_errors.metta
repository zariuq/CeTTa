!(bind! &q (new-space queue))
!(assertEqualToResult (space:queue:pop &q) ((Error (space:queue:pop &q) EmptyQueueSpace)))
!(assertEqualToResult (space:queue:peek &q) ((Error (space:queue:peek &q) EmptyQueueSpace)))
!(assertEqualToResult (space:queue:get &q 0) ((Error (space:queue:get &q 0) IndexOutOfBounds)))
!(assertEqualToResult (space:queue:truncate &q 1) ((Error (space:queue:truncate &q 1) IndexOutOfBounds)))
!(assertEqualToResult (space:queue:get &q nope) ((Error (space:queue:get &q nope) ExpectedNonNegativeIndex)))
