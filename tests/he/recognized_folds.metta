; Folds the prepared machine recognizes from their two equations, and the
; arguments where it must leave them to the equations: other ends, other
; cells, fields that are not machine integers, steps that leave them.
(= (sum Nil) 0)
(= (sum (Cons $x $xs)) (+ $x (sum $xs)))
(= (rsum Nil) 7)
(= (rsum (Cons $x $xs)) (+ (rsum $xs) $x))
(= (prod Nil) 1)
(= (prod (Cons $x $xs)) (* $x (prod $xs)))
(= (len Nil) 0)
(= (len (Cons $x $xs)) (+ 1 (len $xs)))
(= (dbl Nil) 0)
(= (dbl (Cons $x $xs)) (* 2 (dbl $xs)))
(= (tsum E) 0)
(= (tsum (N $a $rest $b)) (+ $b (tsum $rest)))
(= (toint Z) 0)
(= (toint (S $k)) (+ 1 (toint $k)))
