;; A stored row met twice in one derivation is renamed apart for each use.
;; The indexed space &s answers its reads from cold scans, then its match
;; trie, then its substitution tree; the strict space &t reads its rows in
;; turn and is the reference.  Each answer is (answers-of-&s answers-of-&t
;; same-bag), over the metatypes of $c; the bags are sorted before they are
;; compared, since no space promises an order of answers.
!(bind! &s (new-space))
!(bind! &t (new-space atom strict))
!(add-atom &s (pad 0))
!(add-atom &t (pad 0))
!(add-atom &s (pad 1))
!(add-atom &t (pad 1))
!(add-atom &s (pad 2))
!(add-atom &t (pad 2))
!(add-atom &s (pad 3))
!(add-atom &t (pad 3))
!(add-atom &s (pad 4))
!(add-atom &t (pad 4))
!(add-atom &s (pad 5))
!(add-atom &t (pad 5))
!(add-atom &s (pad 6))
!(add-atom &t (pad 6))
!(add-atom &s (pad 7))
!(add-atom &t (pad 7))
!(add-atom &s (pad 8))
!(add-atom &t (pad 8))
!(add-atom &s (pad 9))
!(add-atom &t (pad 9))
!(add-atom &s (pad 10))
!(add-atom &t (pad 10))
!(add-atom &s (pad 11))
!(add-atom &t (pad 11))
!(add-atom &s (zr kd kd))
!(add-atom &t (zr kd kd))
!(add-atom &s (zr $y kd))
!(add-atom &t (zr $y kd))
!(add-atom &s (zr $z $y))
!(add-atom &t (zr $z $y))
!(add-atom &s (zr $y $x))
!(add-atom &t (zr $y $x))
!(add-atom &s (zr $z kd))
!(add-atom &t (zr $z kd))
!(add-atom &s (zr (fz $y) $z))
!(add-atom &t (zr (fz $y) $z))
!(add-atom &s (zr kd $w))
!(add-atom &t (zr kd $w))
;; Reads that take &s past its cold scans and its match trie.
!(w 0 (collapse (match &s (zr kd kd) yes)))
!(w 1 (collapse (match &s (zr kd kd) yes)))
!(w 2 (collapse (match &s (zr kd kd) yes)))
!(w 3 (collapse (match &s (zr kd kd) yes)))
!(w 4 (collapse (match &s (zr kd kd) yes)))
!(w 5 (collapse (match &s (zr kd kd) yes)))
!(w 6 (collapse (match &s (zr kd kd) yes)))
!(w 7 (collapse (match &s (zr kd kd) yes)))
;; (zr ka kb) meets (zr $z $y) and (zr $y $x); (zr (fz $c) $c) meets each again:
;; 2 x 5 answers, $c a variable in 6 of them.
!(r 1 (let* (($p (collapse (match &s (, (zr ka kb) (zr (fz $c) $c)) (get-metatype $c))))
              ($q (collapse (match &t (, (zr ka kb) (zr (fz $c) $c)) (get-metatype $c))))
              ($sp (sort-atom $p))
              ($sq (sort-atom $q)))
   ((size-atom $p) (size-atom $q) (== $sp $sq))))
;; The first conjunct binds the variables of (zr (fz $y) $z); the last conjunct
;; meets that row again, renamed apart: 5 x 6 x 5 answers, $c never an expression.
!(r 2 (let* (($p (collapse (match &s (, (zr (fz (gz ka kc)) kd) (zr kd $b) (zr (fz $c) $c)) (get-metatype $c))))
              ($q (collapse (match &t (, (zr (fz (gz ka kc)) kd) (zr kd $b) (zr (fz $c) $c)) (get-metatype $c))))
              ($sp (sort-atom $p))
              ($sq (sort-atom $q)))
   ((size-atom $p) (size-atom $q) (== $sp $sq))))
;; The same rows read one conjunct at a time by nested matches.
!(r 3 (let* (($p (collapse (match &s (zr ka kb) (match &s (zr (fz $c) $c) (get-metatype $c)))))
              ($q (collapse (match &t (zr ka kb) (match &t (zr (fz $c) $c) (get-metatype $c)))))
              ($sp (sort-atom $p))
              ($sq (sort-atom $q)))
   ((size-atom $p) (size-atom $q) (== $sp $sq))))
