; HE types == as (-> $t $t Bool): two values of different classes are an
; argument type error, also inside a function body that a machine runs
; natively; two values of one class compare.  The answers are Rust HE's.
(: Pair (-> Number String P))
(: sa String)
(= (e1) (== 1 "a"))
(= (e2) (== True 1))
(= (e3 $x) (if (== $x True) yes no))
(= (e4 $x $y) (== $x $y))
(= (e5 $x) (== $x 2.0))
(= (e6) (== "a" "a"))
(= (e7 $x) (if (== $x 1) one other))
(= (e8 $n) (if (== $n 0) 0 (e8 (- $n 1))))
(= (e9) (== x 1))
(= (e10) (== sa 1))
!(collapse (e1))
!(collapse (e2))
!(collapse (e3 True))
!(collapse (e4 1 "b"))
!(collapse (e4 2 2.0))
!(collapse (e5 2))
!(collapse (e6))
!(collapse (e7 1))
!(collapse (e8 3))
!(collapse (e4 (Pair 1 "a") (Pair 1 "a")))
!(collapse (e9))
!(collapse (e10))
