; Formals sharing a variable are checked jointly.
(: List (-> Type Type))
(: Nil (List $a))
(: Cons (-> $a (List $a) (List $a)))
(: SL (List String))
(: NL (List Number))
(: h (-> (List $t) (List $t) Number))
(= (h $a $b) 1)
(: f (-> (List $t) (List $t) (List $t)))
(= (f $a $b) $a)
(: u (-> Number %Undefined%))
(= (u $n) (f SL NL))
!(u 1)
