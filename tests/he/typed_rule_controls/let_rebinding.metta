; A variable a let bound stays bound for the rest of the body: a later let
; of it compares; a let in another branch binds it afresh.
(= (t7 $b) (+ (let $x 1 $x) (let $x $b $x)))
!(collapse (t7 1))
!(collapse (t7 2))
(= (t4) (+ (let $x 1 $x) (let $x 2 $x)))
!(collapse (t4))
(= (t3 $a) (let $x $a (let $y $x (let $x 5 (+ $y 1)))))
!(collapse (t3 5))
!(collapse (t3 6))
(= (t5) (+ (let $x 1 $x) $x))
!(t5)
(= (t6) (Pair (let $x 1 $x) $x))
!(t6)
(= (s $y) (let $y 3 $y))
!(collapse (s 4))
!(collapse (s 3))
(= (br $c) (if $c (let $x 1 (+ $x 10)) (let $x 2 (+ $x 20))))
!(br True)
!(br False)
(= (br2 $c $b) (+ (if $c (let $x 1 $x) (let $x 2 $x)) (let $x $b $x)))
!(collapse (br2 True 1))
!(collapse (br2 True 2))
!(collapse (br2 False 2))
(= (sel $v) (case $v (((A $y) (+ $y 1)) ((B $y) (+ $y 2)))))
!(sel (A 1))
!(sel (B 1))
(= (sel2 $v $b) (+ (case $v (((A $y) $y) ((B $y) $y))) (let $y $b $y)))
!(collapse (sel2 (A 1) 1))
!(collapse (sel2 (B 1) 2))
(= (ch $b) (+ (chain (+ 1 1) $x $x) (let $x $b $x)))
!(collapse (ch 2))
!(collapse (ch 3))
(= (un $b) (+ (unify $x 4 $x 0) (let $x $b $x)))
!(collapse (un 4))
!(collapse (un 5))
