; Untyped functions over typed constructors: the typings their call sites
; pass and their bodies answer decide the constructors' checks where every
; combination passes; a combination that fails is checked, and a value typed
; %Undefined% passes as it does anywhere.
(: List (-> Type Type))
(: Nil (List $a))
(: Cons (-> $a (List $a) (List $a)))
(: Nat Type)
(: Z Nat)
(: S (-> Nat Nat))
(= (build $n $acc) (if (== $n 0) $acc (build (- $n 1) (Cons $n $acc))))
(= (sum Nil) 0)
(= (sum (Cons $x $xs)) (+ $x (sum $xs)))
(= (fromint $n) (if (== $n 0) Z (S (fromint (- $n 1)))))
(= (add Z $m) $m)
(= (add (S $k) $m) (S (add $k $m)))
(= (toint Z) 0)
(= (toint (S $k)) (+ 1 (toint $k)))
(= (wrap $x) (Cons $x Nil))
(= (keep $x) (S $x))
(= (push $x $l) (Cons $x $l))
!(sum (build 5 Nil))
!(toint (add (fromint 3) (fromint 2)))
!(wrap 1)
!(wrap "s")
!(keep (Foo))
!(keep Z)
!(push 2 (Cons 1 Nil))
!(let $l (build 3 Nil) (push 0 $l))
!(push "a" (Cons 1 Nil))
