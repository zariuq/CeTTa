!(import! &self lib_transform)
!(import! &self ../../lib/lib_transform.metta)
!(import! &self lib_transform)
!(bind! &s (new-space))
!(add-atom &s (job a))
!(add-atom &s (job b))
!(sort-atom (collapse (transform &s (take (job $j)) (done $j))))
!(collapse (match &s (job $j) $j))
(= (tf:run $space $sources $template $destination) (redefined $sources))
!(bind! &r (new-space))
!(add-atom &r (job c))
!(transform &r (job $j) (done $j))
