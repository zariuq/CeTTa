; HE evaluates a value at the type a call is expected at only through
; untyped heads and `if`, whose range variable takes that type.  A head with
; a declared function type matches its range with the expected type, then
; evaluates its own results at its range: at %Undefined% nothing is checked,
; and a range the expected type rejects is a type error naming the call.
(: g1 (-> Number %Undefined%))
(= (g1 $x) "s")
(= (u1 $x) (g1 $x))
(: f1 (-> Number %Undefined%))
(= (f1 $x) $x)
(: k1 (-> Number Number))
(= (k1 $x) (u1 $x))
!(collapse (f1 (u1 1)))
!(collapse (k1 1))
!(collapse (metta (u1 1) Number &self))
(= (u2 $x) (+ $x 1))
(: s2 (-> Number String))
(= (s2 $x) (u2 $x))
!(collapse (metta (u2 1) String &self))
!(collapse (s2 1))
(: l3 (-> Number Number))
(= (l3 $x) (u3 $x))
(= (u3 $x) (let $y 1 "s"))
!(collapse (l3 1))
(: i4 (-> Number String))
(= (i4 $x) (u4 $x))
(= (u4 $x) (if True (+ $x 1) 0))
!(collapse (i4 1))
(: m5 (-> Number String))
(= (m5 $x) (u5 $x))
(: g5 (-> Number Number))
(= (g5 $x) (+ $x 1))
(= (u5 $x) (g5 $x))
!(collapse (m5 1))
; case and switch have the range %Undefined%.
(: c6 (-> Number Number))
(= (c6 $x) (case $x ((1 "s"))))
!(collapse (c6 1))
(: w6 (-> Number Number))
(= (w6 $x) (switch $x ((1 "s"))))
!(collapse (w6 1))
(: h6 (-> Number String))
(= (h6 $x) "x")
(: t6 (-> Number Number))
(= (t6 $x) (case $x ((1 (h6 $x)))))
!(collapse (t6 1))
(: k6 (-> Number Number))
(= (k6 $x) $x)
!(collapse (k6 (case 1 ((1 "s")))))
; Untyped heads and `if` carry a value to the expected type.
(: p7 (-> Number Number))
(= (p7 $x) (u7 $x))
(= (u7 $x) "s")
!(collapse (p7 1))
(: q7 (-> Number Number))
(= (q7 $x) (if True "s" 0))
!(collapse (q7 1))
(: r7 (-> Number Number))
(= (r7 $x) (case $x ((1 7))))
!(collapse (r7 1))
(: n7 (-> Number Number))
(= (n7 $x) (u8 $x))
(= (u8 $x) (+ $x 1))
!(collapse (n7 1))
; let, let*, match, unify and chain have the range %Undefined% too.
(: l9 (-> Number String))
(= (l9 $x) (let $y (+ $x 1) (* $y 2)))
!(collapse (l9 3))
(data9 1)
(: m9 (-> Number Number))
(= (m9 $x) (match &self (data9 $x) "s"))
!(collapse (m9 1))
(: n9 (-> Number Number))
(= (n9 $x) (unify $x 1 "s" "t"))
!(collapse (n9 1))
