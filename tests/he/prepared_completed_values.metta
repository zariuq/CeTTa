; Evaluated arguments enter the prepared callee as values. Typed completion
; retains held fields, duplicate answers and the single producing effect.
(: Retained Type)
(: retained-box (-> Number Retained))
(: retained-held (-> Atom Retained))
(= (retained-id $x) $x)
(= (retained-twice $x) $x)
(= (retained-twice $x) $x)
(= (retained-mixed $x) 7)
(= (retained-mixed $x) $x)
!(metta (retained-id (retained-box 7)) Retained &self)
!(metta (retained-twice (retained-box 7)) Retained &self)
!(metta (retained-id (retained-held (println! "must remain data"))) Retained &self)
!(metta (retained-id (retained-box 7)) Atom &self)
!(metta (retained-id (retained-box 7)) Expression &self)
!(let $state (new-state 0)
   (let $value (retained-box (let $_ (change-state! $state (+ (get-state $state) 1)) 7))
     (Pair (retained-twice $value) (get-state $state))))
!(metta (retained-mixed (retained-box 7)) Number &self)
!(metta (retained-id (retained-box 7)) Number &self)
