; A priority space shows its order through its own operations: space:priority:peek,
; space:priority:pop, space:priority:get and space:priority:truncate go by the standard order of terms.
; A read of it (match, get-atoms, a transform's reads) answers a bag, as a
; read of any space does, so every read below is observed sorted
; (sort-atom of its collapse, bound first so that both dialects sort the
; answers), never in the order they come.
!(bind! &p (new-space priority))
!(add-atom &p (5 e))
!(add-atom &p (2 b))
!(add-atom &p (9 z))
!(add-atom &p (2 b2))
!(add-atom &p (1 a))
!(all (let $answers (collapse (match &p $x $x)) (sort-atom $answers)))
!(least (space:priority:peek &p))
!(take (collapse (transform &p (take (2 b)) (given 2 b))))
!(pop (space:priority:pop &p))
!(peek (space:priority:peek &p))
!(heavy (let $answers (collapse (match &p (9 $c) $c)) (sort-atom $answers)))
!(rest (let $answers (collapse (match &p $x $x)) (sort-atom $answers)))
!(bind! &f (new-space priority full))
!(add-atom &f (3 c))
!(add-atom &f (1 a))
!(full (let $answers (collapse (match &f ($w $c) $c)) (sort-atom $answers)))
!(bind! &a (new-space priority))
!(bind! &b (new-space priority))
!(add-atom &a (k true))
!(add-atom &a (k True))
!(add-atom &a (f $x b))
!(add-atom &a (f $y a))
!(add-atom &a (n 1))
!(add-atom &a (n 1.0))
!(add-atom &a (n 1))
!(add-atom &b (n 1))
!(add-atom &b (n 1.0))
!(add-atom &b (n 1))
!(add-atom &b (f $y a))
!(add-atom &b (f $x b))
!(add-atom &b (k True))
!(add-atom &b (k true))
!(add-atom &a (e 0))
!(add-atom &b (e 0))
!(open-rows (let $answers (collapse (match &a (f $u $v) $v)) (sort-atom $answers)))
!(numbers (let $answers (collapse (match &a (n $x) $x)) (sort-atom $answers)))
!(same-open (== (let $answers (collapse (match &a (f $u $v) $v)) (sort-atom $answers)) (let $others (collapse (match &b (f $u $v) $v)) (sort-atom $others))))
!(same-numbers (== (let $answers (collapse (match &a (n $x) $x)) (sort-atom $answers)) (let $others (collapse (match &b (n $x) $x)) (sort-atom $others))))
!(same-least (== (space:priority:pop &a) (space:priority:pop &b)))
!(bind! &g (new-space priority full))
!(add-atom &g (7 seven))
!(add-atom &g (19 nineteen))
!(add-atom &g (3 three))
!(add-atom &g (12 twelve))
!(add-atom &g (5 five))
!(add-atom &g (16 sixteen))
!(add-atom &g (1 one))
!(add-atom &g (10 ten))
!(add-atom &g (14 fourteen))
!(add-atom &g (8 eight))
!(add-atom &g (2 two))
!(add-atom &g (18 eighteen))
!(add-atom &g (6 six))
!(add-atom &g (11 eleven))
!(add-atom &g (4 four))
!(add-atom &g (15 fifteen))
!(add-atom &g (9 nine))
!(add-atom &g (13 thirteen))
!(add-atom &g (17 seventeen))
!(add-atom &g (20 twenty))
!(add-atom &g (tag late))
!(add-atom &g (5 five))
!(keyed (let $answers (collapse (match &g (5 $c) $c)) (sort-atom $answers)))
!(least (space:priority:peek &g))
!(fourth (space:priority:get &g 3))
!(remove-atom &g (5 five))
!(took (collapse (transform &g (take (1 one)) (given 1 one))))
!(after (let $answers (collapse (match &g (5 $c) $c)) (sort-atom $answers)))
!(space:priority:truncate &g 4)
!(kept (let $answers (collapse (match &g $x $x)) (sort-atom $answers)))
!(held (space-len &g))
!(drained (let $a (space:priority:pop &g) (let $b (space:priority:pop &g) (let $c (space:priority:pop &g) (let $d (space:priority:pop &g) ($a $b $c $d))))))

; A copy of a priority space is a priority space: it peeks and pops in the
; same order, reads the same bag, takes atoms of its own, and leaves the space
; it was copied from as it was.
!(bind! &v (new-space priority))
!(add-atom &v (5 e))
!(add-atom &v (2 b))
!(add-atom &v (9 i))
!(add-atom &v (2 a))
!(copy-listed (with-space-snapshot $s &v (let $answers (collapse (get-atoms $s)) (sort-atom $answers))))
!(copy-matched (with-space-snapshot $s &v (let $answers (collapse (match $s ($k $v) $k)) (sort-atom $answers))))
!(copy-keyed (with-space-snapshot $s &v (let $answers (collapse (match $s (2 $v) $v)) (sort-atom $answers))))
!(copy-peeked (with-space-snapshot $s &v (space:priority:peek $s)))
!(copy-popped (with-space-snapshot $s &v (let $x (space:priority:pop $s) (pair $x (let $answers (collapse (get-atoms $s)) (sort-atom $answers))))))
!(copy-added (with-space-snapshot $s &v (let $_ (add-atom $s (1 z)) (let $__ (add-atom $s (7 g)) (let $answers (collapse (get-atoms $s)) (sort-atom $answers))))))
!(copy-added-peek (with-space-snapshot $s &v (let $_ (add-atom $s (1 z)) (space:priority:peek $s))))
!(copy-drained (with-space-snapshot $s &v (let $_ (add-atom $s (3 c)) (let $a (space:priority:pop $s) (let $b (space:priority:pop $s) (let $c (space:priority:pop $s) (taken $a $b $c (let $answers (collapse (get-atoms $s)) (sort-atom $answers)))))))))
!(copied-from (let $answers (collapse (get-atoms &v)) (sort-atom $answers)))
