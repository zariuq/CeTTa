; Indexed ports, equality guards and publications on both firing engines.
!(bind! &left (new-space))
!(bind! &right (new-space))
!(add-atom &left (p 1))
!(add-atom &left (p 2))
!(add-atom &right (p 2))
!(collapse (transform &left (, (read (p $x)) (read &right (p $x))) (joined $x)))
!(collapse (transform &left (, (read (p $x)) (read (p $x))) (repeated-read $x)))
!(collapse (transform &left (, (read (p $x)) (let True (== $x 2))) (equal $x)))
!(collapse (transform &left (, (read (p $x)) (let True (== $x 9))) (never $x)))
!(collapse (transform &left (, (read (p $x)) (let True (== $x 2.0))) (numeric $x 2.0)))
!(collapse (transform &left (, (read (p $x)) (let True (== (quote (+ 1 1)) (quote (+ 1 1))))) (held $x)))

; The compiled shape may repeat while constants, aliases and locations change.
(= (seek $s $value) (transform $s (read (p $value)) (found $value)))
!(collapse (seek &left 1))
!(collapse (seek &left 2))
!(collapse (seek &left 1))
(= (join-spaces $a $b) (transform $a (, (read (p $x)) (read $b (p $x))) (both $x)))
!(collapse (join-spaces &left &left))
!(collapse (join-spaces &left &right))
!(collapse (join-spaces &left &left))

; Row openings preserve distinct unknowns and aliases within a row.
!(bind! &open (new-space))
!(add-atom &open (independent $u $v))
!(add-atom &open (aliased $u $u))
!(collapse (transform &open (, (read (independent 1 2)) (read (independent 3 4))) independent-openings))
!(collapse (let (pair 1 2) (transform &open (read (independent $a $b)) (pair $a $b)) independent))
!(collapse (let (pair 1 2) (transform &open (read (aliased $a $b)) (pair $a $b)) impossible))
!(collapse (let (pair 1 1) (transform &open (read (aliased $a $b)) (pair $a $b)) shared))
!(collapse (transform &open (, (read (independent $a $b)) (let True (== $a $b))) impossible))
!(collapse (transform &open (, (read (aliased $a $b)) (let True (== $a $b))) equal-unknowns))

; A read needs a distinct occurrence when the same value is also taken.
!(bind! &copies (new-space))
!(add-atom &copies (coin 7))
!(add-atom &copies (coin 7))
!(collapse (transform &copies (, (take (coin 7)) (read (coin 7))) spent))
!(collapse (match &copies (coin $n) $n))
!(collapse (transform &copies (, (take (coin 7)) (take (coin 7))) unavailable))
!(collapse (match &copies (coin $n) $n))
!(add-atom &copies (coin 7))
!(collapse (transform &copies (, (take (coin 7)) (take (coin 7))) spent-both))
!(collapse (match &copies (coin $n) $n))

; Multi-space takes commit their current copies once.
!(bind! &jobs (new-space))
!(bind! &receivers (new-space))
!(bind! &done (new-space))
!(add-atom &jobs (job a))
!(add-atom &jobs (job b))
!(add-atom &receivers (receiver alice))
!(add-atom &receivers (receiver bob))
!(collapse (once (transform &jobs (, (take (job $j)) (take &receivers (receiver $r))) (done $j $r) &done)))
!(let $items (collapse (match &jobs (job $j) $j)) (size-atom $items))
!(let $items (collapse (match &receivers (receiver $r) $r)) (size-atom $items))
!(let $items (collapse (match &done $r $r)) (size-atom $items))

; Mutable cell equality and its removal observation retain their host policy.
!(bind! &first (new-state 9))
!(bind! &second (new-state 9))
!(bind! &cells (new-space))
!(add-atom &cells (cell &first))
!(add-atom &cells (cell &second))
!(collapse (transform &cells (read (cell &second)) state-read))
!(collapse (transform &cells (, (read (cell $s)) (let True (== $s &first))) (get-state $s)))
!(collapse (once (transform &cells (take (cell &second)) state-take)))
!(let $_ (change-state! &first 1) first-changed)
!(let $_ (change-state! &second 2) second-changed)
!(collapse (match &cells (cell $s) (get-state $s)))

; General source forms keep their existing realization.
!(collapse (transform &left (, (read (p $x)) (absent (missing $x))) (absent $x)))
!(collapse (transform &left (unique (p 1)) unique))
!(collapse (transform &left (all (read (p $x))) (bulk $x)))
