!(bind! &s (new-space))
!(add-atom &s (job a))
!(add-atom &s (job b))
!(sort-atom (collapse (transform &s (take (job $j)) (done $j))))
!(collapse (match &s (job $j) $j))
(= (ticket $x) (reduced $x))
!(bind! &t (new-space))
!(add-atom &t (ticket a))
!(transform &t (take (ticket $x)) (served $x))
!(get-type transform)
!(program-space (collapse (get-atoms &self)))
