; HE typed heads with formals and ranges that are closed types other than
; value classes run on the prepared machine: each such argument is checked
; at its formal at every call, and a range is checked where an activation
; returns unless every return position shows it.
(: List (-> Type Type))
(: Nil (List $a))
(: Cons (-> $a (List $a) (List $a)))
(: build (-> Number (List Number) (List Number)))
(= (build $n $acc) (if (== $n 0) $acc (build (- $n 1) (Cons $n $acc))))
(: sum (-> (List Number) Number))
(= (sum Nil) 0)
(= (sum (Cons $x $xs)) (+ $x (sum $xs)))
!(sum (build 20 Nil))
!(collapse (sum (Cons "a" Nil)))
!(collapse (build 2 (Cons "x" Nil)))
(: Nat Type)
(: Z Nat)
(: S (-> Nat Nat))
(: fromint (-> Number Nat))
(= (fromint $n) (if (== $n 0) Z (S (fromint (- $n 1)))))
(: add (-> Nat Nat Nat))
(= (add Z $m) $m)
(= (add (S $k) $m) (S (add $k $m)))
(: toint (-> Nat Number))
(= (toint Z) 0)
(= (toint (S $k)) (+ 1 (toint $k)))
!(toint (add (fromint 7) (fromint 5)))
(: mkbad (-> Number Nat))
(= (mkbad $n) 5)
!(collapse (toint (mkbad 1)))
(: Tree Type)
(: Leaf Tree)
(: Node (-> Tree Tree Tree))
(: mk (-> Number Tree))
(= (mk $n) (if (== $n 0) Leaf (Node (mk (- $n 1)) (mk (- $n 1)))))
(: tsize (-> Tree Number))
(= (tsize Leaf) 1)
(= (tsize (Node $l $r)) (+ 1 (+ (tsize $l) (tsize $r))))
!(tsize (mk 5))
!(collapse (tsize 7))
(: Other Type)
(: Odd Other)
!(tsize (mk 4))
(: mkodd (-> Number Tree))
(= (mkodd $n) (if (== $n 0) Odd (Node (mkodd (- $n 1)) Leaf)))
!(collapse (tsize (mkodd 2)))
!(collapse (mkodd 0))
; A call no equation matches is HE's answer as written.
(: f (-> Number Number))
(= (f 1) 5)
!(f 2)
!(collapse (+ 1 (f 2)))
(: g (-> Number Number))
(= (g 0) 0)
(= (g 1) (g 3))
!(g 1)
