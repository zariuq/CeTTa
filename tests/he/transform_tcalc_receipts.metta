!(import! &self (library lib_transform))
!(bind! &w (new-space))
!(add-atom &w (item a))
!(tf:fire &w (tf:cs ((read (item $x)))) (observed $x))
!(tf:fire &w (tf:cs ((read (item $x)) (let $u (add-atom &w (effect $x))))) (observed $x))
!(collapse (match &w (effect $x) $x))
!(add-atom &w (copy a))
!(add-atom &w (copy a))
!(tf:fire &w (tf:cs ((take (copy $x)) (take (copy $y)))) (pair $x $y))
!(collapse (match &w (copy $x) $x))
!(add-atom &w (left a))
!(add-atom &w (right b))
!(tf:fire &w (tf:cs ((take (left $x)) (take (right $y)))) (pair $x $y))
!(collapse (match &w (item $x) $x))
!(collapse (match &w (effect $x) $x))
