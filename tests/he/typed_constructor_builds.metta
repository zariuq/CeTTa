; A constructor with one declared function type over computed parameters is
; built on the prepared machine, each build checked by HE's typing; an
; ill-typed build is answered by the canonical evaluator with HE's error.
(: List (-> Type Type))
(: Nil (List $a))
(: Cons (-> $a (List $a) (List $a)))
(= (build $n $acc) (if (== $n 0) $acc (build (- $n 1) (Cons $n $acc))))
(= (sum Nil) 0)
(= (sum (Cons $x $xs)) (+ $x (sum $xs)))
!(sum (build 30 Nil))
(= (bad $n $acc) (if (== $n 0) (Cons "s" $acc) (bad (- $n 1) (Cons $n $acc))))
!(collapse (bad 3 Nil))
(: Nat Type)
(: Z Nat)
(: S (-> Nat Nat))
(= (fromint $n) (if (== $n 0) Z (S (fromint (- $n 1)))))
(= (toint Z) 0)
(= (toint (S $k)) (+ 1 (toint $k)))
!(toint (fromint 25))
!(collapse (S 5))
(: Tree Type)
(: Leaf Tree)
(: Node (-> Tree Tree Tree))
(= (mk $n) (if (== $n 0) Leaf (Node (mk (- $n 1)) (mk (- $n 1)))))
(= (tsize Leaf) 1)
(= (tsize (Node $l $r)) (+ 1 (+ (tsize $l) (tsize $r))))
!(tsize (mk 6))
; A parameter typed Atom keeps its argument as written: not a checked build.
(: Q (-> Atom Q))
(= (mkq $x) (Q (+ $x 1)))
!(mkq 1)
; Two declared rows: HE selects among them, so the build is not the machine's.
(: Two (-> Number Two))
(: Two (-> String Two))
(= (mk2 $x) (Two $x))
!(mk2 "w")
!(mk2 4)
