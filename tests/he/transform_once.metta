!(bind! &q (new-space))
!(add-atom &q (job a))
!(add-atom &q (job b))
!(add-atom &q (receiver alice))
!(add-atom &q (receiver bob))
!(first (let $claims (collapse (once (transform &q (, (take (job $j)) (take (receiver $r))) (claimed $j $r))))
  (case $claims ((((claimed $j $r)) one-claim) ($_ $claims)))))
!(jobs-after-first (let $jobs (collapse (match &q (job $j) $j)) (size-atom $jobs)))
!(receivers-after-first (let $receivers (collapse (match &q (receiver $r) $r)) (size-atom $receivers)))
!(second (let $claims (collapse (once (transform &q (, (take (job $j)) (take (receiver $r))) (claimed $j $r))))
  (case $claims ((((claimed $j $r)) one-claim) ($_ $claims)))))
!(remaining (collapse (match &q $a $a)))
!(bind! &d (new-space))
!(add-atom &d (job a))
!(add-atom &d (job b))
!(dest-first (collapse (once (transform &d (take (job $j)) (done $j) &d))))
!(dest-second (collapse (once (transform &d (take (job $j)) (done $j) &d))))
!(dest-remaining (collapse (match &d (job $j) $j)))
!(dest-done (let $done (collapse (match &d (done $j) $j)) (sort-atom $done)))
