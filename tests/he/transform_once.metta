!(bind! &q (new-space))
!(add-atom &q (job a))
!(add-atom &q (job b))
!(add-atom &q (receiver alice))
!(add-atom &q (receiver bob))
!(first (collapse (once (transform &q (, (take (job $j)) (take (receiver $r))) (claimed $j $r)))))
!(jobs-after-first (sort-atom (collapse (match &q (job $j) $j))))
!(receivers-after-first (sort-atom (collapse (match &q (receiver $r) $r))))
!(second (collapse (once (transform &q (, (take (job $j)) (take (receiver $r))) (claimed $j $r)))))
!(remaining (collapse (match &q $a $a)))
!(bind! &d (new-space))
!(add-atom &d (job a))
!(add-atom &d (job b))
!(dest-first (collapse (once (transform &d (take (job $j)) (done $j) &d))))
!(dest-second (collapse (once (transform &d (take (job $j)) (done $j) &d))))
!(dest-remaining (collapse (match &d (job $j) $j)))
!(dest-done (sort-atom (collapse (match &d (done $j) $j))))
