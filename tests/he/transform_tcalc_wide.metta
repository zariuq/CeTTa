!(bind! &w (new-space))
!(add-atom &w (p0 a))
!(add-atom &w (p1 a))
!(add-atom &w (p2 a))
!(add-atom &w (p3 a))
!(add-atom &w (p4 a))
!(add-atom &w (p5 a))
!(add-atom &w (p6 a))
!(add-atom &w (p7 a))
!(add-atom &w (p8 b))
!(collapse (transform &w (, (read (p0 $x)) (read (p1 $x)) (read (p2 $x)) (read (p3 $x)) (read (p4 $x)) (read (p5 $x)) (read (p6 $x)) (read (p7 $x)) (read (p8 $x))) (wide $x)))
!(add-atom &w (p8 a))
!(collapse (transform &w (, (read (p0 $x)) (read (p1 $x)) (read (p2 $x)) (read (p3 $x)) (read (p4 $x)) (read (p5 $x)) (read (p6 $x)) (read (p7 $x)) (read (p8 $x))) (wide $x)))
!(collapse (transform &w (, (take (p0 $x)) (take (p1 $x)) (take (p2 $x)) (take (p3 $x)) (take (p4 $x)) (take (p5 $x)) (take (p6 $x)) (take (p7 $x)) (take (p8 $x))) (consumed $x)))
!(collapse (match &w (p8 $x) $x))
