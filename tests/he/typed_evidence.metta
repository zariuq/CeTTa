; Types the prepared machine knows without checking: a returned argument or
; field at the range, a let-bound value, and the answer a checked build made.
; Values typed %Undefined% pass every check and keep that typing wherever
; they are passed on.
(: Nat Type)
(: Z Nat)
(: S (-> Nat Nat))
(: fromint (-> Number Nat))
(= (fromint $n) (if (== $n 0) Z (S (fromint (- $n 1)))))
(: add (-> Nat Nat Nat))
(= (add Z $m) $m)
(= (add (S $k) $m) (S (add $k $m)))
(: toint (-> Nat Number))
(= (toint Z) 0)
(= (toint (S $k)) (+ 1 (toint $k)))
(: pred (-> Nat Nat))
(= (pred Z) Z)
(= (pred (S $k)) $k)
(: shout (-> String String))
(= (shout $s) (Shouted $s))
(: List (-> Type Type))
(: Nil (List $a))
(: Cons (-> $a (List $a) (List $a)))
(: build (-> Number (List Number) (List Number)))
(= (build $n $acc) (if (== $n 0) $acc (build (- $n 1) (Cons $n $acc))))
(: sum (-> (List Number) Number))
(= (sum Nil) 0)
(= (sum (Cons $x $xs)) (+ $x (sum $xs)))
!(toint (add (fromint 3) (fromint 2)))
!(add (fromint 2) Z)
!(pred (S (S Z)))
!(let $l (build 4 Nil) (sum $l))
!(let $n (add (fromint 1) (fromint 1)) (toint $n))
!(add Z (Foo))
!(let $v (add Z (Foo)) (shout $v))
!(pred (S (Foo)))
!(let $v (pred (S (Foo))) (shout $v))
!(let $v (build 0 (Foo 5 Nil)) (shout $v))
!(sum (build 0 (Cons 1 (Foo 5 Nil))))
!(let $v (fromint 2) (shout $v))
!(let $v (build 2 (Foo 5 Nil)) (shout $v))
