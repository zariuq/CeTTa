; These comparisons require only the extended profile, with no module import.
!(@< a b)
!(@> b a)
!(@<= a a)
!(@>= a a)
!(@< b a)
!(@> a b)
!(@<= b a)
!(@>= a b)
!(@< 2 10)
!(@< 1.0 1)
!(@< "z" a)
!(@< () a)
!(@< (q a) (q b))
!(@<= (pair a b) (pair a b))
!(@< () Zebra)
!(@> Zebra ())
; Computations are evaluated before ordering their values. Operand types
; remain independent so different kinds of values can be compared.
(= (score a) 5)
(= (score b) 3)
!(@< (+ 1 2) 4)
!(@< (score a) (score b))
!(@> (score a) (score b))
!(@<= (score a) 5)
!(@>= (score b) 3)
!(@< (score b) a)
