!(import! &self "../tools/tcalc_r2_receipts.metta")
!(bind! &kb (new-space))
!(bind! &proof (new-space))
!(add-atom &kb (occ 1 3 (term a)))
!(add-atom &proof (lres 7 (term b) 4))
!(println! (let $answers (collapse (r2-read-occurrence 1)) (stored-row $answers)))
!(println! (let $answers (collapse (r2-read-occurrence 2)) (missing-row $answers)))
!(println! (let $answers (collapse (r2-read-lemma &proof 7)) (proof-row $answers)))
!(println! (let $answers (collapse (r2-read-lemma &proof 8)) (missing-proof-row $answers)))
