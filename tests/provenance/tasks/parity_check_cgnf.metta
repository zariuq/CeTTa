(m zero (cell 0 $v0) $v0)
(m one (cell 1 $v0) $v0)
(m empty $v0 $v0)
(metarule identity $v0 (m identity $v0 $v1) (m $v0 $v2 $v3) ((m $v1 $v2 $v3)))
(metarule chain $v0 (m chain $v0 $v1 $v2) (m $v0 $v3 $v4) ((m $v1 $v3 $v5) (m $v2 $v5 $v4)))
(= (forest:signature) (s inv_1))
(allowed (m identity s empty))
(allowed (m identity s one))
(allowed (m identity s zero))
(allowed (m chain inv_1 one inv_1))
(allowed (m chain inv_1 one s))
(allowed (m chain inv_1 one zero))
(allowed (m chain inv_1 zero inv_1))
(allowed (m chain inv_1 zero one))
(allowed (m chain inv_1 zero s))
(allowed (m chain s inv_1 one))
(allowed (m chain s inv_1 s))
(allowed (m chain s inv_1 zero))
