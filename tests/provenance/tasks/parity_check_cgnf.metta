(allowed (m chain s one s))
(allowed (m chain s one zero))
(allowed (m chain s zero inv_1))
(allowed (m chain s zero one))
(allowed (m chain s zero s))
(= (forest:allowed $s) (if (== (collapse (match &self (allowed $s) $s)) ()) False True))
(= (task-examples) ((m s nil nil) (m s (cell 0 nil) nil) (m s (cell 0 (cell 0 nil)) nil) (m s (cell 1 (cell 1 nil)) nil) (m s (cell 0 (cell 0 (cell 0 nil))) nil) (m s (cell 0 (cell 1 (cell 1 nil))) nil) (m s (cell 1 (cell 0 (cell 1 nil))) nil) (m s (cell 1 (cell 1 (cell 0 nil))) nil) (m s (cell 0 (cell 0 (cell 0 (cell 0 nil)))) nil) (m s (cell 0 (cell 0 (cell 1 (cell 1 nil)))) nil) (m s (cell 0 (cell 1 (cell 0 (cell 1 nil)))) nil) (m s (cell 0 (cell 1 (cell 1 (cell 0 nil)))) nil) (m s (cell 1 (cell 0 (cell 0 (cell 1 nil)))) nil) (m s (cell 1 (cell 0 (cell 1 (cell 0 nil)))) nil) (m s (cell 1 (cell 1 (cell 0 (cell 0 nil)))) nil) (m s (cell 1 (cell 1 (cell 1 (cell 1 nil)))) nil)))
(= (task-bound) (steps 5))
