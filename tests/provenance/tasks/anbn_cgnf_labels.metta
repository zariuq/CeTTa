; A Vanilla generalisation problem, written by the forest's SWI front end: the
; background, the metarules, the signature, the metasubstitutions the
; constraints allow, the examples and the bound.
(m a (cell a $v0) $v0)
(m b (cell b $v0) $v0)
(m empty $v0 $v0)
(metarule identity $v0 (m identity $v0 $v1) (m $v0 $v2 $v3) ((m $v1 $v2 $v3)))
(metarule chain $v0 (m chain $v0 $v1 $v2) (m $v0 $v3 $v4) ((m $v1 $v3 $v5) (m $v2 $v5 $v4)))
(= (forest:signature) (s inv_1))
(allowed (m identity s a))
(allowed (m identity s b))
(allowed (m identity s empty))
(allowed (m chain inv_1 a a))
(allowed (m chain inv_1 a b))
(allowed (m chain inv_1 a inv_1))
(allowed (m chain inv_1 a s))
(allowed (m chain inv_1 b a))
(allowed (m chain inv_1 b b))
(allowed (m chain inv_1 b inv_1))
(allowed (m chain inv_1 b s))
(allowed (m chain s a a))
(allowed (m chain s a b))
(allowed (m chain s a inv_1))
(allowed (m chain s a s))
(allowed (m chain s b a))
(allowed (m chain s b b))
(allowed (m chain s b inv_1))
(allowed (m chain s b s))
(allowed (m chain s inv_1 a))
(allowed (m chain s inv_1 b))
(allowed (m chain s inv_1 inv_1))
(allowed (m chain s inv_1 s))
(= (forest:allowed $s) (if (== (collapse (match &self (allowed $s) $s)) ()) False True))
(= (task-examples) ((m s (cell a (cell b nil)) nil) (m s (cell a (cell a (cell b (cell b nil)))) nil) (m s (cell a (cell a (cell a (cell b (cell b (cell b nil)))))) nil)))
(= (task-bound) (labels 3))
