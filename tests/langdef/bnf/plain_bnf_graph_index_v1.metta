!(import! &self ../../../lib/lib_bnf.metta)

(= (graph-index:old $start $definitions $lexicals)
   (let (gslt:result:BNFAnalyzeDocumentV1:1110 $result)
        (gslt:entry:BNFAnalyzeDocumentV1:1110 $start $definitions $lexicals) $result))
(= (graph-index:new $start $definitions $lexicals)
   (let (gslt:result:BNFAnalyzeDocumentIndexedV1:1110 $result)
        (gslt:entry:BNFAnalyzeDocumentIndexedV1:1110 $start $definitions $lexicals) $result))
(= (graph-index:compare $marker $start $definitions $lexicals)
   (let $old (collapse (graph-index:old $start $definitions $lexicals))
     (let $new (collapse (graph-index:new $start $definitions $lexicals))
       (case $old
         ((($one) (if (== $old $new) $marker (GraphIndexDifference $marker $old $new)))
          ($other (GraphIndexReferenceMultiplicity $marker $other)))))))
(= (graph-index:read $marker $read $authority)
   (case $read
     (((BNF:ReadValue (BNF:GrammarDocument $_binding $_source $document))
        (case (bnf:admit-grammar-input (bnf-v1:grammar-input $document $authority))
          (((BNF:GrammarInputAdmitted $input)
             (case (bnf:validate-declarations $input)
               (((BNFDeclarationValidationAcceptedV1 $start $definitions $lexicals)
                  (graph-index:compare $marker $start $definitions $lexicals))
                ($other (GraphIndexDeclarationRefused $marker $other)))))
           ($other (GraphIndexInputRefused $marker $other)))))
      ($other (GraphIndexReadRefused $marker $other)))))
(= (graph-index:text $marker $text)
   (graph-index:read $marker (bnf:read-text $text) (bnf:default-authority "s")))

!(graph-index:text GraphIndexLiteralV1 "<s> ::= \"x\"\n")
!(graph-index:text GraphIndexDyckV1 "<s> ::= \"(\" <s> \")\" <s> |\n")
!(graph-index:text GraphIndexForwardChainV1 "<s> ::= <a>\n<a> ::= <b>\n<b> ::= \"x\"\n")
!(graph-index:text GraphIndexReverseChainV1 "<b> ::= \"x\"\n<a> ::= <b>\n<s> ::= <a>\n")
!(graph-index:text GraphIndexSeededCycleV1 "<s> ::= <a>\n<a> ::= <s> |\n")
!(graph-index:text GraphIndexUnseededCycleV1 "<s> ::= <a>\n<a> ::= <s>\n")
!(graph-index:text GraphIndexUnreachableV1 "<s> ::= \"x\"\n<a> ::= <a>\n<b> ::= \"y\"\n")
!(graph-index:text GraphIndexDuplicateReferencesV1 "<s> ::= <a> <a> | <a>\n<a> ::=\n")
!(graph-index:text GraphIndexAmbiguousV1 "<s> ::= <s> <s> | \"a\" | \"a\"\n")
!(graph-index:text GraphIndexUnicodeV1 "<s> ::= <a>\n<a> ::= \"λ雪😀\"\n")
!(graph-index:read GraphIndexSelfV1
   (bnf:read-file "langdef/bnf/plain_bnf_self_v1.bnf") (bnf:self-authority-v1))
