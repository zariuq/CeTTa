% Nested record syntax: a JSON-shaped specimen, not the complete JSON standard.
% The literal alphabet is intentionally finite; whitespace is not implicit.
<s> ::= <value> "\n"?
<value> ::= <record> | <array> | <number> | <string> | "true" | "false" | "null"
<record> ::= "{" (<field> ("," <field>)*)? "}"
<field> ::= <string> ":" <value>
<array> ::= "[" (<value> ("," <value>)*)? "]"
<number> ::= "-"? ("0" | <nonzero> <digit>*) ("." <digit>+)?
<digit> ::= "0" | <nonzero>
<nonzero> ::= "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" | "9"
<string> ::= "\"" ("a" | "b" | "x" | "λ" | "雪" | "\\" "\"")* "\""
