; Run after ONE generated composition containing the index and old collector.
; Results assert lookup and collector observations, not a particular tree layout.
(= (index-test:insert $key $value $tree)
   (let (gslt:result:BNFIndexInsertFirstV1:1110 $after)
        (gslt:entry:BNFIndexInsertFirstV1:1110 $key $value $tree) $after))
(= (index-test:lookup $key $tree)
   (let (gslt:result:BNFIndexLookupV1:110 $result)
        (gslt:entry:BNFIndexLookupV1:110 $key $tree) $result))
(= (index-test:build IndexBindingsNil $tree) $tree)
(= (index-test:build (IndexBindingsCons (IndexBinding $key $value) $tail) $tree)
   (index-test:build $tail (index-test:insert $key $value $tree)))
(= (index-test:new $entries $prefix)
   (let (gslt:result:BNFIndexedCollectDefinitionsV1:1100 $definitions $diagnostics)
        (gslt:entry:BNFIndexedCollectDefinitionsV1:1100 $entries $prefix)
     (IndexCollected $definitions $diagnostics)))
(= (index-test:old $entries $prefix)
   (let (gslt:result:BNFCollectDefinitionsV1:1100 $definitions $diagnostics)
        (gslt:entry:BNFCollectDefinitionsV1:1100 $entries $prefix)
     (IndexCollected $definitions $diagnostics)))
(= (index-test:compare $marker $entries $prefix)
   (let $actual (collapse (index-test:new $entries $prefix))
     (let $reference (collapse (index-test:old $entries $prefix))
       (case $actual
         ((($one) (if (== $actual $reference) $marker
                         (IndexUnexpectedComparison $marker $actual $reference)))
          ($other (IndexUnexpectedMultiplicity $marker $other)))))))

