!(import! &self ../../../lib/lib_bnf.metta)

(= (graph-discovery:old $start $definitions $lexicals)
   (let (gslt:result:BNFAnalyzeDocumentV1:1110 $result)
        (gslt:entry:BNFAnalyzeDocumentV1:1110 $start $definitions $lexicals) $result))
(= (graph-discovery:new $start $definitions $lexicals)
   (let (gslt:result:BNFAnalyzeDocumentWorklistV1:1110 $result)
        (gslt:entry:BNFAnalyzeDocumentWorklistV1:1110 $start $definitions $lexicals) $result))
(= (graph-discovery:compare $marker $start $definitions $lexicals)
   (let $old (collapse (graph-discovery:old $start $definitions $lexicals))
     (let $new (collapse (graph-discovery:new $start $definitions $lexicals))
       (case $old
         ((($one) (if (== $old $new) $marker (GraphDiscoveryDifference $marker $old $new)))
          ($other (GraphDiscoveryReferenceMultiplicity $marker $other)))))))
(= (graph-discovery:read $marker $read $authority)
   (case $read
     (((BNF:ReadValue (BNF:GrammarDocument $_binding $_source $document))
        (case (bnf:admit-grammar-input (bnf-v1:grammar-input $document $authority))
          (((BNF:GrammarInputAdmitted $input)
             (case (bnf:validate-declarations $input)
               (((BNFDeclarationValidationAcceptedV1 $start $definitions $lexicals)
                  (graph-discovery:compare $marker $start $definitions $lexicals))
                ($other (GraphDiscoveryDeclarationRefused $marker $other)))))
           ($other (GraphDiscoveryInputRefused $marker $other)))))
      ($other (GraphDiscoveryReadRefused $marker $other)))))
(= (graph-discovery:text $marker $text)
   (graph-discovery:read $marker (bnf:read-text $text) (bnf:default-authority "s")))

!(graph-discovery:text GraphDiscoveryLiteralV1 "<s> ::= \"x\"\n")
!(graph-discovery:text GraphDiscoveryDyckV1 "<s> ::= \"(\" <s> \")\" <s> |\n")
!(graph-discovery:text GraphDiscoveryForwardChainV1 "<s> ::= <a>\n<a> ::= <b>\n<b> ::= \"x\"\n")
!(graph-discovery:text GraphDiscoveryReverseChainV1 "<b> ::= \"x\"\n<a> ::= <b>\n<s> ::= <a>\n")
!(graph-discovery:text GraphDiscoverySeededCycleV1 "<s> ::= <a>\n<a> ::= <s> |\n")
!(graph-discovery:text GraphDiscoveryUnseededCycleV1 "<s> ::= <a>\n<a> ::= <s>\n")
!(graph-discovery:text GraphDiscoveryUnreachableV1 "<s> ::= \"x\"\n<a> ::= <a>\n<b> ::= \"y\"\n")
!(graph-discovery:text GraphDiscoveryDuplicateReferencesV1 "<s> ::= <a> <a> | <a>\n<a> ::=\n")
!(graph-discovery:text GraphDiscoveryAmbiguousV1 "<s> ::= <s> <s> | \"a\" | \"a\"\n")
!(graph-discovery:text GraphDiscoveryUnicodeV1 "<s> ::= <a>\n<a> ::= \"λ雪😀\"\n")
!(graph-discovery:text GraphDiscoveryIndependentSeedsV1 "<s> ::= <a> <b> <c>\n<a> ::= \"a\"\n<b> ::= \"b\"\n<c> ::= \"c\"\n")
!(graph-discovery:text GraphDiscoveryDiamondV1 "<s> ::= <a> <b> <c>\n<a> ::= <d>\n<b> ::= <d>\n<c> ::= \"c\"\n<d> ::= \"d\"\n")
!(graph-discovery:text GraphDiscoverySameRoundCascadeV1 "<s> ::= <a> <b> <c>\n<a> ::= \"a\"\n<b> ::= <a>\n<c> ::= <b> | \"c\"\n")
!(graph-discovery:text GraphDiscoveryDeferredEarlierV1 "<s> ::= <a> <c>\n<a> ::= <b>\n<b> ::= \"b\"\n<c> ::= \"c\"\n")
!(graph-discovery:text GraphDiscoveryMultiplePendingRoundsV1 "<s> ::= <a> <b> <c> <d>\n<a> ::= <b>\n<b> ::= <d>\n<c> ::= <d>\n<d> ::=\n")
!(graph-discovery:text GraphDiscoveryManyAlternativesV1 "<s> ::= <a> <b> | <c> <d>\n<a> ::= <d> | <b>\n<b> ::= <d>\n<c> ::= <a>\n<d> ::=\n")
!(graph-discovery:read GraphDiscoverySelfV1
   (bnf:read-file "langdef/bnf/plain_bnf_self_v1.bnf") (bnf:self-authority-v1))
