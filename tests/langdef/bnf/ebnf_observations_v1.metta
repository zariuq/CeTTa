!(import! &self ../../../lib/lib_bnf.metta)

(= (ebnf-test:count (EBNF:DerivationsNil)) 0)
(= (ebnf-test:count (EBNF:DerivationsCons $tree $rest)) (+ 1 (ebnf-test:count $rest)))
(= (ebnf-test:observe (EBNF:SourceParse $outcome $binding $source $receipt))
   (ebnf-test:observe $outcome))
(= (ebnf-test:observe (EBNF:Accepted $binding $source $trees))
   (accepted (ebnf-test:count $trees)))
(= (ebnf-test:observe (EBNF:Rejected $binding $source $offset $expected))
   (rejected $offset))
(= (ebnf-test:observe (EBNF:Incomplete $binding $source $outcome $detail))
   incomplete)
(= (ebnf-test:observe (EBNF:Cyclic $binding $source $accepted $digest))
   (cyclic $accepted))
(= (ebnf-test:handle (EBNF:SourceParser $handle $binding $source $receipt)) $handle)
(= (ebnf-test:handle (EBNF:Parser $handle $receipt)) $handle)
(= (ebnf-test:probe $grammar $word)
   (let $parser (bnf:parser-from-ebnf-text $grammar "s")
     (case $parser
       (((EBNF:SourceParser $handle $binding $source $receipt)
          (let $result (bnf:parse-ebnf-text $parser $word)
            (let $_ (bnf:close-ebnf-parser $parser) (ebnf-test:observe $result))))
        ((BNF:ReadRejected ebnf-source-syntax $offset $expected)
          (syntax-rejected $offset (> (size-atom $expected) 0)))
        ((BNF:ParserNotLoaded
           (BNFDiagnosticsConsV1 (BNFUnresolvedReferenceV1 $owner $name $span)
             BNFDiagnosticsNilV1))
          (unresolved (bnf:text->string $name) $span))
        ($failure $failure)))))

!(ebnf-test:probe "<s> ::= \"x\"?\n" "")
!(ebnf-test:probe "<s> ::= \"x\"?\n" "x")
!(ebnf-test:probe "<s> ::= \"x\"?\n" "xx")
!(ebnf-test:probe "<s> ::= \"x\"*\n" "")
!(ebnf-test:probe "<s> ::= \"x\"*\n" "xxx")
!(ebnf-test:probe "<s> ::= \"x\"+\n" "")
!(ebnf-test:probe "<s> ::= \"x\"+\n" "xxx")
!(ebnf-test:probe "<s> ::= (\"x\" | \"x\")?\n" "x")
!(ebnf-test:probe "<s> ::= (\"x\" | \"x\")*\n" "xx")
!(ebnf-test:probe "<s> ::= (\"x\" | \"x\")+\n" "xx")
!(ebnf-test:probe "<s> ::= \"\"?\n" "")
!(ebnf-test:probe "<s> ::= (\"λ\" | \"雪\")+ \"!\"?\n" "λ雪!")
!(ebnf-test:probe "<s> ::= \"(\" <s>* \")\"\n" "(()())")
!(ebnf-test:probe "<s> ::= <s> \"x\" | \"y\"\n" "yxx")
!(ebnf-test:probe "<s> ::= (\"x\"?)?\n" "")
!(ebnf-test:probe "<s> ::= (\"x\"?)?\n" "x")
!(ebnf-test:probe "<s> ::= (\"x\"+)?\n" "xx")
!(ebnf-test:probe "<s> ::= \"x\"**\n" "x")
!(ebnf-test:probe "<s> ::= (\"x\"\n" "x")
!(ebnf-test:probe "<s> ::= <missing>?\n" "")

; Infinite derivations must never be reported as one or zero parses.
!(ebnf-test:probe "<s> ::= \"\"*\n" "")
!(ebnf-test:probe "<s> ::= (\"x\"?)*\n" "x")
!(ebnf-test:probe "<s> ::= \"\"+\n" "")
