(** The symbols the lexer reads whole. *)
Binder exists! , := exu.
Axiom y1 : x :e X.
Axiom y2 : x /:e X.
Axiom y3 : X c= Y.
Axiom y4 : X /c= Y.
Axiom y5 : x <> y.
Axiom y6 : p -> q.
Axiom y7 : p <-> q.
Axiom y8 : p <=> q.
Axiom y9 : p /\ q \/ r.
Axiom y10 : ~ p.
Axiom y11 : x + y * z ^ w - v.
Axiom y12 : x >= y.
Axiom y13 : x <= y.
Axiom y14 : x < y.
Axiom y15 : x > y.
Axiom y16 : exists! x, p.
