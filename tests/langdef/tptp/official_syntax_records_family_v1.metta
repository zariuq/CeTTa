!(import! &self ../../../lib/lib_tptp.metta)
!(import! &self ../../../lib/lib_bnf.metta)
!(import! &self ../../../langdef/tptp/official_prepared_reader_v1.metta)
!(import! &self system)

(= (family-test:name-text (tptp-rec:name-word (tptp-rec:word-lower $text))) $text)
(= (family-test:name-text (tptp-rec:name-word (tptp-rec:word-quoted $text))) $text)
(= (family-test:name-text (tptp-rec:name-integer $text)) $text)
(= (family-test:input-name (tptp-rec:fof $name $_role $_formula $_ann $_span))
   (family-test:name-text $name))
(= (family-test:input-name (tptp-rec:cnf $name $_role $_formula $_ann $_span))
   (family-test:name-text $name))
(= (family-test:input-name (tptp-rec:tff $name $_role $_formula $_ann $_span))
   (family-test:name-text $name))
(= (family-test:input-name (tptp-rec:thf $name $_role $_formula $_ann $_span))
   (family-test:name-text $name))
(= (family-test:input-name (tptp-rec:tcf $name $_role $_formula $_ann $_span))
   (family-test:name-text $name))
(= (family-test:input-name (tptp-rec:tpi $name $_role $_formula $_ann $_span))
   (family-test:name-text $name))
(= (family-test:input-name (tptp-rec:include $file $_sel $_qual $_span)) include)
(= (family-test:input-kind (tptp-rec:fof $_n $_r $_f $_a $_s)) fof)
(= (family-test:input-kind (tptp-rec:cnf $_n $_r $_f $_a $_s)) cnf)
(= (family-test:input-kind (tptp-rec:tff $_n $_r $_f $_a $_s)) tff)
(= (family-test:input-kind (tptp-rec:thf $_n $_r $_f $_a $_s)) thf)
(= (family-test:input-kind (tptp-rec:tcf $_n $_r $_f $_a $_s)) tcf)
(= (family-test:input-kind (tptp-rec:tpi $_n $_r $_f $_a $_s)) tpi)
(= (family-test:input-kind (tptp-rec:include $_f $_s $_q $_p)) include)
(= (family-test:names (tptp-rec:file $inputs $_span))
   (family-test:input-names $inputs))
(= (family-test:input-names (tptp-rec:inputs-nil)) LNil)
(= (family-test:input-names (tptp-rec:inputs-cons $head $tail))
   (LCons (family-test:input-name $head) (family-test:input-names $tail)))
(= (family-test:kinds (tptp-rec:file $inputs $_span))
   (family-test:input-kinds $inputs))
(= (family-test:input-kinds (tptp-rec:inputs-nil)) LNil)
(= (family-test:input-kinds (tptp-rec:inputs-cons $head $tail))
   (LCons (family-test:input-kind $head) (family-test:input-kinds $tail)))
(= (family-test:first-kind (tptp-rec:file (tptp-rec:inputs-cons $head $_tail) $_span))
   (family-test:input-kind $head))
(= (family-test:has-kind-list $needle LNil) False)
(= (family-test:has-kind-list $needle (LCons $head $tail))
   (case (== $needle $head)
     ((True True)
      (False (family-test:has-kind-list $needle $tail)))))
(= (family-test:find-include (tptp-rec:file $inputs $_span))
   (family-test:find-include-inputs $inputs))
(= (family-test:find-include-inputs (tptp-rec:inputs-nil)) missing-include)
(= (family-test:find-include-inputs (tptp-rec:inputs-cons $head $tail))
   (case $head
     (((tptp-rec:include $file $sel $qual $span)
        (tptp-rec:include $file $sel $qual $span))
      ($_ (family-test:find-include-inputs $tail)))))
(= (family-test:name-list-texts (tptp-rec:names-nil)) LNil)
(= (family-test:name-list-texts (tptp-rec:names-cons $head $tail))
   (LCons (family-test:name-text $head) (family-test:name-list-texts $tail)))
(= (family-test:find-inference (tptp-rec:file $inputs $_span))
   (family-test:find-inference-inputs $inputs))
(= (family-test:find-inference-inputs (tptp-rec:inputs-nil)) missing-inference)
(= (family-test:find-inference-inputs (tptp-rec:inputs-cons $head $tail))
   (case $head
     (((tptp-rec:fof $_n $_r $_f (tptp-rec:annotation $source $_opt) $_s)
        (case $source
          (((tptp-rec:inference $rule $info $parents)
             (tptp-rec:inference $rule $info $parents))
           ($_ (family-test:find-inference-inputs $tail)))))
      ((tptp-rec:cnf $_n $_r $_f (tptp-rec:annotation $source $_opt) $_s)
        (case $source
          (((tptp-rec:inference $rule $info $parents)
             (tptp-rec:inference $rule $info $parents))
           ($_ (family-test:find-inference-inputs $tail)))))
      ($_ (family-test:find-inference-inputs $tail)))))
(= (family-test:row $tag $reader $path $expect-kind)
   (let $records (tptp:read-file $reader $path)
     (let $_ (println! (TptpFamilyRecords $tag $records))
       (let $kind (family-test:first-kind $records)
         (let $names (family-test:names $records)
           (case (== $kind $expect-kind)
             ((True (TptpFamilyRow $tag $kind $names))
              (False (TptpFamilyKindMismatch $tag $expect-kind $kind)))))))))
(= (family-test:row-has $tag $reader $path $expect-kind)
   (let $records (tptp:read-file $reader $path)
     (let $_ (println! (TptpFamilyRecords $tag $records))
       (let $kinds (family-test:kinds $records)
         (case (family-test:has-kind-list $expect-kind $kinds)
           ((True (TptpFamilyRow $tag $expect-kind (family-test:names $records)))
            (False (TptpFamilyKindMismatch $tag $expect-kind $kinds))))))))
(= (family-test:text $tag $reader $text $expected)
   (let $actual (tptp:read-text $reader $text)
     (case (== $actual $expected)
       ((True (TptpFamilyText $tag))
        (False (TptpFamilyTextMismatch $tag $expected $actual))))))
(= (family-test:pick $want (tptp-rec:inputs-nil)) missing)
(= (family-test:pick $want (tptp-rec:inputs-cons $head $tail))
   (case $head
     (((tptp-rec:thf $n $_r $f $_a $_s)
        (case (== (family-test:name-text $n) $want)
          ((True $f)
           (False (family-test:pick $want $tail)))))
      ((tptp-rec:fof $n $_r $f $_a $_s)
        (case (== (family-test:name-text $n) $want)
          ((True $f)
           (False (family-test:pick $want $tail)))))
      ((tptp-rec:cnf $n $_r $f $_a $_s)
        (case (== (family-test:name-text $n) $want)
          ((True $f)
           (False (family-test:pick $want $tail)))))
      ((tptp-rec:tcf $n $_r $f $_a $_s)
        (case (== (family-test:name-text $n) $want)
          ((True $f)
           (False (family-test:pick $want $tail)))))
      ($_ (family-test:pick $want $tail)))))
(= (family-test:head $formula)
   (case $formula
     (((tptp-rec:implies $l $r) implies)
      ((tptp-rec:exists $v $b) exists)
      ((tptp-rec:forall $v $b) (forall (family-test:head $b)))
      ((tptp-rec:or $l $r) (or (family-test:head $l) (family-test:head $r)))
      ((tptp-rec:not $b) not)
      ((tptp-rec:atom $p $a) atom)
      ($o other))))
(= (family-test:connectives $reader $path)
   (let $records (tptp:read-file $reader $path)
     (case $records
       (((tptp-rec:file $inputs $_span)
          (TptpFamilyConnectives
            (family-test:head (family-test:pick "thf_formula" $inputs))
            (family-test:head (family-test:pick "fof_formula" $inputs))
            (family-test:head (family-test:pick "cnf_formula" $inputs))
            (family-test:head (family-test:pick "tcf_formula" $inputs))))
        ($o (TptpFamilyConnectives missing))))))
(= (family-test:include-row $reader $path)
   (let $records (tptp:read-file $reader $path)
     (let $include (family-test:find-include $records)
       (case $include
         (((tptp-rec:include $file (tptp-rec:include-names $names) $qual $span)
            (case (family-test:has-kind-list "fof_formula"
                    (family-test:name-list-texts $names))
              ((True (TptpFamilyRow include include (family-test:names $records)))
               (False (TptpFamilyIncludeMismatch $include)))))
          ($_ (TptpFamilyIncludeMismatch $include)))))))
(= (family-test:inference-row $reader $path)
   (let $records (tptp:read-file $reader $path)
     (let $inf (family-test:find-inference $records)
       (case $inf
         (((tptp-rec:inference $rule $_info $parents)
            (TptpFamilyInference $rule $parents))
          ($_ (TptpFamilyInferenceMissing $inf)))))))
(= (family-test:run $reader)
   (let $empty
        (family-test:text empty $reader ""
          (tptp-rec:file (tptp-rec:inputs-nil) (tptp-rec:span 0 0)))
     (let $fof
          (family-test:text fof-atom $reader "fof(a,axiom,p)."
            (tptp-rec:file
              (tptp-rec:inputs-cons
                (tptp-rec:fof
                  (tptp-rec:name-word (tptp-rec:word-lower "a"))
                  (tptp-rec:role "axiom")
                  (tptp-rec:atom (tptp-rec:word-lower "p") (tptp-rec:terms-nil))
                  (tptp-rec:annotation-none)
                  (tptp-rec:span 0 15))
                (tptp-rec:inputs-nil))
              (tptp-rec:span 0 15)))
       (let $quoted
            (family-test:text quoted $reader "fof('X',axiom,p(X,'X'))."
              (tptp-rec:file
                (tptp-rec:inputs-cons
                  (tptp-rec:fof
                    (tptp-rec:name-word (tptp-rec:word-quoted "'X'"))
                    (tptp-rec:role "axiom")
                    (tptp-rec:atom (tptp-rec:word-lower "p")
                      (tptp-rec:terms-cons (tptp-rec:var (tptp-rec:word-upper "X"))
                        (tptp-rec:terms-cons
                          (tptp-rec:fun (tptp-rec:word-quoted "'X'") (tptp-rec:terms-nil))
                          (tptp-rec:terms-nil))))
                    (tptp-rec:annotation-none)
                    (tptp-rec:span 0 24))
                  (tptp-rec:inputs-nil))
                (tptp-rec:span 0 24)))
         (let $cnf-text
              (family-test:text cnf-or $reader "cnf(c,axiom,(~p(X) | q(X)))."
                (tptp-rec:file
                  (tptp-rec:inputs-cons
                    (tptp-rec:cnf
                      (tptp-rec:name-word (tptp-rec:word-lower "c"))
                      (tptp-rec:role "axiom")
                      (tptp-rec:or
                        (tptp-rec:not
                          (tptp-rec:atom (tptp-rec:word-lower "p")
                            (tptp-rec:terms-cons (tptp-rec:var (tptp-rec:word-upper "X"))
                              (tptp-rec:terms-nil))))
                        (tptp-rec:atom (tptp-rec:word-lower "q")
                          (tptp-rec:terms-cons (tptp-rec:var (tptp-rec:word-upper "X"))
                            (tptp-rec:terms-nil))))
                      (tptp-rec:annotation-none)
                      (tptp-rec:span 0 28))
                    (tptp-rec:inputs-nil))
                  (tptp-rec:span 0 28)))
           (let $cnf (family-test:row cnf $reader (system:arg 1) cnf)
             (let $fof-file (family-test:row fof $reader (system:arg 2) fof)
               (let $tff (family-test:row tff $reader (system:arg 3) tff)
                 (let $thf (family-test:row thf $reader (system:arg 4) thf)
                   (let $txf (family-test:row txf $reader (system:arg 5) tff)
                     (let $tcf (family-test:row-has tcf $reader (system:arg 7) tcf)
                       (let $tpi (family-test:row tpi $reader (system:arg 7) tpi)
                         (let $include (family-test:include-row $reader (system:arg 7))
                           (let $inference (family-test:inference-row $reader (system:arg 7))
                             (TptpOfficialSyntaxRecordsFamilyV1Summary
                               $empty $fof $quoted $cnf-text
                               $cnf $fof-file $tff $thf $txf $tcf $tpi $include
                               $inference)))))))))))))))
(= (family-test:document
     (TPTP:StageValue extended-bnf-ast (TPTP:ExtendedBnfAst $_binding $source $document)))
   ($source $document))
(= (family-test:use $parser)
   (case $parser
     (((NativeHandle "cetta.tptp-reader.v1" $_id)
        (println! (family-test:run $parser)))
      ((EBNF:Parser $handle $_receipt)
        (let $summary (family-test:run (EBNF:Parser $handle $_receipt))
          (let $_ (bnf:close-ebnf-parser (EBNF:Parser $handle $_receipt))
            (println! $summary))))
      ($fault (println! (TptpFamilyReaderFailure $fault))))))
!(family-test:use (tptp:official-reader (system:arg 0)))
