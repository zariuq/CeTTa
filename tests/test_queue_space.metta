!(bind! &q (new-space queue))
!(assertEqualToResult (get-type &q) ((Space queue)))
!(assertEqualToResult (space-len &q) (0))
!(add-atom &q alpha)
!(add-atom &q beta)
!(add-atom &q gamma)
!(assertEqualToResult (space:queue:get &q 0) (alpha))
!(assertEqualToResult (space:queue:get &q 1) (beta))
!(assertEqualToResult (space:queue:get &q 2) (gamma))
!(assertEqualToResult (space:queue:peek &q) (alpha))
!(assertEqualToResult (get-atoms &q) (alpha beta gamma))
!(assertEqualToResult (space:queue:pop &q) (alpha))
!(assertEqualToResult (space:queue:peek &q) (beta))
!(remove-atom &q beta)
!(assertEqualToResult (get-atoms &q) (gamma))
!(add-atom &q delta)
!(assertEqualToResult (get-atoms &q) (gamma delta))
!(space:queue:truncate &q 1)
!(assertEqualToResult (space-len &q) (1))
!(assertEqualToResult (space:queue:peek &q) (gamma))

(= (queue-push-range $q $i $limit)
   (if (> $i $limit)
       done
       (let* (($_written (add-atom $q $i))
              ($next (+ $i 1)))
         (queue-push-range $q $next $limit))))

(= (queue-pop-count $q $n)
   (if (<= $n 0)
       done
       (let* (($dropped (space:queue:pop $q))
              ($rest (- $n 1)))
         (queue-pop-count $q $rest))))

!(bind! &q2 (new-space queue))
!(assertEqual (queue-push-range &q2 1 70) done)
!(assertEqual (queue-pop-count &q2 60) done)
!(assertEqualToResult (space:queue:peek &q2) (61))
!(assertEqual (queue-push-range &q2 71 120) done)
!(assertEqualToResult (space-len &q2) (60))
!(assertEqualToResult (space:queue:peek &q2) (61))
!(assertEqualToResult (space:queue:get &q2 0) (61))
!(assertEqualToResult (space:queue:get &q2 9) (70))
!(assertEqualToResult (space:queue:get &q2 10) (71))
!(assertEqualToResult (space:queue:get &q2 59) (120))
!(assertEqualToResult (space:queue:pop &q2) (61))
!(assertEqualToResult (space:queue:pop &q2) (62))
!(assertEqualToResult (space:queue:peek &q2) (63))
