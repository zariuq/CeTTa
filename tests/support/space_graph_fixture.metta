!(import! &self "../../examples/native_space_graph_server.metta")
(= (danger) (println! ACCIDENTAL_EXECUTION))
(= (space-graph:run Echo) Echo)

(= (space-graph:run (Query $path $collection $arity $plan $count $fuel $states))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ($cursor (kbg:open-space $view $collection $arity $plan 131072 $states))
         ($_ (store:close $view)) ($_ (store:close $owner)))
    (if (kbg:cursor? $cursor) (space-graph:drain $cursor $count $fuel 20000 ()) $cursor)))
(= (space-graph:drain $cursor $count $fuel $rounds $reversed)
  (if (== $rounds 0) (let $_ (kbg:close $cursor) (GraphUnfinishedV1 (list:reverse $reversed)))
    (case (kbg:page $cursor $count $fuel)
      (((KgPage $rows (KgMore $next))
        (space-graph:drain $next $count $fuel (- $rounds 1) (cons-atom $rows $reversed)))
       ((KgPage $rows (KgPaused $next))
        (space-graph:drain $next $count $fuel (- $rounds 1) (cons-atom $rows $reversed)))
       ((KgPage $rows (KgComplete $work)) (GraphCompleteV1 (list:reverse (cons-atom $rows $reversed)) $work))
       ((KgPage $rows (KgFailure $error $work)) (GraphFailedV1 $error $work))
       ($failure (let $_ (kbg:close $cursor) $failure))))))
