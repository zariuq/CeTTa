!(import! &self "../../lib/petta/kb_query.metta")
!(import! &self "kb_probe.metta")
(= (kbq-probe:effect) (add-atom &self (KqUnexpectedEffect)))

(= (kbq-probe:pages $cursor $count $fuel $rounds $reversed)
   (if (== $rounds 0)
       (let $closed (kbq:close $cursor) (KqStopped (list:reverse $reversed)))
     (case (kbq:page $cursor $count $fuel)
       (((KqPage $rows (KqMore $next))
         (kbq-probe:pages $next $count $fuel (- $rounds 1) (cons-atom $rows $reversed)))
        ((KqPage $rows (KqPaused $next))
         (kbq-probe:pages $next $count $fuel (- $rounds 1) (cons-atom $rows $reversed)))
        ((KqPage $rows (KqComplete $work)) (KqPages (list:reverse (cons-atom $rows $reversed)) $work))
        ((KqPage $rows (KqFailure $error $work))
         (KqFailedPages (list:reverse (cons-atom $rows $reversed)) $error $work))
        ($bad (let $closed (kbq:close $cursor) $bad))))))
(= (kbq-probe:first $cursor $count $fuel)
   (case (kbq:page $cursor $count $fuel)
     (((KqPage $rows (KqMore $next))
       (let* (($work (kbq:work $next)) ($closed (kbq:close $next))) (KqFirst $rows more $work)))
      ((KqPage $rows (KqPaused $next))
       (let* (($work (kbq:work $next)) ($closed (kbq:close $next))) (KqFirst $rows paused $work)))
      ((KqPage $rows (KqComplete $work)) (KqFirst $rows complete $work))
      ((KqPage $rows (KqFailure $error $work)) (KqFirstFailure $rows $error $work))
      ($bad (let $closed (kbq:close $cursor) $bad)))))
(= (kbq-probe:query $owner $view $plan $command)
   (case (kbq:open $view $plan 1048576)
     (((KqCursor $v $state $steps $keys $bytes)
       (let $cursor (KqCursor $v $state $steps $keys $bytes)
         (case $command
           (((Pages $count $fuel) (kbq-probe:pages $cursor $count $fuel 10000 ()))
            ((PagesWithPlan $count $fuel)
             (let $answer (kbq-probe:pages $cursor $count $fuel 10000 ()) (KqWithPlan $answer $plan)))
            ((FreeObservation $observation)
             (let* (($result (knowledge:scopes-on $view $observation)) ($closed (kbq:close $cursor)))
               (KqObservationCheck $result (get-metatype $observation))))
            ((InvalidViewRows $kind $hole)
             (let* (($query-closed (kbq:close $cursor))
                    ($invalid (case $kind
                      ((free $hole) (owner $owner)
                       (closed (let $view-closed (store:close $view) $view)))))
                    ($result (kbq:open $invalid (KqRows ()) 1024)))
               (KqValidation (if (knowledge:tagged? $result KqCursor 6) KqUnexpectedCursor $result)
                             (get-metatype $hole))))
            ((First $count $fuel) (kbq-probe:first $cursor $count $fuel))
            ((Held $changes $count $fuel)
             (let $committed (kb-probe:commit $owner $view (HeldQuery $changes) $changes
                               (kb:observe-empty $view))
               (KqHeld $committed (kbq-probe:pages $cursor $count $fuel 10000 ()))))
            ((Race $changes $decision)
             (let* (($read (kbq:observe $cursor))
                    ($answers (kbq-probe:pages $cursor 4 4 10000 ()))
                    ($first (kb-probe:commit $owner $view (QueryRaceFirst $changes) $changes
                              (kb:observe-empty $view)))
                    ($second (kb-probe:commit $owner $view (QueryRaceSecond $decision) $decision $read)))
               (KqRace $answers $first $second)))
            ((CloseThenStep)
             (let $closed (kbq:close $cursor) (kbq:step $cursor)))
            ($bad (let $closed (kbq:close $cursor) (KbRefused probe-command)))))))
      ($error $error))))
(= (kbq-probe:run $request)
   (case $request
     (((Effects) (size-atom (collapse (match &self (KqUnexpectedEffect) True))))
      ((Query $path $plan $command)
       (case (store:open $path "existing")
         (((StoreOpened $owner)
           (let $result
             (case (store:snapshot $owner)
               (((StoreSnapshot $view $epoch $revision)
                 (let* (($answer (kbq-probe:query $owner $view $plan $command))
                        ($view-closed (store:close $view))) $answer))
                ($error $error)))
             (let $owner-closed (store:close $owner) $result)))
          ($error $error))))
      ((ExplainQuery $plan) (kbq:explain $plan))
      ((CursorOperations $cursor)
       ((kbq:observe $cursor) (kbq:work $cursor) (kbq:close $cursor)
        (kbq:step $cursor) (kbq:page $cursor 1 1) (get-metatype $cursor)))
      ($ordinary (kb-probe:run $ordinary)))))
