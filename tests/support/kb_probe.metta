!(import! &self "../../lib/petta/kb.metta")
!(import! &self "kb_knowledge_probe.metta")
(= (kb-probe:pure-many $value) (superpose (one two)))
(= (kb-probe:run (MalformedMerge $left $right)) (kb:observe-merge $left $right))

(= (kb-probe:commit $owner $view $receipt $changes $observation)
   (kb:commit $owner $view $observation $receipt (KbChanges $changes) KbAccepted $changes 1048576))
(= (kb-probe:pages $cursor $count $reversed)
   (case (kb:query-page $cursor $count)
     (((KbPage $rows (KbMore $next))
       (kb-probe:pages $next $count (cons-atom $rows $reversed)))
      ((KbPage $rows (KbComplete $work)) (KbPages (list:reverse (cons-atom $rows $reversed)) $work))
      ($error $error))))
(= (kb-probe:at $owner $view $command)
   (case $command
     (((MalformedLists $value)
       (KbInputCheck (kb:edit $value) (kb:edits $value ())
         (kb:observe-facts $view $value 1024) (knowledge:observe $view $value 1024)
         (knowledge:prepare $value) (get-metatype $value)))
      ((OpenMutation $hole)
       (KbInputCheck (kb:edits (cons-atom $hole ()) ())
         (knowledge:prepare (cons-atom $hole ())) (get-metatype $hole)))
      ((ViewInfo)
       (let* (($before (store:view-info $view))
              ($written (kb-probe:commit $owner $view view-info-check
                           ((KbPut "view-info-row" "example" (1))) (kb:observe-empty $view)))
              ($after (store:view-info $view))
              ($closed (store:close $view))
              ($refused (store:view-info $view)))
         (KbViewInfoCheck $before $written $after $refused)))
      ((Commit $receipt $changes)
       (kb-probe:commit $owner $view $receipt $changes (kb:observe-empty $view)))
      ((ReplayOwner $mode $path $receipt $changes)
       (case $mode
         ((invalid (kb-probe:commit "not-an-owner" $view $receipt $changes (kb:observe-empty $view)))
          (closed (let $closed (store:close $owner)
                    (kb-probe:commit $owner $view $receipt $changes (kb:observe-empty $view))))
          (path (case (store:open $path "existing")
            (((StoreOpened $publisher)
              (let* (($answer (kb-probe:commit $publisher $view $receipt $changes (kb:observe-empty $view)))
                     ($closed (store:close $publisher))) $answer))
             ($error $error)))))))
      ((Select $selector) (kb:select $view $selector 1048576))
      ((Fact $id) (kb:fact $view $id 1048576))
      ((CorruptBody $key $fact)
       (case (store:encode $fact)
         (((StoreEncoded $body)
           (case (store:commit $owner $view (ops (put $key $body)))
             (((StoreSnapshot $new $epoch $revision) (let $closed (store:close $new) CorruptionFixtureReady))
              ($error $error))))
          ($error $error))))
      ((Pages $selector $size)
       (case (kb:query-open $view $selector 1048576)
         (((KbCursor $v $scan $position $prefix $bytes $rows $seen $decoded)
           (let* (($cursor (KbCursor $v $scan $position $prefix $bytes $rows $seen $decoded))
                  ($answer (kb-probe:pages $cursor $size ())) ($closed (kb:query-close $cursor))) $answer))
          ($error $error))))
      ((FirstPage $selector $size)
       (case (kb:query-open $view $selector 1048576)
         (((KbCursor $v $scan $position $prefix $bytes $rows $seen $decoded)
           (let* (($cursor (KbCursor $v $scan $position $prefix $bytes $rows $seen $decoded))
                  ($answer (case (kb:query-page $cursor $size)
                    (((KbPage $values (KbMore (KbCursor $v2 $s2 $p2 $f2 $b2 $n2 $seen2 $d2)))
                      (KbFirstPage $values KbMore (KbWork $n2 $seen2 $d2)))
                     ((KbPage $values (KbComplete $work)) (KbFirstPage $values KbComplete $work))
                     ($bad $bad))))
                  ($closed (kb:query-close $cursor))) $answer))
          ($error $error))))
      ((Race $selector $first $second)
       (let* (($observation (kb:observe-selector $view $selector))
              ($a (kb-probe:commit $owner $view (RaceFirst $selector $first) $first (kb:observe-empty $view)))
              ($b (kb-probe:commit $owner $view (RaceSecond $selector $second) $second $observation)))
         (KbRace $a $b)))
      ((PointRace $ids $selector $first $second)
       (let* (($points (kb:observe-facts $view $ids 1048576))
              ($selected (kb:observe-selector $view $selector))
              ($observation (kb:observe-merge $points $selected))
              ($a (kb-probe:commit $owner $view (PointRaceFirst $first) $first (kb:observe-empty $view)))
              ($b (kb-probe:commit $owner $view (PointRaceSecond $second) $second $observation)))
         (KbRace $a $b)))
      ((Held $selector $changes)
       (let* (($before (kb:select $view $selector 1048576))
              ($write (kb-probe:commit $owner $view held $changes (kb:observe-empty $view)))
              ($after (kb:select $view $selector 1048576)))
         (KbHeld $before $write $after)))
      ((ObserveWrongView $changes)
       (case (store:snapshot $owner)
         (((StoreSnapshot $other $epoch $revision)
           (let* (($observation (kb:observe-selector $other KbAll))
                  ($result (kb-probe:commit $owner $view wrong $changes $observation))
                  ($closed (store:close $other))) $result))
          ($error $error))))
      ($bad (KbRefused probe-command)))))
(= (kb-probe:run (Create $path)) (knowledge-probe:run (Create $path)))
(= (kb-probe:run (Explain $selector)) (kb:explain $selector))
(= (kb-probe:run (Equal $a $b)) (kb:equal $a $b))
(= (kb-probe:run (AlphaEqual $a $b)) (kb:alpha-equal $a $b))
(= (kb-probe:run (At $path $command))
   (case (store:open $path "existing")
     (((StoreOpened $owner)
       (let $answer
         (case (store:snapshot $owner)
           (((StoreSnapshot $view $epoch $revision)
             (let* (($result (kb-probe:at $owner $view $command)) ($view-closed (store:close $view))) $result))
            ($error $error)))
         (let $owner-closed (store:close $owner) $answer)))
      ($error $error))))
