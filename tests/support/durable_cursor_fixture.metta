!(import! &self (library durable_space))
!(import! &self (library lib_he))

(= (cursor-fixture:run Echo) Echo)
(= (cursor-fixture:run (BackupGuards $path $destination))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((NativeHandle $kind $identifier) $view)
         ($_ (assertEqual (store:backup (NativeHandle $kind (+ $identifier 0)) $destination)
                          (StoreRefused closed-view)))
         ($_ (assertEqual (store:backup $view "") (StoreRefused invalid-backup)))
         ($_ (assertEqual (store:backup $view $destination) (StoreBackedUp $epoch $revision)))
         ($_ (assertEqual (store:backup $view $destination) (StoreRefused conflict)))
         ($_ (store:close $view)) ($_ (store:close $owner))) BackupGuardsPassed))
(= (cursor-fixture:run FalseAssertion) (assertEqual 1 2))
(= (cursor-fixture:run (Create $path))
  (let* (((StoreOpened $owner) (store:open $path "create"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((KnowledgeCommittedV1 $created $same $r1) (durable-space:create $owner $view sample create))
         ((StoreSnapshot $base $e2 $r2) (store:snapshot $owner))
         ((KnowledgeCommittedV1 $inserted $e3 $r3)
          (durable-space:commit $owner $base sample seed
            ((SpaceInsertV1 a (edge alice bob)) (SpaceInsertV1 b (edge alice bob))
             (SpaceInsertV1 c (rel $x $x)) (SpaceInsertV1 d (danger))
             (SpaceInsertV1 e (= (inert-rule) (println! ACCIDENTAL_EXECUTION)))))))
    Created))
(= (danger) (println! ACCIDENTAL_EXECUTION))

(= (cursor-fixture:drain $query $sequence $reverse)
  (case (store:space-query-next $query $sequence 2 65536)
    (((StoreQueryRow $same $value $ids)
      (let* (($again (store:space-query-next $query $sequence 0 65536))
             ($_ (assertEqual (knowledge:same $again (StoreQueryRow $same $value $ids)) (KnowledgeEqualV1 True)))
             ($_ (assertEqual (store:space-query-checkpoint $query) StoreQueryCheckpointed)))
        (cursor-fixture:drain $query (+ $sequence 1) (cons-atom (Row $value $ids) $reverse))))
     (StoreQueryPaused
      (let $_ (store:space-query-checkpoint $query) (cursor-fixture:drain $query $sequence $reverse)))
     (StoreQueryEnd (Rows (list:reverse $reverse)))
     ($error $error))))

(= (cursor-fixture:run (Query $path $explicit))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((StoreQueryOpened $query $same $captured)
          (durable-space:cursor $view sample $row $row))
         ($_ (store:close $view)) ($_ (store:close $owner))
         ($answer (cursor-fixture:drain $query 0 ()))
         ($_ (if $explicit (store:close $query) Automatic))) $answer))

; Executable MeTTa reference: the ordinary matcher instantiates a quoted
; template as data. This exhaustive test oracle is not a paging implementation.
(= (cursor-fixture:run (Reference $path $pattern $template))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((StoreSpace $space $same $captured) (durable-space:capture $view sample))
         ($values (collapse (match $space $pattern (quote $template)))))
    (ReferenceRows $values)))
(= (cursor-fixture:run (QuerySpec $path $pattern $template))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((StoreQueryOpened $query $same $captured)
          (durable-space:cursor $view sample $pattern $template)))
    (cursor-fixture:drain $query 0 ())))

(= (cursor-fixture:run (Cancel $path $explicit))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((StoreQueryOpened $query $same $captured)
          (durable-space:cursor $view sample (edge alice $who) $who))
         ($_ (store:close $view)) ($_ (store:close $owner))
         ($_ (assertEqual (store:space-query-next $query 0 1 65536) StoreQueryPaused))
         ($_ (assertEqual (store:space-query-cancel $query) StoreQueryCancelled))
         ($_ (assertEqual (store:space-query-next $query 0 1 65536) StoreQueryCancelled))
         ($_ (if $explicit (store:close $query) Automatic))) Cancelled))

(= (cursor-fixture:run (Abandon $path))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((StoreQueryOpened $query $same $captured)
          (durable-space:cursor $view sample (edge alice $who) $who))
         ($_ (store:space-query-next $query 0 1 65536))) Abandoned))

(= (cursor-fixture:run (Guards $path))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((StoreQueryOpened $query $same $captured)
          (durable-space:cursor $view sample (edge alice $who) $who))
         ((NativeHandle $kind $identifier) $query)
         ($_ (assertEqual (store:space-query-next (NativeHandle $kind (+ $identifier 0)) 0 1 65536)
                         (StoreRefused closed-or-busy-query)))
         ($_ (assertEqual (store:space-query-next $query 3 0 65536) StoreQueryStale))
         ($_ (assertEqual (store:space-query-next $query 0 -1 65536) (StoreRefused invalid-space-query)))
         ($_ (store:close $query))
         ($_ (assertEqual (store:space-query-checkpoint $query) (StoreRefused closed-or-busy-query)))) GuardsPassed))
