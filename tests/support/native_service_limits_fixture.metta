!(import! &self "../../examples/native_kb_server.metta")
(= (service-limits:configuration)
  (let (ValueServiceV1 $socket $data $routes $limits) (kb-server:configuration)
    (ValueServiceV1 $socket $data $routes (ServiceLimitsV1 2 3 4096 200 1048576 1000000))))
(= (service-limits:budget)
  (let (ValueServiceV1 $socket $data $routes $limits) (kb-server:configuration)
    (ValueServiceV1 $socket $data $routes (ServiceLimitsV1 2 3 4096 200 1 1000000))))
(= (service-limits:failure)
  (let (ValueServiceV1 $socket $data $routes $limits) (kb-server:configuration)
    (ValueServiceV1 $socket $data
      ((ServiceRouteV1 Exhaust Read service-limits:loop)
       (ServiceRouteV1 Multiple Read service-limits:multiple)
       (ServiceRouteV1 Empty Read service-limits:empty))
      (ServiceLimitsV1 2 3 4096 1000 1048576 2000))))
(= (service-limits:loop $input) (service-limits:loop $input))
(= (service-limits:multiple $input) (superpose (first second)))
(= (service-limits:empty $input) (empty))
