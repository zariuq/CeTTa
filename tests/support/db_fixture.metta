!(import! &self (library db))

(= (db-fixture:run (ActTransfer $path))
  (let* (($owner (db:open (str:concat $path "-act-source")))
         ($_ (assertEqual (db:add $owner (edge a b)) True))
         ($_ (assertEqual (db:add $owner (edge a b)) True))
         ($_ (assertEqual (db:export-act $owner (str:concat $path ".cact")) True))
         ($_ (db:close $owner))
         ($restored (db:open (str:concat $path "-act-target")))
         ($_ (assertEqual (db:import-act $restored (str:concat $path ".cact")) True))
         ($view (db:snapshot $restored))
         ($_ (assertEqual (collapse (match $view (edge a $to) $to)) (b b)))
         ($_ (db:close $view))
         ($_ (db:close $restored))) DB_ACT_TRANSFER_OK))
!(import! &self (library lib_he))

(= (db-fixture:run (Basic $path))
  (let* (($db (db:open $path))
         ($before (db:snapshot $db))
         ($answers (collapse (db:transaction $db (|-> ($space)
           (let* (($_ (add-atom $space (edge a b)))
                  ($_ (add-atom $space (edge a b)))
                  ($_ (add-atom $space (edge b c)))
                  ($_ (add-atom $space (rel $shared $shared)))
                  ($_ (add-atom $space (= (saved) (println! SHOULD_NOT_EXECUTE)))))
             (match $space (edge a $next) $next))))))
         ($_ (assertEqual $answers (b b)))
         ($after (db:snapshot $db))
         ($_ (assertEqual (collapse (get-atoms $before)) ()))
         ($_ (assertEqual (collapse (match $after (, (edge a $x) (edge $x c)) $x)) (b b)))
         ($_ (assertEqual (collapse (match $after (rel 1 2) no)) ()))
         ($_ (assertEqual (collapse (match $after (rel 1 1) yes)) (yes)))
         ($_ (assertEqual (db:close $db) True))
         ($_ (assertEqual (collapse (match $after (edge a $x) $x)) (b b)))
         ($_ (assertEqual (db:close $before) True))
         ($_ (assertEqual (db:close $after) True))) DB_BASIC_OK))

(= (db-fixture:run (Read $path))
  (let* (($db (db:open $path)) ($space (db:snapshot $db))
         ($_ (assertEqual (collapse (match $space (edge a $x) $x)) (b b)))
         ($_ (assertEqual (collapse (match $space (, (edge a $x) (edge $x c)) $x)) (b b)))
         ($_ (assertEqual (db:close $space) True)) ($_ (assertEqual (db:close $db) True))) DB_REOPEN_OK))

(= (db-fixture:run (Rollback $path))
  (let* (($db (db:open $path))
         ($empty (db:transaction-result $db data aborted empty-body (|-> ($space)
           (let $_ (add-atom $space (not-committed empty)) (empty)))))
         ($_ (assertEqual $empty (db:aborted aborted)))
         ($failed (catch (db:transaction-result $db data failed error-body (|-> ($space)
           (let $_ (add-atom $space (not-committed error)) (Error requested rollback))))))
         ($_ (assertEqual $failed (Error requested rollback)))
         ($unportable (catch (db:transaction-result $db data unportable return-space (|-> ($space)
           (let $_ (add-atom $space (not-committed resource)) $space)))))
         ($_ (assertEqual (knowledge:tagged? $unportable Error 3) True))
         ($view (db:snapshot $db))
         ($_ (assertEqual (collapse (match $view (not-committed $why) $why)) ()))
         ($_ (assertEqual (db:close $view) True)) ($_ (assertEqual (db:close $db) True))) DB_ROLLBACK_OK))

(= (db-fixture:run (Replay $path))
  (let* (($db (db:open $path))
         ($first (db:transaction-result $db data repeat-request (insert edge) (|-> ($space)
           (let* (($_ (fs:write (str:concat $path "/replay-effect") "first"))
                  ($_ (add-atom $space (once a b)))) (superpose (alpha beta beta))))))
         ((db:committed repeat-request (alpha beta beta)) $first)
         ($first-effect-hash (str:sha256 (fs:read-text (str:concat $path "/replay-effect"))))
         ($again (db:transaction-result $db data repeat-request (insert edge) (|-> ($space)
           (let* (($_ (fs:write (str:concat $path "/replay-effect") "repeated"))
                  ($_ (add-atom $space (SHOULD_NOT_EXECUTE replay)))) wrong))))
         ((db:replayed repeat-request (alpha beta beta)) $again)
         (True (== (str:sha256 (fs:read-text (str:concat $path "/replay-effect"))) $first-effect-hash))
         ($collision (catch (db:transaction-result $db data repeat-request different-operation (|-> ($space)
           (let $_ (add-atom $space (SHOULD_NOT_EXECUTE collision)) wrong)))))
         ((Error db:transaction (KnowledgeRefusedV1 receipt-collision)) $collision)
         ($space (db:snapshot $db))
         ((b) (collapse (match $space (once a $x) $x)))
         (() (collapse (match $space (SHOULD_NOT_EXECUTE $x) $x)))
         (True (db:close $space)) (True (db:close $db))) DB_REPLAY_OK))

(= (db-fixture:run (ReplayRead $path))
  (let* (($db (db:open $path))
         ($recovered (db:transaction-result $db data repeat-request (insert edge) (|-> ($space)
           (let $_ (add-atom $space (SHOULD_NOT_EXECUTE restart)) wrong))))
         ($_ (assertEqual $recovered (db:replayed repeat-request (alpha beta beta))))
         ($space (db:snapshot $db))
         ($_ (assertEqual (collapse (match $space (once a $x) $x)) (b)))
         ($_ (assertEqual (collapse (match $space (SHOULD_NOT_EXECUTE $x) $x)) ()))
         ($_ (assertEqual (db:close $space) True)) ($_ (assertEqual (db:close $db) True))) DB_RESTART_REPLAY_OK))

(= (db-fixture:run (Named $path))
  (let* (($db (db:open $path))
         ($_ (assertEqual (db:ensure $db indexed ((SpaceIndexV1 3 1))) True))
         ($_ (assertEqual (db:ensure $db indexed ((SpaceIndexV1 3 1))) True))
         ($_ (db:transaction $db indexed (|-> ($space)
           (let $_ (add-atom $space (named key value)) done))))
         ($space (db:snapshot $db indexed))
         ($_ (assertEqual (collapse (match $space (named key $value) $value)) (value)))
         ($_ (assertEqual (db:close $space) True)) ($_ (assertEqual (db:close $db) True))) DB_NAMED_OK))

(= (db-fixture:run (Invalidate $path))
  (let* (($db (db:open $path)) ($ordinary (new-space))
         ($_ (add-atom $ordinary (control old)))
         ($result (catch (db:transaction-result $db data invalidated ordinary-read (|-> ($space)
           (let* (($_ (assertEqual (collapse (match $ordinary (control $v) $v)) (old)))
                  ($_ (add-atom $space (not-committed stale)))
                  ($_ (add-atom $ordinary (control new)))) done)))))
         ($_ (assertEqual $result (Error db:transaction (StoreRefused edit-read-invalidated))))
         ($space (db:snapshot $db))
         ($_ (assertEqual (collapse (match $space (not-committed stale) yes)) ()))
         ($_ (assertEqual (collapse (match $ordinary (control $v) $v)) (old new)))
         ($_ (assertEqual (db:close $space) True)) ($_ (assertEqual (db:close $db) True))) DB_INVALIDATION_OK))

(= (db-fixture:run (Escape $path))
  (let* (($db (db:open $path))
         ((StoreSnapshot $view $_ $_) (store:snapshot $db))
         ((KnowledgeAddressV1 $key) (durable-space:metadata data))
         ((StoreProgramWatch $watch) (store:program-watch-open))
         ((StoreSpaceEdited ($escaped) ((escape saved)) ())
           (store:space-edit $view $key (|-> ($space)
             (let $_ (add-atom $space (escape saved)) $space)) $watch))
         ($_ (assertEqual (store:space-changes $escaped $view $key) (StoreRefused closed-space)))
         ($_ (store:close $watch)) ($_ (store:close $view))
         ($current (db:snapshot $db))
         ($_ (assertEqual (collapse (match $current (escape $x) $x)) ()))
         ($_ (assertEqual (db:close $current) True)) ($_ (assertEqual (db:close $db) True))) DB_ESCAPE_CLOSED_OK))

(= (db-fixture:run (Cycle $path))
  (let* (($db (db:open $path))
         ($_ (db:transaction $db (|-> ($space)
           (let* (($_ (add-atom $space (temporary value)))
                  ($_ (remove-atom $space (temporary value)))) done))))
         ($space (db:snapshot $db))
         ($_ (assertEqual (collapse (match $space (temporary $x) $x)) ()))
         ($_ (assertEqual (db:close $space) True)) ($_ (assertEqual (db:close $db) True))) DB_CYCLE_OK))

(= (db-fixture:run (SpaceRemove $path))
  (let* (($db (db:open $path))
         ($_ (db:transaction $db (|-> ($space)
           (let $_ (remove-atom $space (edge a b) 1) done))))
         ($one (db:snapshot $db))
         ($_ (assertEqual (collapse (match $one (edge a $x) $x)) (b)))
         ($_ (db:transaction $db (|-> ($space)
           (let $_ (remove-atom $space (edge a b)) done))))
         ($none (db:snapshot $db))
         ($_ (assertEqual (collapse (match $none (edge a $x) $x)) ()))
         ($_ (assertEqual (collapse (match $one (edge a $x) $x)) (b)))
         ($_ (db:close $one)) ($_ (db:close $none)) ($_ (db:close $db))) DB_REMOVE_OK))

!(import! &self (library fs))
(= (db-fixture:run (Interrupt $path $entered $gate))
  (let $db (db:open $path)
    (db:transaction $db (|-> ($space)
      (let* (($_ (add-atom $space (not-committed interrupted)))
             ($_ (fs:write $entered "entered"))
             ($_ (fs:read-text $gate))) done)))))
(= (db-fixture:run (VerifyInterrupt $path))
  (let* (($db (db:open $path)) ($space (db:snapshot $db))
         ($_ (assertEqual (collapse (match $space (not-committed interrupted) yes)) ()))
         ($_ (db:close $space)) ($_ (db:close $db))) DB_INTERRUPTED_REOPEN_OK))

(= (db-fixture:run (Page $path))
  (let* (($db (db:open $path))
         ($_ (db:transaction $db (|-> ($space)
           (let* (($_ (add-atom $space (page-item a)))
                  ($_ (add-atom $space (page-item a)))
                  ($_ (add-atom $space (page-item b)))) done))))
         ($query (db:query $db (page-item $x) $x))
         ((db:page-result () (db:paused $waiting)) (db:page $query 1 0))
         ((db:page-result ((db:row $first $first-identities)) (db:more $tail)) (db:page $waiting 1 1000))
         ($_ (db:transaction $db (|-> ($space) (let $_ (add-atom $space (page-item later)) done))))
         ($_ (db:close $db))
         ((db:page-result $rest db:complete) (db:page $tail 100 1000))
         ($_ (assertEqual (size-atom (cons-atom (db:row $first $first-identities) $rest)) 3))
         ($_ (assertEqual (== $first later) False))) DB_PAGE_OK))
(= (db-fixture:run (Resolve $path))
  (let* (($db (db:open $path))
         ($_ (assertEqual (db:resolve $db data repeat-request (insert edge))
               (db:resolved repeat-request (alpha beta beta))))
         ($_ (assertEqual (db:resolve $db data never-used missing) (db:unrecorded never-used)))
         ($_ (db:close $db))) DB_RESOLVE_OK))
(= (db-fixture:run (ReadCycle $path))
  (let* (($db (db:open $path)) ($space (db:snapshot $db))
         ($_ (collapse (match $space (page-item $x) $x)))
         ($_ (db:close $space)) ($_ (db:close $db))) DB_READ_CYCLE_OK))

(= (db-fixture:run (Convenience $path))
  (let* (($db (db:open $path))
         ($_ (db:add $db (convenient same)))
         ($_ (db:add $db (convenient same)))
         ($_ (db:remove $db (convenient same) 1))
         ($one (db:snapshot $db))
         ($_ (assertEqual (collapse (match $one (convenient $x) $x)) (same)))
         ($_ (db:remove $db (convenient same)))
         ($none (db:snapshot $db))
         ($_ (assertEqual (collapse (match $none (convenient $x) $x)) ()))
         ($_ (db:close $one)) ($_ (db:close $none)) ($_ (db:close $db))) DB_CONVENIENCE_OK))

(= (db-fixture:must-not-run) (println! SHOULD_NOT_EXECUTE))
(= (db-fixture:run (QueryData $path))
  (let* (($db (db:open $path))
         ($query (db:query $db (page-item a) (db-fixture:must-not-run)))
         ((db:page-result $rows db:complete) (db:page $query 100 1000))
         ($_ (assertEqual (size-atom $rows) 2))
         ((db:row $value $references) (car-atom $rows))
         ($_ (assertEqual $value (quote (db-fixture:must-not-run))))
         ($_ (db:close $db))) DB_QUERY_DATA_OK))

(= (db-fixture:run (LocalRead $path))
  (let* (($db (db:open $path))
         ($_ (db:transaction $db (|-> ($tx)
           (let* (($local (new-space))
                  ($_ (add-atom $local (observed yes)))
                  ($value (collapse (match $local (observed $v) $v)))
                  ($_ (add-atom $tx (local-read $value)))) done))))
         ($view (db:snapshot $db))
         ($_ (assertEqual (collapse (match $view (local-read $v) $v)) ((yes))))
         ($_ (db:close $view)) ($_ (db:close $db))) DB_LOCAL_READ_OK))

(= (db-fixture:run (CloseBody $path))
  (let* (($db (db:open $path))
         ($result (catch (db:transaction-result $db data body-close close-body (|-> ($space)
           (let* (($_ (add-atom $space (not-committed closed)))
                  ($_ (db:close $space))) done)))))
         ($_ (assertEqual $result (Error db:transaction (StoreRefused edit-workspace-closed))))
         ($view (db:snapshot $db))
         ($_ (assertEqual (collapse (match $view (not-committed closed) yes)) ()))
         ($_ (db:close $view)) ($_ (db:close $db))) DB_CLOSED_BODY_REFUSED_OK))

(= (db-fixture:run (Nested $path))
  (let* (($db (db:open $path)) ($alias (db:open $path))
         ($result (catch (db:transaction-result $db data outer-request outer (|-> ($space)
           (let* (($_ (add-atom $space (not-committed outer)))
                  ($inside (db:transaction $alias (|-> ($inner)
                    (let $_ (add-atom $inner (not-committed inner)) done))))) $inside)))))
         ($_ (assertEqual $result (Error db:transaction (StoreRefused nested-space-edit))))
         ($view (db:snapshot $db))
         ($_ (assertEqual (collapse (match $view (not-committed $who) $who)) ()))
         ($_ (db:close $view)) ($_ (db:close $alias)) ($_ (db:close $db))) DB_NESTED_REFUSED_OK))
(= (db-fixture:run (RawNested $path))
  (let* (($db (db:open $path))
         ($_ (db:transaction $db (|-> ($space)
           (let* (((StoreSnapshot $view $_ $_) (store:snapshot $db))
                  ($refused (store:commit $db $view (ops (put "rogue" "not-published"))))
                  ($_ (assertEqual $refused (StoreRefused write-during-space-edit)))
                  ($_ (store:close $view))
                  ($_ (add-atom $space (handled-refusal yes)))) done))))
         ((StoreSnapshot $view $_ $_) (store:snapshot $db))
         ($_ (assertEqual (store:get $view "rogue" 100) StoreAbsent))
         ($_ (store:close $view)) ($_ (db:close $db))) DB_RAW_NESTED_REFUSED_OK))

(= (db-fixture:run (OtherDomain $path))
  (let* (($db (db:open $path)) ($other (db:open (str:concat $path "-other")))
         ($result (catch (db:transaction-result $db data separate-domain outer (|-> ($space)
           (let* (($_ (add-atom $space (not-committed separate-domain)))
                  ($inside (db:transaction $other (|-> ($independent)
                    (let $_ (add-atom $independent (external committed)) done)))))
             (Error requested abort))))))
         ($_ (assertEqual (knowledge:tagged? $result Error 3) True))
         ($view (db:snapshot $db)) ($external (db:snapshot $other))
         ($_ (assertEqual (collapse (match $view (not-committed separate-domain) yes)) ()))
         ($_ (assertEqual (collapse (match $external (external $state) $state)) (committed)))
         ($_ (db:close $view)) ($_ (db:close $external)) ($_ (db:close $other)) ($_ (db:close $db))) DB_OTHER_DOMAIN_OK))

(= (db-fixture:run (RaisedError $path))
  (let* (($db (db:open $path))
         ($failed (catch (db:transaction-result $db data raised-body missing-file (|-> ($space)
           (let $_ (add-atom $space (not-committed raised))
             (fs:read-text (str:concat $path "/missing-input")))))))
         ($_ (assertEqual (knowledge:tagged? $failed Error 3) True))
         ($view (db:snapshot $db))
         ($_ (assertEqual (collapse (match $view (not-committed raised) yes)) ()))
         ($_ (db:close $view)) ($_ (db:close $db))) DB_RAISED_ERROR_OK))

(= (db-fixture:run (EntropyFailure $path $marker))
  (let* (($db (db:open $path))
         ($failed (catch (db:transaction $db (|-> ($space)
           (let* (($_ (fs:write $marker "called"))
                  ($_ (add-atom $space (not-committed entropy)))) done)))))
         ($_ (assertEqual (knowledge:tagged? $failed Error 3) True))
         ($ensured (catch (db:ensure $db needs-random ())))
         ($_ (assertEqual (knowledge:tagged? $ensured Error 3) True))
         ($_ (assertEqual (db:transaction-result $db data explicit-during-rng-fault explicit (|-> ($space)
               (let $_ (add-atom $space (explicit-id allowed)) done)))
               (db:committed explicit-during-rng-fault (done))))
         ($view (db:snapshot $db))
         ($_ (assertEqual (collapse (match $view (not-committed entropy) yes)) ()))
         ($_ (assertEqual (collapse (match $view (explicit-id $state) $state)) (allowed)))
         ($_ (db:close $view)) ($_ (db:close $db))) DB_ENTROPY_FAILURE_OK))
