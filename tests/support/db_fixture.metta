     (True True)
     ($failure $failure))))
(= (db-fixture:run (ActExportJob $path))
  (let* (($source (db:open (str:concat $path "-job-source")))
         ($_ (db:add $source (edge a b)))
         ($view (db:snapshot $source))
         ($job (act:export-open $view (str:concat $path ".job.cact") 1048576))
         ($_ (assertEqual (db:add $source (edge a newer)) True))
         ($cancelled (act:export-open $view (str:concat $path ".cancelled.cact") 1048576))
         ($_ (assertEqual (act:export-close $cancelled) True))
         ($_ (assertEqual (fs:exists (str:concat $path ".cancelled.cact")) False))
         ($_ (db:close $source))
         ($_ (db:close $view))
         ($_ (assertEqual (act:export-step $job 0) act:pending))
         ($_ (assertEqual (db-fixture:export-drive $job) True))
         ($_ (assertEqual (act:export-step $job 1) True))
         ($_ (assertEqual (act:export-close $job) True))
         ($file (db:open (str:concat $path ".job.cact")))
         ($_ (assertEqual (collapse (match (db:snapshot $file) (edge a $to) $to)) (b)))
         ($_ (db:close $file))) DB_ACT_EXPORT_JOB_OK))

(= (db-fixture:run (Candidates $path))
  (let* (($db (db:open (str:concat $path "-candidates")))
         ($_ (assertEqual (db:transaction $db (|-> ($space)
             (let* (($_ (add-atom $space (rel $shared $shared)))
                    ($_ (add-atom $space (rel $shared $shared)))) done))) done))
         ($space (db:snapshot $db))
         ((StoreSourceOpened $source $count $limit) (store:source-open $space))
         ($_ (assertEqual $count 2))
         ($_ (assertEqual (store:source-view $source) (StoreRefused source-has-no-publication-view)))
         ((StoreCandidateOpened $cursor $sequence) (store:source-candidates $source (rel one $to)))
         ($_ (assertEqual $sequence 0))
         ($_ (db:close $space)) ($_ (db:close $db))
         ($_ (assertEqual (store:close $source) StoreClosed))
         ($_ (assertEqual (store:candidate-next $cursor 0 0) StoreCandidatePaused))
         ((StoreCandidateRow $seq $body-bytes $id-bytes) (store:candidate-next $cursor 0 1))
         ($_ (assertEqual $seq 0))
         ((StoreCandidateChunk $_ body $_ $body) (store:candidate-read $cursor 0 body 0 $body-bytes))
         ((StoreDecoded $fact) (store:decode $body))
         ($_ (assertEqual (car-atom $fact) rel))
         ($_ (assertEqual (get-metatype (car-atom (cdr-atom $fact))) Variable))
         ((StoreEncoded $encoded) (store:encode $fact))
         ($_ (assertEqual $encoded $body))
         ((StoreCandidateOpened $copy $next) (store:candidate-clone $cursor current))
         ($_ (assertEqual $next 1))
         ($_ (assertEqual (store:close $cursor) StoreClosed))
         ($_ (assertEqual (store:candidate-next $copy 0 1) (StoreCandidateRow 0 $body-bytes $id-bytes)))
         ((StoreCandidateChunk $_ body $_ $same) (store:candidate-read $copy 0 body 0 $body-bytes))
         ($_ (assertEqual $same $body))
         ((StoreCandidateRow $second $_ $_) (store:candidate-next $copy 1 1))
         ($_ (assertEqual $second 1))
         ($_ (assertEqual (store:candidate-next $copy 2 1) StoreCandidateEnd))
         ((StoreCandidateOpened $rewound $zero) (store:candidate-clone $copy rewind))
         ($_ (assertEqual $zero 0))
         ((StoreCandidateRow $_ $_ $_) (store:candidate-next $rewound 0 1))
         ($_ (assertEqual (store:candidate-cancel $rewound) StoreCandidateCancelled))
         ($_ (assertEqual (store:candidate-next $rewound 0 1) StoreCandidateCancelled))
         ($_ (assertEqual (store:close $rewound) StoreClosed))
         ($_ (assertEqual (store:close $copy) StoreClosed))) DB_CANDIDATES_OK))

(= (db-fixture:run (SourceOrigin $path))
  (let* (($db (db:open (str:concat $path "-origin")))
         ($_ (db:add $db (origin old)))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $db))
         ((KnowledgeAddressV1 $key) (durable-space:metadata data))
         ((StoreSourceOpened $source $count $_) (store:source-open-view $view $key))
         ($_ (assertEqual $count 1))
         ($_ (assertEqual (store:close $view) StoreClosed))
         ($_ (db:add $db (origin newer)))
         ((StoreSnapshot $captured $same-epoch $same-revision) (store:source-view $source))
         ($_ (assertEqual $same-epoch $epoch))
         ($_ (assertEqual $same-revision $revision))
         ($space (store:source-space $source))
         ($_ (assertEqual (store:close $source) StoreClosed))
         ($_ (assertEqual (collapse (match $space (origin $value) $value)) (old)))
         ($_ (assertEqual (store:commit $db $captured (ops)) (StoreRefused conflict)))
         ($_ (assertEqual (store:close $captured) StoreClosed))
         ($_ (db:close $db))
         ($_ (assertEqual (collapse (match $space (origin $value) $value)) (old)))
         ($_ (db:close $space))) DB_SOURCE_ORIGIN_OK))
