         ((db:database-info (format 3) (epoch $epoch) (revision $revision)
             (base-bytes $_) (delta-bytes $_) (frozen-bytes $_) (has-base $_) (compacting $_)) (db:info $db))
         ($_ (assertEqual (db:compact $db) True))
         ((db:database-info (format $after-format) (epoch $after-epoch) (revision $after-revision)
             (base-bytes $bytes) (delta-bytes $_) (frozen-bytes $frozen-bytes) (has-base $has-base) (compacting $compacting)) (db:info $db))
         ($_ (assertEqual $after-format 3))
