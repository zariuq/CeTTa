         ($_ (assertEqual (collapse (match $old (act-maintenance $v) $v)) (saved saved)))
         ($_ (db:close $latest)) ($_ (db:close $fresh)) ($_ (db:close $old)) ($_ (db:close $db))) DB_ACT_MAINTENANCE_OK))

