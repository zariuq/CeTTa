!(import! &self (library db))

(= (db-fixture:compact-finish $job)
  (case (db:compact-step $job 4096)
    (((db:working $info) (db-fixture:compact-finish $job))
     ((db:complete $info) True)
     ($failure (assertEqual $failure expected-compaction-completion)))))
(= (db-fixture:run (CooperativeCompaction $path))
  (let* (($file (str:concat $path "-cooperative"))
         ($db (db:open $file))
         ($_ (assertEqual (db:add $db (edge a before)) True))
         ($before (db:snapshot $db))
         ($job (db:compact-open $db))
         ($_ (case (db:compact-step $job 1)
               (((db:working $info) True) ($wrong (assertEqual $wrong expected-yield)))))
         ($_ (assertEqual (db:add $db (edge a during)) True))
         ($during (db:snapshot $db))
         ($expected-order (collapse (match $during (edge a $v) $v)))
         ($before-query (db:query $db (edge a $v) $v))
         ((db:page-result $expected-rows db:complete) (db:page $before-query 10 100000))
         ($_ (db:close $db))
         ($_ (assertEqual (db-fixture:compact-finish $job) True))
         ($completed-info (db:compact-info $job))
         ($_ (assertEqual (db:compact-step $job 1) (db:complete $completed-info)))
         ($_ (assertEqual (db:close $job) True))
         ($again (db:open $file))
         ($after (db:snapshot $again))
         ($_ (assertEqual (collapse (match $before (edge a $v) $v)) (before)))
         ($_ (assertEqual (collapse (match $after (edge a $v) $v)) $expected-order))
         ($after-query (db:query $again (edge a $v) $v))
         ($_ (assertEqual (db:page $after-query 10 100000) (db:page-result $expected-rows db:complete)))
         ($cancel (db:compact-open $again))
         ($_ (assertEqual (db:compact-cancel $cancel) True))
         ($_ (assertEqual (db:compact $again) True))
         ($_ (db:close $before)) ($_ (db:close $during)) ($_ (db:close $after)) ($_ (db:close $again)))
    DB_COOPERATIVE_COMPACTION_OK))

(= (db-fixture:run (ActTransfer $path))
  (let* (($owner (db:open (str:concat $path "-act-source")))
         ($_ (assertEqual (db:add $owner (edge a b)) True))
         ($_ (assertEqual (db:add $owner (edge a b)) True))
         ($_ (assertEqual (db:export-act $owner (str:concat $path ".cact")) True))
         ($_ (db:close $owner))
         ($restored (db:open (str:concat $path "-act-target")))
         ($_ (assertEqual (db:import-act $restored (str:concat $path ".cact")) True))
         ($view (db:snapshot $restored))
         ($_ (assertEqual (collapse (match $view (edge a $to) $to)) (b b)))
         ($_ (db:close $view))
         ($_ (db:close $restored))) DB_ACT_TRANSFER_OK))
!(import! &self (library lib_he))

(= (db-fixture:run (Basic $path))
  (let* (($db (db:open $path))
         ($before (db:snapshot $db))
         ($answers (collapse (db:transaction $db (|-> ($space)
           (let* (($_ (add-atom $space (edge a b)))
                  ($_ (add-atom $space (edge a b)))
                  ($_ (add-atom $space (edge b c)))
                  ($_ (add-atom $space (rel $shared $shared)))
                  ($_ (add-atom $space (= (saved) (println! SHOULD_NOT_EXECUTE)))))
             (match $space (edge a $next) $next))))))
         ($_ (assertEqual $answers (b b)))
         ($after (db:snapshot $db))
         ($_ (assertEqual (collapse (get-atoms $before)) ()))
         ($_ (assertEqual (collapse (match $after (, (edge a $x) (edge $x c)) $x)) (b b)))
         ($_ (assertEqual (collapse (match $after (rel 1 2) no)) ()))
         ($_ (assertEqual (collapse (match $after (rel 1 1) yes)) (yes)))
         ($_ (assertEqual (db:close $db) True))
         ($_ (assertEqual (collapse (match $after (edge a $x) $x)) (b b)))
         ($_ (assertEqual (db:close $before) True))
         ($_ (assertEqual (db:close $after) True))) DB_BASIC_OK))

