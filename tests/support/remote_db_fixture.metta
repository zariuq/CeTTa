!(import! &self (library db))
!(import! &self (library fs))
!(import! &self (library lib_he))

(= (remote-fixture:run (Reads $socket))
  (let* (($db (db:connect $socket))
         ($snapshot (db:snapshot $db))
         ($_ (assertEqual (collapse (match $snapshot (edge a $to) $to)) (b b)))
         ($_ (assertEqual (collapse (match $snapshot (rel one one) yes)) (yes)))
         ($_ (assertEqual (collapse (match $snapshot (rel one two) yes)) ()))
         ($cursor (db:query $db (edge a $to) $to))
         ($_ (assertEqual (db:close $db) True))
         ($_ (assertEqual (collapse (match $snapshot (edge a $to) $to)) (b b)))
         ($_ (case (db:page $cursor 10 100000)
               (((db:page-result $rows db:complete) (assertEqual (size-atom $rows) 2))
                ($bad (assertEqual $bad expected-complete-page)))))
         ($_ (db:close $snapshot))) REMOTE_READS_OK))
(= (remote-fixture:run (Named $socket))
  (let* (($_ (db:connect claims $socket))
         ($snapshot (db:snapshot claims))
         ($_ (assertEqual (collapse (match $snapshot (edge a $to) $to)) (b b)))
         ($_ (db:close $snapshot)) ($_ (db:close claims))) REMOTE_NAMED_OK))

(= (remote-fixture:run (Transactions $socket))
  (let* (($db (db:connect $socket))
         ($effect (str:concat $socket "-client-effect"))
         ($_ (fs:write $effect ""))
         ($result (db:transaction-result $db data remote-once operation
           (|-> ($space)
             (let* (($_ (fs:append-text $effect "once"))
                    ($_ (add-atom $space (remote saved)))
                    ($_ (assertEqual (collapse (match $space (remote $v) $v)) (saved))))
               done))))
         ($_ (assertEqual $result (db:committed remote-once (done))))
         ($_ (assertEqual (fs:read-text $effect) "once"))
         ($_ (assertEqual (catch (db:transaction-result $db data remote-once different
                (|-> ($space) (println! ACCIDENTAL_EXECUTION))))
              (Error db:transaction (KnowledgeRefusedV1 receipt-collision))))
         ($_ (assertEqual (db:transaction-result $db data remote-once operation
                (|-> ($space) (println! ACCIDENTAL_EXECUTION)))
              (db:replayed remote-once (done))))
         ($_ (assertEqual (fs:read-text $effect) "once"))
         ($_ (assertEqual (db:transaction-result $db data remote-empty operation
                (|-> ($space) (let $_ (add-atom $space (remote rollback)) (empty))))
              (db:aborted remote-empty)))
         ($_ (assertEqual (db:add $db (remote saved)) True))
         ($snapshot (db:snapshot $db))
         ($_ (assertEqual (collapse (match $snapshot (remote $v) $v)) (saved saved)))
         ($_ (db:close $snapshot))
         ($_ (assertEqual (db:remove $db (remote saved) 1) True))
         ($latest (db:snapshot $db))
         ($_ (assertEqual (collapse (match $latest (remote $v) $v)) (saved)))
         ($_ (assertEqual (db:resolve $db data remote-once operation)
              (db:resolved remote-once (done))))
         ($_ (db:close $latest)) ($_ (db:close $db)))
    REMOTE_TRANSACTIONS_OK))

(= (remote-fixture:run (CloseBody $socket))
  (let* (($db (db:connect $socket))
         ($result (catch (db:transaction-result $db data closed body
           (|-> ($space)
             (let* (($_ (add-atom $space (not-committed closed)))
                    ($_ (db:close $space))) done)))))
         ($_ (assertEqual $result (Error db:transaction (StoreRefused edit-workspace-closed))))
         ($snapshot (db:snapshot $db))
         ($_ (assertEqual (collapse (match $snapshot (not-committed $v) $v)) ()))
         ($_ (db:close $snapshot)) ($_ (db:close $db))) REMOTE_CLOSED_BODY_OK))

(= (remote-fixture:run (Nested $socket))
  (let* (($db (db:connect $socket)) ($alias (db:connect $socket))
         ($result (catch (db:transaction-result $db data outer body
           (|-> ($space)
             (let $_ (add-atom $space (not-committed outer))
               (db:transaction $alias (|-> ($inner) (add-atom $inner (not-committed inner)))))))))
         ($_ (assertEqual $result (Error db:transaction (StoreRefused nested-or-invalid-source-edit))))
         ($snapshot (db:snapshot $db))
         ($_ (assertEqual (collapse (match $snapshot (not-committed $v) $v)) ()))
         ($_ (db:close $snapshot)) ($_ (db:close $alias)) ($_ (db:close $db))) REMOTE_NESTED_OK))
(= (remote-fixture:run (NestedActivation $socket $alias-socket))
  (let* (($db (db:connect $socket)) ($alias (db:connect $alias-socket))
         ($result (catch (db:transaction-result $db data outer-activation body
           (|-> ($space)
             (let $_ (add-atom $space (not-committed outer))
               (db:transaction $alias (|-> ($inner) (add-atom $inner (not-committed inner)))))))))
         ($_ (assertEqual $result (Error db:transaction (StoreRefused nested-or-invalid-source-edit))))
         ($snapshot (db:snapshot $db))
         ($_ (assertEqual (collapse (match $snapshot (not-committed $v) $v)) ()))
         ($_ (db:close $snapshot)) ($_ (db:close $alias)) ($_ (db:close $db))) REMOTE_ACTIVATION_BARRIER_OK))
(= (remote-fixture:run (OtherOwner $socket $other-socket))
  (let* (($db (db:connect $socket)) ($other (db:connect $other-socket))
         ($_ (assertEqual (db:transaction $db
                (|-> ($space)
                  (let $_ (db:add $other (outside committed))
                    (add-atom $space (inside committed))))) True))
         ($snapshot (db:snapshot $db)) ($foreign (db:snapshot $other))
         ($_ (assertEqual (collapse (match $snapshot (inside $v) $v)) (committed)))
         ($_ (assertEqual (collapse (match $foreign (outside $v) $v)) (committed)))
         ($_ (db:close $snapshot)) ($_ (db:close $foreign))
         ($_ (db:close $db)) ($_ (db:close $other))) REMOTE_OTHER_OWNER_OK))

(= (remote-fixture:run (LocalReads $socket))
  (let* (($db (db:connect $socket))
         ($local (new-space))
         ($_ (add-atom $local (observed yes)))
         ($_ (assertEqual (db:transaction $db
                (|-> ($space)
                  (let $read (collapse (match $local (observed $v) $v))
                    (add-atom $space (local-read $read))))) True))
         ($snapshot (db:snapshot $db))
         ($_ (assertEqual (collapse (match $snapshot (local-read $v) $v)) ((yes))))
         ($_ (db:close $snapshot))
         ($invalid (catch (db:transaction-result $db data invalidated body
           (|-> ($space)
             (let* (($read (collapse (match $local (observed $v) $v)))
                    ($_ (add-atom $local (observed changed)))
                    ($_ (add-atom $space (not-committed invalidated)))) done)))))
         ($_ (assertEqual $invalid (Error db:transaction (StoreRefused edit-read-invalidated))))
         ($_ (db:close $db))) REMOTE_LOCAL_READS_OK))

(= (remote-fixture:run (ReadOnly $socket))
  (let* (($db (db:connect $socket))
         ($effect (str:concat $socket "-must-not-exist"))
         ($_ (assertEqual (catch (db:transaction $db
                (|-> ($space) (fs:write $effect "ACCIDENTAL_EXECUTION"))))
              (Error db:transaction read-only)))
         ($_ (assertEqual (fs:exists $effect) False))
         ($_ (assertEqual (catch (db:compact-open $db)) (Error db:compact read-only)))
         ($snapshot (db:snapshot $db))
         ($_ (db:close $db))
         ($_ (assertEqual (> (size-atom (collapse (get-atoms $snapshot))) 0) True))
         ($_ (db:close $snapshot))) REMOTE_READ_ONLY_OK))

(= (remote-fixture:run (LostWrite $socket))
  (let* (($db (db:connect $socket))
         ($effect (str:concat $socket "-client-effect"))
         ($result (db:transaction-result $db data lost-write operation
           (|-> ($space)
             (let* (($_ (fs:append-text $effect "once"))
                    ($_ (add-atom $space (lost saved)))) done))))
         ($_ (assertEqual $result (db:uncertain lost-write data operation)))
         ($_ (db:close $db))) REMOTE_LOST_WRITE_OK))
(= (remote-fixture:run (ResolveLost $socket $effect))
  (let* (($db (db:connect $socket))
         ($result (db:transaction-result $db data lost-write operation
           (|-> ($space) (fs:append-text $effect "ACCIDENTAL_EXECUTION"))))
         ($_ (assertEqual $result (db:replayed lost-write (done))))
         ($_ (assertEqual (fs:read-text $effect) "once"))
         ($snapshot (db:snapshot $db))
         ($_ (assertEqual (collapse (match $snapshot (lost $v) $v)) (saved)))
         ($_ (db:close $snapshot)) ($_ (db:close $db))) REMOTE_RESOLVE_LOST_OK))
(= (remote-fixture:run (StaleWrite $socket))
  (let* (($db (db:connect $socket))
         ($effect (str:concat $socket "-client-effect"))
         ($result (catch (db:transaction-result $db data stale-write operation
           (|-> ($space)
             (let* (($absence (collapse (match $space (intervening $v) $v)))
                    ($_ (assertEqual $absence ()))
                    ($_ (fs:append-text $effect "once"))
                    ($_ (add-atom $space (not-committed stale)))) done)))))
         ($_ (assertEqual $result (Error db:transaction (StoreRefused conflict))))
         ($_ (assertEqual (fs:read-text $effect) "once"))
         ($_ (db:close $db))) REMOTE_STALE_WRITE_OK))
(= (remote-fixture:run (Interrupted $socket))
  (let* (($db (db:connect $socket))
         ($cursor (db:query $db (edge a $v) $v))
         ($_ (case (db:page $cursor 10 100000)
               (((db:page-result $rows (db:failed $why)) True)
                ($wrong (assertEqual $wrong expected-explicit-failure)))))
         ($_ (db:close $db))) REMOTE_INTERRUPTED_OK))

(= (remote-fixture:value (SpaceAnswerV1 $value $identities)) (quote $value))
(= (remote-fixture:run (Collections $socket))
  (let* (($db (db:connect $socket))
         ($_ (assertEqual (db:ensure $db other ()) True))
         ($_ (assertEqual (db:transaction $db other
                (|-> ($space) (add-atom $space (tag b old)))) True))
         ($cursor (db:query-plan $db
           (KqMap
             (KqBind (KqSpace data (edge a $key) $key)
               (SpaceAnswerV1 $key $references)
               (KqSpace other (tag $key $value) $value))
             remote-fixture:value)))
         ($_ (assertEqual (db:transaction $db other
                (|-> ($space) (add-atom $space (tag b newer)))) True))
         ($_ (assertEqual (db:page $cursor 10 100000)
              (db:page-result (old old) db:complete)))
         ($latest (db:query $db other (tag b $value) $value))
         ($_ (case (db:page $latest 10 100000)
               (((db:page-result $rows db:complete) (assertEqual (size-atom $rows) 2))
                ($wrong (assertEqual $wrong expected-complete-page)))))
         ($_ (db:close $db))) REMOTE_COLLECTIONS_OK))

(= (remote-fixture:compact-finish $job)
  (case (db:compact-step $job 4096)
    (((db:working $info) (remote-fixture:compact-finish $job))
     ((db:complete $info) True)
     ($wrong (assertEqual $wrong expected-maintenance-completion)))))
(= (remote-fixture:run (Maintenance $socket))
  (let* (($db (db:connect $socket))
         ($before (db:snapshot $db))
         ((DbCapturedContextV1 $identity $incarnation $revision data) (store:remote-observation $before))
         ($job (db:compact-open $db))
         ($_ (case (db:compact-step $job 1)
               (((db:working $info) True) ($wrong (assertEqual $wrong expected-yield)))))
         ($_ (assertEqual (db:add $db (edge a during-compaction)) True))
         ($during (db:snapshot $db))
         ($expected-order (collapse (match $during (edge a $v) $v)))
         ($before-query (db:query $db (edge a $v) $v))
         ((db:page-result $expected-rows db:complete) (db:page $before-query 10 100000))
         ($_ (db:close $db))
         ($_ (assertEqual (remote-fixture:compact-finish $job) True))
         ($completed-info (db:compact-info $job))
         ($_ (assertEqual (db:compact-step $job 1) (db:complete $completed-info)))
         ($_ (assertEqual (db:close $job) True))
         ($again (db:connect $socket))
         ($after (db:snapshot $again))
         ($_ (assertEqual (store:remote-observation $after)
              (DbCapturedContextV1 $identity $incarnation (+ $revision 1) data)))
         ($_ (assertEqual (collapse (match $before (edge a $v) $v)) (b b)))
         ($_ (assertEqual (collapse (match $after (edge a $v) $v)) $expected-order))
         ($after-query (db:query $again (edge a $v) $v))
         ($_ (assertEqual (db:page $after-query 10 100000) (db:page-result $expected-rows db:complete)))
         ($cancel (db:compact-open $again))
         ($_ (assertEqual (db:compact-cancel $cancel) True))
         ($_ (assertEqual (db:compact $again) True))
         ($_ (assertEqual (collapse (match $before (edge a $v) $v)) (b b)))
         ($_ (db:close $before)) ($_ (db:close $during)) ($_ (db:close $after)) ($_ (db:close $again)))
    REMOTE_MAINTENANCE_OK))

(= (remote-fixture:numbers $space)
  (let* (($_ (add-atom $space (number integer-kind 1)))
         ($_ (add-atom $space (number float-kind 1.0)))
         ($_ (add-atom $space (number exact-kind 9007199254740993)))
         ($_ (add-atom $space (number rounded-kind 9007199254740992.0)))
         ($_ (add-atom $space (number negative-kind -9)))) done))
(= (remote-fixture:run (Numbers $socket))
  (let* (($reference (new-space))
         ($_ (remote-fixture:numbers $reference))
         ($db (db:connect $socket))
         ($_ (assertEqual (db:ensure $db numbers ((SpaceIndexV1 3 0) (SpaceIndexV1 3 2))) True))
         ($_ (assertEqual (db:transaction $db numbers remote-fixture:numbers) done))
         ($snapshot (db:snapshot $db numbers))
         ($_ (assertEqual (collapse (match $snapshot (number $kind 1) $kind))
              (collapse (match $reference (number $kind 1) $kind))))
         ($_ (assertEqual (collapse (match $snapshot (number $kind 1.0) $kind))
              (collapse (match $reference (number $kind 1.0) $kind))))
         ($_ (assertEqual (collapse (match $snapshot (number $kind 9007199254740993) $kind))
              (collapse (match $reference (number $kind 9007199254740993) $kind))))
         ($_ (assertEqual (collapse (match $snapshot (number $kind 9007199254740992.0) $kind))
              (collapse (match $reference (number $kind 9007199254740992.0) $kind))))
         ($_ (db:close $snapshot)) ($_ (db:close $db))) REMOTE_NUMBERS_OK))

; Removing every match may read only the index's selection; a bounded removal
; takes the occurrences a scan takes, even when a row holding a variable at the
; indexed position precedes the rows with the exact key.
(= (remote-fixture:rows $space)
  (let* (($_ (add-atom $space (row k0 0))) ($_ (add-atom $space (row $v 5)))
         ($_ (add-atom $space (row k1 7))) ($_ (add-atom $space (row k2 0)))
         ($_ (add-atom $space (row k1 3))) ($_ (add-atom $space (row k1 9)))
         ($_ (add-atom $space (row k1 3)))) done))
(= (remote-fixture:remove-first $space)
  (let $_ (remove-atom $space (row k1 $x) 1) done))
(= (remote-fixture:remove-rest $space)
  (let* (($_ (add-atom $space (row $w 6))) ($_ (remove-atom $space (row k1 $x)))) done))
(= (remote-fixture:remove-one $space)
  (let $_ (remove-atom $space (number $kind 1)) done))
(= (remote-fixture:kinds $space)
  (collapse (let $kind (superpose (integer-kind float-kind exact-kind rounded-kind negative-kind))
    (if (== (collapse (match $space (number $kind $value) yes)) ()) () ($kind)))))
(= (remote-fixture:run (Removals $socket))
  (let* (($db (db:connect $socket))
         ($_ (assertEqual (db:ensure $db rows ((SpaceIndexV1 3 1))) True))
         ($_ (assertEqual (db:transaction $db rows remote-fixture:rows) done))
         ($_ (assertEqual (db:transaction $db rows remote-fixture:remove-first) done))
         ($first (db:snapshot $db rows))
         ($_ (assertEqual (collapse (match $first (row $key 5) $key)) ()))
         ($_ (assertEqual (size-atom (collapse (match $first (row k1 $n) $n))) 4))
         ($_ (db:close $first))
         ($_ (assertEqual (db:transaction $db rows remote-fixture:remove-rest) done))
         ($rest (db:snapshot $db rows))
         ($_ (assertEqual (size-atom (collapse (match $rest (row $key $n) $key))) 2))
         ($_ (assertEqual (collapse (match $rest (row $key 6) $key)) ()))
         ($_ (assertEqual (collapse (match $rest (row k0 $n) $n)) (0)))
         ($_ (db:close $rest))
         ($reference (new-space))
         ($_ (remote-fixture:numbers $reference))
         ($_ (remote-fixture:remove-one $reference))
         ($_ (assertEqual (db:ensure $db removed-numbers ((SpaceIndexV1 3 2))) True))
         ($_ (assertEqual (db:transaction $db removed-numbers remote-fixture:numbers) done))
         ($_ (assertEqual (db:transaction $db removed-numbers remote-fixture:remove-one) done))
         ($numbers (db:snapshot $db removed-numbers))
         ($_ (assertEqual (remote-fixture:kinds $numbers) (remote-fixture:kinds $reference)))
         ($_ (db:close $numbers)) ($_ (db:close $db))) REMOTE_REMOVALS_OK))

; Filler keyed by a symbol: the index keys symbols and strings exactly, and puts a
; number at the indexed position among the rows every lookup reads.
(= (remote-fixture:fill $space $n)
  (if (== $n 0) done
    (let $_ (add-atom $space (row filler $n)) (remote-fixture:fill $space (- $n 1)))))
(= (remote-fixture:remove-key $space)
  (let $_ (remove-atom $space (row k1 $x)) done))
(= (remote-fixture:run (RemoveCost $socket))
  (let* (($db (db:connect $socket))
         ($_ (assertEqual (db:ensure $db rows ((SpaceIndexV1 3 1))) True))
         ($_ (assertEqual (db:transaction $db rows (|-> ($space)
                (let $_ (add-atom $space (row k1 1)) (remote-fixture:fill $space 400)))) done))
         ($_ (assertEqual (db:transaction $db rows remote-fixture:remove-key) done))
         ($left (db:snapshot $db rows))
         ($_ (assertEqual (collapse (match $left (row k1 $n) $n)) ()))
         ($_ (db:close $left)) ($_ (db:close $db))) REMOTE_REMOVE_COST_OK))

; A publication of 1500 inserts commits within one call's evaluation budget: the
; repeated-occurrence check of its edit list is made once, not per change.
(= (remote-fixture:run (LargeTransaction $socket))
  (let* (($db (db:connect $socket))
         ($_ (assertEqual (db:ensure $db large ((SpaceIndexV1 3 1))) True))
         ($_ (assertEqual (db:transaction $db large (|-> ($space) (remote-fixture:fill $space 1500))) done))
         ($view (db:snapshot $db large))
         ($_ (assertEqual (size-atom (collapse (match $view (row filler $n) $n))) 1500))
         ($_ (db:close $view)) ($_ (db:close $db))) REMOTE_LARGE_TRANSACTION_OK))
