!(import! &self (library store))
!(import! &self (library str))
(= (kb-codec:produce $effects $value)
   (progn (add-atom $effects tick) $value))
(= (kb-codec:run (Encode $value)) (store:encode $value))
(= (kb-codec:run (Roundtrip $value))
   (case (store:encode $value)
     (((StoreEncoded $bytes) (store:decode $bytes)) ($error $error))))
(= (kb-codec:run (Produced $value))
   (let* (($effects (new-space))
          ($answer (store:encode (kb-codec:produce $effects $value)))
          ($count (size-atom (collapse (get-atoms $effects)))))
     (CodecObserved $answer $count)))
(= (kb-codec:reset)
   (let $removed (collapse (let $x (get-atoms &codec-effects) (remove-atom &codec-effects $x))) True))
(= (kb-codec:datum-call) (progn (add-atom &codec-effects executed-datum) "text"))
(= (kb-codec:record $value) (progn (add-atom &codec-effects produced) $value))
(= (kb-codec:run (TransactionProduced $value))
   (let* (($reset (kb-codec:reset))
          ($encoded (transaction (store:encode (kb-codec:record $value))))
          ($effects (collapse (get-atoms &codec-effects))))
     (CodecEffects $encoded $effects)))
(= (kb-codec:run (ErrorSibling $left $right))
   (let* (($reset (kb-codec:reset))
          ($answer (collapse (str:starts-with (kb-codec:record $left) (kb-codec:record $right))))
          ($effects (collapse (get-atoms &codec-effects))))
     (CodecEffects $answer $effects)))
(= (kb-codec:run (TransactionAdded $value))
   (transaction
     (let $added (add-atom &self (= (kb-codec:added $argument) $argument))
       (let $function kb-codec:added (store:encode ($function $value))))))
(= (kb-codec:run (NestedTransaction $value))
   (transaction (transaction (store:encode (kb-codec:record $value)))))
