!(import! &self (library durable_reindex))
(= (reindex-fixture:run (At $path $command))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner)))
    (case $command
      (((BatchErrors)
        (let* (((StoreBatch $batch) (store:batch-open $owner $view 1048576))
               ($_ (store:close $batch))
               ($info (store:batch-info $batch))
               ($commit (store:commit-batch $owner $view $batch))
               ($forged (store:batch-info (NativeHandle "disk-store-batch" 1))))
          (BatchErrorsV1 $info $commit $forged)))
       ((Reindex $request $maximum $steps)
        (case (durable-space:reindex-open $owner $view sample $request $maximum)
          (((SpaceReindexOpenedV1 $state) (reindex-fixture:drain $owner $state $steps 20000))
           ($prior $prior))))
       ((Cancel $request $maximum $steps)
        (case (durable-space:reindex-open $owner $view sample $request $maximum)
          (((SpaceReindexOpenedV1 $state)
            (case (durable-space:reindex-page $owner $state $steps)
              (((SpaceReindexMoreV1 $next $progress)
                (let $_ (durable-space:reindex-close $next) (ReindexCancelledV1 $progress)))
               ($terminal $terminal))))
           ($prior $prior))))
       ($bad (SpaceRefusedV1 fixture-command))))))
(= (reindex-fixture:drain $owner $state $steps $rounds)
  (if (== $rounds 0) (let $_ (durable-space:reindex-close $state) (ReindexUnfinishedV1))
    (case (durable-space:reindex-page $owner $state $steps)
      (((SpaceReindexMoreV1 $next $progress) (reindex-fixture:drain $owner $next $steps (- $rounds 1)))
       ($terminal $terminal)))))
