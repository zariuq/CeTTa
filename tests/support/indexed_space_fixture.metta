!(import! &self (library durable_space))
!(import! &self (library lib_he))
(: indexed-fixture:query (-> %Undefined% Atom Atom %Undefined%))
(: indexed-fixture:reference (-> %Undefined% Atom Atom %Undefined%))
(= (danger) (println! ACCIDENTAL_EXECUTION))

(= (indexed-fixture:run (Create $path $specs))
  (let* (((StoreOpened $owner) (store:open $path "create"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ($answer (durable-space:create-indexed $owner $view sample create $specs))) $answer))
(= (indexed-fixture:run (CreatePlain $path))
  (let* (((StoreOpened $owner) (store:open $path "create"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner)))
    (durable-space:create $owner $view sample create)))
(= (indexed-fixture:run (OrphanIndex $path $remove))
  (let* (((StoreOpened $owner) (store:open $path "create"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((KnowledgeAddressV1 $prefix) (durable-index:prefix sample 3 1))
         ($key (str:concat $prefix "/any/orphan"))
         ($operation (if $remove (remove $key) (put $key ""))))
    (case (store:commit $owner $view (ops $operation))
      (((StoreSnapshot $after $same $next) (OrphanIndexWritten $next))
       ($failure $failure)))))
(= (indexed-fixture:run (At $path $command))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner)))
    (case $command
      (((Commit $request $changes) (durable-space:commit $owner $view sample $request $changes))
       ((Query $pattern $template) (indexed-fixture:query $view $pattern $template))
       ((Info) (store:view-info $view))
       ((Compact)
        (let* (((StoreSnapshot $after $same $r) (store:compact $owner))
               ($_ (store:close $after)) ($collected (store:collect $owner)))
          (IndexedCompacted $r $collected)))
       ((LegacyMissingV2)
        (let* (((KnowledgeAddressV1 $metadata) (durable-space:metadata sample))
               ((StoreValue $body) (store:get $view $metadata 1048576))
               ((StoreDecoded (StoreSpaceV3 $prefix $count $indexes)) (store:decode $body))
               ((SpaceProbeFoundV1 $atom ((StoreOccurrenceV1 $e $key)))
                 (durable-space:probe $view sample $row $row 4096))
               ((SpaceIndexPostingsV1 $postings) (durable-index:postings $indexes $key $atom))
               ($removals (map-atom $postings $posting (remove $posting)))
               ((StoreEncoded $legacy) (store:encode (StoreSpaceV2 $prefix $count $indexes)))
               ((StoreSnapshot $after $same $r)
                 (store:commit $owner $view (cons-atom ops (cons-atom (put $metadata $legacy) $removals)))))
          (LegacyMissingV2 $key)))
       ((Reference $pattern $template) (indexed-fixture:reference $view $pattern $template))
       ((Raw $pattern $template)
        (let (StoreSpace $space $same $captured) (durable-space:capture $view sample)
          (let $rows (collapse (match $space $pattern (quote $template))) (ReferenceRows $rows))))
       ($other (IndexedRefused command))))))
(= (indexed-fixture:query $view $pattern $template)
  (case (durable-space:cursor $view sample $pattern $template)
    (((StoreQueryOpened $query $epoch $revision) (indexed-fixture:drain $query 0 ()))
     ($failure $failure))))
(= (indexed-fixture:drain $query $sequence $rows)
  (case (store:space-query-next $query $sequence 4 131072)
    (((StoreQueryRow $same $value $identities)
      (let $_ (store:space-query-checkpoint $query)
        (indexed-fixture:drain $query (+ $sequence 1) (cons-atom (Row $value $identities) $rows))))
     (StoreQueryPaused
       (let $_ (store:space-query-checkpoint $query) (indexed-fixture:drain $query $sequence $rows)))
     (StoreQueryEnd
       (let* (($ordered (list:reverse $rows)) ($statistics (store:space-query-info $query))
              ($_ (store:close $query))) (IndexedRows $ordered $statistics)))
     ($failure $failure))))
; Materialization is intentional in this small independent test oracle.
; Production queries use the shared captured source cursor directly.
(= (indexed-fixture:reference $view $pattern $template)
  (case (indexed-fixture:query $view $row $row)
    (((IndexedRows $rows $statistics)
      (let* (($space (new-space)) ($_ (indexed-fixture:fill $space $rows))
             ($answers (collapse (match $space $pattern (quote $template))))) (ReferenceRows $answers)))
     ($failure $failure))))
(= (indexed-fixture:fill $space $rows)
  (if (== $rows ()) Filled
    (let (Row $value $identities) (car-atom $rows)
      (let $_ (add-atom $space $value) (indexed-fixture:fill $space (cdr-atom $rows))))))
