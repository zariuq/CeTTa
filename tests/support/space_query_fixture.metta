!(import! &self (library kb_query))
!(import! &self "kb_query_probe.metta")
!(import! &self "space_query_callbacks.metta")
(= (space-query:run (At $path $plan $count $fuel))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ($cursor (kbq:open-space $view $plan 131072))
         ($_ (store:close $view)))
    (if (kbq:cursor? $cursor) (kbq-probe:pages $cursor $count $fuel 10000 ()) $cursor)))
(= (space-query:run (First $path $plan $count $fuel $maximum))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ($cursor (kbq:open-space $view $plan $maximum))
         ($_ (store:close $view)) ($_ (store:close $owner)))
    (if (kbq:cursor? $cursor) (kbq-probe:first $cursor $count $fuel) $cursor)))
