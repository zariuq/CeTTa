; An index-selected key returns through the existing owning Space matcher.
!(import! &self (library store))
; Finite reference: ordinary matching over one stored atom, with a data
; template. This temporary Space is for reference, not repeated service use.
(: point-test:reference (-> Atom Atom Atom %Undefined%))
(= (point-test:reference $atom $pattern $template)
  (let* (($space (new-space)) ($_ (add-atom $space $atom)))
    (collapse (match $space $pattern (quote $template)))))
(= (point-test:row $query $sequence)
  (case (store:space-query-next $query $sequence 16 1048576)
    ((StoreQueryPaused (point-test:row $query $sequence)) ($answer $answer))))
(= (point-test:run $path)
  (let* (((StoreOpened $owner) (store:open $path "create"))
         ((StoreSnapshot $empty $epoch $revision) (store:snapshot $owner))
         ((StoreEncoded $body) (store:encode (point same)))
         ((StoreSnapshot $view $same $after) (store:commit $owner $empty (ops (put "one" $body) (put "one/child" $body))))
         ($_ (store:close $empty))
         ((StoreQueryOpened $query $same $after) (store:space-point-query-open $view "one" (point $x) (Result $x)))
         ($absent (store:space-point-query-open $view "missing" (point $x) $x))
         ($_ (store:close $view)) ($_ (store:close $owner))
         ($row (point-test:row $query 0))
         ($checkpoint (store:space-query-checkpoint $query))
         ($end (point-test:row $query 1)) ($_ (store:close $query)))
    (let $reference (point-test:reference (point same) (point $x) (Result $x))
      (PointQueryV1 $row $checkpoint $end $absent $reference))))
