!(import! &self (library py))
!(bind! &fixture (py:import "python_interop_fixture"))
!(py:call (py:get &fixture "reset"))
!(py:bind! &self fixture:check (py:get &fixture "check"))
!(py:bind! &self fixture:bump (py:get &fixture "bump"))
!(py:call (py:get &fixture "patch"))
!(fixture:check (fixture:bump 8) 9)
!(fixture:check (py:call (py:get &fixture "bump") 8) -1)
