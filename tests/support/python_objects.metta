!(fixture:check (&callable 4 (py:kwargs ("scale" 3))) 12)
!(fixture:check (py:call (py:get (py:import "math") "sqrt") 81) 9.0)
!(bind! &data (py:list 1 2 3))
!(py:call (py:get &data "append") 4)
!(fixture:check (py:item &data 3) 4)
!(fixture:check (py:to-tuple &data) (1 2 3 4))
!(fixture:check (py:is &data &data) True)
!(fixture:check (py:is &data (py:list 1 2 3 4)) False)
!(fixture:check (py:eq &data (py:list 1 2 3 4)) True)
!(fixture:check (py:to-tuple (py:item &data (py:slice 1 3))) (2 3))
!(fixture:check (py:is (py:none) (py:call (py:get &fixture "identity") (py:none))) True)
!(fixture:check (py:call (py:get &fixture "huge")) 1606938044258990275541962092341162602522202993782792835301376)
!(fixture:check (py:call (py:get (py:import "builtins") "len") (py:call (py:get &fixture "nul"))) 3)
!(bind! &cycle (py:call (py:get &fixture "cycle")))
!(fixture:check (py:is &cycle (py:item &cycle 0)) True)
!(fixture:check (collapse (py:iter (py:call (py:get &fixture "stream")))) (4 5))
(= (context-items $items) (py:iter $items))
!(fixture:check (collapse (py:with (py:call (py:get &fixture "Context")) context-items)) (7 8))
