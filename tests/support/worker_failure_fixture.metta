!(import! &self (library store))
(= (worker-failure:run Empty) (empty))
(= (worker-failure:run Many) (superpose (first second)))
(= (worker-failure:run Error) (Error source deliberate))
(= (worker-failure:run Opaque) (new-space))
(= (worker-failure:run (AfterEffect $path))
  (let* (((StoreOpened $owner) (store:open $path "create"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ($_ (store:commit $owner $view (ops (put "effect" "committed"))))) (empty)))
(= (worker-failure:run (InspectEffect $path))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((StoreValue $value) (store:get $view "effect" 128)))
    (WorkerDurableEffectV1 $revision $value)))
(= (worker-failure:run Echo) Echo)
