!(import! &self "indexed_space_fixture.metta")
!(import! &self "kb_query_probe.metta")
!(import! &self "../../examples/native_space_query_server.metta")
!(import! &self "../../examples/native_space_graph_server.metta")
!(import! &self (library space_service))
!(import! &self (library io))
!(import! &self "native_kb_client_fixture.metta")
(QueryPureCallbackV1 kb:alpha-equal)
(= (large-value:configuration)
  (let (ValueServiceV1 $socket $data $routes $limits) (query-server:configuration)
    (ValueServiceV1 $socket $data
      (list:append (list:append $routes (graph-server:routes))
        ((ServiceRouteV1 LargeEcho Read large-value:echo))) $limits)))
(= (large-value:echo (ServiceCallV1 $configuration $peer $unused $value)) (quote $value))
(= (large-value:run (Remote $socket $message)) (space:call $socket $message 5000))
(= (large-value:run (RemoteAsync $socket $message))
  (let* (($request (space:request $socket $message 5000))
         ((io:pending $identifier) (io:submit $request)))
    (case (io:wait $identifier 5000)
      (((io:event $same $reply) $reply) ($failure $failure)))))
(= (large-value:run (RemoteQuery $socket $pattern $template))
  (let* (((SpaceConnected $connection) (space:connect $socket 5000))
         ((ServiceResourceV1 $view $metadata) (kb-client:call $connection (CallV1 Snapshot ())))
         ((ServiceResourceV1 $query $captured)
           (kb-client:call $connection (UseV1 $view Query (QueryV1 sample $pattern $template))))
         ($rows (kb-client:drain $connection $query 0 ()))
         ($_ (kb-client:call $connection (DropV1 $query)))
         ($_ (kb-client:call $connection (DropV1 $view)))
         ($_ (space:disconnect $connection))) $rows))
(: large-value:fill (-> %Undefined% Atom %Undefined%))
(= (large-value:fill $space $rows)
  (if (== $rows ()) filled
    (let* (($row (car-atom $rows)) ($tail (cdr-atom $rows))
           ($_ (add-atom $space $row)))
      (large-value:fill $space $tail))))
(= (large-value:run (Memory $rows $pattern $template))
  (let* (($space (new-space)) ($_ (large-value:fill $space $rows))
         ($answers (collapse (match $space $pattern (quote $template)))))
    (MemoryRows $answers)))
(= (large-value:run (At $path $plan $count $maximum))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ($cursor (kbq:open-space $view $plan $maximum))
         ($_ (store:close $view)) ($_ (store:close $owner)))
    (if (kbq:cursor? $cursor) (kbq-probe:pages $cursor $count 128 10000 ()) $cursor)))
(= (large-value:run (Raw $path $pattern $template))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((StoreSpace $space $e $r) (durable-space:capture $view sample))
         ($_ (store:close $view)) ($_ (store:close $owner))
         ($answers (collapse (match $space $pattern (quote $template)))))
    (MemoryRows $answers)))
(= (large-value:run (Budget)) (store:value-byte-limit))
(= (large-value:run (Seed $command)) (indexed-fixture:run $command))
(= (large-value:run (Read $path $reference $maximum))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ($answer (durable-space:read $view sample $reference $maximum))
         ($_ (store:close $view)) ($_ (store:close $owner))) $answer))
