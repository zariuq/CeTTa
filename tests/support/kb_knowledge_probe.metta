; Test owner for the native knowledge interface. Handles never leave the RPC.
!(import! &self ../../lib/petta/knowledge.metta)

(= (knowledge-probe:read $view $identities $budget)
  (knowledge:observe $view $identities $budget))
(= (knowledge-probe:apply $owner $view
      (KnowledgeApplyV1 $identities $receipt $command $answer $changes $budget))
  (case (knowledge:observe $view $identities $budget)
    (((KnowledgeObservedV1 $points $reads)
      (knowledge:publish $owner $view $reads $receipt $command $answer $changes $budget))
     ($error $error))))

(= (knowledge-probe:at-view $owner $view $epoch $revision $operation)
  (case $operation
    (((KnowledgeReadV1 $identities $budget) (knowledge-probe:read $view $identities $budget))
     ((KnowledgeApplyV1 $ids $receipt $command $answer $changes $budget)
      (knowledge-probe:apply $owner $view $operation))
     ((KnowledgeResolveV1 $receipt $command $budget) (knowledge:resolve $owner $receipt $command $budget))
     ((KnowledgeRaceV1 $first $second)
      (let* (($left (knowledge-probe:apply $owner $view $first))
             ($right (knowledge-probe:apply $owner $view $second)))
        (KnowledgeRaceResultV1 $left $right)))
     ((KnowledgeHeldReadV1 $first $identities $budget)
      (let* (($before (knowledge-probe:read $view $identities $budget))
             ($write (knowledge-probe:apply $owner $view $first))
             ($again (knowledge-probe:read $view $identities $budget)))
        (KnowledgeHeldResultV1 $before $write $again)))
     (KnowledgeProbeRevisionV1 (KnowledgeRevisionV1 $epoch $revision))
     (KnowledgeProbeAuditV1 (knowledge-probe:audit $view))
     (KnowledgeProbeCompactV1
      (case (store:compact $owner)
        (((StoreSnapshot $updated $same $after)
          (let* (($closed (store:close $updated)) ($collected (store:collect $owner)))
            (KnowledgeMaintainedV1 $same $after $collected)))
         ($error $error))))
     ($other (KnowledgeRefusedV1 probe-operation)))))

(= (knowledge-probe:reverse $values $answer)
  (if (== $values ()) $answer
    (knowledge-probe:reverse (cdr-atom $values) (cons-atom (car-atom $values) $answer))))
(= (knowledge-probe:rows $view $scan $position $answer)
  (case (store:scan-next $scan $position)
    ((StoreEnd (KnowledgeAuditV1 (knowledge-probe:reverse $answer ())))
     ((StoreKey $key $size $next)
      (case (store:get $view $key $size)
        (((StoreValue $bytes)
          (case (store:decode $bytes)
            (((StoreDecoded $value)
              (knowledge-probe:rows $view $scan $next (cons-atom ($key $value) $answer)))
             ($error $error))))
         ($error $error))))
     ($error $error))))
(= (knowledge-probe:audit $view)
  (case (store:scan-open $view NoBound NoBound)
    (((StoreScan $scan)
      (let* (($answer (knowledge-probe:rows $view $scan 0 ())) ($closed (store:close $scan))) $answer))
     ($error $error))))

(= (knowledge-probe:run (Create $path))
  (case (store:open $path "create")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let $closed (store:close $view) (KnowledgeReadyV1 $epoch $revision)))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))
(= (knowledge-probe:run (At $path $operation))
  (case (store:open $path "existing")
    (((StoreOpened $owner)
      (let $answer
        (case (store:snapshot $owner)
          (((StoreSnapshot $view $epoch $revision)
            (let* (($answer (knowledge-probe:at-view $owner $view $epoch $revision $operation))
                   ($closed (store:close $view))) $answer))
           ($error $error)))
        (let $closed (store:close $owner) $answer)))
     ($error $error))))
