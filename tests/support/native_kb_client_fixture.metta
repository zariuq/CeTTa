!(import! &self (library space_service))
!(import! &self (library lib_he))

(= (kb-client:call $connection $body)
  (let $identifier (space:request-id)
    (case (space:exchange $connection (request $identifier $body) 5000)
      (((reply $same ok $value) $value) ($failure $failure)))))

(= (kb-client:drain $connection $query $sequence $rows)
  (case (kb-client:call $connection (UseV1 $query Next (NextV1 $sequence)))
    ((StoreQueryPaused (kb-client:drain $connection $query $sequence $rows))
     (StoreQueryEnd (ClientRows $rows))
     ((StoreQueryRow $same $value $identities)
      (kb-client:drain $connection $query (+ $sequence 1) (cons-atom (Row $value $identities) $rows)))
     ($failure $failure))))

(= (kb-client:run (Inspect $socket))
  (let* (((SpaceConnected $connection) (space:connect $socket 5000))
         ((ServiceResourceV1 $view $metadata) (kb-client:call $connection (CallV1 Snapshot ())))
         ((ServiceResourceV1 $query $captured)
          (kb-client:call $connection (UseV1 $view Query (QueryV1 sample (edge alice $who) $who))))
         ($rows (kb-client:drain $connection $query 0 ()))
         ($_ (assertEqual (kb-client:call $connection (DropV1 $query)) ServiceClosedV1))
         ($_ (assertEqual (kb-client:call $connection (DropV1 $view)) ServiceClosedV1))
         ($_ (assertEqual (space:disconnect $connection) SpaceDisconnected))) $rows))

(= (kb-client:run (Abandon $socket))
  (let* (((SpaceConnected $connection) (space:connect $socket 5000))
         ((ServiceResourceV1 $view $metadata) (kb-client:call $connection (CallV1 Snapshot ())))
         ((ServiceResourceV1 $query $captured)
          (kb-client:call $connection (UseV1 $view Query (QueryV1 sample (edge alice $who) $who))))) ClientAbandoned))

(= (kb-client:run (Guards $socket))
  (let* (((SpaceConnected $connection) (space:connect $socket 5000))
         ((NativeHandle $kind $identifier) $connection)
         ($_ (assertEqual
           (space:exchange (NativeHandle $kind (+ $identifier 0)) (request "forged" (StatsV1)) 5000)
           (space:unavailable "forged" closed-or-busy-connection)))
         ($_ (assertEqual (space:disconnect $connection) SpaceDisconnected))
         ($_ (assertEqual (space:disconnect $connection) (SpaceConnectionRefused closed-or-busy)))
         ($_ (assertEqual (space:exchange $connection (request "closed" (StatsV1)) 5000)
                         (space:unavailable "closed" closed-or-busy-connection)))) ClientGuardsPassed))

(= (kb-client:run Echo) Echo)

(= (kb-client:run (FailedExchange $socket))
  (let* (((SpaceConnected $connection) (space:connect $socket 5000))
         ($first (space:exchange $connection (request "probe" (StatsV1)) 1000))
         ($second (space:exchange $connection (request "after" (StatsV1)) 1000)))
    (ClientFailedExchange $first $second)))
