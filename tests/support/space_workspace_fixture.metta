!(import! &self (library durable_space))
!(import! &self (library lib_he))
(= (workspace-fixture:run (Write $path))
  (let* (((StoreOpened $owner) (store:open $path "create"))
         ((StoreSnapshot $initial $epoch $zero) (store:snapshot $owner))
         ($_ (durable-space:create-indexed $owner $initial sample create ((SpaceIndexV1 3 1))))
         ($_ (store:close $initial))
         ((StoreSnapshot $view $same $revision) (store:snapshot $owner))
         ((KnowledgeAddressV1 $key) (durable-space:metadata sample))
         ((StoreSpace $original $oe $or) (durable-space:capture $view sample))
         ((StoreSpace $space $we $wr) (durable-space:workspace $view sample))
         ($alias $space)
         ($_ (add-atom $space (edge a b)))
         ($_ (add-atom $space (edge a b)))
         ($_ (add-atom $space (edge b c)))
         ($_ (add-atom $space (rel $shared $shared)))
         ($_ (add-atom $space (= (saved) (println! SHOULD_NOT_EXECUTE))))
         ($_ (assertEqual (collapse (match $space (edge a $to) $to)) (b b)))
         ($_ (assertEqual (collapse (match $space (, (edge a $x) (edge $x c)) $x)) (b b)))
         ($_ (assertEqual (collapse (match $space (rel 1 2) no)) ()))
         ($_ (assertEqual (collapse (match $space (rel 1 1) yes)) (yes)))
         ($_ (assertEqual (collapse (get-atoms $original)) ()))
         ($reference (new-space))
         ($_ (add-atom $reference (edge a b)))
         ($_ (add-atom $reference (edge a b)))
         ($_ (remove-atom $reference (edge a b)))
         ($_ (assertEqual (collapse (match $reference (edge a $to) $to)) ()))
         ($_ (remove-atom $space (edge a b)))
         ($_ (assertEqual (collapse (match $space (edge a $to) $to)) ()))
         ($_ (assertEqual (size-atom (collapse (get-atoms $space))) 3))
         ($_ (assertEqual (store:space-changes $space $view "wrong-collection")
               (StoreRefused workspace-view-mismatch)))
         ($committed (durable-space:commit-workspace $owner $view sample publish $space))
         ($replayed (durable-space:commit-workspace $owner $view sample publish $space))
         ((StoreSnapshot $after $ae $ar) (store:snapshot $owner))
         ($_ (assertEqual $ar (+ $revision 1)))
         ($_ (assertEqual (store:space-changes $space $after $key) (StoreRefused workspace-view-mismatch)))
         ((StoreSpace $fresh $fe $fr) (durable-space:capture $after sample))
         ($_ (assertEqual (collapse (match $fresh (edge a $to) $to)) ()))
         ($_ (assertEqual (size-atom (collapse (get-atoms $fresh))) 3))
         ($_ (assertEqual (collapse (get-atoms $original)) ()))
         ($_ (store:close $space))
         ($_ (assertEqual (store:space-changes $alias $view $key) (StoreRefused closed-space)))
         ($_ (assertEqual (let (Error $call $reason) (catch (get-atoms $alias)) closed) closed))
         ($_ (assertEqual (collapse (catch (match $alias $row $row))) ()))
         ($closed-add (collapse (catch (add-atom $alias (must not publish)))))
         ($_ (assertEqual (store:space-changes $alias $view $key) (StoreRefused closed-space)))
         ((StoreSnapshot $unchanged $ue $ur) (store:snapshot $owner))
         ($_ (assertEqual $ur $ar)) ($_ (store:close $unchanged))
         ($_ (store:close $fresh)) ($_ (store:close $original))
         ($_ (store:close $after)) ($_ (store:close $view)) ($_ (store:close $owner)))
    WORKSPACE_WRITE_OK))
(= (workspace-fixture:run (Read $path))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((StoreSpace $space $same $captured) (durable-space:capture $view sample))
         ($_ (store:close $view)) ($_ (store:close $owner))
         ($_ (assertEqual (collapse (match $space (edge a $to) $to)) ()))
         ($_ (assertEqual (collapse (match $space (rel 1 2) no)) ()))
         ($_ (assertEqual (collapse (match $space (rel 1 1) yes)) (yes)))
         ($_ (assertEqual (collapse (match $space (= (saved) $body) found)) (found)))
         ($_ (assertEqual (size-atom (collapse (get-atoms $space))) 3))
         ($_ (store:close $space))) WORKSPACE_REOPEN_OK))
(= (workspace-fixture:run (Cycle $path))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((StoreSpace $read $re $rr) (durable-space:capture $view sample))
         ((StoreSpace $write $we $wr) (durable-space:workspace $view sample))
         ($_ (store:close $view)) ($_ (store:close $owner))
         ($_ (assertEqual (size-atom (collapse (get-atoms $read))) 3))
         ($_ (add-atom $write (temporary discarded)))
         ($_ (add-atom $write (temporary discarded)))
         ($_ (remove-atom $write (temporary discarded) 1))
         ($_ (assertEqual (collapse (match $write (temporary $x) $x)) (discarded)))
         ($_ (store:close $write)) ($_ (store:close $read))) WORKSPACE_CYCLE_OK))
(= (workspace-fixture:run (Remove $path))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((StoreSpace $before $be $br) (durable-space:capture $view sample))
         ((StoreSpace $work $we $wr) (durable-space:workspace $view sample))
         ($_ (remove-atom $work (edge b c) 1))
         ($_ (assertEqual (collapse (match $work (edge b $to) $to)) ()))
         ($_ (assertEqual (collapse (match $before (edge b $to) $to)) (c)))
         ((KnowledgeAddressV1 $key) (durable-space:metadata sample))
         ((StoreSpaceChanges $added $removed) (store:space-changes $work $view $key))
         ($_ (assertEqual $added ()))
         ($_ (assertEqual (size-atom $removed) 1))
         ($receipt (durable-space:commit-workspace $owner $view sample remove-one $work))
         ((StoreSnapshot $after $ae $ar) (store:snapshot $owner))
         ($_ (assertEqual $ar (+ $revision 1)))
         ($_ (store:close $work)) ($_ (store:close $before))
         ($_ (store:close $after)) ($_ (store:close $view))
         ($_ (store:close $owner))) WORKSPACE_REMOVE_OK))
(= (workspace-fixture:run (ReadAfter $path))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((StoreSpace $space $same $captured) (durable-space:capture $view sample))
         ($_ (store:close $view)) ($_ (store:close $owner))
         ($_ (assertEqual (collapse (match $space (edge b $to) $to)) ()))
         ($_ (assertEqual (collapse (match $space (rel 1 1) yes)) (yes)))
         ($_ (assertEqual (size-atom (collapse (get-atoms $space))) 2))
         ($_ (store:close $space))) WORKSPACE_REMOVE_REOPEN_OK))
