!(import! &self (library kb_query))
!(import! &self (library kb_graph))
!(import! &self "kb_query_probe.metta")
!(import! &self "space_query_callbacks.metta")
(= (program-test:value $row) (Old $row))
(= (program-test:helper $row) (Old $row))
(= (program-test:outer $row) (program-test:helper $row))
(: program-test:typed (-> Atom Atom))
(= (program-test:typed $row) (Typed $row))
(= (program-test:future $row) (program-test:not-yet $row))
(= (program-test:changing $row)
  (let $_ (add-atom &self (= (ChangedDuringCallbackV1) changed)) (Changed $row)))

(= (program-test:setup $path)
  (let* (((StoreOpened $owner) (store:open $path "create"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ($_ (durable-space:create-indexed $owner $view sample create ((SpaceIndexV1 2 0))))
         ($_ (store:close $view))) $owner))
(= (program-test:mutate $kind)
  (case $kind
    ((equation
      (let* (($_ (remove-atom &self (= (program-test:value $old) (Old $old))))
             ($_ (add-atom &self (= (program-test:value $new) (New $new))))) Changed))
     (transitive
      (let* (($_ (remove-atom &self (= (program-test:helper $old-helper) (Old $old-helper))))
             ($_ (add-atom &self (= (program-test:helper $new-helper) (New $new-helper))))) Changed))
     (declaration
      (let* (($_ (remove-atom &self (: program-test:typed (-> Atom Atom))))
             ($_ (add-atom &self (: program-test:typed (-> Number Number))))) Changed))
     (future (add-atom &self (= (program-test:not-yet $new-callee) (Installed $new-callee))))
     (data (add-atom &self (ScratchOnlyV1)))
     (other-equation (add-atom &self (= (ProgramAddedV1) added)))
     (import (import! &self "program_query_import.metta"))
     ($other Changed))))
(= (program-test:run (Live $path $kind $callback))
  (let* (($owner (program-test:setup $path))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ($cursor (kbq:open-space $view (KqMap (KqRows (1 2)) $callback) 131072)))
    (case (kbq:page $cursor 1 128)
      (((KqPage $first (KqMore $next))
        (let* (($_ (program-test:mutate $kind))
               ($second (kbq-probe:first $next 1 128))
               ($ordinary (program-test:value 9))
               ($info (store:view-info $view)))
          (ProgramLiveV1 $first $second $ordinary $info)))
       ($failure $failure)))))
(= (program-test:run (Commit $path $kind))
  (let* (($owner (program-test:setup $path))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ($cursor (kbq:open-space $view
           (KqAnti (KqRows (allowed)) $original (KqSpace sample (blocked $blocker) $blocker)) 131072))
         ($context (kbq:read-context $cursor))
         ($answers (kbq-probe:pages $cursor 2 8 1000 ()))
         ($_ (case $kind
           ((code (program-test:mutate other-equation))
            (data
              (let* (((StoreSnapshot $fresh $same $r) (store:snapshot $owner))
                     ($_ (durable-space:commit $owner $fresh sample concurrent ((SpaceInsertV1 0 (blocked now)))))
                     ($_ (store:close $fresh))) Changed))
            (closed (let (DurableReadContextV1 $v $w) $context (store:close $w)))
            ($other Changed))))
         ($changes ((SpaceInsertV1 0 (decision allowed))))
         ($committed (kbq:commit-read $owner $context sample decision $changes))
         ($retry (case $kind
           ((retry
              (let $_ (program-test:mutate other-equation)
                (kbq:commit-read $owner $context sample decision $changes)))
            ($other NotRetried))))
         ($different (case $kind
           ((retry (kbq:commit-read $owner $context sample decision ((SpaceInsertV1 0 (decision different)))))
            ($other NotRetried))))
         ($_ (kbq:close-read-context $context))
         ((StoreSnapshot $after $same $next) (store:snapshot $owner)))
    (ProgramCommitV1 $answers $committed $retry $different $revision $next)))
(= (program-test:run (During $path))
  (let* (($owner (program-test:setup $path))
         ((StoreSnapshot $before $epoch $revision) (store:snapshot $owner))
         ($_ (durable-space:commit $owner $before sample seed ((SpaceInsertV1 0 (datum 7)))))
         ((StoreSnapshot $view $same $next) (store:snapshot $owner))
         ($cursor (kbq:open-space $view (KqMap (KqSpace sample (datum $value) $value) program-test:changing) 131072)))
    (kbq-probe:first $cursor 1 128)))
(= (program-test:run (Graph $path $kind))
  (let* (($owner (program-test:setup $path))
         ((StoreSnapshot $seed $epoch $revision) (store:snapshot $owner))
         ($_ (durable-space:commit $owner $seed sample graph-seed
           ((SpaceInsertV1 0 (edge a b)) (SpaceInsertV1 1 (edge a c)))))
         ((StoreSnapshot $view $same $next) (store:snapshot $owner))
         ($cursor (kbg:open-space $view sample 3 (KgNeighbours (KgRelation edge 0 1) a out) 131072 1000))
         ($context (kbg:read-context $cursor)))
    (case (kbg:page $cursor 1 128)
      (((KgPage $first (KgMore $tail))
        (let* (($_ (program-test:mutate $kind))
               ($page (kbg:page $tail 1 128))
               ($_ (case $page
                 (((KgPage $rows (KgMore $still)) (kbg:close $still))
                  ((KgPage $rows (KgPaused $still)) (kbg:close $still)) ($done Closed))))
               ($summary (case $page
                 (((KgPage $more-rows (KgMore $unused)) (KgPage $more-rows (KgMore)))
                  ((KgPage $paused-rows (KgPaused $unused-paused)) (KgPage $paused-rows (KgPaused)))
                  ($terminal $terminal))))
               ($commit (durable-query:commit $owner $context sample graph-decision ((SpaceInsertV1 0 (decision graph)))))
               ($_ (durable-query:close-context $context)))
          (ProgramGraphV1 $first $summary $commit)))
       ($failure $failure)))))
(= (program-test:run WatchErrors)
  (let* (((StoreProgramWatch $watch) (store:program-watch-open))
         ((StoreProgramWatch $clone) (store:program-watch-clone $watch))
         ($_ (store:close $watch))
         ($closed (store:program-watch-check $watch))
         ($current (store:program-watch-check $clone))
         ($literal (store:program-watch-check (NativeHandle "program-watch" 1)))
         ($_ (program-test:mutate other-equation))
         ((StoreProgramWatch $stale) (store:program-watch-clone $clone))
         ($old (store:program-watch-check $stale))
         ($_ (store:close $clone)) ($_ (store:close $stale)))
    (ProgramWatchErrorsV1 $closed $current $literal $old)))
