; Native forward-chaining memory probe.
;
; This is a lightweight diagnostic lane for Nil-style FC on native spaces.
; It prints the main retained-storage and temporary-arena counters after
; completed depth-3 duplicate and nodup runs so deeper depth-4 failures can
; be interpreted against concrete buckets instead of raw RSS alone.

(= (show-counter $label $stats $name)
   (match $stats (runtime-counter $name $n) ($label $name $n)))

(= (dup-depth) 3)
(= (nodup-depth) 3)

(: Nat Type)
(: Z Nat)
(: S (-> Nat Nat))
(: fromNumber (-> Number Nat))
(= (fromNumber $n) (if (<= $n 0) Z (S (fromNumber (- $n 1)))))

(= (fs2 $rb (: $x1 $a1) (: $x2 $a2))
   (match $rb (: $f (-> $a1 $a2 $b)) (: ($f $x1 $x2) $b)))

(= (fs-add-to-ss $rb $ss)
   (with-space-snapshot $ss0 $ss
     (match $ss0 (: $x1 $a1)
       (match $ss0 (: $x2 $a2)
         (match $rb (: $f (-> $a1 $a2 $b))
           (add-atom $ss (: ($f $x1 $x2) $b)))))))

(= (fs-add-to-ss-nodup $rb $ss)
   (with-space-snapshot $ss0 $ss
     (match $ss0 (: $x1 $a1)
       (match $ss0 (: $x2 $a2)
         (match $rb (: $f (-> $a1 $a2 $b))
           (add-atom-nodup $ss (: ($f $x1 $x2) $b)))))))

!(println! "=== fc-native-memory-probe ===")

!(bind! &rb (new-space))
!(add-atom &rb (: ax-mp (-> (→ $p $q) $p $q)))

!(bind! &ab (new-space))
!(add-atom &ab (: ax-1 (→ $p (→ $q $p))))
!(add-atom &ab (: ax-2 (→ (→ $p (→ $q $r)) (→ (→ $p $q) (→ $p $r)))))
!(add-atom &ab (: ax-3 (→ (→ (¬ $p) (¬ $q)) (→ $q $p))))

!(bind! &ss-dup (new-space))
!(match &ab (: $x $a) (add-atom &ss-dup (: $x $a)))
!(reset-runtime-stats!)
!(if (<= 1 (dup-depth)) (fs-add-to-ss &rb &ss-dup) (empty))
!(if (<= 2 (dup-depth)) (fs-add-to-ss &rb &ss-dup) (empty))
!(if (<= 3 (dup-depth)) (fs-add-to-ss &rb &ss-dup) (empty))
!(assertEqualToResult (count-atoms &ss-dup) (3421))
!(bind! &dup-stats (runtime-stats!))
!(println! (fc3-dup-count (count-atoms &ss-dup)))
!(println! (show-counter fc3-dup &dup-stats persistent-arena-live-bytes-peak))
!(println! (show-counter fc3-dup &dup-stats term-universe-insert))
!(println! (show-counter fc3-dup &dup-stats term-universe-byte-entry))
!(println! (show-counter fc3-dup &dup-stats term-universe-fallback-entry))
!(println! (show-counter fc3-dup &dup-stats term-universe-blob-bytes))
!(println! (show-counter fc3-dup &dup-stats space-atom-id-live-bytes-peak))
!(println! (show-counter fc3-dup &dup-stats space-atom-id-capacity-bytes-peak))
!(println! (show-counter fc3-dup &dup-stats eval-arena-live-bytes-peak))
!(println! (show-counter fc3-dup &dup-stats scratch-arena-live-bytes-peak))
!(println! (show-counter fc3-dup &dup-stats bindings-entry-retained-bytes-peak))
!(println! (show-counter fc3-dup &dup-stats bindings-constraint-retained-bytes-peak))
!(println! (show-counter fc3-dup &dup-stats bindings-entry-active-bytes-peak))
!(println! (show-counter fc3-dup &dup-stats bindings-constraint-active-bytes-peak))
!(println! (show-counter fc3-dup &dup-stats match-chain-frontier-bindings-peak))
!(println! (show-counter fc3-dup &dup-stats match-chain-subst-results-peak))
!(println! (show-counter fc3-dup &dup-stats match-chain-eval-bytes-after-grounded-peak))
!(println! (show-counter fc3-dup &dup-stats match-chain-eval-bytes-after-query-peak))
!(println! (show-counter fc3-dup &dup-stats match-chain-eval-bytes-after-project-peak))
!(println! (show-counter fc3-dup &dup-stats match-chain-grounded-delta-bytes-peak))
!(println! (show-counter fc3-dup &dup-stats match-chain-query-delta-bytes-peak))
!(println! (show-counter fc3-dup &dup-stats match-chain-project-delta-bytes-peak))
!(println! (show-counter fc3-dup &dup-stats match-chain-substmatchset-bytes-peak))
!(println! (show-counter fc3-dup &dup-stats match-chain-query-bindings-entry-delta-peak))
!(println! (show-counter fc3-dup &dup-stats match-chain-query-bindings-constraint-delta-peak))
!(println! (show-counter fc3-dup &dup-stats match-chain-seed-merge-bindings-entry-delta-peak))
!(println! (show-counter fc3-dup &dup-stats match-chain-seed-merge-bindings-constraint-delta-peak))
!(println! (show-counter fc3-dup &dup-stats query-episode-survivor-arena-live-bytes-peak))
!(println! (show-counter fc3-dup &dup-stats query-episode-promoted-answer-bytes))
!(println! (show-counter fc3-dup &dup-stats query-episode-delayed-outcome-survivor-count))
!(println! (show-counter fc3-dup &dup-stats match-result-direct-stream-count))
!(println! (show-counter fc3-dup &dup-stats match-result-snapshot-count))
!(println! (show-counter fc3-dup &dup-stats match-result-direct-generated-outcome-count))
!(println! (show-counter fc3-dup &dup-stats match-result-direct-generated-outcome-peak))

!(bind! &ss-nodup (new-space))
!(match &ab (: $x $a) (add-atom-nodup &ss-nodup (: $x $a)))
!(reset-runtime-stats!)
!(if (<= 1 (nodup-depth)) (fs-add-to-ss-nodup &rb &ss-nodup) (empty))
!(if (<= 2 (nodup-depth)) (fs-add-to-ss-nodup &rb &ss-nodup) (empty))
!(if (<= 3 (nodup-depth)) (fs-add-to-ss-nodup &rb &ss-nodup) (empty))
!(assertEqualToResult (count-atoms &ss-nodup) (2759))
!(bind! &nodup-stats (runtime-stats!))
!(println! (fc3-nodup-count (count-atoms &ss-nodup)))
!(println! (show-counter fc3-nodup &nodup-stats persistent-arena-live-bytes-peak))
!(println! (show-counter fc3-nodup &nodup-stats term-universe-insert))
!(println! (show-counter fc3-nodup &nodup-stats term-universe-byte-entry))
!(println! (show-counter fc3-nodup &nodup-stats term-universe-fallback-entry))
!(println! (show-counter fc3-nodup &nodup-stats term-universe-blob-bytes))
!(println! (show-counter fc3-nodup &nodup-stats space-atom-id-live-bytes-peak))
!(println! (show-counter fc3-nodup &nodup-stats space-atom-id-capacity-bytes-peak))
!(println! (show-counter fc3-nodup &nodup-stats eval-arena-live-bytes-peak))
!(println! (show-counter fc3-nodup &nodup-stats scratch-arena-live-bytes-peak))
!(println! (show-counter fc3-nodup &nodup-stats bindings-entry-retained-bytes-peak))
!(println! (show-counter fc3-nodup &nodup-stats bindings-constraint-retained-bytes-peak))
!(println! (show-counter fc3-nodup &nodup-stats bindings-entry-active-bytes-peak))
!(println! (show-counter fc3-nodup &nodup-stats bindings-constraint-active-bytes-peak))
!(println! (show-counter fc3-nodup &nodup-stats match-chain-frontier-bindings-peak))
!(println! (show-counter fc3-nodup &nodup-stats match-chain-subst-results-peak))
!(println! (show-counter fc3-nodup &nodup-stats match-chain-eval-bytes-after-grounded-peak))
!(println! (show-counter fc3-nodup &nodup-stats match-chain-eval-bytes-after-query-peak))
!(println! (show-counter fc3-nodup &nodup-stats match-chain-eval-bytes-after-project-peak))
!(println! (show-counter fc3-nodup &nodup-stats match-chain-grounded-delta-bytes-peak))
!(println! (show-counter fc3-nodup &nodup-stats match-chain-query-delta-bytes-peak))
!(println! (show-counter fc3-nodup &nodup-stats match-chain-project-delta-bytes-peak))
!(println! (show-counter fc3-nodup &nodup-stats match-chain-substmatchset-bytes-peak))
!(println! (show-counter fc3-nodup &nodup-stats match-chain-query-bindings-entry-delta-peak))
!(println! (show-counter fc3-nodup &nodup-stats match-chain-query-bindings-constraint-delta-peak))
!(println! (show-counter fc3-nodup &nodup-stats match-chain-seed-merge-bindings-entry-delta-peak))
!(println! (show-counter fc3-nodup &nodup-stats match-chain-seed-merge-bindings-constraint-delta-peak))
!(println! (show-counter fc3-nodup &nodup-stats query-episode-survivor-arena-live-bytes-peak))
!(println! (show-counter fc3-nodup &nodup-stats query-episode-promoted-answer-bytes))
!(println! (show-counter fc3-nodup &nodup-stats query-episode-delayed-outcome-survivor-count))
!(println! (show-counter fc3-nodup &nodup-stats match-result-direct-stream-count))
!(println! (show-counter fc3-nodup &nodup-stats match-result-snapshot-count))
!(println! (show-counter fc3-nodup &nodup-stats match-result-direct-generated-outcome-count))
!(println! (show-counter fc3-nodup &nodup-stats match-result-direct-generated-outcome-peak))
