!(import! &self (library db))
!(import! &self (library lib_he))

(= (append-fixture:drain $state)
  (case (durable-space:append-next $state)
    (((SpaceAppendMoreV1 $next) (append-fixture:drain $next))
     ((SpaceAppendReadyV1 $ready) (durable-space:append-finish $ready))
     ($failure $failure))))
(= (append-fixture:prepare $owner $path $request)
  (let* (($source (act:open $path))
         ((StoreSnapshot $view $_ $_) (store:snapshot $owner))
         ($opened (durable-space:append-open $owner $view data $request
                    (DbTransactionV1 data manual) $source 9223372036854775807))
         ($_ (store:close $view)) ($_ (act:close! $source))) $opened))

(= (append-fixture:run (Basic $path $input))
  (let* (($db (db:open $path))
         ($_ (assertEqual (db:add $db (retained yes)) True))
         ($first (db:import-act-result $db data repeat-import copy $input))
         ($_ (assertEqual $first (db:committed repeat-import (True))))
         ($again (db:import-act-result $db data repeat-import copy $input))
         ($_ (assertEqual $again (db:replayed repeat-import (True))))
         ($snapshot (db:snapshot $db))
         ($_ (assertEqual (size-atom (collapse (get-atoms $snapshot))) 18))
         ($_ (assertEqual (collapse (match $snapshot (retained yes) yes)) (yes yes)))
         ($_ (assertEqual (collapse (match $snapshot (rel one one) yes)) (yes yes)))
         ($_ (assertEqual (collapse (match $snapshot (rel one two) yes)) (yes)))
         ($_ (db:close $snapshot)) ($_ (db:close $db))) APPEND_BASIC_OK))
(= (append-fixture:run (Retain $path $input))
  (let* (($db (db:open $path))
         ((SpaceAppendOpenedV1 $state) (append-fixture:prepare $db $input retained-import))
         ($_ (db:close $db))
         ($result (append-fixture:drain $state))
         ($_ (case $result
               (((KnowledgeCommittedV1 $_ $_ $_) True)
                ($wrong (assertEqual $wrong expected-commit)))))
         ($again (db:open $path)) ($snapshot (db:snapshot $again))
         ($_ (assertEqual (size-atom (collapse (get-atoms $snapshot))) 17))
         ($_ (db:close $snapshot)) ($_ (db:close $again))) APPEND_RETAIN_OK))
(= (append-fixture:run (Cancel $path $input))
  (let* (($db (db:open $path))
         ((SpaceAppendOpenedV1 $state) (append-fixture:prepare $db $input cancelled-import))
         ((SpaceAppendMoreV1 $next) (durable-space:append-next $state))
         ($_ (assertEqual (durable-space:append-close $next) True))
         ($snapshot (db:snapshot $db))
         ($_ (assertEqual (collapse (get-atoms $snapshot)) ()))
         ($_ (assertEqual (db:resolve $db data cancelled-import manual) (db:unrecorded cancelled-import)))
         ($_ (db:close $snapshot)) ($_ (db:close $db))) APPEND_CANCEL_OK))
(= (append-fixture:run (Stale $path $input))
  (let* (($db (db:open $path))
         ((SpaceAppendOpenedV1 $state) (append-fixture:prepare $db $input stale-import))
         ($_ (assertEqual (db:add $db (intervening committed)) True))
         ($_ (assertEqual (append-fixture:drain $state) (StoreRefused conflict)))
         ($snapshot (db:snapshot $db))
         ($_ (assertEqual (collapse (get-atoms $snapshot)) ((intervening committed))))
         ($_ (assertEqual (db:resolve $db data stale-import manual) (db:unrecorded stale-import)))
         ($_ (db:close $snapshot)) ($_ (db:close $db))) APPEND_STALE_OK))
(= (append-fixture:run (Program $path $input))
  (let* (($db (db:open $path))
         ((SpaceAppendOpenedV1 $state) (append-fixture:prepare $db $input changed-program))
         ($_ (add-atom &self (= (append-fixture:changed) yes)))
         ($_ (assertEqual (append-fixture:drain $state) (StoreRefused program-invalidated)))
         ($snapshot (db:snapshot $db))
         ($_ (assertEqual (collapse (get-atoms $snapshot)) ()))
         ($_ (db:close $snapshot)) ($_ (db:close $db))) APPEND_PROGRAM_OK))
(= (append-fixture:run (Premature $path $input))
  (let* (($db (db:open $path))
         ((SpaceAppendOpenedV1 $state) (append-fixture:prepare $db $input unfinished))
         ($_ (assertEqual (durable-space:append-finish $state) (SpaceRefusedV1 append-incomplete)))
         ($snapshot (db:snapshot $db))
         ($_ (assertEqual (collapse (get-atoms $snapshot)) ()))
         ($_ (db:close $snapshot)) ($_ (db:close $db))) APPEND_PREMATURE_OK))
(= (append-fixture:run (Scale $path $input $expected))
  (let* (($db (db:open $path))
         ($_ (assertEqual (db:import-act $db $input) True))
         ($snapshot (db:snapshot $db))
         ((StoreSourceOpened $source $count $maximum) (store:source-open $snapshot))
         ($_ (assertEqual $count $expected))
         ($_ (store:close $source)) ($_ (db:close $snapshot)) ($_ (db:close $db))) APPEND_SCALE_OK))
(= (append-fixture:run (Collision $path $input))
  (let* (($db (db:open $path))
         ($_ (assertEqual (db:import-act-result $db data content-request copy $input)
              (db:committed content-request (True))))
         ($other (new-space)) ($_ (add-atom $other (different artifact)))
         ($changed (str:concat $path ".changed.cact"))
         ($_ (assertEqual (act:dump! $other $changed) True))
         ($_ (assertEqual (catch (db:import-act-result $db data content-request copy $changed))
              (Error db:transaction (KnowledgeRefusedV1 receipt-collision))))
         ($snapshot (db:snapshot $db))
         ($_ (assertEqual (size-atom (collapse (get-atoms $snapshot))) 17))
         ($_ (db:close $snapshot)) ($_ (db:close $db))) APPEND_COLLISION_OK))
(= (append-fixture:run (Legacy $path $input))
  (let* (($db (db:open $path))
         ((StoreSnapshot $view $_ $_) (store:snapshot $db))
         ((KnowledgeAddressV1 $metadata) (durable-space:metadata data))
         ((KnowledgeAddressV1 $prefix) (durable-space:prefix data))
         ((StoreEncoded $old) (store:encode (StoreSpaceV2 $prefix 0 ())))
         ((StoreSnapshot $written $_ $_) (store:commit $db $view (ops (put $metadata $old))))
         ($_ (store:close $written)) ($_ (store:close $view))
         ($_ (assertEqual (catch (db:import-act $db $input))
              (Error db:transaction (SpaceRefusedV1 index-upgrade-required))))
         ((StoreSnapshot $after $_ $_) (store:snapshot $db))
         ((StoreValue $bytes) (store:get $after $metadata (store:value-byte-limit)))
         ($_ (assertEqual (store:decode $bytes) (StoreDecoded (StoreSpaceV2 $prefix 0 ()))))
         ($_ (store:close $after)) ($_ (db:close $db))) APPEND_LEGACY_OK))
(= (append-fixture:run (Failure $path $input))
  (let* (($db (db:open $path))
         ($_ (assertEqual (db:add $db (retained yes)) True))
         ($result (catch (db:import-act $db $input)))
         ($_ (case $result
               (((Error $where $why) True)
                ($wrong (assertEqual $wrong expected-io-failure)))))
         ($before-retry (db:snapshot $db))
         ($_ (assertEqual (collapse (get-atoms $before-retry)) ((retained yes))))
         ($_ (db:close $before-retry))
         ($_ (assertEqual (db:import-act $db $input) True))
         ($after-retry (db:snapshot $db))
         ($_ (assertEqual (size-atom (collapse (get-atoms $after-retry))) 18))
         ($_ (db:close $after-retry)) ($_ (db:close $db))) APPEND_FAILURE_OK))
(= (append-fixture:run (Indexed $path $input))
  (let* (($db (db:open $path))
         ($_ (assertEqual (db:ensure $db indexed
                ((SpaceIndexV1 3 0) (SpaceIndexV1 3 1) (SpaceIndexV1 2 1))) True))
         ($_ (assertEqual (db:import-act $db indexed $input) True))
         ($source (act:open $input)) ($snapshot (db:snapshot $db indexed))
         ($_ (assertEqual (collapse (match $snapshot (edge a b) hit))
              (collapse (match $source (edge a b) hit))))
         ($_ (assertEqual (collapse (match $snapshot (rel one one) hit))
              (collapse (match $source (rel one one) hit))))
         ($_ (assertEqual (collapse (match $snapshot (rel one two) hit))
              (collapse (match $source (rel one two) hit))))
         ($_ (assertEqual (collapse (match $snapshot (number 1) hit))
              (collapse (match $source (number 1) hit))))
         ($_ (act:close! $source)) ($_ (db:close $snapshot)) ($_ (db:close $db))) APPEND_INDEXED_OK))
