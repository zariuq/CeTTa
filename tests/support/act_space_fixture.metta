!(import! &self (library act))
!(import! &self (library lib_he))
!(import! &self (library str))
!(import! &self (library system))
!(import! &self (library fs))

(= (act-test:run $path)
  (let* (($source (new-space))
         ($_ (add-atom $source (edge a b)))
         ($_ (add-atom $source (edge a b)))
         ($_ (add-atom $source (edge b c)))
         ($_ (add-atom $source (pair $x $x)))
         ($_ (add-atom $source (= (stored-code) (println! SHOULD_NOT_EXECUTE))))
         ($_ (assertEqual (act:dump! $source $path) True))
         ($snapshot (act:open $path))
         ($_ (assertEqual (collapse (match $snapshot (edge a $x) $x)) (b b)))
         ($_ (assertEqual (collapse (match $snapshot (, (edge a $x) (edge $x c)) $x)) (b b)))
         ($_ (assertEqual (collapse (match $snapshot (pair 1 2) no)) ()))
         ($_ (assertEqual (collapse (match $snapshot (pair 1 1) yes)) (yes)))
         ($_ (assertEqual (act:dump! $snapshot (str:concat $path ".copy")) True))
         ($copy (act:open (str:concat $path ".copy")))
         ($_ (assertEqual (collapse (match $copy (edge a $x) $x)) (b b)))
         ($editable (act:workspace $snapshot))
         ($_ (assertEqual (act:close! $snapshot) True))
         ($_ (add-atom $editable (edge a b)))
         ($_ (assertEqual (collapse (match $editable (edge a $x) $x)) (b b b)))
         ($_ (assertEqual (act:dump! $editable (str:concat $path ".edited")) True))
         ($edited (act:open (str:concat $path ".edited")))
         ($_ (assertEqual (collapse (match $edited (edge a $x) $x)) (b b b)))
         ($loaded (new-space))
         ($_ (assertEqual (act:load! $loaded $path) True))
         ($_ (assertEqual (collapse (match $loaded (edge a $x) $x)) (b b)))
         ($_ (assertEqual (act:dump-mork! $source (str:concat $path ".act")) True))
         ($mork (act:open (str:concat $path ".act")))
         ($_ (assertEqual (collapse (match $mork (edge a $x) $x)) (b)))
         ($_ (assertEqual (collapse (match $mork (pair 1 1) yes)) (yes)))
         ($_ (assertEqual (act:close! $mork) True))
         ($_ (assertEqual (act:close! $copy) True))
         ($_ (assertEqual (act:close! $editable) True))
         ($_ (assertEqual (act:close! $edited) True))) ACT_SPACE_OK))
