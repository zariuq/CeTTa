; Measurement uses the same embedded and service query implementations.
!(import! &self "space_graph_fixture.metta")
!(import! &self "space_query_fixture.metta")
!(import! &self "../../examples/native_space_query_server.metta")
(= (bench-space:count $count $row) (+ $count 1))
(QueryPureCallbackV1 bench-space:count)

(= (bench-space:configuration)
  (let (ValueServiceV1 $socket $data $routes $limits) (query-server:configuration)
    (ValueServiceV1 $socket $data
      (list:append $routes
        ((ServiceRouteV1 GraphOpen Read graph-server:open)
         (ServiceRouteV1 GraphPage Read graph-server:page)
         (ServiceRouteV1 GraphInspect Read graph-server:inspect)
         (ServiceRouteV1 GraphCancel Read graph-server:cancel))) $limits)))
(= (bench-space:run Echo) Echo)
(= (bench-space:run (Census $path))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ((StoreScan $scan) (store:scan-open $view NoBound NoBound))
         ($answer (bench-space:census $scan 0 0 0 0 0 0 0 0))
         ($_ (store:close $scan)) ($_ (store:close $view)) ($_ (store:close $owner))) $answer))
(= (bench-space:census $scan $position $facts $indexes $receipts $metadata $other $rows $keys)
  (case (store:scan-next $scan $position)
    ((StoreEnd (BenchStorageV1 $facts $indexes $receipts $metadata $other $rows $keys))
     ((StoreKey $key $length $next)
      (let $bytes (+ (str:byte-length $key) $length)
        (if (str:starts-with $key "space/rows/v1/")
          (bench-space:census $scan $next (+ $facts $bytes) $indexes $receipts $metadata $other (+ $rows 1) (+ $keys 1))
          (if (or (str:starts-with $key "space/index/v1/") (str:starts-with $key "space/range-index/v1/"))
            (bench-space:census $scan $next $facts (+ $indexes $bytes) $receipts $metadata $other $rows (+ $keys 1))
            (if (str:starts-with $key "knowledge/receipt/v1/")
              (bench-space:census $scan $next $facts $indexes (+ $receipts $bytes) $metadata $other $rows (+ $keys 1))
              (if (str:starts-with $key "space/meta/v1/")
                (bench-space:census $scan $next $facts $indexes $receipts (+ $metadata $bytes) $other $rows (+ $keys 1))
                (bench-space:census $scan $next $facts $indexes $receipts $metadata (+ $other $bytes) $rows (+ $keys 1))))))))
     ($failure $failure))))
(= (bench-space:run (Rel $path $plan $count $fuel))
  (space-query:run (At $path $plan $count $fuel)))
(= (bench-space:run (Graph $path $plan $count $fuel $states))
  (space-graph:run (Query $path sample 3 $plan $count $fuel $states)))
(= (bench-space:run (First $path $plan $states))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner))
         ($cursor (kbg:open-space $view sample 3 $plan 131072 $states))
         ($_ (store:close $view)) ($_ (store:close $owner)))
    (if (kbg:cursor? $cursor) (bench-space:first $cursor 20000) $cursor)))
(= (bench-space:first $cursor $rounds)
  (if (== $rounds 0) (let $_ (kbg:close $cursor) (BenchUnfinishedV1))
    (case (kbg:page $cursor 1 32)
      (((KgPage $rows (KgMore $next)) (bench-space:more $next $rows $rounds))
       ((KgPage $rows (KgPaused $next)) (bench-space:more $next $rows $rounds))
       ((KgPage $rows (KgComplete $work)) (BenchFirstV1 $rows Complete $work))
       ((KgPage $rows (KgFailure $error $work)) (BenchFailedV1 $error $work))
       ($failure (let $_ (kbg:close $cursor) $failure))))))
(= (bench-space:more $next $rows $rounds)
  (if (== $rows ()) (bench-space:first $next (- $rounds 1))
    (let* (((KgCursor $base $config $mode $frontier $active $work) $next)
           ($_ (kbg:close $next))) (BenchFirstV1 $rows More $work))))
