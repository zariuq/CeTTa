!(import! &self (library space_transfer))
(= (danger) (println! ACCIDENTAL_EXECUTION))
(= (transfer-test:run (HeaderValid $header)) (transfer:header? $header))
(= (transfer-test:run (At $path $command))
  (let* (((StoreOpened $owner) (store:open $path "existing"))
         ((StoreSnapshot $view $epoch $revision) (store:snapshot $owner)))
    (case $command
      (((Export $collection $maximum)
        (case (durable-space:export-open $view $collection $maximum)
          (((SpaceExportOpenedV1 $state $header) (transfer-test:export $state $header ())) ($failure $failure))))
       ((Import $collection $request $header $digest $rows $footer $maximum)
        (case (durable-space:import-open $owner $view $collection $request $header $digest $maximum)
          (((SpaceImportOpenedV1 $state) (transfer-test:import $owner $state $rows $footer ())) ($prior $prior))))
       ((Origin $collection $request $origin) (durable-space:import-origin $view $collection $request $origin))
       ((Alias $collection $request $header $digest $row $replacement $footer)
        (let* (((SpaceImportOpenedV1 $state) (durable-space:import-open $owner $view $collection $request $header $digest 1048576))
               ((SpaceImportMoreV1 $next $mapping) (durable-space:import-row $state $row))
               ($stale (durable-space:import-row $state $replacement))
               ($finished (durable-space:import-finish $owner $next $footer)))
          (TransferAliasV1 $stale $finished)))
       ($bad (SpaceRefusedV1 transfer-test-command))))))
; Small-fixture oracle only. Production callers keep one row at a time.
(= (transfer-test:export $state $header $rows)
  (case (durable-space:export-next $state)
    (((SpaceExportMoreV1 $next $row) (transfer-test:export $next $header (cons-atom $row $rows)))
     ((SpaceExportCompleteV1 $footer) (TransferArchiveV1 $header (list:reverse $rows) $footer))
     ($failure $failure))))
(= (transfer-test:import $owner $state $rows $footer $mappings)
  (if (== $rows ())
    (let $answer (durable-space:import-finish $owner $state $footer)
      (TransferResultV1 $answer (list:reverse $mappings)))
    (let $row (car-atom $rows)
     (case (durable-space:import-row $state $row)
      (((SpaceImportMoreV1 $next $mapping)
        (transfer-test:import $owner $next (cdr-atom $rows) $footer (cons-atom $mapping $mappings)))
       ($failure $failure))))))
