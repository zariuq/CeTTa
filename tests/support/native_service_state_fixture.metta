; Retained MeTTa continuations use the same native views and query cursors.
!(import! &self "../../examples/native_kb_server.metta")
!(import! &self (library list))
(= (danger) (println! ACCIDENTAL_EXECUTION))

(= (state-server:configuration)
  (let (ValueServiceV1 $socket $data $routes $limits) (kb-server:configuration)
    (ValueServiceV1 $socket $data
      (list:append $routes
        ((ServiceRouteV1 OpenState Read state-server:open)
         (ServiceRouteV1 StepState Read state-server:step)
         (ServiceRouteV1 CancelState Read state-server:cancel)
         (ServiceRouteV1 FailState Read state-server:fail)
         (ServiceRouteV1 BadReplyState Read state-server:bad-reply)
         (ServiceRouteV1 PureState Read state-server:pure)
         (ServiceRouteV1 EchoState Read state-server:echo)
         (ServiceRouteV1 AliasState Read state-server:alias)
         (ServiceRouteV1 ForgeState Read state-server:forge)
         (ServiceRouteV1 InspectState Read state-server:inspect)
         (ServiceRouteV1 ClosedState Read state-server:closed)
         (ServiceRouteV1 DeepState Read state-server:deep)
         (ServiceRouteV1 HeapState Read state-server:heap))) $limits)))
(= (state-server:limited-configuration)
  (let (ValueServiceV1 $socket $data $routes $limits) (state-server:configuration)
    (ValueServiceV1 $socket $data $routes (ServiceLimitsV1 4 3 262144 10000 65536 1000000))))
(= (state-server:open (ServiceCallV1 $configuration $peer $view (StateOpenV1 $collection $payload)))
  (let* (((StoreSnapshot $copy $epoch $revision) (store:view-clone $view))
         ((StoreQueryOpened $query $same $r) (durable-space:cursor $copy $collection $row $row)))
    (ServiceKeepValueV1 (StateCursorV1 $copy $query 0 0 $payload) (StateOpenedV1 $epoch $revision))))
(: state-server:advance (-> Atom %Undefined%))
(= (state-server:step (ServiceCallV1 $configuration $peer $state $unused))
  (state-server:advance $state))
(= (state-server:advance (StateCursorV1 $view $query $sequence $count $payload))
  (let $answer (store:space-query-next $query $sequence 128 131072)
    (case $answer
      (((StoreQueryRow $same $value $ids)
        (let $_ (store:space-query-checkpoint $query)
          (ServiceKeepValueV1 (StateCursorV1 $view $query (+ $sequence 1) (+ $count 1) $payload)
            (StateRowV1 $value $ids $payload))))
       (StoreQueryPaused
        (let $_ (store:space-query-checkpoint $query)
          (ServiceKeepValueV1 (StateCursorV1 $view $query $sequence $count $payload) StatePausedV1)))
       (StoreQueryEnd
        (let* (($_ (store:close $query)) ($_ (store:close $view))) (StateDoneV1 $count $payload)))
       ($failure $failure)))))
(= (state-server:cancel (ServiceCallV1 $configuration $peer (StateCursorV1 $view $query $sequence $count $payload) $unused))
  (let* (($_ (store:space-query-cancel $query)) ($_ (store:close $query)) ($_ (store:close $view))) StateCancelledV1))
(= (state-server:fail $input) (empty))
(= (state-server:bad-reply (ServiceCallV1 $configuration $peer $state $oversize))
  (let $large (str:concat $oversize $oversize) (ServiceKeepValueV1 $state $large)))
(= (state-server:pure (ServiceCallV1 $configuration $peer $unused $payload))
  (ServiceKeepValueV1 $payload StatePureV1))
(= (state-server:echo (ServiceCallV1 $configuration $peer $state $unused))
  (ServiceKeepValueV1 $state $state))
(= (state-server:alias (ServiceCallV1 $configuration $peer $view $unused))
  (ServiceKeepValueV1 (AliasV1 $view) StateAliasV1))
(= (state-server:forge (ServiceCallV1 $configuration $peer (NativeHandle $kind $id) $unused))
  (ServiceKeepValueV1 (NativeHandle $kind (+ $id 0)) StateForgedV1))
(= (state-server:inspect (ServiceCallV1 $configuration $peer $state $unused))
  (store:view-info $state))
(= (state-server:closed (ServiceCallV1 $configuration $peer $view $unused))
  (let* (((StoreSnapshot $copy $epoch $revision) (store:view-clone $view))
         ($_ (store:close $copy))) (ServiceKeepValueV1 $copy StateClosedV1)))
(= (state-server:heap $input) (ServiceKeepValueV1 (new-space) StateHeapV1))
(= (state-server:deep $input)
  (let $value (state-server:nest 70) (ServiceKeepValueV1 $value StateDeepV1)))
(= (state-server:nest $count)
  (if (== $count 0) ()
    (let $value (state-server:nest (- $count 1)) (NestedV1 $value))))
