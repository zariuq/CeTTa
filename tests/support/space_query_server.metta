!(import! &self "../../examples/native_space_query_server.metta")
!(import! &self "space_query_callbacks.metta")
(QueryPureCallbackV1 kb:alpha-equal)
(QueryPureCallbackV1 sq-test:identity)
(QueryPureCallbackV1 sq-test:never-less)
(QueryPureCallbackV1 sq-test:bind)
(QueryPureCallbackV1 sq-test:positive)
(QueryPureCallbackV1 sq-test:metric-key)
(QueryPureCallbackV1 sq-test:metric-less)
(QueryPureCallbackV1 sq-test:metric-value)
(QueryPureCallbackV1 sq-test:stats)
(QueryPureCallbackV1 sq-test:no-answer)
(QueryPureCallbackV1 sq-test:many-answers)
(QueryPureCallbackV1 sq-test:append)
; Deliberately not approved; the test checks it never runs as a callback.
(= (sq-test:unapproved $row) (add-atom &self (UnapprovedRan)))
(= (sq-test:unapproved-count (ServiceCallV1 $configuration $peer $unused $arguments))
  (size-atom (collapse (match &self (UnapprovedRan) Witness))))
(= (query-test:configuration)
  (let (ValueServiceV1 $socket $data $routes $limits) (query-server:configuration)
    (ValueServiceV1 $socket $data
      (list:append $routes ((ServiceRouteV1 UnapprovedCount Read sq-test:unapproved-count))) $limits)))
