!(import! &self (library db))
!(import! &self (library lib_he))
(= (range-test:side-effect) (println! ACCIDENTAL_EXECUTION))
(: range-test:rows (-> %Undefined% Atom %Undefined%))
(: range-test:compare (-> %Undefined% %Undefined% Atom %Undefined%))
(= (range-test:rows $owner $plan)
  (case (db:query-plan $owner (KqMap $plan db:public-row))
    (((Error $where $why) (Error $where $why))
     ($query (range-test:pages $query)))))
(= (range-test:pages $query)
  (case (db:page $query 2 1000)
    (((db:page-result $rows db:complete) $rows)
     ((db:page-result $rows (db:more $next)) (list:append $rows (range-test:pages $next)))
     ((db:page-result $rows (db:paused $next)) (list:append $rows (range-test:pages $next)))
     ($failure (Error range-test:pages $failure)))))
(= (range-test:compare $embedded $remote $plan)
  (let* (($expected (range-test:rows $embedded $plan))
         ($actual (range-test:rows $remote $plan))
         ($_ (assertEqual (knowledge:tagged? $expected Error 3) False))
         ($_ (assertEqual (knowledge:tagged? $actual Error 3) False))
         ((StoreEncoded $left) (store:encode $expected))
         ((StoreEncoded $right) (store:encode $actual)))
    (assertEqual $left $right)))
(= (range-test:run (Compare $directory $socket $collection $indexed))
  (let* (($embedded (db:open $directory)) ($remote (db:connect $socket))
         ($_ (range-test:compare $embedded $remote
              (KqRange $collection 3 2 (Inclusive -2) (Inclusive 7) (value $label $n) ($label $n))))
         ($_ (range-test:compare $embedded $remote
              (KqRange $collection 3 2 (Exclusive 1) (Exclusive 5) (value $label $n) ($label $n))))
         ($_ (range-test:compare $embedded $remote
              (KqRange $collection 3 2 NoBound NoBound (value $label $n) ($label $n))))
         ($_ (range-test:compare $embedded $remote
              (KqRange $collection 4 3 (Inclusive 5) (Inclusive 5) (open one $other $n) $other)))
         ($_ (range-test:compare $embedded $remote
              (KqRange $collection 3 2 (Exclusive 5) (Inclusive 5) (value $label $n) ($label $n))))
         ($_ (range-test:compare $embedded $remote
              (KqRange $collection 3 2 (Inclusive 9223372036854775807) NoBound (value $label $n) ($label $n))))
         ($_ (range-test:compare $embedded $remote
              (KqRange $collection 1 0 NoBound NoBound $original $original)))
         ($_ (range-test:compare $embedded $remote
              (KqRange $collection 2 0 NoBound NoBound $original $original)))
         ($_ (if $indexed
              (range-test:compare $embedded $remote
                (KqIndexedI64Range $collection 3 2 NoBound NoBound (value $label $n) ($label $n)))
              (assertEqual (catch (db:query-plan $remote
                (KqIndexedI64Range $collection 3 2 NoBound NoBound (value $label $n) ($label $n))))
                (Error db:query (KbRefused ordered-integer-index-required)))))
         ($_ (db:close $embedded)) ($_ (db:close $remote))) REMOTE_RANGE_COMPARE_OK))

(= (range-test:run (Retain $directory $socket $collection))
  (let* (($embedded (db:open $directory)) ($remote (db:connect $socket))
         ($plan (KqRange $collection 3 2 NoBound NoBound (value $label $n) ($label $n)))
         ($expected (range-test:rows $embedded $plan))
         ($query (db:query-plan $remote (KqMap $plan db:public-row)))
         ((db:page-result $head (db:more $next)) (db:page $query 1 100000))
         ($_ (db:close $remote))
         ($_ (db:transaction $embedded $collection (|-> ($space) (add-atom $space (value newly-published 2)))))
         ($rest (range-test:pages $next))
         ($actual (list:append $head $rest))
         ((StoreEncoded $left) (store:encode $expected))
         ((StoreEncoded $right) (store:encode $actual))
         ($_ (assertEqual $left $right)) ($_ (db:close $embedded))) REMOTE_RANGE_RETAINED_OK))

(= (range-test:run (Interrupted $socket))
  (let* (($remote (db:connect $socket))
         ($query (db:query-plan $remote (KqRange values 3 2 NoBound NoBound (value $label $n) $n)))
         ($result (db:page $query 2 1000))
         ($_ (case $result
               (((db:page-result $rows (db:failed $reason)) (assertEqual (size-atom $rows) 0))
                ($wrong (assertEqual $wrong expected-explicit-failure)))))
         ($_ (db:close $remote))) REMOTE_RANGE_INTERRUPTED_OK))
(= (range-test:run (Cancel $socket))
  (let* (($remote (db:connect $socket))
         ($query (db:query-plan $remote (KqRange values 3 2 NoBound NoBound (value $label $n) $n)))
         ((db:page-result $rows (db:paused $next)) (db:page $query 2 1))
         ($_ (db:close $remote)) ($_ (assertEqual (db:close $next) True))) REMOTE_RANGE_CANCELLED_OK))
(= (range-test:run (Protocol $socket))
  (let $_ (assertEqual (catch (db:connect $socket)) (Error db:connect (StoreRemoteFailed invalid-response)))
    REMOTE_PROTOCOL_REFUSED_OK))
