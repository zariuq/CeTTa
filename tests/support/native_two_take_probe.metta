!(collapse (match &pm (pm:state $c $k $d $r) (pm:at $c $k)))
!(collapse (transform &pm (take (pm:state (pm:evlis (pm:items $V0 $V1) $V2 $V3) $V4 $V5 $V6)) (pm:state (pm:eval $V0) (pm:k (pm:k-evlis $V1 $V2 $V3) $V4) $V5 $V6) &pm))
!(collapse (transform &pm (take (pm:state (pm:evlis pm:nil $V0 $V1) $V2 $V3 $V4)) (pm:state (pm:rev $V0 pm:nil $V1) $V2 $V3 $V4) &pm))
