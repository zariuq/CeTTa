; A replay of the store operations of three evaluations on a machine of transform rules,
; as plain calls: no machine library is needed.  At the end a rule with two takes is
; offered at a store where `match` finds its join.
!(import! &self (library lib_transform))
(= (pm:list2 $a $b) (cons-atom $a (cons-atom $b ())))
(= (pm:list3 $a $b $c) (cons-atom $a (cons-atom $b (cons-atom $c ()))))
(= (pm:list4 $a $b $c $d) (cons-atom $a (cons-atom $b (cons-atom $c (cons-atom $d ())))))
(= (pm:list-of $items)
   (if (== $items pm:nil) ()
     (let ($_items $first $rest) $items
       (let $tail (pm:list-of $rest) (cons-atom $first $tail)))))
(= (pm:reversed $items $onto)
   (if (== $items pm:nil) $onto
     (let ($_items $first $rest) $items
       (pm:reversed $rest (cons-atom $first $onto)))))
(= (pm:expression $f $items)
   (if (== $f pm:tuple) (pm:list-of $items) (cons-atom $f (pm:list-of $items))))
(= (pm:compute $op $items)
   (let $call (cons-atom $op (pm:list-of $items)) (eval $call)))
!(bind! &pm (new-space))
!(add-atom &pm (pm:fun double))
!(add-atom &pm (pm:fun fib))
!(add-atom &pm (pm:fun colour))
!(add-atom &pm (pm:fun len))
!(add-atom &pm (pm:fun kind))
!(add-atom &pm (pm:fun pick))
!(add-atom &pm (pm:fun sort-of))
!(add-atom &pm (pm:fun first-colour))
!(add-atom &pm (pm:fun all-colours))
!(add-atom &pm (pm:fun sign))
!(add-atom &pm (pm:fun keep-first))
!(add-atom &pm (pm:clause double z (pm:head (pm:items $V0 pm:nil)) (pm:prim * (pm:items (pm:lit $V0) (pm:items (pm:lit 2) pm:nil)))))
!(add-atom &pm (pm:clause fib z (pm:head (pm:items $V1 pm:nil)) (pm:if (pm:prim < (pm:items (pm:lit $V1) (pm:items (pm:lit 2) pm:nil))) (pm:lit $V1) (pm:prim + (pm:items (pm:call fib (pm:items (pm:prim - (pm:items (pm:lit $V1) (pm:items (pm:lit 1) pm:nil))) pm:nil)) (pm:items (pm:call fib (pm:items (pm:prim - (pm:items (pm:lit $V1) (pm:items (pm:lit 2) pm:nil))) pm:nil)) pm:nil))))))
!(add-atom &pm (pm:clause colour z (pm:head pm:nil) (pm:lit red)))
!(add-atom &pm (pm:clause colour (s z) (pm:head pm:nil) (pm:lit green)))
!(add-atom &pm (pm:clause colour (s (s z)) (pm:head pm:nil) (pm:lit blue)))
!(add-atom &pm (pm:clause len z (pm:head (pm:items Nil pm:nil)) (pm:lit 0)))
!(add-atom &pm (pm:clause len (s z) (pm:head (pm:items (Cons $V2 $V3) pm:nil)) (pm:prim + (pm:items (pm:lit 1) (pm:items (pm:call len (pm:items (pm:lit $V3) pm:nil)) pm:nil)))))
!(add-atom &pm (pm:clause kind z (pm:head (pm:items (leaf $V4) pm:nil)) (pm:lit leaf)))
!(add-atom &pm (pm:clause kind (s z) (pm:head (pm:items (node $V5 $V6) pm:nil)) (pm:lit node)))
!(add-atom &pm (pm:clause kind (s (s z)) (pm:head (pm:items $V7 pm:nil)) (pm:lit something)))
!(add-atom &pm (pm:clause pick z (pm:head (pm:items $V8 pm:nil)) (pm:if (pm:prim > (pm:items (pm:lit $V8) (pm:items (pm:lit 1) pm:nil))) (pm:lit $V8) pm:empty)))
!(add-atom &pm (pm:clause sort-of z (pm:head (pm:items $V9 pm:nil)) (pm:case (pm:lit $V9) (pm:items (pm:row 1 (pm:lit one)) (pm:items (pm:row 2 (pm:lit two)) (pm:items (pm:row $V10 (pm:data many (pm:items (pm:lit $V10) pm:nil))) pm:nil))))))
!(add-atom &pm (pm:clause first-colour z (pm:head pm:nil) (pm:once (pm:call colour pm:nil))))
!(add-atom &pm (pm:clause all-colours z (pm:head pm:nil) (pm:collapse (pm:call colour pm:nil))))
!(add-atom &pm (pm:clause sign z (pm:head (pm:items $V11 pm:nil)) (pm:seq (pm:if (pm:prim > (pm:items (pm:lit $V11) (pm:items (pm:lit 0) pm:nil))) pm:cut pm:empty) (pm:lit positive))))
!(add-atom &pm (pm:clause sign (s z) (pm:head (pm:items $V12 pm:nil)) (pm:lit other)))
!(add-atom &pm (pm:clause keep-first z (pm:head pm:nil) (pm:seq (pm:call colour pm:nil) (pm:seq pm:cut (pm:lit kept)))))
!(add-atom &pm (pm:clause keep-first (s z) (pm:head pm:nil) (pm:lit never)))
!(collapse (remove-atom &pm (pm:state $c $k $d $r)))
!(collapse (remove-atom &pm (pm:alt $d2 $c2 $k2)))
!(collapse (remove-atom &pm (pm:done $r2)))
!(collapse (remove-atom &pm (pm:bag $d3 $items)))
!(add-atom &pm (pm:state (pm:eval (pm:let (pair $V0 $V1) (pm:data triple (pm:items (pm:lit 1) (pm:items (pm:lit 2) (pm:items (pm:lit 3) pm:nil)))) (pm:lit $V0))) pm:halt z pm:nil))
