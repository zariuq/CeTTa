!(import! &self "../../lib/petta/rel.metta")
(= (kb-rel:equal-key $a $b)
   (if (== (car-atom $a) (car-atom $b)) RelTrue RelFalse))
(= (kb-rel:unknown $a $b) RelUnknown)
(= (kb-rel:pair $a $b) (cons-atom $a (cons-atom $b ())))
(= (kb-rel:callable-data) "invoked")
(= (kb-rel:unary $value) (Invoked $value))
(= (kb-rel:callable-projection $left $right) kb-rel:callable-data)
(= (kb-rel:empty $a $b) ())
(= (kb-rel:several $a $b) (superpose (one two)))
(= (kb-rel:first $row) (car-atom $row))
(= (kb-rel:open-bool $left $right) (car-atom $left))
(= (kb-rel:wrap $answer)
   (case $answer (((Error $source $why) (RelFailure $source $why)) ($other (RelValue $other)))))
(= (kb-rel:run (Not $value)) (kb-rel:wrap (rel:not $value)))
(= (kb-rel:run (And $a $b)) (kb-rel:wrap (rel:and $a $b)))
(= (kb-rel:run (Or $a $b)) (kb-rel:wrap (rel:or $a $b)))
(= (kb-rel:run CallableProjection)
   (rel:left-join kb-rel:unknown kb-rel:callable-projection KbMissing (one) ()))
(= (kb-rel:run (OpenTruth $rows)) (kb-rel:wrap (rel:select kb-rel:first $rows)))
(= (kb-rel:run (OpenBool $rows)) (kb-rel:wrap (rel:distinct kb-rel:open-bool $rows)))
(= (kb-rel:run (Left $left $right))
   (rel:left-join kb-rel:equal-key kb-rel:pair KbMissing $left $right))
(= (kb-rel:run (Unknown $left $right))
   (rel:left-join kb-rel:unknown kb-rel:pair KbMissing $left $right))
(= (kb-rel:run (EmptyRow $left $right))
   (rel:left-join kb-rel:equal-key kb-rel:empty KbMissing $left $right))
(= (kb-rel:run (Several $left $right))
   (case (rel:left-join kb-rel:equal-key kb-rel:several KbMissing $left $right)
     (((Error $source $why) (RelFailure $source $why)) ($unexpected $unexpected))))
