; `==` compares operands of one type.  A literal symbol that no annotation
; names has type %Undefined%, which matches every type.  A declared literal is
; still checked, including one declared while the program runs, and a
; registry token keeps the registry's typing.
(= (is-nil $x) (== $x Nil))
(= (nil-is $x) (== Nil $x))
(= (is-tag $x) (== $x Tag))
(= (is-kind $x) (== $x Kinded))
(: Kinded Kind)
(= (is-token $x) (== $x &tok))
(: seen (-> Atom %Undefined%))
(= (seen $v) (case $v (((Error $a $b) (error $b)) ($x $x))))
!(is-nil Nil)
!(is-nil (Cons 1 Nil))
!(is-nil 1)
!(nil-is "s")
!(nil-is Nil)
!(seen (is-kind Kinded))
!(seen (is-kind 1))
!(seen (is-kind Other))
!(seen (is-tag 2))
!(seen (is-tag Tag))
!(add-atom &self (: Tag Label))
!(seen (is-tag 2))
!(seen (is-tag Tag))
!(seen (is-tag Other))
!(bind! &tok 5)
!(seen (is-token 5))
!(seen (is-token "s"))
