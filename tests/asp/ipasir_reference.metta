; The SAT personality against an IPASIR solver loaded at run time: on each
; clause set, the same verdict and, when satisfiable, the same set of models.
!(import! &self sat)
!(import! &self ipasir)
(= (canon-each $ms)
   (if (== $ms ()) () (let ($h $t) (decons-atom $ms) (cons-atom (sort $h) (canon-each $t)))))
(= (canon $ms) (sort (canon-each $ms)))
(= (ours $c) (let (models $ms $cert) (sat:models $c) (canon $ms)))
(= (theirs $c) (let (models $ms (reference $sig)) (ipasir:models $c) (canon $ms)))
(= (verdict (model $m)) sat)
(= (verdict (unsat $e)) unsat)
(= (agree $name $c)
   ($name (== (ours $c) (theirs $c)) (== (verdict (sat:solve $c)) (verdict (ipasir:solve $c)))
          (size-atom (theirs $c))))
!(agree one-of-two ((clause (a b) ()) (clause () (a b))))
!(agree chain ((clause (p) ()) (clause (q) (p)) (clause (r) (q)) (clause (s) (r))))
!(agree contradiction ((clause (x) ()) (clause () (x))))
!(agree xor3 ((clause (a b c) ()) (clause (c) (a b)) (clause (b) (a c)) (clause (a) (b c))))
!(agree pigeons32 ((clause ((p 1 1) (p 1 2)) ()) (clause ((p 2 1) (p 2 2)) ()) (clause ((p 3 1) (p 3 2)) ()) (clause () ((p 1 1) (p 2 1))) (clause () ((p 1 1) (p 3 1))) (clause () ((p 2 1) (p 3 1))) (clause () ((p 1 2) (p 2 2))) (clause () ((p 1 2) (p 3 2))) (clause () ((p 2 2) (p 3 2)))))
!(agree no-clauses ())
!(agree empty-clause ((clause (a) ()) (clause () ())))
