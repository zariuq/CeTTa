; Finite admissible configurations, diagnosis, prior reduction and changed goals.
; Lean: PriorReduction.posterior_prior_reduction, DecisionBounds.regret_le_of_score_error,
; WellFoundedServices.ConstraintPlanning, FiniteAdaptivePolicy.evaluate_refines.
!(pragma! prefer-rationals True)
!(import! &self ../../../../lib/probability/finite_decision.metta)

(= (repair:prior) ((ram 1/2) (disk 1/2)))
(= (repair:likelihood) ((ram 3/4) (disk 1/4)))
(= (repair:new-prior) ((ram 1/4) (disk 3/4)))
(= (repair:kernel)
   (((diagnose ram) (((ram memory) 1)))
    ((diagnose disk) (((disk storage) 1)))
    ((replaceRam ram) (((fixedRam done) 1)))
    ((replaceRam disk) (((broken done) 1)))
    ((replaceDisk ram) (((broken done) 1)))
    ((replaceDisk disk) (((fixedDisk done) 1)))
    ((replaceBoth ram) (((fixedBoth done) 1)))
    ((replaceBoth disk) (((fixedBoth done) 1)))))
(= (repair:cheap-goal)
   ((ram 0) (disk 0) (fixedRam 9) (fixedDisk 8) (fixedBoth 5) (broken 0)))
(= (repair:urgent-goal)
   ((ram 0) (disk 0) (fixedRam 10) (fixedDisk 10) (fixedBoth 9) (broken 0)))
(= (repair:plans)
   ((ram (bayes:act replaceRam ((done (bayes:stop)))))
    (disk (bayes:act replaceDisk ((done (bayes:stop)))))
    (both (bayes:act replaceBoth ((done (bayes:stop)))))))

(= (repair:configuration-action ((memory new) (storage old))) replaceRam)
(= (repair:configuration-action ((memory old) (storage new))) replaceDisk)
(= (repair:configuration-action ((memory new) (storage new))) replaceBoth)
(= (repair:allowed)
   (let $configurations
        (bayes:configurations ((memory (old new)) (storage (old new)))
          ((excludes memory old storage old)))
     (map-atom $configurations $configuration (repair:configuration-action $configuration))))

!(bayes:configurations ((memory (old new)) (storage (old new)))
   ((excludes memory old storage old)))
!(let* (($prior (repair:prior)) ($likelihood (repair:likelihood)))
   (bayes:update $prior $likelihood))
!(let* (($prior (repair:prior)) ($likelihood (repair:likelihood)) ($kernel (repair:kernel))
        ($goal (repair:cheap-goal)) ($plans (repair:plans)) ($allowed (repair:allowed)))
   (case (bayes:update $prior $likelihood)
     (((bayes:posterior $posterior $evidence)
        (bayes:choose $posterior $kernel $goal $allowed $plans))
      ($failure $failure))))
!(let* (($old (repair:prior)) ($new (repair:new-prior)) ($likelihood (repair:likelihood)))
   (case (bayes:update $old $likelihood)
     (((bayes:posterior $posterior $evidence) (bayes:reduce $old $new $posterior))
      ($failure $failure))))
!(let* (($old (repair:prior)) ($new (repair:new-prior)) ($likelihood (repair:likelihood))
        ($kernel (repair:kernel)) ($goal (repair:cheap-goal)) ($plans (repair:plans))
        ($allowed (repair:allowed)))
   (case (bayes:update $old $likelihood)
     (((bayes:posterior $posterior $evidence)
        (case (bayes:reduce $old $new $posterior)
          (((bayes:posterior $reduced $ratio)
             (bayes:choose $reduced $kernel $goal $allowed $plans))
           ($failure $failure)))) ($failure $failure))))
!(let* (($prior (repair:prior)) ($likelihood (repair:likelihood)) ($kernel (repair:kernel))
        ($goal (repair:urgent-goal)) ($plans (repair:plans)) ($allowed (repair:allowed)))
   (case (bayes:update $prior $likelihood)
     (((bayes:posterior $posterior $evidence)
        (bayes:choose $posterior $kernel $goal $allowed $plans))
      ($failure $failure))))
!(bayes:certify-order 4 ram ((ram (27/4 27/4)) (disk (2 2)) (both (5 5)))
   ((faultPrior 1) (sensor 1) (goal cheap)) ((faultPrior 1) (sensor 1) (goal urgent)))
!(bayes:certify-order 4 both ((ram (15/2 15/2)) (disk (5/2 5/2)) (both (9 9)))
   ((faultPrior 1) (sensor 1) (goal urgent)) ((faultPrior 1) (sensor 1) (goal urgent)))
!(bayes:reduce ((ram 1) (disk 0)) ((ram 1/2) (disk 1/2)) ((ram 1) (disk 0)))
!(bayes:distribution? ((ram 1/2) (ram 1/2)))

; Coarse concepts retain a constant repair value, but not the diagnostic.
; Refining the concept family restores the distinction needed by that update.
; Lean: StochasticSufficiency.policy_value_commutes, FiniteBayes.aggregate_refines.
!(let* (($prior (repair:prior))
        ($view (bayes:concept-view $prior ((hardware (ram disk))))))
   (bayes:coarsen $prior $view))
!(let* (($prior (repair:prior)) ($likelihood (repair:likelihood))
        ($view (bayes:concept-view $prior ((hardware (ram disk))))))
   (bayes:class-consumer $likelihood $view))
!(let* (($prior (repair:prior)) ($likelihood (repair:likelihood))
        ($view (bayes:concept-view $prior ((memory (ram)) (storage (disk))))))
   (bayes:class-consumer $likelihood $view))
!(let* (($prior (repair:prior))
        ($view (bayes:concept-view $prior ((hardware (ram disk))))))
   (bayes:class-consumer ((ram 5) (disk 5)) $view))
!(let* (($prior (repair:prior))
        ($view (bayes:concept-view $prior ((hardware (ram disk)) (machine (ram disk))))))
   (bayes:class-consumer ((ram 5) (disk 5)) $view))
!(let $prior (repair:prior) (bayes:coarsen $prior ((ram memory))))

; A useful finer observation supports a better two-stage repair policy.
; Lean: ModelRefinement.finer_observation_strictly_better.
(= (repair:diagnostic-plans)
   (let* (($plans (repair:plans))
          ($ram (bayes:lookup ram $plans)) ($disk (bayes:lookup disk $plans))
          ($diagnose (bayes:act diagnose ((memory $ram) (storage $disk)))))
     (cons-atom (diagnose $diagnose) $plans)))
(= (repair:certified $concepts)
   (let* (($prior (repair:prior)) ($like (repair:likelihood)) ($kernel (repair:kernel))
          ($goal (repair:cheap-goal)) ($plans (repair:diagnostic-plans))
          ($allowed (cons-atom diagnose (repair:allowed)))
          ($view (bayes:concept-view $prior $concepts)))
     (case (bayes:class-consumer $like $view)
       (((bayes:consumer $retained)
          (bayes:certify-exact $prior $like ((ram 3/4) (disk 1/4))
            $kernel $kernel $goal $goal $allowed diagnose $plans
            ((sensor 1) (goal cheap)) ((sensor 1) (goal cheap))))
        ($failure $failure)))))
!(repair:certified ((hardware (ram disk))))
!(repair:certified ((memory (ram)) (storage (disk))))
!(repair:certified ((memory (ram)) (storage (disk)) (hardware (ram disk))))
; Revision of the fault prior and the goal is recertified against all repairs.
!(let* (($prior (repair:new-prior)) ($like (repair:likelihood)) ($kernel (repair:kernel))
        ($goal (repair:urgent-goal)) ($plans (repair:plans)) ($allowed (repair:allowed)))
   (bayes:certify-exact $prior $like ((ram 1/2) (disk 1/2))
     $kernel $kernel $goal $goal $allowed both $plans
     ((faultPrior 2) (goal urgent)) ((faultPrior 2) (goal urgent))))
!(bayes:configurations ((memory (old new)) (memory (old new))) ())
!(bayes:configurations ((memory (old new))) ((requires memory new missing (new))))
