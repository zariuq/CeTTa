; Inference, adaptive planning and revision through one reusable service.
; Lean: BayesianDecision.regret, FiniteBayes.update_refines,
; FiniteAdaptivePolicy.evaluate_refines, FiniteCoupling.checked_bound.
!(pragma! prefer-rationals True)
!(import! &self ../../../../lib/probability/finite_decision.metta)

(= (delivery:prior) ((good 1/2) (bad 1/2)))
(= (delivery:clear) ((good 3/4) (bad 1/4)))
(= (delivery:changed-clear) ((good 1/4) (bad 3/4)))
(= (delivery:kernel)
   (((inspect good) (((good clear) 3/4) ((good warning) 1/4)))
    ((inspect bad) (((bad clear) 1/4) ((bad warning) 3/4)))
    ((bridge good) (((delivered arrived) 1)))
    ((bridge bad) (((failed arrived) 1)))
    ((hill good) (((safe arrived) 1)))
    ((hill bad) (((safe arrived) 1)))))
(= (delivery:reward) ((good 0) (bad 0) (delivered 10) (failed 0) (safe 6)))
(= (delivery:bridge) (bayes:act bridge ((arrived (bayes:stop)))))
(= (delivery:hill) (bayes:act hill ((arrived (bayes:stop)))))
(= (delivery:inspect)
   (let* (($bridge (delivery:bridge)) ($hill (delivery:hill)))
     (bayes:act inspect ((clear $bridge) (warning $hill)))))
(= (delivery:plans)
   (let* (($bridge (delivery:bridge)) ($hill (delivery:hill)) ($inspect (delivery:inspect)))
     ((bridge $bridge) (hill $hill) (inspect $inspect))))
(= (delivery:routes)
   (let* (($bridge (delivery:bridge)) ($hill (delivery:hill)))
     ((bridge $bridge) (hill $hill))))

!(let* (($prior (delivery:prior)) ($kernel (delivery:kernel)) ($reward (delivery:reward))
        ($plans (delivery:plans)))
   (bayes:choose $prior $kernel $reward (inspect bridge hill) $plans))
!(let* (($prior (delivery:prior)) ($kernel (delivery:kernel)) ($reward (delivery:reward))
        ($policy (delivery:inspect)))
   (case (bayes:evaluate $prior $kernel $reward (inspect bridge hill) $policy)
     (((bayes:ok $gross) (delivery:net-inspection (- $gross 1/2))) ($failure $failure))))
!(let* (($prior (delivery:prior)) ($likelihood (delivery:clear)))
   (bayes:update $prior $likelihood))
!(let* (($prior (delivery:prior)) ($likelihood (delivery:clear)) ($kernel (delivery:kernel))
        ($reward (delivery:reward)) ($routes (delivery:routes)))
   (case (bayes:update $prior $likelihood)
     (((bayes:posterior $posterior $evidence)
        (bayes:choose $posterior $kernel $reward (bridge hill) $routes)) ($failure $failure))))
!(let* (($prior (delivery:prior)) ($likelihood (delivery:changed-clear))
        ($kernel (delivery:kernel)) ($reward (delivery:reward)) ($routes (delivery:routes)))
   (case (bayes:update $prior $likelihood)
     (((bayes:posterior $posterior $evidence)
        (bayes:choose $posterior $kernel $reward (bridge hill) $routes)) ($failure $failure))))

!(bayes:certify-order 4 bridge ((bridge (15/2 15/2)) (hill (6 6)))
   ((sensor 1) (roads 1) (reward 1)) ((sensor 2) (roads 1) (reward 1)))
!(bayes:certify-order 0 bridge ((bridge (15/2 15/2)) (hill (6 6)))
   ((sensor 1) (roads 1)) ((sensor 1) (roads 1)))
!(bayes:resume-comparison 3
   (bayes:comparison bridge 15/2 ((bridge (15/2 15/2)) (hill (6 6)))
     ((bridge (15/2 15/2)) (hill (6 6)))))
!(bayes:certify-order 4 bridge ((bridge (5 8)) (hill (6 6))) () ())
!(bayes:update ((good 3/4) (bad 3/4)) ((good 1) (bad 1)))
!(bayes:update ((good 1/2) (bad 1/2)) ((good 0) (bad 0)))
!(let* (($prior (delivery:prior)) ($kernel (delivery:kernel)) ($reward (delivery:reward))
        ($policy (delivery:bridge)))
   (bayes:evaluate $prior $kernel $reward (hill) $policy))
!(bayes:coupling? ((good 1/2) (bad 1/2)) ((good 1/2) (bad 1/2))
   (((good good) 1/2) ((bad bad) 1/2)))
!(bayes:coupling? ((good 1/2) (bad 1/2)) ((good 1/2) (bad 1/2))
   (((good good) 3/4) ((bad bad) 1/4)))

; The same raw checker certifies the contingent inspection and the observed route.
!(let* (($prior (delivery:prior)) ($kernel (delivery:kernel)) ($reward (delivery:reward))
        ($plans (delivery:plans)))
   (bayes:certify-exact $prior ((good 1) (bad 1)) ((good 1/2) (bad 1/2))
     $kernel $kernel $reward $reward (inspect bridge hill) inspect $plans
     ((sensor 1) (roads 1)) ((sensor 1) (roads 1))))
!(let* (($prior (delivery:prior)) ($like (delivery:clear)) ($kernel (delivery:kernel))
        ($reward (delivery:reward)) ($plans (delivery:routes)))
   (bayes:certify-exact $prior $like ((good 3/4) (bad 1/4))
     $kernel $kernel $reward $reward (bridge hill) bridge $plans
     ((sensor 1) (roads 1)) ((sensor 1) (roads 1))))
; A closed bridge is independently supplied as the changed world dynamics.
(= (delivery:closed-world)
   (((bridge good) (((failed arrived) 1))) ((bridge bad) (((failed arrived) 1)))
    ((hill good) (((safe arrived) 1))) ((hill bad) (((safe arrived) 1)))))
!(let* (($prior (delivery:prior)) ($like (delivery:clear)) ($model (delivery:kernel))
        ($world (delivery:closed-world)) ($reward (delivery:reward)) ($plans (delivery:routes)))
   (bayes:certify-exact $prior $like ((good 3/4) (bad 1/4))
     $model $world $reward $reward (bridge hill) bridge $plans
     ((sensor 1) (roads 2)) ((sensor 1) (roads 2))))
!(let* (($prior (delivery:prior)) ($like (delivery:clear)) ($world (delivery:closed-world))
        ($reward (delivery:reward)) ($plans (delivery:routes)))
   (bayes:certify-exact $prior $like ((good 3/4) (bad 1/4))
     $world $world $reward $reward (bridge hill) hill $plans
     ((sensor 1) (roads 2)) ((sensor 1) (roads 2))))
