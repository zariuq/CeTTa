; General raw-data certificate boundary, including different controllers.
; Lean: BayesianDecisionControls and FiniteBayesianDecision.Instance.regret.
!(pragma! prefer-rationals True)
!(import! &self ../../../../lib/probability/finite_decision.metta)

(= (raw:prior) ((healthy 1/2) (faulty 1/2)))
(= (raw:like) ((healthy 3) (faulty 1)))
(= (raw:post) ((healthy 3/4) (faulty 1/4)))
(= (raw:model) (((repair healthy) (((ready observed) 1)))
                ((repair faulty) (((ready observed) 1)))))
(= (raw:world) (((replace healthy) (((ready signal) 1)))
                ((replace faulty) (((ready signal) 1)))))
(= (raw:reward) ((healthy 0) (faulty 0) (ready 1)))
(= (raw:model-policy) (bayes:act repair ((observed (bayes:stop)))))
(= (raw:world-policy) (bayes:act replace ((signal (bayes:stop)))))
(= (raw:tree) (bayes:step ((((ready observed) (ready signal)) 1))
                ((((ready observed) (ready signal)) (bayes:terminal)))))
(= (raw:trees) (let $tree (raw:tree) (((healthy healthy) $tree) ((faulty faulty) $tree))))
(= (raw:plans)
   (let* (($first (raw:model-policy)) ($second (raw:world-policy)) ($trees (raw:trees)))
     ((repair (bayes:plan $first $second $trees 0 0 0 1)))))
(= (raw:input $initial $posterior)
   (let* (($prior (raw:prior)) ($like (raw:like)) ($model (raw:model)) ($world (raw:world))
          ($reward (raw:reward)))
     (bayes:decision-input $prior $like $posterior $posterior $posterior
       (bayes:system $model $reward (repair)) (bayes:system $world $reward (replace))
       (bayes:constant-distance 0) $initial 1 0)))
(= (raw:initial) (((healthy healthy) 3/4) ((faulty faulty) 1/4)))

!(bayes:natural? 1/2)
!(let* (($post (raw:post)) ($initial (raw:initial)) ($input (raw:input $initial $post))
        ($plans (raw:plans)))
   (bayes:certify-decision $input repair $plans 0 0 ((model 1)) ((model 1))))
!(let* (($post (raw:post)) ($input (raw:input (((healthy healthy) 1)) $post))
        ($plans (raw:plans)))
   (bayes:certify-decision $input repair $plans 0 0 ((model 1)) ((model 1))))
!(bayes:kl-bound? ((healthy 1/2) (faulty 1/2)) ((healthy 3/4) (faulty 1/4)) 1 1 1)
!(bayes:kl-bound? ((healthy 1/2) (faulty 1/2)) ((healthy 3/4) (faulty 1/4)) 1 0 1)
!(bayes:kl-bound? ((healthy 1)) ((healthy 0) (faulty 1)) 1 2 1)

!(bayes:start-log-choice 0 3 better ((other ((0 2))) (better ((1 2)))) ((goal 1)) ((goal 1)))
!(case (bayes:start-log-choice 0 3 better ((other ((0 2))) (better ((1 2)))) ((goal 1)) ((goal 1)))
   (((bayes:incomplete $work)
      (bayes:resume-log-choice 2 3 ((other ((0 2))) (better ((1 2)))) ((goal 1)) ((goal 1)) $work))
    ($answer $answer)))
!(bayes:resume-log-choice 2 3 ((other ((0 2))) (better ((1 2)))) ((goal 1)) ((goal 1))
   (bayes:log-work other (other better) () 0 ((other ((0 2))) (better ((1 2)))) ((goal 1))))
!(bayes:start-log-choice 2 3 better ((other ((1 2))) (better ((1 2)))) ((goal 1)) ((goal 1)))
!(bayes:log-score ((-1 2)) 1)
!(bayes:start-log-choice 2 3 better ((other ((0 2))) (better ((1 2)))) ((goal 1)) ((goal 2)))
!(bayes:start-log-choice 1/2 3 better ((other ((0 2))) (better ((1 2)))) ((goal 1)) ((goal 1)))

; Conditioning, execution, numerical and admissibility failures stay distinct.
!(let* (($post ((healthy 1/2) (faulty 1/2)))
        ($input (raw:input (((healthy healthy) 1/2) ((faulty faulty) 1/2)) $post))
        ($plans (raw:plans)))
   (bayes:certify-decision $input repair $plans 0 0 () ()))
!(let* (($post (raw:post)) ($initial (raw:initial)) ($input (raw:input $initial $post))
        ($first (raw:model-policy)) ($second (raw:world-policy)))
   (bayes:certify-decision $input repair
     ((repair (bayes:plan $first $second
       (((healthy healthy) (bayes:step () ())) ((faulty faulty) (bayes:step () ())))
       0 0 0 1))) 0 0 () ()))
!(let* (($post (raw:post)) ($initial (raw:initial)) ($input (raw:input $initial $post))
        ($first (raw:model-policy)) ($second (raw:world-policy)) ($trees (raw:trees)))
   (bayes:certify-decision $input repair
     ((repair (bayes:plan $first $second $trees 0 0 0 0))) 0 0 () ()))
!(let* (($post (raw:post)) ($initial (raw:initial)) ($input (raw:input $initial $post))
        ($plans (raw:plans))
        ($wait (wait (bayes:plan (bayes:stop) (bayes:stop)
          (((healthy healthy) (bayes:terminal)) ((faulty faulty) (bayes:terminal))) 0 0 0 0)))
        ($both (cons-atom $wait $plans)))
   (bayes:certify-decision $input wait $both 0 0 () ()))
; A finite nonempty checked prefix is retained and revalidated.
!(bayes:resume-log-choice 2 3 ((other ((0 2))) (better ((1 2)))) ((goal 1)) ((goal 1))
   (bayes:log-work better (other) (better) 1 ((other ((0 2))) (better ((1 2)))) ((goal 1))))
