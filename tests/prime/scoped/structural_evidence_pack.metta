; Native dependent evidence packing, without a special chainer policy.
!(bind! &thy (new-space))
!(add-atom &thy (: A (u 0)))
!(add-atom &thy (: a A))
!(add-atom &thy (: b A))
!(add-atom &thy (: B (-> (z : A) (u 0))))
!(add-atom &thy (: ha (B a)))
!(add-atom &thy (: hb (B b)))
!(type:check (lam A (lam B (lam x (lam witness (pair x witness)))))
   (-> (A : (u 0)) (B : (-> (z : A) (u 0)))
       (x : A) (witness : (B x)) (sigma (z : A) (B z))))
!(type:check (lam A (lam B (lam x (lam witness (pair witness x)))))
   (-> (A : (u 0)) (B : (-> (z : A) (u 0)))
       (x : A) (witness : (B x)) (sigma (z : A) (B z))))
!(set:define &thy packWitness
   (-> (A : (u 0)) (B : (-> (z : A) (u 0)))
       (x : A) (witness : (B x)) (sigma (z : A) (B z)))
   (= (packWitness $A $B $x $witness) (pair $x $witness)))
!(type:check &thy (packWitness A B a ha) (sigma (z : A) (B z)))
!(type:check &thy (packWitness A B b hb) (sigma (z : A) (B z)))
!(type:check &thy (packWitness A B b ha) (sigma (z : A) (B z)))
!(type:eq &thy (fst (packWitness A B a ha)) a)
!(type:eq &thy (fst (packWitness A B a ha)) b)
!(type:check &thy (snd (packWitness A B a ha)) (B a))
!(type:check &thy (snd (packWitness A B a ha)) (B b))
; Unknown evidence remains unknown; a constructor name is not authority.
!(let $outcome (try (type:check &thy
      (packWitness A B a unknownWitness) (sigma (z : A) (B z))))
   (car-atom $outcome))
; Packing native identity evidence exercises a genuinely dependent endpoint.
!(set:define &thy recordAt (-> (A : (u 0)) (x : A)
      (sigma (z : A) (id A x z)))
   (= (recordAt $A $x) (pair $x (refl $x))))
!(type:check &thy (recordAt A a) (sigma (z : A) (id A a z)))
!(type:check &thy (recordAt A b) (sigma (z : A) (id A b z)))
!(type:check &thy (recordAt A b) (sigma (z : A) (id A a z)))
!(type:eq &thy (fst (recordAt A a)) a)
!(type:check &thy (snd (recordAt A a)) (id A a a))
