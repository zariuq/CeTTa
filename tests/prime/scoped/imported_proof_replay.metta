; Controls.
;
; `lam c. S K K` with no domain written, as it is typed when each lambda takes
; its domain from its type.  The kernel cannot synthesize the type of `S`, a
; lambda without a domain applied to another, and abstains.
!(let $package (set:native-proof native-id)
   (let (SetNativeProofV1 $name $prop $proof $term $type $context $rules $assumptions $digest)
        $package
     (try (set:native-use $package
            (Lam $type
              (App (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (DeclConst all@prop) (Lam (App (App (DeclConst imp) (idx 0)) (idx 0))))) (idx 0))
                (Lam (App (App (Lam (Lam (Lam (App (App (idx 2) (idx 0)) (App (idx 1) (idx 0)))))) (Lam (Lam (idx 1)))) (Lam (Lam (idx 1)))))))))))

; The right term at a wrong type: `holds (bot -> bot)`, with `bot` the code
; `all@prop (lam c. c)`.  The first lambda is written over `prop`, which is
; apart from the decoded domain `holds bot`, a function type.
!(let $package (set:native-proof native-id)
   (let (SetNativeProofV1 $name $prop $proof $term $type $context $rules $assumptions $digest)
        $package
     (try (set:native-use $package
            (Lam $type
              (App (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (App (DeclConst all@prop) (Lam (idx 0)))) (App (DeclConst all@prop) (Lam (idx 0))))) (idx 0))
                (Lam (DeclConst prop) (App (App (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (idx 0)) (App (App (DeclConst imp) (App (App (DeclConst imp) (idx 0)) (idx 0))) (idx 0)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (idx 1)) (App (App (DeclConst imp) (idx 1)) (idx 1)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 2)) (App (App (idx 2) (idx 0)) (App (idx 1) (idx 0)))))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 0)) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (idx 1)) (idx 1))) (idx 1)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 0)) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 1)) (idx 1)))))))))))

; A wrong term at the right type: `lam c. K` proves
; `holds (all@prop (lam c. imp c (imp c c)))`; checked at `c -> c`, its inner
; lambda meets `holds c`, which is not a function type.
!(let $package (set:native-proof native-id)
   (let (SetNativeProofV1 $name $prop $proof $term $type $context $rules $assumptions $digest)
        $package
     (try (set:native-use $package
            (Lam $type
              (App (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (DeclConst all@prop) (Lam (App (App (DeclConst imp) (idx 0)) (idx 0))))) (idx 0))
                (Lam (DeclConst prop) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 0)) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 1)) (idx 1))))))))))

; `lam c. S K K` with the written domains of its first `K` replaced by those of
; its second: without domains it is the same term, but a written domain now
; disagrees with the domain it is checked at.
!(let $package (set:native-proof native-id)
   (let (SetNativeProofV1 $name $prop $proof $term $type $context $rules $assumptions $digest)
        $package
     (try (set:native-use $package
            (Lam $type
              (App (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (DeclConst all@prop) (Lam (App (App (DeclConst imp) (idx 0)) (idx 0))))) (idx 0))
                (Lam (DeclConst prop) (App (App (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (idx 0)) (App (App (DeclConst imp) (App (App (DeclConst imp) (idx 0)) (idx 0))) (idx 0)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (idx 1)) (App (App (DeclConst imp) (idx 1)) (idx 1)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 2)) (App (App (idx 2) (idx 0)) (App (idx 1) (idx 0)))))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 0)) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 1)) (idx 1)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 0)) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 1)) (idx 1)))))))))))

; The same context without the family's decoding rules.  A scoped `type:check`
; computes only with the space's admitted rules, and no admitted rule can name
; the reserved family, so `holds` does not decode there: the package's own term
; is refuted at the package's own type, and so is the imported term, although
; the type itself is formed.
!(let (SetNativeProofV1 $name $prop $proof $term $type $context $rules $assumptions $digest)
      (set:native-proof native-id)
   (type:check (PrimeScoped $context $term) $type))
!(let (SetNativeProofV1 $name $prop $proof $term $type $context $rules $assumptions $digest)
      (set:native-proof native-id)
   (type:check (PrimeScoped $context (Lam (DeclConst prop) (App (App (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (idx 0)) (App (App (DeclConst imp) (App (App (DeclConst imp) (idx 0)) (idx 0))) (idx 0)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (idx 1)) (App (App (DeclConst imp) (idx 1)) (idx 1)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 2)) (App (App (idx 2) (idx 0)) (App (idx 1) (idx 0)))))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 0)) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (idx 1)) (idx 1))) (idx 1)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 0)) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 1)) (idx 1)))))) (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (DeclConst all@prop) (Lam (App (App (DeclConst imp) (idx 0)) (idx 0)))))))
!(let (SetNativeProofV1 $name $prop $proof $term $type $context $rules $assumptions $digest)
      (set:native-proof native-id)
   (type:check (PrimeScoped $context (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (DeclConst all@prop) (Lam (App (App (DeclConst imp) (idx 0)) (idx 0)))))) (Sort (LevelConst 0))))
