   (let (SetNativeProofV1 $name $prop $proof $term $type $context $rules $assumptions $digest)
        $package
     (let (SetNativeNormalFormV1 $checked $consumer $application $normal
                                 $source-type $normal-type)
          (set:native-normalize $package
            (Lam $type
              (App (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (DeclConst all@prop) (Lam (App (App (DeclConst imp) (idx 0)) (idx 0))))) (idx 0))
                (Lam (DeclConst prop) (App (App (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (idx 0)) (App (App (DeclConst imp) (App (App (DeclConst imp) (idx 0)) (idx 0))) (idx 0)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (idx 1)) (App (App (DeclConst imp) (idx 1)) (idx 1)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 2)) (App (App (idx 2) (idx 0)) (App (idx 1) (idx 0)))))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 0)) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (idx 1)) (idx 1))) (idx 1)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 0)) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 1)) (idx 1))))))))
       (ImportedNormalForm $normal (== $normal $term)))))

