; Proofs imported from intuitionistic derivations, replayed on the kernel.
;
; The importer turns a Hilbert derivation into a proof term over the codes
; `prop`, `imp` and `all@prop` and the proof family `__cetta_holds_...`:
; each axiom becomes its combinator, modus ponens becomes application.  Each
; lambda of a combinator carries the domain its typing introduces it at: the
; kernel checks bidirectionally and does not synthesize the type of a lambda
; without a domain, which a combinator applied to another combinator needs.
; Every term below is the importer's spelled output, which reads back as the
; importer's term with those domains; dropping the domains gives the imported
; proof term.
;
; The family's context and decoding rules come from a checked native proof
; package, and the judgment `term : type` reaches the kernel as the body of
; that package's consumer: the ascription `(App (Lam type (idx 0)) term)`.

; The package of the closed theorem `forall p : prop. p -> p`.
!(set:theorem native-id
   (all prop (lam p (imp p p)))
   (pf:all-intro (pf:imp-intro (pf:hyp 0))))

; `lam c. S K K`: the import of the derivation `S K K` of `p -> p`, its atom
; bound, at `holds (all@prop (lam c. imp c c))`.  The kernel accepts it; the
; type of the use is that code decoded.
!(let $package (set:native-proof native-id)
   (let (SetNativeProofV1 $name $prop $proof $term $type $context $rules $assumptions $digest)
        $package
     (let (SetNativeUseV1 $checked $consumer $result $result-type)
          (set:native-use $package
            (Lam $type
              (App (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (DeclConst all@prop) (Lam (App (App (DeclConst imp) (idx 0)) (idx 0))))) (idx 0))
                (Lam (DeclConst prop) (App (App (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (idx 0)) (App (App (DeclConst imp) (App (App (DeclConst imp) (idx 0)) (idx 0))) (idx 0)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (idx 1)) (App (App (DeclConst imp) (idx 1)) (idx 1)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 2)) (App (App (idx 2) (idx 0)) (App (idx 1) (idx 0)))))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 0)) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (App (App (DeclConst imp) (idx 1)) (idx 1))) (idx 1)))) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 0)) (Lam (App (DeclConst __cetta_holds_4af51ee31207779bb184b387) (idx 1)) (idx 1))))))))
       (ImportedUse (== $checked $package) $result-type))))

