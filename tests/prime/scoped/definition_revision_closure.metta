(set:profile hol)

; A published fact is reusable only while everything it was checked against
; is unchanged: the definitions it mentions, and everything those definitions
; mention in turn, with the bodies they had.  A change behind an alias whose
; own equation is unchanged is a change.

; A theorem reaches a definition through two aliases (the review probe).
!(bind! &review (let $profile-space (new-space) (let $_ (add-atom $profile-space (set:profile hol)) $profile-space)))
!(add-atom &review (: A prop))
!(set:define &review leaf prop (= leaf (imp A A)))
!(set:define &review middle prop (= middle leaf))
!(set:define &review root prop (= root middle))
!(set:theorem &review saved root (pf:imp-intro (pf:hyp 0)))
!(match &review (set:known saved $p $o $proof $deps $r $s) (SavedDependencies $deps))
!(match &review (set:known root $p $o $proof $deps $r $s) (RootDependencies $deps))
!(try (set:proves &review (pf:known saved) root))
!(try (set:proves &review (pf:all-elim (pf:known saved) A) A))
!(set:theorem &review direct leaf (pf:imp-intro (pf:hyp 0)))
; Remove one admitted definition and replace it by a different checked body.
!(match &review (set:known leaf $p $o $proof $deps $r $s)
    (remove-atom &review (set:known leaf $p $o $proof $deps $r $s)))
!(match &review (type:rule leaf $n $pats $rhs)
    (remove-atom &review (type:rule leaf $n $pats $rhs)))
!(remove-atom &review (: leaf prop))
!(set:define &review leaf prop (= leaf (all prop (lam p p))))
!(try (set:proves &review (pf:all-elim (pf:known direct) A) A))
; There is no assumption A. The saved proof is no longer usable.
!(try (set:proves &review (pf:known saved) root))
!(try (set:proves &review (pf:all-elim (pf:known saved) A) A))
!(try (set:recheck &review saved))
!(try (set:proves &review (pf:all-elim (pf:known saved) A) A))
!(try (set:recheck &review root))
!(try (set:native-proof &review saved))
!(try (set:proves &review (pf:known saved) (all prop (lam p p))))

; Restoring the body restores reuse: the recorded definitions are current
; again.
!(match &review (set:known leaf $p $o $proof $deps $r $s)
    (remove-atom &review (set:known leaf $p $o $proof $deps $r $s)))
!(match &review (type:rule leaf $n $pats $rhs)
    (remove-atom &review (type:rule leaf $n $pats $rhs)))
!(remove-atom &review (: leaf prop))
!(set:define &review leaf prop (= leaf (imp A A)))
!(try (set:proves &review (pf:known saved) root))
!(try (set:recheck &review root))

; Renewing the aliases over a changed body does not revive a fact checked
; against the old one: the fact records the whole closure it relied on.
!(bind! &renew (let $profile-space (new-space) (let $_ (add-atom $profile-space (set:profile hol)) $profile-space)))
!(add-atom &renew (: A prop))
!(add-atom &renew (: B prop))
!(set:define &renew leaf prop (= leaf (imp A A)))
!(set:define &renew middle prop (= middle leaf))
!(set:define &renew root prop (= root middle))
!(set:theorem &renew saved root (pf:imp-intro (pf:hyp 0)))
!(match &renew (set:known leaf $p $o $proof $deps $r $s)
    (remove-atom &renew (set:known leaf $p $o $proof $deps $r $s)))
!(match &renew (type:rule leaf $n $pats $rhs)
    (remove-atom &renew (type:rule leaf $n $pats $rhs)))
!(remove-atom &renew (: leaf prop))
!(set:define &renew leaf prop (= leaf (imp B B)))
; An alias over the changed body waits for its own renewal.
!(try (set:recheck &renew middle))
!(match &renew (set:known middle $p $o $proof $deps $r $s)
    (remove-atom &renew (set:known middle $p $o $proof $deps $r $s)))
!(match &renew (type:rule middle $n $pats $rhs)
    (remove-atom &renew (type:rule middle $n $pats $rhs)))
!(remove-atom &renew (: middle prop))
!(set:define &renew middle prop (= middle leaf))
!(try (set:recheck &renew middle))
!(try (set:recheck &renew root))
!(match &renew (set:known root $p $o $proof $deps $r $s)
    (remove-atom &renew (set:known root $p $o $proof $deps $r $s)))
!(match &renew (type:rule root $n $pats $rhs)
    (remove-atom &renew (type:rule root $n $pats $rhs)))
!(remove-atom &renew (: root prop))
!(set:define &renew root prop (= root middle))
!(try (set:recheck &renew root))
; Every alias is renewed, yet the fact still names the old body.
!(try (set:proves &renew (pf:known saved) root))
; Published again, the same proof is checked against the new body and reused.
!(match &renew (set:known saved $p $o $proof $deps $r $s)
    (remove-atom &renew (set:known saved $p $o $proof $deps $r $s)))
!(set:theorem &renew saved root (pf:imp-intro (pf:hyp 0)))
!(try (set:proves &renew (pf:known saved) root))
!(match &renew (set:known saved $p $o $proof $deps $r $s) (RenewedDependencies $deps))

; The same with a body under which the old proof would prove any
; proposition: the renewed alias does not revive the fact.
!(bind! &sharp (let $profile-space (new-space) (let $_ (add-atom $profile-space (set:profile hol)) $profile-space)))
!(add-atom &sharp (: A prop))
!(set:define &sharp leaf prop (= leaf (imp A A)))
!(set:define &sharp middle prop (= middle leaf))
!(set:theorem &sharp saved middle (pf:imp-intro (pf:hyp 0)))
!(match &sharp (set:known leaf $p $o $proof $deps $r $s)
    (remove-atom &sharp (set:known leaf $p $o $proof $deps $r $s)))
!(match &sharp (type:rule leaf $n $pats $rhs)
    (remove-atom &sharp (type:rule leaf $n $pats $rhs)))
!(remove-atom &sharp (: leaf prop))
!(set:define &sharp leaf prop (= leaf (all prop (lam p p))))
!(match &sharp (set:known middle $p $o $proof $deps $r $s)
    (remove-atom &sharp (set:known middle $p $o $proof $deps $r $s)))
!(match &sharp (type:rule middle $n $pats $rhs)
    (remove-atom &sharp (type:rule middle $n $pats $rhs)))
!(remove-atom &sharp (: middle prop))
!(set:define &sharp middle prop (= middle leaf))
!(try (set:recheck &sharp middle))
!(try (set:proves &sharp (pf:all-elim (pf:known saved) A) A))
!(try (set:proves &sharp (pf:known saved) (all prop (lam p p))))

; A plain recheck that fails withdraws the fact: restoring the theory does
; not revive it, until it is published again or rechecked with success.
!(bind! &withdraw (let $profile-space (new-space) (let $_ (add-atom $profile-space (set:profile hol)) $profile-space)))
!(add-atom &withdraw (: A prop))
!(add-atom &withdraw (: B prop))
!(set:define &withdraw leaf prop (= leaf (imp A A)))
!(set:theorem &withdraw kept leaf (pf:imp-intro (pf:hyp 0)))
!(match &withdraw (set:known leaf $p $o $proof $deps $r $s)
    (remove-atom &withdraw (set:known leaf $p $o $proof $deps $r $s)))
!(match &withdraw (type:rule leaf $n $pats $rhs)
    (remove-atom &withdraw (type:rule leaf $n $pats $rhs)))
!(remove-atom &withdraw (: leaf prop))
!(set:define &withdraw leaf prop (= leaf (imp B B)))
!(set:recheck &withdraw kept)
!(match &withdraw (set:known leaf $p $o $proof $deps $r $s)
    (remove-atom &withdraw (set:known leaf $p $o $proof $deps $r $s)))
!(match &withdraw (type:rule leaf $n $pats $rhs)
    (remove-atom &withdraw (type:rule leaf $n $pats $rhs)))
!(remove-atom &withdraw (: leaf prop))
!(set:define &withdraw leaf prop (= leaf (imp A A)))
!(try (set:proves &withdraw (pf:known kept) leaf))
!(set:recheck &withdraw kept)
!(try (set:proves &withdraw (pf:known kept) leaf))

; An unrelated definition changes nothing that was relied on.
!(bind! &quiet (let $profile-space (new-space) (let $_ (add-atom $profile-space (set:profile hol)) $profile-space)))
!(add-atom &quiet (: A prop))
!(set:define &quiet leaf prop (= leaf (imp A A)))
!(set:define &quiet root prop (= root leaf))
!(set:theorem &quiet saved root (pf:imp-intro (pf:hyp 0)))
!(set:define &quiet unrelated prop (= unrelated (imp A (imp A A))))
!(try (set:proves &quiet (pf:known saved) root))
