; Both premise evidence and the reconstructed result earn native checking.
!(bind! &thy (new-space))
!(add-atom &thy (: A (u 0)))
!(add-atom &thy (: a A))
!(add-atom &thy (: b A))
!(add-atom &thy (: P (-> (x : A) (u 0))))
!(add-atom &thy (: h (P a)))
!(add-atom &thy (: next (-> (x : A) (e : (P x)) (P x))))
!(add-atom &thy (chaining-rule next))
; A partial plan assembles only when both inputs carry candidate evidence.
(= (proof-plan:assemble (present $major) (present $minor))
   (candidate ($major $minor)))
!(let (he-accept (typed-answer-v2 (: $proof $type) $substitution))
      (search-first-inhabitant &thy (P a) 1)
      (let (candidate $result)
         (proof-plan:assemble (present (next a)) (present $proof))
         (type:check &thy $result (P a))))
!(let (candidate $result)
      (proof-plan:assemble (present (next b)) (present h))
      (type:check &thy $result (P b)))
!(proof-plan:assemble (present (next a)) (open (P a)))
; Higher-order dependent binders retain the selected assumption occurrence.
!(type:check &thy (lam P (lam x (lam older (lam newer older))))
   (-> (P : (-> (x : A) (u 0))) (x : A) (older newer : (P x)) (P x)))
!(type:check &thy (lam P (lam x (lam older (lam newer newer))))
   (-> (P : (-> (x : A) (u 0))) (x : A) (older newer : (P x)) (P x)))
!(type:check &thy (lam P (lam x (lam older (lam newer x))))
   (-> (P : (-> (x : A) (u 0))) (x : A) (older newer : (P x)) (P x)))
; Equal types must not hide an incorrect selected variable.
!(add-atom &thy (: h2 (P a)))
!(set:define &thy selectOlder
   (-> (P : (-> (x : A) (u 0))) (x : A) (older newer : (P x)) (P x))
   (= (selectOlder $P $x $older $newer) $older))
!(set:define &thy selectNewer
   (-> (P : (-> (x : A) (u 0))) (x : A) (older newer : (P x)) (P x))
   (= (selectNewer $P $x $older $newer) $newer))
!(type:eq &thy (selectOlder P a h h2) h)
!(type:eq &thy (selectOlder P a h h2) h2)
!(type:eq &thy (selectNewer P a h h2) h)
!(type:eq &thy (selectNewer P a h h2) h2)
; The same closed proof obligation has different slots in the two binder orders.
!(type:check &thy (lam x (lam proof proof))
   (-> (x : A) (proof : (P a)) (P a)))
!(type:check &thy (lam proof (lam x proof))
   (-> (proof : (P a)) (x : A) (P a)))
!(type:check &thy (lam x (lam proof x))
   (-> (x : A) (proof : (P a)) (P a)))
!(type:check &thy (lam proof (lam x x))
   (-> (proof : (P a)) (x : A) (P a)))
; Compilation preserves both the proof occurrence and the application order.
!(set:define &thy objectThenProof
   (-> (x : A) (proof : (P a)) (P a))
   (= (objectThenProof $x $proof) $proof))
!(set:define &thy proofThenObject
   (-> (proof : (P a)) (x : A) (P a))
   (= (proofThenObject $proof $x) $proof))
!(type:eq &thy (objectThenProof a h) h)
!(type:eq &thy (objectThenProof a h) h2)
!(type:eq &thy (proofThenObject h a) h)
!(type:eq &thy (proofThenObject h a) h2)
!(type:eq &thy (objectThenProof b h) h)
!(type:eq &thy (proofThenObject h b) h)
!(type:check &thy (objectThenProof h a) (P a))
!(type:check &thy (proofThenObject a h) (P a))
