; Matching helpers run their continuation after the pattern binds, once per
; occurrence. Pattern and matched data retain their inert role.
!(import! &self durable:activity)
!(import! &self durable:telegram)
!(bind! &template-effects (new-space))
(= (template:tick $x) (let $_ (add-atom &template-effects ran) $x))
!(add-atom &self (template:sample 3))
!(add-atom &self (template:sample 3))
!(activity:match (template:sample $x) (+ $x 1))
!(tg-host:match (template:sample $x) (+ $x 1))
!(collapse (activity:match (template:missing $x) (template:tick $x)))
!(collapse (tg-host:match (template:missing $x) (template:tick $x)))
!(collapse (get-atoms &template-effects))
!(activity:match (template:sample $x) (template:tick $x))
!(collapse (get-atoms &template-effects))
!(tg-host:match (template:sample $x) (template:tick $x))
!(collapse (get-atoms &template-effects))
!(add-atom &self (template:datum (template:tick 99)))
!(activity:match (template:datum $value) $value)
!(tg-host:match (template:datum $value) $value)
!(collapse (get-atoms &template-effects))
!(activity:match (template:sample $x)
   (tg-host:match (template:sample $y) (Pair $x $y)))
