; Structural inspection of held values preserves their data role, multiplicity
; and binder identity. Explicit eval remains an activation boundary.
(: nested:hold (-> Atom Atom))
(= (nested:hold $x) $x)
!(bind! &nested-effects (new-space))
(= (nested:effect) (let $_ (add-atom &nested-effects ran) 9))
!(case (collapse (nested:hold (record ready)))
   ((((record $state)) $state) ($other mismatch)))
!(let ((record $state)) (collapse (nested:hold (record ready))) $state)
!(let $rows (collapse (nested:hold (record ready)))
   (unify $rows ((record $state)) $state mismatch))
!(case (collapse (nested:hold (record (nested:effect))))
   ((((record $value)) $value) ($other mismatch)))
!(let ((record $value)) (collapse (nested:hold (record (nested:effect)))) $value)
!(let $rows (collapse (nested:hold (record (nested:effect))))
   (unify $rows ((record $value)) $value mismatch))
!(collapse (get-atoms &nested-effects))
(: nested:open (-> Atom Atom Atom))
(= (nested:open (lam $key $body) $value) (lift let $key $value $body))
!(nested:open (lam y (g y y)) (+ 1 2))
!(nested:open (lam y (g y y)) (nested:effect))
!(collapse (get-atoms &nested-effects))
!(case (collapse (nested:hold (record (nested:effect))))
   ((((record $value)) (eval $value)) ($other mismatch)))
!(collapse (get-atoms &nested-effects))
!(case (collapse (nested:hold (pair a a)))
   ((((pair $x $x)) same) ($other different)))
!(case (collapse (nested:hold (pair a b)))
   ((((pair $x $x)) same) ($other different)))
!(case (collapse (nested:hold (record ready)))
   ((((other $x)) wrong) ($whole kept)))
!(let $items (nested:hold ((record a) (record a)))
   (let $rows (collapse (superpose $items))
     (case $rows ((((record $x) (record $y)) ($x $y)) ($other mismatch)))))
!(collapse (get-atoms &nested-effects))
!(case (@(lam x (f x)))
   ((((quote (lam $a $b))) (Got $a $b (*$b 9))) ($other no-match)))
!(case (collapse (nested:hold @(lam x (f x))))
   ((((quote (lam $a $b))) (Got $a $b (*$b 9))) ($other no-match)))
!(case (@(lam x (f x)))
   ((((quote (lam $a (f x)))) wrong) ($other right)))
!(case (collapse (nested:hold @(lam x (f x))))
   ((((quote (lam $a (f x)))) wrong) ($other right)))
