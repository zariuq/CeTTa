; Shared weak-head decision program: generated discrimination must preserve
; source order, exact matching, and Prime demand semantics.

(= (decision:test K0 $n) (- $n 1))
(= (decision:test K1 $n) (- $n 1))
(= (decision:test K2 $n) (- $n 1))
(= (decision:test K3 $n) (- $n 1))
(= (decision:test K4 $n) (- $n 1))
