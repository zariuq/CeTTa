(= (decision:test K17 $n) (- $n 1))
(= (decision:test K18 $n) (- $n 1))
(= (decision:test K19 $n) (- $n 1))
(= (decision:test K20 $n) (- $n 1))
(= (decision:test K21 $n) (- $n 1))
(= (decision:test K22 $n) (- $n 1))
(= (decision:test K23 $n) (- $n 1))
(= (decision:test K24 $n) (- $n 1))
(= (decision:test K25 $n) (- $n 1))
(= (decision:test K26 $n) (- $n 1))
(= (decision:test K27 $n) (- $n 1))
(= (decision:test K28 $n) (- $n 1))
(= (decision:test K29 $n) (- $n 1))
(= (decision:test K30 $n) (- $n 1))
(= (decision:test K31 $n) (- $n 1))
(= (decision:test K32 $n) (- $n 1))
(= (decision:test K33 $n) (- $n 1))
(= (decision:test K34 $n) (- $n 1))
(= (decision:test K35 $n) (- $n 1))
(= (decision:test K36 $n) (- $n 1))
(= (decision:test K37 $n) (- $n 1))
(= (decision:test K38 $n) (- $n 1))
(= (decision:test K39 $n) (- $n 1))
(= (decision:test K40 $n) (- $n 1))
(= (decision:test K41 $n) (- $n 1))
(= (decision:test K42 $n) (- $n 1))
(= (decision:test K43 $n) (- $n 1))
(= (decision:test K44 $n) (- $n 1))
(= (decision:test K45 $n) (- $n 1))
(= (decision:test K46 $n) (- $n 1))
(= (decision:test K47 $n) (- $n 1))
(= (decision:test K48 $n) (- $n 1))
(= (decision:test K49 $n) (- $n 1))
(= (decision:test K50 $n) (- $n 1))
(= (decision:test K51 $n) (- $n 1))
(= (decision:test K52 $n) (- $n 1))
(= (decision:test K53 $n) (- $n 1))
(= (decision:test K54 $n) (- $n 1))
(= (decision:test K55 $n) (- $n 1))
(= (decision:test K56 $n) (- $n 1))
(= (decision:test K57 $n) (- $n 1))
(= (decision:test K58 $n) (- $n 1))
(= (decision:test K59 $n) (- $n 1))
(= (decision:test K60 $n) (- $n 1))
(= (decision:test K61 $n) (- $n 1))
(= (decision:test K62 $n) (- $n 1))
(= (decision:test K63 $n) (- $n 1))

(= (decision:loop $n)
   (if (== $n 0)
       done
       (decision:loop (decision:test K63 $n))))
!(decision:loop 10000)

; No single position separates this matrix; the conjunction does.
(= (decision:joint A X) ax)
(= (decision:joint A Y) ay)
(= (decision:joint B X) bx)
(= (decision:joint B Y) by)
!(decision:joint A X)
!(decision:joint A Y)
!(decision:joint B X)
!(decision:joint B Y)

; Exact expression-head/arity discrimination.
(= (decision:shape (Box $x)) (boxed $x))
(= (decision:shape (Pair $x $y)) (paired $x $y))
!(decision:shape (Box A))
!(decision:shape (Pair A B))

; A callable discriminator must first follow canonical Prime demand.  The
; decision program may prune only after the argument has become observable.
!(decision:test (if True K63 K0) 1)
