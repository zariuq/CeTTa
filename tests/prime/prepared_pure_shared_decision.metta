(= (decision:test K9 $n) (- $n 1))
(= (decision:test K10 $n) (- $n 1))
(= (decision:test K11 $n) (- $n 1))
(= (decision:test K12 $n) (- $n 1))
(= (decision:test K13 $n) (- $n 1))
(= (decision:test K14 $n) (- $n 1))
