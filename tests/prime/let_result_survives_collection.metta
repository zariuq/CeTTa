; A function body binds the answer of a call whose evaluation collects the
; evaluator's heap: `(let $p (gc:found) (Got $p))`.  While the answer is
; computed, held arguments name the space, so the Need path mixes lifetimes
; (a space handle outlives the collected heap).  The collection must keep the
; pending let and give its answer; with collection off the answer is the same.

(gc:edge n0 n1)
(gc:edge n0 n2)
(gc:edge n0 n3)
(gc:edge n1 n2)
(gc:edge n1 n3)
(gc:edge n1 n4)
(gc:edge n2 n3)
(gc:edge n2 n4)
(gc:edge n2 n5)
(gc:edge n3 n4)
(gc:edge n3 n5)
(gc:edge n3 n6)
(gc:edge n4 n5)
(gc:edge n4 n6)
(gc:edge n4 n7)
(gc:edge n5 n6)
(gc:edge n5 n7)
(gc:edge n5 n8)
(gc:edge n6 n7)
(gc:edge n6 n8)
(gc:edge n6 n9)
(gc:edge n7 n8)
(gc:edge n7 n9)
(gc:edge n7 n10)
(gc:edge n8 n9)
(gc:edge n8 n10)
(gc:edge n8 n11)
(gc:edge n9 n10)
(gc:edge n9 n11)
(gc:edge n9 n0)
(gc:edge n10 n11)
(gc:edge n10 n0)
(gc:edge n10 n1)
(gc:edge n11 n0)
(gc:edge n11 n1)
(gc:edge n11 n2)

(= (gc:outputs $kb $x) (collapse (match $kb (gc:edge $x $y) $y)))
(= (gc:member $needle ()) False)
(= (gc:member $needle $items)
   (let ($head $tail) (decons-atom $items)
     (if (== $needle $head) True (gc:member $needle $tail))))
; The second argument is held: its thunk names the space until it is read.
(= (gc:covered $kb (gc:ex $x $y)) (gc:member $y (gc:outputs $kb $x)))
(= (gc:all $kb ()) True)
(= (gc:all $kb $examples)
   (let ($example $rest) (decons-atom $examples)
     (and (gc:covered $kb $example) (gc:all $kb $rest))))
(= (gc:examples)
   ((gc:ex n0 n3) (gc:ex n1 n4) (gc:ex n2 n5) (gc:ex n3 n6) (gc:ex n4 n7) (gc:ex n5 n8) (gc:ex n6 n9) (gc:ex n7 n10) (gc:ex n8 n11) (gc:ex n9 n0) (gc:ex n10 n1) (gc:ex n11 n2) (gc:ex n0 n3) (gc:ex n1 n4) (gc:ex n2 n5) (gc:ex n3 n6)))
(= (gc:found) (if (gc:all &self (gc:examples)) found (superpose ())))

(= (gc:bound) (let $p (gc:found) (Got $p)))
!(gc:bound)
!(collapse (gc:bound))
!(let $p (gc:found) (Got $p))
