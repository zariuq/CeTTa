; Iteration reads held collection elements as data. Explicit eval activates
; an element; each selected code occurrence is a separate execution.
(: seq:hold (-> Atom Atom))
(= (seq:hold $x) $x)
!(let $items (seq:hold (c a b)) (superpose $items))
!(let $items (seq:hold ((+ 1 2) (+ 3 4)))
   (map-atom $items $x (w $x)))
!(let $items (seq:hold (c a b))
   (foldl-atom $items 0 $n $x (+ $n 1)))
!(let $items (seq:hold (1 2 3))
   (filter-atom $items $x (> $x 1)))
!(let $items (seq:hold ()) (collapse (superpose $items)))
!(bind! &sequence-effects (new-space))
(= (seq:effect) (let $_ (add-atom &sequence-effects ran) 9))
!(let $items (seq:hold ((seq:effect) (+ 1 2)))
   (collapse (superpose $items)))
!(assertEqual (collapse (get-atoms &sequence-effects)) ())
!(let $items (seq:hold ((seq:effect) (seq:effect)))
   (let $code (superpose $items) (eval $code)))
!(assertEqual (collapse (get-atoms &sequence-effects)) (ran ran))
!(superpose ((seq:effect) (seq:effect)))
!(assertEqual (size-atom (collapse (get-atoms &sequence-effects))) 4)
!(let $items (seq:hold (c a b a))
   (sort-atom (collapse (hyperpose $items))))
(= seq:defined (seq:effect))
!(let $items (seq:hold (seq:defined a)) (superpose $items))
!(assertEqual (size-atom (collapse (get-atoms &sequence-effects))) 4)
!(let $items (seq:hold ((Error (seq:effect) reason)))
   (map-atom $items $x (Box $x)))
!(assertEqual (size-atom (collapse (get-atoms &sequence-effects))) 4)
; An immutable original keeps its iteration semantics after a local edit.
(= (superpose $items) local-choices)
!(let $items (seq:hold ((+ 5 6)))
   (std:superpose $items))
