!(import! &self math_space_store)
!(bind! &p (math:new "schema"))
!(math:goal &p "g" type (quote (u 0)) "An open goal.")
(= (schema:research $bundle $rows)
   (case $bundle
     (((Math:Bundle 1 $name $sources $publications $research $history $theory)
        (let $artifact (math:encode-artifact $rows)
          (Math:Bundle 1 $name $sources $publications $artifact $history $theory))))))
(= (schema:sources $bundle $text)
   (case $bundle
     (((Math:Bundle 1 $name $sources $publications $research $history $theory)
        (let* (($digest (str:sha256 $text)) ($artifact (Math:Artifact $digest $text)))
          (Math:Bundle 1 $name $artifact $publications $research $history $theory))))))
!(assertEqual
   (case (math:restore (math:serialize &p) 10000)
     (((Math:Restored $restored) Restored) ($other Wrong))) Restored)
!(let* (($rows (math:research &p)) ($duplicate (cons-atom (car-atom $rows) $rows))
        ($bundle (schema:research (math:bundle &p) $duplicate)))
   (assertEqual (math:restore (math:pack-bundle $bundle) 10000)
     (Math:RestoreFailed snapshot-records)))
!(let* (($rows ((Math:Candidate "c" "missing-goal" "proposal" arbitrary-key (quote proof))))
        ($bundle (schema:research (math:bundle &p) $rows)))
   (assertEqual (math:restore (math:pack-bundle $bundle) 10000)
     (Math:RestoreFailed snapshot-records)))
!(assertEqual (math:restore (math:serialize &p) -1) (Math:RestoreFailed snapshot-records))
!(let* (($object (json:parse (math:serialize &p))) ((JsonObject $pairs) $object)
        ($extra (union-atom $pairs ((JsonPair "authority" "verified")))))
   (assertEqual (math:restore-object (JsonObject $extra) 10000)
     (Math:RestoreFailed snapshot-schema)))
; Parsed code in an artifact stays data, including at the list's outer level.
!(let $bundle (schema:sources (math:bundle &p) "(system:write stdout \"UNEXPECTED-EFFECT\")")
   (assertEqual (math:restore (math:pack-bundle $bundle) 10000)
     (Math:RestoreFailed snapshot-records)))
!(let* (($bad (parse "((system:write stdout \"UNEXPECTED-EFFECT\"))"))
        ($bundle (schema:research (math:bundle &p) $bad)))
   (assertEqual (math:restore (math:pack-bundle $bundle) 10000)
     (Math:RestoreFailed snapshot-records)))
!(let $bundle (schema:sources (math:bundle &p) "((hol:define raw (u 0) (= raw (u 0))))")
   (assertEqual (math:restore (math:pack-bundle $bundle) 10000)
     (Math:RestoreFailed snapshot-records)))
