; Native declarations carry formed types and explicit dependent parameters.
; HE's multiply annotated constants remain covered by the HE lane; the native
; analogue exposes the parameter in the proof instead of silently overloading it.
!(import! &self search_observation.metta)
(: A (u 0))
(: B (u 0))
(: C (u 0))
(: D (u 0))
(: E (u 0))
(: F (u 0))
(: Seed (u 0))
(: FairGoal (u 0))
(: Tag (u 0))
(: a1 A)
(: a2 A)
(: b1 B)
(: MakeC (-> A B C))
(chaining-rule MakeC)
!(native-search:observe &self (search-inhabitants &self C 1 200000 1))
!(native-search:observe &self (search-inhabitants &self C 1 200000 2))
!(native-search:observe &self (search-inhabitants &self C 1 200000 3))
(: d1 D)
(: d2 D)
(: e1 E)
(: e2 E)
(: MakeF (-> D E F))
(chaining-rule MakeF)
!(native-search:observe &self (search-inhabitants &self F 1 300000 8))
(: Left Tag)
(: Right Tag)
(: Choice (-> Tag (u 0)))
(: shared-choice (-> (tag : Tag) (Choice tag)))
(chaining-rule shared-choice)
!(native-search:observe &self (search-inhabitants &self (Choice $which) 1 100000 4))
(: seed Seed)
(: LoopGoal (-> FairGoal FairGoal))
(chaining-rule LoopGoal)
(: DirectGoal (-> Seed FairGoal))
(chaining-rule DirectGoal)
!(let (he-accept (typed-answer-v2 (: $proof $type) $substitution))
      (search-first-inhabitant &self FairGoal 5 100000)
      (Checked $proof $type (type:check &self $proof $type)))
; The sixty-fifth independent declaration must remain searchable. Native
; constants have one declared type; these are distinct hypotheses.
