; Atom parameters preserve syntax. Proc parameters denote computations;
; the existing Need discipline shares a demanded argument's evaluation.
(: roles:hold (-> Atom Atom))
(= (roles:hold $x) $x)
(: roles:compute (-> Proc Proc))
(= (roles:compute $x) $x)
(: roles:twice (-> Proc Proc))
(= (roles:twice $x) (+ $x $x))
(: roles:number (-> Number Number))
(= (roles:number $x) (+ $x 1))
(: roles:project (-> Atom Atom))
(= (roles:project $x) (car-atom $x))
(: roles:run (-> Atom Proc))
(= (roles:run $x) (eval $x))
(= (roles:undeclared $x) (+ $x $x))

!(roles:hold (+ 1 2))
!(roles:compute (+ 1 2))
!(roles:hold (println! "ATOM-MUST-NOT-RUN"))
!(roles:compute (println! "PROC-RUNS"))
!(roles:twice (let $_ (println! "PROC-ONCE") 3))
!(roles:number (+ 2 3))
!(roles:project (a b))
!(roles:run (println! "EXPLICIT-RUN"))
!(roles:undeclared (let $_ (println! "UNDECLARED-ONCE") 4))

; Declarations are live program data: replacement changes argument demand.
(: roles:changing (-> Atom Proc))
(= (roles:changing $x) $x)
!(roles:changing (+ 4 5))

; Type inspection reads data. An explicitly earned value has its value type.
!(get-type 2)
!(bind! &roles:classified-effects (new-space))
(= (roles:classification-effect)
   (let $_ (add-atom &roles:classified-effects ran) 17))
!(let $types (collapse (get-type (roles:classification-effect)))
   (assertEqual (collapse (get-atoms &roles:classified-effects)) ()))
!(let $value (roles:classification-effect) (get-type $value))
!(assertEqual (collapse (get-atoms &roles:classified-effects)) (ran))

; Explicit interpreters open data at their execution boundary. Passing the
; same syntax to an ordinary Proc parameter still treats it as a value.
(: roles:chain (-> Atom Proc))
(= (roles:chain $code)
   (function (chain $code $value (return $value))))
(: roles:interpret (-> Atom Proc))
(= (roles:interpret $code) (metta $code %Undefined% &self))
(: roles:in-space (-> Atom SpaceType Proc))
(= (roles:in-space $code $space) (evalc $code $space))
!(roles:chain (+ 3 4))
!(roles:interpret (+ 3 5))
!(roles:in-space (+ 4 5) &self)
!(roles:compute (roles:hold (+ 7 8)))
(= roles:defined-name 17)
!(roles:compute (roles:hold roles:defined-name))
(: roles:unused (-> Proc Proc))
(= (roles:unused $x) ignored)
!(roles:unused (println! "UNUSED-PROC-MUST-NOT-RUN"))
!(let $code (roles:hold (quote (note data))) (repr $code))
!(remove-atom &self (: roles:changing (-> Atom Proc)))
!(add-atom &self (: roles:changing (-> Proc Proc)))
!(roles:changing (+ 4 5))
