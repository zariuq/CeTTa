; A raw record is neither an external certificate nor a constructed
; datatype. Explicit assumption adoption remains available and visible.
!(let $digest (set:signature-digest)
    (add-atom &self (set:known invented Falsum external-verified () () 0 $digest)))
!(car-atom (try (set:recheck invented)))
!(set:recheck invented)
!(car-atom (try (set:proves (pf:known invented) Falsum)))
!(let $digest (set:signature-digest)
    (add-atom &self (set:known forged-datatype Falsum inductive () () 0 $digest)))
!(car-atom (try (set:recheck forged-datatype)))
!(set:recheck forged-datatype)
!(car-atom (try (set:proves (pf:known forged-datatype) Falsum)))
!(let $digest (set:signature-digest)
    (add-atom &self (set:known forged-signature Falsum signature () () 0 $digest)))
!(car-atom (try (set:recheck forged-signature)))
!(car-atom (try (set:proves (pf:known forged-signature) Falsum)))
!(let $digest (set:signature-digest)
    (add-atom &self (set:known forged-definition Falsum definition () () 0 $digest)))
!(car-atom (try (set:recheck forged-definition)))
!(car-atom (try (set:proves (pf:known forged-definition) Falsum)))

; A knowingly adopted premise has the assumption origin, not theorem or
; model provenance. This control deliberately adds Falsum locally.
!(let $digest (set:signature-digest)
    (add-atom &self (set:known explicit-premise Falsum axiom () () 0 $digest)))
!(car-atom (try (set:recheck explicit-premise)))
!(set:recheck explicit-premise)
!(set:proves (pf:known explicit-premise) Falsum)
!(let (SetFoundationManifest (profile $profile) (signature-digest $digest)
        (checker $checker) (identity-policy $identity)
        (identity-region-assumptions $regions) (typed-declarations $declarations)
        (admitted-type-rules $type_rules) (profile-source $source)
        (adopted-rules $rules) (interpretations $interpretations)
        (admitted-assumptions $assumptions) (admitted-definitions $definitions) (admitted-constructions $constructions))
        (set:signature manifest)
    (AssumptionNames (map-atom $assumptions $entry (index-atom $entry 1))))
