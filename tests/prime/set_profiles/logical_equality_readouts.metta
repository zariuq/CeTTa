(set:profile hol)
!(car-atom (try (set:proves (pf:all-intro (pf:eq-refl prop (pf:var 0))) (all prop (lam p (eq prop p p))))))
!(add-atom &self (set:rule eq-subst))
!(car-atom (try (set:proves (pf:all-intro (pf:eq-refl prop (pf:var 0))) (all prop (lam p (eq prop p p))))))
!(remove-atom &self (set:rule eq-subst))
!(add-atom &self (set:rule hol-equality))
!(set:theorem logical-refl (all prop (lam p (eq prop p p))) (pf:all-intro (pf:eq-refl prop (pf:var 0))))
!(car-atom (try (set:native-proof logical-refl)))
!(car-atom (try (set:native-proof logical-refl rule-constants)))
!(set:theorem logical-beta (all prop (lam p (eq prop ((lam x x) p) p))) (pf:all-intro (pf:beta prop prop (pf:var 0) (lam x x))))
!(car-atom (try (set:native-proof logical-beta)))
!(car-atom (try (set:native-proof logical-beta rule-constants)))
!(set:theorem logical-symm (all prop (lam p (all prop (lam q (imp (eq prop p q) (eq prop q p)))))) (pf:all-intro (pf:all-intro (pf:imp-intro (pf:eq-symm (pf:hyp 0))))))
!(car-atom (try (set:native-proof logical-symm)))
!(car-atom (try (set:native-proof logical-symm rule-constants)))
!(set:theorem logical-trans (all prop (lam p (all prop (lam q (all prop (lam r (imp (eq prop p q) (imp (eq prop q r) (eq prop p r))))))))) (pf:all-intro (pf:all-intro (pf:all-intro (pf:imp-intro (pf:imp-intro (pf:eq-trans (pf:hyp 1) (pf:hyp 0))))))))
!(car-atom (try (set:native-proof logical-trans)))
!(car-atom (try (set:native-proof logical-trans rule-constants)))
!(set:theorem logical-prop (all prop (lam p (all prop (lam q (imp (eq prop p q) (imp p q)))))) (pf:all-intro (pf:all-intro (pf:imp-intro (pf:eq-prop-elim (pf:hyp 0))))))
!(car-atom (try (set:native-proof logical-prop)))
!(car-atom (try (set:native-proof logical-prop rule-constants)))
!(set:theorem logical-app (all (-> prop prop) (lam f (all (-> prop prop) (lam g (all prop (lam p (imp (eq (-> prop prop) f g) (eq prop (f p) (g p))))))))) (pf:all-intro (pf:all-intro (pf:all-intro (pf:imp-intro (pf:eq-app prop prop (pf:hyp 0) (pf:var 0)))))))
!(car-atom (try (set:native-proof logical-app)))
!(car-atom (try (set:native-proof logical-app rule-constants)))
!(set:theorem logical-arg (all (-> prop prop) (lam f (all prop (lam p (all prop (lam q (imp (eq prop p q) (eq prop (f p) (f q))))))))) (pf:all-intro (pf:all-intro (pf:all-intro (pf:imp-intro (pf:eq-app-arg prop prop (pf:var 2) (pf:hyp 0)))))))
!(car-atom (try (set:native-proof logical-arg)))
!(car-atom (try (set:native-proof logical-arg rule-constants)))
!(set:theorem logical-set-refl (all set (lam x (eq set x x))) (pf:all-intro (pf:eq-refl set (pf:var 0))))
!(car-atom (try (set:native-proof logical-set-refl)))
!(car-atom (try (set:native-proof logical-set-refl rule-constants)))
!(car-atom (try (set:proves (pf:all-intro (pf:all-intro (pf:eq-refl prop (pf:var 0)))) (all prop (lam p (all prop (lam q (eq prop p q))))))))
!(car-atom (try (set:proves (pf:eq-refl prop) (all prop (lam p p)))))
!(car-atom (try (set:proves (pf:all-intro (pf:beta prop set (pf:var 0) (lam x x))) (all prop (lam p (eq set p p))))))
!(car-atom (try (set:proves (pf:all-intro (pf:all-intro (pf:all-intro (pf:imp-intro (pf:imp-intro (pf:eq-trans (pf:hyp 1) (pf:hyp 0))))))) (all prop (lam p (all prop (lam q (all prop (lam r (imp (eq prop p q) (imp (eq prop p r) (eq prop q r))))))))))))
!(remove-atom &self (set:rule hol-equality))
!(car-atom (try (set:proves (pf:known logical-refl) (all prop (lam p (eq prop p p))))))
!(car-atom (try (set:native-proof logical-refl)))
!(car-atom (try (set:proves (pf:known logical-beta) (all prop (lam p (eq prop ((lam x x) p) p))))))
!(car-atom (try (set:native-proof logical-beta)))
!(car-atom (try (set:proves (pf:known logical-symm) (all prop (lam p (all prop (lam q (imp (eq prop p q) (eq prop q p)))))))))
!(car-atom (try (set:native-proof logical-symm)))
!(car-atom (try (set:proves (pf:known logical-trans) (all prop (lam p (all prop (lam q (all prop (lam r (imp (eq prop p q) (imp (eq prop q r) (eq prop p r))))))))))))
!(car-atom (try (set:native-proof logical-trans)))
!(car-atom (try (set:proves (pf:known logical-prop) (all prop (lam p (all prop (lam q (imp (eq prop p q) (imp p q)))))))))
!(car-atom (try (set:native-proof logical-prop)))
!(car-atom (try (set:proves (pf:known logical-app) (all (-> prop prop) (lam f (all (-> prop prop) (lam g (all prop (lam p (imp (eq (-> prop prop) f g) (eq prop (f p) (g p))))))))))))
!(car-atom (try (set:native-proof logical-app)))
!(car-atom (try (set:proves (pf:known logical-arg) (all (-> prop prop) (lam f (all prop (lam p (all prop (lam q (imp (eq prop p q) (eq prop (f p) (f q))))))))))))
!(car-atom (try (set:native-proof logical-arg)))
!(car-atom (try (set:proves (pf:known logical-set-refl) (all set (lam x (eq set x x))))))
!(car-atom (try (set:native-proof logical-set-refl)))
