(set:profile hol)
!(add-atom &self (set:rule hol-equality))
!(set:define ReviewAlias (u 0) (= ReviewAlias prop))
!(set:define FunAlias (u 0) (= FunAlias (-> prop prop)))
!(car-atom (try (set:proves (pf:fix f (pf:eq-refl FunAlias f)) (all FunAlias (lam f (eq FunAlias f f))))))
!(car-atom (try (set:check (lam (x : FunAlias) x) (-> FunAlias FunAlias))))
!(car-atom (try (set:proves (pf:fix p (pf:eq-refl FunAlias p)) (all prop (lam p (eq prop p p))))))
!(car-atom (try (set:proves (pf:fix p (pf:eq-refl ReviewAlias p)) (all prop (lam p (eq (-> prop prop) p p))))))
!(car-atom (try (set:check (lam (x : FunAlias) x) (-> prop prop))))
!(car-atom (try (set:proves (pf:fix p (pf:eq-refl ReviewAlias p)) (all FunAlias (lam p (eq ReviewAlias p p))))))
