; Lexical pattern slots belong to each binding activation, including code
; formed at run time. The source remains outside; crossing names stay shared.
(scope:profile lexical-fresh)
(= (twice $f) (Pair ($f 1) ($f 2)))
(entry 1 a)
(entry 2 b)
!(tag written (twice (lam z (let $y z (g $y)))))
!(tag cons (twice (cons-atom lam (z (let $y z (g $y))))))
!(tag union (twice (union-atom (lam z) ((let $y z (g $y))))))
!(tag lifted (let $c (lift app @lam @z @(let $y z (g $y))) (twice *$c)))
!(tag head (let $h lam (twice ($h z (let $y z (g $y))))))
!(tag beta ((lam h (twice (h z (let $y z (g $y))))) lam))
!(tag case (twice (cons-atom lam (z (case z (($y (g $y))))))))
!(tag match (twice (cons-atom lam (z (match &self (entry z $y) (g $y))))))
!(tag outer-source (let $y 7 (let $y $y $y)))
!(tag explicit-new (twice (cons-atom lam (z (new ($y) (let $y z (g $y)))))))
!(tag shared-refusal (collapse (let $f (cons-atom lam (z (let $y z (g $y)){$y})) (Pair ($f 1) ($f 2)))))
!(tag same-name-outside (let $y 99 (twice (cons-atom lam (z (let $y z (g $y)))))))
!(tag repeated-pattern-refusal (collapse (let (Pair $x $x) (Pair 1 2) wrong)))
!(tag shadow (let $x 1 (Pair (let $x 2 $x) $x)))
!(tag rhs-outside (let $x 1 (Pair (let $x $x $x) $x)))
!(tag many-source (let $x (superpose (1 2)) (Pair $x $x)))
!(tag named-form (quote (let $x 1 $x)))
