; case inside called functions.
(= (walk $n) (case $n ((0 done) ($k (walk (- $k 1))))))
!(walk 5)
(= (kind $x) (case $x ((0 zero) (1 one) ($_ many))))
!(kind 0)
!(kind 1)
!(kind 7)
(= (none) (empty))
(= (on-empty) (case (none) ((Empty nothing) ($v (got $v)))))
!(on-empty)
(= (no-branch $x) (case $x ((0 zero))))
!(no-branch 3)
(= (two) (superpose (1 2)))
(= (each) (case (two) ((1 a) (2 b))))
!(let $answers (collapse (each)) (sort-atom $answers))
(= (err) (Error x bad))
(= (on-error) (case (err) (((Error $a $b) caught) ($v other))))
!(on-error)
(= (pairs $p) (case $p (((a $y) (left $y)) (($x b) (right $x)))))
!(pairs (a b))
!(pairs (c b))
; Numbers in branch patterns compare by value, as in HE.
(= (num-case $x) (case $x ((1 int-one) (2.5 two-half) ($y (other $y)))))
!(num-case 1)
!(num-case 1.0)
!(num-case 2.5)
!(num-case 3)
(= (half) 0.5)
(= (num-scrut) (case (* (half) 2) ((1 by-value) ($y (other $y)))))
!(num-scrut)
