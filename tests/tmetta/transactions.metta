!(bind! &tokens (new-space))
!(add-atom &tokens (token 1))
!(add-atom &tokens (token 1))
!(count (transform &tokens (, (take (token $x)) (take (token $y))) (, (made $x) (made $y))))
!(count (collapse (match &tokens (token $x) $x)))
!(count (collapse (match &tokens (made $x) $x)))
!(count (transform &tokens (, (take (made 1)) (absent (made 1))) forbidden))
!(count (collapse (match &tokens (made 1) ok)))
!(count (transform &tokens (, (take (made 1)) (let True (> 1 2))) forbidden))
!(count (collapse (match &tokens (made 1) ok)))
!(count (transform &tokens (, (take (made 1)) (let True (> 2 1))) done))
!(count (collapse (match &tokens done ok)))
!(bind! &other (new-space))
!(add-atom &other ticket)
!(count (transform &tokens (, (take (made 1)) (take &other ticket)) (, combined combined)))
!(count (collapse (match &other ticket ok)))
!(count (collapse (match &tokens combined ok)))
!(count (collapse (add-atom &tokens forbidden)))
