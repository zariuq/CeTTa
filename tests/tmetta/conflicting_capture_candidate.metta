!(bind! &stock (new-space))
!(bind! &done (new-space))
!(add-atom &stock (permit bad))
!(add-atom &stock (permit good))
!(let $_ (add-atom &stock (capture ($v) (pair bad $v blue)))
   (add-atom &stock (capture ($v) (pair bad red $v))))
!(add-atom &stock (pair good red blue))
!(count (transform &stock (, (take (permit $case)) (all (pair $case red blue))) (used $case) &done))
!(count (reify (match &stock (permit bad) kept)))
!(count (reify (match &stock (permit good) kept)))
!(match &done (used $case) $case)
