!(import! &self stored_row_import)
(signal key duplicate)
!(bind! &dest (new-space))
!(add-atom &self (capture ($c) (captured local $c)))
!(count (reify (match &self (signal key duplicate) yes)))
!(count (reify (match &self (signal key imported) yes)))
!(count (transform &self (read (signal key imported)) copied &dest))
!(count (transform &self (read (captured local confirmed)) told &dest))
!(count (reify (match &self (captured local other) possible)))
!(match &self (captured local $v) $v)
!(count (reify (match &dest copied yes)))
