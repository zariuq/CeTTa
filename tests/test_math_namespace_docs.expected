[(@doc-formal (@item math:exp) (@kind function) (@type (-> Number Number)) (@desc "Exponential function in the math: namespace, implemented as e raised to the given power.") (@params ((@param (@type Number) (@desc "Exponent")))) (@return (@type Number) (@desc "e raised to the given power")))]
[(@doc-formal (@item math:min) (@kind function) (@type (-> Number Number Number)) (@desc "Binary numeric minimum in the math: namespace. This is a library-level helper rather than a new core builtin.") (@params ((@param (@type Number) (@desc "First number")) (@param (@type Number) (@desc "Second number")))) (@return (@type Number) (@desc "Smaller of the two numbers")))]
[(@doc-formal (@item math:clamp) (@kind function) (@type (-> Number Number Number Number)) (@desc "Currying-friendly clamp helper with the bounds first and the input value last. (math:clamp lo hi x) is (math:max lo (math:min x hi)): the input whenever lo <= x <= hi by value, a tie with either bound included, otherwise the bound the input crosses. A NaN operand propagates; when lo exceeds hi the answer is lo.") (@params ((@param (@type Number) (@desc "Lower bound")) (@param (@type Number) (@desc "Upper bound")) (@param (@type Number) (@desc "Input value")))) (@return (@type Number) (@desc "The input when it lies within the inclusive [lo, hi] interval by value, else the bound it crosses")))]
[(@doc-formal (@item math:mod) (@kind function) (@type (-> Number Number Number)) (@desc "Euclidean modulo in the math: namespace. The result is the canonical non-negative remainder modulo the absolute divisor.") (@params ((@param (@type Number) (@desc "Dividend")) (@param (@type Number) (@desc "Divisor")))) (@return (@type Number) (@desc "Non-negative remainder less than the absolute divisor")))]
