; Removals keep the exact index: ground queries read it after each removal.
(A 1 x) (B 2 y) (A 1 x) (C 3 z) (B 2 y) (D 4 w)
(= (has $a) (collapse (match &self $a found)))
(= (count-of $a) (let $found (collapse (match &self $a found)) (size-atom $found)))
!(count-of (A 1 x))
!(remove-atom &self (A 1 x))
!(count-of (A 1 x))
!(has (D 4 w))
!(remove-atom &self (D 4 w))
!(has (D 4 w))
!(count-of (B 2 y))
!(remove-atom &self (B 2 y))
!(remove-atom &self (B 2 y))
!(count-of (B 2 y))
!(remove-atom &self (B 2 y))
!(add-atom &self (D 4 w))
!(has (D 4 w))
!(remove-atom &self (C 3 z))
!(has (C 3 z))
!(count-of (A 1 x))
!(remove-atom &self (A 1 x))
!(count-of (A 1 x))
!(collapse (match &self (A $n $l) (A $n $l)))
!(collapse (match &self (B $n $l) (B $n $l)))
!(collapse (match &self (D $n $l) (D $n $l)))
