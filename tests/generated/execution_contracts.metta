; Generated by scripts/gen_execution_contracts.py.
; Planner admission follows the relational may-effect fold.
!(bind! &effect-space (new-space pathmap))
!(add-atom &effect-space (left n0 k0))
!(add-atom &effect-space (right k0 v0))
!(add-atom &effect-space (left n1 k1))
!(add-atom &effect-space (right k1 v1))
(= (generated-relational-wrapper $name $key) (match &effect-space (right $key $value) (joined $name $value)))

; root
!(assertEqualToResult
  (collapse
    (match &effect-space (left $name $key)
      (match &effect-space (right $key $value) (joined $name $value))))
  (((joined n0 v0) (joined n1 v1))))
; let
!(assertEqualToResult
  (collapse
    (match &effect-space (left $name $key)
      (let $answer (match &effect-space (right $key $value) (joined $name $value)) $answer)))
  (((joined n0 v0) (joined n1 v1))))
; superpose
!(assertEqualToResult
  (collapse
    (match &effect-space (left $name $key)
      (superpose ((match &effect-space (right $key $value) (joined $name $value))))))
  (((joined n0 v0) (joined n1 v1))))
; if
!(assertEqualToResult
  (collapse
    (match &effect-space (left $name $key)
      (if True (match &effect-space (right $key $value) (joined $name $value)) no-result)))
  (((joined n0 v0) (joined n1 v1))))
; pure
!(assertEqualToResult
  (collapse
    (match &effect-space (left $name $key)
      (joined $name $key)))
  (((joined n0 k0) (joined n1 k1))))

; A user-defined head inherits the relational effect of its body.
!(assertEqualToResult
  (collapse
    (match &effect-space (left $name $key)
      (generated-relational-wrapper $name $key)))
  (((joined n0 v0) (joined n1 v1))))

; A template running get-atoms is relational: the pull declines
; and the oracle answers per row.
!(collapse
  (match &effect-space (left $name $key)
    (get-atoms &effect-space)))

; A cyclic substitution is additive zero, not a transport fault.
!(bind! &row-space (new-space pathmap))
!(add-atom &row-space (edge $stored $stored))
!(add-atom &row-space (edge a (f a)))
!(assertEqualToResult
  (collapse (match &row-space (edge $query (f $query)) (ok $query)))
  (((ok a))))
