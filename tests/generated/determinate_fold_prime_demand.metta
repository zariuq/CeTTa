; Generated by scripts/gen_execution_contracts.py.
; Prime demand is preserved by the prepared fold instruction.
(= (generated-fold-count $accumulator $item) (+ $accumulator 1))
(= (generated-fold-return-item $ignored $value) $value)
(= (generated-fold-box-number $value) (GeneratedFoldNumber (+ $value 1)))
(= (generated-fold-unbox-number (GeneratedFoldNumber $value)) $value)
(= (generated-fold-dynamic-number $value) (let $boxed (generated-fold-box-number $value) (generated-fold-unbox-number $boxed)))

; unused-faulting-item: admitted
!(foldl-atom (sentinel (== 1 "unused-fault")) 7 $accumulator $item (eval (generated-fold-count $accumulator $item)))
