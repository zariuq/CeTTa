; Collections inside called functions: completed values, one answer each.
(edge a b)
(edge a c)
(edge b c)
(edge c d)
(= (succ $x) (match &self (edge $x $y) $y))
(= (all-succ $x) (collapse (succ $x)))
!(let $answers (all-succ a) (sort-atom $answers))
!(all-succ d)
(= (twice $x) (collapse (superpose ($x $x))))
!(twice 1)
; Empty and errors inside collapse.
(= (none) (empty))
(= (with-empty) (collapse (superpose (1 (none) 2))))
!(let $answers (with-empty) (sort-atom $answers))
(= (with-error) (collapse (superpose (1 (Error x bad) 2))))
!(let $answers (with-error) (sort-atom $answers))
(= (only-error) (collapse (superpose ((Error x bad)))))
!(only-error)
; superpose results reaching a caller.
(= (pick) (superpose (1 (Error y bad) 2)))
!(pick)
(= (pick-empty) (superpose ()))
!(pick-empty)
; Set operations on completed tuples, duplicates and faults.
(= (uniq $t) (unique-atom $t))
!(uniq (a b a c b))
(= (uni $x $y) (union-atom $x $y))
!(uni (a b) (b c))
(= (sub $x $y) (subtraction-atom $x $y))
!(sub (a b c b) (b))
(= (int $x $y) (intersection-atom $x $y))
!(int (a b c) (c a d))
; Nested collections through a recursion, as the level-wise closure rows.
(= (successors $nodes)
   (let $found (collapse (let $x (superpose $nodes) (succ $x)))
        (unique-atom $found)))
(= (reach $front $seen)
   (if (== $front ())
       $seen
       (let $next (successors $front)
            (let $fresh (subtraction-atom $next $seen)
                 (let $all (union-atom $seen $fresh)
                      (reach $fresh $all))))))
!(let $answers (reach (a) ()) (sort-atom $answers))
!(reach (d) ())
!(match &self (edge a $y) (let $set (reach ($y) ()) (from $y $set)))
; A fault of a set operation's argument type ends the run, as in HE.
(= (uniq-num $x) (unique-atom $x))
!(uniq-num 5)
