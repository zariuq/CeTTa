; transform in the HE lane (lib/lib_transform.metta): it answers as match does, one
; branch per kernel match, with exact-occurrence takes, absence, counting, all and
; once.  Values the sources bind are evaluated as in a match template.
!(import! &self ../lib/lib_transform.metta)
(= (show $s) (let $xs (collapse (match $s $a $a)) (sort-atom $xs)))
(= (count $s $p) (let $xs (collapse (match $s $p x)) (size-atom $xs)))

; reads alone: the answers of match, duplicates included
!(bind! &p (new-space))
!(add-atom &p (p A))
!(add-atom &p (p B))
!(add-atom &p (p A))
!(add-atom &p (q B))
!(let $xs (collapse (transform &p (p $x) (tag $x))) (sort-atom $xs))
!(let $xs (collapse (match &p (p $x) (tag $x))) (sort-atom $xs))
!(collapse (transform &p (, (p $x) (q $x)) (both $x)))
!(collapse (transform &p (, (p $x) (absent (q $x))) (alone $x)))
!(collapse (transform &p (unique (q $x)) (only $x)))
!(collapse (transform &p (r $x) (never $x)))

; takes: one branch per match, each taking its own occurrence
!(bind! &a (new-space))
!(add-atom &a (coin 1))
!(add-atom &a (coin 2))
!(add-atom &a (coin 5))
!(let $xs (collapse (transform &a (take (coin $v)) (got $v))) (sort-atom $xs))
!(show &a)

; two copies of one atom are two matches, and each takes one copy
!(bind! &d (new-space))
!(add-atom &d (coin 1))
!(add-atom &d (coin 1))
!(add-atom &d (coin 2))
!(collapse (transform &d (take (coin 1)) spent))
!(show &d)

; two matches want the one token: one branch takes it, the other fires nothing
!(bind! &t (new-space))
!(add-atom &t (tok a))
!(add-atom &t (k 1))
!(add-atom &t (k 2))
!(let $xs (collapse (transform &t (, (take (tok $x)) (k $y)) (won $x $y))) (size-atom $xs))
!(show &t)

; all is computed when a branch fires: the first branch takes every q, the second
; fires with none left
!(bind! &e (new-space))
!(add-atom &e (r 1))
!(add-atom &e (r 2))
!(add-atom &e (q a))
!(add-atom &e (q b))
!(let $xs (collapse (transform &e (, (r $x) (all (take (q $y)))) (moved $y))) (sort-atom $xs))
!(show &e)

; once fires the first match that holds: alone it takes one coin; after a read,
; each branch takes one q still there
!(bind! &w (new-space))
!(add-atom &w (coin 1))
!(add-atom &w (coin 2))
!(add-atom &w (coin 5))
!(let $xs (collapse (transform &w (once (take (coin $v))) (got $v))) (size-atom $xs))
!(count &w (coin $v))
!(bind! &f (new-space))
!(add-atom &f (r 1))
!(add-atom &f (r 2))
!(add-atom &f (q a))
!(add-atom &f (q b))
!(add-atom &f (q c))
!(let $xs (collapse (transform &f (, (r $x) (once (take (q $y)))) (moved $x $y))) (size-atom $xs))
!(count &f (q $y))

; collect gathers every match as one value; a take-mode collect takes the whole set
!(bind! &c (new-space))
!(add-atom &c (ev 1))
!(add-atom &c (ev 2))
!(add-atom &c (ev 3))
!(collapse (transform &c (, (collect (take (ev $n)) $evs) (let $k (size-atom $evs))) (revised $k)))
!(show &c)

; into a destination space: each branch answers how many it routed
!(bind! &src (new-space))
!(bind! &dst (new-space))
!(add-atom &src (job a))
!(add-atom &src (job b))
!(collapse (transform &src (take (job $j)) (done $j) &dst))
!(show &src)
!(show &dst)

; a branch's other conditions are evaluated when it fires, each with its own
; variables free
!(bind! &g (new-space))
!(add-atom &g (q 1))
!(add-atom &g (q 2))
!(add-atom &g (r 1))
!(collapse (transform &g (, (collect (q $y) $C) (r $y)) (got $y)))
!(bind! &u (new-space))
!(add-atom &u (k 1))
!(add-atom &u (k 2))
!(add-atom &u (p 7))
!(collapse (transform &u (, (take (k $n)) (unique (p $x))) (p $n) &u))
!(count &u (k $n))

; the template's own syntax decides how many instances a row gives
!(bind! &cs (new-space))
!(bind! &cd (new-space))
!(add-atom &cs (pair (, a b)))
!(collapse (transform &cs (pair $x) $x &cd))
!(count &cd $z)

; ',' is conjunction where a query is read and a constructor where data is: joint
; takes, stored comma atoms as data, reads reusing an occurrence, takes of distinct
; occurrences, and absent, unique and collect over joint matches.
!(bind! &jt (new-space))
!(add-atom &jt a)
!(add-atom &jt a)
!(add-atom &jt b)
!(let $r (collapse (transform &jt (take (, a b)) took)) (joint-take $r))
!(let $r (show &jt) (after-joint-take $r))
!(bind! &jc (new-space))
!(add-atom &jc (, a b))
!(let $r (collapse (transform &jc $x $x)) (stored-comma $r))
!(bind! &jr (new-space))
!(add-atom &jr (p 1))
!(add-atom &jr (, (p 1) (p 1)))
!(let $r (collapse (transform &jr (read (, $y $z)) ($y $z))) (read-pairs (size-atom $r)))
!(bind! &ju2 (new-space))
!(add-atom &ju2 a)
!(let $r (collapse (transform &ju2 (take (, a a)) took)) (take-aa-one $r))
!(add-atom &ju2 a)
!(let $r (collapse (transform &ju2 (take (, a a)) took)) (take-aa-two $r))
!(let $r (show &ju2) (after-take-aa $r))
!(bind! &jb (new-space))
!(add-atom &jb (p 1))
!(add-atom &jb (q 2))
!(let $r (collapse (transform &jb (absent (, (p $x) (q $x))) none)) (absent-joint $r))
!(add-atom &jb (q 1))
!(let $r (collapse (transform &jb (absent (, (p $x) (q $x))) none)) (absent-joint-after $r))
!(bind! &ju (new-space))
!(add-atom &ju (p 1))
!(add-atom &ju (q 1))
!(add-atom &ju (q 2))
!(let $r (collapse (transform &ju (, (unique (take (, (p $x) (q $x))))) ($x took))) (unique-joint $r))
!(let $r (show &ju) (after-unique-joint $r))
!(bind! &jk (new-space))
!(add-atom &jk (p 1))
!(add-atom &jk (q 1))
!(add-atom &jk (p 2))
!(add-atom &jk (q 2))
!(let $r (collapse (transform &jk (collect (, (p $x) (q $x)) $all) $all)) (collect-joint $r))
!(bind! &ka (new-space))
!(add-atom &ka (p 1))
!(add-atom &ka (q 1))
!(add-atom &ka (q 2))
!(let $r (collapse (transform &ka (collect (take (, (p $x) (q $y))) $c) (size-atom $c))) (shared-p $r))
!(let $r (show &ka) (after-shared-p $r))
!(bind! &kb (new-space))
!(add-atom &kb (p 1))
!(add-atom &kb (p 1))
!(add-atom &kb (q 1))
!(let $r (collapse (transform &kb (collect (take (, (p $x) (q $y))) $c) (size-atom $c))) (copies-p $r))
!(let $r (show &kb) (after-copies-p $r))
!(bind! &kc (new-space))
!(add-atom &kc a)
!(let $r (collapse (transform &kc (collect (take (, a a)) $c) $c)) (take-aa-collect $r))
!(let $r (show &kc) (after-take-aa-collect $r))
