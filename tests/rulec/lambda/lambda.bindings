; The binding table of the lambda-calculus client: the same generic components as the HOL Light
; kernel module, nothing written for this calculus.  The judgments' rules are the contract.
(rep "Nat" nat "lc:nz" "lc:nb0" "lc:nb1")
(rep "Str" bytes "lc:nnil" "lc:ncons" "lc:byte" "lc:x")
(rep "Term" intern)
(rep "Names" intern)
(rep "Pairs" intern)
(block "name equality" "lc:str-eq" (equal "lc:yes" "lc:no") "proved" "interned byte strings: equal bytes exactly when one node; str-eq is cmp-str's eq")
(block "name order" "lc:cmp-str" (bytes-order "lc:lt" "lc:eq" "lc:gt") "proved" "the rules' order is the unsigned byte order, a proper prefix first (the HOL module's cmp-str rules, cmpStr_refines)")
(block "name prime" "lc:str-prime" (bytes-snoc "27") "proved" "the rules append the byte 0x27 (strPrime_refines)")
(block "numeral order" "lc:cmp-nat" (nat-order "lc:lt" "lc:eq" "lc:gt") "proved" "cmpNat_refines")
(block "numeral successor" "lc:nat-inc" (nat-succ) "proved" "natInc_refines; checked at run time: the immediate range")
(block "term order" "lc:cmp-term" (structural-order "lc:lt" "lc:eq" "lc:gt") "checked" "the structural order: Var < App < Lam, then the children in order, as cmp-term's rules state; every call compared in check mode")
(block "term equality" "lc:term-eq" (equal "lc:yes" "lc:no") "checked" "interned terms: term-eq is cmp-term's eq, which holds exactly on equal terms")
(block "names union" "lc:names-union" (set-union "lc:cmp-str" "lc:lt" "lc:eq" "lc:gt") "proved" "setUnion_eq_termUnion: names-union's rules are the merge, for every comparator; trusted: rc_set.c is the model")
(block "names remove" "lc:names-remove" (set-remove "lc:cmp-str" "lc:lt" "lc:eq" "lc:gt") "proved" "setRemove_eq_termRemove: names-remove's rules are the removal, for every comparator; trusted: rc_set.c is the model")
(memo "free variables" "lc:fv" "proved" "fv is a function of an interned term: memo_sound, memo2_sound; trusted: rc_memo.c is the model")
(memo "substitution" "lc:subst" "proved" "subst is a function of a name and two interned terms: memo_sound, memo2_sound; trusted: rc_memo.c is the model")
(memo "alpha-equivalence" "lc:alpha-eq" "proved" "alpha-eq is a function of two interned terms: memo_sound, memo2_sound; trusted: rc_memo.c is the model")
