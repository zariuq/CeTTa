!(bind! &stk (new-space stack))
!(assertEqualToResult (get-type &stk) ((Space stack)))
!(assertEqualToResult (space-len &stk) (0))
!(add-atom &stk alpha)
!(add-atom &stk beta)
!(assertEqualToResult (space:stack:get &stk 0) (alpha))
!(assertEqualToResult (space:stack:get &stk 1) (beta))
!(assertEqualToResult (space:stack:peek &stk) (beta))
!(assertEqualToResult (get-atoms &stk) (alpha beta))
!(assertEqualToResult (space:stack:pop &stk) (beta))
!(assertEqualToResult (space:stack:peek &stk) (alpha))
!(space:stack:truncate &stk 0)
!(assertEqualToResult (space-len &stk) (0))
!(assertEqualToResult (collapse (get-atoms &stk)) (()))
