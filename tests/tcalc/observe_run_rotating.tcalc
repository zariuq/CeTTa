; The run of observe_run.tcalc under the rotating schedule: the n-th step takes
; the n-th successor in the structural order, counted round.  The first step
; takes successor 0 of 2, b's first fork, as the canonical run does; the second
; takes successor 1 of 2, a's first fork, and the run ends in the deadlock the
; canonical run never meets.
(step one)
(observe run)
(schedule rotating)
(fork 1) (fork 2)
(thinking a 1 2)
(thinking b 2 1)
(rule left (take (thinking $p $l $r) (fork $l)) (make (holding $p $l $r)))
(rule right (take (holding $p $l $r) (fork $r)) (make (eating $p $l $r)))
(rule done (take (eating $p $l $r)) (make (fork $l) (fork $r) (fed $p)))
