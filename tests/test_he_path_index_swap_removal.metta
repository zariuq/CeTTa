; Position indexes follow unordered removal: the removed row leaves its
; posting and the last row moves to its place; every other row still
; answers, once.
(k a 1)
(k b 2)
(k c 1)
(k d 3)
(k e 1)
(k f 2)
(k g 4)
(k open $v)
(other x 1)
(k h 1)
!(let $answers (collapse (match &self (k $x 1) $x)) (sort-atom $answers))
!(let $answers (collapse (match &self (k $x 2) $x)) (sort-atom $answers))
; Remove from the middle: the last row moves.
!(remove-atom &self (k c 1))
!(let $answers (collapse (match &self (k $x 1) $x)) (sort-atom $answers))
; Empty a key, then give it a row again.
!(remove-atom &self (k d 3))
!(collapse (match &self (k $x 3) $x))
!(add-atom &self (k d2 3))
!(let $answers (collapse (match &self (k $x 3) $x)) (sort-atom $answers))
; Remove the last row itself, and an open row.
!(remove-atom &self (k d2 3))
!(remove-atom &self (k open $v))
!(let $answers (collapse (match &self (k $x 1) $x)) (sort-atom $answers))
!(collapse (match &self (k $x 4) $x))
; Keys emptied, then new keys: the key table grows past the emptied ones.
!(add-atom &self (k m10 10))
!(add-atom &self (k m11 11))
!(add-atom &self (k m12 12))
!(add-atom &self (k m13 13))
!(add-atom &self (k m14 14))
!(add-atom &self (k m15 15))
!(add-atom &self (k m16 16))
!(add-atom &self (k m17 17))
!(add-atom &self (k m18 18))
!(add-atom &self (k m19 19))
!(collapse (match &self (k $x 12) $x))
!(remove-atom &self (k m10 10))
!(remove-atom &self (k m11 11))
!(remove-atom &self (k m12 12))
!(remove-atom &self (k m13 13))
!(remove-atom &self (k m14 14))
!(remove-atom &self (k m15 15))
!(remove-atom &self (k m16 16))
!(remove-atom &self (k m17 17))
!(remove-atom &self (k m18 18))
!(remove-atom &self (k m19 19))
!(collapse (match &self (k $x 12) $x))
!(add-atom &self (k n30 30))
!(add-atom &self (k n31 31))
!(add-atom &self (k n32 32))
!(add-atom &self (k n33 33))
!(add-atom &self (k n34 34))
!(add-atom &self (k n35 35))
!(add-atom &self (k n36 36))
!(add-atom &self (k n37 37))
!(add-atom &self (k n38 38))
!(add-atom &self (k n39 39))
!(add-atom &self (k n40 40))
!(add-atom &self (k n41 41))
!(add-atom &self (k n42 42))
!(add-atom &self (k n43 43))
!(add-atom &self (k n44 44))
!(add-atom &self (k n45 45))
!(collapse (match &self (k $x 12) $x))
!(collapse (match &self (k $x 33) $x))
!(remove-atom &self (k n33 33))
!(collapse (match &self (k $x 33) $x))
!(collapse (match &self (k $x 45) $x))
!(let $answers (collapse (match &self (k $x 1) $x)) (sort-atom $answers))
!(collapse (match &self (other $y 1) $y))
