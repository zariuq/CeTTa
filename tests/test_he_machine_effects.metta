; Effects and comparisons inside called functions.
(A 1 x)
(= (put $k $v) (add-atom &self (A $k $v)))
!(put 2 y)
(= (drop $k $v) (remove-atom &self (A $k $v)))
!(drop 1 x)
!(drop 9 z)
!(collapse (match &self (A $k $v) ($k $v)))
; Comparisons as conditions: decided, and left unreduced by a non-number.
(= (cmp $x) (if (< $x 3) small big))
!(cmp 1)
!(cmp 5)
!(cmp a)
; let* in sequence, effects inside.
(= (seq $k) (let* (($a (add-atom &self (B $k))) ($b (remove-atom &self (B $k)))) (done $a $b)))
!(seq 1)
!(collapse (match &self (B $k) $k))
; A conjunction pattern, rows taken before any template runs.
(C 1 one) (C 2 two) (D one 10) (D two 20)
(= (join $k) (match &self (, (C $k $n) (D $n $v)) $v))
!(join 2)
(= (move-all) (collapse (match &self (C $k $n) (let* (($r (remove-atom &self (C $k $n))) ($a (add-atom &self (E $k $n)))) $k))))
!(let $answers (move-all) (sort-atom $answers))
!(collapse (match &self (C $k $n) $k))
!(let $answers (collapse (match &self (E $k $n) $k)) (sort-atom $answers))
; An odd-even sort pass over the space, as the sort rows.
(V 0 30) (V 1 10) (V 2 20)
(next 0 1) (next 1 2)
(= (swap $i $x $j $y)
   (let* (($a (remove-atom &self (V $i $x))) ($b (remove-atom &self (V $j $y)))
          ($c (add-atom &self (V $i $y))) ($d (add-atom &self (V $j $x))))
         swapped))
(= (pass) (collapse (match &self (, (next $i $j) (V $i $x) (V $j $y))
                       (if (< $y $x) (swap $i $x $j $y) (empty)))))
!(pass)
!(pass)
!(let $answers (collapse (match &self (V $i $x) ($i $x))) (sort-atom $answers))
; A two-argument if (CeTTa accepts it; the HE reference rejects it).
(= (cmp2 $x) (if (>= $x 3) big))
!(cmp2 4)
!(cmp2 b)
