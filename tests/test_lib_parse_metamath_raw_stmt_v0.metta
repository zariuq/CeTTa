!(import! &self ./support/lib_parse_metamath_grammar_v0.metta)

!(assertEqual (mm-parse-stmt-class (mm-cdecl-raw)) Unique)
!(assertEqual (mm-parse-stmt-class (mm-vdecl-raw)) Unique)
!(assertEqual (mm-parse-stmt-class (mm-float-raw)) Unique)
!(assertEqual (mm-parse-stmt-class (mm-dv-raw)) Unique)
!(assertEqual (mm-parse-stmt-class (mm-normal-thm-raw)) Unique)
!(assertEqual (mm-parse-stmt-class (mm-compressed-thm-raw)) Unique)
!(assertEqual (mm-parse-stmt-class (mm-empty-compressed-thm-raw)) Unique)
!(assertEqual (mm-parse-stmt-class (mm-a1-raw)) Unique)
!(assertEqual (mm-parse-stmt-class "$( hidden $) wph $f wff ph $.") Unique)
!(assertEqual (mm-parse-stmt-class (mm-bad-compressed-raw)) NoParse)
!(assertEqual (mm-parse-stmt-class (mm-bad-compressed-lex-raw)) LexError)
!(assertEqual (mm-parse-stmt-class "$( hidden wph $f wff ph $.") NoParse)

!(assertEqual (mm-lex-string (mm-cdecl-raw)) (Ok (mm-cdecl-demo0-toks)))
!(assertEqual (mm-lex-string (mm-vdecl-raw)) (Ok (mm-vdecl-raw-toks)))
!(assertEqual (mm-lex-string (mm-float-raw)) (Ok (mm-float-raw-toks)))
!(assertEqual (mm-lex-string (mm-dv-raw)) (Ok (mm-dv-raw-toks)))
!(assertEqual (mm-lex-string (mm-normal-thm-raw)) (Ok (mm-normal-thm-raw-toks)))
!(assertEqual (mm-lex-string (mm-compressed-thm-raw)) (Ok (mm-compressed-thm-raw-toks)))
!(assertEqual (mm-lex-string (mm-empty-compressed-thm-raw)) (Ok (mm-empty-compressed-thm-raw-toks)))
!(assertEqual (mm-lex-string (mm-a1-raw)) (Ok (mm-a1-raw-toks)))
