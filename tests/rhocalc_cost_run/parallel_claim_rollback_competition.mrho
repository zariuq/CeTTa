(rho:cost:par
  (rho:cost:signed
    (rho:par
      (rho:recv c $x (rho:cost:signed rho:nil done))
      (rho:send c (rho:cost:signed rho:nil payload)))
    spend)
  (rho:cost:purse c
    (rho:cost:stack-cons spend rho:cost:stack-empty))
  (rho:cost:purse c
    (rho:cost:stack-cons spend rho:cost:stack-empty)))
