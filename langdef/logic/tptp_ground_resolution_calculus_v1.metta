(gslt-presentation-v1 TptpGroundResolutionCalculus
  (signature
    (operator ground-resolution:positive 1)
    (operator ground-resolution:negative 1)
    (operator ground-resolution:cons 2)
    (operator GroundRemovePositive 3)
    (operator GroundRemoveNegative 3)
    (operator GroundAppend 3)
    (operator GroundLiterals 1)
    (operator GroundResolve 5)
  )
  (equations)
  (rewrites
    (rule ground-resolution:remove-positive-head (head (GroundRemovePositive ?pivot (ground-resolution:cons (ground-resolution:positive ?pivot) ?xs) ?xs)) (body))
    (rule ground-resolution:remove-positive-tail (head (GroundRemovePositive ?pivot (ground-resolution:cons ?head ?xs) (ground-resolution:cons ?head ?ys))) (body (GroundRemovePositive ?pivot ?xs ?ys)))
    (rule ground-resolution:remove-negative-head (head (GroundRemoveNegative ?pivot (ground-resolution:cons (ground-resolution:negative ?pivot) ?xs) ?xs)) (body))
    (rule ground-resolution:remove-negative-tail (head (GroundRemoveNegative ?pivot (ground-resolution:cons ?head ?xs) (ground-resolution:cons ?head ?ys))) (body (GroundRemoveNegative ?pivot ?xs ?ys)))
    (rule ground-resolution:append-nil (head (GroundAppend ground-resolution:nil ?ys ?ys)) (body))
    (rule ground-resolution:append-cons (head (GroundAppend (ground-resolution:cons ?head ?xs) ?ys (ground-resolution:cons ?head ?zs))) (body (GroundAppend ?xs ?ys ?zs)))
    (rule ground-resolution:literals-nil (head (GroundLiterals ground-resolution:nil)) (body))
    (rule ground-resolution:literals-positive (head (GroundLiterals (ground-resolution:cons (ground-resolution:positive ?pivot) ?xs))) (body (GroundLiterals ?xs)))
    (rule ground-resolution:literals-negative (head (GroundLiterals (ground-resolution:cons (ground-resolution:negative ?pivot) ?xs))) (body (GroundLiterals ?xs)))
    (rule ground-resolution:resolve-positive-left (head (GroundResolve ground-resolution:positive-left ?pivot ?left ?right ?result)) (body (GroundRemovePositive ?pivot ?left ?leftRest) (GroundRemoveNegative ?pivot ?right ?rightRest) (GroundAppend ?leftRest ?rightRest ?result) (GroundLiterals ?left) (GroundLiterals ?right) (GroundLiterals ?result)))
    (rule ground-resolution:resolve-positive-right (head (GroundResolve ground-resolution:positive-right ?pivot ?left ?right ?result)) (body (GroundRemoveNegative ?pivot ?left ?leftRest) (GroundRemovePositive ?pivot ?right ?rightRest) (GroundAppend ?leftRest ?rightRest ?result) (GroundLiterals ?left) (GroundLiterals ?right) (GroundLiterals ?result)))
  ))
