Module TensorDescriptors {
  Theory Descriptors() {
    Empty Types { Descriptor; } Terms {
      "i64". |- "i64" : Descriptor;
      "f64". |- "f64" : Descriptor;
      "u8". |- "u8" : Descriptor;
      "f32". |- "f32" : Descriptor;
      "bool". |- "bool" : Descriptor;
      "index". |- "index" : Descriptor;
      "Code1". |- "Code1" : Descriptor;
      "Code2". |- "Code2" : Descriptor;
      "Code3". |- "Code3" : Descriptor;
      "Code4". |- "Code4" : Descriptor;
      "Code5". |- "Code5" : Descriptor;
      "Code6". |- "Code6" : Descriptor;
      "Bytes1". |- "Bytes1" : Descriptor;
      "Bytes4". |- "Bytes4" : Descriptor;
      "Bytes8". |- "Bytes8" : Descriptor;
      "Signed". |- "Signed" : Descriptor;
      "Floating". |- "Floating" : Descriptor;
      "Unsigned". |- "Unsigned" : Descriptor;
      "Boolean". |- "Boolean" : Descriptor;
      "Precision1". |- "Precision1" : Descriptor;
      "Precision8". |- "Precision8" : Descriptor;
      "Precision24". |- "Precision24" : Descriptor;
      "Precision53". |- "Precision53" : Descriptor;
      "Precision64". |- "Precision64" : Descriptor;
      "dense". |- "dense" : Descriptor;
      "coo". |- "coo" : Descriptor;
      "csr". |- "csr" : Descriptor;
      "csc". |- "csc" : Descriptor;
      "AllPresent". |- "AllPresent" : Descriptor;
      "ExplicitSupport". |- "ExplicitSupport" : Descriptor;
      "RowMajorOrStrided". |- "RowMajorOrStrided" : Descriptor;
      "CoordinateAscending". |- "CoordinateAscending" : Descriptor;
      "RowCompressed". |- "RowCompressed" : Descriptor;
      "ColumnCompressed". |- "ColumnCompressed" : Descriptor;
      "equality". |- "equality" : Descriptor;
      "sum". |- "sum" : Descriptor;
      "matvec". |- "matvec" : Descriptor;
      "dotBounds". |- "dotBounds" : Descriptor;
      "matvecBounds". |- "matvecBounds" : Descriptor;
      "NearestGradualSeparate". |- "NearestGradualSeparate" : Descriptor;
      "StoredRealInputEnclosure". |- "StoredRealInputEnclosure" : Descriptor;
      "TypedRefusal". |- "TypedRefusal" : Descriptor;
      "fixed4". |- "fixed4" : Descriptor;
      "topk". |- "topk" : Descriptor;
      "entries". |- "entries" : Descriptor;
      "gather". |- "gather" : Descriptor;
      "merge". |- "merge" : Descriptor;
      "zipmap". |- "zipmap" : Descriptor;
      "screen". |- "screen" : Descriptor;
      "OwnerQueryMaskKBound". |- "OwnerQueryMaskKBound" : Descriptor;
      "NearestGradualSequential". |- "NearestGradualSequential" : Descriptor;
      "InclusiveThreshold". |- "InclusiveThreshold" : Descriptor;
      "ExactRerank". |- "ExactRerank" : Descriptor;
      "FullScanFallback". |- "FullScanFallback" : Descriptor;
      "PackedCoordinateValueVectors". |- "PackedCoordinateValueVectors" : Descriptor;
      "IndexPullbackSupport". |- "IndexPullbackSupport" : Descriptor;
      "BoundsChecked". |- "BoundsChecked" : Descriptor;
      "OccurrenceConcatenate". |- "OccurrenceConcatenate" : Descriptor;
      "ExplicitDuplicatePolicy". |- "ExplicitDuplicatePolicy" : Descriptor;
      "EqualShapeSupport". |- "EqualShapeSupport" : Descriptor;
      "CapturedValueCall". |- "CapturedValueCall" : Descriptor;
      "AtomicFallback". |- "AtomicFallback" : Descriptor;
      "COOResult". |- "COOResult" : Descriptor;
      "DTypeShapeSupportScalarBits". |- "DTypeShapeSupportScalarBits" : Descriptor;
      "StoredCoordinateOrder". |- "StoredCoordinateOrder" : Descriptor;
      "F64AccumulateFloats". |- "F64AccumulateFloats" : Descriptor;
      "StoredRowCoordinateOrder". |- "StoredRowCoordinateOrder" : Descriptor;
      "FourLanesLeftAssociated". |- "FourLanesLeftAssociated" : Descriptor;
      "ExplicitSelection". |- "ExplicitSelection" : Descriptor;
      "FiniteEnabledDescending". |- "FiniteEnabledDescending" : Descriptor;
      "CoordinateAscendingTies". |- "CoordinateAscendingTies" : Descriptor;
      "CTN1". |- "CTN1" : Descriptor;
      "Signed64Atom". |- "Signed64Atom" : Descriptor;
      "Unsigned8Atom". |- "Unsigned8Atom" : Descriptor;
      "Float32Atom". |- "Float32Atom" : Descriptor;
      "Float64Atom". |- "Float64Atom" : Descriptor;
      "Unsigned64Atom". |- "Unsigned64Atom" : Descriptor;
    } Equations {
      (TensorDType (i64)) == (ScalarLayout (Code1) (Bytes8) (Signed) (Precision64));
      (TensorDType (f64)) == (ScalarLayout (Code2) (Bytes8) (Floating) (Precision53));
      (TensorDType (u8)) == (ScalarLayout (Code3) (Bytes1) (Unsigned) (Precision8));
      (TensorDType (f32)) == (ScalarLayout (Code4) (Bytes4) (Floating) (Precision24));
      (TensorDType (bool)) == (ScalarLayout (Code5) (Bytes1) (Boolean) (Precision1));
      (TensorDType (index)) == (ScalarLayout (Code6) (Bytes8) (Unsigned) (Precision64));
      (TensorCallbackInput (i64)) == (ScalarAtomInput (Signed64Atom));
      (TensorCallbackInput (f64)) == (ScalarAtomInput (Float64Atom));
      (TensorCallbackInput (u8)) == (ScalarAtomInput (Unsigned8Atom));
      (TensorCallbackInput (f32)) == (ScalarAtomInput (Float32Atom));
      (TensorCallbackInput (index)) == (ScalarAtomInput (Unsigned64Atom));
      (TensorLayout (dense)) == (LayoutPolicy (AllPresent) (RowMajorOrStrided));
      (TensorLayout (coo)) == (LayoutPolicy (ExplicitSupport) (CoordinateAscending));
      (TensorLayout (csr)) == (LayoutPolicy (ExplicitSupport) (RowCompressed));
      (TensorLayout (csc)) == (LayoutPolicy (ExplicitSupport) (ColumnCompressed));
      (TensorObservation (equality)) == (Observe (DTypeShapeSupportScalarBits));
      (TensorObservation (sum)) == (Observe (StoredCoordinateOrder) (F64AccumulateFloats));
      (TensorObservation (matvec)) == (Observe (StoredRowCoordinateOrder) (F64AccumulateFloats));
      (TensorObservation (dotBounds)) == (Observe (StoredCoordinateOrder) (NearestGradualSeparate) (StoredRealInputEnclosure) (TypedRefusal));
      (TensorObservation (matvecBounds)) == (Observe (StoredRowCoordinateOrder) (NearestGradualSeparate) (StoredRealInputEnclosure) (TypedRefusal));
      (TensorObservation (fixed4)) == (Observe (FourLanesLeftAssociated) (ExplicitSelection));
      (TensorObservation (topk)) == (Observe (FiniteEnabledDescending) (CoordinateAscendingTies));
      (TensorObservation (entries)) == (Observe (CoordinateAscending) (PackedCoordinateValueVectors));
      (TensorObservation (gather)) == (Observe (IndexPullbackSupport) (BoundsChecked));
      (TensorObservation (merge)) == (Observe (OccurrenceConcatenate) (ExplicitDuplicatePolicy));
      (TensorObservation (zipmap)) == (Observe (EqualShapeSupport) (CapturedValueCall) (CoordinateAscending) (AtomicFallback) (COOResult));
      (TensorObservation (screen)) == (Observe (OwnerQueryMaskKBound) (NearestGradualSequential) (InclusiveThreshold) (CoordinateAscendingTies) (ExactRerank) (FullScanFallback));
      (TensorTransport (CTN1)) == (DenseOnly (Code1) (Code2) (Code3) (Code4));
    }
  }
  theory Descriptors()
}
