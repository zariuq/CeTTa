; authored target equations
; gslt-lowered-equation-v1 source-rewrite=486 source-presentation=PythonScopeHostV1 source-rule=py-maybe-mangle-petta target=authored-target-equation
(= (gslt:py-maybe-mangle (py-maybe-mangle $c $m $n $r)) (let $x (pyhost:maybe-mangle $c $m $n) (quote (py-maybe-mangle $c $m $n $x))))
; gslt-lowered-equation-v1 source-rewrite=489 source-presentation=PythonScopeHostV1 source-rule=py-has-petta target=authored-target-equation
(= (gslt:py-has (py-has $s $x $f)) (let $y (pyhost:has $s $x) (quote (py-has $s $x $y))))
; gslt-lowered-equation-v1 source-rewrite=492 source-presentation=PythonScopeHostV1 source-rule=py-set-add-petta target=authored-target-equation
(= (gslt:py-set-add (py-set-add $s $x $r)) (let $y (pyhost:set-add $s $x) (quote (py-set-add $s $x $y))))
