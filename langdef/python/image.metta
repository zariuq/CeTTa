; The prelude's heap image: the prelude run once at build time, and the
; runtime's state it leaves (every heap record, the next object id, the
; prelude's namespace) written as atoms.  A run loads the image into its heap
; instead of running the prelude again.
;   cetta --lang petta --profile extended image.metta -- OUTPUT
!(import! &self host_runtime)
!(import! &self generated/machine_program_v1)
!(import! &self generated/prelude_v1)
!(import! &self fs)
!(import! &self system)

(= (pyimage:output) (pyimage:last (system:args)))
(= (pyimage:last $xs)
   (let ($x $rest) (decons-atom $xs) (if (== $rest ()) $x (pyimage:last $rest))))

; one atom a line, the state last.  An infinity, a NaN or a string holding
; a NUL character does not read back from its printed form, so an atom
; holding one is written as (py-image-special ATOM), each such float a
; (py-image-float KIND SIGN), each such string (py-image-text CODE-POINTS),
; the run decodes
(= (pyimage:text)
   (let $atoms (collapse (get-atoms &py-heap))
     (str:concat (str:join "\n" (pyimage:reprs $atoms ()))
                 (str:concat "\n" (repr (py-image-state (get-state &py-ids) (get-state &py-prelude)))))))
; the heap's atoms written in any order (a heap is a set), the recursion in
; tail position: the heap has thousands of atoms
(= (pyimage:reprs $atoms $acc)
   (if (== $atoms ()) $acc
     (let ($a $rest) (decons-atom $atoms)
       (let $e (pyimage:encode $a)
         (let $r (repr (if (== $e $a) $a (py-image-special $e)))
           (pyimage:reprs $rest (cons-atom $r $acc)))))))
(= (pyimage:encode $a)
   (if (== (get-metatype $a) Expression)
       (pyimage:encode-each $a)
       (if (pyrt:is-float $a)
           (if (float:is-finite $a) $a
             (py-image-float (if (float:is-nan $a) nan (if (float:sign-bit $a) -inf inf)) (float:sign-bit $a)))
           (if (pyrt:is-str $a)
               (let $cps (str:codepoint-values $a)
                 (if (pyrt:has-cp $cps 0) (py-image-text (pyrt:seq-copy $cps)) $a))
               $a))))
(= (pyimage:encode-each $xs)
   (if (== $xs ()) ()
     (let ($x $rest) (decons-atom $xs) (cons-atom (pyimage:encode $x) (pyimage:encode-each $rest)))))

!(case (pyrt:start-prelude (python:prelude-code))
   (((m:err $e) (let $w (pyrt:report $e) (system:exit 70)))
    ($ok (fs:write (pyimage:output) (str:concat "; Generated by image.metta from the prelude's run; do not edit.\n" (pyimage:text))))))
