(= (pyrt:btype lazy_import) (bt "lazy_import" "builtins" ((py:type object)) ((py:type lazy_import) (py:type object)) False False))
(= (pyrt:btype SimpleNamespace) (bt "SimpleNamespace" "types" ((py:type object)) ((py:type SimpleNamespace) (py:type object)) True True))
(= (pyrt:btype PyCapsule) (bt "PyCapsule" "builtins" ((py:type object)) ((py:type PyCapsule) (py:type object)) False False))
