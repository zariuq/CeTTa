(= (pyrt:btype NoDefaultType) (bt "NoDefaultType" "builtins" ((py:type object)) ((py:type NoDefaultType) (py:type object)) False False))
(= (pyrt:btype Template) (bt "Template" "string.templatelib" ((py:type object)) ((py:type Template) (py:type object)) False False))
