      -- format (codegen_function_annotations); none without annotations
      "ANNOTATE-NONE". nm:T, qn:T, args:T, rt:T, pos:T, x:T, n:T |- "CAnnotateFor"("py:False"(), nm, qn, args, rt, pos, x, n) ~> "c:anf"("LNil"(), "c:no-annotate"(), n);
      "ANNOTATE-FUNCTION". pl:T, nm:T, qn:T, args:T, rt:T, pos:T, k:T, tb:T, q:T, pv:T, sl:T, lp:T, n:T, at:T, aqn:T, aqi:T, abody:T, aargs:T, slots:T, spec:T, spec2:T, cells:T, frees:T, fnames:T, n0:T, fb:T, nx:T, clo:T, fk:T, none:T, an:T, r:T | "py-pos-line"(pos, pl), "CAnnotationTable"("c:tq"(tb, q, pv), pos) ~> at, "py-annotate-qualname"(qn, aqn), "py-qualname-inner"(aqn, aqi), "py-annotate-body"(args, rt, pv, pos, abody), "py-annotate-args"(pos, aargs), "py-code-layout"(aargs, at, pv, "c:layout"(slots, spec, cells, frees, fnames)), "py-annotate-spec"(spec, spec2), "py-slot-count"(slots, n0), "CFunctionBody"(abody, "c:cx"("c:function"("py:False"(), "py:False"()), "c:tq"(at, aqi, pv), slots, "py:None"()), n0) ~> "c:st"(fb, nx), "CClosure"(fnames, "c:cx"(k, "c:tq"(tb, q, pv), sl, lp)) ~> clo, "py-core-none"(none), "CCodeKind"("py:False"(), "py:False"(), none) ~> fk, "py-core-name"("c:n-annotate"(), an), "CTemp"("c:function"("c:code"(an, aqn, spec2, nx, cells, frees, fk, fb, "c:line"(pl)), "LNil"(), "LNil"(), clo, "c:no-annotate"()), "LNil"(), n) ~> r |- "CAnnotateFor"("py:True"(), nm, qn, args, rt, pos, "c:cx"(k, "c:tq"(tb, q, pv), sl, lp), n) ~> r;
      "ANNOTATION-TABLE". k:T, n:T, p:T, syms:T, tabs:T, q:T, pv:T, pos:T, t:T | "py-annotation-table"(tabs, pos, t) |- "CAnnotationTable"("c:tq"("st:table"(k, n, p, syms, tabs), q, pv), pos) ~> t;
      "FUNCTION-MADE". fl:T, asy:T, nm:T, args:T, body:T, pos:T, k:T, tb:T, q:T, sl:T, lp:T, ft:T, qn:T, qi:T, slots:T, spec:T, cells:T, frees:T, fnames:T, n0:T, fb:T, nx:T, pd:T, dflts:T, kwd:T, n1:T, clo:T, d:T, doc:T, r:T, rt:T, dflts0:T, kwd0:T, ha:T, pa:T, anns:T, n2:T, ph1:T, n3:T, ph2:T, n4:T, q0:T, q1:T, q2:T, pv:T, yg:T, fk:T | "py-has-yield"(body, yg), "CChild"("c:tq"(tb, q, pv), "st:function"(), pos) ~> ft, "py-qualname"(q, nm, qn), "py-qualname-inner"(qn, qi), "py-code-layout"(args, ft, pv, "c:layout"(slots, spec, cells, frees, fnames)), "py-slot-count"(slots, n0), "CFunctionBody"(body, "c:cx"("c:function"(asy, yg), "c:tq"(ft, qi, pv), slots, "py:None"()), n0) ~> "c:st"(fb, nx), "py-fn-has-annotations"(args, rt, ha), "CAnnotateFor"(ha, nm, qn, args, rt, pos, "c:cx"(k, "c:tq"(tb, q, pv), sl, lp), n1) ~> "c:anf"(pa, anns, n2), "CHoldAtoms"(dflts0, pa, n2) ~> "c:anfs"(ph1, dflts, n3), "CHoldKws"(kwd0, pa, n3) ~> "c:anfs"(ph2, kwd, n4), "CClosure"(fnames, "c:cx"(k, "c:tq"(tb, q, pv), sl, lp)) ~> clo, "py-docstring"(body, d), "CDocValue"(d) ~> doc, "CAppend"(pd, ph1) ~> q0, "CAppend"(q0, ph2) ~> q1, "CAppend"(q1, pa) ~> q2, "CCodeKind"(asy, yg, doc) ~> fk, "CTemp"("c:function"("c:code"(nm, qn, spec, nx, cells, frees, fk, fb, "c:line"(fl)), dflts, kwd, clo, anns), q2, n4) ~> r |- "CFunctionMade"(asy, nm, args, body, pos, fl, rt, "c:defaults"(pd, dflts0, kwd0, n1), "c:cx"(k, "c:tq"(tb, q, pv), sl, lp)) ~> r;
      "DEFAULTS". po:T, pa:T, va:T, ko:T, kd:T, kw:T, ds:T, x:T, n:T, p2:T, ks:T, n1:T, p1:T, xs:T, n2:T, pre:T | "CKwDefaults"(ko, kd, x, n) ~> "c:anfs"(p2, ks, n1), "COperands"(ds, p2, x, n1) ~> "c:anfs"(p1, xs, n2), "CAppend"(p1, p2) ~> pre |- "CDefaults"("py:arguments"(po, pa, va, ko, kd, kw, ds), x, n) ~> "c:defaults"(pre, xs, ks, n2);
      "KW-DEFAULTS-NIL". x:T, n:T |- "CKwDefaults"("LNil"(), "LNil"(), x, n) ~> "c:anfs"("LNil"(), "LNil"(), n);
      "KW-DEFAULTS-CONS". an:T, aa:T, at:T, al:T, ac:T, ael:T, aec:T, rest:T, d:T, ds:T, x:T, n:T, f:T, r:T | "py-is-none"(d, f), "CKwDefault"(f, an, d, rest, ds, x, n) ~> r |- "CKwDefaults"("LCons"("py:arg"(an, aa, at, al, ac, ael, aec), rest), "LCons"(d, ds), x, n) ~> r;
      "KW-DEFAULT-NONE". an:T, d:T, rest:T, ds:T, x:T, n:T, r:T | "CKwDefaults"(rest, ds, x, n) ~> r |- "CKwDefault"("py:True"(), an, d, rest, ds, x, n) ~> r;
      -- keyed by the parameter's name mangled, as the code's names are
      -- (compiler_visit_kwonlydefaults: _PyCompile_MaybeMangle)
      "KW-DEFAULT-SOME". an:T, d:T, rest:T, ds:T, x:T, n:T, p2:T, ks:T, n1:T, p1:T, a:T, n2:T, ph:T, ha:T, n3:T, q:T, pre:T, mg:T | "CMangle"(an, x) ~> mg, "CKwDefaults"(rest, ds, x, n) ~> "c:anfs"(p2, ks, n1), "CAtom"(d, x, n1) ~> "c:anf"(p1, a, n2), "CHold"(a, p2, "LNil"(), n2) ~> "c:anf"(ph, ha, n3), "CAppend"(p1, ph) ~> q, "CAppend"(q, p2) ~> pre |- "CKwDefault"("py:False"(), an, d, rest, ds, x, n) ~> "c:anfs"(pre, "LCons"("c:kw"(mg, ha), ks), n3);
      -- the closure: the cell of each free name, from the block around
      "CLOSURE-NIL". x:T |- "CClosure"("LNil"(), x) ~> "LNil"();
      "CLOSURE-CONS". nm:T, rest:T, k:T, tk:T, tn:T, tp:T, syms:T, tabs:T, q:T, pv:T, sl:T, lp:T, s:T, i:T, r:T | "py-closure-scope"(k, syms, nm, s), "CClosureSlot"(s, nm, sl) ~> i, "CClosure"(rest, "c:cx"(k, "c:tq"("st:table"(tk, tn, tp, syms, tabs), q, pv), sl, lp)) ~> r |- "CClosure"("LCons"(nm, rest), "c:cx"(k, "c:tq"("st:table"(tk, tn, tp, syms, tabs), q, pv), sl, lp)) ~> "LCons"("c:cellref"(i), r);
      -- the cell a closure takes: a cell or free name's slot (in a class body
      -- also a name it binds that a child takes from outside), or the cell a
      -- comprehension made for its own name
      "CLOSURE-SLOT-CELL". nm:T, sl:T, i:T | "py-slot"(sl, nm, i) |- "CClosureSlot"("st:scope-cell"(), nm, sl) ~> i;
      "CLOSURE-SLOT-FREE". nm:T, sl:T, i:T | "py-slot"(sl, nm, i) |- "CClosureSlot"("st:scope-free"(), nm, sl) ~> i;
      "CLOSURE-SLOT-CLASS". nm:T, sl:T, i:T | "py-slot"(sl, nm, i) |- "CClosureSlot"("st:scope-local"(), nm, sl) ~> i;
      "CLOSURE-SLOT-RENAMED". i:T, nm:T, sl:T |- "CClosureSlot"("c:renamed"("c:cell"(i)), nm, sl) ~> i;
      -- a class's implicit __class__ cell, which its table does not hold (drop_class_free)
      "CLOSURE-SLOT-IMPLICIT". nm:T, sl:T, i:T | "py-slot"(sl, nm, i) |- "CClosureSlot"("py:None"(), nm, sl) ~> i;
      -- decorators: evaluated first, applied innermost first
      "DECORATE-NIL". fv:T, n:T |- "CDecorate"("LNil"(), fv, n) ~> "c:anf"("LNil"(), fv, n);
      "DECORATE-CONS". d:T, ds:T, fv:T, n:T, p1:T, inner:T, n1:T, t:T, n2:T, b:T | "CDecorate"(ds, fv, n) ~> "c:anf"(p1, inner, n1), "CFresh"(n1) ~> "c:fresh"(t, n2), "CSnoc"(p1, "c:assign"("c:tmp"(t), "c:call"(d, "LCons"(inner, "LNil"()), "LNil"()))) ~> b |- "CDecorate"("LCons"(d, ds), fv, n) ~> "c:anf"(b, "c:tmp"(t), n2);
      "RETURN-VALUE". v:T, l:T, c:T, el:T, ec:T, asy:T, gk:T, tb:T, sl:T, lp:T, n:T, f:T, r:T | "py-is-none"(v, f), "CReturnIn"(asy, gk, f, v, l, c, el, ec, "c:cx"("c:function"(asy, gk), tb, sl, lp), n) ~> r |- "CStmt"("py:Return"(v, l, c, el, ec), "c:cx"("c:function"(asy, gk), tb, sl, lp), n) ~> r;
      "RETURN-SYNC". gk:T, f:T, v:T, l:T, c:T, el:T, ec:T, x:T, n:T, r:T | "CReturn"(f, v, x, n) ~> r |- "CReturnIn"("py:False"(), gk, f, v, l, c, el, ec, x, n) ~> r;
      "RETURN-COROUTINE". f:T, v:T, l:T, c:T, el:T, ec:T, x:T, n:T, r:T | "CReturn"(f, v, x, n) ~> r |- "CReturnIn"("py:True"(), "py:False"(), f, v, l, c, el, ec, x, n) ~> r;
      "RETURN-ASYNC-GEN". v:T, l:T, c:T, el:T, ec:T, x:T, n:T, r:T | "CReturn"("py:True"(), v, x, n) ~> r |- "CReturnIn"("py:True"(), "py:True"(), "py:True"(), v, l, c, el, ec, x, n) ~> r;
      "RETURN-ASYNC-GEN-VALUE". v:T, l:T, c:T, el:T, ec:T, x:T, n:T, m:T | "py-core-name"("c:e-return-async-gen"(), m) |- "CReturnIn"("py:True"(), "py:True"(), "py:False"(), v, l, c, el, ec, x, n) ~> "c:st"("c:syntax-error"(m, l, c, el, ec), n);
      "RETURN-IN-MODULE". v:T, l:T, c:T, el:T, ec:T, tb:T, sl:T, lp:T, n:T, m:T | "py-core-name"("c:e-return"(), m) |- "CStmt"("py:Return"(v, l, c, el, ec), "c:cx"("c:module"(), tb, sl, lp), n) ~> "c:st"("c:syntax-error"(m, l, c, el, ec), n);
      "RETURN-IN-CLASS". v:T, l:T, c:T, el:T, ec:T, tb:T, sl:T, lp:T, n:T, m:T | "py-core-name"("c:e-return"(), m) |- "CStmt"("py:Return"(v, l, c, el, ec), "c:cx"("c:class"(), tb, sl, lp), n) ~> "c:st"("c:syntax-error"(m, l, c, el, ec), n);
      "RETURN-NONE". v:T, x:T, n:T, none:T | "py-core-none"(none) |- "CReturn"("py:True"(), v, x, n) ~> "c:st"("c:return"("c:const"(none)), n);
      "RETURN-SOME". v:T, x:T, n:T, pre:T, a:T, n1:T, b:T | "CAtom"(v, x, n) ~> "c:anf"(pre, a, n1), "CSnoc"(pre, "c:return"(a)) ~> b |- "CReturn"("py:False"(), v, x, n) ~> "c:st"("c:seq"(b), n1);

      -- ================================================================ expressions

      -- an expression as an atom: an operation's value goes to a fresh
      -- temporary
      "ATOM". e:T, x:T, n:T, pre:T, op:T, n1:T, r:T | "COp"(e, x, n) ~> "c:anf"(pre, op, n1), "CAtomOf"(op, pre, n1) ~> r |- "CAtom"(e, x, n) ~> r;
      "ATOM-OF-ATOM". a:T, pre:T, n:T |- "CAtomOf"("c:atom"(a), pre, n) ~> "c:anf"(pre, a, n);
      "ATOM-OF-CALL". f:T, xa:T, ks:T, pre:T, n:T, r:T | "CTemp"("c:call"(f, xa, ks), pre, n) ~> r |- "CAtomOf"("c:call"(f, xa, ks), pre, n) ~> r;
      "ATOM-OF-INTRINSIC". i:T, ats:T, pre:T, n:T, r:T | "CTemp"("c:intrinsic"(i, ats), pre, n) ~> r |- "CAtomOf"("c:intrinsic"(i, ats), pre, n) ~> r;
      "ATOM-OF-BUILD-STRING". as0:T, pre:T, n:T, r:T | "CTemp"("c:build-string"(as0), pre, n) ~> r |- "CAtomOf"("c:build-string"(as0), pre, n) ~> r;
      "ATOM-OF-BUILD-TEMPLATE". sa:T, as0:T, pre:T, n:T, r:T | "CTemp"("c:build-template"(sa, as0), pre, n) ~> r |- "CAtomOf"("c:build-template"(sa, as0), pre, n) ~> r;
      "ATOM-OF-BINOP". o:T, a:T, b:T, pre:T, n:T, r:T | "CTemp"("c:binop"(o, a, b), pre, n) ~> r |- "CAtomOf"("c:binop"(o, a, b), pre, n) ~> r;
      "ATOM-OF-INPLACE". o:T, a:T, b:T, pre:T, n:T, r:T | "CTemp"("c:inplace"(o, a, b), pre, n) ~> r |- "CAtomOf"("c:inplace"(o, a, b), pre, n) ~> r;
      "ATOM-OF-UNARY". o:T, a:T, pre:T, n:T, r:T | "CTemp"("c:unary"(o, a), pre, n) ~> r |- "CAtomOf"("c:unary"(o, a), pre, n) ~> r;
      "ATOM-OF-COMPARE". o:T, a:T, b:T, pre:T, n:T, r:T | "CTemp"("c:compare"(o, a, b), pre, n) ~> r |- "CAtomOf"("c:compare"(o, a, b), pre, n) ~> r;
      -- a function's code is a generator function's when its body yields
      "CODE-KIND-FUNCTION". d:T |- "CCodeKind"("py:False"(), "py:False"(), d) ~> "c:function"(d);
      "CODE-KIND-GENERATOR". d:T |- "CCodeKind"("py:False"(), "py:True"(), d) ~> "c:generator"(d);
      "CODE-KIND-COROUTINE". d:T |- "CCodeKind"("py:True"(), "py:False"(), d) ~> "c:coroutine"(d);
      "CODE-KIND-ASYNC-GENERATOR". d:T |- "CCodeKind"("py:True"(), "py:True"(), d) ~> "c:async-generator"(d);
      "FUNCTION-BODY". st:T, sts:T, x:T, n:T, r:T | "CBlock"("LCons"(st, sts), x, n) ~> r |- "CFunctionBody"("LCons"(st, sts), x, n) ~> r;
      -- a generator expression's body: a loop for each generator, the first
      -- over the iterator its parameter .0 holds (no iter() again), its element
      -- yielded innermost
      "FUNCTION-BODY-GENEXP". sp:T, af1:T, tg:T, ifs:T, gs:T, e:T, x:T, n:T, d0:T, it:T, s:T, n1:T | "py-core-name"("c:n-dot0"(), d0), "CName"(d0, x) ~> it, "CLoopFor"(af1, tg, it, ifs, gs, "c:k-yield"(), e, e, "py:None"(), x, n) ~> "c:sts"(s, n1), "py-node-span"(e, sp) |- "CFunctionBody"("c:genexp-body"(af1, tg, ifs, gs, e), x, n) ~> "c:st"("c:at"(sp, "c:seq"(s)), n1);
      "ATOM-OF-FUNCTION". code:T, dflts:T, kwd:T, clo:T, anns:T, pre:T, n:T, r:T | "CTemp"("c:function"(code, dflts, kwd, clo, anns), pre, n) ~> r |- "CAtomOf"("c:function"(code, dflts, kwd, clo, anns), pre, n) ~> r;
      -- atoms held when something runs after them (each default, across the annotations)
      "HOLD-ATOMS-NIL". lt:T, n:T |- "CHoldAtoms"("LNil"(), lt, n) ~> "c:anfs"("LNil"(), "LNil"(), n);
      "HOLD-ATOMS-CONS". a:T, rest:T, lt:T, n:T, p1:T, ha:T, n1:T, p2:T, hs:T, n2:T, b:T | "CHold"(a, "LNil"(), lt, n) ~> "c:anf"(p1, ha, n1), "CHoldAtoms"(rest, lt, n1) ~> "c:anfs"(p2, hs, n2), "CAppend"(p1, p2) ~> b |- "CHoldAtoms"("LCons"(a, rest), lt, n) ~> "c:anfs"(b, "LCons"(ha, hs), n2);
      "HOLD-KWS-NIL". lt:T, n:T |- "CHoldKws"("LNil"(), lt, n) ~> "c:anfs"("LNil"(), "LNil"(), n);
      "HOLD-KWS-CONS". nm:T, a:T, ks:T, lt:T, n:T, p1:T, ha:T, n1:T, p2:T, hs:T, n2:T, b:T | "CHold"(a, "LNil"(), lt, n) ~> "c:anf"(p1, ha, n1), "CHoldKws"(ks, lt, n1) ~> "c:anfs"(p2, hs, n2), "CAppend"(p1, p2) ~> b |- "CHoldKws"("LCons"("c:kw"(nm, a), ks), lt, n) ~> "c:anfs"(b, "LCons"("c:kw"(nm, ha), hs), n2);
      "ATOM-OF-TUPLE". xs:T, pre:T, n:T, r:T | "CTemp"("c:tuple"(xs), pre, n) ~> r |- "CAtomOf"("c:tuple"(xs), pre, n) ~> r;
      "ATOM-OF-LIST". xs:T, pre:T, n:T, r:T | "CTemp"("c:list"(xs), pre, n) ~> r |- "CAtomOf"("c:list"(xs), pre, n) ~> r;
      "ATOM-OF-SET". xs:T, pre:T, n:T, r:T | "CTemp"("c:set"(xs), pre, n) ~> r |- "CAtomOf"("c:set"(xs), pre, n) ~> r;
      "ATOM-OF-DICT". ps:T, pre:T, n:T, r:T | "CTemp"("c:dict"(ps), pre, n) ~> r |- "CAtomOf"("c:dict"(ps), pre, n) ~> r;
      "ATOM-OF-GETITEM". o:T, k:T, pre:T, n:T, r:T | "CTemp"("c:getitem"(o, k), pre, n) ~> r |- "CAtomOf"("c:getitem"(o, k), pre, n) ~> r;
      "ATOM-OF-SLICE". a:T, b:T, st:T, pre:T, n:T, r:T | "CTemp"("c:slice"(a, b, st), pre, n) ~> r |- "CAtomOf"("c:slice"(a, b, st), pre, n) ~> r;
      "ATOM-OF-GETATTR". o:T, at:T, pre:T, n:T, r:T | "CTemp"("c:getattr"(o, at), pre, n) ~> r |- "CAtomOf"("c:getattr"(o, at), pre, n) ~> r;
      "ATOM-OF-LIST-TUPLE". a:T, pre:T, n:T, r:T | "CTemp"("c:list-tuple"(a), pre, n) ~> r |- "CAtomOf"("c:list-tuple"(a), pre, n) ~> r;
      "ATOM-OF-CALL-EX". f:T, a:T, k:T, pre:T, n:T, r:T | "CTemp"("c:call-ex"(f, a, k), pre, n) ~> r |- "CAtomOf"("c:call-ex"(f, a, k), pre, n) ~> r;
      "ATOM-OF-CALL-METHOD". o:T, at:T, xs:T, kws:T, pre:T, n:T, r:T | "CTemp"("c:call-method"(o, at, xs, kws), pre, n) ~> r |- "CAtomOf"("c:call-method"(o, at, xs, kws), pre, n) ~> r;
      "TEMP". op:T, pre:T, n:T, t:T, n1:T, b:T | "CFresh"(n) ~> "c:fresh"(t, n1), "CSnoc"(pre, "c:assign"("c:tmp"(t), op)) ~> b |- "CTemp"(op, pre, n) ~> "c:anf"(b, "c:tmp"(t), n1);

      -- constants and names are atoms
      "CONSTANT". v:T, k:T, l:T, c:T, el:T, ec:T, x:T, n:T, w:T | "py-core-value"(v, w) |- "COp"("py:Constant"(v, k, l, c, el, ec), x, n) ~> "c:anf"("LNil"(), "c:atom"("c:const"(w)), n);
      "NAME-LOAD". t:T, l:T, c:T, el:T, ec:T, x:T, n:T, a:T | "CName"(t, x) ~> a |- "COp"("py:Name"(t, "py:Load"(), l, c, el, ec), x, n) ~> "c:anf"("LNil"(), "c:atom"(a), n);

      -- operators: the operands' atoms, left to right
      "BINOP". a:T, o:T, b:T, l:T, c:T, el:T, ec:T, x:T, n:T, pre:T, x1:T, x2:T, n1:T | "COperands"("LCons"(a, "LCons"(b, "LNil"())), "LNil"(), x, n) ~> "c:anfs"(pre, "LCons"(x1, "LCons"(x2, "LNil"())), n1) |- "COp"("py:BinOp"(a, o, b, l, c, el, ec), x, n) ~> "c:anf"(pre, "c:binop"(o, x1, x2), n1);
      "UNARY". o:T, a:T, l:T, c:T, el:T, ec:T, x:T, n:T, pre:T, x1:T, n1:T | "CAtom"(a, x, n) ~> "c:anf"(pre, x1, n1) |- "COp"("py:UnaryOp"(o, a, l, c, el, ec), x, n) ~> "c:anf"(pre, "c:unary"(o, x1), n1);

      -- a comparison; a chain compares each operand once and stops at the
      -- first false: r = a < b; if r: r = b < c ...
      "COMPARE-ONE". a:T, o:T, b:T, l:T, c:T, el:T, ec:T, x:T, n:T, pre:T, x1:T, x2:T, n1:T, b2:T, w:T, pre2:T | "py-code-warnings"("py:Compare"(a, "LCons"(o, "LNil"()), "LCons"(b, "LNil"()), l, c, el, ec), w), "py-contains-operand"(o, b, b2), "COperands"("LCons"(a, "LCons"(b2, "LNil"())), "LNil"(), x, n) ~> "c:anfs"(pre, "LCons"(x1, "LCons"(x2, "LNil"())), n1), "CAppend"(w, pre) ~> pre2 |- "COp"("py:Compare"(a, "LCons"(o, "LNil"()), "LCons"(b, "LNil"()), l, c, el, ec), x, n) ~> "c:anf"(pre2, "c:compare"(o, x1, x2), n1);
      "COMPARE-CHAIN". a:T, o:T, o2:T, os:T, b:T, b2:T, bs:T, l:T, c:T, el:T, ec:T, x:T, n:T, p1:T, x1:T, n1:T, r:T, n2:T, rest:T, n3:T, pre:T, w:T, pre2:T | "py-code-warnings"("py:Compare"(a, "LCons"(o, "LCons"(o2, os)), "LCons"(b, "LCons"(b2, bs)), l, c, el, ec), w), "CAtom"(a, x, n) ~> "c:anf"(p1, x1, n1), "CFresh"(n1) ~> "c:fresh"(r, n2), "CChain"(x1, "LCons"(o, "LCons"(o2, os)), "LCons"(b, "LCons"(b2, bs)), r, x, n2) ~> "c:st"(rest, n3), "CSnoc"(p1, rest) ~> pre, "CAppend"(w, pre) ~> pre2 |- "COp"("py:Compare"(a, "LCons"(o, "LCons"(o2, os)), "LCons"(b, "LCons"(b2, bs)), l, c, el, ec), x, n) ~> "c:anf"(pre2, "c:atom"("c:tmp"(r)), n3);
      "CHAIN-LAST". left:T, o:T, b:T, r:T, x:T, n:T, p2:T, x2:T, n1:T, ph:T, hl:T, n2:T, q:T, s:T, b2:T | "py-contains-operand"(o, b, b2), "CAtom"(b2, x, n) ~> "c:anf"(p2, x2, n1), "CHold"(left, p2, "LNil"(), n1) ~> "c:anf"(ph, hl, n2), "CAppend"(ph, p2) ~> q, "CSnoc"(q, "c:assign"("c:tmp"(r), "c:compare"(o, hl, x2))) ~> s |- "CChain"(left, "LCons"(o, "LNil"()), "LCons"(b, "LNil"()), r, x, n) ~> "c:st"("c:seq"(s), n2);
      -- a middle operand is read once and compared twice: held in a temporary
      "CHAIN-MORE". left:T, o:T, o2:T, os:T, b:T, b2:T, bs:T, r:T, x:T, n:T, p2:T, x2:T, n1:T, ph:T, hl:T, n2:T, ph2:T, hx:T, n3:T, rest:T, n4:T, q0:T, q1:T, s0:T, s:T | "CAtom"(b, x, n) ~> "c:anf"(p2, x2, n1), "CHold"(left, p2, "LNil"(), n1) ~> "c:anf"(ph, hl, n2), "CHoldAtom"(x2, n2) ~> "c:anf"(ph2, hx, n3), "CChain"(hx, "LCons"(o2, os), "LCons"(b2, bs), r, x, n3) ~> "c:st"(rest, n4), "CAppend"(ph, p2) ~> q0, "CAppend"(q0, ph2) ~> q1, "CSnoc"(q1, "c:assign"("c:tmp"(r), "c:compare"(o, hl, hx))) ~> s0, "CSnoc"(s0, "c:if"("c:tmp"(r), rest, "c:seq"("LNil"()))) ~> s |- "CChain"(left, "LCons"(o, "LCons"(o2, os)), "LCons"(b, "LCons"(b2, bs)), r, x, n) ~> "c:st"("c:seq"(s), n4);

      -- a and b, a or b: the value of the first operand that decides, each
      -- evaluated only when needed
      "BOOLOP". o:T, v:T, vs:T, l:T, c:T, el:T, ec:T, x:T, n:T, p1:T, x1:T, n1:T, r:T, n2:T, rest:T, n3:T, s0:T, pre:T | "CAtom"(v, x, n) ~> "c:anf"(p1, x1, n1), "CFresh"(n1) ~> "c:fresh"(r, n2), "CBoolRest"(o, vs, r, x, n2) ~> "c:st"(rest, n3), "CSnoc"(p1, "c:assign"("c:tmp"(r), "c:atom"(x1))) ~> s0, "CSnoc"(s0, rest) ~> pre |- "COp"("py:BoolOp"(o, "LCons"(v, vs), l, c, el, ec), x, n) ~> "c:anf"(pre, "c:atom"("c:tmp"(r)), n3);
      "BOOL-REST-NIL". o:T, r:T, x:T, n:T |- "CBoolRest"(o, "LNil"(), r, x, n) ~> "c:st"("c:seq"("LNil"()), n);
      "BOOL-REST-AND". v:T, vs:T, r:T, x:T, n:T, p:T, a:T, n1:T, rest:T, n2:T, s0:T, s:T | "CAtom"(v, x, n) ~> "c:anf"(p, a, n1), "CBoolRest"("py:And"(), vs, r, x, n1) ~> "c:st"(rest, n2), "CSnoc"(p, "c:assign"("c:tmp"(r), "c:atom"(a))) ~> s0, "CSnoc"(s0, rest) ~> s |- "CBoolRest"("py:And"(), "LCons"(v, vs), r, x, n) ~> "c:st"("c:if"("c:tmp"(r), "c:seq"(s), "c:seq"("LNil"())), n2);
      "BOOL-REST-OR". v:T, vs:T, r:T, x:T, n:T, p:T, a:T, n1:T, rest:T, n2:T, s0:T, s:T | "CAtom"(v, x, n) ~> "c:anf"(p, a, n1), "CBoolRest"("py:Or"(), vs, r, x, n1) ~> "c:st"(rest, n2), "CSnoc"(p, "c:assign"("c:tmp"(r), "c:atom"(a))) ~> s0, "CSnoc"(s0, rest) ~> s |- "CBoolRest"("py:Or"(), "LCons"(v, vs), r, x, n) ~> "c:st"("c:if"("c:tmp"(r), "c:seq"("LNil"()), "c:seq"(s)), n2);

      -- a if test else b: the test, then only the branch it picks
      "IF-EXP". t:T, a:T, b:T, l:T, c:T, el:T, ec:T, x:T, n:T, pt:T, xt:T, n1:T, r:T, n2:T, pa:T, xa:T, n3:T, pb:T, xb:T, n4:T, sa:T, sb:T, pre:T | "CAtom"(t, x, n) ~> "c:anf"(pt, xt, n1), "CFresh"(n1) ~> "c:fresh"(r, n2), "CAtom"(a, x, n2) ~> "c:anf"(pa, xa, n3), "CAtom"(b, x, n3) ~> "c:anf"(pb, xb, n4), "CSnoc"(pa, "c:assign"("c:tmp"(r), "c:atom"(xa))) ~> sa, "CSnoc"(pb, "c:assign"("c:tmp"(r), "c:atom"(xb))) ~> sb, "CSnoc"(pt, "c:if"(xt, "c:seq"(sa), "c:seq"(sb))) ~> pre |- "COp"("py:IfExp"(t, a, b, l, c, el, ec), x, n) ~> "c:anf"(pre, "c:atom"("c:tmp"(r)), n4);

      -- lambda args: body, a function named <lambda>
      "LAMBDA". args:T, b:T, l:T, c:T, el:T, ec:T, x:T, n:T, nm:T, none:T, p:T, fv:T, n1:T | "py-core-name"("c:n-lambda"(), nm), "py-core-none"(none), "CFunction"(nm, args, "LCons"("py:Return"(b, l, c, el, ec), "LNil"()), "st:pos"(l, c), l, none, x, n) ~> "c:anf"(p, fv, n1) |- "COp"("py:Lambda"(args, b, l, c, el, ec), x, n) ~> "c:anf"(p, "c:atom"(fv), n1);

      -- displays, as CPython builds them (its starunpack): with no starred
      -- element, the elements' atoms left to right and one build; with one,
      -- the elements before it built, then each later element added, or a
      -- starred one's iterable appended, in order; a tuple is that list made
      -- a tuple
      "TUPLE". es:T, cx:T, l:T, c:T, el:T, ec:T, x:T, n:T, its:T, ps:T, r:T | "CSeqItems"(es) ~> its, "CRuns"(its) ~> ps, "CSeqFrom"("c:k-tuple"(), ps, x, n) ~> r |- "COp"("py:Tuple"(es, cx, l, c, el, ec), x, n) ~> r;
      "LIST". es:T, cx:T, l:T, c:T, el:T, ec:T, x:T, n:T, its:T, ps:T, r:T | "CSeqItems"(es) ~> its, "CRuns"(its) ~> ps, "CSeqFrom"("c:k-list"(), ps, x, n) ~> r |- "COp"("py:List"(es, cx, l, c, el, ec), x, n) ~> r;
      -- a set display of more than two constants (after constant folding) is
      -- an empty set updated from the set of those constants, as CPython
      -- compiles it (BUILD_SET 0, LOAD_CONST frozenset, SET_UPDATE)
      "SET". es:T, l:T, c:T, el:T, ec:T, x:T, n:T, d:T, r:T | "py-set-display"(es, d), "CSetDisplay"(d, es, x, n) ~> r |- "COp"("py:Set"(es, l, c, el, ec), x, n) ~> r;
      "SET-DISPLAY". es:T, x:T, n:T, its:T, ps:T, r:T | "CSeqItems"(es) ~> its, "CRuns"(its) ~> ps, "CSeqFrom"("c:k-set"(), ps, x, n) ~> r |- "CSetDisplay"("c:display"(), es, x, n) ~> r;
      -- a set display the optimizer made a constant where the next
      -- instruction iterates it or tests membership in it (py-iter-operand,
      -- py-contains-operand): the frozenset constant itself
      "FOLDED-SET". vs:T, x:T, n:T |- "COp"("c:folded-set"(vs), x, n) ~> "c:anf"("LNil"(), "c:atom"("c:const-set"(vs)), n);
      -- a builtin the compiler names itself (LOAD_COMMON_CONSTANT), whatever
      -- the program binds to its name
      "COMMON-EXPR". tag:T, x:T, n:T |- "COp"("c:common-expr"(tag), x, n) ~> "c:anf"("LNil"(), "c:atom"("c:common"(tag)), n);
      "SET-CONSTANTS". vs:T, es:T, x:T, n:T, t:T, n1:T | "CFresh"(n) ~> "c:fresh"(t, n1) |- "CSetDisplay"("c:constants"(vs), es, x, n) ~> "c:anf"("LCons"("c:assign"("c:tmp"(t), "c:set"("LNil"())), "LCons"("c:do"("c:set-update"("c:tmp"(t), "c:const-set"(vs))), "LNil"())), "c:atom"("c:tmp"(t)), n1);
      "SEQ-FROM-EMPTY". k:T, x:T, n:T, op:T | "CSeqBuild"(k, "LNil"()) ~> op |- "CSeqFrom"(k, "LNil"(), x, n) ~> "c:anf"("LNil"(), op, n);
      "SEQ-FROM-PLAIN". k:T, es:T, x:T, n:T, pre:T, xs:T, n1:T, op:T | "CAtoms"(es, x, n) ~> "c:anfs"(pre, xs, n1), "CSeqBuild"(k, xs) ~> op |- "CSeqFrom"(k, "LCons"("c:run"(es), "LNil"()), x, n) ~> "c:anf"(pre, op, n1);
      "SEQ-FROM-RUN". k:T, es:T, p:T, ps:T, x:T, n:T, kc:T, p1:T, xs:T, n1:T, op0:T, t:T, n2:T, b0:T, p2:T, n3:T, pre:T, op:T | "CContainer"(k) ~> kc, "CAtoms"(es, x, n) ~> "c:anfs"(p1, xs, n1), "CSeqBuild"(kc, xs) ~> op0, "CFresh"(n1) ~> "c:fresh"(t, n2), "CSnoc"(p1, "c:assign"("c:tmp"(t), op0)) ~> b0, "CSeqLater"(kc, "LCons"(p, ps), t, x, n2) ~> "c:sts"(p2, n3), "CAppend"(b0, p2) ~> pre, "CSeqResult"(k, "c:tmp"(t)) ~> op |- "CSeqFrom"(k, "LCons"("c:run"(es), "LCons"(p, ps)), x, n) ~> "c:anf"(pre, op, n3);
      "SEQ-FROM-SPREAD". k:T, v:T, ps:T, x:T, n:T, kc:T, op0:T, t:T, n1:T, p2:T, n2:T, pre:T, op:T | "CContainer"(k) ~> kc, "CSeqBuild"(kc, "LNil"()) ~> op0, "CFresh"(n) ~> "c:fresh"(t, n1), "CSeqLater"(kc, "LCons"("c:spread"(v), ps), t, x, n1) ~> "c:sts"(p2, n2), "CAppend"("LCons"("c:assign"("c:tmp"(t), op0), "LNil"()), p2) ~> pre, "CSeqResult"(k, "c:tmp"(t)) ~> op |- "CSeqFrom"(k, "LCons"("c:spread"(v), ps), x, n) ~> "c:anf"(pre, op, n2);
      "SEQ-LATER-NIL". kc:T, t:T, x:T, n:T |- "CSeqLater"(kc, "LNil"(), t, x, n) ~> "c:sts"("LNil"(), n);
      "SEQ-LATER-RUN". kc:T, es:T, ps:T, t:T, x:T, n:T, p1:T, n1:T, p2:T, n2:T, b:T | "CSeqAdds"(kc, es, t, x, n) ~> "c:sts"(p1, n1), "CSeqLater"(kc, ps, t, x, n1) ~> "c:sts"(p2, n2), "CAppend"(p1, p2) ~> b |- "CSeqLater"(kc, "LCons"("c:run"(es), ps), t, x, n) ~> "c:sts"(b, n2);
      "SEQ-LATER-SPREAD". kc:T, v:T, ps:T, t:T, x:T, n:T, p1:T, a:T, n1:T, op:T, b0:T, p2:T, n2:T, b:T | "CAtom"(v, x, n) ~> "c:anf"(p1, a, n1), "CSeqExtend"(kc, "c:tmp"(t), a) ~> op, "CSnoc"(p1, "c:do"(op)) ~> b0, "CSeqLater"(kc, ps, t, x, n1) ~> "c:sts"(p2, n2), "CAppend"(b0, p2) ~> b |- "CSeqLater"(kc, "LCons"("c:spread"(v), ps), t, x, n) ~> "c:sts"(b, n2);
      "SEQ-ADDS-NIL". kc:T, t:T, x:T, n:T |- "CSeqAdds"(kc, "LNil"(), t, x, n) ~> "c:sts"("LNil"(), n);
      "SEQ-ADDS-CONS". kc:T, e:T, es:T, t:T, x:T, n:T, p1:T, a:T, n1:T, op:T, b0:T, p2:T, n2:T, b:T | "CAtom"(e, x, n) ~> "c:anf"(p1, a, n1), "CSeqAdd"(kc, "c:tmp"(t), a) ~> op, "CSnoc"(p1, "c:do"(op)) ~> b0, "CSeqAdds"(kc, es, t, x, n1) ~> "c:sts"(p2, n2), "CAppend"(b0, p2) ~> b |- "CSeqAdds"(kc, "LCons"(e, es), t, x, n) ~> "c:sts"(b, n2);
      -- the kinds: what holds the elements while they are built, the build,
      -- the result, an iterable's items appended, one element added
      "CONTAINER-TUPLE". |- "CContainer"("c:k-tuple"()) ~> "c:k-list"();
      "CONTAINER-LIST". |- "CContainer"("c:k-list"()) ~> "c:k-list"();
      "CONTAINER-SET". |- "CContainer"("c:k-set"()) ~> "c:k-set"();
      "BUILD-TUPLE". xs:T |- "CSeqBuild"("c:k-tuple"(), xs) ~> "c:tuple"(xs);
      "BUILD-LIST". xs:T |- "CSeqBuild"("c:k-list"(), xs) ~> "c:list"(xs);
      "BUILD-SET". xs:T |- "CSeqBuild"("c:k-set"(), xs) ~> "c:set"(xs);
      "RESULT-TUPLE". a:T |- "CSeqResult"("c:k-tuple"(), a) ~> "c:list-tuple"(a);
      "RESULT-LIST". a:T |- "CSeqResult"("c:k-list"(), a) ~> "c:atom"(a);
      "RESULT-SET". a:T |- "CSeqResult"("c:k-set"(), a) ~> "c:atom"(a);
      "EXTEND-LIST". t:T, a:T |- "CSeqExtend"("c:k-list"(), t, a) ~> "c:list-extend"(t, a);
      "EXTEND-SET". t:T, a:T |- "CSeqExtend"("c:k-set"(), t, a) ~> "c:set-update"(t, a);
      "ADD-LIST". t:T, a:T |- "CSeqAdd"("c:k-list"(), t, a) ~> "c:list-append"(t, a);
      "ADD-SET". t:T, a:T |- "CSeqAdd"("c:k-set"(), t, a) ~> "c:set-add"(t, a);
      -- the elements of a display or a call's positional arguments: each
      -- one (c:one), or a starred one's iterable (c:spread); then the runs
      -- (c:run) of ones between the spreads
      "SEQ-ITEMS-NIL". |- "CSeqItems"("LNil"()) ~> "LNil"();
      "SEQ-ITEMS-CONS". e:T, es:T, b:T, it:T, its:T | "py-is-starred"(e, b), "CSeqItem"(b, e) ~> it, "CSeqItems"(es) ~> its |- "CSeqItems"("LCons"(e, es)) ~> "LCons"(it, its);
      "SEQ-ITEM-STARRED". v:T, cx:T, l:T, c:T, el:T, ec:T |- "CSeqItem"("py:True"(), "py:Starred"(v, cx, l, c, el, ec)) ~> "c:spread"(v);
      "SEQ-ITEM-ONE". e:T |- "CSeqItem"("py:False"(), e) ~> "c:one"(e);
      "RUNS-NIL". |- "CRuns"("LNil"()) ~> "LNil"();
      "RUNS-SPREAD". v:T, rest:T, r:T | "CRuns"(rest) ~> r |- "CRuns"("LCons"("c:spread"(v), rest)) ~> "LCons"("c:spread"(v), r);
      "RUNS-ONE". e:T, rest:T, r:T, r2:T | "CRuns"(rest) ~> r, "CRunPush"(e, r) ~> r2 |- "CRuns"("LCons"("c:one"(e), rest)) ~> r2;
      "RUN-PUSH-NIL". e:T |- "CRunPush"(e, "LNil"()) ~> "LCons"("c:run"("LCons"(e, "LNil"())), "LNil"());
      "RUN-PUSH-RUN". e:T, es:T, ps:T |- "CRunPush"(e, "LCons"("c:run"(es), ps)) ~> "LCons"("c:run"("LCons"(e, es)), ps);
      "RUN-PUSH-SPREAD". e:T, v:T, ps:T |- "CRunPush"(e, "LCons"("c:spread"(v), ps)) ~> "LCons"("c:run"("LCons"(e, "LNil"())), "LCons"("c:spread"(v), ps));
      -- a dict display, as CPython builds it: each key, then its value, left
      -- to right; with a ** item, the pairs before it built, then the
      -- mapping's items put in, and each later run of pairs built and put in
      "DICT". ks:T, vs:T, l:T, c:T, el:T, ec:T, x:T, n:T, its:T, ps:T, r:T | "CDictItems"(ks, vs) ~> its, "CRuns"(its) ~> ps, "CMapFrom"("c:m-update"(), ps, x, n) ~> r |- "COp"("py:Dict"(ks, vs, l, c, el, ec), x, n) ~> r;
      "DICT-ITEMS-NIL". |- "CDictItems"("LNil"(), "LNil"()) ~> "LNil"();
      "DICT-ITEMS-CONS". k:T, ks:T, v:T, vs:T, b:T, it:T, its:T | "py-is-none"(k, b), "CDictItem"(b, k, v) ~> it, "CDictItems"(ks, vs) ~> its |- "CDictItems"("LCons"(k, ks), "LCons"(v, vs)) ~> "LCons"(it, its);
      "DICT-ITEM-SPREAD". k:T, v:T |- "CDictItem"("py:True"(), k, v) ~> "c:spread"(v);
      "DICT-ITEM-ONE". k:T, v:T |- "CDictItem"("py:False"(), k, v) ~> "c:one"("c:kv"(k, v));
      "MAP-FROM-EMPTY". m:T, x:T, n:T |- "CMapFrom"(m, "LNil"(), x, n) ~> "c:anf"("LNil"(), "c:dict"("LNil"()), n);
      "MAP-FROM-PLAIN". m:T, its:T, x:T, n:T, pre:T, xs:T, n1:T | "CPairsOf"(its, x, n) ~> "c:anfs"(pre, xs, n1) |- "CMapFrom"(m, "LCons"("c:run"(its), "LNil"()), x, n) ~> "c:anf"(pre, "c:dict"(xs), n1);
      "MAP-FROM-RUN". m:T, its:T, p:T, ps:T, x:T, n:T, p1:T, xs:T, n1:T, t:T, n2:T, b0:T, p2:T, n3:T, pre:T | "CPairsOf"(its, x, n) ~> "c:anfs"(p1, xs, n1), "CFresh"(n1) ~> "c:fresh"(t, n2), "CSnoc"(p1, "c:assign"("c:tmp"(t), "c:dict"(xs))) ~> b0, "CMapLater"(m, "LCons"(p, ps), t, x, n2) ~> "c:sts"(p2, n3), "CAppend"(b0, p2) ~> pre |- "CMapFrom"(m, "LCons"("c:run"(its), "LCons"(p, ps)), x, n) ~> "c:anf"(pre, "c:atom"("c:tmp"(t)), n3);
      "MAP-FROM-SPREAD". m:T, v:T, ps:T, x:T, n:T, t:T, n1:T, p2:T, n2:T, pre:T | "CFresh"(n) ~> "c:fresh"(t, n1), "CMapLater"(m, "LCons"("c:spread"(v), ps), t, x, n1) ~> "c:sts"(p2, n2), "CAppend"("LCons"("c:assign"("c:tmp"(t), "c:dict"("LNil"())), "LNil"()), p2) ~> pre |- "CMapFrom"(m, "LCons"("c:spread"(v), ps), x, n) ~> "c:anf"(pre, "c:atom"("c:tmp"(t)), n2);
      "MAP-LATER-NIL". m:T, t:T, x:T, n:T |- "CMapLater"(m, "LNil"(), t, x, n) ~> "c:sts"("LNil"(), n);
      "MAP-LATER-RUN". m:T, its:T, ps:T, t:T, x:T, n:T, p1:T, xs:T, n1:T, s:T, n2:T, op:T, b0:T, p2:T, n3:T, b:T | "CPairsOf"(its, x, n) ~> "c:anfs"(p1, xs, n1), "CFresh"(n1) ~> "c:fresh"(s, n2), "CMerge"(m, "c:tmp"(t), "c:tmp"(s)) ~> op, "CAppend"(p1, "LCons"("c:assign"("c:tmp"(s), "c:dict"(xs)), "LCons"("c:do"(op), "LNil"()))) ~> b0, "CMapLater"(m, ps, t, x, n2) ~> "c:sts"(p2, n3), "CAppend"(b0, p2) ~> b |- "CMapLater"(m, "LCons"("c:run"(its), ps), t, x, n) ~> "c:sts"(b, n3);
      "MAP-LATER-SPREAD". m:T, v:T, ps:T, t:T, x:T, n:T, p1:T, a:T, n1:T, op:T, b0:T, p2:T, n2:T, b:T | "CAtom"(v, x, n) ~> "c:anf"(p1, a, n1), "CMerge"(m, "c:tmp"(t), a) ~> op, "CSnoc"(p1, "c:do"(op)) ~> b0, "CMapLater"(m, ps, t, x, n1) ~> "c:sts"(p2, n2), "CAppend"(b0, p2) ~> b |- "CMapLater"(m, "LCons"("c:spread"(v), ps), t, x, n) ~> "c:sts"(b, n2);
      "PAIRS-OF-NIL". x:T, n:T |- "CPairsOf"("LNil"(), x, n) ~> "c:anfs"("LNil"(), "LNil"(), n);
      "PAIRS-OF-KV". k:T, v:T, its:T, x:T, n:T, p3:T, ps:T, n1:T, p2:T, va:T, n2:T, ph2:T, hv:T, n3:T, p1:T, ka:T, n4:T, q2:T, after:T, ph1:T, hk:T, n5:T, q1:T, pre:T | "CPairsOf"(its, x, n) ~> "c:anfs"(p3, ps, n1), "CAtom"(v, x, n1) ~> "c:anf"(p2, va, n2), "CHold"(va, p3, "LNil"(), n2) ~> "c:anf"(ph2, hv, n3), "CAtom"(k, x, n3) ~> "c:anf"(p1, ka, n4), "CAppend"(p2, ph2) ~> q2, "CAppend"(q2, p3) ~> after, "CHold"(ka, after, "LNil"(), n4) ~> "c:anf"(ph1, hk, n5), "CAppend"(p1, ph1) ~> q1, "CAppend"(q1, after) ~> pre |- "CPairsOf"("LCons"("c:kv"(k, v), its), x, n) ~> "c:anfs"(pre, "LCons"("c:pair"(hk, hv), ps), n5);
      "PAIRS-OF-KW". a:T, v:T, its:T, x:T, n:T, p2:T, ps:T, n1:T, p1:T, va:T, n2:T, ph:T, hv:T, n3:T, q:T, pre:T | "CPairsOf"(its, x, n) ~> "c:anfs"(p2, ps, n1), "CAtom"(v, x, n1) ~> "c:anf"(p1, va, n2), "CHold"(va, p2, "LNil"(), n2) ~> "c:anf"(ph, hv, n3), "CAppend"(p1, ph) ~> q, "CAppend"(q, p2) ~> pre |- "CPairsOf"("LCons"("c:kwv"(a, v), its), x, n) ~> "c:anfs"(pre, "LCons"("c:pair"("c:const"(a), hv), ps), n3);
      -- a display's mapping put in (dict.update); a call's keywords merged,
      -- where a repeated one is an error that names the function
      "MERGE-UPDATE". t:T, a:T |- "CMerge"("c:m-update"(), t, a) ~> "c:dict-update"(t, a);
      "MERGE-CALL". f:T, t:T, a:T |- "CMerge"("c:m-merge"(f), t, a) ~> "c:dict-merge"(t, a, f);

      -- obj[key]; a slice: its three parts (None where absent)
      "STARRED-HERE". v:T, cx:T, l:T, c:T, el:T, ec:T, x:T, n:T, m:T, none:T | "py-core-name"("c:e-starred-here"(), m), "py-core-none"(none) |- "COp"("py:Starred"(v, cx, l, c, el, ec), x, n) ~> "c:anf"("LCons"("c:syntax-error"(m, l, c, el, ec), "LNil"()), "c:atom"("c:const"(none)), n);
      "SUBSCRIPT". v:T, sl:T, l:T, c:T, el:T, ec:T, x:T, n:T, pre:T, xo:T, xk:T, n1:T, w:T, pre2:T | "py-code-warnings"("py:Subscript"(v, sl, "py:Load"(), l, c, el, ec), w), "COperands"("LCons"(v, "LCons"(sl, "LNil"())), "LNil"(), x, n) ~> "c:anfs"(pre, "LCons"(xo, "LCons"(xk, "LNil"())), n1), "CAppend"(w, pre) ~> pre2 |- "COp"("py:Subscript"(v, sl, "py:Load"(), l, c, el, ec), x, n) ~> "c:anf"(pre2, "c:getitem"(xo, xk), n1);
      "SLICE". a:T, b:T, st:T, l:T, c:T, el:T, ec:T, x:T, n:T, pre:T, xa:T, xb:T, xs:T, n1:T | "COptOperands"("LCons"(a, "LCons"(b, "LCons"(st, "LNil"()))), "LNil"(), x, n) ~> "c:anfs"(pre, "LCons"(xa, "LCons"(xb, "LCons"(xs, "LNil"()))), n1) |- "COp"("py:Slice"(a, b, st, l, c, el, ec), x, n) ~> "c:anf"(pre, "c:slice"(xa, xb, xs), n1);
      "OPT-ATOM". e:T, x:T, n:T, f:T, r:T | "py-is-none"(e, f), "COptAtomIf"(f, e, x, n) ~> r |- "COptAtom"(e, x, n) ~> r;
      "OPT-ATOM-NONE". e:T, x:T, n:T, none:T | "py-core-none"(none) |- "COptAtomIf"("py:True"(), e, x, n) ~> "c:anf"("LNil"(), "c:const"(none), n);
      "OPT-ATOM-SOME". e:T, x:T, n:T, r:T | "CAtom"(e, x, n) ~> r |- "COptAtomIf"("py:False"(), e, x, n) ~> r;

      -- obj.attr
      "ATTRIBUTE". v:T, at:T, l:T, c:T, el:T, ec:T, x:T, n:T, pre:T, xo:T, n1:T, mg:T | "CMangle"(at, x) ~> mg, "CAtom"(v, x, n) ~> "c:anf"(pre, xo, n1) |- "COp"("py:Attribute"(v, at, "py:Load"(), l, c, el, ec), x, n) ~> "c:anf"(pre, "c:getattr"(xo, mg), n1);
      -- keyword arguments: (c:kw NAME ATOM), in order, their values operands
      "KEYWORDS". ks:T, x:T, n:T, r:T | "CKwOperands"(ks, "LNil"(), x, n) ~> r |- "CKeywords"(ks, x, n) ~> r;
      "KW-OPERANDS-NIL". lt:T, x:T, n:T |- "CKwOperands"("LNil"(), lt, x, n) ~> "c:anfs"("LNil"(), "LNil"(), n);
      "KW-OPERANDS-CONS". nm:T, v:T, l:T, c:T, el:T, ec:T, rest:T, lt:T, x:T, n:T, p2:T, kws:T, n1:T, p1:T, a:T, n2:T, ph:T, ha:T, n3:T, q:T, pre:T | "CKwOperands"(rest, lt, x, n) ~> "c:anfs"(p2, kws, n1), "CAtom"(v, x, n1) ~> "c:anf"(p1, a, n2), "CHold"(a, p2, lt, n2) ~> "c:anf"(ph, ha, n3), "CAppend"(p1, ph) ~> q, "CAppend"(q, p2) ~> pre |- "CKwOperands"("LCons"("py:keyword"(nm, v, l, c, el, ec), rest), lt, x, n) ~> "c:anfs"(pre, "LCons"("c:kw"(nm, ha), kws), n3);

      -- a call, as CPython compiles it: with a starred argument or a **
      -- keyword, through one sequence and one dict (CALL_FUNCTION_EX); else a
      -- method call when the callee is obj.name; else a plain call.  The
      -- function's atom, then each argument's, then each keyword's, in order
      "CALL". f:T, xa:T, ks:T, l:T, c:T, el:T, ec:T, x:T, n:T, s:T, p:T, a:T, n1:T, w:T, p2:T | "py-code-warnings"("py:Call"(f, xa, ks, l, c, el, ec), w), "py-call-shape"(f, xa, ks, s), "CCall"(s, f, xa, ks, x, n) ~> "c:anf"(p, a, n1), "CAppend"(w, p) ~> p2 |- "COp"("py:Call"(f, xa, ks, l, c, el, ec), x, n) ~> "c:anf"(p2, a, n1);
      "CALL-FUNCTION". f:T, xa:T, ks:T, x:T, n:T, p3:T, kws:T, n1:T, p2:T, xf:T, xs:T, n2:T, pre:T | "CKeywords"(ks, x, n) ~> "c:anfs"(p3, kws, n1), "COperands"("LCons"(f, xa), p3, x, n1) ~> "c:anfs"(p2, "LCons"(xf, xs), n2), "CAppend"(p2, p3) ~> pre |- "CCall"("c:shape-function"(), f, xa, ks, x, n) ~> "c:anf"(pre, "c:call"(xf, xs, kws), n2);
      -- obj.name(args): the method looked up and called at once
      "CALL-METHOD". v:T, at:T, cx:T, al:T, ac:T, ael:T, aec:T, xa:T, ks:T, x:T, n:T, p3:T, kws:T, n1:T, p2:T, xs:T, n2:T, pa:T, r:T | "CKeywords"(ks, x, n) ~> "c:anfs"(p3, kws, n1), "COperands"(xa, p3, x, n1) ~> "c:anfs"(p2, xs, n2), "CAppend"(p2, p3) ~> pa, "CMethodCall"(pa, v, at, xs, kws, x, n2) ~> r |- "CCall"("c:shape-method"(), "py:Attribute"(v, at, cx, al, ac, ael, aec), xa, ks, x, n) ~> r;
      -- nothing runs between the method's lookup and the call: one operation
      "METHOD-CALL-FUSED". v:T, at:T, xs:T, kws:T, x:T, n:T, p1:T, xo:T, n1:T, mg:T | "CMangle"(at, x) ~> mg, "CAtom"(v, x, n) ~> "c:anf"(p1, xo, n1) |- "CMethodCall"("LNil"(), v, at, xs, kws, x, n) ~> "c:anf"(p1, "c:call-method"(xo, mg, xs, kws), n1);
      -- the arguments run code: the method is looked up first, where CPython
      -- looks it up, and the bound method called
      "METHOD-CALL-BOUND". s:T, ss:T, v:T, at:T, xs:T, kws:T, x:T, n:T, p1:T, xo:T, n1:T, t:T, n2:T, b0:T, pre:T, mg:T | "CMangle"(at, x) ~> mg, "CAtom"(v, x, n) ~> "c:anf"(p1, xo, n1), "CFresh"(n1) ~> "c:fresh"(t, n2), "CSnoc"(p1, "c:assign"("c:tmp"(t), "c:getattr"(xo, mg))) ~> b0, "CAppend"(b0, "LCons"(s, ss)) ~> pre |- "CMethodCall"("LCons"(s, ss), v, at, xs, kws, x, n) ~> "c:anf"(pre, "c:call"("c:tmp"(t), xs, kws), n2);
      -- f(*args, **kwargs): the positional arguments as one sequence (a lone
      -- starred one's value as it is), the keywords as one dict
      "CALL-EX". f:T, xa:T, ks:T, x:T, n:T, p1:T, xf0:T, n1:T, ph:T, xf:T, n2:T, its:T, ps:T, p2:T, xs0:T, n3:T, p3:T, xk:T, n4:T, ph2:T, xs:T, n5:T, q0:T, q1:T, q2:T, pre:T | "CAtom"(f, x, n) ~> "c:anf"(p1, xf0, n1), "CHoldAtom"(xf0, n1) ~> "c:anf"(ph, xf, n2), "CSeqItems"(xa) ~> its, "CRuns"(its) ~> ps, "CExArgs"(ps, x, n2) ~> "c:anf"(p2, xs0, n3), "CExKeywords"(ks, xf, x, n3) ~> "c:anf"(p3, xk, n4), "CHold"(xs0, "LNil"(), p3, n4) ~> "c:anf"(ph2, xs, n5), "CAppend"(p1, ph) ~> q0, "CAppend"(q0, p2) ~> q1, "CAppend"(q1, ph2) ~> q2, "CAppend"(q2, p3) ~> pre |- "CCall"("c:shape-ex"(), f, xa, ks, x, n) ~> "c:anf"(pre, "c:call-ex"(xf, xs, xk), n5);
      "EX-ARGS-LONE". v:T, x:T, n:T, r:T | "CAtom"(v, x, n) ~> r |- "CExArgs"("LCons"("c:spread"(v), "LNil"()), x, n) ~> r;
      "EX-ARGS-NONE". x:T, n:T, p:T, op:T, n1:T, r:T | "CSeqFrom"("c:k-tuple"(), "LNil"(), x, n) ~> "c:anf"(p, op, n1), "CAtomOf"(op, p, n1) ~> r |- "CExArgs"("LNil"(), x, n) ~> r;
      "EX-ARGS-RUN". es:T, ps:T, x:T, n:T, p:T, op:T, n1:T, r:T | "CSeqFrom"("c:k-tuple"(), "LCons"("c:run"(es), ps), x, n) ~> "c:anf"(p, op, n1), "CAtomOf"(op, p, n1) ~> r |- "CExArgs"("LCons"("c:run"(es), ps), x, n) ~> r;
      "EX-ARGS-SPREADS". v:T, q:T, ps:T, x:T, n:T, p:T, op:T, n1:T, r:T | "CSeqFrom"("c:k-tuple"(), "LCons"("c:spread"(v), "LCons"(q, ps)), x, n) ~> "c:anf"(p, op, n1), "CAtomOf"(op, p, n1) ~> r |- "CExArgs"("LCons"("c:spread"(v), "LCons"(q, ps)), x, n) ~> r;
      "EX-KEYWORDS-NONE". f:T, x:T, n:T |- "CExKeywords"("LNil"(), f, x, n) ~> "c:anf"("LNil"(), "c:no-kw"(), n);
      "EX-KEYWORDS". k:T, ks:T, f:T, x:T, n:T, its:T, ps:T, p1:T, op:T, n1:T, r:T | "CKwItems"("LCons"(k, ks)) ~> its, "CRuns"(its) ~> ps, "CMapFrom"("c:m-merge"(f), ps, x, n) ~> "c:anf"(p1, op, n1), "CAtomOf"(op, p1, n1) ~> r |- "CExKeywords"("LCons"(k, ks), f, x, n) ~> r;
      "KW-ITEMS-NIL". |- "CKwItems"("LNil"()) ~> "LNil"();
      "KW-ITEMS-CONS". a:T, v:T, l:T, c:T, el:T, ec:T, ks:T, b:T, it:T, its:T | "py-is-none"(a, b), "CKwItem"(b, a, v) ~> it, "CKwItems"(ks) ~> its |- "CKwItems"("LCons"("py:keyword"(a, v, l, c, el, ec), ks)) ~> "LCons"(it, its);
      "KW-ITEM-SPREAD". a:T, v:T |- "CKwItem"("py:True"(), a, v) ~> "c:spread"(v);
      "KW-ITEM-ONE". a:T, v:T |- "CKwItem"("py:False"(), a, v) ~> "c:one"("c:kwv"(a, v));
      -- operands, left to right, in A-normal form over mutable variables: a
      -- name is read where it stands, so it stays an atom only when nothing
      -- runs between it and the operation that reads it; else it is read into a
      -- temporary first.  The rest is converted first, to know what follows
      "ATOMS". es:T, x:T, n:T, r:T | "COperands"(es, "LNil"(), x, n) ~> r |- "CAtoms"(es, x, n) ~> r;
      "OPERANDS-NIL". lt:T, x:T, n:T |- "COperands"("LNil"(), lt, x, n) ~> "c:anfs"("LNil"(), "LNil"(), n);
      "OPERANDS-CONS". e:T, es:T, lt:T, x:T, n:T, p2:T, xs:T, n1:T, p1:T, a:T, n2:T, ph:T, ha:T, n3:T, q:T, pre:T | "COperands"(es, lt, x, n) ~> "c:anfs"(p2, xs, n1), "CAtom"(e, x, n1) ~> "c:anf"(p1, a, n2), "CHold"(a, p2, lt, n2) ~> "c:anf"(ph, ha, n3), "CAppend"(p1, ph) ~> q, "CAppend"(q, p2) ~> pre |- "COperands"("LCons"(e, es), lt, x, n) ~> "c:anfs"(pre, "LCons"(ha, xs), n3);
      "OPT-OPERANDS-NIL". lt:T, x:T, n:T |- "COptOperands"("LNil"(), lt, x, n) ~> "c:anfs"("LNil"(), "LNil"(), n);
      "OPT-OPERANDS-CONS". e:T, es:T, lt:T, x:T, n:T, p2:T, xs:T, n1:T, p1:T, a:T, n2:T, ph:T, ha:T, n3:T, q:T, pre:T | "COptOperands"(es, lt, x, n) ~> "c:anfs"(p2, xs, n1), "COptAtom"(e, x, n1) ~> "c:anf"(p1, a, n2), "CHold"(a, p2, lt, n2) ~> "c:anf"(ph, ha, n3), "CAppend"(p1, ph) ~> q, "CAppend"(q, p2) ~> pre |- "COptOperands"("LCons"(e, es), lt, x, n) ~> "c:anfs"(pre, "LCons"(ha, xs), n3);
      "HOLD-REST". a:T, s:T, ss:T, lt:T, n:T, r:T | "CHoldAtom"(a, n) ~> r |- "CHold"(a, "LCons"(s, ss), lt, n) ~> r;
      "HOLD-LATER". a:T, lt:T, n:T, r:T | "CHoldIf"(a, lt, n) ~> r |- "CHold"(a, "LNil"(), lt, n) ~> r;
      "HOLD-IF-NOTHING". a:T, n:T |- "CHoldIf"(a, "LNil"(), n) ~> "c:anf"("LNil"(), a, n);
      "HOLD-IF-SOMETHING". a:T, s:T, ss:T, n:T, r:T | "CHoldAtom"(a, n) ~> r |- "CHoldIf"(a, "LCons"(s, ss), n) ~> r;
      -- a name's value read into a temporary; a constant or a temporary stays
      "HOLD-LOCAL". i:T, n:T, t:T, n1:T | "CFresh"(n) ~> "c:fresh"(t, n1) |- "CHoldAtom"("c:local"(i), n) ~> "c:anf"("LCons"("c:assign"("c:tmp"(t), "c:atom"("c:local"(i))), "LNil"()), "c:tmp"(t), n1);
      "HOLD-CELL". i:T, n:T, t:T, n1:T | "CFresh"(n) ~> "c:fresh"(t, n1) |- "CHoldAtom"("c:cell"(i), n) ~> "c:anf"("LCons"("c:assign"("c:tmp"(t), "c:atom"("c:cell"(i))), "LNil"()), "c:tmp"(t), n1);
      "HOLD-GLOBAL". g:T, n:T, t:T, n1:T | "CFresh"(n) ~> "c:fresh"(t, n1) |- "CHoldAtom"("c:global"(g), n) ~> "c:anf"("LCons"("c:assign"("c:tmp"(t), "c:atom"("c:global"(g))), "LNil"()), "c:tmp"(t), n1);
      "HOLD-NAME". g:T, n:T, t:T, n1:T | "CFresh"(n) ~> "c:fresh"(t, n1) |- "CHoldAtom"("c:name"(g), n) ~> "c:anf"("LCons"("c:assign"("c:tmp"(t), "c:atom"("c:name"(g))), "LNil"()), "c:tmp"(t), n1);
      "HOLD-DICT-OR-CELL". i:T, g:T, n:T, t:T, n1:T | "CFresh"(n) ~> "c:fresh"(t, n1) |- "CHoldAtom"("c:dict-or-cell"(i, g), n) ~> "c:anf"("LCons"("c:assign"("c:tmp"(t), "c:atom"("c:dict-or-cell"(i, g))), "LNil"()), "c:tmp"(t), n1);
      "HOLD-DICT-OR-GLOBAL". i:T, g:T, n:T, t:T, n1:T | "CFresh"(n) ~> "c:fresh"(t, n1) |- "CHoldAtom"("c:dict-or-global"(i, g), n) ~> "c:anf"("LCons"("c:assign"("c:tmp"(t), "c:atom"("c:dict-or-global"(i, g))), "LNil"()), "c:tmp"(t), n1);
      "HOLD-CONST". v:T, n:T |- "CHoldAtom"("c:const"(v), n) ~> "c:anf"("LNil"(), "c:const"(v), n);
      "HOLD-COMMON". g:T, n:T |- "CHoldAtom"("c:common"(g), n) ~> "c:anf"("LNil"(), "c:common"(g), n);
      "HOLD-CONST-SET". vs:T, n:T |- "CHoldAtom"("c:const-set"(vs), n) ~> "c:anf"("LNil"(), "c:const-set"(vs), n);
      "HOLD-TMP". i:T, n:T |- "CHoldAtom"("c:tmp"(i), n) ~> "c:anf"("LNil"(), "c:tmp"(i), n);

      -- ================================================================ names, slots, tables

      -- where a name lives (compiler_nameop)
      "NAME". t:T, k:T, q:T, sl:T, lp:T, s:T, r:T, tk:T, tn:T, tp:T, syms:T, tabs:T, none:T, m:T, pv:T | "py-core-none"(none), "py-maybe-mangle"(pv, none, t, m), "py-lookup-scope"(syms, m, s), "CNameIn"(k, s, m, sl) ~> r |- "CName"(t, "c:cx"(k, "c:tq"("st:table"(tk, tn, tp, syms, tabs), q, pv), sl, lp)) ~> r;
      -- a context's names: its table, its qualname prefix and its private name,
      -- the innermost class's name, by which names and attribute names are
      -- mangled (the compiler's u_private, _Py_Mangle)
      "MANGLE". t:T, k:T, tb:T, q:T, pv:T, sl:T, lp:T, none:T, m:T | "py-core-none"(none), "py-maybe-mangle"(pv, none, t, m) |- "CMangle"(t, "c:cx"(k, "c:tq"(tb, q, pv), sl, lp)) ~> m;
      -- in an inlined comprehension: its own names are its temporaries; any
      -- other name is resolved as its block resolves it
      "NAME-RENAMED". k:T, a:T, t:T, sl:T |- "CNameIn"(k, "c:renamed"(a), t, sl) ~> a;
      "NAME-COMP-LOCAL". k:T, t:T, sl:T, r:T | "CNameIn"(k, "st:scope-local"(), t, sl) ~> r |- "CNameIn"("c:comp"(k), "st:scope-local"(), t, sl) ~> r;
      "NAME-COMP-CELL". k:T, t:T, sl:T, r:T | "CNameIn"(k, "st:scope-cell"(), t, sl) ~> r |- "CNameIn"("c:comp"(k), "st:scope-cell"(), t, sl) ~> r;
      "NAME-COMP-FREE". k:T, t:T, sl:T, r:T | "CNameIn"(k, "st:scope-free"(), t, sl) ~> r |- "CNameIn"("c:comp"(k), "st:scope-free"(), t, sl) ~> r;
      "NAME-COMP-GLOBAL-IMPLICIT". k:T, t:T, sl:T, r:T | "CNameIn"(k, "st:scope-global-implicit"(), t, sl) ~> r |- "CNameIn"("c:comp"(k), "st:scope-global-implicit"(), t, sl) ~> r;
      "NAME-COMP-GLOBAL-EXPLICIT". k:T, t:T, sl:T, r:T | "CNameIn"(k, "st:scope-global-explicit"(), t, sl) ~> r |- "CNameIn"("c:comp"(k), "st:scope-global-explicit"(), t, sl) ~> r;
      "NAME-FUNCTION-LOCAL". gk:T, asy:T, t:T, sl:T, i:T | "py-slot"(sl, t, i) |- "CNameIn"("c:function"(asy, gk), "st:scope-local"(), t, sl) ~> "c:local"(i);
      "NAME-FUNCTION-CELL". gk:T, asy:T, t:T, sl:T, i:T | "py-slot"(sl, t, i) |- "CNameIn"("c:function"(asy, gk), "st:scope-cell"(), t, sl) ~> "c:cell"(i);
      "NAME-FUNCTION-FREE". gk:T, asy:T, t:T, sl:T, i:T | "py-slot"(sl, t, i) |- "CNameIn"("c:function"(asy, gk), "st:scope-free"(), t, sl) ~> "c:cell"(i);
      "NAME-FUNCTION-GLOBAL-IMPLICIT". gk:T, asy:T, t:T, sl:T, cs:T, a:T | "py-classdict-slot"(sl, cs), "CGlobalImplicit"(cs, t) ~> a |- "CNameIn"("c:function"(asy, gk), "st:scope-global-implicit"(), t, sl) ~> a;
      -- a scope that sees a class reads an implicit global from the class's
      -- namespace first (LOAD_FROM_DICT_OR_GLOBALS through __classdict__)
      "GLOBAL-IMPLICIT". t:T |- "CGlobalImplicit"("c:no-cell"(), t) ~> "c:global"(t);
      "GLOBAL-IMPLICIT-CLASSDICT". i:T, t:T |- "CGlobalImplicit"("c:cell"(i), t) ~> "c:dict-or-global"(i, t);
      "NAME-FUNCTION-GLOBAL-EXPLICIT". gk:T, asy:T, t:T, sl:T |- "CNameIn"("c:function"(asy, gk), "st:scope-global-explicit"(), t, sl) ~> "c:global"(t);
      "NAME-MODULE-LOCAL". t:T, sl:T |- "CNameIn"("c:module"(), "st:scope-local"(), t, sl) ~> "c:name"(t);
      -- a class body's names live in its namespace (LOAD_NAME, STORE_NAME); a
      -- free name is looked for there first, then in its cell
      -- (LOAD_FROM_DICT_OR_DEREF)
      "NAME-CLASS-LOCAL". t:T, sl:T |- "CNameIn"("c:class"(), "st:scope-local"(), t, sl) ~> "c:name"(t);
      "NAME-CLASS-GLOBAL-IMPLICIT". t:T, sl:T |- "CNameIn"("c:class"(), "st:scope-global-implicit"(), t, sl) ~> "c:name"(t);
      "NAME-CLASS-GLOBAL-EXPLICIT". t:T, sl:T |- "CNameIn"("c:class"(), "st:scope-global-explicit"(), t, sl) ~> "c:global"(t);
      "NAME-CLASS-FREE". t:T, sl:T, i:T | "py-slot"(sl, t, i) |- "CNameIn"("c:class"(), "st:scope-free"(), t, sl) ~> "c:dict-or-cell"(i, t);
      "NAME-MODULE-GLOBAL-IMPLICIT". t:T, sl:T |- "CNameIn"("c:module"(), "st:scope-global-implicit"(), t, sl) ~> "c:name"(t);
      "NAME-MODULE-GLOBAL-EXPLICIT". t:T, sl:T |- "CNameIn"("c:module"(), "st:scope-global-explicit"(), t, sl) ~> "c:global"(t);


      -- the table of a block that stands at POS
      "CHILD". pv:T, k:T, n:T, p:T, syms:T, tabs:T, q:T, ck:T, pos:T, t:T | "py-child-table"(tabs, ck, pos, t) |- "CChild"("c:tq"("st:table"(k, n, p, syms, tabs), q, pv), ck, pos) ~> t;

      -- a fresh slot (a temporary or a label)
      "FRESH". n:T, one:T, n1:T | "py-const"("py:one"(), one), "py-add"(n, one, n1) |- "CFresh"(n) ~> "c:fresh"(n, n1);
    }
  }
  theory Desugar()
}
