      -- IMPORT_NAME with the names as the fromlist and the level, then each
      -- name taken (IMPORT_FROM) and bound, or * (IMPORT_STAR)
      "IMPORT-FROM". mod:T, as0:T, lv:T, l:T, c:T, el:T, ec:T, x:T, n:T, mn:T, fl:T, ps:T, t:T, n1:T, s:T, n2:T, lz:T, md:T | "py-import-mode"(lz, md), "py-import-module-name"(mod, mn), "py-import-from-parts"(as0, "c:from-parts"(fl, ps)), "CFresh"(n) ~> "c:fresh"(t, n1), "CImportFroms"(ps, t, x, n1) ~> "c:sts"(s, n2) |- "CStmt"("py:ImportFrom"(mod, as0, lv, lz, l, c, el, ec), x, n) ~> "c:st"("c:seq"("LCons"("c:assign"("c:tmp"(t), "c:import"("c:const"(mn), "c:const"(fl), "c:const"(lv), md)), s)), n2);
      "IMPORT-FROMS-NIL". t:T, x:T, n:T |- "CImportFroms"("LNil"(), t, x, n) ~> "c:sts"("LNil"(), n);
      "IMPORT-FROMS-NAME". nm:T, bn:T, rest:T, t:T, x:T, n:T, tg:T, s:T, n1:T | "CName"(bn, x) ~> tg, "CImportFroms"(rest, t, x, n) ~> "c:sts"(s, n1) |- "CImportFroms"("LCons"("c:from"(nm, bn), rest), t, x, n) ~> "c:sts"("LCons"("c:assign"(tg, "c:import-from"("c:tmp"(t), "c:const"(nm))), s), n1);
      "IMPORT-FROMS-STAR". rest:T, t:T, x:T, n:T, s:T, n1:T | "CImportFroms"(rest, t, x, n) ~> "c:sts"(s, n1) |- "CImportFroms"("LCons"("c:star"(), rest), t, x, n) ~> "c:sts"("LCons"("c:do"("c:import-star"("c:tmp"(t))), s), n1);

      -- ================================================================ f-strings

      -- f"...": each part in turn (compiler_joined_str): a constant as it is;
      -- a replacement field's value, then its conversion (str, repr or ascii)
      -- at once, then its format spec (itself an f-string) evaluated, then the
      -- value formatted (FORMAT_SIMPLE, FORMAT_WITH_SPEC); the parts joined
      "JOINED-STR". vs:T, l:T, c:T, el:T, ec:T, x:T, n:T, p:T, as0:T, n1:T | "CFParts"(vs, x, n) ~> "c:anfs"(p, as0, n1) |- "COp"("py:JoinedStr"(vs, l, c, el, ec), x, n) ~> "c:anf"(p, "c:build-string"(as0), n1);
      "F-PARTS-NIL". x:T, n:T |- "CFParts"("LNil"(), x, n) ~> "c:anfs"("LNil"(), "LNil"(), n);
      "F-PARTS-CONS". v:T, vs:T, x:T, n:T, p1:T, a:T, n1:T, p2:T, rest:T, n2:T, b:T | "CFPart"(v, x, n) ~> "c:anf"(p1, a, n1), "CFParts"(vs, x, n1) ~> "c:anfs"(p2, rest, n2), "CAppend"(p1, p2) ~> b |- "CFParts"("LCons"(v, vs), x, n) ~> "c:anfs"(b, "LCons"(a, rest), n2);
      "F-PART-CONSTANT". v:T, k:T, l:T, c:T, el:T, ec:T, x:T, n:T |- "CFPart"("py:Constant"(v, k, l, c, el, ec), x, n) ~> "c:anf"("LNil"(), "c:const"(v), n);
      "F-PART-FIELD". v:T, cv:T, spec:T, l:T, c:T, el:T, ec:T, x:T, n:T, p1:T, a:T, n1:T, k:T, p2:T, a2:T, n2:T, sb:T, p3:T, sa:T, n3:T, ph:T, a3:T, n4:T, t:T, n5:T, b0:T, b1:T, b2:T, b:T | "CAtom"(v, x, n) ~> "c:anf"(p1, a, n1), "py-conversion-kind"(cv, k), "CConvert"(k, a, n1) ~> "c:anf"(p2, a2, n2), "py-is-none"(spec, sb), "CFSpec"(sb, spec, x, n2) ~> "c:anf"(p3, sa, n3), "CHold"(a2, p3, "LNil"(), n3) ~> "c:anf"(ph, a3, n4), "CFresh"(n4) ~> "c:fresh"(t, n5), "CAppend"(p1, p2) ~> b0, "CAppend"(b0, ph) ~> b1, "CAppend"(b1, p3) ~> b2, "CSnoc"(b2, "c:assign"("c:tmp"(t), "c:format"(a3, sa))) ~> b |- "CFPart"("py:FormattedValue"(v, cv, spec, l, c, el, ec), x, n) ~> "c:anf"(b, "c:tmp"(t), n5);
      "CONVERT-NONE". a:T, n:T |- "CConvert"("c:conv-none"(), a, n) ~> "c:anf"("LNil"(), a, n);
      "CONVERT-STR". a:T, n:T, t:T, n1:T | "CFresh"(n) ~> "c:fresh"(t, n1) |- "CConvert"("c:conv-str"(), a, n) ~> "c:anf"("LCons"("c:assign"("c:tmp"(t), "c:convert"("c:conv-str"(), a)), "LNil"()), "c:tmp"(t), n1);
      "CONVERT-REPR". a:T, n:T, t:T, n1:T | "CFresh"(n) ~> "c:fresh"(t, n1) |- "CConvert"("c:conv-repr"(), a, n) ~> "c:anf"("LCons"("c:assign"("c:tmp"(t), "c:convert"("c:conv-repr"(), a)), "LNil"()), "c:tmp"(t), n1);
      "CONVERT-ASCII". a:T, n:T, t:T, n1:T | "CFresh"(n) ~> "c:fresh"(t, n1) |- "CConvert"("c:conv-ascii"(), a, n) ~> "c:anf"("LCons"("c:assign"("c:tmp"(t), "c:convert"("c:conv-ascii"(), a)), "LNil"()), "c:tmp"(t), n1);
      "F-SPEC-NONE". spec:T, x:T, n:T, e0:T | "py-core-name"("c:n-empty"(), e0) |- "CFSpec"("py:True"(), spec, x, n) ~> "c:anf"("LNil"(), "c:const"(e0), n);
      "F-SPEC". spec:T, x:T, n:T, r:T | "CAtom"(spec, x, n) ~> r |- "CFSpec"("py:False"(), spec, x, n) ~> r;

      -- ================================================================ template strings

      -- t"..." (PEP 750) as codegen_template_str: its strings one constant
      -- tuple (an empty string before an interpolation that begins it or
      -- follows another, and at its end after one); its interpolations in turn
      -- (codegen_interpolation): the value, then the format spec (an f-string)
      -- evaluated, made an interpolation with the expression's text and the
      -- conversion, the value itself unconverted (BUILD_INTERPOLATION); then
      -- the template of the two tuples (BUILD_TEMPLATE)
      "TEMPLATE-STR". vs:T, l:T, c:T, el:T, ec:T, x:T, n:T, ss:T, p:T, as0:T, n1:T | "py-template-strings"(vs, ss), "CTParts"(vs, x, n) ~> "c:anfs"(p, as0, n1) |- "COp"("py:TemplateStr"(vs, l, c, el, ec), x, n) ~> "c:anf"(p, "c:build-template"("c:const"(ss), as0), n1);
      "T-PARTS-NIL". x:T, n:T |- "CTParts"("LNil"(), x, n) ~> "c:anfs"("LNil"(), "LNil"(), n);
      "T-PARTS-CONSTANT". v:T, k:T, l:T, c:T, el:T, ec:T, vs:T, x:T, n:T, r:T | "CTParts"(vs, x, n) ~> r |- "CTParts"("LCons"("py:Constant"(v, k, l, c, el, ec), vs), x, n) ~> r;
      "T-PARTS-INTERPOLATION". v:T, s:T, cv:T, spec:T, l:T, c:T, el:T, ec:T, vs:T, x:T, n:T, p1:T, a:T, n1:T, p2:T, rest:T, n2:T, b:T | "CTInterpolation"(v, s, cv, spec, x, n) ~> "c:anf"(p1, a, n1), "CTParts"(vs, x, n1) ~> "c:anfs"(p2, rest, n2), "CAppend"(p1, p2) ~> b |- "CTParts"("LCons"("py:Interpolation"(v, s, cv, spec, l, c, el, ec), vs), x, n) ~> "c:anfs"(b, "LCons"(a, rest), n2);
      -- the value held across the format spec's code, which may rebind it
      "T-INTERPOLATION". v:T, s:T, cv:T, spec:T, x:T, n:T, p1:T, a:T, n1:T, k:T, sb:T, p3:T, sa:T, n3:T, ph:T, a3:T, n4:T, t:T, n5:T, b0:T, b1:T, b:T | "CAtom"(v, x, n) ~> "c:anf"(p1, a, n1), "py-conversion-kind"(cv, k), "py-is-none"(spec, sb), "CFSpec"(sb, spec, x, n1) ~> "c:anf"(p3, sa, n3), "CHold"(a, p3, "LNil"(), n3) ~> "c:anf"(ph, a3, n4), "CFresh"(n4) ~> "c:fresh"(t, n5), "CAppend"(p1, ph) ~> b0, "CAppend"(b0, p3) ~> b1, "CSnoc"(b1, "c:assign"("c:tmp"(t), "c:build-interpolation"(a3, "c:const"(s), k, sa))) ~> b |- "CTInterpolation"(v, s, cv, spec, x, n) ~> "c:anf"(b, "c:tmp"(t), n5);

      -- ================================================================ with

      -- with ITEM, ...: BODY as CPython's compiler_with: each item's context
      -- expression evaluated, its __enter__'s value kept and the target bound
      -- inside the protected region, the next item (or the body) inside it
      "WITH". items:T, body:T, tc:T, l:T, c:T, el:T, ec:T, x:T, n:T, r:T | "CWith"(items, body, x, n) ~> r |- "CStmt"("py:With"(items, body, tc, l, c, el, ec), x, n) ~> r;
      "WITH-ITEM". ce:T, ov:T, rest:T, body:T, x:T, n:T, p:T, a:T, n1:T, tv:T, n2:T, b:T, ts:T, n3:T, inner:T, n4:T, b0:T, w:T | "CAtom"(ce, x, n) ~> "c:anf"(p, a, n1), "CFresh"(n1) ~> "c:fresh"(tv, n2), "py-is-none"(ov, b), "CWithTarget"(b, ov, tv, x, n2) ~> "c:sts"(ts, n3), "CWithInner"(rest, body, x, n3) ~> "c:st"(inner, n4), "CSnoc"(ts, inner) ~> b0, "CSnoc"(p, "c:with"(a, "c:tmp"(tv), "c:seq"(b0))) ~> w |- "CWith"("LCons"("py:withitem"(ce, ov), rest), body, x, n) ~> "c:st"("c:seq"(w), n4);
      "WITH-TARGET-NONE". ov:T, tv:T, x:T, n:T |- "CWithTarget"("py:True"(), ov, tv, x, n) ~> "c:sts"("LNil"(), n);
      "WITH-TARGET". ov:T, tv:T, x:T, n:T, r:T | "CTarget"(ov, "c:tmp"(tv), x, n) ~> r |- "CWithTarget"("py:False"(), ov, tv, x, n) ~> r;
      "WITH-INNER-BODY". body:T, x:T, n:T, r:T | "CBlock"(body, x, n) ~> r |- "CWithInner"("LNil"(), body, x, n) ~> r;
      "WITH-INNER-MORE". i:T, is:T, body:T, x:T, n:T, r:T | "CWith"("LCons"(i, is), body, x, n) ~> r |- "CWithInner"("LCons"(i, is), body, x, n) ~> r;

      -- ================================================================ annotations

      -- under from __future__ import annotations, a module or class body that
      -- annotates makes __annotations__ first (SETUP_ANNOTATIONS: a new dict
      -- unless it has one)
      "SETUP-ANNOTATIONS". |- "CSetupAnnotations"("py:True"()) ~> "LCons"("c:do"("c:setup-annotations"()), "LNil"());
      "SETUP-ANNOTATIONS-NONE". |- "CSetupAnnotations"("py:False"()) ~> "LNil"();
      -- target: annotation = value, as CPython 3.15 compiles it (codegen_annassign):
      -- the value stored; without a value, a complex target's object (and key)
      -- evaluated; the annotation never evaluated here (PEP 649): in a module
      -- or class body a simple name registers its index in
      -- __conditional_annotations__ when it has one (see py-deferred)
      "ANN-ASSIGN". t:T, ann:T, v:T, simple:T, l:T, c:T, el:T, ec:T, x:T, n:T, b:T, r:T | "py-is-none"(v, b), "CAnnAssign"(b, t, ann, v, simple, l, c, el, ec, x, n) ~> r |- "CStmt"("py:AnnAssign"(t, ann, v, simple, l, c, el, ec), x, n) ~> r;
      "ANN-ASSIGN-VALUE". t:T, ann:T, v:T, simple:T, l:T, c:T, el:T, ec:T, x:T, n:T, none:T, s1:T, n1:T, s2:T, n2:T | "py-core-none"(none), "CStmt"("py:Assign"("LCons"(t, "LNil"()), v, none, l, c, el, ec), x, n) ~> "c:st"(s1, n1), "CAnnPart"(t, ann, simple, x, n1) ~> "c:st"(s2, n2) |- "CAnnAssign"("py:False"(), t, ann, v, simple, l, c, el, ec, x, n) ~> "c:st"("c:seq"("LCons"(s1, "LCons"(s2, "LNil"()))), n2);
      "ANN-ASSIGN-BARE". t:T, ann:T, v:T, simple:T, l:T, c:T, el:T, ec:T, x:T, n:T, s1:T, n1:T, s2:T, n2:T | "CAnnTargetCheck"(t, x, n) ~> "c:st"(s1, n1), "CAnnPart"(t, ann, simple, x, n1) ~> "c:st"(s2, n2) |- "CAnnAssign"("py:True"(), t, ann, v, simple, l, c, el, ec, x, n) ~> "c:st"("c:seq"("LCons"(s1, "LCons"(s2, "LNil"()))), n2);
      "ANN-TARGET-NAME". nm:T, cx:T, l:T, c:T, el:T, ec:T, x:T, n:T |- "CAnnTargetCheck"("py:Name"(nm, cx, l, c, el, ec), x, n) ~> "c:st"("c:seq"("LNil"()), n);
      "ANN-TARGET-ATTRIBUTE". v:T, at:T, cx:T, l:T, c:T, el:T, ec:T, x:T, n:T, b:T, n1:T | "CEvalEach"("LCons"(v, "LNil"()), x, n) ~> "c:sts"(b, n1) |- "CAnnTargetCheck"("py:Attribute"(v, at, cx, l, c, el, ec), x, n) ~> "c:st"("c:seq"(b), n1);
      "ANN-TARGET-SUBSCRIPT". v:T, sl:T, cx:T, l:T, c:T, el:T, ec:T, x:T, n:T, ps:T, b:T, n1:T | "py-ann-subscript-parts"(sl, ps), "CEvalEach"("LCons"(v, ps), x, n) ~> "c:sts"(b, n1) |- "CAnnTargetCheck"("py:Subscript"(v, sl, cx, l, c, el, ec), x, n) ~> "c:st"("c:seq"(b), n1);
      -- each expression evaluated and its value dropped, in order
      "EVAL-EACH-NIL". x:T, n:T |- "CEvalEach"("LNil"(), x, n) ~> "c:sts"("LNil"(), n);
      "EVAL-EACH-CONS". e:T, es:T, x:T, n:T, p:T, a:T, n1:T, b0:T, b1:T, n2:T, b:T | "COp"(e, x, n) ~> "c:anf"(p, a, n1), "CSnoc"(p, "c:do"(a)) ~> b0, "CEvalEach"(es, x, n1) ~> "c:sts"(b1, n2), "CAppend"(b0, b1) ~> b |- "CEvalEach"("LCons"(e, es), x, n) ~> "c:sts"(b, n2);
      "ANN-PART". t:T, ann:T, simple:T, x:T, n:T, g:T, r:T | "py-ann-register"(simple, g), "CAnnRegister"(g, t, ann, x, n) ~> r |- "CAnnPart"(t, ann, simple, x, n) ~> r;
      "ANN-REGISTER-NONE". t:T, ann:T, x:T, n:T |- "CAnnRegister"("c:no-register"(), t, ann, x, n) ~> "c:st"("c:seq"("LNil"()), n);
      "ANN-REGISTER-MODULE". t:T, ann:T, i:T, tq:T, sl:T, lp:T, n:T, ca:T | "py-core-name"("c:n-cond-annotations"(), ca) |- "CAnnRegister"("c:register"(i), t, ann, "c:cx"("c:module"(), tq, sl, lp), n) ~> "c:st"("c:seq"("LCons"("c:do"("c:set-add"("c:name"(ca), "c:const"(i))), "LNil"())), n);
      "ANN-REGISTER-CLASS". t:T, ann:T, i:T, tq:T, sl:T, lp:T, n:T, ca:T, j:T | "py-core-name"("c:n-cond-annotations"(), ca), "py-slot"(sl, ca, j) |- "CAnnRegister"("c:register"(i), t, ann, "c:cx"("c:class"(), tq, sl, lp), n) ~> "c:st"("c:seq"("LCons"("c:do"("c:set-add"("c:cell"(j), "c:const"(i))), "LNil"())), n);
      -- under from __future__ import annotations: the annotation (its text) stored
      -- in __annotations__ under the name, mangled
      "ANN-REGISTER-FUTURE". nm:T, cx:T, l:T, c:T, el:T, ec:T, ann:T, x:T, n:T, na:T, p:T, a:T, n1:T, b:T, mg:T | "py-core-name"("c:n-dunder-annotations"(), na), "CMangle"(nm, x) ~> mg, "CAtom"(ann, x, n) ~> "c:anf"(p, a, n1), "CSnoc"(p, "c:set-item"("c:name"(na), "c:const"(mg), a)) ~> b |- "CAnnRegister"("c:future-store"(), "py:Name"(nm, cx, l, c, el, ec), ann, x, n) ~> "c:st"("c:seq"(b), n1);

      -- global and nonlocal are the scope stage's: they do nothing at run time
      "GLOBAL". ns:T, l:T, c:T, el:T, ec:T, x:T, n:T |- "CStmt"("py:Global"(ns, l, c, el, ec), x, n) ~> "c:st"("c:seq"("LNil"()), n);
      "NONLOCAL". ns:T, l:T, c:T, el:T, ec:T, x:T, n:T |- "CStmt"("py:Nonlocal"(ns, l, c, el, ec), x, n) ~> "c:st"("c:seq"("LNil"()), n);

      -- name = value: the value's operation, stored where the name lives
      "ASSIGN-NAME". t:T, cx:T, nl:T, nc:T, nel:T, nec:T, v:T, tc:T, l:T, c:T, el:T, ec:T, x:T, n:T, pre:T, op:T, n1:T, tg:T, b:T | "COp"(v, x, n) ~> "c:anf"(pre, op, n1), "CName"(t, x) ~> tg, "CSnoc"(pre, "c:assign"(tg, op)) ~> b |- "CStmt"("py:Assign"("LCons"("py:Name"(t, cx, nl, nc, nel, nec), "LNil"()), v, tc, l, c, el, ec), x, n) ~> "c:st"("c:seq"(b), n1);
      -- name op= value: the name read first, then the value, then the
      -- in-place operation, stored back
      "AUG-ASSIGN-NAME". t:T, cx:T, nl:T, nc:T, nel:T, nec:T, o:T, v:T, l:T, c:T, el:T, ec:T, x:T, n:T, tg:T, t0:T, n1:T, pre:T, a:T, n2:T, b:T | "CName"(t, x) ~> tg, "CFresh"(n) ~> "c:fresh"(t0, n1), "CAtom"(v, x, n1) ~> "c:anf"(pre, a, n2), "CSnoc"("LCons"("c:assign"("c:tmp"(t0), "c:atom"(tg)), pre), "c:assign"(tg, "c:inplace"(o, "c:tmp"(t0), a))) ~> b |- "CStmt"("py:AugAssign"("py:Name"(t, cx, nl, nc, nel, nec), o, v, l, c, el, ec), x, n) ~> "c:st"("c:seq"(b), n2);
      -- obj.attr OP= value: obj evaluated once and held; the attribute loaded,
      -- the value evaluated, the in-place operation, the attribute stored
      "AUG-ASSIGN-ATTRIBUTE". v:T, at:T, cx:T, al:T, ac:T, ael:T, aec:T, o:T, val:T, l:T, c:T, el:T, ec:T, x:T, n:T, p1:T, xo0:T, n1:T, ph:T, xo:T, n2:T, t1:T, n3:T, p2:T, xv:T, n4:T, t2:T, n5:T, q0:T, q1:T, q2:T, b:T, mg:T | "CMangle"(at, x) ~> mg, "CAtom"(v, x, n) ~> "c:anf"(p1, xo0, n1), "CHoldAtom"(xo0, n1) ~> "c:anf"(ph, xo, n2), "CFresh"(n2) ~> "c:fresh"(t1, n3), "CAtom"(val, x, n3) ~> "c:anf"(p2, xv, n4), "CFresh"(n4) ~> "c:fresh"(t2, n5), "CAppend"(p1, ph) ~> q0, "CSnoc"(q0, "c:assign"("c:tmp"(t1), "c:getattr"(xo, mg))) ~> q1, "CAppend"(q1, p2) ~> q2, "CAppend"(q2, "LCons"("c:assign"("c:tmp"(t2), "c:inplace"(o, "c:tmp"(t1), xv)), "LCons"("c:set-attr"(xo, mg, "c:tmp"(t2)), "LNil"()))) ~> b |- "CStmt"("py:AugAssign"("py:Attribute"(v, at, cx, al, ac, ael, aec), o, val, l, c, el, ec), x, n) ~> "c:st"("c:seq"(b), n5);
      -- obj[key] OP= value: obj and key evaluated once and held; the item loaded,
      -- the value evaluated, the in-place operation, the item stored
      "AUG-ASSIGN-SUBSCRIPT". v:T, sl:T, cx:T, sl1:T, sc:T, sel:T, sec:T, o:T, val:T, l:T, c:T, el:T, ec:T, x:T, n:T, p1:T, xo0:T, xk0:T, n1:T, ph1:T, xo:T, n2:T, ph2:T, xk:T, n3:T, t1:T, n4:T, p2:T, xv:T, n5:T, t2:T, n6:T, q0:T, q1:T, q2:T, q3:T, b:T | "COperands"("LCons"(v, "LCons"(sl, "LNil"())), "LNil"(), x, n) ~> "c:anfs"(p1, "LCons"(xo0, "LCons"(xk0, "LNil"())), n1), "CHoldAtom"(xo0, n1) ~> "c:anf"(ph1, xo, n2), "CHoldAtom"(xk0, n2) ~> "c:anf"(ph2, xk, n3), "CFresh"(n3) ~> "c:fresh"(t1, n4), "CAtom"(val, x, n4) ~> "c:anf"(p2, xv, n5), "CFresh"(n5) ~> "c:fresh"(t2, n6), "CAppend"(p1, ph1) ~> q0, "CAppend"(q0, ph2) ~> q1, "CSnoc"(q1, "c:assign"("c:tmp"(t1), "c:getitem"(xo, xk))) ~> q2, "CAppend"(q2, p2) ~> q3, "CAppend"(q3, "LCons"("c:assign"("c:tmp"(t2), "c:inplace"(o, "c:tmp"(t1), xv)), "LCons"("c:set-item"(xo, xk, "c:tmp"(t2)), "LNil"()))) ~> b |- "CStmt"("py:AugAssign"("py:Subscript"(v, sl, cx, sl1, sc, sel, sec), o, val, l, c, el, ec), x, n) ~> "c:st"("c:seq"(b), n6);

      -- a, b = value (or [a, b] = value): the value, then each target in
      -- turn; t1 = t2 = value: the value once, then each target, left to right
