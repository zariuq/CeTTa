{- Python 3.15: the core a program runs as.

   The abstract syntax Ast.module builds, with the symbol tables Scope.module
   gives, becomes a small core in A-normal form: an operation's operands are
   atoms, so evaluation order is explicit and every intermediate value has a
   slot.  Atoms: (c:const V), (c:const-set VALUES) the set of constants a
   display of constants is built from, (c:local SLOT) a function's fast local,
   (c:cell SLOT), (c:global NAME) the module's globals then the builtins,
   (c:name NAME) a module's or class body's namespace, (c:tmp SLOT) a
   temporary.  Statements: (c:assign TARGET OP), (c:do OP), (c:seq LIST),
   (c:if ATOM S S), (c:block LABEL S), (c:loop LABEL S), (c:break LABEL),
   (c:continue LABEL), (c:return ATOM), (c:yield T ATOM), (c:yield-from T ATOM),
   (c:await T ATOM); and (c:syntax-error MESSAGE LINE COL
   ELINE ECOL) where CPython's compiler raises a SyntaxError (the first in the
   core's order refuses the program).  A function is a code object,
   (c:code NAME QUALNAME (c:args NPOSONLY NPOS NKWONLY STAR DSTAR NAMES) NSLOTS CELLS FREES FLAGS BODY),
   NAMES the slots' names, CELLS the slots holding cells, FREES those the closure fills.

   Names resolve as CPython's compiler resolves them (compiler_nameop): in a
   function a LOCAL name is a fast local, a GLOBAL one a global, a FREE or
   CELL one a cell; in a module or class body a LOCAL or implicitly global
   name is looked up in the namespace, an explicitly global one in the
   globals.  The desugaring threads the next free slot (temporaries and loop
   labels are numbered from it) through the walk.  A context is
   (c:cx KIND (c:tq TABLE PREFIX PRIVATE) SLOTS LOOPS): the block's kind; its
   symbol table, the prefix of the qualified names it holds and its private
   name (the innermost class's name, py:None outside classes); its fast
   locals in slot order (py:None outside functions); and the labels a break
   and a continue go to (py:None outside loops). -}
Module PythonCore {
  Theory Desugar() {
    Empty
    Types {
      T;
    }
    Rewrites {
      -- ================================================================ match
      -- PEP 634 as compile.c compiles it (compiler_match_inner): the subject
      -- once, in a temporary; each case a block its pattern breaks out of when
      -- it does not match; a pattern's captures are stored only once all of it
      -- has matched, then the guard is tested (the names stay bound when it
      -- fails), then the body runs and the statement ends
      "MATCH". subj:T, cases:T, l:T, c:T, el:T, ec:T, x:T, n:T, pre:T, a:T, n1:T, ts:T, n2:T, end:T, n3:T, ss:T, n4:T, b0:T, b:T | "CAtom"(subj, x, n) ~> "c:anf"(pre, a, n1), "CFresh"(n1) ~> "c:fresh"(ts, n2), "CFresh"(n2) ~> "c:fresh"(end, n3), "CCases"(cases, "c:tmp"(ts), end, x, n3) ~> "c:sts"(ss, n4), "CSnoc"(pre, "c:assign"("c:tmp"(ts), "c:atom"(a))) ~> b0, "CAppend"(b0, ss) ~> b |- "CStmt"("py:Match"(subj, cases, l, c, el, ec), x, n) ~> "c:st"("c:block"(end, "c:seq"(b)), n4);
      "CASES-NIL". s:T, end:T, x:T, n:T |- "CCases"("LNil"(), s, end, x, n) ~> "c:sts"("LNil"(), n);
      "CASES-LAST". cs:T, s:T, end:T, x:T, n:T, st:T, n1:T | "CCase"(cs, "py:True"(), s, end, x, n) ~> "c:st"(st, n1) |- "CCases"("LCons"(cs, "LNil"()), s, end, x, n) ~> "c:sts"("LCons"(st, "LNil"()), n1);
      "CASES-CONS". cs:T, c2:T, rest:T, s:T, end:T, x:T, n:T, st:T, n1:T, ss:T, n2:T | "CCase"(cs, "py:False"(), s, end, x, n) ~> "c:st"(st, n1), "CCases"("LCons"(c2, rest), s, end, x, n1) ~> "c:sts"(ss, n2) |- "CCases"("LCons"(cs, "LCons"(c2, rest)), s, end, x, n) ~> "c:sts"("LCons"(st, ss), n2);
      "CASE". p:T, g:T, body:T, lst:T, s:T, end:T, x:T, n:T, er:T, pe:T, fl:T, n1:T, ps:T, sto:T, n2:T, stv:T, gs:T, n3:T, bs:T, n4:T, b0:T, b1:T, b2:T, b:T | "py-pattern-error"(p, g, lst, er), "CPatError"(er) ~> pe, "CFresh"(n) ~> "c:fresh"(fl, n1), "CPat"(p, s, fl, x, n1) ~> "c:pat"(ps, sto, n2), "CStores"(sto, x) ~> stv, "CGuard"(g, fl, x, n2) ~> "c:sts"(gs, n3), "CBlock"(body, x, n3) ~> "c:st"(bs, n4), "CAppend"(pe, ps) ~> b0, "CAppend"(b0, stv) ~> b1, "CAppend"(b1, gs) ~> b2, "CAppend"(b2, "LCons"(bs, "LCons"("c:break"(end), "LNil"()))) ~> b |- "CCase"("py:match_case"(p, g, body), lst, s, end, x, n) ~> "c:st"("c:block"(fl, "c:seq"(b)), n4);
      "PAT-ERROR-NONE". |- "CPatError"("c:no-error"()) ~> "LNil"();
      "PAT-ERROR". m:T, l:T, c:T, el:T, ec:T |- "CPatError"("c:syntax-error"(m, l, c, el, ec)) ~> "LCons"("c:syntax-error"(m, l, c, el, ec), "LNil"());
      "GUARD". g:T, fl:T, x:T, n:T, b:T, r:T | "py-is-none"(g, b), "CGuardIf"(b, g, fl, x, n) ~> r |- "CGuard"(g, fl, x, n) ~> r;
      "GUARD-NONE". g:T, fl:T, x:T, n:T |- "CGuardIf"("py:True"(), g, fl, x, n) ~> "c:sts"("LNil"(), n);
      "GUARD-TEST". g:T, fl:T, x:T, n:T, pre:T, a:T, n1:T, b:T | "CAtom"(g, x, n) ~> "c:anf"(pre, a, n1), "CSnoc"(pre, "c:if"(a, "c:seq"("LNil"()), "c:break"(fl))) ~> b |- "CGuardIf"("py:False"(), g, fl, x, n) ~> "c:sts"(b, n1);
      "STORES-NIL". x:T |- "CStores"("LNil"(), x) ~> "LNil"();
      "STORES-CONS". nm:T, a:T, rest:T, x:T, tg:T, r:T | "CName"(nm, x) ~> tg, "CStores"(rest, x) ~> r |- "CStores"("LCons"("c:store"(nm, a), rest), x) ~> "LCons"("c:assign"(tg, "c:atom"(a)), r);

      -- a pattern against a subject atom S, breaking out to FAIL when it does
      -- not match: (c:pat STATEMENTS STORES N), STORES its captures
      -- (c:store NAME ATOM) in the order compile.c stores them
      "PAT-VALUE". v:T, l:T, c:T, el:T, ec:T, s:T, fl:T, x:T, n:T, pre:T, a:T, n1:T, t:T, n2:T, b0:T, b:T | "CAtom"(v, x, n) ~> "c:anf"(pre, a, n1), "CFresh"(n1) ~> "c:fresh"(t, n2), "CSnoc"(pre, "c:assign"("c:tmp"(t), "c:compare"("py:Eq"(), s, a))) ~> b0, "CSnoc"(b0, "c:if"("c:tmp"(t), "c:seq"("LNil"()), "c:break"(fl))) ~> b |- "CPat"("py:MatchValue"(v, l, c, el, ec), s, fl, x, n) ~> "c:pat"(b, "LNil"(), n2);
      "PAT-SINGLETON". v:T, l:T, c:T, el:T, ec:T, s:T, fl:T, x:T, n:T, w:T, t:T, n1:T | "py-core-value"(v, w), "CFresh"(n) ~> "c:fresh"(t, n1) |- "CPat"("py:MatchSingleton"(v, l, c, el, ec), s, fl, x, n) ~> "c:pat"("LCons"("c:assign"("c:tmp"(t), "c:compare"("py:Is"(), s, "c:const"(w))), "LCons"("c:if"("c:tmp"(t), "c:seq"("LNil"()), "c:break"(fl)), "LNil"())), "LNil"(), n1);
      "PAT-STAR". nm:T, l:T, c:T, el:T, ec:T, s:T, fl:T, x:T, n:T, b:T, st:T | "py-is-none"(nm, b), "CCapture"(b, nm, s) ~> st |- "CPat"("py:MatchStar"(nm, l, c, el, ec), s, fl, x, n) ~> "c:pat"("LNil"(), st, n);
      "CAPTURE-NONE". nm:T, s:T |- "CCapture"("py:True"(), nm, s) ~> "LNil"();
      "CAPTURE". nm:T, s:T |- "CCapture"("py:False"(), nm, s) ~> "LCons"("c:store"(nm, s), "LNil"());
      "PAT-AS". p:T, nm:T, l:T, c:T, el:T, ec:T, s:T, fl:T, x:T, n:T, bp:T, bn:T, cap:T, r:T | "py-is-none"(p, bp), "py-is-none"(nm, bn), "CCapture"(bn, nm, s) ~> cap, "CPatAs"(bp, p, cap, s, fl, x, n) ~> r |- "CPat"("py:MatchAs"(p, nm, l, c, el, ec), s, fl, x, n) ~> r;
      "PAT-AS-BARE". p:T, cap:T, s:T, fl:T, x:T, n:T |- "CPatAs"("py:True"(), p, cap, s, fl, x, n) ~> "c:pat"("LNil"(), cap, n);
      "PAT-AS-SUB". p:T, cap:T, s:T, fl:T, x:T, n:T, ps:T, st:T, n1:T, st2:T | "CPat"(p, s, fl, x, n) ~> "c:pat"(ps, st, n1), "CAppend"(st, cap) ~> st2 |- "CPatAs"("py:False"(), p, cap, s, fl, x, n) ~> "c:pat"(ps, st2, n1);
      -- an or-pattern: each alternative in its own block, its captures moved
      -- into the temporaries of the first alternative's names
      "PAT-OR". ps:T, l:T, c:T, el:T, ec:T, s:T, fl:T, x:T, n:T, ok:T, n1:T, f1:T, ps1:T, st1:T, cs:T, n2:T, ctl:T, n3:T, bs:T, b:T | "CFresh"(n) ~> "c:fresh"(ok, n1), "COrAlts"(ps, s, x, n1) ~> "c:alts"("LCons"("c:alt"(f1, ps1, st1), cs), n2), "py-or-control"(st1, n2, "c:control"(ctl, n3)), "COrBlocks"("LCons"("c:alt"(f1, ps1, st1), cs), ctl, ok) ~> bs, "CSnoc"(bs, "c:break"(fl)) ~> b |- "CPat"("py:MatchOr"(ps, l, c, el, ec), s, fl, x, n) ~> "c:pat"("LCons"("c:block"(ok, "c:seq"(b)), "LNil"()), ctl, n3);
      "OR-ALTS-NIL". s:T, x:T, n:T |- "COrAlts"("LNil"(), s, x, n) ~> "c:alts"("LNil"(), n);
      "OR-ALTS-CONS". p:T, rest:T, s:T, x:T, n:T, f:T, n1:T, ps:T, st:T, n2:T, cs:T, n3:T | "CFresh"(n) ~> "c:fresh"(f, n1), "CPat"(p, s, f, x, n1) ~> "c:pat"(ps, st, n2), "COrAlts"(rest, s, x, n2) ~> "c:alts"(cs, n3) |- "COrAlts"("LCons"(p, rest), s, x, n) ~> "c:alts"("LCons"("c:alt"(f, ps, st), cs), n3);
      "OR-BLOCKS-NIL". ctl:T, ok:T |- "COrBlocks"("LNil"(), ctl, ok) ~> "LNil"();
      "OR-BLOCKS-CONS". f:T, ps:T, st:T, rest:T, ctl:T, ok:T, asg:T, b0:T, b:T, r:T | "py-or-assigns"(ctl, st, asg), "CAppend"(ps, asg) ~> b0, "CSnoc"(b0, "c:break"(ok)) ~> b, "COrBlocks"(rest, ctl, ok) ~> r |- "COrBlocks"("LCons"("c:alt"(f, ps, st), rest), ctl, ok) ~> "LCons"("c:block"(f, "c:seq"(b)), r);
      -- a sequence pattern: MATCH_SEQUENCE, the length, then its items by
      -- subscripts (a wildcard star) or by unpacking (UNPACK_SEQUENCE/UNPACK_EX)
      "PAT-SEQUENCE". ps:T, l:T, c:T, el:T, ec:T, s:T, fl:T, x:T, n:T, lc:T, kd:T, t:T, n1:T, b1:T, n2:T, b2:T, st:T, n3:T, b:T | "py-sequence-shape"(ps, "c:seq-shape"(lc, kd)), "CFresh"(n) ~> "c:fresh"(t, n1), "CLenCheck"(lc, s, fl, n1) ~> "c:sts"(b1, n2), "CSeqExtract"(kd, s, fl, x, n2) ~> "c:pat"(b2, st, n3), "CAppend"("LCons"("c:assign"("c:tmp"(t), "c:match-sequence"(s)), "LCons"("c:if"("c:tmp"(t), "c:seq"("LNil"()), "c:break"(fl)), b1)), b2) ~> b |- "CPat"("py:MatchSequence"(ps, l, c, el, ec), s, fl, x, n) ~> "c:pat"(b, st, n3);
      "LEN-ANY". s:T, fl:T, n:T |- "CLenCheck"("c:len-any"(), s, fl, n) ~> "c:sts"("LNil"(), n);
      "LEN-CHECK". o:T, k:T, s:T, fl:T, n:T, tl:T, n1:T, tc:T, n2:T | "CFresh"(n) ~> "c:fresh"(tl, n1), "CFresh"(n1) ~> "c:fresh"(tc, n2) |- "CLenCheck"("c:len"(o, k), s, fl, n) ~> "c:sts"("LCons"("c:assign"("c:tmp"(tl), "c:get-len"(s)), "LCons"("c:assign"("c:tmp"(tc), "c:compare"(o, "c:tmp"(tl), "c:const"(k))), "LCons"("c:if"("c:tmp"(tc), "c:seq"("LNil"()), "c:break"(fl)), "LNil"()))), n2);
      "EXTRACT-NONE". s:T, fl:T, x:T, n:T |- "CSeqExtract"("c:only-wildcards"(), s, fl, x, n) ~> "c:pat"("LNil"(), "LNil"(), n);
      "EXTRACT-SUBSCRIPTS". plan:T, s:T, fl:T, x:T, n:T, r:T | "CSubscrPats"(plan, s, fl, x, n) ~> r |- "CSeqExtract"("c:subscripts"(plan), s, fl, x, n) ~> r;
      "EXTRACT-UNPACK". sh:T, ps:T, s:T, fl:T, x:T, n:T, op:T, tu:T, n1:T, z:T, b:T, st:T, n2:T | "CUnpackOp"(sh, s) ~> op, "CFresh"(n) ~> "c:fresh"(tu, n1), "py-const"("py:zero"(), z), "CItemPats"(ps, tu, z, fl, x, n1) ~> "c:pat"(b, st, n2) |- "CSeqExtract"("c:unpack-by"(sh, ps), s, fl, x, n) ~> "c:pat"("LCons"("c:assign"("c:tmp"(tu), op), b), st, n2);
      "ITEM-PATS-NIL". tu:T, i:T, fl:T, x:T, n:T |- "CItemPats"("LNil"(), tu, i, fl, x, n) ~> "c:pat"("LNil"(), "LNil"(), n);
      "ITEM-PATS-CONS". p:T, ps:T, tu:T, i:T, fl:T, x:T, n:T, ti:T, n1:T, b1:T, st1:T, n2:T, one:T, i1:T, b2:T, st2:T, n3:T, b:T, st:T | "CFresh"(n) ~> "c:fresh"(ti, n1), "CPat"(p, "c:tmp"(ti), fl, x, n1) ~> "c:pat"(b1, st1, n2), "py-const"("py:one"(), one), "py-add"(i, one, i1), "CItemPats"(ps, tu, i1, fl, x, n2) ~> "c:pat"(b2, st2, n3), "CAppend"("LCons"("c:assign"("c:tmp"(ti), "c:getitem"("c:tmp"(tu), "c:const"(i))), b1), b2) ~> b, "CAppend"(st1, st2) ~> st |- "CItemPats"("LCons"(p, ps), tu, i, fl, x, n) ~> "c:pat"(b, st, n3);
      "SUBSCR-NIL". s:T, fl:T, x:T, n:T |- "CSubscrPats"("LNil"(), s, fl, x, n) ~> "c:pat"("LNil"(), "LNil"(), n);
      "SUBSCR-FRONT". i:T, p:T, rest:T, s:T, fl:T, x:T, n:T, ti:T, n1:T, b1:T, st1:T, n2:T, b2:T, st2:T, n3:T, b:T, st:T | "CFresh"(n) ~> "c:fresh"(ti, n1), "CPat"(p, "c:tmp"(ti), fl, x, n1) ~> "c:pat"(b1, st1, n2), "CSubscrPats"(rest, s, fl, x, n2) ~> "c:pat"(b2, st2, n3), "CAppend"("LCons"("c:assign"("c:tmp"(ti), "c:getitem"(s, "c:const"(i))), b1), b2) ~> b, "CAppend"(st1, st2) ~> st |- "CSubscrPats"("LCons"("c:front"(i, p), rest), s, fl, x, n) ~> "c:pat"(b, st, n3);
      "SUBSCR-BACK". k:T, p:T, rest:T, s:T, fl:T, x:T, n:T, tl:T, n1:T, tk:T, n2:T, ti:T, n3:T, b1:T, st1:T, n4:T, b2:T, st2:T, n5:T, b:T, st:T | "CFresh"(n) ~> "c:fresh"(tl, n1), "CFresh"(n1) ~> "c:fresh"(tk, n2), "CFresh"(n2) ~> "c:fresh"(ti, n3), "CPat"(p, "c:tmp"(ti), fl, x, n3) ~> "c:pat"(b1, st1, n4), "CSubscrPats"(rest, s, fl, x, n4) ~> "c:pat"(b2, st2, n5), "CAppend"("LCons"("c:assign"("c:tmp"(tl), "c:get-len"(s)), "LCons"("c:assign"("c:tmp"(tk), "c:binop"("py:Sub"(), "c:tmp"(tl), "c:const"(k))), "LCons"("c:assign"("c:tmp"(ti), "c:getitem"(s, "c:tmp"(tk))), b1))), b2) ~> b, "CAppend"(st1, st2) ~> st |- "CSubscrPats"("LCons"("c:back"(k, p), rest), s, fl, x, n) ~> "c:pat"(b, st, n5);
      -- a mapping pattern: MATCH_MAPPING, the length, the keys (literals and
      -- attribute lookups, in order), MATCH_KEYS, the values' patterns, **rest
      "PAT-MAPPING". ks:T, ps:T, rest:T, l:T, c:T, el:T, ec:T, s:T, fl:T, x:T, n:T, sh:T, t:T, n1:T, b0:T, st:T, n2:T | "py-mapping-shape"(ks, rest, sh), "CFresh"(n) ~> "c:fresh"(t, n1), "CMapPat"(sh, ks, ps, rest, s, fl, x, n1) ~> "c:pat"(b0, st, n2) |- "CPat"("py:MatchMapping"(ks, ps, rest, l, c, el, ec), s, fl, x, n) ~> "c:pat"("LCons"("c:assign"("c:tmp"(t), "c:match-mapping"(s)), "LCons"("c:if"("c:tmp"(t), "c:seq"("LNil"()), "c:break"(fl)), b0)), st, n2);
      "MAP-EMPTY". ks:T, ps:T, rest:T, s:T, fl:T, x:T, n:T |- "CMapPat"("c:map-empty"(), ks, ps, rest, s, fl, x, n) ~> "c:pat"("LNil"(), "LNil"(), n);
      "MAP-KEYS". lc:T, ks:T, ps:T, rest:T, s:T, fl:T, x:T, n:T, b1:T, n1:T, pre:T, xs:T, n2:T, tk:T, n3:T, tv:T, n4:T, tn:T, n5:T, none:T, z:T, b2:T, st:T, n6:T, br:T, sr:T, n7:T, q1:T, q2:T, q3:T, b:T, st2:T | "CLenCheck"(lc, s, fl, n) ~> "c:sts"(b1, n1), "CAtoms"(ks, x, n1) ~> "c:anfs"(pre, xs, n2), "CFresh"(n2) ~> "c:fresh"(tk, n3), "CFresh"(n3) ~> "c:fresh"(tv, n4), "CFresh"(n4) ~> "c:fresh"(tn, n5), "py-core-none"(none), "py-const"("py:zero"(), z), "CItemPats"(ps, tv, z, fl, x, n5) ~> "c:pat"(b2, st, n6), "CMapRest"(rest, s, tk, n6) ~> "c:pat"(br, sr, n7), "CAppend"(b1, pre) ~> q1, "CAppend"(q1, "LCons"("c:assign"("c:tmp"(tk), "c:tuple"(xs)), "LCons"("c:assign"("c:tmp"(tv), "c:match-keys"(s, "c:tmp"(tk))), "LCons"("c:assign"("c:tmp"(tn), "c:compare"("py:IsNot"(), "c:tmp"(tv), "c:const"(none))), "LCons"("c:if"("c:tmp"(tn), "c:seq"("LNil"()), "c:break"(fl)), "LNil"()))))) ~> q2, "CAppend"(q2, b2) ~> q3, "CAppend"(q3, br) ~> b, "CAppend"(st, sr) ~> st2 |- "CMapPat"("c:map"(lc), ks, ps, rest, s, fl, x, n) ~> "c:pat"(b, st2, n7);
      "MAP-REST". rest:T, s:T, tk:T, n:T, b:T, r:T | "py-is-none"(rest, b), "CMapRestIf"(b, rest, s, tk, n) ~> r |- "CMapRest"(rest, s, tk, n) ~> r;
      "MAP-REST-NONE". rest:T, s:T, tk:T, n:T |- "CMapRestIf"("py:True"(), rest, s, tk, n) ~> "c:pat"("LNil"(), "LNil"(), n);
      "MAP-REST-NAME". rest:T, s:T, tk:T, n:T, tr:T, n1:T | "CFresh"(n) ~> "c:fresh"(tr, n1) |- "CMapRestIf"("py:False"(), rest, s, tk, n) ~> "c:pat"("LCons"("c:assign"("c:tmp"(tr), "c:match-rest"(s, "c:tmp"(tk))), "LNil"()), "LCons"("c:store"(rest, "c:tmp"(tr)), "LNil"()), n1);
      -- a class pattern: the class, MATCH_CLASS (an instance; its attributes by
      -- __match_args__, then by keyword), then each attribute's pattern
      "PAT-CLASS". cls:T, ps:T, ka:T, kp:T, l:T, c:T, el:T, ec:T, s:T, fl:T, x:T, n:T, pre:T, a:T, n1:T, k:T, names:T, tr:T, n2:T, tn:T, n3:T, none:T, z:T, all:T, b1:T, st:T, n4:T, b:T | "CAtom"(cls, x, n) ~> "c:anf"(pre, a, n1), "py-slot-count"(ps, k), "py-class-names"(ka, names), "CFresh"(n1) ~> "c:fresh"(tr, n2), "CFresh"(n2) ~> "c:fresh"(tn, n3), "py-core-none"(none), "py-const"("py:zero"(), z), "CAppend"(ps, kp) ~> all, "CItemPats"(all, tr, z, fl, x, n3) ~> "c:pat"(b1, st, n4), "CAppend"(pre, "LCons"("c:assign"("c:tmp"(tr), "c:match-class"(s, a, "c:const"(k), "c:const"(names))), "LCons"("c:assign"("c:tmp"(tn), "c:compare"("py:IsNot"(), "c:tmp"(tr), "c:const"(none))), "LCons"("c:if"("c:tmp"(tn), "c:seq"("LNil"()), "c:break"(fl)), b1)))) ~> b |- "CPat"("py:MatchClass"(cls, ps, ka, kp, l, c, el, ec), s, fl, x, n) ~> "c:pat"(b, st, n4);


      -- ================================================================ lists
      "APPEND-NIL". ys:T |- "CAppend"("LNil"(), ys) ~> ys;
