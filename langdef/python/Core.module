      "SET-COMP". e:T, gs:T, l:T, c:T, el:T, ec:T, x:T, n:T, af:T, r:T | "py-comp-async"(gs, e, e, af), "CCompIf"(af, "c:k-set"(), e, e, gs, l, c, el, ec, x, n) ~> r |- "COp"("py:SetComp"(e, gs, l, c, el, ec), x, n) ~> r;
