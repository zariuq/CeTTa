      "AWAIT". v:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a0:T, r:T | "SBlockCheck"("st:w-await"(), "st:at"(l, c, el, ec), x, acc) ~> a0, "SExpr"(v, x, a0) ~> r |- "SExpr"("py:Await"(v, l, c, el, ec), x, acc) ~> r;
