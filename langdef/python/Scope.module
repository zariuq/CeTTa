      "PARAMS-CONS". n:T, an:T, tc:T, l:T, c:T, el:T, ec:T, rest:T, x:T, acc:T, a0:T, a1:T, r:T | "SParamCheck"(n, "st:at"(l, c, el, ec), x, acc) ~> a0, "SDef"(n, "st:param"(), x, a0) ~> a1, "SParams"(rest, x, a1) ~> r |- "SParams"("LCons"("py:arg"(n, an, tc, l, c, el, ec), rest), x, acc) ~> r;
      "PARAM-OPT". p:T, x:T, acc:T, f:T, r:T | "py-is-none"(p, f), "SParamIf"(f, p, x, acc) ~> r |- "SParamOpt"(p, x, acc) ~> r;
      "PARAM-OPT-NONE". p:T, x:T, acc:T |- "SParamIf"("py:True"(), p, x, acc) ~> acc;
      "PARAM-OPT-SOME". n:T, an:T, tc:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a0:T, r:T | "SParamCheck"(n, "st:at"(l, c, el, ec), x, acc) ~> a0, "SDef"(n, "st:param"(), x, a0) ~> r |- "SParamIf"("py:False"(), "py:arg"(n, an, tc, l, c, el, ec), x, acc) ~> r;
      -- annotations (3.14+, PEP 649): in a block of their own, __annotate__,
      -- before the function's, whose parameter is .format; a method's (and a
      -- generic method's) can see the class.  Postponed annotations (from
      -- __future__ import annotations) state nothing (their errors stay).
      "ANNOTATIONS". args:T, rt:T, pos:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, acc:T, r:T | "SAnnotationsIf"(fu, args, rt, pos, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r |- "SAnnotations"(args, rt, pos, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r;
