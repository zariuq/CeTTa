      -- ================================================================ parameters

      "ARG-DEFAULTS". po:T, pa:T, va:T, ko:T, kd:T, kw:T, ds:T, x:T, acc:T, a1:T, r:T | "SExprs"(ds, x, acc) ~> a1, "SOpts"(kd, x, a1) ~> r |- "SArgDefaults"("py:arguments"(po, pa, va, ko, kd, kw, ds), x, acc) ~> r;
