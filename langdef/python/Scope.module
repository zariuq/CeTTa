      "NAME-STORE". n:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a0:T, r:T | "SIterTarget"(n, "st:at"(l, c, el, ec), x, acc) ~> a0, "SDef"(n, "st:local"(), x, a0) ~> r |- "SExpr"("py:Name"(n, "py:Store"(), l, c, el, ec), x, acc) ~> r;
      "NAME-DEL". n:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a0:T, r:T | "SIterTarget"(n, "st:at"(l, c, el, ec), x, acc) ~> a0, "SDef"(n, "st:local"(), x, a0) ~> r |- "SExpr"("py:Name"(n, "py:Del"(), l, c, el, ec), x, acc) ~> r;
