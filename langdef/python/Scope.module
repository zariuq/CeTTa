      "COMP". tag:T, gen:T, t:T, it:T, fs:T, ia:T, gs:T, e:T, v:T, l:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, acc:T, a1:T, a2:T, a3:T, a4:T, a5:T, a6:T, a7:T, n:T, o:T, r:T | "SExpr"(it, "st:ctx"(k, pv, mg, ct, fu, ic, cs, "st:no-walrus"("st:iter"())), acc) ~> a1, "SOuterIters"(ic, a1) ~> o, "py-name"(tag, n), "SDefNamed"("st:n-dot0"(), "st:param"(), "st:ctx"("st:function"(), pv, mg, "py:False"(), fu, "st:in-comp"(tag, o), "py:False"(), wt), "st:acc"("LNil"(), "LNil"(), "LNil"())) ~> a2, "SExpr"(t, "st:ctx"("st:function"(), pv, mg, "py:True"(), fu, "st:in-comp"(tag, o), "py:False"(), wt), a2) ~> a3, "SExprs"(fs, "st:ctx"("st:function"(), pv, mg, "py:False"(), fu, "st:in-comp"(tag, o), "py:False"(), wt), a3) ~> a4, "SGenerators"(gs, "st:ctx"("st:function"(), pv, mg, "py:False"(), fu, "st:in-comp"(tag, o), "py:False"(), wt), a4) ~> a5, "SOpt"(v, "st:ctx"("st:function"(), pv, mg, "py:False"(), fu, "st:in-comp"(tag, o), "py:False"(), wt), a5) ~> a6, "SExpr"(e, "st:ctx"("st:function"(), pv, mg, "py:False"(), fu, "st:in-comp"(tag, o), "py:False"(), wt), a6) ~> a7, "SClose"("st:function"(), n, l, "st:props"("py:True"(), gen, "py:False"()), "py:none"(), a7, a1) ~> r |- "SComp"(tag, gen, "LCons"("py:comprehension"(t, it, fs, ia), gs), e, v, l, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r;
