{- Python 3.15: the symbol tables of a module, as CPython's symtable gives
   them (the Python Language Reference, 4.2 Naming and binding).

   Two passes over the abstract syntax Ast.module builds.

   The first reads, for each block (the module, a class, a function, a
   lambda, a comprehension, and the scopes of type parameters, type aliases
   and type variables), the facts each name has in it: (st:ev NAME FLAG),
   FLAG one of st:local, st:param, st:global, st:nonlocal, st:use,
   st:import, st:annot, st:comp-iter, st:type-param.  A block is
   (st:block KIND NAME (st:pos LINE COLUMN) PROPS EVENTS CHILDREN), PROPS
   (st:props COMPREHENSION GENERATOR CAN-SEE-CLASS).  The walk carries a
   context (st:ctx KIND PRIVATE MANGLED COMP-TARGET FUTURE IN-COMP
   CAN-SEE-CLASS WALRUS-TARGET) and an accumulator (st:acc EVENTS CHILDREN
   ESCAPES): events and children in reverse, and the facts a block states
   of an enclosing one (st:esc TARGET NAME FLAG): a global declaration is
   also the module's, and a named expression in a comprehension binds in
   the nearest function or the module.

   The second decides each name's scope from its facts and the names the
   enclosing blocks bind (an attribute grammar: bound, global and type
   parameter names flow down, free names flow up), inlines list, set and
   dict comprehensions into their block (PEP 709) and gives each symbol
   CPython's flags and scope.  Names written with a dot (.0, .defaults) are
   CPython's own. -}
Module PythonScope {
  Theory Tables() {
    Empty
    Types {
      T;
    }
    Rewrites {
      -- ================================================================ lists

      "APPEND-NIL". ys:T |- "SAppend"("LNil"(), ys) ~> ys;
      "APPEND-CONS". x:T, xs:T, ys:T, r:T | "SAppend"(xs, ys) ~> r |- "SAppend"("LCons"(x, xs), ys) ~> "LCons"(x, r);
      "REV-NIL". acc:T |- "SRev"("LNil"(), acc) ~> acc;
      "REV-CONS". x:T, xs:T, acc:T, r:T | "SRev"(xs, "LCons"(x, acc)) ~> r |- "SRev"("LCons"(x, xs), acc) ~> r;

      -- ================================================================ the module

      "MODULE". body:T, ti:T, fu:T, fe:T, top:T, z:T, ev:T, ch:T, es:T, ev2:T, up:T, chs:T, r:T, a0:T, ca:T, mb:T | "py-future-error"(body, fe), "py-future-annotations"(body, fu), "py-name"("st:n-top"(), top), "py-const"("py:zero"(), z), "py-mark-imports"(body, mb), "SStmts"(mb, "st:ctx"("st:module"(), "py:None"(), "py:None"(), "py:False"(), fu, "py:False"(), "py:False"(), "py:module"()), "st:acc"("LNil"(), "LNil"(), "LNil"())) ~> a0, "py-any-annotation"(body, ca), "SCondAnn"(ca, "st:ctx"("st:module"(), "py:None"(), "py:None"(), "py:False"(), fu, "py:False"(), "py:False"(), "py:module"()), a0) ~> "st:acc"(ev, ch, es), "SAbsorb"(es, "py:mod"(), ev, "LNil"()) ~> "st:abs"(ev2, up), "SRevOpen"(ch, "LNil"()) ~> chs, "SModResult"(fe, up, "st:block"("st:module"(), top, "st:pos"(z, z), "st:props"("py:False"(), "py:False"(), "py:False"()), ev2, chs)) ~> r |- "SMod"("py:Module"(body, ti)) ~> r;
      -- an Expression (eval's input): the symbols of a module whose one
      -- statement is that expression (_PySymtable_Build's module block)
      "EXPRESSION". e:T, z:T, r:T | "py-const"("py:zero"(), z), "SMod"("py:Module"("LCons"("py:Expr"(e, z, z, z, z), "LNil"()), "LNil"())) ~> r |- "SMod"("py:Expression"(e)) ~> r;
      -- the future statements are checked before the tables are read; what
      -- the module leaves unabsorbed is the errors, in the order the walk met
      -- them: the first is CPython's
      "MOD-OK". b:T |- "SModResult"("py:None"(), "LNil"(), b) ~> b;
      "MOD-ERROR". m:T, l:T, c:T, el:T, ec:T, rest:T, b:T |- "SModResult"("py:None"(), "LCons"("st:err"(m, l, c, el, ec), rest), b) ~> "st:fail"("st:err"(m, l, c, el, ec));
      "MOD-FUTURE". m:T, l:T, c:T, el:T, ec:T, up:T, b:T |- "SModResult"("st:err"(m, l, c, el, ec), up, b) ~> "st:fail"("st:err"(m, l, c, el, ec));

      -- a block closes: its children in order, the facts it states of the
      -- enclosing blocks absorbed where they belong (a function takes a
      -- comprehension's named expressions, the module takes globals)
      "CLOSE". k:T, n:T, l:T, p:T, a:T, ev:T, ch:T, es:T, pev:T, pch:T, pes:T, ev2:T, up:T, chs:T, pes2:T | "SAbsorb"(es, a, ev, "LNil"()) ~> "st:abs"(ev2, up), "SRevOpen"(ch, "LNil"()) ~> chs, "SRev"(up, pes) ~> pes2 |- "SClose"(k, n, l, p, a, "st:acc"(ev, ch, es), "st:acc"(pev, pch, pes)) ~> "st:acc"(pev, "LCons"("st:block"(k, n, l, p, ev2, chs), pch), pes2);
      -- a block's children in order, its open annotation block closed
      "REV-OPEN-NIL". acc:T |- "SRevOpen"("LNil"(), acc) ~> acc;
      "REV-OPEN-BLOCK". k:T, n:T, l:T, p:T, ev:T, chs:T, rest:T, acc:T, r:T | "SRevOpen"(rest, "LCons"("st:block"(k, n, l, p, ev, chs), acc)) ~> r |- "SRevOpen"("LCons"("st:block"(k, n, l, p, ev, chs), rest), acc) ~> r;
      "REV-OPEN-ANN". pos:T, see:T, aev:T, ach:T, aes:T, rest:T, acc:T, n:T, chs:T, r:T | "py-name"("st:n-annotate"(), n), "SRev"(ach, "LNil"()) ~> chs, "SRevOpen"(rest, "LCons"("st:block"("st:annotation"(), n, pos, "st:props"("py:False"(), "py:False"(), see), aev, chs), acc)) ~> r |- "SRevOpen"("LCons"("st:ann-open"(pos, see, "st:acc"(aev, ach, aes)), rest), acc) ~> r;
      "ABSORB-NIL". a:T, ev:T, up:T |- "SAbsorb"("LNil"(), a, ev, up) ~> "st:abs"(ev, up);
      "ABSORB-FUNCTION". m:T, t:T, rest:T, ev:T, up:T, r:T | "SAbsorb"(rest, "py:fun"(), "LCons"("st:ev"(m, t), ev), up) ~> r |- "SAbsorb"("LCons"("st:esc"("st:to-function"(), m, t), rest), "py:fun"(), ev, up) ~> r;
      "ABSORB-FUNCTION-PASS". m:T, t:T, rest:T, ev:T, up:T, r:T | "SAbsorb"(rest, "py:fun"(), ev, "LCons"("st:esc"("st:to-module"(), m, t), up)) ~> r |- "SAbsorb"("LCons"("st:esc"("st:to-module"(), m, t), rest), "py:fun"(), ev, up) ~> r;
      "ABSORB-MODULE". m:T, t:T, rest:T, ev:T, up:T, r:T | "SAbsorb"(rest, "py:mod"(), "LCons"("st:ev"(m, t), ev), up) ~> r |- "SAbsorb"("LCons"("st:esc"("st:to-module"(), m, t), rest), "py:mod"(), ev, up) ~> r;
      "ABSORB-FUNCTION-ERROR". m:T, l:T, c:T, el:T, ec:T, rest:T, ev:T, up:T, r:T | "SAbsorb"(rest, "py:fun"(), ev, "LCons"("st:err"(m, l, c, el, ec), up)) ~> r |- "SAbsorb"("LCons"("st:err"(m, l, c, el, ec), rest), "py:fun"(), ev, up) ~> r;
      "ABSORB-MODULE-ERROR". m:T, l:T, c:T, el:T, ec:T, rest:T, ev:T, up:T, r:T | "SAbsorb"(rest, "py:mod"(), ev, "LCons"("st:err"(m, l, c, el, ec), up)) ~> r |- "SAbsorb"("LCons"("st:err"(m, l, c, el, ec), rest), "py:mod"(), ev, up) ~> r;
      "ABSORB-NONE". e:T, rest:T, ev:T, up:T, r:T | "SAbsorb"(rest, "py:none"(), ev, "LCons"(e, up)) ~> r |- "SAbsorb"("LCons"(e, rest), "py:none"(), ev, up) ~> r;

      -- ================================================================ facts

      -- a name's fact in the current block, its name mangled inside a class;
      -- a comprehension's target names are also iteration variables
      "DEF". n:T, t:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, acc:T, m:T, r:T | "py-maybe-mangle"(pv, mg, n, m), "SAdd"(m, t, ct, acc) ~> r |- "SDef"(n, t, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r;
      "ADD". m:T, t:T, ev:T, ch:T, es:T |- "SAdd"(m, t, "py:False"(), "st:acc"(ev, ch, es)) ~> "st:acc"("LCons"("st:ev"(m, t), ev), ch, es);
      "ADD-ITER". m:T, t:T, ev:T, ch:T, es:T |- "SAdd"(m, t, "py:True"(), "st:acc"(ev, ch, es)) ~> "st:acc"("LCons"("st:ev"(m, t), "LCons"("st:ev"(m, "st:comp-iter"()), ev)), ch, es);
      -- a global declaration is also the module's
      "GLOBAL-DEF". n:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, ev:T, ch:T, es:T, m:T | "py-maybe-mangle"(pv, mg, n, m) |- "SGlobal"(n, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), "st:acc"(ev, ch, es)) ~> "st:acc"("LCons"("st:ev"(m, "st:global"()), ev), ch, "LCons"("st:esc"("st:to-module"(), m, "st:global"()), es));
      -- a named fact (a name the tables state, by its tag)
      "DEF-NAMED". tag:T, t:T, x:T, acc:T, n:T, r:T | "py-name"(tag, n), "SDef"(n, t, x, acc) ~> r |- "SDefNamed"(tag, t, x, acc) ~> r;

      -- whether a block is function-like (its names can be locals)
      "FUN-MODULE". |- "SFunLike"("st:module"()) ~> "py:False"();
      "FUN-CLASS". |- "SFunLike"("st:class"()) ~> "py:False"();
      "FUN-FUNCTION". |- "SFunLike"("st:function"()) ~> "py:True"();
      "FUN-TYPE-PARAMS". |- "SFunLike"("st:type-params"()) ~> "py:True"();
      "FUN-TYPE-ALIAS". |- "SFunLike"("st:type-alias"()) ~> "py:True"();
      "FUN-TYPE-VAR". |- "SFunLike"("st:type-var"()) ~> "py:True"();
      "FUN-ANNOTATION". |- "SFunLike"("st:annotation"()) ~> "py:True"();
      "IS-CLASS-MODULE". |- "SIsClass"("st:module"()) ~> "py:False"();
      "IS-CLASS-CLASS". |- "SIsClass"("st:class"()) ~> "py:True"();
      "IS-CLASS-FUNCTION". |- "SIsClass"("st:function"()) ~> "py:False"();
      "IS-CLASS-TYPE-PARAMS". |- "SIsClass"("st:type-params"()) ~> "py:False"();
      "IS-CLASS-TYPE-ALIAS". |- "SIsClass"("st:type-alias"()) ~> "py:False"();
      "IS-CLASS-TYPE-VAR". |- "SIsClass"("st:type-var"()) ~> "py:False"();
      "IS-CLASS-ANNOTATION". |- "SIsClass"("st:annotation"()) ~> "py:False"();

      -- ================================================================ sequences

      "STMTS-NIL". x:T, acc:T |- "SStmts"("LNil"(), x, acc) ~> acc;
      "STMTS-CONS". s:T, rest:T, x:T, acc:T, a1:T, r:T | "SStmt"(s, x, acc) ~> a1, "SStmts"(rest, x, a1) ~> r |- "SStmts"("LCons"(s, rest), x, acc) ~> r;
      "EXPRS-NIL". x:T, acc:T |- "SExprs"("LNil"(), x, acc) ~> acc;
      "EXPRS-CONS". e:T, rest:T, x:T, acc:T, a1:T, r:T | "SExpr"(e, x, acc) ~> a1, "SExprs"(rest, x, a1) ~> r |- "SExprs"("LCons"(e, rest), x, acc) ~> r;
      -- a list of optional expressions (a dict's keys, keyword-only defaults)
      "OPTS-NIL". x:T, acc:T |- "SOpts"("LNil"(), x, acc) ~> acc;
      "OPTS-CONS". e:T, rest:T, x:T, acc:T, a1:T, r:T | "SOpt"(e, x, acc) ~> a1, "SOpts"(rest, x, a1) ~> r |- "SOpts"("LCons"(e, rest), x, acc) ~> r;
      "OPT". e:T, x:T, acc:T, f:T, r:T | "py-is-none"(e, f), "SOptIf"(f, e, x, acc) ~> r |- "SOpt"(e, x, acc) ~> r;
      "OPT-NONE". e:T, x:T, acc:T |- "SOptIf"("py:True"(), e, x, acc) ~> acc;
      "OPT-SOME". e:T, x:T, acc:T, r:T | "SExpr"(e, x, acc) ~> r |- "SOptIf"("py:False"(), e, x, acc) ~> r;
      -- an optional name's fact
      "NAME-OPT". n:T, t:T, x:T, acc:T, f:T, r:T | "py-is-none"(n, f), "SNameIf"(f, n, t, x, acc) ~> r |- "SNameOpt"(n, t, x, acc) ~> r;
      "NAME-OPT-NONE". n:T, t:T, x:T, acc:T |- "SNameIf"("py:True"(), n, t, x, acc) ~> acc;
      "NAME-OPT-SOME". n:T, t:T, x:T, acc:T, r:T | "SDef"(n, t, x, acc) ~> r |- "SNameIf"("py:False"(), n, t, x, acc) ~> r;

      -- ================================================================ statements

      -- def: its name, defaults and decorators here; its type parameters,
      -- annotations and body in blocks of their own
      "FUNCTION-DEF". n:T, args:T, body:T, ds:T, rt:T, tc:T, tps:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, a2:T, a3:T, r:T | "SDef"(n, "st:local"(), x, acc) ~> a1, "SArgDefaults"(args, x, a1) ~> a2, "SExprs"(ds, x, a2) ~> a3, "SFunctionRest"(n, args, body, rt, tps, "st:pos"(l, c), x, a3) ~> r |- "SStmt"("py:FunctionDef"(n, args, body, ds, rt, tc, tps, l, c, el, ec), x, acc) ~> r;
      "ASYNC-FUNCTION-DEF". n:T, args:T, body:T, ds:T, rt:T, tc:T, tps:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, a2:T, a3:T, r:T | "SDef"(n, "st:local"(), x, acc) ~> a1, "SArgDefaults"(args, x, a1) ~> a2, "SExprs"(ds, x, a2) ~> a3, "SFunctionRest"(n, args, body, rt, tps, "st:pos"(l, c), x, a3) ~> r |- "SStmt"("py:AsyncFunctionDef"(n, args, body, ds, rt, tc, tps, l, c, el, ec), x, acc) ~> r;
      "FUNCTION-PLAIN". n:T, args:T, body:T, rt:T, l:T, x:T, acc:T, a1:T, r:T | "SAnnotations"(args, rt, l, x, acc) ~> a1, "SFunctionBlock"(n, args, body, l, x, a1) ~> r |- "SFunctionRest"(n, args, body, rt, "LNil"(), l, x, acc) ~> r;
      -- a generic function: its type parameters, annotations and body sit in
      -- a type parameter scope (with .defaults always, .kwdefaults when a
      -- keyword-only parameter has a default)
      "FUNCTION-GENERIC". n:T, args:T, body:T, rt:T, tp:T, tps:T, l:T, x:T, acc:T, x2:T, x2b:T, a0:T, a1:T, a2:T, a3:T, a4:T, r:T | "STpEnter"(x, "st:tp-function"(args)) ~> "st:tpe"(x2, a0), "SKwDefaults"(args, x2, a0) ~> a1, "STypeParams"("LCons"(tp, tps), x2, a1) ~> "st:tpr"(x2b, a2), "SAnnotations"(args, rt, l, x2b, a2) ~> a3, "SFunctionBlock"(n, args, body, l, x2b, a3) ~> a4, "STpClose"(n, l, x, x2, a4, acc) ~> r |- "SFunctionRest"(n, args, body, rt, "LCons"(tp, tps), l, x, acc) ~> r;
      "FUNCTION-BLOCK". n:T, args:T, body:T, l:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, acc:T, a1:T, a2:T, r:T | "SArguments"(args, "st:ctx"("st:function"(), pv, mg, "py:False"(), fu, "py:False"(), "py:False"(), "py:function"()), "st:acc"("LNil"(), "LNil"(), "LNil"())) ~> a1, "SStmts"(body, "st:ctx"("st:function"(), pv, mg, "py:False"(), fu, "py:False"(), "py:False"(), "py:function"()), a1) ~> a2, "SClose"("st:function"(), n, l, "st:props"("py:False"(), "py:False"(), "py:False"()), "py:fun"(), a2, acc) ~> r |- "SFunctionBlock"(n, args, body, l, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r;

      -- class: its name and decorators here; its bases and keywords here (or
      -- in its type parameter scope); its body in a class block where its
      -- name is the private name
      "CLASS-DEF". n:T, bs:T, ks:T, body:T, ds:T, tps:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, a2:T, r:T | "SDef"(n, "st:local"(), x, acc) ~> a1, "SExprs"(ds, x, a1) ~> a2, "SClassRest"(n, bs, ks, body, tps, "st:pos"(l, c), x, a2) ~> r |- "SStmt"("py:ClassDef"(n, bs, ks, body, ds, tps, l, c, el, ec), x, acc) ~> r;
      "CLASS-PLAIN". n:T, bs:T, ks:T, body:T, l:T, x:T, acc:T, a1:T, a2:T, r:T | "SExprs"(bs, x, acc) ~> a1, "SKeywords"(ks, x, a1) ~> a2, "SClassBlock"(n, body, "py:False"(), l, x, a2) ~> r |- "SClassRest"(n, bs, ks, body, "LNil"(), l, x, acc) ~> r;
      "CLASS-GENERIC". n:T, bs:T, ks:T, body:T, tp:T, tps:T, l:T, x:T, acc:T, x2:T, x3:T, x3b:T, a0:T, a1:T, a2:T, a3:T, a4:T, r:T | "STpEnter"(x, "st:tp-class"(n)) ~> "st:tpe"(x2, a0), "STpPrivate"(x2, n) ~> x3, "STypeParams"("LCons"(tp, tps), x3, a0) ~> "st:tpr"(x3b, a1), "SExprs"(bs, x3b, a1) ~> a2, "SKeywords"(ks, x3b, a2) ~> a3, "SClassBlock"(n, body, "py:True"(), l, x3b, a3) ~> a4, "STpClose"(n, l, x, x2, a4, acc) ~> r |- "SClassRest"(n, bs, ks, body, "LCons"(tp, tps), l, x, acc) ~> r;
      "CLASS-BLOCK". n:T, body:T, g:T, l:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, acc:T, a0:T, a1:T, r:T, ca:T, a2:T | "SClassInit"(g, "st:ctx"("st:class"(), n, "py:None"(), "py:False"(), fu, "py:False"(), "py:False"(), "st:no-walrus"("st:class"()))) ~> a0, "SStmts"(body, "st:ctx"("st:class"(), n, "py:None"(), "py:False"(), fu, "py:False"(), "py:False"(), "st:no-walrus"("st:class"())), a0) ~> a1, "py-cond-annotations"(body, ca), "SCondAnn"(ca, "st:ctx"("st:class"(), n, "py:None"(), "py:False"(), fu, "py:False"(), "py:False"(), "st:no-walrus"("st:class"())), a1) ~> a2, "SClose"("st:class"(), n, l, "st:props"("py:False"(), "py:False"(), "py:False"()), "py:none"(), a2, acc) ~> r |- "SClassBlock"(n, body, g, l, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r;
      "CLASS-INIT". x:T |- "SClassInit"("py:False"(), x) ~> "st:acc"("LNil"(), "LNil"(), "LNil"());
      -- a generic class's body sets __type_params__ and reads .type_params
      "CLASS-INIT-GENERIC". x:T, a1:T, r:T | "SDefNamed"("st:n-dunder-type-params"(), "st:local"(), x, "st:acc"("LNil"(), "LNil"(), "LNil"())) ~> a1, "SDefNamed"("st:n-type-params"(), "st:use"(), x, a1) ~> r |- "SClassInit"("py:True"(), x) ~> r;

      -- type X[...] = v: the name here; v in a type alias scope (in a type
      -- parameter scope when generic) that can see an enclosing class
      "TYPE-ALIAS". nm:T, tps:T, v:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, r:T, n:T, nc:T, nl:T, nel:T, nec:T | "SExpr"(nm, x, acc) ~> a1, "SAliasRest"(nm, tps, v, "st:pos"(l, c), x, a1) ~> r |- "SStmt"("py:TypeAlias"(nm, tps, v, l, c, el, ec), x, acc) ~> r;
      "ALIAS-PLAIN". n:T, ctxk:T, nl:T, nc:T, nel:T, nec:T, v:T, l:T, x:T, acc:T, r:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, inc:T | "SIsClass"(k) ~> inc, "SAliasBlock"(n, v, l, inc, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r |- "SAliasRest"("py:Name"(n, ctxk, nl, nc, nel, nec), "LNil"(), v, l, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r;
      "ALIAS-GENERIC". n:T, ctxk:T, nl:T, nc:T, nel:T, nec:T, tp:T, tps:T, v:T, l:T, x:T, acc:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, inc:T, x2:T, x2b:T, a0:T, a1:T, a2:T, r:T | "SIsClass"(k) ~> inc, "STpEnter"("st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), "st:tp-alias"()) ~> "st:tpe"(x2, a0), "STypeParams"("LCons"(tp, tps), x2, a0) ~> "st:tpr"(x2b, a1), "SAliasBlock"(n, v, l, inc, x2b, a1) ~> a2, "STpClose"(n, l, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), x2, a2, acc) ~> r |- "SAliasRest"("py:Name"(n, ctxk, nl, nc, nel, nec), "LCons"(tp, tps), v, l, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r;
      "ALIAS-BLOCK". n:T, v:T, l:T, inc:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, acc:T, a0:T, a1:T, r:T | "SAnnBlockInit"(inc, "st:ctx"("st:type-alias"(), pv, mg, "py:False"(), fu, "py:False"(), inc, "st:no-walrus"("st:type-alias"()))) ~> a0, "SExpr"(v, "st:ctx"("st:type-alias"(), pv, mg, "py:False"(), fu, "py:False"(), inc, "st:no-walrus"("st:type-alias"())), a0) ~> a1, "SClose"("st:type-alias"(), n, l, "st:props"("py:False"(), "py:False"(), inc), "py:none"(), a1, acc) ~> r |- "SAliasBlock"(n, v, l, inc, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r;
      -- a scope that can see a class reads its __classdict__
      "SEES-CLASS-NO". x:T, acc:T |- "SSeesClass"("py:False"(), x, acc) ~> acc;
      "SEES-CLASS". x:T, acc:T, r:T | "SDefNamed"("st:n-classdict"(), "st:use"(), x, acc) ~> r |- "SSeesClass"("py:True"(), x, acc) ~> r;

      -- the simple statements
      "RETURN". v:T, l:T, c:T, el:T, ec:T, x:T, acc:T, r:T | "SOpt"(v, x, acc) ~> r |- "SStmt"("py:Return"(v, l, c, el, ec), x, acc) ~> r;
      "DELETE". ts:T, l:T, c:T, el:T, ec:T, x:T, acc:T, r:T | "SExprs"(ts, x, acc) ~> r |- "SStmt"("py:Delete"(ts, l, c, el, ec), x, acc) ~> r;
      "ASSIGN". ts:T, v:T, tc:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, r:T | "SExprs"(ts, x, acc) ~> a1, "SExpr"(v, x, a1) ~> r |- "SStmt"("py:Assign"(ts, v, tc, l, c, el, ec), x, acc) ~> r;
      "AUG-ASSIGN". t:T, op:T, v:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, r:T | "SExpr"(t, x, acc) ~> a1, "SExpr"(v, x, a1) ~> r |- "SStmt"("py:AugAssign"(t, op, v, l, c, el, ec), x, acc) ~> r;
      -- an annotated name: annotated and local when simple, else local when
      -- given a value; the annotation read here unless annotations are
      -- postponed (from __future__ import annotations)
      "ANN-ASSIGN-NAME". n:T, cx:T, nl:T, nc:T, nel:T, nec:T, an:T, v:T, s:T, l:T, c:T, el:T, ec:T, x:T, acc:T, f:T, a0:T, a1:T, a2:T, r:T | "py-truthy"(s, f), "SAnnCheck"(f, n, "st:at"(l, c, el, ec), x, acc) ~> a0, "SAnnName"(f, n, v, x, a0) ~> a1, "SAnnotation"(an, x, a1) ~> a2, "SOpt"(v, x, a2) ~> r |- "SStmt"("py:AnnAssign"("py:Name"(n, cx, nl, nc, nel, nec), an, v, s, l, c, el, ec), x, acc) ~> r;
      "ANN-ASSIGN-ATTRIBUTE". t:T, an:T, v:T, s:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, a2:T, r:T, tv:T, ta:T, tx:T, tl:T, tc:T, tel:T, tec:T | "SExpr"("py:Attribute"(tv, ta, tx, tl, tc, tel, tec), x, acc) ~> a1, "SAnnotation"(an, x, a1) ~> a2, "SOpt"(v, x, a2) ~> r |- "SStmt"("py:AnnAssign"("py:Attribute"(tv, ta, tx, tl, tc, tel, tec), an, v, s, l, c, el, ec), x, acc) ~> r;
      "ANN-ASSIGN-SUBSCRIPT". an:T, v:T, s:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, a2:T, r:T, tv:T, ts:T, tx:T, tl:T, tc:T, tel:T, tec:T | "SExpr"("py:Subscript"(tv, ts, tx, tl, tc, tel, tec), x, acc) ~> a1, "SAnnotation"(an, x, a1) ~> a2, "SOpt"(v, x, a2) ~> r |- "SStmt"("py:AnnAssign"("py:Subscript"(tv, ts, tx, tl, tc, tel, tec), an, v, s, l, c, el, ec), x, acc) ~> r;
      "ANN-NAME-SIMPLE". n:T, v:T, x:T, acc:T, a1:T, r:T | "SDef"(n, "st:annot"(), x, acc) ~> a1, "SDef"(n, "st:local"(), x, a1) ~> r |- "SAnnName"("py:True"(), n, v, x, acc) ~> r;
      "ANN-NAME-PLAIN". n:T, v:T, x:T, acc:T, f:T, r:T | "py-is-none"(v, f), "SAnnValue"(f, n, x, acc) ~> r |- "SAnnName"("py:False"(), n, v, x, acc) ~> r;
      "ANN-VALUE-NONE". n:T, x:T, acc:T |- "SAnnValue"("py:True"(), n, x, acc) ~> acc;
      "ANN-VALUE-SOME". n:T, x:T, acc:T, r:T | "SDef"(n, "st:local"(), x, acc) ~> r |- "SAnnValue"("py:False"(), n, x, acc) ~> r;
      "ANNOTATION". an:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, acc:T, r:T | "SAnnotationIf"(fu, an, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r |- "SAnnotation"(an, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r;
      "ANNOTATION-POSTPONED". an:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, acc:T, a1:T, r:T | "SExpr"(an, "st:ctx"("st:annotation"(), pv, mg, "py:False"(), fu, "py:False"(), "py:False"(), wt), "st:acc"("LNil"(), "LNil"(), "LNil"())) ~> a1, "SKeepEscapes"(a1, acc) ~> r |- "SAnnotationIf"("py:True"(), an, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r;
      -- an annotated assignment's annotation (3.14+): in its block's one
      -- annotation block, __annotate__, made at the block's first annotation
      -- and kept open in its place among the children, (st:ann-open POS
      -- CAN-SEE ACC), until the block closes; a function's annotations are
      -- not evaluated, so its annotation block states only .format
      -- (symtable_visit_annotation); an annotation's errors are its block's
      "ANNOTATION-READ". an:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, acc:T, fl:T, r:T | "SFunLike"(k) ~> fl, "SAnnScope"(fl, an, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r |- "SAnnotationIf"("py:False"(), an, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r;
      "ANN-SCOPE-LOCAL". an:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, acc:T, pos:T, a1:T, a2:T, r:T | "py-expr-pos"(an, pos), "SAnnOpenEnsure"(pos, "py:False"(), "st:ctx"("st:annotation"(), pv, mg, "py:False"(), fu, "py:False"(), "py:False"(), wt), acc) ~> a1, "SExpr"(an, "st:ctx"("st:annotation"(), pv, mg, "py:False"(), fu, "py:False"(), "py:False"(), wt), "st:acc"("LNil"(), "LNil"(), "LNil"())) ~> a2, "SKeepEscapes"(a2, a1) ~> r |- "SAnnScope"("py:True"(), an, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r;
      "ANN-SCOPE-EVAL". an:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, acc:T, inc:T, pos:T, a1:T, r:T | "SIsClass"(k) ~> inc, "py-expr-pos"(an, pos), "SAnnOpenEnsure"(pos, inc, "st:ctx"("st:annotation"(), pv, mg, "py:False"(), fu, "py:False"(), inc, wt), acc) ~> a1, "SAnnOpenAdd"(an, "st:ctx"("st:annotation"(), pv, mg, "py:False"(), fu, "py:False"(), inc, wt), a1) ~> r |- "SAnnScope"("py:False"(), an, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r;
      "ANN-OPEN-ENSURE". pos:T, see:T, x:T, ev:T, ch:T, es:T, h:T, r:T | "SHasOpenAnn"(ch) ~> h, "SAnnOpenNew"(h, pos, see, x, "st:acc"(ev, ch, es)) ~> r |- "SAnnOpenEnsure"(pos, see, x, "st:acc"(ev, ch, es)) ~> r;
      "ANN-OPEN-HAVE". pos:T, see:T, x:T, acc:T |- "SAnnOpenNew"("py:True"(), pos, see, x, acc) ~> acc;
      "ANN-OPEN-NEW". pos:T, see:T, x:T, ev:T, ch:T, es:T, a0:T | "SAnnBlockInit"(see, x) ~> a0 |- "SAnnOpenNew"("py:False"(), pos, see, x, "st:acc"(ev, ch, es)) ~> "st:acc"(ev, "LCons"("st:ann-open"(pos, see, a0), ch), es);
      "HAS-OPEN-NIL". |- "SHasOpenAnn"("LNil"()) ~> "py:False"();
      "HAS-OPEN-HERE". pos:T, see:T, a:T, rest:T |- "SHasOpenAnn"("LCons"("st:ann-open"(pos, see, a), rest)) ~> "py:True"();
      "HAS-OPEN-NEXT". k:T, n:T, l:T, p:T, ev:T, chs:T, rest:T, r:T | "SHasOpenAnn"(rest) ~> r |- "SHasOpenAnn"("LCons"("st:block"(k, n, l, p, ev, chs), rest)) ~> r;
      "ANN-OPEN-ADD". an:T, x:T, ev:T, ch:T, es:T, ch2:T, ues:T, es2:T | "SAnnOpenVisit"(an, x, ch) ~> "st:aov"(ch2, ues), "SAppend"(ues, es) ~> es2 |- "SAnnOpenAdd"(an, x, "st:acc"(ev, ch, es)) ~> "st:acc"(ev, ch2, es2);
      "AOV-HERE". an:T, x:T, pos:T, see:T, aev:T, ach:T, aes:T, rest:T, bev:T, bch:T, bes:T | "SExpr"(an, x, "st:acc"(aev, ach, "LNil"())) ~> "st:acc"(bev, bch, bes) |- "SAnnOpenVisit"(an, x, "LCons"("st:ann-open"(pos, see, "st:acc"(aev, ach, aes)), rest)) ~> "st:aov"("LCons"("st:ann-open"(pos, see, "st:acc"(bev, bch, "LNil"())), rest), bes);
      "AOV-NEXT". an:T, x:T, k:T, n:T, l:T, p:T, ev:T, chs:T, rest:T, rest2:T, ues:T | "SAnnOpenVisit"(an, x, rest) ~> "st:aov"(rest2, ues) |- "SAnnOpenVisit"(an, x, "LCons"("st:block"(k, n, l, p, ev, chs), rest)) ~> "st:aov"("LCons"("st:block"(k, n, l, p, ev, chs), rest2), ues);
      -- __conditional_annotations__: read by a module with an annotation, and
      -- by a class with one in a conditional block (for, while, if, match,
      -- try, with) (symtable_visit_annotation)
      "COND-ANN-NO". x:T, acc:T |- "SCondAnn"("py:False"(), x, acc) ~> acc;
      "COND-ANN-YES". x:T, acc:T, r:T | "SDefNamed"("st:n-cond-annotations"(), "st:use"(), x, acc) ~> r |- "SCondAnn"("py:True"(), x, acc) ~> r;
      "FOR". t:T, it:T, b:T, o:T, tc:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, a2:T, a3:T, r:T | "SExpr"(t, x, acc) ~> a1, "SExpr"(it, x, a1) ~> a2, "SStmts"(b, x, a2) ~> a3, "SStmts"(o, x, a3) ~> r |- "SStmt"("py:For"(t, it, b, o, tc, l, c, el, ec), x, acc) ~> r;
      "ASYNC-FOR". t:T, it:T, b:T, o:T, tc:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, a2:T, a3:T, r:T | "SExpr"(t, x, acc) ~> a1, "SExpr"(it, x, a1) ~> a2, "SStmts"(b, x, a2) ~> a3, "SStmts"(o, x, a3) ~> r |- "SStmt"("py:AsyncFor"(t, it, b, o, tc, l, c, el, ec), x, acc) ~> r;
      "WHILE". t:T, b:T, o:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, a2:T, r:T | "SExpr"(t, x, acc) ~> a1, "SStmts"(b, x, a1) ~> a2, "SStmts"(o, x, a2) ~> r |- "SStmt"("py:While"(t, b, o, l, c, el, ec), x, acc) ~> r;
      "IF". t:T, b:T, o:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, a2:T, r:T | "SExpr"(t, x, acc) ~> a1, "SStmts"(b, x, a1) ~> a2, "SStmts"(o, x, a2) ~> r |- "SStmt"("py:If"(t, b, o, l, c, el, ec), x, acc) ~> r;
      "WITH". its:T, b:T, tc:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, r:T | "SWithItems"(its, x, acc) ~> a1, "SStmts"(b, x, a1) ~> r |- "SStmt"("py:With"(its, b, tc, l, c, el, ec), x, acc) ~> r;
      "ASYNC-WITH". its:T, b:T, tc:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, r:T | "SWithItems"(its, x, acc) ~> a1, "SStmts"(b, x, a1) ~> r |- "SStmt"("py:AsyncWith"(its, b, tc, l, c, el, ec), x, acc) ~> r;
      "MATCH". s:T, cs:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, r:T | "SExpr"(s, x, acc) ~> a1, "SCases"(cs, x, a1) ~> r |- "SStmt"("py:Match"(s, cs, l, c, el, ec), x, acc) ~> r;
      "RAISE". e:T, cause:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, r:T | "SOpt"(e, x, acc) ~> a1, "SOpt"(cause, x, a1) ~> r |- "SStmt"("py:Raise"(e, cause, l, c, el, ec), x, acc) ~> r;
      "TRY". b:T, hs:T, o:T, f:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, a2:T, a3:T, r:T | "SStmts"(b, x, acc) ~> a1, "SHandlers"(hs, x, a1) ~> a2, "SStmts"(o, x, a2) ~> a3, "SStmts"(f, x, a3) ~> r |- "SStmt"("py:Try"(b, hs, o, f, l, c, el, ec), x, acc) ~> r;
      "TRY-STAR". b:T, hs:T, o:T, f:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, a2:T, a3:T, r:T | "SStmts"(b, x, acc) ~> a1, "SHandlers"(hs, x, a1) ~> a2, "SStmts"(o, x, a2) ~> a3, "SStmts"(f, x, a3) ~> r |- "SStmt"("py:TryStar"(b, hs, o, f, l, c, el, ec), x, acc) ~> r;
      "ASSERT". t:T, m:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, r:T | "SExpr"(t, x, acc) ~> a1, "SOpt"(m, x, a1) ~> r |- "SStmt"("py:Assert"(t, m, l, c, el, ec), x, acc) ~> r;
      -- import and from ... import: a lazy import is refused inside a try
      -- statement, a function or a class, and lazily importing * is refused
      -- (check_lazy_import_context); a from __future__ import after the
      -- module's leading ones is refused once its names are read
      -- (check_import_from); py-mark-imports marked both beforehand
      "IMPORT". ns:T, l:T, c:T, el:T, ec:T, x:T, acc:T, r:T, lz:T, lk:T, a0:T | "py-lazy-kind"(lz, lk), "SLazyCheck"(lk, "st:lz-import"(), "st:at"(l, c, el, ec), x, acc) ~> a0, "SAliases"(ns, x, a0) ~> r |- "SStmt"("py:Import"(ns, lz, l, c, el, ec), x, acc) ~> r;
      "IMPORT-FROM". m:T, ns:T, lv:T, l:T, c:T, el:T, ec:T, x:T, acc:T, r:T, lz:T, lk:T, a0:T, a1:T, a2:T, sr:T, lf:T | "py-lazy-kind"(lz, lk), "SLazyCheck"(lk, "st:lz-from"(), "st:at"(l, c, el, ec), x, acc) ~> a0, "py-lazy-star"(lk, ns, sr), "SErrIf"(sr, "st:m-lazy-star"(), "py:None"(), "py:None"(), "st:at"(l, c, el, ec), a0) ~> a1, "SAliases"(ns, x, a1) ~> a2, "py-late-future"(m, lf), "SErrIf"(lf, "st:m-late-future"(), "py:None"(), "py:None"(), "st:at"(l, c, el, ec), a2) ~> r |- "SStmt"("py:ImportFrom"(m, ns, lv, lz, l, c, el, ec), x, acc) ~> r;
      "LAZY-NO". kd:T, at:T, x:T, acc:T |- "SLazyCheck"("st:lazy-no"(), kd, at, x, acc) ~> acc;
      "LAZY-TRY". kd:T, at:T, x:T, acc:T, r:T | "SErrTag"("st:m-lazy-try"(), kd, "py:None"(), at, acc) ~> r |- "SLazyCheck"("st:lazy-try"(), kd, at, x, acc) ~> r;
      "LAZY-HERE". kd:T, at:T, k:T, pv:T, mg:T, ct:T, fu:T, ic:T, cs:T, wt:T, acc:T, r:T | "SLazyIn"(k, kd, at, acc) ~> r |- "SLazyCheck"("st:lazy-yes"(), kd, at, "st:ctx"(k, pv, mg, ct, fu, ic, cs, wt), acc) ~> r;
      "LAZY-IN-MODULE". kd:T, at:T, acc:T |- "SLazyIn"("st:module"(), kd, at, acc) ~> acc;
      "LAZY-IN-FUNCTION". kd:T, at:T, acc:T, r:T | "SErrTag"("st:m-lazy-function"(), kd, "py:None"(), at, acc) ~> r |- "SLazyIn"("st:function"(), kd, at, acc) ~> r;
      "LAZY-IN-CLASS". kd:T, at:T, acc:T, r:T | "SErrTag"("st:m-lazy-class"(), kd, "py:None"(), at, acc) ~> r |- "SLazyIn"("st:class"(), kd, at, acc) ~> r;
      "GLOBAL". ns:T, l:T, c:T, el:T, ec:T, x:T, acc:T, r:T | "SGlobals"(ns, "st:at"(l, c, el, ec), x, acc) ~> r |- "SStmt"("py:Global"(ns, l, c, el, ec), x, acc) ~> r;
      "GLOBALS-NIL". at:T, x:T, acc:T |- "SGlobals"("LNil"(), at, x, acc) ~> acc;
      "GLOBALS-CONS". n:T, rest:T, at:T, x:T, acc:T, f:T, a0:T, a1:T, a2:T, r:T | "SFlagsNow"(n, x, acc) ~> f, "SDeclCheck"("st:global"(), f, n, at, acc) ~> a0, "SGlobal"(n, x, a0) ~> a1, "SDirective"(n, at, x, a1) ~> a2, "SGlobals"(rest, at, x, a2) ~> r |- "SGlobals"("LCons"(n, rest), at, x, acc) ~> r;
      "NONLOCAL". ns:T, l:T, c:T, el:T, ec:T, x:T, acc:T, r:T | "SNonlocals"(ns, "st:at"(l, c, el, ec), x, acc) ~> r |- "SStmt"("py:Nonlocal"(ns, l, c, el, ec), x, acc) ~> r;
      "NONLOCALS-NIL". at:T, x:T, acc:T |- "SNonlocals"("LNil"(), at, x, acc) ~> acc;
      "NONLOCALS-CONS". n:T, rest:T, at:T, x:T, acc:T, f:T, a0:T, a1:T, a2:T, r:T | "SFlagsNow"(n, x, acc) ~> f, "SDeclCheck"("st:nonlocal"(), f, n, at, acc) ~> a0, "SDef"(n, "st:nonlocal"(), x, a0) ~> a1, "SDirective"(n, at, x, a1) ~> a2, "SNonlocals"(rest, at, x, a2) ~> r |- "SNonlocals"("LCons"(n, rest), at, x, acc) ~> r;
      "EXPR". v:T, l:T, c:T, el:T, ec:T, x:T, acc:T, r:T | "SExpr"(v, x, acc) ~> r |- "SStmt"("py:Expr"(v, l, c, el, ec), x, acc) ~> r;
      "PASS". l:T, c:T, el:T, ec:T, x:T, acc:T |- "SStmt"("py:Pass"(l, c, el, ec), x, acc) ~> acc;
      "BREAK". l:T, c:T, el:T, ec:T, x:T, acc:T |- "SStmt"("py:Break"(l, c, el, ec), x, acc) ~> acc;
      "CONTINUE". l:T, c:T, el:T, ec:T, x:T, acc:T |- "SStmt"("py:Continue"(l, c, el, ec), x, acc) ~> acc;

      -- ================================================================ expressions

      -- a name read is used (super, read in a function, also uses __class__);
      -- a name stored into or deleted is local
