      "UNARY-OP". op:T, a:T, l:T, c:T, el:T, ec:T, x:T, acc:T, r:T | "SExpr"(a, x, acc) ~> r |- "SExpr"("py:UnaryOp"(op, a, l, c, el, ec), x, acc) ~> r;
