      "IF-EXP". t:T, b:T, o:T, l:T, c:T, el:T, ec:T, x:T, acc:T, a1:T, a2:T, r:T | "SExpr"(t, x, acc) ~> a1, "SExpr"(b, x, a1) ~> a2, "SExpr"(o, x, a2) ~> r |- "SExpr"("py:IfExp"(t, b, o, l, c, el, ec), x, acc) ~> r;
