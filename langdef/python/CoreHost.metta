; The host relations of Core.module, with their modes and their realization
; on CeTTa's PeTTa lane (functions of host_core.metta):
;   (py-core-value CONSTANT VALUE)  the runtime's value of a constant
;   (py-core-none NONE)            Python's None
;   (py-core-name TAG NAME)        the names the core states
;   (py-slot SLOTS NAME INDEX)     a name's slot
;   (py-slot-count SLOTS N)        how many slots
;   (py-child-table CHILDREN KIND POS TABLE)  the table of a block by where it stands
;   (py-call-shape FUNC ARGS KEYWORDS SHAPE)  how CPython compiles a call
;   (py-is-starred EXPR FLAG)      whether an element is starred
;   (py-set-display ITEMS FORM)  how CPython builds a set display: of its constants, or item by item
;   (py-iter-operand ASYNC EXPR OPERAND)  a for loop's iterable as the loop reads it: (c:folded-set
;                                VALUES) for a set display the optimizer makes a constant, or itself
;   (py-contains-operand OP EXPR OPERAND)  a comparison's last operand, the same way for in and not in
;   (py-code-warnings NODE WARNINGS)  the code generator's SyntaxWarnings for a node, as statements
;   (py-unpack-shape TARGETS SHAPE)  how a target list unpacks: exactly, or around its starred target
;   (py-sequence-shape PATTERNS SHAPE)  how a sequence pattern checks the length and takes the items
;   (py-mapping-shape KEYS REST SHAPE)  whether a mapping pattern checks keys and the length
;   (py-class-names ATTRS TUPLE)  a class pattern's keyword attribute names as a tuple
;   (py-or-control STORES N CONTROL)  an or-pattern's captures given temporaries
;   (py-or-assigns CONTROL STORES ASSIGNS)  an alternative's captures moved into them
;   (py-pattern-error PATTERN GUARD LAST ERROR)  the first compile error of a case's pattern, or (c:no-error)
;   (py-comp-async GENERATORS ELT VALUE FLAG)  whether a comprehension is asynchronous (PEP 530)
;   (py-qualname-inner QUALNAME PREFIX)  the prefix of the names it holds
;   (py-qualname PREFIX NAME QUALNAME)  a function's qualified name
;   (py-code-layout ARGS TABLE PRIVATE LAYOUT)  a function's frame layout, its parameters' names mangled
;   (py-import-from-parts ALIASES (c:from-parts FROMLIST PARTS))  the fromlist tuple and each name's binding
;   (py-import-module-name MODULE NAME)  from-import's module name, "" for none
;   (py-import-binding NAME ASNAME BIND)  (c:bind-top TOP) or (c:bind-as ATTRS ASNAME)
;   (py-conversion-kind N KIND)  an f-string field's conversion: -1 none, 115 str, 114 repr, 97 ascii
;   (py-genexp-args L C EL EC ARGS)  a generator expression's parameters: .0
;   (py-has-yield BODY FLAG)  (py:True) when a function's body yields (a generator function)
;   (py-setup-annotations BODY FLAG)  (py:True) when a module's or class's body under from __future__ import annotations annotates
;   (py-fn-has-annotations ARGS RETURNS FLAG)  whether a function has annotations
;   (py-annotate-qualname QUALNAME AQUALNAME)  its __annotate__ function's qualname
;   (py-annotate-body ARGS RETURNS PRIVATE POS BODY)  its __annotate__ function's statements
;   (py-annotate-args POS ARGS)    its __annotate__ function's one parameter, .format
;   (py-annotate-spec SPEC SPEC2)  .format shown as format
;   (py-pos-line POS LINE)  a position's line
;   (py-node-span NODE SPAN)  where a node stands: (c:span L C EL EC), or (c:no-span)
;   (py-comp-elt ELEMENT FORM)  a comprehension's element: (c:star VALUE) when unpacked, else (c:plain ELEMENT)
;   (py-template-strings PARTS STRINGS)  a template string's strings as one tuple (codegen_template_str)
;   (py-import-mode MARK MODE)  an import's IMPORT_NAME mode: (c:imp-lazy), (c:imp-maybe) or (c:imp-eager)
;   (py-annotation-table CHILDREN POS TABLE)  a function's annotation block, also when the table leaves it out
;   (py-deferred KIND BODY PRIVATE (c:deferred ENTRIES BODY2))  a module's or class's deferred annotations, its simple targets marked
;   (py-ann-register SIMPLE REG)  what a simple annotated name registers: (c:register INDEX) or (c:no-register)
;   (py-first-annotation-pos BODY POS)  where a module's or class's annotation block stands
;   (py-deferred-layout KIND ENTRIES ARGS TABLE PRIVATE LAYOUT)  the frame of a module's or class's __annotate__
;   (py-deferred-cond KIND SLOTS ATOM)  how that __annotate__ reads __conditional_annotations__
;   (py-deferred-stmts ENTRIES DICT CA STMTS)  its statements after the prologue
;   (py-annotate-prologue POS STMTS)  an __annotate__'s first statement: a format above 2 raises NotImplementedError
;   (py-closure-scope KIND SYMBOLS NAME SCOPE)  a name a closure takes from its block, a class's implicit cells as cells
;   (py-ann-subscript-parts INDEX PARTS)  what a bare annotated subscript evaluates of its index
;   (py-comp-table CHILDREN POS TABLE)  an inlined comprehension's own table
;   (py-comp-names KIND SYMBOLS SLOTS N NAMES)  the names an inlined comprehension sees
;   (py-class-inner QUALNAME PREFIX)  the prefix of a class's names: its qualname and a dot
;   (py-class-layout TABLE BODY LAYOUT)  a class body's frame: its implicit cells, the free names
;   (py-start-pos E POS)  where an expression starts, (st:pos LINE COLUMN): the block of a bound or default stands there
;   (py-tp-default-error NAME MESSAGE)  the error for a type parameter without a default after one with
;   (py-star-default DEFAULT VALUE)  a TypeVarTuple's default as its function returns it: *X unpacked to its one item
;   (py-kw-default-names KWONLY KWDEFAULTS NAMES)  the keyword-only parameters that have defaults, in order
;   (py-count-indexes LIST INDEXES)  0, 1, ... as many as the list has items
;   (py-tp-arguments ARGS TPARGS)  the parameters of a generic function's type parameter scope: .defaults, .kwdefaults
;   (py-generic-name NAME SCOPE)  the name of a generic definition's type parameter scope
;   (py-child-table-nth CHILDREN KIND POS NTH TABLE)  the (c:first) table of a block by where it stands
;   (py-bound-kind BOUND KIND)  a type variable's bound: (c:no-bound), (c:constraints) for a tuple, else (c:bound)
;   (py-classdict-slot SLOTS SLOT)  a scope that sees a class: (c:cell SLOT) of its free __classdict__, else (c:no-cell)
;   (py-class-cells TABLE BODY CELLS)  a class body's own cells: (c:class-cells CLASS CLASSDICT CONDITIONAL), each (c:cell SLOT) or (c:no-cell)
;   (py-docstring BODY DOC)        (c:doc TEXT REST) when the body starts with a string, else (c:no-doc)
;   (py-static-attributes BODY T)  a class's __static_attributes__
;   (py-first-line DECORATORS LINE FIRST)  a class's first line: its first decorator's, else its own
(gslt-presentation-v1 PythonCoreHostV1
  (signature
    (operator py-core-value 2)
    (operator py-core-none 1)
    (operator py-core-name 2)
    (operator py-slot 3)
    (operator py-slot-count 2)
    (operator py-child-table 4)
    (operator py-call-shape 4)
    (operator py-comp-async 4)
