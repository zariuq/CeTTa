      (body))
    (rule py-takes-capability (head (oslf-external-relation-decl-v1 py-takes 3)) (body))
    (rule py-takes-modes (head (oslf-external-relation-modes-v1 py-takes "110")) (body))
    (rule py-takes-petta
      (head (metta-equation (gslt:py-takes (py-takes ?a0 ?a1 ?o))
                            (let ?x (pyrt:takes ?a0 ?a1) (quote (py-takes ?a0 ?a1 ?x)))))
