; The host relations of Machine.module, with their modes and their realization
; on CeTTa's PeTTa lane (functions of host_runtime.metta):
;   (py-module-frame CODE FRAME)   the module's frame, its globals made
;   (py-eval OP FRAME RESULT)      one core operation: (m:val V), (m:err E) or (m:call CODE FRAME)
;   (py-store TARGET VALUE FRAME FRAME2)  a value put where a target says
;   (py-truth ATOM FRAME TRUTH)    (m:true), (m:false) or (m:err E)
;   (py-takes COMPLETION FRAME HOW)  whether a loop or block takes a break or continue
;   (py-none NONE)                 Python's None
;   (py-status OUTCOME STATUS)     a run's exit status
;   (py-report EXCEPTION STATUS)   an uncaught exception reported on standard error
;   (py-raise-start EXCEPTION FRAME K RAISED)  an exception made an instance as it is raised in FRAME (continuation K), its context the one being handled, an entry for FRAME in its traceback
;   (py-warn-at CATEGORY MESSAGE FRAME K RESULT)  a warning the runtime raises in FRAME (continuation K): (m:val None) or (m:err E)
;   (py-frame-at DEPTH FRAME K RESULT)  sys._getframe(DEPTH) in FRAME (continuation K): (m:val FRAMEOBJ) or (m:err E)
;   (py-tb-here EXC FRAME K EXC2)  an exception raised in FRAME again (thrown in, or a delegate's): FRAME's entry put in its traceback
;   (py-traceback-here EXC CALLEE FRAME K EXC2)  an exception leaving CALLEE for FRAME (continuation K): FRAME's entry put in its traceback
;   (py-handle EXCEPTION OK)       a handler begins: the exception being handled
;   (py-unhandle OK)               a handler ends: the one before is handled again
;   (py-handled-now RESULT)        the exception being handled, for a bare raise
;   (py-delete TARGET FRAME RESULT)  a name unbound: (m:val FRAME2) or (m:err E)
;   (py-with-exit EXIT HOW RESULT)  __exit__ called: (m:val SUPPRESS) with SUPPRESS py:True/py:False, or (m:err E)
;   (py-before-with ATOM FRAME RESULT)  BEFORE_WITH: (m:val (c:entered EXIT VALUE)) or (m:err E)
;   (py-propagate EXC EXC2)         an exception leaving a run for its caller: propagating, not chained again there
;   (py-yf-throw ITER EXC RESULT)   yield from passes on a thrown exception
;   (py-yf-send ITER VALUE RESULT)  yield from sends: (m:yielded V), (m:returned V) or (m:err E)
;   (py-gen-raised GEN EXC EXC2)    a generator ended by an exception: a StopIteration becomes a RuntimeError (PEP 479)
;   (py-gen-finish GEN OK)          a generator ended
;   (py-gen-suspend K WHERE FRAME OUTER)  a yield: the continuation up to the generator's delimiter kept with the frame; OUTER the delimiter's continuation
(gslt-presentation-v1 PythonMachineHostV1
  (signature
    (operator py-module-frame 2)
    (operator py-eval 3)
    (operator py-store 4)
    (operator py-truth 3)
    (operator py-takes 3)
    (operator py-none 1)
    (operator py-status 2)
    (operator py-report 2)
    (operator py-raise-start 4)
    (operator py-traceback-here 5)
    (operator py-tb-here 4)
    (operator py-frame-at 4)
    (operator py-warn-at 5)
    (operator py-handle 2)
    (operator py-unhandle 1)
    (operator py-handled-now 1)
    (operator py-gen-suspend 4)
    (operator py-gen-finish 2)
    (operator py-gen-raised 3)
    (operator py-yf-send 3)
    (operator py-yf-throw 3)
    (operator py-propagate 2)
    (operator py-before-with 3)
    (operator py-with-exit 3)
    (operator py-delete 3)
    (operator gslt:py-module-frame 1)
    (operator gslt:py-eval 1)
    (operator gslt:py-store 1)
    (operator gslt:py-truth 1)
    (operator gslt:py-takes 1)
    (operator gslt:py-none 1)
    (operator gslt:py-status 1)
    (operator gslt:py-report 1)
    (operator gslt:py-raise-start 1)
    (operator gslt:py-traceback-here 1)
    (operator gslt:py-tb-here 1)
    (operator gslt:py-frame-at 1)
    (operator gslt:py-warn-at 1)
    (operator gslt:py-handle 1)
    (operator gslt:py-unhandle 1)
    (operator gslt:py-handled-now 1)
    (operator gslt:py-gen-suspend 1)
    (operator gslt:py-gen-finish 1)
    (operator gslt:py-gen-raised 1)
    (operator gslt:py-yf-send 1)
    (operator gslt:py-yf-throw 1)
    (operator gslt:py-propagate 1)
    (operator gslt:py-before-with 1)
    (operator gslt:py-with-exit 1)
    (operator gslt:py-delete 1)
    (operator pyrt:with-exit 2)
    (operator pyrt:before-with 2)
    (operator pyrt:propagating 1)
    (operator pyrt:yf-throw 2)
    (operator pyrt:yf-send 2)
    (operator pyrt:gen-raised 2)
    (operator pyrt:gen-finish 1)
    (operator pyrt:gen-suspend 3)
    (operator pyrt:module-frame 1)
    (operator pyrt:eval 2)
    (operator pyrt:store 3)
    (operator pyrt:truth 2)
    (operator pyrt:takes 2)
    (operator pyrt:none 0)
    (operator pyrt:status 1)
    (operator pyrt:report 1)
    (operator pyrt:raise-start 3)
    (operator pyrt:traceback-here 4)
    (operator pyrt:tb-here-again 3)
    (operator pyrt:frame-at 3)
    (operator pyrt:warn-at 4)
    (operator pyrt:handle 1)
    (operator pyrt:unhandle 0)
    (operator pyrt:handled-now 0)
    (operator pyrt:delete 2)
    (operator oslf-external-relation-decl-v1 2)
    (operator oslf-external-relation-modes-v1 2)
    (operator metta-equation 2)
    (operator let 3)
    (operator quote 1))
  (equations)
  (rewrites
    (rule py-module-frame-capability (head (oslf-external-relation-decl-v1 py-module-frame 2)) (body))
    (rule py-module-frame-modes (head (oslf-external-relation-modes-v1 py-module-frame "10")) (body))
    (rule py-module-frame-petta
      (head (metta-equation (gslt:py-module-frame (py-module-frame ?a0 ?o))
                            (let ?x (pyrt:module-frame ?a0) (quote (py-module-frame ?a0 ?x)))))
      (body))
    (rule py-eval-capability (head (oslf-external-relation-decl-v1 py-eval 3)) (body))
    (rule py-eval-modes (head (oslf-external-relation-modes-v1 py-eval "110")) (body))
    (rule py-eval-petta
      (head (metta-equation (gslt:py-eval (py-eval ?a0 ?a1 ?o))
                            (let ?x (pyrt:eval ?a0 ?a1) (quote (py-eval ?a0 ?a1 ?x)))))
      (body))
    (rule py-store-capability (head (oslf-external-relation-decl-v1 py-store 4)) (body))
    (rule py-store-modes (head (oslf-external-relation-modes-v1 py-store "1110")) (body))
    (rule py-store-petta
      (head (metta-equation (gslt:py-store (py-store ?a0 ?a1 ?a2 ?o))
                            (let ?x (pyrt:store ?a0 ?a1 ?a2) (quote (py-store ?a0 ?a1 ?a2 ?x)))))
      (body))
