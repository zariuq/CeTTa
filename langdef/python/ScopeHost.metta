; The host relations of Scope.module, with their modes and their realization
; on CeTTa's PeTTa lane (functions of host_scope.metta):
;   (py-maybe-mangle CLASS MANGLED NAME MANGLED-NAME)  private-name mangling
;   (py-has SET X FLAG)           (py:True) when X is in SET, else (py:False)
;   (py-set-add SET X SET2)       sets of names: sorted lists without repeats
;   (py-set-union A B AB)
;   (py-set-diff A B A-B)
;   (py-group EVENTS SYMBOLS)     a block's (st:ev NAME FLAG) events grouped as
;                                 (st:sym NAME FLAGS)
;   (py-flags-number FLAGS SCOPE N)  CPython's number for a symbol
;   (py-dotted-head NAME HEAD)    the name an import binds
;   (py-name TAG NAME)            the names the symbol tables state
;   (py-name-is NAME TAG FLAG)    (py:True) when NAME is the name TAG states
;   (py-any-annotation BODY FLAG)  whether a module body annotates in its own scope
;   (py-mark-imports BODY BODY2)  a module body with its lazy imports in try statements and late future imports marked
;   (py-lazy-kind IS-LAZY KIND)   an import's laziness: (st:lazy-no), (st:lazy-yes) or (st:lazy-try)
;   (py-lazy-star KIND NAMES FLAG)  whether a lazy from ... import imports *
;   (py-late-future MODULE FLAG)  whether a from ... import is a marked late future import
;   (py-cond-annotations BODY FLAG)  whether a class body annotates in a conditional block
;   (py-future-annotations BODY FLAG)  whether the module's leading future
;                                 imports name annotations
;   (py-is-none X FLAG)           (py:True) when an optional field is absent
;   (py-truthy N FLAG)            (py:True) when a number is nonzero
;   (py-empty-set S)              the empty set of names
;   (py-set-list SET LIST)        a set's names as a list
;   (py-lookup SYMBOLS NAME FLAGS)        a symbol's flags, or (py:None)
;   (py-lookup-scope SYMBOLS NAME SCOPE)  a final symbol's scope, or (py:None)
;   (py-expr-pos E POS)           where an expression starts, (st:pos LINE COLUMN)
;   (py-set-remove SET X SET2)    a set without X
;   (py-add-flag SYMBOLS NAME FLAG SYMBOLS2)  a final symbol given one more flag
;   (py-flags-now EVENTS ESCAPES MODE NAME FLAGS)  a name's flags in the block being read, as they stand
;   (py-message TAG A B TEXT)     CPython's message for an error
;   (py-comp-iters EVENTS SET)    the names a comprehension's events make iteration variables
;   (py-directive EVENTS NAME AT) where the first directive naming NAME stands
;   (py-first-bad SYMBOLS EVENTS BAD)  the erroneous symbol CPython meets first
;   (py-bound-info BOUND INFO)    a TypeVar bound or constraint
;   (py-future-error BODY ERROR)  the error the module's future statements raise
(gslt-presentation-v1 PythonScopeHostV1
  (signature
    (operator py-maybe-mangle 4)
    (operator py-has 3)
    (operator py-set-add 3)
    (operator py-set-union 3)
    (operator py-set-diff 3)
    (operator py-group 2)
    (operator py-flags-number 3)
    (operator py-dotted-head 2)
    (operator py-name 2)
    (operator py-name-is 3)
    (operator py-future-annotations 2)
    (operator py-any-annotation 2)
    (operator py-mark-imports 2)
    (operator py-lazy-kind 2)
    (operator py-lazy-star 3)
    (operator py-late-future 2)
    (operator py-cond-annotations 2)
    (operator py-is-none 2)
    (operator py-truthy 2)
    (operator py-empty-set 1)
    (operator py-set-list 2)
    (operator py-lookup 3)
    (operator py-lookup-scope 3)
    (operator py-expr-pos 2)
    (operator py-set-remove 3)
    (operator py-add-flag 4)
    (operator py-flags-now 5)
    (operator py-message 4)
    (operator py-comp-iters 2)
    (operator py-directive 3)
    (operator py-first-bad 3)
    (operator py-bound-info 2)
    (operator py-future-error 2)
    (operator gslt:py-maybe-mangle 1)
    (operator gslt:py-has 1)
    (operator gslt:py-set-add 1)
    (operator gslt:py-set-union 1)
    (operator gslt:py-set-diff 1)
    (operator gslt:py-group 1)
    (operator gslt:py-flags-number 1)
    (operator gslt:py-dotted-head 1)
    (operator gslt:py-name 1)
    (operator gslt:py-name-is 1)
    (operator gslt:py-future-annotations 1)
    (operator gslt:py-any-annotation 1)
    (operator gslt:py-mark-imports 1)
    (operator gslt:py-lazy-kind 1)
    (operator gslt:py-lazy-star 1)
    (operator gslt:py-late-future 1)
    (operator gslt:py-cond-annotations 1)
    (operator gslt:py-is-none 1)
    (operator gslt:py-truthy 1)
    (operator gslt:py-empty-set 1)
    (operator gslt:py-set-list 1)
    (operator gslt:py-lookup 1)
    (operator gslt:py-lookup-scope 1)
    (operator gslt:py-expr-pos 1)
    (operator gslt:py-set-remove 1)
    (operator gslt:py-add-flag 1)
    (operator gslt:py-flags-now 1)
    (operator gslt:py-message 1)
    (operator gslt:py-comp-iters 1)
    (operator gslt:py-directive 1)
    (operator gslt:py-first-bad 1)
    (operator gslt:py-bound-info 1)
    (operator gslt:py-future-error 1)
    (operator pyhost:maybe-mangle 3)
    (operator pyhost:has 2)
    (operator pyhost:set-add 2)
    (operator pyhost:set-union 2)
    (operator pyhost:set-diff 2)
    (operator pyhost:group 1)
    (operator pyhost:flags-number 2)
    (operator pyhost:dotted-head 1)
    (operator pyhost:name 1)
    (operator pyhost:name-is 2)
    (operator pyhost:future-annotations 1)
    (operator pyhost:any-annotation 1)
    (operator pyhost:mark-imports 1)
    (operator pyhost:lazy-kind 1)
    (operator pyhost:lazy-star 2)
    (operator pyhost:late-future 1)
    (operator pyhost:cond-annotations 1)
    (operator pyhost:is-none 1)
    (operator pyhost:truthy 1)
    (operator pyhost:empty-set 0)
    (operator pyhost:set-list 1)
    (operator pyhost:lookup 2)
    (operator pyhost:lookup-scope 2)
    (operator pyhost:expr-pos 1)
    (operator pyhost:set-remove 2)
    (operator pyhost:add-flag 3)
    (operator pyhost:flags-now 4)
    (operator pyhost:message 3)
    (operator pyhost:comp-iters 1)
    (operator pyhost:directive 2)
    (operator pyhost:first-bad 2)
    (operator pyhost:bound-info 1)
    (operator pyhost:future-error 1)
    (operator oslf-external-relation-decl-v1 2)
    (operator oslf-external-relation-modes-v1 2)
    (operator metta-equation 2)
    (operator let 3)
    (operator quote 1))
  (equations)
  (rewrites
    (rule py-maybe-mangle-capability (head (oslf-external-relation-decl-v1 py-maybe-mangle 4)) (body))
