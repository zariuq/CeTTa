(= (tptp:syntax-tree->raw (tptp-cst:pair $left $right)) (pair (tptp:syntax-tree->raw $left) (tptp:syntax-tree->raw $right)))
(= (tptp:syntax-tree->raw (tptp-cst:some $value)) (some (tptp:syntax-tree->raw $value)))
(= (tptp:term (node application (pair $word (node arguments $arguments))) $scope) (fo-cnf:term-function (tptp:symbol-name $word) (tptp:arguments $arguments $scope)))
(= (tptp:term (node constant $word) $scope) (fo-cnf:term-function (tptp:symbol-name $word) (fo-cnf:terms-nil)))
(= (tptp:term (node defined-application (pair $word (node arguments $arguments))) $scope) (fo-cnf:term-function (tptp:symbol-name $word) (tptp:arguments $arguments $scope)))
(= (tptp:term (node defined-constant $word) $scope) (fo-cnf:term-function (tptp:symbol-name $word) (fo-cnf:terms-nil)))
(= (tptp:term (node distinct $object) $scope) (fo-cnf:term-distinct (tptp:text $object)))
(= (tptp:term (node number $number) $scope) (fo-cnf:term-number (tptp:numeric-kind $number) (tptp:text $number)))
(= (tptp:term-rest (cons $first $rest) $scope) (fo-cnf:terms-cons (tptp:term $first $scope) (tptp:term-rest $rest $scope)))
(= (tptp:term-rest nil $scope) (fo-cnf:terms-nil))
(= (tptp:term (node system-application (pair $word (node arguments $arguments))) $scope) (fo-cnf:term-function (tptp:symbol-name $word) (tptp:arguments $arguments $scope)))
(= (tptp:term (node system-constant $word) $scope) (fo-cnf:term-function (tptp:symbol-name $word) (fo-cnf:terms-nil)))
(= (tptp:term (node variable (node upper-word $characters)) $scope) (fo-cnf:term-variable (fo-cnf:variable-id $scope (fo-cnf:variable-name (langdef:codepoints->string $characters)))))
(= (tptp:text (node back-quoted $characters)) (langdef:codepoints->string $characters))
(= (tptp:text (node defined-word $characters)) (langdef:codepoints->string $characters))
(= (tptp:text (node distinct-object $characters)) (langdef:codepoints->string $characters))
(= (tptp:text (node integer $characters)) (langdef:codepoints->string $characters))
(= (tptp:text (node lower-word $characters)) (langdef:codepoints->string $characters))
(= (tptp:text (node rational $characters)) (langdef:codepoints->string $characters))
(= (tptp:text (node real $characters)) (langdef:codepoints->string $characters))
(= (tptp:text (node single-quoted $characters)) (langdef:codepoints->string $characters))
(= (tptp:text (node system-word $characters)) (langdef:codepoints->string $characters))
(= (tptp:text (node upper-word $characters)) (langdef:codepoints->string $characters))
