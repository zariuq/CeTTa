(gslt-presentation-v1 prime-closed-formation-v1
  (signature
    (operator PCons 2)
    (operator PArrow 1)
    (operator PrimeForm 1)
    (operator PrimeFormComponents 1)
    (operator PrimeNotForm 1)
  )
  (equations)
  (rewrites
    (rule prime-form-type (head (PrimeForm PType)) (body))
    (rule prime-form-dynamic (head (PrimeForm PDynamic)) (body))
    (rule prime-form-atom (head (PrimeForm PAtom)) (body))
    (rule prime-form-symbol (head (PrimeForm PSymbol)) (body))
    (rule prime-form-variable (head (PrimeForm PVariable)) (body))
    (rule prime-form-expression (head (PrimeForm PExpression)) (body))
    (rule prime-form-grounded (head (PrimeForm PGrounded)) (body))
    (rule prime-form-number (head (PrimeForm PNumber)) (body))
    (rule prime-form-bool (head (PrimeForm PBool)) (body))
    (rule prime-form-string (head (PrimeForm PString)) (body))
    (rule prime-form-error (head (PrimeForm PError)) (body))
    (rule prime-form-components-one (head (PrimeFormComponents (PCons ?t PNil))) (body (PrimeForm ?t)))
    (rule prime-form-components-cons (head (PrimeFormComponents (PCons ?t ?ts))) (body (PrimeForm ?t) (PrimeFormComponents ?ts)))
    (rule prime-form-arrow (head (PrimeForm (PArrow ?ts))) (body (PrimeFormComponents ?ts)))
    (rule prime-not-form-empty-arrow (head (PrimeNotForm (PArrow PNil))) (body))
  ))
