(gslt-presentation-v1 he-typing-consistency-core
  (signature
    (operator HTList 1)
    (operator HTArrow 2)
    (operator HEType 1)
    (operator HENonDynamic 1)
    (operator HEOrdinaryRoot 1)
    (operator HEConsistent 3)
  )
  (equations)
  (rewrites
    (rule type-number (head (HEType HTNumber)) (body))
    (rule type-string (head (HEType HTString)) (body))
    (rule type-bool (head (HEType HTBool)) (body))
    (rule type-dynamic (head (HEType HTDynamic)) (body))
    (rule type-atom (head (HEType HTAtom)) (body))
    (rule type-list (head (HEType (HTList ?t))) (body (HEType ?t)))
    (rule type-arrow (head (HEType (HTArrow ?a ?r))) (body (HEType ?a) (HEType ?r)))
    (rule non-dynamic-number (head (HENonDynamic HTNumber)) (body))
    (rule non-dynamic-string (head (HENonDynamic HTString)) (body))
    (rule non-dynamic-bool (head (HENonDynamic HTBool)) (body))
    (rule non-dynamic-atom (head (HENonDynamic HTAtom)) (body))
    (rule non-dynamic-list (head (HENonDynamic (HTList ?t))) (body (HEType ?t)))
    (rule non-dynamic-arrow (head (HENonDynamic (HTArrow ?a ?r))) (body (HEType ?a) (HEType ?r)))
    (rule ordinary-number (head (HEOrdinaryRoot HTNumber)) (body))
    (rule ordinary-string (head (HEOrdinaryRoot HTString)) (body))
    (rule ordinary-bool (head (HEOrdinaryRoot HTBool)) (body))
    (rule ordinary-list (head (HEOrdinaryRoot (HTList ?t))) (body (HEType ?t)))
    (rule ordinary-arrow (head (HEOrdinaryRoot (HTArrow ?a ?r))) (body (HEType ?a) (HEType ?r)))
    (rule consistent-exact (head (HEConsistent ?t ?t HEdgeExact)) (body (HEOrdinaryRoot ?t)))
    (rule consistent-dynamic-left (head (HEConsistent HTDynamic ?t HEdgeDynamic)) (body (HEType ?t)))
    (rule consistent-dynamic-right (head (HEConsistent ?t HTDynamic HEdgeDynamic)) (body (HEType ?t)))
    (rule consistent-top-right (head (HEConsistent ?t HTAtom HEdgeTop)) (body (HENonDynamic ?t)))
  ))
